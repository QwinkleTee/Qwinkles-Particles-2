        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">Randomizer</string>
            <string name="Source"><![CDATA[--[[
	Randomizer  -  Part-Icles V5
	Copyright (C) 2026 Qwinkle

	Barrel for the Randomizer system. Submodules:
	  - RandomizerRules: hybrid bounds (curated overrides + TypeData auto-derivation) +
	    type-aware value generators (Number / NumberRange / NumberSequence / Color /
	    ColorSequence / Vector / UDim2 / boolean / enum).
	  - RandomizerWriter: dispatch wrapper that handles virtualEmitAttr (item-level
	    SetAttribute) vs TypeRegistry.write + clears Prop_BezierHandles on graph writes.
	  - Cancel: scoped revert that only touches props the Randomizer actually wrote.
	  - RandomizerWiring: panel state machine factory (deps -> {open, rollAll, apply,
	    cancel, isOpen, populateSections}).
	  - Bootstrap: attach(deps) wires the toolbar button + panel button handlers.

	NOT user-script-reachable. Internal-only.
]]

-- task.wait between requires so Luraph VM bootstrap of each obfuscated submodule
-- spreads across frames instead of stacking in one frame.
local Rules = require(script.RandomizerRules); task.wait()
local Writer = require(script.RandomizerWriter); task.wait()
local Cancel = require(script.Cancel); task.wait()
-- Wiring is a factory (deps -> module); caller invokes `require(RandomizerWiring)(deps)`.
-- Exposed here as the require ref so init.server.lua can build with ctx-bound deps.
local Wiring = require(script.RandomizerWiring); task.wait()
local Bootstrap = require(script.Bootstrap); task.wait()

return {
	Rules = Rules,
	Writer = Writer,
	Cancel = Cancel,
	Wiring = Wiring,
	Bootstrap = Bootstrap,
}
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">Bootstrap</string>
              <string name="Source"><![CDATA[--[[
	RandomizerBootstrap  -  Part-Icles V5 Randomizer wiring entry point
	Copyright (C) 2026 Qwinkle

	Bootstrap.attach(deps) builds the RandomizerWiring state machine, wires:
	  - Toolbar QMenu "Randomize" button → toggle (open/cancel via isOpen()).
	  - Panel buttons: rollAllBtn / applyBtn / cancelBtn.
	  - Built-in W.makeToolPanel header X (`headerCloseBtn`) → cancel().

	Invariant: ALL close paths must restore preview snapshots  -  both cancelBtn and
	headerCloseBtn route through wiring.cancel().

	Returns the wiring state machine (so callers can keep a ref on ctx).

	Required deps shape:
	  ctx, UI, Connections, Randomizer (the barrel), PropertyCatalog, QOL,
	  TypeRegistry, ChangeHistoryService, ToolPanels, Widgets, Theme.
]]

local Bootstrap = {}

function Bootstrap.attach(deps)
	local ctx = deps.ctx
	local UI = deps.UI
	local Connections = deps.Connections
	local Randomizer = deps.Randomizer

	local wiring = Randomizer.Wiring({
		ctx = ctx,
		panel = {
			panel = UI.RandomizerPanel,
			sectionList = UI.RandomizerSectionList,
			rollAllBtn = UI.RandomizerRollAllBtn,
			applyBtn = UI.RandomizerApplyBtn,
			cancelBtn = UI.RandomizerCancelBtn,
			headerCloseBtn = UI.RandomizerHeaderCloseBtn,
		},
		PropertyCatalog = deps.PropertyCatalog,
		RandomizerRules = Randomizer.Rules,
		RandomizerWriter = Randomizer.Writer,
		QOL = deps.QOL,
		TypeRegistry = deps.TypeRegistry,
		ChangeHistoryService = deps.ChangeHistoryService,
		PE_SECTIONS = (deps.ToolPanels and deps.ToolPanels.PE_SECTIONS) or {},
		Widgets = deps.Widgets,
		Theme = deps.Theme,
	})
	ctx.RandomizerWiring = wiring

	-- Toolbar QMenu "Randomize" → toggle.
	if UI.Randomize then
		Connections["RandomizeToggle"] = UI.Randomize.Activated:Connect(function()
			if wiring.isOpen() then wiring.cancel() else wiring.open() end
		end)
	end

	-- Panel buttons. cancelBtn + headerCloseBtn both route through cancel() so preview
	-- snapshots restore regardless of which close path the user takes.
	if UI.RandomizerRollAllBtn then
		Connections["RandomizeRoll"] = UI.RandomizerRollAllBtn.Activated:Connect(function() wiring.rollAll() end)
	end
	if UI.RandomizerApplyBtn then
		Connections["RandomizeApply"] = UI.RandomizerApplyBtn.Activated:Connect(function() wiring.apply() end)
	end
	if UI.RandomizerCancelBtn then
		Connections["RandomizeCancel"] = UI.RandomizerCancelBtn.Activated:Connect(function() wiring.cancel() end)
	end
	if UI.RandomizerHeaderCloseBtn then
		Connections["RandomizeHeaderClose"] = UI.RandomizerHeaderCloseBtn.Activated:Connect(function() wiring.cancel() end)
	end

	return wiring
end

return Bootstrap
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">Cancel</string>
              <string name="Source"><![CDATA[--[[
	Randomizer/Cancel  -  Part-Icles V5
	Copyright (C) 2026 Qwinkle

	Scoped Cancel restore. Extracted from RandomizerWiring as a separate sub-module.

	Why scoped?
	  Blanket _restoreSnapshots() reverts every property on every selected item
	  back to its open-time snapshot value. If the user makes a property edit
	  elsewhere while the panel is open and then presses Cancel, that unrelated
	  edit also reverts  -  which is silent data loss. This module rebuilds a
	  reduced snapshot containing only the (item, propKey) pairs the Randomizer
	  actually wrote during preview, then routes through QOL.restoreSnapshots's
	  scoped path so the per-type quirks (PE native props, virtualEmitAttr's
	  nil-clears-attribute semantic, directAccess Trail) keep their existing
	  behavior.

	Bag fields read:
	  snapshots, lastBatch, retainedBatch  -- live tables owned by RandomizerWiring.
	  QOL                                  -- so we don't need to re-require it here.

	NOT user-script-reachable. Internal-only.
]]

local Cancel = {}

-- propKey written -> snapshot key holding the original virtual emit attr value.
local VIRTUAL_KEY = {
	EmitDuration = "_emitDuration",
	EmitDelay = "_emitDelay",
	EmitCount = "_emitCount",
}

-- propKey written -> snapshot key for native PE properties stored under a non-
-- matching key. PE.Color goes through `snap._peColor` (the only entry currently)
-- because its snapshot is wrapped in pcall; without this translation the harvest
-- below would write touched.Color instead of touched._peColor and the restore
-- branch in QOL.restoreSnapshots would skip the revert.
local PE_KEY = {
	Color = "_peColor",
}

-- Build a per-item touched snapshot from the supplied roll batches and route it
-- through QOL.restoreSnapshots(_, true). Items with no live Parent are skipped so
-- a deleted item doesn't error during attribute writes.
function Cancel.restoreTouchedOnly(bag)
	local snapshots = bag.snapshots
	if not snapshots then return end
	local QOL = bag.QOL
	local touchedMap = {}

	local function harvest(batch)
		if not batch then return end
		for item, itemBatch in pairs(batch) do
			local origSnap = snapshots[item]
			if not (origSnap and item.Parent) then continue end
			local touched = touchedMap[item] or {}
			touchedMap[item] = touched
			for propKey in pairs(itemBatch) do
				if origSnap[propKey] ~= nil then
					touched[propKey] = origSnap[propKey]
				end
				local virtualKey = VIRTUAL_KEY[propKey]
				if virtualKey then
					-- Assigning nil here would remove the key from `touched`, which scoped
					-- restore reads as "skip". Use QOL.NIL_SENTINEL so scoped restore knows
					-- to call SetAttribute(name, nil) and revive originally-absent state;
					-- otherwise Cancel leaves rolled EmitCount/EmitDelay/EmitDuration
					-- attributes persisted on raw PEs that originally had no such attrs.
					local origVal = origSnap[virtualKey]
					touched[virtualKey] = (origVal == nil) and (QOL and QOL.NIL_SENTINEL) or origVal
				end
				local peKey = PE_KEY[propKey]
				if peKey then
					touched[peKey] = origSnap[peKey]
				end
				if origSnap._bezierHandles then
					touched._bezierHandles = touched._bezierHandles or {}
					local handleAttr = propKey .. "_BezierHandles"
					touched._bezierHandles[handleAttr] = origSnap._bezierHandles[handleAttr]
				end
			end
		end
	end

	harvest(bag.lastBatch)
	harvest(bag.retainedBatch)
	if next(touchedMap) then
		QOL.restoreSnapshots(touchedMap, true)
	end
end

return Cancel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">RandomizerRules</string>
              <string name="Source"><![CDATA[--[[
	RandomizerRules  -  Part-Icles V5
	Copyright (C) 2026 Qwinkle

	Hybrid bounds system:
	  1. Property-name override (`Rules.byName`)  -  curated semantic + perf-sensitive
	     bounds for the most-used props. Wins over auto-derivation.
	  2. TypeData auto-derivation by `propDef.type`  -  generic safety bounds for
	     everything not in `byName`.
	  3. If neither yields a safe rule, returns nil → Randomizer panel filters this
	     prop out.

	Generators are deterministic given a math.randomseed (caller's responsibility)
	but use math.random uniformly within bounds. Color generators use the
	algorithmic palette modes (Analogous / Complementary / Monochrome / Warm / Cool /
	WhiteToColor).

	NumberSequence generator produces 3..7 keypoints with sorted times + random
	values + bounded envelopes when the keypoint-count toggle is on (2-keypoint shape
	when off).

	Virtual emit-attribute props (EmitCount/EmitDelay/EmitDuration) are tagged with
	`virtualEmitAttr = true`. RandomizerWriter dispatches them via item:SetAttribute(
	name, value) rather than TypeRegistry.write (those attrs live on the item, not
	in PartIcleProperties).

	Skipped: instance refs (Link/EmitParent/AccelTarget/OnDeath_EmitTarget), asset
	IDs, enums without curated profile.
]]

local RandomizerRules = {}

-- =========================================================
-- CURATED OVERRIDES (Rules.byName)
-- =========================================================

-- Override entries provide bounds + policy ONLY (min/max, integer, perfSensitive, virtualEmitAttr,
-- minKeypoints/maxKeypoints for NumberSequence). Generator shape is computed from propDef.type
-- per-type at derive time, NOT hardcoded here. Same logical prop key can have different shapes
-- across types (Lifetime is NumberRange on Part/Beam but `number` on Trail; Brightness is
-- NumberSequence on Beam but `number` on Trail). Override locks bounds; type drives shape.
RandomizerRules.byName = {
	-- VIRTUAL emit attributes (item-level, NOT in TypeRegistry config). Writer dispatches via
	-- item:SetAttribute. virtualEmitAttr forces scalar + integer-where-set regardless of any
	-- propDef (these aren't in TypeRegistry).
	EmitCount    = {min = 1,   max = 40, integer = true, perfSensitive = true, virtualEmitAttr = true},
	EmitDelay    = {min = 0,   max = 2,                  perfSensitive = true, virtualEmitAttr = true},
	EmitDuration = {min = 0,   max = 3,                  perfSensitive = true, virtualEmitAttr = true},

	-- Perf-sensitive bounds. Shape decided per-type (Rate is scalar; Lifetime is NumberRange
	-- on most types but `number` on Trail; FlipbookFramerate is NumberRange).
	TotalKeyFrames    = {min = 20,  max = 180, integer = true, perfSensitive = true},
	Rate              = {min = 1,   max = 80,                  perfSensitive = true},
	Lifetime          = {min = 0.1, max = 5,                   perfSensitive = true, minKeypoints = 3, maxKeypoints = 7},
	FlipbookFramerate = {min = 1,   max = 60,                  perfSensitive = true, minKeypoints = 3, maxKeypoints = 7},

	-- Semantic bounds for graph- or scalar-typed props. minKeypoints/maxKeypoints applied
	-- automatically when propDef.type == "NumberSequence" at derive time.
	Transparency       = {min = 0,   max = 1, minKeypoints = 3, maxKeypoints = 7},
	LightEmission      = {min = 0,   max = 1, minKeypoints = 3, maxKeypoints = 7},
	LightInfluence     = {min = 0,   max = 1, minKeypoints = 3, maxKeypoints = 7},
	Brightness         = {min = 0,   max = 2, minKeypoints = 3, maxKeypoints = 7},
	Speed              = {min = -20, max = 50, minKeypoints = 3, maxKeypoints = 7},
	SizeX              = {min = 0.1, max = 10, minKeypoints = 3, maxKeypoints = 7},
	SizeY              = {min = 0.1, max = 10, minKeypoints = 3, maxKeypoints = 7},
	SizeZ              = {min = 0.1, max = 10, minKeypoints = 3, maxKeypoints = 7},
	Width0             = {min = 0.1, max = 10, minKeypoints = 3, maxKeypoints = 7},
	Width1             = {min = 0.1, max = 10, minKeypoints = 3, maxKeypoints = 7},
	CurveSize0         = {min = -5,  max = 5,  minKeypoints = 3, maxKeypoints = 7},
	CurveSize1         = {min = -5,  max = 5,  minKeypoints = 3, maxKeypoints = 7},
	TextureLength      = {min = 0.5, max = 10, minKeypoints = 3, maxKeypoints = 7},
	TextureSpeed       = {min = -5,  max = 5,  minKeypoints = 3, maxKeypoints = 7},
	Segments           = {min = 20,  max = 60, integer = true, minKeypoints = 3, maxKeypoints = 7},

	Range              = {min = 4,   max = 60, minKeypoints = 3, maxKeypoints = 7},
	WidthScale         = {min = 0,   max = 2,  minKeypoints = 3, maxKeypoints = 7},
	AccelStrength      = {min = -50, max = 50, minKeypoints = 3, maxKeypoints = 7},

	-- Tightened bounds so MinLength's max <= MaxLength's min  -  prevents Randomizer rolling
	-- a Trail with MinLength > MaxLength (Roblox renders nothing or distorts when min > max).
	-- Trade-off: Randomizer can't produce a Trail with both bounds below 5; user can hand-edit
	-- if they want a tighter window.
	MinLength          = {min = 0,  max = 5},
	MaxLength          = {min = 5,  max = 50},
	Drag               = {min = 0,  max = 20},
	ZOffset            = {min = -2, max = 2},
	-- Hollow/shell ratio. 0 = solid volume, 1 = surface-only shell. Auto-derive would
	-- run -10..10 because the propDef has no nonNegative flag (it's not stored as
	-- an attribute  -  we want the literal 0..1 range, not a clamped version).
	ShapePartial       = {min = 0,  max = 1},

	-- ImageLabel layout / flipbook props. Auto-derive defaults are wrong here  - 
	-- AnchorPoint is normalized 0..1, ZIndex/GridCols/GridRows are integers.
	AnchorPoint        = {min = 0,  max = 1},
	ZIndex             = {min = 0,  max = 32, integer = true},
	GridCols           = {min = 1,  max = 16, integer = true},
	GridRows           = {min = 1,  max = 16, integer = true},
}

-- Per-type exclusions: some prop keys exist on multiple types but make sense to randomize on
-- only one. Trail's logical `Duration` (TypeRegistry attrName=EmitDuration) is rolled here
-- only when the type is Trail; non-Trail items use the virtual `EmitDuration` instead.
RandomizerRules.typeExcludes = {
	-- Trail items skip the virtual EmitCount/EmitDelay (Trail directAccess; not meaningful).
	Trail = { EmitCount = true, EmitDelay = true, EmitDuration = true },
	-- Non-Trail items skip Trail's directAccess `Duration` logical prop (Trail-only).
	Part = { Duration = true }, Beam = { Duration = true }, PointLight = { Duration = true },
	Highlight = { Duration = true },
	Attachment = { Duration = true }, Model = { Duration = true },
}

-- Cross-type excludes  -  props that exist on multiple types but never make sense to
-- randomize. AccelerationTowardsInstance is a boolean gate that depends on AccelTarget
-- being a valid Instance picked by the user; flipping it on without a target rolls
-- nothing useful, and rolling it off discards the user's setup. Strength still rolls.
RandomizerRules.globalExcludes = {
	AccelerationTowardsInstance = true,
}

-- =========================================================
-- DERIVE  -  hybrid override + auto
-- =========================================================

-- Build a fresh rule from override bounds + propDef.type-driven shape. virtualEmitAttr is
-- a special case: scalar + integer regardless of propDef (not in TypeRegistry).
local function _decorateOverride(override, propDef)
	-- virtualEmitAttr: scalar shape, copy bounds + integer flag.
	if override.virtualEmitAttr then
		return {
			scalar = true,
			min = override.min, max = override.max,
			integer = override.integer,
			perfSensitive = override.perfSensitive,
			virtualEmitAttr = true,
		}
	end
	-- No propDef means caller passed a key not in TypeRegistry (e.g. raw PE prop). Without
	-- shape info, can't dispatch a generator. Skip.
	if not propDef then return nil end

	local nn = propDef.nonNegative or false
	-- Resolve effective bounds: override wins if present, otherwise nonNegative-aware default.
	-- nonNegative ALWAYS clamps lo to >= 0 even when override has a negative min  -  otherwise
	-- TypeRegistry.write would silently clamp the value post-roll, collapsing rolls toward 0
	-- and skewing the expected distribution.
	local lo = override.min if lo == nil then lo = nn and 0 or -10 end
	if nn and lo < 0 then lo = 0 end
	local hi = override.max if hi == nil then hi = 10 end
	local rule = {
		min = lo, max = hi,
		integer = override.integer,
		perfSensitive = override.perfSensitive,
	}
	-- Shape comes from propDef.type at THIS type. Same logical prop key can be different
	-- shapes across types (Brightness is NumberSequence on Beam, scalar `number` on Trail).
	local t = propDef.type
	if t == "boolean" then return {coin = true} end
	if t == "enum" then return nil end -- skip uncurated enums
	if t == "ColorSequence" then return {colorSequence = true} end
	if t == "NumberSequence" then
		rule.numberSequence = true
		rule.minKeypoints = override.minKeypoints or 3
		rule.maxKeypoints = override.maxKeypoints or 7
		return rule
	end
	if t == "NumberRange" then rule.numberRange = true; return rule end
	if t == "number" then rule.scalar = true; return rule end
	if t == "Vector3" then return {vector = true, axes = 3, min = lo, max = hi} end
	if t == "Vector2" then return {vector = true, axes = 2, min = lo, max = hi} end
	if t == "UDim2" then return {udim2 = true} end
	-- Anything else (string asset IDs, instance refs, custom types): skip.
	return nil
end

-- Pure-auto fallback when no override exists. Uses propDef.type + nonNegative.
local function _autoFromPropDef(propDef)
	if not propDef then return nil end
	if propDef.type == "boolean" then return {coin = true} end
	if propDef.type == "enum" then return nil end -- skip uncurated
	if propDef.type == "ColorSequence" then return {colorSequence = true} end
	local nn = propDef.nonNegative or false
	if propDef.type == "NumberSequence" then
		return {numberSequence = true, min = nn and 0 or -10, max = 10, minKeypoints = 3, maxKeypoints = 7}
	end
	if propDef.type == "NumberRange" then
		return {numberRange = true, min = nn and 0 or -10, max = 10}
	end
	if propDef.type == "number" then
		return {scalar = true, min = nn and 0 or -10, max = 10}
	end
	if propDef.type == "Vector3" then return {vector = true, axes = 3, min = -10, max = 10} end
	if propDef.type == "Vector2" then return {vector = true, axes = 2, min = -10, max = 10} end
	if propDef.type == "UDim2" then return {udim2 = true} end
	return nil
end

-- Native PE prop type map. Values mirror Roblox ParticleEmitter property types.
-- Used by derive("PE", ...) to build a rule when propDef is nil (PE has no
-- TypeRegistry entry). Boolean props omitted  -  PE booleans aren't randomization-
-- friendly (WindAffectsDrag, FlipbookBlendFrames). Emit timing attrs route through
-- the existing virtualEmitAttr path on the item itself.
local PE_PROP_TYPES = {
	Rate = "scalarPos",                 -- 0..50
	Lifetime = "numberRange",            -- (lo, hi)
	SpreadAngle = "vector2",             -- degrees
	EmitCount = "scalarPosInt",          -- 0..50
	EmitDelay = "scalarNonNeg",          -- 0..2
	EmitDuration = "scalarNonNeg",       -- 0..3
	Brightness = "scalarPos",            -- 0..2
	Size = "numberSequence",
	Transparency = "numberSequence",
	Color = "colorSequence",
	Squash = "numberSequence",
	LightEmission = "scalarUnit",        -- 0..1
	LightInfluence = "scalarUnit",       -- 0..1
	ZOffset = "scalarSym",               -- -2..2
	Speed = "numberRange",
	RotSpeed = "numberRange",
	Rotation = "numberRange",
	Acceleration = "vector3",
	Drag = "scalarNonNeg",               -- 0..3
	VelocityInheritance = "scalarUnit",  -- 0..1
	TimeScale = "scalarPos",             -- 0..2
	FlipbookFramerate = "numberRange",   -- Roblox PE FlipbookFramerate is NumberRange.
}

-- Per-PE-prop bound overrides. Generic kind defaults (numberRange 0..5,
-- numberSequence 0..1) are too tight for properties whose native Roblox scale
-- is much larger (Rotation/RotSpeed in degrees, Squash -10..10, Speed 0..50).
local PE_BOUNDS = {
	-- numberRange (Vector2 keypoint pair)  -  explicit min/max in property's native units.
	Speed = {min = 0, max = 50},
	RotSpeed = {min = -360, max = 360},
	Rotation = {min = 0, max = 360},
	Lifetime = {min = 0.1, max = 5},
	-- numberSequence  -  Squash is signed -10..10; Size typical visual range.
	Size = {min = 0.5, max = 5},
	Squash = {min = -10, max = 10},
	-- scalarPos overrides
	Rate = {min = 1, max = 80},
	FlipbookFramerate = {min = 1, max = 60},
	Brightness = {min = 0, max = 100},
	-- scalarUnit overrides  -  both clamped to native PE's accepted [0,1] range.
	-- LightInfluence: probability=0.25 → 25% chance to roll a value, 75% chance
	-- to commit 0. Matches plugin convention that most randomized PEs render unlit.
	-- LightEmission is scalarUnit per PE_PROP_TYPES; Roblox clamps to [0,1]
	-- internally so any non-unit override would silently snap.
	LightEmission = {min = 0, max = 1},
	LightInfluence = {min = 0, max = 1, probability = 0.25},
	-- SpreadAngle is the size of a random emission spread; negative components
	-- are not meaningful. Cap each component at [0, 360].
	SpreadAngle = {vector = true, axes = 2, min = 0, max = 360},
}

local function _peRule(propKey)
	local kind = PE_PROP_TYPES[propKey]
	if not kind then return nil end
	local override = PE_BOUNDS[propKey]
	local rule
	if kind == "scalarPos" then
		local hi = override and override.max or ((propKey == "Rate" or propKey == "FlipbookFramerate") and 30 or 2)
		local lo = override and override.min or 0
		rule = {scalar = true, min = lo, max = hi}
	elseif kind == "scalarPosInt" then rule = {scalar = true, min = 0, max = 50, integer = true}
	elseif kind == "scalarNonNeg" then rule = {scalar = true, min = 0, max = 3}
	elseif kind == "scalarUnit" then
		local lo = override and override.min or 0
		local hi = override and override.max or 1
		rule = {scalar = true, min = lo, max = hi, probability = override and override.probability}
	elseif kind == "scalarSym" then rule = {scalar = true, min = -2, max = 2}
	elseif kind == "numberRange" then
		local lo = override and override.min or 0
		local hi = override and override.max or 5
		rule = {numberRange = true, min = lo, max = hi}
	elseif kind == "vector2" then
		-- Respect PE_BOUNDS override so SpreadAngle (and any future per-prop
		-- vector2 with custom range) isn't stuck on the generic [-180, 180].
		local lo = override and override.min or -180
		local hi = override and override.max or 180
		rule = {vector = true, axes = 2, min = lo, max = hi}
	elseif kind == "vector3" then rule = {vector = true, axes = 3, min = -10, max = 10}
	elseif kind == "numberSequence" then
		local lo = override and override.min or 0
		local hi = override and override.max or 1
		rule = {numberSequence = true, min = lo, max = hi}
	elseif kind == "colorSequence" then rule = {colorSequence = true}
	end
	if rule then rule.nativePE = true end
	-- Emit timing attrs go through the item-level setattribute path, not native property.
	if propKey == "EmitCount" or propKey == "EmitDelay" or propKey == "EmitDuration" then
		rule.virtualEmitAttr = true
		rule.nativePE = nil
	end
	return rule
end

-- Per-type-and-name overrides for props whose native scale differs by type. Beats
-- byName for the matching (typeName, propKey). E.g. ColorCorrection.Brightness is
-- signed -1..1 (Roblox native), not the 0..2 PointLight-suitable byName default.
RandomizerRules.byTypeAndName = {
	ColorCorrection = {
		Brightness = {min = -1, max = 1, minKeypoints = 3, maxKeypoints = 7},
		Contrast = {min = -1, max = 1, minKeypoints = 3, maxKeypoints = 7},
		Saturation = {min = -1, max = 1, minKeypoints = 3, maxKeypoints = 7},
	},
	Atmosphere = {
		Density = {min = 0, max = 1, minKeypoints = 3, maxKeypoints = 7},
		Offset = {min = 0, max = 1, minKeypoints = 3, maxKeypoints = 7},
		Glare = {min = 0, max = 24, minKeypoints = 3, maxKeypoints = 7},
		Haze = {min = 0, max = 10, minKeypoints = 3, maxKeypoints = 7},
	},
}

function RandomizerRules.derive(typeName, propKey, propDef)
	-- Cross-type exclude pre-check (applies before PE / per-type filters).
	if RandomizerRules.globalExcludes[propKey] then return nil end
	-- Native PE rules  -  PE has no TypeRegistry entry, so derive consults a hardcoded
	-- type map keyed off the prop name.
	if typeName == "PE" then return _peRule(propKey) end
	-- Per-type exclude pre-check.
	local excludes = RandomizerRules.typeExcludes[typeName]
	if excludes and excludes[propKey] then return nil end

	-- Trail Duration special case: TypeData stores it as type="string" (range format
	-- "min, max" parsed by the directAccess Trail readers). Generic derive would skip
	-- strings. Roll a scalar in [0, 3] and writer tostring-wraps before TypeRegistry.
	-- write. Trail items show Duration; non-Trail show virtual EmitDuration.
	if typeName == "Trail" and propKey == "Duration" then
		return {scalar = true, min = 0, max = 3, perfSensitive = true, stringForm = true}
	end

	-- Type-specific override beats byName.
	local typeOverrides = RandomizerRules.byTypeAndName[typeName]
	local override = typeOverrides and typeOverrides[propKey] or RandomizerRules.byName[propKey]
	if override then return _decorateOverride(override, propDef) end

	-- No override: pure auto-derive from propDef.type.
	return _autoFromPropDef(propDef)
end

-- =========================================================
-- GENERATORS
-- =========================================================

-- Scalar (number)
function RandomizerRules.rollScalar(rule)
	-- Probability gate: PE LightInfluence rolls a value 25% of the time and 0
	-- otherwise so most randomized PEs render unlit (matches plugin convention).
	if rule.probability and math.random() > rule.probability then
		return 0
	end
	local lo, hi = rule.min or 0, rule.max or 1
	if rule.integer then return math.random(math.floor(lo), math.floor(hi)) end
	return lo + math.random() * (hi - lo)
end

-- NumberRange (min/max pair, sorted)
function RandomizerRules.rollNumberRange(rule)
	local lo, hi = rule.min or 0, rule.max or 1
	local a = lo + math.random() * (hi - lo)
	local b = lo + math.random() * (hi - lo)
	if a > b then a, b = b, a end
	return NumberRange.new(a, b)
end

-- NumberSequence  -  keypoint count depends on the rule.randomizeKeypoints flag:
--   OFF (default): exactly 2 keypoints (t=0 + t=1) with random values + envelopes  -  gives
--                  a simple start/end envelope-style randomization.
--   ON: 3..7 keypoints, sorted random times, bounded envelopes  -  produces a varied shape.
function RandomizerRules.rollNumberSequence(rule)
	local minKp, maxKp
	if rule.randomizeKeypoints then
		minKp = rule.minKeypoints or 3
		maxKp = rule.maxKeypoints or 7
	else
		minKp, maxKp = 2, 2
	end
	local n = math.random(minKp, maxKp)
	-- Times: anchor 0 and 1, n-2 random ascending in between.
	local times = {0}
	for i = 1, n - 2 do table.insert(times, math.random()) end
	table.insert(times, 1)
	table.sort(times)
	local lo, hi = rule.min or 0, rule.max or 1
	local rangeSpan = hi - lo
	local kps = {}
	for _, t in ipairs(times) do
		local v = lo + math.random() * rangeSpan
		if rule.integer then v = math.floor(v + 0.5) end
		-- Envelope clamped so value +/- envelope stays within [lo, hi]. 0..50% of remaining
		-- headroom  -  full envelope-to-edge would saturate at the bounds and look ugly.
		local headroom = math.min(v - lo, hi - v)
		local env = math.random() * headroom * 0.5
		if rule.integer then env = math.floor(env + 0.5) end
		table.insert(kps, NumberSequenceKeypoint.new(t, v, env))
	end
	return NumberSequence.new(kps)
end

-- Color (single Color3, vivid)
function RandomizerRules.rollColor()
	local h = math.random()
	local s = 0.6 + math.random() * 0.4
	local v = 0.5 + math.random() * 0.5
	return Color3.fromHSV(h, s, v)
end

-- ColorSequence  -  algorithmic palette. Picks a mode (weighted) and produces
-- 2 keypoints (when randomizeKeypoints OFF) or 3..6 keypoints (when ON), each color
-- sampled by the palette's hue rule via PALETTE_SAMPLERS below.
local COLOR_MODES = {
	{name = "Analogous",     weight = 3},
	{name = "Complementary", weight = 2},
	{name = "Monochrome",    weight = 2},
	{name = "Warm",          weight = 1},
	{name = "Cool",          weight = 1},
	{name = "WhiteToColor",  weight = 1},
}

local function pickColorMode()
	local total = 0
	for _, m in ipairs(COLOR_MODES) do total = total + m.weight end
	local r = math.random() * total
	local acc = 0
	for _, m in ipairs(COLOR_MODES) do
		acc = acc + m.weight
		if r <= acc then return m.name end
	end
	return COLOR_MODES[1].name
end

local function hsv(h, s, v) return Color3.fromHSV(h % 1, math.clamp(s, 0, 1), math.clamp(v, 0, 1)) end

-- Per-row palette dropdown lets the user pin the algorithmic palette mode for
-- ColorSequence rolls instead of the weighted random `pickColorMode`. UI sends the
-- chosen mode as `rule.paletteMode` (string: Auto / Analogous / Complementary /
-- Monochrome / Warm / Cool / WhiteToColor); "Auto" / nil falls back to weighted random.
RandomizerRules.PALETTE_MODES = {"Auto", "Analogous", "Complementary", "Monochrome", "Warm", "Cool", "WhiteToColor"}

-- Validate modeOverride against PALETTE_MODES. Unknown strings (typo, stale saved
-- setting, future-version mode the current build doesn't know) get reset to nil so
-- the call falls through to weighted-random pickColorMode() rather than silently
-- using the PALETTE_SAMPLERS WhiteToColor fallback. PALETTE_MODE_SET is O(1) lookup.
local PALETTE_MODE_SET = {}
for _, name in ipairs(RandomizerRules.PALETTE_MODES) do PALETTE_MODE_SET[name] = true end

-- Per-palette samplers  -  each returns a Color3 honoring the palette's hue rule.
-- baseHue + i (0-based) + n let some palettes alternate (Complementary, WhiteToColor)
-- while others sample-with-jitter (Analogous, Monochrome, Warm, Cool).
local PALETTE_SAMPLERS = {
	Analogous = function(baseHue, _i, _n)
		local drift = (math.random() - 0.5) * 0.32  -- ±0.16 around baseHue
		return hsv(baseHue + drift, 0.6 + math.random() * 0.25, 0.8 + math.random() * 0.15)
	end,
	Complementary = function(baseHue, i, _n)
		local h = ((i % 2) == 0) and baseHue or (baseHue + 0.5) % 1
		return hsv(h, 0.65 + math.random() * 0.2, 0.85 + math.random() * 0.1)
	end,
	Monochrome = function(baseHue, _i, _n)
		return hsv(baseHue, 0.5 + math.random() * 0.4, 0.4 + math.random() * 0.55)
	end,
	Warm = function(_baseHue, _i, _n)
		return hsv(math.random() * 0.2, 0.7 + math.random() * 0.2, 0.85 + math.random() * 0.1)
	end,
	Cool = function(_baseHue, _i, _n)
		return hsv(0.45 + math.random() * 0.25, 0.7 + math.random() * 0.2, 0.85 + math.random() * 0.1)
	end,
	WhiteToColor = function(baseHue, i, _n)
		if (i % 2) == 0 then return Color3.new(1, 1, 1) end
		return hsv(baseHue, 0.7 + math.random() * 0.2, 0.85 + math.random() * 0.1)
	end,
}

-- ColorSequence roller supports both OFF (2 keypoints) and ON (3..6 keypoints) keypoint
-- counts AND honors the palette mode in either case. ON + explicit palette (Warm / Cool
-- / etc.) samples multi-keypoint colors within the palette's hue family; ON + Auto
-- picks a palette via weighted random first. OFF
-- mirrors that with exactly 2 keypoints  -  palette still constrains the start/end.
function RandomizerRules.rollColorSequence(modeOverride, randomizeKeypoints)
	if modeOverride and not PALETTE_MODE_SET[modeOverride] then modeOverride = nil end
	local mode = (modeOverride and modeOverride ~= "Auto" and modeOverride) or pickColorMode()
	local sampler = PALETTE_SAMPLERS[mode] or PALETTE_SAMPLERS.WhiteToColor
	local n = randomizeKeypoints and math.random(3, 6) or 2
	local times
	if n == 2 then
		times = {0, 1}
	else
		times = {0}
		for _ = 1, n - 2 do table.insert(times, math.random()) end
		table.insert(times, 1)
		table.sort(times)
	end
	local baseHue = math.random()
	local kps = {}
	for i, t in ipairs(times) do
		table.insert(kps, ColorSequenceKeypoint.new(t, sampler(baseHue, i - 1, n)))
	end
	return ColorSequence.new(kps)
end

-- Vector (Vector2 / Vector3)
function RandomizerRules.rollVector(rule)
	local axes = rule.axes or 3
	local lo, hi = rule.min or -10, rule.max or 10
	local span = hi - lo
	if axes == 2 then
		return Vector2.new(lo + math.random() * span, lo + math.random() * span)
	end
	return Vector3.new(lo + math.random() * span, lo + math.random() * span, lo + math.random() * span)
end

-- UDim2  -  random scale + offset within sane UI ranges. Plugin uses UDim2 for ImageLabel
-- positioning; offset 0..200 px, scale 0..1.
function RandomizerRules.rollUDim2()
	return UDim2.new(math.random(), math.random(0, 200), math.random(), math.random(0, 200))
end

-- Boolean (coin)
function RandomizerRules.rollBoolean()
	return math.random() < 0.5
end

-- Enum: caller passes an enum profile (curated subset of valid Enum.X.Name strings).
function RandomizerRules.rollEnum(profile)
	if not profile or #profile == 0 then return nil end
	return profile[math.random(1, #profile)]
end

-- =========================================================
-- ROLL DISPATCH (rule -> generator)
-- =========================================================

-- Single entry point: callers pass a rule from RandomizerRules.derive() + optional context.
-- Returns the generated value, or nil if rule shape is unrecognized.
function RandomizerRules.roll(rule)
	if not rule then return nil end
	if rule.coin then return RandomizerRules.rollBoolean() end
	if rule.colorSequence then return RandomizerRules.rollColorSequence(rule.paletteMode, rule.randomizeKeypoints) end
	if rule.numberSequence then return RandomizerRules.rollNumberSequence(rule) end
	if rule.numberRange then return RandomizerRules.rollNumberRange(rule) end
	if rule.vector then return RandomizerRules.rollVector(rule) end
	if rule.udim2 then return RandomizerRules.rollUDim2() end
	-- Default: scalar (covers `byName` curated bounds and `derive` numeric returns).
	return RandomizerRules.rollScalar(rule)
end

return RandomizerRules
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">RandomizerSection</string>
              <string name="Source"><![CDATA[--[[
	RandomizerSection  -  Part-Icles V5 Randomizer System
	Copyright (C) 2026 Qwinkle

	Builds one category section's UI:
	  Header blob: collapse arrow + tristate glyph (none/some/all) + label
	  Body Frame: per-prop rows (label blob + optional palette dropdown + IsOn toggle).

	Caller passes a `bag` of shared state + helpers. We don't capture upvalues from
	RandomizerWiring directly because:
	  - Mutable tables (_checked, _paletteMode, _toggleConns, etc.) share by reference.
	  - Mutable scalars (_lastBatch, _groupAxes) come through getter callbacks so the
	    row closures see the live values from RandomizerWiring's outer scope.

	NOT user-script-reachable. Internal-only.
]]

local M = {}

function M.emit(bag, sec, sectionTypeName, sectionUid, headerText, parent)
	local W = bag.W
	local Th = bag.Th
	local TypeRegistry = bag.TypeRegistry
	local Rules = bag.Rules
	local _checked = bag.checked
	local _paletteMode = bag.paletteMode
	local _itemTypeName = bag.itemTypeName
	local _sectionProps = bag.sectionProps
	local _sectionHeaderRefresh = bag.sectionHeaderRefresh
	local _typeRowToggles = bag.typeRowToggles
	local _typeHeaderRefresh = bag.typeHeaderRefresh
	local _toggleConns = bag.toggleConns
	local AXIS_TO_FAMILY = bag.AXIS_TO_FAMILY
	local _compKey = bag.compKey
	local _hasMixedLinkState = bag.hasMixedLinkState
	local _refreshHeaderGlyph = bag.refreshHeaderGlyph
	local _restoreSnapshots = bag.restoreSnapshots
	local _replayBatch = bag.replayBatch
	local _rollBatch = bag.rollBatch
	local getLastBatch = bag.getLastBatch
	local getGroupAxes = bag.getGroupAxes
	local getResetOnUncheck = bag.getResetOnUncheck
	local getOrInitRetainedBatch = bag.getOrInitRetainedBatch

	-- Header blob (collapse arrow on the left, then tristate glyph, then label).
	local hdr = W.makeBlob("Section_" .. sectionUid, parent, UDim2.new(1, -8, 0, 22))
	W.addPadding(hdr, 4, 4, 0, 0)
	local glyph = Instance.new("TextButton")
	glyph.Name = "Glyph"
	glyph.BackgroundTransparency = 1
	glyph.Text = "[ ]"
	glyph.Font = Th.Font; glyph.TextSize = 11; glyph.TextColor3 = Th.Gold
	glyph.TextXAlignment = Enum.TextXAlignment.Left
	-- Glyph box trimmed to bracket text width so [ ] sits adjacent to the label.
	glyph.Position = UDim2.new(0, 16, 0, 0); glyph.Size = UDim2.new(0, 16, 1, 0)
	glyph.Parent = hdr
	local label = W.makeLabel("L", hdr, headerText, Th.Gold, Th.Font, 11)
	label.Position = UDim2.new(0, 34, 0, 0)
	label.Size = UDim2.new(1, -38, 1, 0)

	-- Section body holds the per-prop rows; collapse arrow toggles its visibility.
	local sectionBody = Instance.new("Frame")
	sectionBody.Name = "Body_" .. sectionUid
	sectionBody.BackgroundTransparency = 1
	sectionBody.AutomaticSize = Enum.AutomaticSize.Y
	sectionBody.Size = UDim2.new(1, -8, 0, 0)
	sectionBody.Parent = parent
	W.addListLayout(sectionBody, 4, Enum.FillDirection.Vertical)
	W.addCollapseButton(hdr, {sectionBody}, {anchorLeft = true, arrowPos = UDim2.new(0, 0, 0, 0)})

	-- Cache composite keys + per-header refresh closure.
	local sectionComps = {}
	for _, propKey in ipairs(sec.props) do
		table.insert(sectionComps, _compKey(sectionTypeName, propKey))
	end
	_sectionProps[sectionUid] = sectionComps
	local sectionPropsRef = sec.props
	_sectionHeaderRefresh[sectionUid] = function()
		_refreshHeaderGlyph(sectionUid, glyph)
	end

	local rowToggles = {}
	for _, propKey in ipairs(sec.props) do
		local rowComp = _compKey(sectionTypeName, propKey)
		local row = Instance.new("Frame")
		row.Name = "Row_" .. rowComp
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, 22)
		row.Parent = sectionBody

		-- Label may carry "(mixed link)" qualifier if items in the same type disagree
		-- on whether this axis is linked to a primary.
		local labelText = propKey
		if _hasMixedLinkState(sectionTypeName, propKey) then
			labelText = labelText .. "  (mixed link)"
		end

		-- Row blob spans the full row; toggle (and palette dropdown for ColorSequence
		-- rows) overlay the right end. Probe via Rules.derive so PE Color (no
		-- TypeRegistry entry / no propDef) still surfaces the palette dropdown  -  derive's
		-- PE branch reports colorSequence.
		local typeDef = TypeRegistry.Types[sectionTypeName]
		local pd = typeDef and typeDef.properties and typeDef.properties[propKey]
		local probeRule = Rules.derive(sectionTypeName, propKey, pd)
		local isColorSeq = probeRule and probeRule.colorSequence
		-- Inside-padding right value reserves space for toggle (28w + 4 margin) and
		-- palette dropdown (84w + 8 margin) when present, so text doesn't overlap them.
		local rightPad = isColorSeq and 122 or 34

		local labelBlob = W.makeBlob("LabelBlob_"..rowComp, row, UDim2.new(1, 0, 1, -2))
		labelBlob.Position = UDim2.new(0, 0, 0, 1)
		W.addPadding(labelBlob, 14, rightPad, 0, 0)
		W.makeLabel("L", labelBlob, labelText, Th.MutedGold, Th.Font, 10)

		if isColorSeq then
			local current = _paletteMode[rowComp] or "Auto"
			local _, dd, setOnChanged = W.makeDropdown(
				"Pal_" .. rowComp, row,
				Rules.PALETTE_MODES, current
			)
			dd.Size = UDim2.new(0, 84, 0, 18)
			dd.Position = UDim2.new(1, -116, 0.5, -9)
			setOnChanged(function(modeName)
				_paletteMode[rowComp] = modeName ~= "Auto" and modeName or nil
				if _checked[rowComp] and getLastBatch() then _rollBatch() end
			end)
		end

		local toggle = W.makeToggle("Rand_" .. rowComp, row)
		toggle.Position = UDim2.new(1, -26, 0.5, -8)
		rowToggles[propKey] = toggle
		table.insert(_typeRowToggles[sectionTypeName], {comp = rowComp, toggle = toggle})

		-- IsOn handler: sync _checked. Uncheck: filter _lastBatch by typeName + matching
		-- origin (same family.primary if grouped, else propKey itself). Reset-on-uncheck
		-- ON: drop entries + restore + replay. OFF: MOVE entries to retained batch  - 
		-- they survive the next Roll's snapshot restore and commit on Apply.
		-- Re-check (on=true): drop matching entries from retained so the next Roll can
		-- generate fresh values without an old retained ghost write fighting them.
		local conn = toggle:GetAttributeChangedSignal("IsOn"):Connect(function()
			local on = toggle:GetAttribute("IsOn") == true
			_checked[rowComp] = on or nil
			local lastBatch = getLastBatch()
			-- Build origin set (same shape used by both uncheck and re-check).
			local family = getGroupAxes() and AXIS_TO_FAMILY[propKey]
			local originsToRemove = {}
			if family then
				local anySiblingChecked = false
				for _, axis in ipairs(family.all) do
					if axis ~= propKey and _checked[_compKey(sectionTypeName, axis)] then
						anySiblingChecked = true; break
					end
				end
				if not anySiblingChecked then originsToRemove[family.primary] = true end
			else
				originsToRemove[propKey] = true
			end

			if on then
				-- Re-check: move matching retained entries back into _lastBatch so
				-- Apply tracks them under the Randomize waypoint. If the user rolls
				-- next, _rollBatch rebuilds _lastBatch from scratch (overwriting
				-- these entries); if they don't, Apply still commits the live preview
				-- with proper undo coverage instead of silently leaving it untracked.
				if next(originsToRemove) then
					local retained = getOrInitRetainedBatch()
					local target = lastBatch
					for item, itemBatch in pairs(retained) do
						if _itemTypeName[item] == sectionTypeName then
							for axis, entry in pairs(itemBatch) do
								if entry.origin and originsToRemove[entry.origin] then
									if target then
										target[item] = target[item] or {}
										target[item][axis] = entry
									end
									itemBatch[axis] = nil
								end
							end
							if not next(itemBatch) then retained[item] = nil end
						end
					end
				end
			elseif lastBatch and next(originsToRemove) then
				local resetOn = getResetOnUncheck()
				local retained = (not resetOn) and getOrInitRetainedBatch() or nil
				for item, itemBatch in pairs(lastBatch) do
					if _itemTypeName[item] == sectionTypeName then
						for axis, entry in pairs(itemBatch) do
							if entry.origin and originsToRemove[entry.origin] then
								if retained then
									retained[item] = retained[item] or {}
									retained[item][axis] = entry
								end
								itemBatch[axis] = nil
							end
						end
						-- Prune emptied parent so Apply's _batchHasEntries check doesn't
						-- see a phantom item with no writes.
						if not next(itemBatch) then lastBatch[item] = nil end
					end
				end
				if resetOn then
					_restoreSnapshots()
					_replayBatch()
				end
			end
			if _sectionHeaderRefresh[sectionUid] then _sectionHeaderRefresh[sectionUid]() end
			if _typeHeaderRefresh[sectionTypeName] then _typeHeaderRefresh[sectionTypeName]() end
		end)
		table.insert(_toggleConns, conn)
	end

	-- Header tristate cycle: any-on -> all-off, else all-on. Each SetAttribute fires the
	-- corresponding row's IsOn handler which updates _checked + refreshes glyphs.
	local hdrConn = glyph.Activated:Connect(function()
		local anyOn = false
		for _, pk in ipairs(sectionPropsRef) do
			if _checked[_compKey(sectionTypeName, pk)] then anyOn = true; break end
		end
		local target = not anyOn
		for _, pk in ipairs(sectionPropsRef) do
			local t = rowToggles[pk]
			if t then t:SetAttribute("IsOn", target) end
		end
	end)
	table.insert(_toggleConns, hdrConn)
end

return M
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">RandomizerWiring</string>
              <string name="Source"><![CDATA[--[[
	RandomizerWiring  -  Part-Icles V5 Randomizer System
	Copyright (C) 2026 Qwinkle

	State machine for the modal Randomizer panel.

	Snapshot-preview-apply contract:
	  open(items)  -> snapshot items + FREEZE the item list (selection changes during
	                  preview don't leak writes to non-snapshotted items)
	  rollAll      -> restore snapshots, derive+roll+store batch per frozen item, write
	                  the batch (preview state always reflects fresh roll, no stale)
	  apply        -> Before waypoint, restore snapshots, write last batch once, After
	                  waypoint (history records ONE Apply transaction, not preview writes)
	  cancel/close -> restore snapshots, clear

	Rules.derive runs per item per actual TypeRegistry type. Items are frozen at open
	so preview writes can be restored-and-rerolled atomically. Toggle state listens to
	IsOn AttributeChanged (not stacked Activated) so Widgets.makeToggle's internal flip
	doesn't desync from _checked.
]]

-- Linked-follower detection must use the same sanitizer as the runtime
-- (AxisLinks.sanitize) so the panel agrees with what runtime treats as a follower.
-- Stale/manual bad attrs would otherwise trigger false "mixed link" warnings.
local AxisLinks = require(script.Parent.Parent.Part.AxisLinks)
local RandomizerSection = require(script.Parent.RandomizerSection)
local Cancel = require(script.Parent.Cancel)
local Selection = game:GetService("Selection")

return function(deps)
	local ctx = deps.ctx
	local panel = deps.panel
	local PropertyCatalog = deps.PropertyCatalog
	local Rules = deps.RandomizerRules
	local Writer = deps.RandomizerWriter
	local QOL = deps.QOL
	local TypeRegistry = deps.TypeRegistry
	local CHS = deps.ChangeHistoryService
	local PE_SECTIONS = deps.PE_SECTIONS or {}
	-- Widgets must be an explicit dep  -  ctx.UIBuilder.Widgets isn't exposed (UIBuilder
	-- doesn't re-export Widgets). Caller passes the module reference.
	local Widgets = deps.Widgets
	-- Theme accessor: caller passes the live theme table from UIBuilder. Fresh read each
	-- time the panel is populated picks up active theme changes.
	local Theme = deps.Theme

	local M = {}

	-- Frozen at open(); never mutated by selection changes during preview.
	local _items = nil           -- array of {item, typeName}
	local _snapshots = nil       -- {[item] = QOL.snapshotItem(item)}
	-- _checked tracks user prop selections for the current open session. Keys are
	-- "TypeName::PropKey" composites so per-type sections track ticks independently.
	local _checked = {}          -- {[compositeKey] = true|nil}
	-- _lastBatch: most recent roll. {[item] = {[propKey] = {value, rule}}}. Apply replays
	-- this against restored snapshots so the final committed state reflects exactly what
	-- the user sees in preview, no stale unchecked props.
	local _lastBatch = nil
	-- Retained batch: entries that were rolled on a checked row, then unchecked while
	-- Reset-on-uncheck was OFF. Survive across Rolls (replayed after snapshot restore
	-- in _rollBatch and _replayBatch) and commit on Apply. Re-checking a row drops its
	-- retained entries so the next Roll generates fresh.
	local _retainedBatch = nil
	local _open = false
	local _toggleConns = {}      -- to disconnect IsOn listeners on close
	-- Tristate section headers + per-section composite-key registry. _sectionProps[
	-- sectionUid] = array of "TypeName::PropKey" composites (sectionUid = typeName::
	-- categoryName), populated during build so header refresh can compute {none/some/
	-- all} state without re-walking PropertyCatalog.
	local _sectionProps = {}
	local _sectionHeaderRefresh = {}  -- {sectionUid -> function()}  -  updates header glyph
	-- Type-level tristate state. typeRowToggles[typeName] = {{comp, toggle}, ...}  - 
	-- collected from every row of every category for that type. Type-glyph click flips all.
	local _typeRowToggles = {}
	local _typeHeaderRefresh = {}  -- {typeName -> function()}  -  updates type glyph

	-- Mixed link-state detection + follower-skip. Both consult AxisLinks.sanitize so the
	-- panel sees the same {follower -> primary or nil} resolution the runtime uses.
	-- Stale/manual bad attrs (cross-group target, chain, cycle) are correctly treated
	-- as "unlinked"  -  runtime ignores them too, and the UI must agree.
	local AXIS_KEYS_LIST = {
		"SizeX", "SizeY", "SizeZ", "RotX", "RotY", "RotZ",
		"RotSpeedX", "RotSpeedY", "RotSpeedZ", "PosX", "PosY", "PosZ",
		"PosOffsetX", "PosOffsetY", "PosOffsetZ",
	}
	local AXIS_PROPS = {}
	for _, k in ipairs(AXIS_KEYS_LIST) do AXIS_PROPS[k] = true end

	-- Group axes magnitude family. When _groupAxes is true (default ON), the roll visits
	-- each axis family at most once per type per Roll All: one base value rolled via the
	-- family's primary (X-axis) prop, then written to X/Y/Z (with linked-follower auto-
	-- promote per item via _writeOrPromote). Off: independent roll per checked axis prop.
	-- Toggle is session-scoped (re-armed to default on open).
	local AXIS_FAMILIES = {
		{primary = "SizeX",      all = {"SizeX", "SizeY", "SizeZ"}},
		{primary = "RotX",       all = {"RotX", "RotY", "RotZ"}},
		{primary = "RotSpeedX",  all = {"RotSpeedX", "RotSpeedY", "RotSpeedZ"}},
		{primary = "PosX",       all = {"PosX", "PosY", "PosZ"}},
		{primary = "PosOffsetX", all = {"PosOffsetX", "PosOffsetY", "PosOffsetZ"}},
	}
	local AXIS_TO_FAMILY = {}
	for _, fam in ipairs(AXIS_FAMILIES) do
		for _, axis in ipairs(fam.all) do AXIS_TO_FAMILY[axis] = fam end
	end
	local _groupAxes = false
	-- When ON, NumberSequence rolls produce 3..7 keypoints and ColorSequence rolls
	-- produce 3..6 palette-honoring keypoints. When OFF, both reduce to a 2-keypoint
	-- roll (start + end)  -  palette still constrains start/end colors. Default OFF  - 
	-- start with the simpler shape.
	local _randomizeKeypoints = false
	-- When ON (default), unchecking a row reverts that prop on the live preview.
	-- When OFF, unchecking just drops the prop from _lastBatch so Apply skips it  -  the
	-- already-rolled visual remains so the user can keep what they rolled while randomizing
	-- something else. Either way, Apply restores snapshots before replay so unchecked
	-- props are NEVER committed.
	local _resetOnUncheck = true
	-- Per-row palette mode override for ColorSequence props. Map from bucketKey (propKey)
	-- to mode name string. Nil / "Auto" entries fall through to the algorithmic weighted
	-- random (RandomizerRules.pickColorMode). Session-scoped  -  re-armed on open(). Mode
	-- change triggers a full _rollBatch so cached buckets invalidate cleanly.
	local _paletteMode = {}

	-- Per-item sanitized link map cache. Populated lazily on first query and reused by
	-- `_hasMixedLinkState` (panel label) and the per-item write path inside `_rollBatch`
	-- (linked-follower auto-promote). Cleared in _teardown + open so stale entries don't
	-- leak into the next session (different selection, possibly different attrs).
	local _resolvedLinks = {}  -- {[item] = AxisLinks.sanitize(raw) | "none"}

	-- Per-type sectioning. _checked is keyed by composite "TypeName::PropKey" so the
	-- panel mirrors Properties' per-type structure  -  checking "Part PosX" doesn't auto-
	-- check "Beam PosX". _itemTypeName mirrors _items for fast item->typeName lookup
	-- inside the uncheck cleanup pass (so we filter _lastBatch by item type when
	-- dropping writes for an unchecked composite).
	local _itemTypeName = {}  -- {[item]=typeName}, populated in open()
	local function _compKey(typeName, propKey) return typeName .. "::" .. propKey end
	local function _splitComp(comp) return comp:match("^(.-)::(.+)$") end

	local function _resolveLinksFor(item)
		local cached = _resolvedLinks[item]
		if cached == "none" then return nil end
		if cached then return cached end
		local config = TypeRegistry.getConfig(item)
		if not config then _resolvedLinks[item] = "none"; return nil end
		local raw = {}
		for _, k in ipairs(AXIS_KEYS_LIST) do raw[k] = config:GetAttribute(k .. "LinkedTo") end
		local resolved = AxisLinks.sanitize(raw)
		_resolvedLinks[item] = resolved
		return resolved
	end

	-- Auto-promote: _rollBatch uses `resolved[axis]` directly inside _writeOrPromote
	-- (per-item write path), so linked followers redirect their write to the primary
	-- axis instead of being silently dropped. Follower-only selection without primary
	-- is honored: a checked SizeY on an item with SizeYLinkedTo=SizeX produces a write
	-- to SizeX with the rolled value, not a no-op.
	-- typeName param so a per-type section's "(mixed link)" annotation only compares
	-- items of that type  -  mixed-link warning is meaningless under per-type sectioning
	-- (each section's checks affect only one type).
	local function _hasMixedLinkState(typeName, propKey)
		if not AXIS_PROPS[propKey] or not _items then return false end
		local linkedSeen, unlinkedSeen = false, false
		for _, e in ipairs(_items) do
			if e.typeName ~= typeName then continue end
			-- Trail items use directAccess (no Configuration)  -  skipped by _resolveLinksFor.
			local resolved = _resolveLinksFor(e.item)
			if resolved then
				if resolved[propKey] ~= nil then linkedSeen = true else unlinkedSeen = true end
				if linkedSeen and unlinkedSeen then return true end
			end
		end
		return false
	end

	-- Reverse-lookup typeName for a TypeRegistry-backed item.
	local function _typeNameFor(item)
		local typeDef = TypeRegistry.getTypeFor(item)
		if not typeDef then return nil end
		for _, name in ipairs(PropertyCatalog.TYPE_NAMES) do
			if TypeRegistry.Types[name] == typeDef then return name end
		end
		return nil
	end

	-- Build {item, typeName} list from current selection. Raw PEs included  - 
	-- RandomizerRules.derive has a PE branch, snapshots via QOL handle native PE props,
	-- Writer routes to native property assignment when rule.nativePE.
	local function _collectFromSelection()
		local list = {}
		for _, item in ipairs(ctx.currentTransformed or {}) do
			local typeName = _typeNameFor(item)
			if typeName then table.insert(list, {item = item, typeName = typeName}) end
		end
		for _, trail in ipairs(ctx.selectedTrails or {}) do
			table.insert(list, {item = trail, typeName = "Trail"})
		end
		for _, pe in ipairs(ctx.selectedPEs or {}) do
			table.insert(list, {item = pe, typeName = "PE"})
		end
		-- BeamNative (plain Beam, directAccess) intentionally excluded: no graph / axis props
		-- to randomize. Promote via Transform → emitter Beam to get randomizable graphs.
		return list
	end

	-- Scoped restore. Reverts only props Randomizer wrote (tracked via _lastBatch +
	-- _retainedBatch) so manual edits made via the Property panel while Randomizer
	-- was open survive Roll / Apply / SelectionChanged. Same data-loss-safe path
	-- M.cancel uses; routes through Modules/Randomizer/Cancel.luau.
	local function _restoreSnapshots()
		if not _snapshots then return end
		Cancel.restoreTouchedOnly({
			snapshots = _snapshots,
			lastBatch = _lastBatch,
			retainedBatch = _retainedBatch,
			QOL = QOL,
		})
	end

	-- Nested itemBatch may end up empty after uncheck/re-check pruning; check inner
	-- tables instead of just the outer key set.
	local function _batchHasEntries(batch)
		if not batch then return false end
		for _, itemBatch in pairs(batch) do if next(itemBatch) then return true end end
		return false
	end

	-- Replay retained then _lastBatch against restored snapshots. Last-write-wins on
	-- overlap so a fresh roll overwrites its previously-retained entry.
	local function _writeBatch(batch)
		if not batch then return end
		for item, itemBatch in pairs(batch) do
			if item.Parent then
				for propKey, entry in pairs(itemBatch) do
					Writer.write(item, propKey, entry.value, entry.rule)
				end
			end
		end
	end
	local function _replayBatch() _writeBatch(_retainedBatch); _writeBatch(_lastBatch) end

	-- Compute a fresh batch + apply preview writes. Restores snapshots first so Roll
	-- always start from the original baseline; only checked props get fresh values. Unchecked
	-- props stay at their snapshot values (no stale leftovers from previous rolls).
	-- Multi-selection coordination. _rollBatch is split into two phases:
	--   Phase 1  -  roll once per (typeName, bucketKey) bucket. bucketKey is family.primary
	--             when groupAxes is on AND propKey is in an axis family, else propKey itself.
	--             rolls cached so item B reuses the value rolled for item A's same bucket
	--             (independent-per-item rolling is not currently supported).
	--   Phase 2  -  per item, walk checked props (or families when grouped). For each axis,
	--             apply linked-follower auto-promote: if the item has the axis linked to a
	--             primary, write the primary instead with the rolled value. Skip absent
	--             props per type (Attachment lacks SizeX/Y/Z, etc.).
	-- _lastBatch records the literal (axis -> {value, rule}) writes done so Apply replays
	-- exactly the same writes (incl. promoted primaries).
	local function _rollBatch()
		if not _items or not _snapshots then return end
		-- Clear the resolved-link cache so AxisLink edits made in the Properties
		-- panel between rolls take effect on the next roll.
		_resolvedLinks = {}
		_restoreSnapshots()
		-- Replay retained (Reset-on-uncheck-OFF) entries first so pinned values stay
		-- visible. Then generate fresh _lastBatch for currently-checked composites;
		-- new writes overwrite retained ones if the same prop ends up in both.
		_writeBatch(_retainedBatch)
		_lastBatch = {}

		-- Phase 1 caches: (typeName, bucketKey) -> {value, rule} or false (rule absent).
		-- Do NOT early-reject when propDef is nil. Virtual emit attrs (EmitCount/EmitDelay/
		-- EmitDuration) live as item-level attributes  -  they have no entry in TypeRegistry.
		-- properties. RandomizerRules.derive handles them via the override.virtualEmitAttr
		-- branch in _decorateOverride (returns a scalar rule with the virtualEmitAttr flag
		-- set so RandomizerWriter dispatches via item:SetAttribute).
		local rolledBuckets = {}
		local function _ensureBucketRoll(typeName, bucketKey)
			rolledBuckets[typeName] = rolledBuckets[typeName] or {}
			local cache = rolledBuckets[typeName]
			local cached = cache[bucketKey]
			if cached ~= nil then return cached or nil end
			local typeDef = TypeRegistry.Types[typeName]
			local propDef = typeDef and typeDef.properties and typeDef.properties[bucketKey]
			-- Pass propDef even when nil; derive's virtualEmitAttr branch doesn't need it.
			local rule = Rules.derive(typeName, bucketKey, propDef)
			if not rule then cache[bucketKey] = false; return nil end
			-- Palette mode is keyed by composite (typeName::propKey) so per-type rows
			-- pick their own palette without cross-talk.
			if rule.colorSequence and _paletteMode[_compKey(typeName, bucketKey)] then
				rule.paletteMode = _paletteMode[_compKey(typeName, bucketKey)]
			end
			-- Stamp the keypoint-count toggle onto the rule so NumberSequence /
			-- ColorSequence rollers can fall back to the simpler 2-keypoint shape when off.
			rule.randomizeKeypoints = _randomizeKeypoints
			local value = Rules.roll(rule)
			if value == nil then cache[bucketKey] = false; return nil end
			local entry = {value = value, rule = rule}
			cache[bucketKey] = entry
			return entry
		end

		-- Families touched are per-typeName (composite-key _checked). Item B of type
		-- Beam shouldn't have its X/Y/Z rolled because user checked Part SizeX.
		local familyTouchedByType = {}  -- {[typeName]={[primary]=true}}
		if _groupAxes then
			for comp, on in pairs(_checked) do
				if on then
					local tn, pk = _splitComp(comp)
					if tn and pk and AXIS_TO_FAMILY[pk] then
						familyTouchedByType[tn] = familyTouchedByType[tn] or {}
						familyTouchedByType[tn][AXIS_TO_FAMILY[pk].primary] = true
					end
				end
			end
		end

		for _, e in ipairs(_items) do
			if not e.item.Parent then continue end
			local itemBatch = {}
			local typeName = e.typeName
			local typeDef = TypeRegistry.Types[typeName]
			local resolved = _resolveLinksFor(e.item)
			-- Collect this type's checked propKeys (drop other types' composites).
			local typeChecked = {}  -- {[propKey]=true}
			for comp, on in pairs(_checked) do
				if on then
					local tn, pk = _splitComp(comp)
					if tn == typeName and pk then typeChecked[pk] = true end
				end
			end
			-- Skip the per-item write loops entirely when nothing is checked for this type.
			if not next(typeChecked) then continue end

			-- Write a single (item, axis, entry) honoring linked-follower auto-promote,
			-- absent-prop guard, and direct-vs-promoted ordering. `origin` records which
			-- checked propKey (or family.primary
			-- in grouped mode) initiated the write  -  drives the uncheck cleanup pass. Virtual
			-- emit attrs (entry.rule.virtualEmitAttr) bypass the absent-prop guard AND the
			-- link-promotion path (item-level attrs, AxisLinks doesn't apply).
			--
			-- mode:
			--   "any"       -  write target = resolved follower (if any) else axis (used by
			--                grouped path where family.all iterates primary-first, so
			--                ordering is deterministic).
			--   "direct"    -  skip linked followers entirely (Pass 1 of ungrouped). Direct
			--                check writes its own axis. Linked-follower writes are deferred
			--                to Pass 2 so direct check always wins ownership of the target.
			--   "promoted"  -  only writes linked followers, AND only if the promoted target
			--                is still absent in itemBatch (Pass 2 of ungrouped).
			local function _writeOrPromote(axis, origin, entry, mode)
				mode = mode or "any"
				local isVirtual = entry.rule and entry.rule.virtualEmitAttr
				-- nativePE bypass mirrors virtualEmitAttr  -  PE has no TypeRegistry entry,
				-- so the absent-prop guard would reject every PE write. Rules.derive
				-- already validated the prop via PE_PROP_TYPES upstream.
				local isNativePE = entry.rule and entry.rule.nativePE
				if not isVirtual and not isNativePE
					and not (typeDef and typeDef.properties and typeDef.properties[axis]) then
					return
				end
				local link = (not isVirtual) and (not isNativePE) and resolved and resolved[axis] or nil
				if mode == "direct" and link then return end
				if mode == "promoted" and (isVirtual or not link) then return end
				local target
				if isVirtual then
					target = axis
				elseif link and (mode == "any" or mode == "promoted") then
					target = link
				else
					target = axis
				end
				if itemBatch[target] then return end
				itemBatch[target] = {value = entry.value, rule = entry.rule, origin = origin}
				Writer.write(e.item, target, entry.value, entry.rule)
			end

			if _groupAxes then
				-- Grouped: families with any checked axis roll ONCE per family per type.
				-- All 3 axes in family.all share the rolled value (subject to absent-prop
				-- skip + linked-follower auto-promote per item). Origin = family.primary so
				-- a later uncheck of the LAST family axis can find + drop these entries.
				local typeFamilies = familyTouchedByType[typeName] or {}
				for primary, _ in pairs(typeFamilies) do
					local family = AXIS_TO_FAMILY[primary]
					local entry = _ensureBucketRoll(typeName, primary)
					if entry then
						for _, axis in ipairs(family.all) do _writeOrPromote(axis, primary, entry) end
					end
				end
				-- Non-axis checked props share the bucket model too. Origin = propKey.
				for propKey, _on in pairs(typeChecked) do
					if not AXIS_TO_FAMILY[propKey] then
						local entry = _ensureBucketRoll(typeName, propKey)
						if entry then _writeOrPromote(propKey, propKey, entry) end
					end
				end
			else
				-- Ungrouped: every checked prop rolls into its own bucket. Auto-promote
				-- still applies  -  a checked follower writes the primary for that item.
				-- Origin = propKey (the checked source), even when the WRITE target is a
				-- different prop due to follower promotion.
				--
				-- Two-pass for direct vs promoted determinism. If SizeX and SizeY are both
				-- checked AND item has SizeYLinkedTo=SizeX, both want to target SizeX.
				-- pairs() ordering is nondeterministic  -  first-write-wins could let the
				-- follower-promoted SizeY value beat the direct SizeX value. Pass 1 writes
				-- directly (allowPromote=false), Pass 2 promotes only if the target is
				-- still absent. Direct check beats promotion every time.
				for propKey, _on in pairs(typeChecked) do
					local entry = _ensureBucketRoll(typeName, propKey)
					if entry then _writeOrPromote(propKey, propKey, entry, "direct") end
				end
				for propKey, _on in pairs(typeChecked) do
					local entry = _ensureBucketRoll(typeName, propKey)
					if entry then _writeOrPromote(propKey, propKey, entry, "promoted") end
				end
			end

			if next(itemBatch) then _lastBatch[e.item] = itemBatch end
		end
	end

	-- Set-equality guard  -  Studio's UI can briefly clear and restore Selection during
	-- a click; we only reinit when the effective items table actually differs. Compares
	-- by item identity AND typeName so a re-classification (e.g. type swap on the same
	-- instance) still triggers a refresh.
	local function _sameItems(a, b)
		if not a or not b or #a ~= #b then return false end
		local seen = {}
		for _, e in ipairs(a) do seen[e.item] = e.typeName end
		for _, e in ipairs(b) do
			if seen[e.item] ~= e.typeName then return false end
			seen[e.item] = nil
		end
		return true
	end

	-- Shared (re)initialization for items + snapshots. Accepts optional pre-collected
	-- items list so SelectionChanged callers don't collect twice.
	-- Selection delta filter: composite keys are "TypeName::PropKey". When the
	-- selection changes, only drop entries whose TypeName no longer appears in
	-- the new selection  -  ticks on still-present types must survive so the user
	-- doesn't lose state by extending the selection.
	local function _reinitFromSelection(precollected)
		_restoreSnapshots()
		local items = precollected or _collectFromSelection()
		_items = items
		_snapshots = {}
		_itemTypeName = {}
		local typeNamesPresent = {}
		for _, e in ipairs(_items) do
			_snapshots[e.item] = QOL.snapshotItem(e.item)
			_itemTypeName[e.item] = e.typeName
			typeNamesPresent[e.typeName] = true
		end
		_lastBatch = nil
		_retainedBatch = nil
		_resolvedLinks = {}
		for compositeKey in pairs(_checked) do
			local typeName = compositeKey:match("^([^:]+)::")
			if not (typeName and typeNamesPresent[typeName]) then _checked[compositeKey] = nil end
		end
		for compositeKey in pairs(_paletteMode) do
			local typeName = compositeKey:match("^([^:]+)::")
			if not (typeName and typeNamesPresent[typeName]) then _paletteMode[compositeKey] = nil end
		end
	end

	-- Live selection refresh. Disconnected on teardown.
	local _selectionConn = nil

	function M.open()
		if _open then return end -- prevent double-open
		-- Open even when the selection has no transformed items. Empty panel is an OK
		-- parked state; the user can refine selection and reopen when ready.
		_snapshots = nil  -- ensure _reinitFromSelection's restore is a no-op on first init
		_reinitFromSelection()
		-- Group axes defaults ON. Each session opens with the toggle armed; user opts
		-- OUT if they want independent per-axis rolls. _checked / _paletteMode /
		-- _resolvedLinks already cleared by _reinitFromSelection.
		_groupAxes = true
		_randomizeKeypoints = false
		_resetOnUncheck = true
		_open = true
		M.populateSections()
		panel.panel.Visible = true
		-- Defer the listener body. RBXScriptSignal connection order isn't guaranteed,
		-- so without defer this listener can fire before the plugin's main selection
		-- listener has refreshed ctx.currentTransformed  -  leaving the panel one step
		-- behind the user's actual selection (e.g. select 2 → no change, select 3 →
		-- shows "2 selected"). Defer to the next resumption so handleSelection has
		-- finished updating ctx before we read it.
		if _selectionConn then _selectionConn:Disconnect() end
		_selectionConn = Selection.SelectionChanged:Connect(function()
			task.defer(function()
				if not _open then return end
				local nextItems = _collectFromSelection()
				if _sameItems(_items or {}, nextItems) then return end
				_reinitFromSelection(nextItems)
				M.populateSections()
			end)
		end)
	end

	function M.rollAll() _rollBatch() end

	function M.apply()
		if not _open then return end
		-- Skip waypoints when both batches are empty. Walks nested itemBatch tables
		-- since `next()` on the outer table alone passes for `{[item]={}}`.
		if not _batchHasEntries(_lastBatch) and not _batchHasEntries(_retainedBatch) then
			M._teardown()
			return
		end
		CHS:SetWaypoint("Part-Icles: Before Randomize")
		-- Restore baseline + replay both retained AND last batches atomically so undo
		-- captures one diff and so retained pinned values commit alongside fresh rolls.
		_restoreSnapshots()
		_replayBatch()
		CHS:SetWaypoint("Part-Icles: Randomize")
		M._teardown()
	end

	function M.cancel()
		if not _open then return end
		-- Scoped restore (Modules/Randomizer/Cancel.luau): only revert props the
		-- Randomizer wrote during this open session, so unrelated edits survive.
		Cancel.restoreTouchedOnly({
			snapshots = _snapshots,
			lastBatch = _lastBatch,
			retainedBatch = _retainedBatch,
			QOL = QOL,
		})
		M._teardown()
	end

	-- Palette dropdown's expanded options frame parents to ScreenGui (escapes ScrollingFrame
	-- clipping); hiding the panel doesn't destroy it. AND makeDropdown toggles the ancestor
	-- ScrollingFrame's `ScrollingEnabled` on MouseEnter/Leave so MouseWheel only cycles
	-- dropdown options instead of scrolling the section list  -  if populate or teardown fires
	-- while the cursor is on the dropdown, MouseLeave never runs and the scroll stays stuck.
	-- Helper pairs the dismiss with the defensive restore so both call sites (populateSections
	-- and _teardown) stay in sync.
	local function _closeDropdownUi()
		if Widgets.hideDropdownExpansion then Widgets.hideDropdownExpansion() end
		if panel.sectionList then panel.sectionList.ScrollingEnabled = true end
	end

	function M._teardown()
		_snapshots = nil
		_items = nil
		_itemTypeName = {}
		_lastBatch = nil
		_retainedBatch = nil
		_checked = {}
		_open = false
		for _, conn in ipairs(_toggleConns) do conn:Disconnect() end
		_toggleConns = {}
		_resolvedLinks = {}  -- clear sanitized-link cache so next open re-reads attrs
		-- Drop the SelectionChanged hook so closed panels stop reacting.
		if _selectionConn then _selectionConn:Disconnect(); _selectionConn = nil end
		_closeDropdownUi()
		panel.panel.Visible = false
	end

	-- Read accessor for UI populate. Takes (typeName, propKey)  -  composite key.
	function M.isChecked(typeName, propKey) return _checked[_compKey(typeName, propKey)] == true end
	-- Read accessor so toolbar can branch open/cancel.
	function M.isOpen() return _open end

	-- Recompute a section header's tristate glyph from current _checked. Called whenever any
	-- contained-row toggle flips OR when the user clicks the header itself.
	local function _refreshHeaderGlyph(sectionName, glyphLabel)
		local props = _sectionProps[sectionName]
		if not props or #props == 0 then glyphLabel.Text = "[ ]"; return end
		local on = 0
		for _, k in ipairs(props) do if _checked[k] then on = on + 1 end end
		if on == 0 then glyphLabel.Text = "[ ]"
		elseif on == #props then glyphLabel.Text = "[X]"
		else glyphLabel.Text = "[~]" end
	end

	-- Build sectionList. Listens for IsOn AttributeChanged on each Widgets.makeToggle so
	-- _checked stays in sync without stacking another Activated handler.
	-- UI polish:
	--   - Tristate section headers via a TextButton glyph ([ ] / [~] / [X]). Click cycles
	--     all-or-none (off if any-on, else on for every prop in the section).
	--   - Mixed link-state qualifier appended to axis-prop row labels when items in the
	--     frozen selection disagree on link state.
	function M.populateSections()
		-- Rebuilding rows must dismiss any open palette dropdown AND restore the section
		-- ScrollingFrame's `ScrollingEnabled` (in case populate fires while cursor is on
		-- the dropdown  -  same edge case as _teardown). _closeDropdownUi pairs both.
		_closeDropdownUi()
		for _, child in ipairs(panel.sectionList:GetChildren()) do
			if child:IsA("TextLabel") or child:IsA("Frame") then child:Destroy() end
		end
		for _, conn in ipairs(_toggleConns) do conn:Disconnect() end
		_toggleConns = {}
		_sectionProps = {}
		_sectionHeaderRefresh = {}
		_typeRowToggles = {}
		_typeHeaderRefresh = {}
		-- Tree-style sections  -  top-level type header ("TypeName (N selected)") with
		-- category sub-headers (Spawning / Appearance / ...) underneath. Mirrors
		-- Properties panel hierarchy. typesInSel gates `randomizableSectionsByType` so
		-- other types' props don't render. countByType drives the per-type-header count.
		local typesInSel = {}
		local countByType = {}
		if _items then
			for _, e in ipairs(_items) do
				typesInSel[e.typeName] = true
				countByType[e.typeName] = (countByType[e.typeName] or 0) + 1
			end
		end
		local sections = PropertyCatalog.randomizableSectionsByType(TypeRegistry, PE_SECTIONS, Rules, typesInSel)
		local Th = Theme
		local W = Widgets

		-- Top-row "Group axes" toggle. Defaults ON; M.open() re-arms `_groupAxes = true`
		-- each session. Tooltip-style label clarifies that this couples X/Y/Z to a
		-- single magnitude family rolled once per (typeName, family). Blob-wrapped to
		-- match Settings AERow / Shortcut row convention.
		local groupRow = W.makeBlob("GroupAxesRow", panel.sectionList, UDim2.new(1, -8, 0, 22))
		groupRow.LayoutOrder = -1  -- ensure ordering above sections
		W.addPadding(groupRow, 8, 4, 0, 0)
		local groupLbl = W.makeLabel("L", groupRow, "Group axes (X/Y/Z share one rolled value)",
			Th.MutedGold, Th.Font, 9)
		groupLbl.Size = UDim2.new(1, -28, 1, 0)
		local groupToggle = W.makeToggle("GroupAxes", groupRow)
		groupToggle.Position = UDim2.new(1, -26, 0.5, -8)
		groupToggle:SetAttribute("IsOn", _groupAxes)
		local groupConn = groupToggle:GetAttributeChangedSignal("IsOn"):Connect(function()
			_groupAxes = groupToggle:GetAttribute("IsOn") == true
			-- Drop the retained batch on flip  -  its entries were keyed by origins
			-- under the OLD grouping convention (family.primary when grouped, raw
			-- propKey otherwise). Keeping them through a flip means the re-check
			-- pruning matches against new origins and silently leaks old writes
			-- through Apply. Reset to baseline + re-roll so the user sees the
			-- grouped/ungrouped variant from a clean slate.
			_retainedBatch = nil
			_restoreSnapshots()
			if _lastBatch then _rollBatch() end
		end)
		table.insert(_toggleConns, groupConn)

		-- Top-row "Randomize Keypoint Count" toggle. OFF (default):
		-- NumberSequence emits 2 keypoints (start + end with random envelopes);
		-- ColorSequence emits 2 palette-honoring keypoints. ON: NumberSequence emits 3..7
		-- keypoints; ColorSequence emits 3..6 palette-honoring keypoints. Either way the
		-- palette dropdown stays meaningful  -  it controls hue family in both shapes.
		local kpRow = W.makeBlob("RandomizeKeypointsRow", panel.sectionList, UDim2.new(1, -8, 0, 22))
		kpRow.LayoutOrder = -1
		W.addPadding(kpRow, 8, 4, 0, 0)
		local kpLbl = W.makeLabel("L", kpRow, "Randomize Keypoint/ColorSequence Count",
			Th.MutedGold, Th.Font, 9)
		kpLbl.Size = UDim2.new(1, -28, 1, 0)
		local kpToggle = W.makeToggle("RandomizeKeypoints", kpRow)
		kpToggle.Position = UDim2.new(1, -26, 0.5, -8)
		kpToggle:SetAttribute("IsOn", _randomizeKeypoints)
		local kpConn = kpToggle:GetAttributeChangedSignal("IsOn"):Connect(function()
			_randomizeKeypoints = kpToggle:GetAttribute("IsOn") == true
			if _lastBatch then _rollBatch() end
		end)
		table.insert(_toggleConns, kpConn)

		-- Top-row "Reset to initial on uncheck" toggle. ON (default): unchecking
		-- a prop reverts the live preview to its snapshot value. OFF: unchecking just drops
		-- the prop from the apply-batch  -  already-rolled visual stays so the user can roll
		-- one prop, untick it (keeps showing), and roll another while still seeing both.
		-- Apply still skips unchecked props in either mode.
		local resetRow = W.makeBlob("ResetOnUncheckRow", panel.sectionList, UDim2.new(1, -8, 0, 22))
		resetRow.LayoutOrder = -1
		W.addPadding(resetRow, 8, 4, 0, 0)
		local resetLbl = W.makeLabel("L", resetRow, "Reset to initial on uncheck",
			Th.MutedGold, Th.Font, 9)
		resetLbl.Size = UDim2.new(1, -28, 1, 0)
		local resetToggle = W.makeToggle("ResetOnUncheck", resetRow)
		resetToggle.Position = UDim2.new(1, -26, 0.5, -8)
		resetToggle:SetAttribute("IsOn", _resetOnUncheck)
		local resetConn = resetToggle:GetAttributeChangedSignal("IsOn"):Connect(function()
			_resetOnUncheck = resetToggle:GetAttribute("IsOn") == true
			-- Flipping ON means "drop pending values on uncheck"  -  but uncheck-then-
			-- flip leaves a retained batch from the OFF era that Apply would still
			-- commit. Clear it + restore baseline so the toggle's user-promise holds.
			if _resetOnUncheck and _retainedBatch then
				_retainedBatch = nil
				_restoreSnapshots()
				_replayBatch()
			end
		end)
		table.insert(_toggleConns, resetConn)

		-- Bucket sections by typeName so we can emit a top-level type header once per
		-- type, then list that type's category sub-sections beneath it.
		local sectionsByType = {}
		local typeOrder = {}
		for _, sec in ipairs(sections) do
			if not sectionsByType[sec.typeName] then
				sectionsByType[sec.typeName] = {}
				table.insert(typeOrder, sec.typeName)
			end
			table.insert(sectionsByType[sec.typeName], sec)
		end
		for _, typeName in ipairs(typeOrder) do
			-- Type group is wrapped in a TypeContainer Frame so the type-level collapse
			-- arrow can hide everything beneath the type header in one flip. Container
			-- holds {typeHdr, typeChildren}. typeChildren holds all category section
			-- blobs + their sectionBody Frames. Collapse arrow on typeHdr toggles
			-- typeChildren visibility.
			local typeContainer = Instance.new("Frame")
			typeContainer.Name = "TypeContainer_"..typeName
			typeContainer.BackgroundTransparency = 1
			typeContainer.AutomaticSize = Enum.AutomaticSize.Y
			typeContainer.Size = UDim2.new(1, 0, 0, 0)
			typeContainer.Parent = panel.sectionList
			W.addListLayout(typeContainer, 4, Enum.FillDirection.Vertical)

			local typeHdr = W.makeBlob("Type_"..typeName, typeContainer, UDim2.new(1, -8, 0, 26))
			W.addPadding(typeHdr, 4, 4, 0, 0)
			-- Type-level tristate glyph (parent of all categories' rows for this type).
			local typeGlyph = Instance.new("TextButton")
			typeGlyph.Name = "TypeGlyph"
			typeGlyph.BackgroundTransparency = 1
			typeGlyph.Text = "[ ]"
			typeGlyph.Font = Th.Font; typeGlyph.TextSize = 12; typeGlyph.TextColor3 = Th.BrightGold
			typeGlyph.TextXAlignment = Enum.TextXAlignment.Left
			-- Tighter glyph spacing  -  bracket text only takes ~14px so a 28px box left
			-- huge gaps between [ ] and the label. Drop to 16px.
			typeGlyph.Position = UDim2.new(0, 16, 0, 0); typeGlyph.Size = UDim2.new(0, 16, 1, 0)
			typeGlyph.Parent = typeHdr
			-- Friendly display name from TypeRegistry uiSection. PE has no TypeRegistry
			-- entry (raw ParticleEmitter); BuildProperties banners it as "Particles"  - 
			-- mirror that here.
			local typeDef0 = TypeRegistry.Types[typeName]
			local displayName = (typeDef0 and typeDef0.uiSection)
				or (typeName == "PE" and "Particles")
				or typeName
			local typeLbl = W.makeLabel("L", typeHdr,
				("%s (%d selected)"):format(displayName, countByType[typeName] or 0),
				Th.BrightGold, Th.Font, 12)
			typeLbl.Position = UDim2.new(0, 34, 0, 0)
			typeLbl.Size = UDim2.new(1, -38, 1, 0)
			typeLbl.TextXAlignment = Enum.TextXAlignment.Left

			local typeChildren = Instance.new("Frame")
			typeChildren.Name = "TypeChildren_"..typeName
			typeChildren.BackgroundTransparency = 1
			typeChildren.AutomaticSize = Enum.AutomaticSize.Y
			typeChildren.Size = UDim2.new(1, 0, 0, 0)
			typeChildren.Parent = typeContainer
			W.addListLayout(typeChildren, 4, Enum.FillDirection.Vertical)
			-- Left-indent so categories visually nest under their type header.
			W.addPadding(typeChildren, 12, 0, 0, 0)
			W.addCollapseButton(typeHdr, {typeChildren}, {anchorLeft = true, arrowPos = UDim2.new(0, 0, 0, 0)})

			_typeRowToggles[typeName] = {}
			local typeNameRef = typeName
			local typeGlyphRef = typeGlyph
			_typeHeaderRefresh[typeName] = function()
				local lst = _typeRowToggles[typeNameRef]
				if not lst or #lst == 0 then typeGlyphRef.Text = "[ ]"; return end
				local on = 0
				for _, e in ipairs(lst) do if _checked[e.comp] then on = on + 1 end end
				typeGlyphRef.Text = (on == 0 and "[ ]") or (on == #lst and "[X]") or "[~]"
			end
			local typeGlyphConn = typeGlyph.Activated:Connect(function()
				local lst = _typeRowToggles[typeNameRef]
				if not lst then return end
				local anyOn = false
				for _, e in ipairs(lst) do if _checked[e.comp] then anyOn = true; break end end
				local target = not anyOn
				for _, e in ipairs(lst) do e.toggle:SetAttribute("IsOn", target) end
			end)
			table.insert(_toggleConns, typeGlyphConn)

			-- Per-section emission extracted to RandomizerSection sibling. Pass the bag
			-- of shared mutable refs + helpers; mutable scalars come through getters so
			-- the section's row closures see live values.
			local sectionBag = {
				W = W, Th = Th, TypeRegistry = TypeRegistry, Rules = Rules,
				checked = _checked, paletteMode = _paletteMode, itemTypeName = _itemTypeName,
				sectionProps = _sectionProps, sectionHeaderRefresh = _sectionHeaderRefresh,
				typeRowToggles = _typeRowToggles, typeHeaderRefresh = _typeHeaderRefresh,
				toggleConns = _toggleConns, AXIS_TO_FAMILY = AXIS_TO_FAMILY, compKey = _compKey,
				hasMixedLinkState = _hasMixedLinkState, refreshHeaderGlyph = _refreshHeaderGlyph,
				restoreSnapshots = _restoreSnapshots, replayBatch = _replayBatch, rollBatch = _rollBatch,
				getLastBatch = function() return _lastBatch end,
				getGroupAxes = function() return _groupAxes end,
				getResetOnUncheck = function() return _resetOnUncheck end,
				getOrInitRetainedBatch = function()
					_retainedBatch = _retainedBatch or {}
					return _retainedBatch
				end,
			}
			for _, sec in ipairs(sectionsByType[typeName]) do
				local sectionUid = _compKey(sec.typeName, sec.name)
				RandomizerSection.emit(sectionBag, sec, sec.typeName, sectionUid, sec.name, typeChildren)
			end
		end
		-- Empty-selection hint blob: distinguishes "empty" from "loading" when no
		-- type sections render. Non-interactive; follows the row blob convention.
		if #typeOrder == 0 then
			local emptyBlob = W.makeBlob("EmptyHint", panel.sectionList, UDim2.new(1, -8, 0, 22))
			W.addPadding(emptyBlob, 8, 4, 0, 0)
			local emptyLbl = W.makeLabel("L", emptyBlob,
				"No transformed items selected", Th.DarkGold, Th.Font, 10)
			emptyLbl.TextXAlignment = Enum.TextXAlignment.Left
		end
	end

	return M
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">RandomizerWriter</string>
              <string name="Source"><![CDATA[--[[
	RandomizerWriter  -  Part-Icles V5
	Copyright (C) 2026 Qwinkle

	Per-prop write dispatch for the Randomizer:

	- Virtual emit attrs (`virtualEmitAttr = true` in rule) -> `item:SetAttribute(propKey, value)`
	  because EmitCount/EmitDelay/EmitDuration live on the item, NOT in PartIcleProperties.
	- Everything else -> `TypeRegistry.write(item, propKey, value)` so attrName / nonNegative
	  / directAccess Trail dispatch all happen via the existing TypeRegistry pipeline.
	- For graph (NumberSequence / ColorSequence) writes, ALSO clear the `<propKey>_BezierHandles`
	  attribute on the Configuration. Old handles don't match new keypoints; leaving them in
	  place would make the Graph editor open with junk on next select.
]]

local TypeRegistry = require(script.Parent.Parent.Part.TypeRegistry)

local RandomizerWriter = {}

-- Per-rule write dispatch. Caller threads the rule from RandomizerRules.derive(...) so the
-- writer doesn't have to re-derive.
function RandomizerWriter.write(item, propKey, value, rule)
	if rule and rule.virtualEmitAttr then
		-- Item-level attribute; not in PartIcleProperties Configuration.
		pcall(function() item:SetAttribute(propKey, value) end)
		return
	end
	-- Native PE write  -  direct property assignment on the ParticleEmitter instance.
	-- PE has no Configuration child / TypeRegistry entry; props live as native
	-- ParticleEmitter members (Rate / Lifetime / Color / etc).
	if rule and rule.nativePE then
		local nativeOk = pcall(function() item[propKey] = value end)
		-- Clear stale Bezier handle JSON on the PE itself for graph rolls.
		-- Without this, GraphEditor._load() can resurrect the pre-randomize
		-- curve from the leftover handles instead of showing the new keypoints.
		if nativeOk and (rule.numberSequence or rule.colorSequence) then
			pcall(function() item:SetAttribute(propKey .. "_BezierHandles", nil) end)
		end
		return
	end
	-- stringForm rules (e.g. Trail Duration) store as a string; generator returns a number,
	-- writer tostring-wraps before TypeRegistry.write so the underlying string-attr accepts.
	local writeValue = value
	if rule and rule.stringForm and type(value) == "number" then
		writeValue = tostring(value)
	end
	-- TypeRegistry handles attrName overrides (BeamBrightness/PLRange/ImgFlipbookFramerate),
	-- nonNegative clamping, directAccess Trail native-property writes, and Configuration
	-- attribute writes for everything else. Wrapped in pcall so a single bad write doesn't
	-- abort a multi-prop Roll All.
	local writeOk = pcall(function() TypeRegistry.write(item, propKey, writeValue) end)

	-- Graph writes: clear stored Bezier handles ONLY after a successful TypeRegistry write.
	-- Otherwise a bad write would leave the prior valid graph in place but delete its handles.
	-- Handles attr is keyed by the LOGICAL prop key (matches the existing graph connector
	-- convention), not the attrName override.
	if writeOk and rule and (rule.numberSequence or rule.colorSequence) then
		-- Bezier handle attribute lives on the Configuration when one exists; on
		-- the item itself for raw ParticleEmitter / directAccess Trail.
		local target = TypeRegistry.getConfig(item) or item
		pcall(function() target:SetAttribute(propKey .. "_BezierHandles", nil) end)
	end
end

-- Convenience: write a batch of {[propKey] = {value, rule}} entries on one item. Useful for
-- the Randomize panel's apply path (Roll All -> snapshot per item -> writeBatch per item).
function RandomizerWriter.writeBatch(item, batch)
	for propKey, entry in pairs(batch) do
		RandomizerWriter.write(item, propKey, entry.value, entry.rule)
	end
end

return RandomizerWriter
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">Shortcuts</string>
            <string name="Source"><![CDATA[--[[
	Shortcuts  -  Part-Icles V5 ShortcutKey System
	Copyright (C) 2026 Qwinkle

	Barrel for the ShortcutKey system. Submodules:
	  - Bindings: storage + validation. DEFAULTS / SUGGESTED both empty (fresh
	    installs start unbound, no Apply-Suggested). Rejects modifier-only key combos
	    (e.g. plain Ctrl), malformed combos, and unimplemented actionIds at load.
	    Bare non-modifier keys (plain "I", "`", function keys) ARE allowed.
	  - Wiring: factory (deps -> {open, close, isOpen, isCapturing, populate, reset,
	    getSettings, ensureSettings, setOnChanged}). Panel state machine + capture flow.
	  - Bootstrap: attach(deps) wires Settings panel "Shortcuts" button + panel close,
	    primes settings via ensureSettings, then starts Runtime.
	  - Runtime: start(deps) -> {stop}. UIS.InputBegan dispatcher with comboKey reverse-
	    index rebuilt on every save (via wiring.setOnChanged). Focus gates: wiring.isOpen
	    / wiring.isCapturing / GetFocusedTextBox. The `gameProcessedEvent` gate is NOT
	    used because Studio sets it true for nearly every keyboard event in Edit mode,
	    silencing all dispatch. Routes through Dispatcher for 50ms dedup +
	    `def.implemented==true` second guard.

	Disabled / not shipped:
	  - PluginAction registration for Studio Customize Shortcuts is DISABLED under the
	    P-prefix leader policy (see PluginActions.luau). Studio cannot prove the user
	    pressed our P leader before firing Triggered, so any Studio-bound chord would
	    end-run the policy. PluginActions.register stays as a no-op stub so Bootstrap
	    doesn't need to know. PluginAction instances created by older plugin versions
	    may still appear in the dialog with inert bindings  -  users can clear them via
	    Customize Shortcuts.
	  - Apply-Suggested panel affordance + SUGGESTED catalog are not shipped. New
	    installs start unbound; users explicitly Bind each action they want.

	Cmd/Win display preference (manual, not OS-detected): the Roblox plugin API exposes
	no host-OS detection, so Cmd-vs-Win labeling can't be auto-driven from the platform.
	The plugin reads an opt-in setting `DisplayCmdAsMeta` (boolean). Wiring re-reads it
	on open() so flips take effect next session. There is no visible panel toggle yet  - 
	Mac users flip it via the Studio dev console:
	  plugin:SetSetting("DisplayCmdAsMeta", true)

	NOT user-script-reachable. Internal-only.
]]

-- task.wait between requires so Luraph VM bootstrap of each obfuscated submodule
-- spreads across frames.
local Bindings  = require(script.Bindings); task.wait()
local Wiring    = require(script.Wiring); task.wait()
local Bootstrap = require(script.Bootstrap); task.wait()
-- Runtime.start(deps) wires the UIS dispatcher. Builds a comboKey reverse-index
-- from wiring.getSettings(), rebuilds on save via wiring.setOnChanged, gates
-- dispatch on isOpen/isCapturing/GetFocusedTextBox.
local Runtime   = require(script.Runtime); task.wait()
-- Disabled no-op stub under the P-leader policy  -  see PluginActions.luau header.
-- Bootstrap still calls register(); the call returns {stop = function() end}.
local PluginActions = require(script.PluginActions); task.wait()
-- Shared dispatch chokepoint. Currently only Runtime calls Dispatcher.dispatch.
-- Per-action + global 50ms dedup preserved as future-proofing for any new
-- dispatch path.
local Dispatcher = require(script.Dispatcher); task.wait()

return {
	Bindings = Bindings,
	Wiring = Wiring,
	Bootstrap = Bootstrap,
	Runtime = Runtime,
	PluginActions = PluginActions,
	Dispatcher = Dispatcher,
}
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">Bindings</string>
              <string name="Source"><![CDATA[--[[
	Bindings  -  Part-Icles V5 ShortcutKey storage layer
	Copyright (C) 2026 Qwinkle

	Pure load / save / validate against the canonical plugin:GetSetting/SetSetting
	"Shortcuts" key (single key  -  avoids the period/backslash silent-failure issue
	from SetSetting).

	Storage shape:
	  {
	      version = 2,
	      overlayEnabled = true,
	      bindings = {
	          [actionId] = {key = "P", ctrl = true, alt = true, shift = false, meta = false},
	          ...
	      },
	  }

	Combo is structured (key + 4 modifier bools) NOT a stringified "Ctrl+Shift+P".
	String display is rendering-only; storage stays structured so we can validate.

	DEFAULTS / SUGGESTED are both empty. New users start with everything unbound and
	explicitly Bind each action they want via the Shortcuts panel  -  pre-binding even
	a few actions amounts to surprise global behavior.

	load() also enforces `def.implemented == true`: a hand-edited or older settings
	entry that preserves a stub binding gets dropped at load time with a warn.
	Runtime safety must NOT trust UI filtering.

	NOT user-script-reachable. Internal-only.
]]

local Bindings = {}

-- v2 schema  -  load() detects v1-saved bindings still on the v1 defaults and clears
-- them so the user lands on the unbound starting state. Custom user chords are
-- preserved unchanged.
Bindings.VERSION = 2

-- v1-era default chords  -  closed set so the migration only touches users still on
-- the unmodified original install. List-of-entries form because a single actionId
-- has multiple historical default chords (Ctrl-era then P-leader-era). Migration
-- nils raw.bindings[actionId] when the saved combo matches ANY entry  -  covers
-- users from both install windows.
local OLD_DEFAULTS_V1 = {
	-- Ctrl-era defaults
	{actionId = "ToggleUI",         combo = {key = "P", ctrl = true,  alt = true,  shift = false, meta = false}},
	{actionId = "ToggleInventory",  combo = {key = "I", ctrl = true,  alt = false, shift = true,  meta = false}},
	{actionId = "ToggleProperties", combo = {key = "R", ctrl = true,  alt = false, shift = true,  meta = false}},
	-- P-leader-era defaults
	{actionId = "ToggleUI",         combo = {key = "P", ctrl = false, alt = false, shift = false, meta = false}},
	{actionId = "ToggleInventory",  combo = {key = "I", ctrl = false, alt = false, shift = false, meta = false}},
	{actionId = "ToggleProperties", combo = {key = "R", ctrl = false, alt = false, shift = false, meta = false}},
}

-- All shortcuts start unbound; the user explicitly assigns combos via the Bind
-- button. SUGGESTED is also empty  -  no per-row "Sug" affordance.
Bindings.DEFAULTS = {}
Bindings.SUGGESTED = {}

-- Reject keys that are *only* a modifier  -  modifier-without-non-modifier never reaches
-- a meaningful combo (would fire on plain Ctrl press). Capture-state UX rejects these too.
local MODIFIER_ONLY_KEYS = {
	LeftControl = true, RightControl = true, LeftAlt = true, RightAlt = true,
	LeftShift = true, RightShift = true, LeftMeta = true, RightMeta = true,
	LeftSuper = true, RightSuper = true,
}

function Bindings.isValidCombo(combo)
	if type(combo) ~= "table" then return false end
	if type(combo.key) ~= "string" or combo.key == "" then return false end
	if type(combo.ctrl) ~= "boolean" then return false end
	if type(combo.alt) ~= "boolean" then return false end
	if type(combo.shift) ~= "boolean" then return false end
	if type(combo.meta) ~= "boolean" then return false end
	if MODIFIER_ONLY_KEYS[combo.key] then return false end
	-- P is the runtime leader. Runtime returns early on P keypress, so a "P" chord
	-- key would never dispatch  -  reject it at validation.
	if combo.key == "P" then return false end
	-- Bare-key bindings (e.g. plain "I" or "`") MUST work. We don't require ≥1
	-- modifier as a UX guardrail  -  if a user binds a viewport key and regrets it,
	-- they can rebind/unbind via the panel.
	-- KeyCode validation: if Enum.KeyCode[combo.key] doesn't resolve, reject. pcall the
	-- Enum index because Roblox Studio raises rather than returning nil on unknown names.
	local ok, kc = pcall(function() return Enum.KeyCode[combo.key] end)
	if not ok or kc == nil then return false end
	return true
end

-- Stable comma-joined modifier-prefixed key string. Used as a hash for collision detection
-- on load AND in capture flow. Modifier order is fixed (ctrl,alt,shift,meta) so two combos
-- with the same logical modifiers + key always produce the same comboKey.
function Bindings.comboKey(combo)
	return string.format("%s+%s+%s+%s+%s",
		combo.ctrl and "C" or "_",
		combo.alt  and "A" or "_",
		combo.shift and "S" or "_",
		combo.meta and "M" or "_",
		combo.key)
end

-- Pretty-print combo with P-leader prefix. Examples: "P + I", "P + Shift+T".
-- Storage stays as second-key chord; leader P prepended at display time so users
-- can see the full sequence at a glance.
function Bindings.formatCombo(combo, isMac)
	if not combo then return "(unbound)" end
	local parts = {}
	if combo.ctrl then table.insert(parts, "Ctrl") end
	if combo.alt then table.insert(parts, "Alt") end
	if combo.shift then table.insert(parts, "Shift") end
	if combo.meta then table.insert(parts, isMac and "Cmd" or "Win") end
	table.insert(parts, combo.key)
	-- Hold-P leader  -  display as "P + chord" to match the hold semantic.
	return "P + " .. table.concat(parts, "+")
end

-- Load + validate against the current ActionCatalog. Cases:
-- 1. Setting missing → empty bindings (DEFAULTS is empty).
-- 2. version mismatch (newer): warn + return empty bindings, don't overwrite stored setting.
-- 3. version older (no version OR <2): run migrations before validation  - 
--    TogglePlugin->ToggleUI rename, then v1 default-chord clear.
-- 4. binding for unknown actionId: skip + warn once.
-- 5. malformed binding: skip + warn.
-- 6. duplicate combo: alphabetical-actionId wins, others dropped + warn.
-- Returns: settings table {version, overlayEnabled, bindings}.
function Bindings.load(plugin, ActionCatalog)
	local raw = plugin:GetSetting("Shortcuts")
	if type(raw) ~= "table" then
		return {version = Bindings.VERSION, overlayEnabled = true, bindings = Bindings._copyDefaults()}
	end
	-- Normalize raw.version to a finite number before any comparison. Corrupt or
	-- hand-edited settings can leave it as a string, table, or NaN  -  direct
	-- comparison would throw and abort shortcut bootstrap.
	local rawVersion = tonumber(raw.version)
	if rawVersion ~= rawVersion then rawVersion = nil end -- NaN guard
	if rawVersion and rawVersion > Bindings.VERSION then
		warn("[Part-Icles Shortcuts] settings version unsupported (saved="..tostring(raw.version)..", current="..Bindings.VERSION.."); using defaults")
		return {version = Bindings.VERSION, overlayEnabled = true, bindings = Bindings._copyDefaults()}
	end
	-- TogglePlugin renamed to ToggleUI. Soft migration  -  if a saved binding still uses
	-- the old key, transfer it to the new key so the user's chord survives the rename.
	-- Done before validation so the migrated entry runs through the same checks.
	if type(raw.bindings) == "table" and raw.bindings.TogglePlugin and not raw.bindings.ToggleUI then
		raw.bindings.ToggleUI = raw.bindings.TogglePlugin
		raw.bindings.TogglePlugin = nil
	end
	-- ToggleAnimateLoop retired in favor of ToggleEnable (auto-routes to AnimateLoop
	-- in Animate mode, Enabled in Emit mode). Move the saved chord to ToggleEnable
	-- when free; otherwise drop with a warning.
	if type(raw.bindings) == "table" and raw.bindings.ToggleAnimateLoop then
		if not raw.bindings.ToggleEnable then
			raw.bindings.ToggleEnable = raw.bindings.ToggleAnimateLoop
		else
			warn("[Part-Icles Shortcuts] ToggleAnimateLoop binding dropped  -  ToggleEnable already bound (which now covers both modes)")
		end
		raw.bindings.ToggleAnimateLoop = nil
	end
	-- v1 -> v2 migration. v2 has no DEFAULTS  -  all bindings start unbound. So the
	-- migration just NILS bindings still on the v1 default chord; user-customized
	-- chords pass through unchanged.
	if type(raw.bindings) == "table" and (not rawVersion or rawVersion < 2) then
		for _, entry in ipairs(OLD_DEFAULTS_V1) do
			local current = raw.bindings[entry.actionId]
			if current and Bindings.isValidCombo(current) and Bindings.comboKey(current) == Bindings.comboKey(entry.combo) then
				raw.bindings[entry.actionId] = nil
			end
		end
	end
	local validated = {}
	if type(raw.bindings) == "table" then
		for actionId, combo in pairs(raw.bindings) do
			local def = ActionCatalog[actionId]
			if not def then
				warn(("[Part-Icles Shortcuts] binding for unknown action %q ignored; remove via Settings panel"):format(actionId))
			elseif def.implemented ~= true then
				-- Stubs (ResetSelection / OpenGraphEditor / OpenColorPicker) must not be
				-- dispatchable from the keyboard even if a hand-edited settings entry
				-- preserves them. Panel UI filters them too, but runtime safety must
				-- NOT trust UI filtering  -  refuse here.
				warn(("[Part-Icles Shortcuts] binding for unimplemented action %q dropped; rebind via the Settings panel once it ships"):format(actionId))
			elseif not Bindings.isValidCombo(combo) then
				warn(("[Part-Icles Shortcuts] binding for %q is malformed; falling back to unbound"):format(actionId))
			else
				validated[actionId] = combo
			end
		end
	end
	-- Pass 2: deterministic duplicate-combo handling. Alphabetical actionId wins.
	local sorted = {}
	for actionId in pairs(validated) do table.insert(sorted, actionId) end
	table.sort(sorted)
	local seenCombos = {}
	local final = {}
	for _, actionId in ipairs(sorted) do
		local combo = validated[actionId]
		local k = Bindings.comboKey(combo)
		if seenCombos[k] then
			warn(("[Part-Icles Shortcuts] duplicate combo on load: %q wins over %q"):format(seenCombos[k], actionId))
		else
			seenCombos[k] = actionId
			final[actionId] = combo
		end
	end
	-- Force overlayEnabled true on every load. There's no UI to flip it back, and a
	-- stale build or hand-edited setting could leave it false → Runtime would bail
	-- silently. If a future settings UI exposes this toggle, restore raw.overlayEnabled.
	local overlayEnabled = true
	local result = {version = Bindings.VERSION, overlayEnabled = overlayEnabled, bindings = final}
	-- Persist post-migration state so subsequent loads find raw.version == VERSION
	-- and skip the migration block. Otherwise the migration replays each session.
	if rawVersion ~= Bindings.VERSION then
		pcall(Bindings.save, plugin, result)
	end
	return result
end

function Bindings.save(plugin, settings)
	plugin:SetSetting("Shortcuts", {
		version = Bindings.VERSION,
		overlayEnabled = settings.overlayEnabled ~= false,
		bindings = settings.bindings or {},
	})
end

function Bindings._copyDefaults()
	local out = {}
	for k, v in pairs(Bindings.DEFAULTS) do
		out[k] = {key = v.key, ctrl = v.ctrl, alt = v.alt, shift = v.shift, meta = v.meta}
	end
	return out
end

-- Find which actionId currently owns the given combo, or nil. O(n) over bindings  - 
-- bindings table is bounded by ActionCatalog size (~15) so this is fine on every capture.
function Bindings.findOwner(settings, combo)
	if not Bindings.isValidCombo(combo) then return nil end
	local target = Bindings.comboKey(combo)
	for actionId, existing in pairs(settings.bindings or {}) do
		if Bindings.comboKey(existing) == target then return actionId end
	end
	return nil
end

return Bindings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">Bootstrap</string>
              <string name="Source"><![CDATA[--[[
	Bootstrap  -  Part-Icles V5 ShortcutKey wiring entry point
	Copyright (C) 2026 Qwinkle

	Mirrors Randomizer/Bootstrap.luau.

	Order of operations:
	  1. Build ShortcutsWiring state machine, register ctx.ShortcutsWiring.
	  2. wiring.ensureSettings()  -  primes _settings with the user's saved bindings
	     (or empty on a fresh install) BEFORE Runtime.start, so the dispatcher's
	     first index rebuild has data.
	  3. Shortcuts.Runtime.start  -  UIS dispatcher hooks wiring.setOnChanged for live
	     index rebuilds; registers via ConnectionManager so plugin teardown disconnects
	     cleanly.
	  4. Settings panel "Shortcuts" button → toggle wiring.open/close.
	  5. Panel headerCloseBtn (built-in W.makeToolPanel Hd.Close) → close().

	Required deps shape:
	  ctx (must contain ctx.plugin + ctx.Actions),
	  UI (must contain ShortcutPanel + ShortcutsList + ShortcutsSearch + ShortcutsReset
	      + ShortcutsHeaderClose + ShortcutsButton on Settings panel),
	  Connections (ConnectionManager  -  same instance used by init.server.lua),
	  Shortcuts (the barrel; needs Bindings + Wiring + Runtime),
	  Widgets, Theme.
]]

local Bootstrap = {}

function Bootstrap.attach(deps)
	local ctx = deps.ctx
	local UI = deps.UI
	local Connections = deps.Connections
	local Shortcuts = deps.Shortcuts

	local wiring = Shortcuts.Wiring({
		ctx = ctx,
		panel = {
			panel = UI.ShortcutPanel,
			scrollList = UI.ShortcutsList,
			searchBox = UI.ShortcutsSearch,
			resetBtn = UI.ShortcutsReset,
			headerCloseBtn = UI.ShortcutsHeaderClose,
		},
		Bindings = Shortcuts.Bindings,
		-- Forward Connections so search/reset signals register through the shared
		-- ConnectionManager (consistent with every other top-level wiring path).
		Connections = Connections,
		Widgets = deps.Widgets,
		Theme = deps.Theme,
	})
	ctx.ShortcutsWiring = wiring

	-- Prime _settings at setup so the runtime (which attaches below) sees the user's
	-- saved bindings (or empty fresh install) on first dispatch.
	wiring.ensureSettings()

	-- Shared dispatcher with 50ms dedup. Runtime is currently the only live caller  - 
	-- dedup is retained as future-proofing for any new dispatch path that gets added.
	-- Built BEFORE Runtime.start so it can hook in.
	local dispatcher = Shortcuts.Dispatcher.create(ctx)
	ctx.ShortcutsDispatcher = dispatcher

	-- Start the UIS dispatcher. wiring.setOnChanged is hooked inside Runtime.start so
	-- any save-side rebuild flows through. ctx.ShortcutsRuntime exposed for teardown
	-- (plugin Unloading -> stop()) and future debug introspection.
	local runtime = Shortcuts.Runtime.start({
		ctx = ctx,
		wiring = wiring,
		Bindings = Shortcuts.Bindings,
		Connections = Connections,
		dispatcher = dispatcher,
	})
	ctx.ShortcutsRuntime = runtime

	-- PluginActions.register is a disabled no-op under the P-prefix leader policy.
	-- The call is kept (returns {stop = function() end}) so we don't have to wire
	-- conditional code paths if the policy ever flips back. See PluginActions.luau
	-- header for the bypass rationale.
	if ctx.plugin then
		ctx.ShortcutsPluginActions = Shortcuts.PluginActions.register(ctx.plugin, ctx, wiring, dispatcher)
	end

	-- Settings panel "Shortcuts" button. Toggle behaviour: open if closed, close if open.
	if UI.ShortcutsButton then
		Connections["ShortcutsToggle"] = UI.ShortcutsButton.Activated:Connect(function()
			if wiring.isOpen() then wiring.close() else wiring.open() end
		end)
	end

	-- Built-in W.makeToolPanel header X. close() so capture connection tears down.
	if UI.ShortcutsHeaderClose then
		Connections["ShortcutsHeaderClose"] = UI.ShortcutsHeaderClose.Activated:Connect(function()
			wiring.close()
		end)
	end

	return wiring
end

return Bootstrap
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">Dispatcher</string>
              <string name="Source"><![CDATA[--[[
	Dispatcher  -  Part-Icles V5 ShortcutKey shared dispatch
	Copyright (C) 2026 Qwinkle

	The only live dispatch path is `UIS InputBegan -> Runtime overlay reverse-index
	match -> handler`. Single dispatch chokepoint is preserved as future-proofing:
	any new path that gets added calls `Dispatcher.dispatch(actionId)` and inherits
	the 50ms dedup discipline.

	Two dedup layers  -  kept because Runtime can still fire twice if an InputBegan
	repeat slips through the focus gates:
	  - `_lastFire[actionId] -> os.clock()` per-action 50ms window. Catches same-action
	    double dispatch.
	  - `_lastAnyFire -> os.clock()` global 50ms window. Catches cross-action collisions
	     -  future-proofing for any additional dispatch path.

	The `def.implemented == true` guard also runs here so callers can drop their own
	duplicate checks (kept defensively at the caller in case dispatcher is bypassed).

	Lifecycle:
	  Dispatcher.create(ctx) returns `{dispatch}`. Stored on `ctx.ShortcutsDispatcher`
	  by Bootstrap. No teardown needed  -  `_lastFire` + `_lastAnyFire` are scoped per
	  Dispatcher instance and GC'd when ctx is dropped.

	NOT user-script-reachable. Internal-only.
]]

local Dispatcher = {}

local DEDUP_WINDOW = 0.05  -- 50ms; matches Runtime's prior per-instance dedup

function Dispatcher.create(ctx)
	local self = {}
	local _lastFire = {}      -- per-actionId: same chord on overlay+Studio doesn't double-fire.
	-- Initialize to nil + guarded check so the very first dispatch in a fresh context
	-- isn't suppressed when os.clock() happens to be below DEDUP_WINDOW. Could also
	-- use -math.huge; nil reads cleaner.
	local _lastAnyFire = nil  -- global cross-action dedup window.

	function self.dispatch(actionId)
		if type(actionId) ~= "string" or actionId == "" then return end
		local Actions = ctx.Actions
		local def = Actions and Actions[actionId]
		-- Second-guard applied centrally: even if a caller bypasses its own implemented
		-- check, the dispatcher refuses stub actions.
		if not def or def.implemented ~= true then return end
		local now = os.clock()
		local last = _lastFire[actionId]
		if last and (now - last) < DEDUP_WINDOW then return end
		if _lastAnyFire and (now - _lastAnyFire) < DEDUP_WINDOW then return end
		_lastFire[actionId] = now
		_lastAnyFire = now
		local ok, err = pcall(def.handler, ctx)
		if not ok then
			warn(("[Part-Icles Shortcuts] handler error for %q: %s"):format(actionId, tostring(err)))
		end
	end

	return self
end

return Dispatcher
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">PluginActions</string>
              <string name="Source"><![CDATA[--[[
	PluginActions  -  DISABLED under the P-prefix leader policy
	Copyright (C) 2026 Qwinkle

	Empty stub. Studio `PluginAction` registration was the original mechanism for
	surfacing plugin shortcuts in Studio's File → Advanced → Customize Shortcuts
	dialog. The hold-P leader policy ("all keybinds require P first") makes that
	mechanism unsafe because Studio cannot prove the user pressed our leader key
	before firing `PluginAction.Triggered`  -  Studio-bound chords would end-run the
	policy.

	The previous body created `PluginAction`s with `allowBinding = true` and hooked
	their `Triggered` signal through the shared dispatcher. That entire path is
	deliberately deleted here so a future careless edit cannot re-enable the bypass
	by calling a "legacy" function. The stub keeps the same call signature so
	Bootstrap doesn't have to know whether the policy is active.

	Side effect: `PluginAction` instances created by older plugin versions may still
	appear in Studio's Customize Shortcuts dialog with stale bindings. Those bindings
	cannot fire because we no longer connect Triggered. Users can clear them via the
	dialog at their leisure  -  the plugin cannot mutate Studio's binding store.

	NOT user-script-reachable. Internal-only.
]]

local PluginActions = {}

function PluginActions.register(_plugin, _ctx, _wiring, _dispatcher)
	return {stop = function() end}
end

return PluginActions
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">Runtime</string>
              <string name="Source"><![CDATA[--[[
	Runtime  -  Part-Icles V5 ShortcutKey UIS dispatch
	Copyright (C) 2026 Qwinkle

	Connects keyboard chords to ActionCatalog handlers via a comboKey reverse-index
	built from `wiring.getSettings()`.

	**Hold-P leader:**
	All shortcuts require P held down at the moment of the chord keypress. Roblox
	Studio uses heavy modifier prefixes (Ctrl/Shift/Alt) for its own shortcuts, so a
	dedicated leader key sidesteps that whole conflict surface. Hold-style (vs.
	tap-once + 1s window) lets the user hold P and tap multiple keys to fire several
	actions in a row without re-pressing P each time.

	Sequence:
	  1. User holds P down. P alone fires nothing (P is the modifier, not an action).
	  2. While P is still held, any other keypress builds a combo and dispatches if
	     its comboKey hits the reverse-index. User can tap several chord keys in
	     succession.
	  3. User releases P → leader off. Next chord key without P held is ignored.

	Architecture:
	  - Reverse-index `_index[comboKey] -> actionId` rebuilt on demand AND whenever
	    the Wiring layer fires its onChanged callback (after every save: commit /
	    unbind / reset).
	  - 50ms per-actionId dedup + global cross-action dedup live in
	    Shortcuts.Dispatcher.
	  - Focus gating:
	      1. `wiring.isCapturing()` → skip (panel actively capturing a chord).
	      2. `UserInputService:GetFocusedTextBox()` → skip (let typing pass through
	         to the focused text input  -  overlay shortcuts must NOT eat keystrokes
	         from properties / search / config inputs).
	      3. `wiring.isOpen()` → SUPPRESS but allow `ToggleShortcuts` and `ToggleUI`
	         through: the same shortcut that opened the panel must be able to close
	         it, and ToggleUI must work when the panel is open under a hidden
	         ScreenGui. Other actions are blocked so chord-tapping during binding
	         doesn't fire random actions.
	    The `gameProcessedEvent` gate is intentionally NOT used because Studio sets
	    it true for nearly every keyboard event.

	Required deps shape:
	  ctx (must contain ctx.Actions),
	  wiring (needs getSettings + isOpen + isCapturing + setOnChanged),
	  Bindings (for comboKey + isValidCombo),
	  Connections (ConnectionManager),
	  dispatcher (Shortcuts.Dispatcher.create(ctx)).

	NOT user-script-reachable. Internal-only.
]]

local UserInputService = game:GetService("UserInputService")

local LEADER_KEYCODE = Enum.KeyCode.P

local Runtime = {}

function Runtime.start(deps)
	local ctx = deps.ctx
	local wiring = deps.wiring
	local Bindings = deps.Bindings
	local Connections = deps.Connections
	local dispatcher = deps.dispatcher

	local runtime = {}
	local _index = {}        -- comboKey -> actionId

	function runtime._rebuildIndex()
		_index = {}
		local settings = wiring.getSettings()
		if not settings or settings.overlayEnabled == false then return end
		local Actions = ctx.Actions
		for actionId, combo in pairs(settings.bindings or {}) do
			local def = Actions and Actions[actionId]
			-- Index-build filter: stubs skipped here so a malformed config doesn't
			-- even land in _index. Dispatcher repeats the check defensively at fire
			-- time in case bypass paths land.
			if def and def.implemented == true and Bindings.isValidCombo(combo) then
				_index[Bindings.comboKey(combo)] = actionId
			end
		end
	end

	-- Build a combo table from a keyboard InputObject. Mirrors Wiring's capture-side combo
	-- construction so the comboKey hash matches between save-time and dispatch-time.
	local function _buildComboFromInput(input)
		local combo = {
			key = input.KeyCode.Name,
			ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl),
			alt = UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt),
			shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift),
			meta = false,
		}
		pcall(function()
			combo.meta = UserInputService:IsKeyDown(Enum.KeyCode.LeftMeta) or UserInputService:IsKeyDown(Enum.KeyCode.RightMeta)
		end)
		return combo
	end

	-- Hold-P leader: dispatch fires on any second-key press WHILE P is held down.
	-- Lets the user hold P and tap multiple keys to toggle several actions in a row
	-- without re-arming a 1-second window each time. Leader is released when P
	-- releases.
	local function _isLeaderHeld() return UserInputService:IsKeyDown(LEADER_KEYCODE) end

	local function _dispatchActionId(actionId)
		if not actionId then return end
		if dispatcher then
			dispatcher.dispatch(actionId)
			return
		end
		-- Defensive fallback if Bootstrap forgot to wire dispatcher.
		warn("[Part-Icles Shortcuts] Runtime built without dispatcher; firing direct (dedup absent)")
		local def = ctx.Actions and ctx.Actions[actionId]
		if def and def.implemented == true then
			local ok, err = pcall(def.handler, ctx)
			if not ok then
				warn(("[Part-Icles Shortcuts] handler error for %q: %s"):format(actionId, tostring(err)))
			end
		end
	end

	function runtime._onInputBegan(input, _gameProcessedEvent)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		-- Focus gates. gameProcessedEvent intentionally unused  -  see header comment.
		if wiring.isCapturing and wiring.isCapturing() then return end
		if UserInputService:GetFocusedTextBox() then return end

		-- Hold-P leader: P held + any other key press = dispatch. Pressing P alone
		-- does nothing (it's the modifier, not an action).
		if input.KeyCode == LEADER_KEYCODE then return end
		if not _isLeaderHeld() then return end
		local combo = _buildComboFromInput(input)
		if not Bindings.isValidCombo(combo) then return end
		local actionId = _index[Bindings.comboKey(combo)]
		if not actionId then return end
		-- When the Shortcuts panel itself is open, only ToggleShortcuts can dispatch  - 
		-- that lets the same shortcut close the panel it just opened. Other actions
		-- are suppressed so chord-tapping inside the panel doesn't accidentally fire
		-- random actions while the user is binding. ToggleUI is also allowlisted so
		-- the user can recover when the panel is open under a hidden ScreenGui
		-- (panel.Visible=true but parent disabled).
		if wiring.isOpen() and actionId ~= "ToggleShortcuts" and actionId ~= "ToggleUI" then return end
		_dispatchActionId(actionId)
	end

	-- Build the index now (Bootstrap calls ensureSettings before us so getSettings returns
	-- a populated table). Hook onChanged so future saves rebuild.
	runtime._rebuildIndex()
	wiring.setOnChanged(runtime._rebuildIndex)

	local conn = UserInputService.InputBegan:Connect(runtime._onInputBegan)
	if Connections then
		Connections["ShortcutsRuntime"] = conn
	end

	function runtime.stop()
		if conn then conn:Disconnect(); conn = nil end
		wiring.setOnChanged(nil)
		_index = {}
	end

	return runtime
end

return Runtime
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">Wiring</string>
              <string name="Source"><![CDATA[--[[
	Wiring  -  Part-Icles V5 ShortcutKey panel state machine
	Copyright (C) 2026 Qwinkle

	Factory: `(deps) -> {open, close, isOpen, populate, ...}`.

	State machine:
	  - Closed: panel.Visible = false. _settings table is the in-memory truth.
	  - Open: visible. populate() rebuilds rows from ctx.Actions filtered by
	    `def.implemented==true`. Search box re-filters live via
	    :GetPropertyChangedSignal("Text").
	  - Capturing: a row's Bind button was clicked. _captureActionId is set, all
	    input is intercepted by the active UIS connection until either (a) Esc
	    cancels, (b) a valid non-modifier-only key fires (with or without
	    modifiers), or (c) any other Bind button is clicked (capture handoff  - 
	    mirrors Studio's keybind UX).

	Save flow (Capture commit):
	  1. New combo built from UIS state.
	  2. Bindings.findOwner(settings, combo) → if a different action owns it,
	     warn + drop the previous binding. Conflict policy is "simple override".
	  3. _settings.bindings[actionId] = combo. Bindings.save(plugin, _settings).
	  4. populate() rebuilds rows so combo display refreshes for both winner +
	     previous owner.

	Reset:
	  - Two-click confirm. First click flips resetBtn.Text to "Click again to
	    confirm", arms _resetArmed + _resetArmedAt. Second click within
	    _resetConfirmWindow seconds → mod.reset() (Bindings._copyDefaults() into
	    _settings.bindings, save, populate). No second click → task.delay restores
	    label after window. close() also disarms.

	Settings priming:
	  - mod.ensureSettings() lazy-loads Bindings.load(plugin, Actions) on first
	    access.
	  - Bootstrap calls ensureSettings() right after construction so the runtime
	    (which attaches before any user opens the panel) sees the user's saved
	    bindings on first dispatch.
	  - getSettings() routes through ensureSettings() so it never returns nil.

	NOT user-script-reachable. Internal-only.

	Required deps shape:
	  ctx (must contain ctx.plugin + ctx.Actions),
	  panel = {panel, scrollList, searchBox, resetBtn, headerCloseBtn},
	  Bindings (the storage submodule),
	  Connections (ConnectionManager  -  registers searchBox/resetBtn signals so
	    plugin teardown disconnects them, consistent with every other top-level
	    wiring path),
	  Widgets, Theme.
]]

local UserInputService = game:GetService("UserInputService")

return function(deps)
	local ctx = deps.ctx
	local plugin = ctx.plugin
	local Actions = ctx.Actions
	local panel = deps.panel.panel
	local scrollList = deps.panel.scrollList
	local searchBox = deps.panel.searchBox
	local resetBtn = deps.panel.resetBtn
	local Bindings = deps.Bindings
	local Widgets = deps.Widgets
	local Theme = deps.Theme
	local Connections = deps.Connections  -- register signal connections through ConnectionManager

	local W = Widgets
	local T = Theme
	local mod = {}

	local _settings  -- {version, overlayEnabled, bindings}
	local _open = false
	local _captureActionId = nil
	local _captureConn = nil
	local _rows = {}  -- {actionId -> {frame, comboLabel, bindBtn, unbindBtn, applyBtn}}
	local _conflictTimer = nil
	local _destroyed = false
	-- Runtime rebuilds its comboKey reverse-index when bindings change. _onChanged is a
	-- single-callback hook (Runtime.start sets this); fired from every save path (commit
	-- / unbind / reset). Single consumer, so no full Signal needed.
	local _onChanged = nil
	local function _fireChanged()
		if _onChanged then pcall(_onChanged) end
	end
	-- Manual Cmd/Win display preference (NOT OS detection). Roblox plugin API has no
	-- host-OS hook, so Mac vs Win meta-key labeling can't be auto-driven. We read the
	-- plugin setting `DisplayCmdAsMeta` (boolean) at open time; Mac users flip via
	-- `plugin:SetSetting("DisplayCmdAsMeta", true)` in the Studio dev console. Display
	-- labels render "Cmd+" instead of "Win+" for combos with meta=true. open() refreshes
	-- per session so a flip + reopen reflects the label preference immediately. There is
	-- no visible panel toggle yet  -  could surface as a checkbox near Reset if Mac uptake
	-- creates demand.
	local _isMac = false
	local function _refreshIsMac()
		local v = plugin:GetSetting("DisplayCmdAsMeta")
		_isMac = (type(v) == "boolean") and v or false
	end

	-- =========================================================
	-- Capture flow
	-- =========================================================

	local function _stopCapture(reason)
		if _captureConn then _captureConn:Disconnect(); _captureConn = nil end
		_captureActionId = nil
		-- Restore button labels (populate rebuilds, simpler than per-row state restore).
		mod.populate()
	end

	-- Transient conflict notice {actionId, expiresAt, message}. Populate displays
	-- the message on the affected row's combo label in red until expiresAt.
	local _conflictNotice = nil

	local function _commitCombo(actionId, combo)
		-- _commitCombo can fire with actionId == nil under a race between _stopCapture's
		-- _captureActionId clear and an in-flight InputBegan event. Bail early so format/
		-- warn/save calls never receive nil. The capture flow's caller already gates
		-- re-firing on the boolean return (false → don't _stopCapture again).
		if type(actionId) ~= "string" or actionId == "" then return false end
		if not Bindings.isValidCombo(combo) then return false end
		mod.ensureSettings()
		local owner = Bindings.findOwner(_settings, combo)
		if owner and owner ~= actionId then
			warn(("[Part-Icles Shortcuts] %s overrides previous binding %s -> %s"):format(
				tostring(actionId), tostring(owner), Bindings.formatCombo(combo, _isMac)))
			_settings.bindings[owner] = nil
			-- Stash a transient notice for the row that just lost its binding.
			-- Populate (called from _fireChanged below) will overlay it; another
			-- populate runs after 3s to clear.
			local newName = (Actions[actionId] and Actions[actionId].displayName) or actionId
			_conflictNotice = {
				actionId = owner,
				expiresAt = os.clock() + 3,
				message = "Reassigned to " .. newName,
			}
			if _conflictTimer then pcall(task.cancel, _conflictTimer); _conflictTimer = nil end
			_conflictTimer = task.delay(3, function()
				_conflictTimer = nil
				if _destroyed then return end
				if _conflictNotice and _conflictNotice.actionId == owner then
					_conflictNotice = nil
					mod.populate()
				end
			end)
		end
		_settings.bindings[actionId] = combo
		Bindings.save(plugin, _settings)
		_fireChanged()
		return true
	end

	local function _startCapture(actionId)
		-- Tear down any existing capture before arming a new one  -  regardless of
		-- whether actionId matches. Otherwise same-row double-click would orphan
		-- the prior listener with its stale captured actionId still alive.
		if _captureConn then _stopCapture("rearm") end
		_captureActionId = actionId
		local row = _rows[actionId]
		if row and row.comboLabel then row.comboLabel.Text = "Press key... (hold P + key; Esc cancels)" end
		-- Bind the actionId in the closure rather than reading the _captureActionId
		-- upvalue at fire time. Otherwise an InputBegan event in flight when
		-- _stopCapture nils the upvalue would pass nil to _commitCombo. Closure
		-- capture pins the value at _startCapture time; _stopCapture's Disconnect
		-- kills the listener but the bound `actionId` survives until that happens.
		local capturingActionId = actionId
		-- InputBegan listener. ProcessEvent passes through Studio bindings  -  we want even
		-- captured-by-Studio combos to commit here, so we listen on InputBegan and check
		-- modifiers via UIS:IsKeyDown rather than relying on the InputObject having them.
		_captureConn = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
			-- Bail when a TextBox is focused so typing in the Shortcuts search (or
			-- any other plugin TextBox) doesn't get captured as a chord. Escape is
			-- the exception  -  letting it through lets the user cancel capture
			-- without un-focusing first.
			if input.KeyCode == Enum.KeyCode.Escape then _stopCapture("escape"); return end
			if UserInputService:GetFocusedTextBox() then return end
			-- Leader P never lands as the chord. With hold-P semantics the user holds
			-- P first then taps the chord key; capture must ignore the leader press
			-- so it doesn't bind P as the second key.
			if input.KeyCode == Enum.KeyCode.P then return end
			local kcName = input.KeyCode.Name
			-- Reject modifier-only press; wait for the chord-finishing non-modifier.
			local combo = {
				key = kcName,
				ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl),
				alt = UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt),
				shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift),
				meta = false,
			}
			-- Mac meta probe: pcall because LeftMeta enum may not exist on all Studio runtimes.
			pcall(function()
				combo.meta = UserInputService:IsKeyDown(Enum.KeyCode.LeftMeta) or UserInputService:IsKeyDown(Enum.KeyCode.RightMeta)
			end)
			if not Bindings.isValidCombo(combo) then return end  -- modifier-only-key skip
			if _commitCombo(capturingActionId, combo) then _stopCapture("commit") end
		end)
		-- Also register through ConnectionManager so plugin teardown disconnects
		-- the capture listener if the user disables the plugin mid-bind.
		if Connections then Connections["ShortcutsCapture"] = _captureConn end
	end

	-- =========================================================
	-- Row builder
	-- =========================================================

	local function _makeRow(parent, actionId, def, layoutOrder)
		-- Matches UIBuilder convention: Settings panel + Properties rows wrap text in
		-- W.makeBlob (themed background + corner + stroke) and use W.makeLabel for
		-- typography. Plain TextLabels on a transparent row would read as floating
		-- text  -  inconsistent with the rest of the plugin. Row height 24 matches
		-- Settings AERow/USRow.
		local row = Instance.new("Frame")
		row.Name = "Row_" .. actionId
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, -4, 0, 24)
		row.LayoutOrder = layoutOrder
		row.Parent = parent

		-- nameBlob fixed at 130px (action names short + bounded). comboBlob fills the
		-- middle minus the right-side button gutter (78px = 22 X + 40 Bind + 16 gaps).
		-- Name blob (left): themed pill with action display name. Internal padding via
		-- UIPadding so text doesn't sit flush against the rounded corner.
		local nameBlob = W.makeBlob("Name", row, UDim2.new(0, 130, 1, -2))
		nameBlob.Position = UDim2.new(0, 0, 0, 1)
		W.addPadding(nameBlob, 6, 4, 0, 0)
		local nameLabel = W.makeLabel("L", nameBlob, def.displayName or actionId, T.MutedGold, T.Font, 10)
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.TextTruncate = Enum.TextTruncate.AtEnd

		-- Combo blob (middle): themed pill showing current binding / suggestion / "(unbound)".
		-- Same treatment as the name blob for visual consistency.
		-- comboBlob right reserve = 208 (74px button gutter) so the bind button sits
		-- close to comboBlob's right edge.
		local comboBlob = W.makeBlob("Combo", row, UDim2.new(1, -208, 1, -2))
		comboBlob.Position = UDim2.new(0, 134, 0, 1)
		W.addPadding(comboBlob, 6, 4, 0, 0)
		local comboLabel = W.makeLabel("L", comboBlob, "(unbound)", T.BrightGold, T.Font, 10)
		comboLabel.TextXAlignment = Enum.TextXAlignment.Left
		comboLabel.TextTruncate = Enum.TextTruncate.AtEnd

		-- Right-anchored buttons. Layout: [...nameBlob...][...comboBlob...] [Bind][X].
		-- Offsets from right edge: X (22) flush at -4; Bind (40) at -(4+22+4)=-30.
		local unbindBtn = W.makeButton("Unbind_"..actionId, row, "X", UDim2.new(0, 22, 1, -4), T.DarkGold)
		unbindBtn.AnchorPoint = Vector2.new(1, 0)
		unbindBtn.Position = UDim2.new(1, -4, 0, 2)
		unbindBtn.TextSize = 10

		local bindBtn = W.makeButton("Bind_"..actionId, row, "Bind", UDim2.new(0, 40, 1, -4), T.DarkGold)
		bindBtn.AnchorPoint = Vector2.new(1, 0)
		bindBtn.Position = UDim2.new(1, -30, 0, 2)
		bindBtn.TextSize = 10

		bindBtn.Activated:Connect(function() _startCapture(actionId) end)
		unbindBtn.Activated:Connect(function()
			-- Stop ANY armed capture, not just one matching this row. Clicking X on
			-- a different row while another is in "Press key..." mode would otherwise
			-- leave the original listener alive after populate() destroyed its prompt.
			if _captureConn then _stopCapture("unbind") end
			_settings.bindings[actionId] = nil
			Bindings.save(plugin, _settings)
			_fireChanged()
			mod.populate()
		end)

		_rows[actionId] = {
			frame = row, comboLabel = comboLabel,
			bindBtn = bindBtn, unbindBtn = unbindBtn,
		}
		return row
	end

	local function _makeCategoryHeader(parent, name, layoutOrder)
		-- Matches BuildProperties section-header style  -  slightly taller, gold accent,
		-- with a small left padding so the label doesn't sit flush.
		local hdr = Instance.new("Frame")
		hdr.Name = "Cat_" .. name
		hdr.BackgroundTransparency = 1
		hdr.Size = UDim2.new(1, -4, 0, 20)
		hdr.LayoutOrder = layoutOrder
		hdr.Parent = parent
		W.addPadding(hdr, 4, 0, 4, 0)
		local lbl = W.makeLabel("L", hdr, name, T.Gold, T.Font, 11)
		lbl.TextXAlignment = Enum.TextXAlignment.Left
	end

	-- =========================================================
	-- populate / filter
	-- =========================================================

	function mod.populate()
		-- Clear existing rows + headers (preserve placeholder if no actions; safe to drop it
		-- since populate runs after _settings is loaded).
		for _, child in ipairs(scrollList:GetChildren()) do
			if child:IsA("Frame") or (child:IsA("TextLabel") and child.Name:sub(1,4) == "Cat_") or child.Name == "Placeholder" then
				child:Destroy()
			end
		end
		_rows = {}
		local filter = (searchBox and searchBox.Text or ""):lower()
		-- Group by category, ordered: UI, Edit, Animate, Emit, Editor.
		local categoryOrder = {"UI", "Tools", "Edit", "Animate", "Emit", "Editor"}
		local byCat = {}
		for actionId, def in pairs(Actions) do
			-- Filter to implemented actions only  -  stubs (ResetSelection,
			-- OpenGraphEditor, OpenColorPicker) shouldn't appear in the bindable list.
			if def.implemented == true then
				local matchesFilter = filter == "" or
					(def.displayName or actionId):lower():find(filter, 1, true) ~= nil or
					actionId:lower():find(filter, 1, true) ~= nil
				if matchesFilter then
					local cat = def.category or "Other"
					byCat[cat] = byCat[cat] or {}
					table.insert(byCat[cat], {actionId = actionId, def = def})
				end
			end
		end
		local layoutOrder = 0
		for _, cat in ipairs(categoryOrder) do
			local rows = byCat[cat]
			if rows and #rows > 0 then
				_makeCategoryHeader(scrollList, cat, layoutOrder); layoutOrder = layoutOrder + 1
				-- Stable per-category order: alphabetical actionId.
				table.sort(rows, function(a, b) return a.actionId < b.actionId end)
				for _, entry in ipairs(rows) do
					_makeRow(scrollList, entry.actionId, entry.def, layoutOrder)
					-- Refresh combo label. Unbound rows read "(unbound)"; bound rows show
					-- the actual combo. An active conflict notice for this row overlays a
					-- red message instead.
					local combo = _settings.bindings[entry.actionId]
					local cl = _rows[entry.actionId].comboLabel
					if _conflictNotice and _conflictNotice.actionId == entry.actionId and os.clock() < _conflictNotice.expiresAt then
						cl.Text = _conflictNotice.message
						cl.TextColor3 = Color3.fromRGB(220, 80, 80)
					else
						cl.Text = combo and Bindings.formatCombo(combo, _isMac) or "(unbound)"
						cl.TextColor3 = T.MutedGold
					end
					layoutOrder = layoutOrder + 1
				end
			end
		end
	end

	-- =========================================================
	-- ensureSettings / Reset / open / close
	-- =========================================================

	-- Runtime attaches at plugin setup BEFORE the user has opened the panel.
	-- getSettings() must return a populated table, so prime _settings lazily on
	-- first access instead of at open() time.
	function mod.ensureSettings()
		if _settings == nil then
			-- Defense-in-depth: Bindings.load already normalizes the version field,
			-- but any other unforeseen error inside load() must NOT abort plugin
			-- bootstrap. Fall back to defaults on any error.
			local ok, result = pcall(Bindings.load, plugin, Actions)
			if ok and type(result) == "table" then
				_settings = result
			else
				warn("[Part-Icles Shortcuts] Bindings.load failed; using defaults: "..tostring(result))
				_settings = {version = Bindings.VERSION, overlayEnabled = true, bindings = Bindings._copyDefaults()}
			end
		end
		return _settings
	end

	-- Two-click reset confirm. First click flips the button to a confirm state; the
	-- second click within `_resetConfirmWindow` seconds commits. Auto-reverts after
	-- the window with task.delay.
	local _resetArmed = false
	local _resetArmedAt = 0
	local _resetConfirmWindow = 3
	local _resetOriginalText = resetBtn and resetBtn.Text or "Unbind all"
	local function _disarmReset()
		_resetArmed = false
		if resetBtn then resetBtn.Text = _resetOriginalText end
	end
	function mod.reset()
		mod.ensureSettings()
		_settings.bindings = Bindings._copyDefaults()
		Bindings.save(plugin, _settings)
		_disarmReset()
		-- Tear down any armed capture so a post-reset keypress doesn't silently
		-- rebind a row the user just told us to clear.
		if _captureConn then _stopCapture("reset") end
		_fireChanged()
		mod.populate()
	end
	local function _onResetClick()
		if not _open then return end
		if _resetArmed and (os.clock() - _resetArmedAt) <= _resetConfirmWindow then
			mod.reset()
			return
		end
		_resetArmed = true
		_resetArmedAt = os.clock()
		if resetBtn then resetBtn.Text = "Click again to confirm" end
		task.delay(_resetConfirmWindow, function()
			-- Bail if the user already clicked through. Otherwise restore label.
			if _resetArmed and (os.clock() - _resetArmedAt) >= _resetConfirmWindow - 0.05 then
				_disarmReset()
			end
		end)
	end

	function mod.open()
		if _open then return end
		_open = true
		mod.ensureSettings()
		_refreshIsMac()  -- re-read plugin setting so label preference picks up flips.
		panel.Visible = true
		mod.populate()
	end

	function mod.close()
		if not _open then return end
		_open = false
		_stopCapture("close")
		_disarmReset()
		panel.Visible = false
	end

	-- Plugin-teardown hook; cancels pending conflict-notice timer + an in-flight
	-- capture's InputBegan listener (otherwise the disconnect-on-stop path never runs
	-- when the user toggles plugin off mid-capture, leaving an orphan Connection).
	function mod.destroy()
		_destroyed = true
		if _captureConn then _captureConn:Disconnect(); _captureConn = nil end
		_captureActionId = nil
		if _conflictTimer then pcall(task.cancel, _conflictTimer); _conflictTimer = nil end
		_conflictNotice = nil
	end

	function mod.isOpen() return _open end
	function mod.isCapturing() return _captureActionId ~= nil end

	function mod.getSettings()
		-- Runtime safety: if dispatcher loads before user opens the panel, prime defaults so
		-- the 3 pre-bound shortcuts still fire on first install.
		return mod.ensureSettings()
	end

	-- Runtime registers a callback here; Wiring fires it after every save (commit /
	-- unbind / reset) so the reverse-index rebuilds. Single-consumer hook  -  replace
	-- with a Signal if a second consumer ever needs it.
	function mod.setOnChanged(callback)
		_onChanged = callback
	end

	-- Register signal connections through ConnectionManager so plugin teardown
	-- disconnects them (consistent with every other top-level wiring path).
	if Connections then
		if searchBox then
			Connections["ShortcutsSearchChanged"] = searchBox:GetPropertyChangedSignal("Text"):Connect(function()
				if _open then mod.populate() end
			end)
		end
		if resetBtn then
			Connections["ShortcutsReset"] = resetBtn.Activated:Connect(_onResetClick)
		end
	else
		-- Defensive fallback if Bootstrap forgets to pass Connections. Module is plugin-lifetime
		-- so leak risk is small but warn so the gap surfaces in dev.
		warn("[Part-Icles Shortcuts] Wiring built without Connections  -  search/reset signals are dangling")
		if searchBox then searchBox:GetPropertyChangedSignal("Text"):Connect(function() if _open then mod.populate() end end) end
		if resetBtn then resetBtn.Activated:Connect(_onResetClick) end
	end

	return mod
end
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">UIBuilder</string>
            <string name="Source"><![CDATA[--[[
	UIBuilder Module - Part-Icles V5
	Copyright (C) 2026 Qwinkle
	Orchestrates all UI construction. Delegates to UIBuilderConstants, UIWidgets, UIToolPanels.
]]

-- task.wait between requires spreads obfuscated VM bootstrap across frames so the
-- initial UIBuilder load doesn't pile onto the same frame as Part's mixin chain.
local C = require(script.Constants); task.wait()
local W = require(script.Widgets); task.wait()
local TP = require(script.ToolPanels); task.wait()
local BP = require(script.BuildProperties); task.wait()
local IP = require(script.InventoryPanel); task.wait()

local T = C.T
local LAYOUT = C.LAYOUT

local UIBuilder = {}
-- Module-scoped (not self-state): persists across SnapshotTheme/RestoreTheme cycles so the descendant-walk
-- inside UpdateTheme can short-circuit when the same font is re-applied. Walking ~1000+ descendants per
-- color-picker drag was a measurable cost; this skip relies on font being a string-name comparison.
local _currentFontName = T.Font.Name

-- BUILD HUD
local function buildHUD(screenGui)
	local hud = Instance.new("Frame"); hud.Name = "HUD"; hud.BackgroundTransparency = 1
	hud.Position = UDim2.new(0,LAYOUT.HudX,0,LAYOUT.HudY); hud.Size = UDim2.new(0,LAYOUT.HudWidth,0,0)
	hud.AutomaticSize = Enum.AutomaticSize.Y; hud.Parent = screenGui; W.addListLayout(hud, 4)
	local panel = Instance.new("Frame"); panel.Name = "Panel"; panel.BackgroundColor3 = T.PanelBg; panel.BackgroundTransparency = T.PanelAlpha
	panel.Size = UDim2.new(1,0,0,0); panel.AutomaticSize = Enum.AutomaticSize.Y; panel.Active = true; panel.LayoutOrder = 0; panel.Visible = false; panel.Parent = hud
	W.addCorner(panel, T.BigCorner); W.addStroke(panel); W.addPadding(panel,6,6,6,6); W.addListLayout(panel,4); table.insert(W.getThemed().panels, panel)
	W.attachPanelBackground(panel)
	local refs = {}

	local nameBar = W.makeBlob("NameBar", panel, UDim2.new(1,0,0,26)); nameBar.LayoutOrder = 0; W.addPadding(nameBar,6,4,0,0)
	local dragH = Instance.new("TextButton"); dragH.Name = "DragHandle"; dragH.BackgroundTransparency = 1
	dragH.Text = ""; dragH.Size = UDim2.new(1,0,1,0); dragH.ZIndex = 2; dragH.Parent = nameBar
	refs.StatusDot = Instance.new("Frame"); refs.StatusDot.Name = "StatusDot"; refs.StatusDot.BackgroundColor3 = T.Green
	refs.StatusDot.Size = UDim2.new(0,6,0,6); refs.StatusDot.Position = UDim2.new(0,0,0.5,-3)
	refs.StatusDot.BorderSizePixel = 0; refs.StatusDot.Parent = nameBar; W.addCorner(refs.StatusDot, UDim.new(0,3))
	refs.NameLabel = Instance.new("TextLabel"); refs.NameLabel.Name = "NameLabel"; refs.NameLabel.BackgroundTransparency = 1
	refs.NameLabel.Text = "No Selection"; refs.NameLabel.TextColor3 = T.BrightGold; refs.NameLabel.Font = T.Font; refs.NameLabel.TextSize = 11
	refs.NameLabel.TextXAlignment = Enum.TextXAlignment.Left; refs.NameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	refs.NameLabel.Size = UDim2.new(1,-44,1,0); refs.NameLabel.Position = UDim2.new(0,10,0,0); refs.NameLabel.Parent = nameBar
	refs.HUDClose = Instance.new("TextButton"); refs.HUDClose.Name = "Close"; refs.HUDClose.BackgroundTransparency = 1
	refs.HUDClose.Text = "X"; refs.HUDClose.TextColor3 = T.DarkGold; refs.HUDClose.Font = T.Font; refs.HUDClose.TextSize = 10
	refs.HUDClose.Size = UDim2.new(0,14,1,0); refs.HUDClose.Position = UDim2.new(1,-2,0,0); refs.HUDClose.AnchorPoint = Vector2.new(1,0)
	refs.HUDClose.ZIndex = 3; refs.HUDClose.Parent = nameBar
	local iconH = Instance.new("Frame"); iconH.Name = "Icons"; iconH.BackgroundTransparency = 1
	iconH.Size = UDim2.new(0,32,0,16); iconH.Position = UDim2.new(1,-46,0.5,-8); iconH.Parent = nameBar; W.addListLayout(iconH, 2, Enum.FillDirection.Horizontal)
	refs.EnabledIcon = W.makeBlob("EnabledIcon", iconH, UDim2.new(0,14,0,14))
	local el = Instance.new("TextLabel"); el.BackgroundTransparency = 1; el.Text = "E"; el.TextColor3 = T.Gold; el.Font = T.Font; el.TextSize = 9; el.Size = UDim2.new(1,0,1,0); el.Parent = refs.EnabledIcon

	local function makeHudRow(name, labelText, lsz, defVal, lo)
		local row = Instance.new("Frame"); row.Name = name; row.BackgroundTransparency = 1
		row.Size = UDim2.new(1,0,0,28); row.LayoutOrder = lo; row.Parent = panel
		local lb = W.makeBlob(name.."Label", row, UDim2.new(0,44,1,0))
		local lt = Instance.new("TextLabel"); lt.BackgroundTransparency = 1; lt.Text = labelText
		lt.TextColor3 = T.Gold; lt.Font = T.Font; lt.TextSize = lsz; lt.Size = UDim2.new(1,0,1,0); lt.Parent = lb
		local iw = W.makeBlob(name.."InputWrap", row, UDim2.new(1,-48,1,0)); iw.Position = UDim2.new(0,48,0,0)
		local tb = Instance.new("TextBox"); tb.Name = name.."Box"; tb.BackgroundTransparency = 1; tb.Text = defVal
		tb.TextColor3 = T.BrightGold; tb.Font = T.Font; tb.TextSize = 13; tb.TextXAlignment = Enum.TextXAlignment.Right
		tb.ClearTextOnFocus = false; tb.Size = UDim2.new(1,-8,1,0); tb.Position = UDim2.new(0,4,0,0)
		tb.BorderSizePixel = 0; tb.Parent = iw; return tb
	end
	refs.EmitBox = makeHudRow("Emit","Emit",12,"1",1); refs.EmitRow = refs.EmitBox.Parent.Parent
	refs.DelayBox = makeHudRow("Delay","Delay",12,"0",2)
	refs.DurationBox = makeHudRow("Dur","Duration",9,"0",3)
	local emitRow = refs.EmitBox.Parent.Parent; local delayRow = refs.DelayBox.Parent.Parent; local durRow = refs.DurationBox.Parent.Parent

	local btnRow = Instance.new("Frame"); btnRow.Name = "ButtonRow"; btnRow.BackgroundTransparency = 1
	btnRow.Size = UDim2.new(1,0,0,28); btnRow.LayoutOrder = 4; btnRow.Parent = panel; W.addListLayout(btnRow, 3, Enum.FillDirection.Horizontal)
	refs.EmitButton = W.makeButton("EmitButton", btnRow, "Emit", UDim2.new(0,80,1,0)); refs.EmitButton.LayoutOrder = 0
	refs.AutoEmitButton = Instance.new("ImageButton"); refs.AutoEmitButton.Name = "AutoEmitButton"
	refs.AutoEmitButton.BackgroundColor3 = T.BlobBg; refs.AutoEmitButton.BackgroundTransparency = T.BlobAlpha
	refs.AutoEmitButton.Image = "rbxassetid://84619708295584"; refs.AutoEmitButton.ImageColor3 = T.MutedGold; refs.AutoEmitButton.ScaleType = Enum.ScaleType.Fit; refs.AutoEmitButton.Size = UDim2.new(0,28,1,0)
	refs.AutoEmitButton.BorderSizePixel = 0; refs.AutoEmitButton.LayoutOrder = 1; refs.AutoEmitButton.Parent = btnRow
	W.addCorner(refs.AutoEmitButton); W.addStroke(refs.AutoEmitButton); table.insert(W.getThemed().blobs, refs.AutoEmitButton)
	local enWrap = W.makeBlob("EnableWrap", btnRow, UDim2.new(0,38,1,0)); enWrap.LayoutOrder = 2
	refs.ToggleEnableButton = W.makeToggle("ToggleEnable", enWrap); refs.ToggleEnableButton.Position = UDim2.new(0.5,-14,0.5,-8)
	W.addCollapseButton(nameBar, {emitRow, delayRow, durRow, btnRow}, {arrowPos = UDim2.new(1,-16,0,0)})

	refs.TransformButton = W.makeButton("TransformBtn", hud, "Transform", UDim2.new(0,90,0,30))
	refs.TransformButton.TextSize = 12; refs.TransformButton.LayoutOrder = 10; refs.TransformButton.Visible = false
	W.makeDraggable(hud, dragH); refs.HUD = hud; refs.HUDPanel = panel; return refs
end

-- BUILD SETTINGS
local function buildSettings(screenGui)
	local panel = Instance.new("Frame"); panel.Name = "SettingsPanel"
	panel.BackgroundColor3 = T.PanelBg; panel.BackgroundTransparency = T.PanelAlpha
	-- Anchor bottom-right so the panel hugs just above the toggle bar regardless of
	-- its AutomaticSize.Y height. Toggle bar sits at y=`1, -34` with height 24, so
	-- y=`1, -38` leaves a 4px gap above the bar's top edge.
	panel.AnchorPoint = Vector2.new(1, 1)
	panel.Position = UDim2.new(1, -12, 1, -38)
	panel.Size = UDim2.new(0,LAYOUT.SettingsWidth,0,0); panel.AutomaticSize = Enum.AutomaticSize.Y; panel.Active = true
	panel.ClipsDescendants = false; panel.Visible = false; panel.Parent = screenGui
	W.addCorner(panel, T.BigCorner); W.addStroke(panel); W.addPadding(panel,8,8,8,8); W.addListLayout(panel,4)
	table.insert(W.getThemed().panels, panel)
	W.attachPanelBackground(panel)
	local refs = {}

	local header = W.makeBlob("Header", panel, UDim2.new(1,0,0,24)); header.LayoutOrder = 0
	local ht2 = Instance.new("TextLabel"); ht2.BackgroundTransparency = 1; ht2.Text = "Settings"
	ht2.TextColor3 = T.Gold; ht2.Font = T.Font; ht2.TextSize = 12; ht2.TextXAlignment = Enum.TextXAlignment.Left
	ht2.Size = UDim2.new(1,-20,1,0); ht2.Position = UDim2.new(0,6,0,0); ht2.Parent = header
	refs.SettingsClose = Instance.new("TextButton"); refs.SettingsClose.Name = "Close"
	refs.SettingsClose.BackgroundTransparency = 1; refs.SettingsClose.Text = "X"; refs.SettingsClose.TextColor3 = T.DarkGold
	refs.SettingsClose.Font = T.Font; refs.SettingsClose.TextSize = 12; refs.SettingsClose.Size = UDim2.new(0,20,1,0)
	refs.SettingsClose.Position = UDim2.new(1,-22,0,0); refs.SettingsClose.ZIndex = 3; refs.SettingsClose.Parent = header
	local sdh = Instance.new("TextButton"); sdh.Name = "DragHandle"; sdh.BackgroundTransparency = 1
	sdh.Text = ""; sdh.Size = UDim2.new(1,-24,1,0); sdh.ZIndex = 2; sdh.Parent = header; W.makeDraggable(panel, sdh)

	local aeRow = Instance.new("Frame"); aeRow.Name = "AERow"; aeRow.BackgroundTransparency = 1
	aeRow.Size = UDim2.new(1,0,0,24); aeRow.LayoutOrder = 1; aeRow.Parent = panel
	local aeL = W.makeBlob("AEL", aeRow, UDim2.new(0,90,1,0)); W.makeLabel("L", aeL, "AutoEmit Delay", T.MutedGold, T.Font, 9)
	local aeW = W.makeBlob("AEW", aeRow, UDim2.new(1,-94,1,0)); aeW.Position = UDim2.new(0,94,0,0)
	refs.AutoEmitDelayBox = Instance.new("TextBox"); refs.AutoEmitDelayBox.Name = "AEDelay"; refs.AutoEmitDelayBox.BackgroundTransparency = 1
	refs.AutoEmitDelayBox.Text = "1"; refs.AutoEmitDelayBox.TextColor3 = T.BrightGold; refs.AutoEmitDelayBox.Font = T.Font
	refs.AutoEmitDelayBox.TextSize = 11; refs.AutoEmitDelayBox.TextXAlignment = Enum.TextXAlignment.Right
	refs.AutoEmitDelayBox.ClearTextOnFocus = false; refs.AutoEmitDelayBox.Size = UDim2.new(1,-8,1,0)
	refs.AutoEmitDelayBox.Position = UDim2.new(0,4,0,0); refs.AutoEmitDelayBox.BorderSizePixel = 0; refs.AutoEmitDelayBox.Parent = aeW

	local usRow = Instance.new("Frame"); usRow.Name = "UIScaleRow"; usRow.BackgroundTransparency = 1
	usRow.Size = UDim2.new(1,0,0,24); usRow.LayoutOrder = 2; usRow.Parent = panel
	local usL = W.makeBlob("USL", usRow, UDim2.new(0,90,1,0)); W.makeLabel("L", usL, "UI Scale %", T.MutedGold, T.Font, 9)
	local usW = W.makeBlob("USW", usRow, UDim2.new(1,-94,1,0)); usW.Position = UDim2.new(0,94,0,0)
	refs.UIScaleBox = Instance.new("TextBox"); refs.UIScaleBox.Name = "UIScale"; refs.UIScaleBox.BackgroundTransparency = 1
	refs.UIScaleBox.Text = "115"; refs.UIScaleBox.TextColor3 = T.BrightGold; refs.UIScaleBox.Font = T.Font
	refs.UIScaleBox.TextSize = 11; refs.UIScaleBox.TextXAlignment = Enum.TextXAlignment.Right
	refs.UIScaleBox.ClearTextOnFocus = false; refs.UIScaleBox.Size = UDim2.new(1,-8,1,0)
	refs.UIScaleBox.Position = UDim2.new(0,4,0,0); refs.UIScaleBox.BorderSizePixel = 0; refs.UIScaleBox.Parent = usW

	-- Active particle cap. Engine skips new emits past this threshold (Module code in events
	-- still runs). Cap defaults to 1000; users can lower to spare CPU on weaker machines or
	-- raise for heavy effects on stronger ones.
	local pcRow = Instance.new("Frame"); pcRow.Name = "ParticleCapRow"; pcRow.BackgroundTransparency = 1
	pcRow.Size = UDim2.new(1,0,0,24); pcRow.LayoutOrder = 3; pcRow.Parent = panel
	local pcL = W.makeBlob("PCL", pcRow, UDim2.new(0,90,1,0)); W.makeLabel("L", pcL, "Particle Cap", T.MutedGold, T.Font, 9)
	local pcW = W.makeBlob("PCW", pcRow, UDim2.new(1,-94,1,0)); pcW.Position = UDim2.new(0,94,0,0)
	refs.ParticleCapBox = Instance.new("TextBox"); refs.ParticleCapBox.Name = "ParticleCap"; refs.ParticleCapBox.BackgroundTransparency = 1
	refs.ParticleCapBox.Text = "1000"; refs.ParticleCapBox.TextColor3 = T.BrightGold; refs.ParticleCapBox.Font = T.Font
	refs.ParticleCapBox.TextSize = 11; refs.ParticleCapBox.TextXAlignment = Enum.TextXAlignment.Right
	refs.ParticleCapBox.ClearTextOnFocus = false; refs.ParticleCapBox.Size = UDim2.new(1,-8,1,0)
	refs.ParticleCapBox.Position = UDim2.new(0,4,0,0); refs.ParticleCapBox.BorderSizePixel = 0; refs.ParticleCapBox.Parent = pcW

	refs.EditThemeButton = W.makeButton("EditTheme", panel, "Edit Theme", UDim2.new(1,0,0,26), T.Gold); refs.EditThemeButton.LayoutOrder = 4
	refs.ResetLayoutButton = W.makeButton("ResetLayout", panel, "Reset Layout", UDim2.new(1,0,0,26), T.DarkGold); refs.ResetLayoutButton.LayoutOrder = 5
	-- Opens the ShortcutPanel modal. Bootstrap (Modules/Shortcuts) wires this button's
	-- Activated to wiring.open/close.
	refs.ShortcutsButton = W.makeButton("Shortcuts", panel, "Shortcuts", UDim2.new(1,0,0,26), T.DarkGold); refs.ShortcutsButton.LayoutOrder = 6

	-- Auto-Update toggle row. Persisted per-user via plugin:SetSetting("AutoUpdate"),
	-- default ON. QOLWiring hydrates from the persisted value at setup time.
	local auRow = Instance.new("Frame"); auRow.Name = "AutoUpdateRow"; auRow.BackgroundTransparency = 1
	auRow.Size = UDim2.new(1,0,0,24); auRow.LayoutOrder = 7; auRow.Parent = panel
	local auL = W.makeBlob("AUL", auRow, UDim2.new(0,140,1,0))
	W.makeLabel("L", auL, "Auto-Update", T.MutedGold, T.Font, 9)
	local auW = W.makeBlob("AUW", auRow, UDim2.new(1,-144,1,0)); auW.Position = UDim2.new(0,144,0,0)
	refs.AutoUpdateToggle = W.makeToggle("AutoUpdateToggle", auW)
	refs.AutoUpdateToggle.Position = UDim2.new(1,-32,0.5,-8)

	-- Manual "Check for Updates" trigger. QOLWiring debounces via the module-scoped
	-- _updateInFlight inside init.server.lua and swaps the button label to
	-- "Checking..." during a fetch, restoring it via the onDone callback.
	refs.CheckUpdatesButton = W.makeButton("CheckUpdates", panel, "Check for Updates", UDim2.new(1,0,0,26), T.Gold)
	refs.CheckUpdatesButton.LayoutOrder = 8

	refs.SettingsPanel = panel; return refs
end

-- COUNTER / OPT INDICATOR / TOGGLE BAR
local function buildCounter(sg)
	local c = W.makeBlob("ParticleCounter", sg, UDim2.new(0,100,0,22)); c.Position = UDim2.new(0,12,1,-34)
	local l = Instance.new("TextLabel"); l.Name = "Label"; l.BackgroundTransparency = 1; l.Text = "0 particles"
	l.TextColor3 = T.MutedGold; l.Font = T.Font; l.TextSize = 10; l.Size = UDim2.new(1,0,1,0); l.Parent = c
	return c, l end
local function buildOptIndicator(sg)
	local c = W.makeBlob("OptIndicator", sg, UDim2.new(0,160,0,22)); c.Position = UDim2.new(0,118,1,-34); c.Visible = false
	local l = Instance.new("TextLabel"); l.Name = "Label"; l.BackgroundTransparency = 1; l.Text = "Optimization: --"
	l.TextColor3 = T.MutedGold; l.Font = T.Font; l.TextSize = 10; l.Size = UDim2.new(1,0,1,0); l.Parent = c
	return c, l
end

local function buildToggles(sg)
	local bar = Instance.new("Frame"); bar.Name = "ToggleBar"; bar.BackgroundTransparency = 1
	bar.AnchorPoint = Vector2.new(1, 0)
	bar.Position = UDim2.new(1,-12,1,-34); bar.Size = UDim2.new(0,0,0,24)
	bar.AutomaticSize = Enum.AutomaticSize.X; bar.Parent = sg
	W.addListLayout(bar, 3, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right)

	-- Menu toggle button (always visible, rightmost)
	local menuBtn = W.makeButton("MenuToggle", bar, "\u{2261}", UDim2.new(0,24,0,24), T.Gold)
	menuBtn.TextSize = 16; menuBtn.LayoutOrder = 100

	-- Expandable strip (hidden by default, appears to the left)
	local strip = Instance.new("Frame"); strip.Name = "Strip"; strip.BackgroundColor3 = T.PanelBg
	strip.BackgroundTransparency = T.PanelAlpha; strip.Size = UDim2.new(0,0,0,24)
	strip.AutomaticSize = Enum.AutomaticSize.X; strip.Visible = false; strip.LayoutOrder = 0
	strip.BorderSizePixel = 0; strip.Parent = bar
	W.addCorner(strip, T.Corner); W.addStroke(strip); table.insert(W.getThemed().panels, strip)
	local sp = Instance.new("UIPadding"); sp.PaddingLeft = UDim.new(0,3); sp.PaddingRight = UDim.new(0,3); sp.Parent = strip
	local sl = Instance.new("UIListLayout"); sl.Padding = UDim.new(0,3); sl.FillDirection = Enum.FillDirection.Horizontal
	sl.SortOrder = Enum.SortOrder.LayoutOrder; sl.HorizontalAlignment = Enum.HorizontalAlignment.Right
	sl.VerticalAlignment = Enum.VerticalAlignment.Center; sl.Parent = strip

	local function makeStripBtn(name, text, color, lo)
		local b = W.makeButton(name, strip, text, UDim2.new(0,0,0,20), color)
		b.AutomaticSize = Enum.AutomaticSize.X; b.TextSize = 9; b.LayoutOrder = lo
		local p = Instance.new("UIPadding"); p.PaddingLeft = UDim.new(0,6); p.PaddingRight = UDim.new(0,6); p.Parent = b
		return b
	end

	local eb = makeStripBtn("EmitToggle", "Emit", T.Gold, 0)
	local pb = makeStripBtn("PropsToggle", "Properties", T.Gold, 1)
	local cb = makeStripBtn("CounterToggle", "Counter", T.DarkGold, 2)
	local qb = makeStripBtn("QolToggle", "Tools", T.DarkGold, 3)
	local sb = makeStripBtn("SettingsToggle", "Settings", T.DarkGold, 4)
	local ib = makeStripBtn("InventoryToggle", "Inventory", T.DarkGold, 5)
	local mb = makeStripBtn("MotionToggle", "Motion", T.DarkGold, 6)

	menuBtn.Activated:Connect(function() strip.Visible = not strip.Visible end)

	return {emitToggle = eb, propsToggle = pb, settingsToggle = sb, counterToggle = cb, qolToggle = qb, inventoryToggle = ib, motionToggle = mb, bar = bar, menuBtn = menuBtn, strip = strip}
end


-- THEME MANAGEMENT
local function _sweepDead(arr)
	local j = 1; for i = 1, #arr do if arr[i].Parent then arr[j] = arr[i]; j = j + 1 end end
	for i = j, #arr do arr[i] = nil end
end
function UIBuilder:UpdateTheme(primary, secondary, tertiary, panelAlpha, blobAlpha, fontName, textAccent, blobColor, scrollBarColor, fontScale, bgImage, bgImageTransparency)
	local _themed = W.getThemed()
	-- Sweep destroyed refs from themed arrays to prevent unbounded growth
	_sweepDead(_themed.strokes); _sweepDead(_themed.panels); _sweepDead(_themed.blobs)
	_sweepDead(_themed.fills); _sweepDead(_themed.scrollbars); _sweepDead(_themed.toggles)
	if _themed.panelImages then _sweepDead(_themed.panelImages) end
	-- Sweep evenDots: dots are created per populate cycle for selected items with
	-- EvenDistribution support; without sweep the array grows unboundedly across
	-- selection changes and theme refresh walks dead instances.
	if _themed.evenDots then _sweepDead(_themed.evenDots) end
	if primary then T.Border = primary; for _, s in ipairs(_themed.strokes) do if s.Parent then s.Color = primary end end end
	if secondary then T.PanelBg = secondary; for _, p in ipairs(_themed.panels) do if p.Parent then p.BackgroundColor3 = secondary end end end
	if tertiary then T.SliderFill = tertiary; for _, f in ipairs(_themed.fills) do if f.Parent then f.BackgroundColor3 = tertiary end end end
	if blobColor then T.BlobBg = blobColor; for _, b in ipairs(_themed.blobs) do if b.Parent then b.BackgroundColor3 = blobColor end end end
	if scrollBarColor then T.ScrollBar = scrollBarColor; for _, sb in ipairs(_themed.scrollbars) do if sb.Parent then sb.ScrollBarImageColor3 = scrollBarColor end end end
	if panelAlpha ~= nil then T.PanelAlpha = panelAlpha; for _, p in ipairs(_themed.panels) do if p.Parent and not p:GetAttribute("_opaquePanel") then p.BackgroundTransparency = panelAlpha end end end
	if blobAlpha ~= nil then T.BlobAlpha = blobAlpha; for _, b in ipairs(_themed.blobs) do if b.Parent then b.BackgroundTransparency = blobAlpha end end end
	if fontName and fontName ~= _currentFontName then
		local ok, font = pcall(function() return Enum.Font[fontName] end)
		if ok and font then
			T.Font = font; _currentFontName = fontName
			if self._screenGui then
				for _, desc in ipairs(self._screenGui:GetDescendants()) do
					if (desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox")) and not desc:GetAttribute("_noFontOverride") then
						desc.Font = font
					end
				end
			end
		end
	end
	if fontScale and fontScale > 0 then
		T.FontScale = fontScale
		if self._screenGui then
			for _, desc in ipairs(self._screenGui:GetDescendants()) do
				if (desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox")) and not desc:GetAttribute("_noFontOverride") then
					if not desc:GetAttribute("_baseTextSize") then desc:SetAttribute("_baseTextSize", desc.TextSize) end
					desc.TextSize = math.max(6, math.round(desc:GetAttribute("_baseTextSize") * fontScale))
				end
			end
		end
	end
	if textAccent then
		-- Capture old shades BEFORE updating T (critical for second+ changes to work)
		local oldShades = {
			Color3.new(T.BrightGold.R, T.BrightGold.G, T.BrightGold.B),
			Color3.new(T.Gold.R, T.Gold.G, T.Gold.B),
			Color3.new(T.MutedGold.R, T.MutedGold.G, T.MutedGold.B),
			Color3.new(T.DarkGold.R, T.DarkGold.G, T.DarkGold.B),
		}
		local bright, gold, muted, dark
		if C.isDefaultTextAccent(textAccent) then
			bright = C.DEFAULT_TEXT_SHADES.BrightGold
			gold = C.DEFAULT_TEXT_SHADES.Gold
			muted = C.DEFAULT_TEXT_SHADES.MutedGold
			dark = C.DEFAULT_TEXT_SHADES.DarkGold
		else
			bright, gold, muted, dark = C.deriveTextShades(textAccent)
		end
		T.TextAccent = textAccent; T.BrightGold = bright; T.Gold = gold; T.MutedGold = muted; T.DarkGold = dark
		local newShades = {bright, gold, muted, dark}
		-- Tolerance 0.04 (~10/255) to handle floating point drift from HSV derivation
		local TOL = 0.04
		if self._screenGui then
			for _, desc in ipairs(self._screenGui:GetDescendants()) do
				if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
					local tc = desc.TextColor3
					for i, old in ipairs(oldShades) do
						if math.abs(tc.R - old.R) < TOL and math.abs(tc.G - old.G) < TOL and math.abs(tc.B - old.B) < TOL then
							desc.TextColor3 = newShades[i]; break
						end
					end
					if desc:IsA("TextBox") then local pc = desc.PlaceholderColor3
						for i, old in ipairs(oldShades) do if math.abs(pc.R-old.R)<TOL and math.abs(pc.G-old.G)<TOL and math.abs(pc.B-old.B)<TOL then desc.PlaceholderColor3=newShades[i]; break end end
					end
				end
				if (desc:IsA("ImageButton") or desc:IsA("ImageLabel")) then local ic = desc.ImageColor3
					for i, old in ipairs(oldShades) do if math.abs(ic.R-old.R)<TOL and math.abs(ic.G-old.G)<TOL and math.abs(ic.B-old.B)<TOL then desc.ImageColor3=newShades[i]; break end end end
				-- Frames with a gold-accent BackgroundColor3 (e.g. the resize-edge highlight). Skip
				-- frames marked `_noColorRemap`  -  the ColorPicker's HS canvas layers use pure-white
				-- BG for gradient compositing, and a textAccent that derives a near-white BrightGold
				-- would otherwise hijack those whites and tint the rainbow on the next theme change.
				if (desc:IsA("Frame") or desc:IsA("ScrollingFrame")) and not desc:GetAttribute("_noColorRemap") then local bc = desc.BackgroundColor3
					for i, old in ipairs(oldShades) do if math.abs(bc.R-old.R)<TOL and math.abs(bc.G-old.G)<TOL and math.abs(bc.B-old.B)<TOL then desc.BackgroundColor3=newShades[i]; break end end end
			end
		end
		for _, tog in ipairs(_themed.toggles) do if tog.Parent then local dot = tog:FindFirstChild("Dot")
			if tog:GetAttribute("IsOn") then tog.BackgroundColor3 = Color3.fromRGB(40,55,30); if dot then dot.BackgroundColor3 = T.Green end
			else tog.BackgroundColor3 = T.BlobBg; tog.BackgroundTransparency = T.BlobAlpha; if dot then dot.BackgroundColor3 = dark end end
		end end
	end
	-- Producer: `WidgetAxis.trackAxis` registers `{btn, color, selBg}` entries.
	-- `_selected` on the button (set by WidgetAxis axis-toggle handlers) drives the
	-- selected-style paint here.
	for _, e in ipairs(_themed.axisButtons) do if e.btn.Parent then -- axis buttons
		if e.btn:GetAttribute("_selected") then e.btn.BackgroundColor3 = e.selBg; e.btn.BackgroundTransparency = 0.15; e.btn.TextColor3 = e.color
		else e.btn.BackgroundColor3 = T.BlobBg; e.btn.BackgroundTransparency = T.BlobAlpha; e.btn.TextColor3 = T.DarkGold end
	end end
	-- axisColored entries follow AxisX/Y/Z theme colors. Used by WidgetAxis checkmarks etc.
	if _themed.axisColored then
		for _, e in ipairs(_themed.axisColored) do
			if e.inst and e.inst.Parent then
				local col = T["Axis" .. (e.axis or "X")]
				if col then e.inst[e.prop] = col end
			end
		end
	end
	-- EvenDistribution per-axis dots paint BrightGold (on) / DarkGold (off) based on
	-- the `_even` attribute; without this sweep theme edits leave the dots stuck on
	-- initial-time colors until the next populate-driven refresh.
	if _themed.evenDots then
		for _, dot in ipairs(_themed.evenDots) do
			if dot and dot.Parent then
				dot.BackgroundColor3 = dot:GetAttribute("_even") and T.BrightGold or T.DarkGold
			end
		end
	end
	-- Decorative background image: write Image + ImageTransparency to every registered
	-- panel-image layer. Empty BgImage paints nothing, ImageTransparency=1 hides cleanly.
	if bgImage ~= nil then T.BgImage = bgImage end
	if bgImageTransparency ~= nil then T.BgImageTransparency = bgImageTransparency end
	if _themed.panelImages then
		for _, img in ipairs(_themed.panelImages) do
			if img.Parent then
				img.Image = T.BgImage or ""
				img.ImageTransparency = T.BgImageTransparency or 1
			end
		end
	end
end

function UIBuilder:SnapshotTheme()
	return {
		Border = T.Border, PanelBg = T.PanelBg, SliderFill = T.SliderFill,
		BlobBg = T.BlobBg, PanelAlpha = T.PanelAlpha, BlobAlpha = T.BlobAlpha, Font = T.Font,
		TextAccent = T.TextAccent, ScrollBar = T.ScrollBar,
		BrightGold = T.BrightGold, Gold = T.Gold, MutedGold = T.MutedGold, DarkGold = T.DarkGold,
		BgImage = T.BgImage, BgImageTransparency = T.BgImageTransparency,
	}
end

function UIBuilder:RestoreTheme(snap)
	-- Don't pre-set text shades: UpdateTheme needs current (preview) values as oldShades to shade-match
	self:UpdateTheme(snap.Border, snap.PanelBg, snap.SliderFill, snap.PanelAlpha, snap.BlobAlpha, snap.Font.Name, snap.TextAccent, snap.BlobBg, snap.ScrollBar)
end


-- BUILD (orchestrator)
function UIBuilder:Build(TypeRegistry)
	-- Reset widget tracking
	W.reset()
	for _, old in pairs(game:GetService('CoreGui'):GetChildren()) do
		if old:IsA("ScreenGui") and old.Name == "PartIclesUI" then old:Destroy() end
	end
	local sg = Instance.new("ScreenGui"); sg.Name = "PartIclesUI"; sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	sg.ResetOnSpawn = false; sg.Enabled = false; sg.Parent = game:GetService('CoreGui')
	UIBuilder._screenGui = sg
	-- Hand the ScreenGui to the toast system so showToast can parent its frames.
	if W.setToastParent then W.setToastParent(sg) end
	local uiScale = Instance.new("UIScale"); uiScale.Scale = 1.15; uiScale.Parent = sg

	local hudRefs = buildHUD(sg)
	local propRefs = BP.buildProperties(sg)
	local settingsRefs = buildSettings(sg)
	local counter, counterLabel = buildCounter(sg)
	local optIndicator, optLabel = buildOptIndicator(sg)
	local toggleRefs = buildToggles(sg)
	local qMenuRefs = TP.buildQMenu(sg)
	local resizeRefs = TP.buildResize(sg)
	local retimeRefs = TP.buildRetime(sg)
	local clipboardRefs = TP.buildClipboard(sg, TypeRegistry)
	local shifterRefs = TP.buildShifter(sg, TypeRegistry)
	local hueRefs = TP.buildHueChanger(sg)
	local emitCodeRefs = TP.buildEmitCode(sg)
	local fixRefs = TP.buildFixBanner(sg)
	local themeRefs = BP.buildThemeEditor(sg)
	local dotsMenuRefs = W.buildDotsMenu(sg)
	local inventoryRefs = IP.build(sg)
	-- Randomizer modal panel. Wiring + button handlers attached in init.server.lua
	-- because RandomizerWiring needs ctx-bound deps. Refs merge into `ui` below
	-- (panel + buttons + headerCloseBtn referenced by name from init.server.lua).
	local RandomizerPanel = require(script.RandomizerPanel)
	local randomizerRefs = RandomizerPanel.build(sg)
	-- Re-key under "Randomizer" prefix to avoid clashing with QMenu's "Randomize" Activated button.
	local randomizerUI = {
		RandomizerPanel = randomizerRefs.panel,
		RandomizerSectionList = randomizerRefs.sectionList,
		RandomizerRollAllBtn = randomizerRefs.rollAllBtn,
		RandomizerApplyBtn = randomizerRefs.applyBtn,
		RandomizerCancelBtn = randomizerRefs.cancelBtn,
		RandomizerHeaderCloseBtn = randomizerRefs.headerCloseBtn,
	}
	-- ShortcutPanel modal. Bootstrap (Modules/Shortcuts) wires the Settings panel
	-- "Shortcuts" button to wiring.open/close, and panel headerCloseBtn to close().
	local ShortcutPanel = require(script.ShortcutPanel)
	local shortcutRefs = ShortcutPanel.build(sg)
	local shortcutUI = {
		ShortcutPanel = shortcutRefs.panel,
		ShortcutsList = shortcutRefs.scrollList,
		ShortcutsSearch = shortcutRefs.searchBox,
		ShortcutsReset = shortcutRefs.resetBtn,
		ShortcutsHeaderClose = shortcutRefs.headerCloseBtn,
	}

	-- Default positions: [Resize][Retime][Shifter][Clipboard][Properties] left to right
	local dockGap = 6
	local col1 = -(LAYOUT.PropsX + dockGap + 110)                -- Clipboard (110w, closest to Properties)
	local col2 = -(LAYOUT.PropsX + dockGap + 110 + dockGap + 110) -- Shifter (110w)
	local col3 = -(LAYOUT.PropsX + dockGap + 110 + dockGap + 110 + dockGap + 120) -- Retime (120w)
	local col4 = -(LAYOUT.PropsX + dockGap + 110 + dockGap + 110 + dockGap + 120 + dockGap + 120) -- Resize (120w)
	local defaultPositions = {
		[clipboardRefs.ClipboardPanel]  = UDim2.new(1, col1, 0, LAYOUT.PropsY),
		[shifterRefs.ShifterPanel]      = UDim2.new(1, col2, 0, LAYOUT.PropsY),
		[retimeRefs.RetimePanel]        = UDim2.new(1, col3, 0, LAYOUT.PropsY),
		[resizeRefs.ResizePanel]        = UDim2.new(1, col4, 0, LAYOUT.PropsY),
		[hueRefs.HuePanel]             = UDim2.new(0, 12, 1, -400),
		[emitCodeRefs.EmitCodePanel]    = UDim2.new(0, 100, 1, -260),
		-- RandomizerPanel: centered modal (220x400, _noSnap so resolveOverlap won't
		-- rescue it). W.makeToolPanel sets no default Position, so a missing entry
		-- here would leave the modal pinned at top-left (0,0) on first open.
		[randomizerRefs.panel]          = UDim2.new(0.5, -110, 0.5, -200),
		-- ShortcutPanel: centered modal (300x420, _noSnap). Same default-Position
		-- requirement as RandomizerPanel above  -  never ship a _noSnap panel without
		-- an explicit defaultPositions entry or it pins to top-left.
		[shortcutRefs.panel]            = UDim2.new(0.5, -150, 0.5, -210),
	}

	-- Record original sizes for reset
	local defaultSizes = {}
	for panel, pos in pairs(defaultPositions) do
		panel.Position = pos; defaultSizes[panel] = panel.Size
	end
	defaultSizes[inventoryRefs.InventoryPanel] = inventoryRefs.InventoryPanel.Size

	-- Register panels for magnetic snap
	W.registerPanel(hudRefs.HUD)
	W.registerPanel(propRefs.PropsPanel)
	W.registerPanel(settingsRefs.SettingsPanel)
	W.registerPanel(qMenuRefs.QMenu)
	W.registerPanel(resizeRefs.ResizePanel)
	W.registerPanel(retimeRefs.RetimePanel)
	W.registerPanel(hueRefs.HuePanel)
	W.registerPanel(clipboardRefs.ClipboardPanel)
	W.registerPanel(shifterRefs.ShifterPanel)
	W.registerPanel(inventoryRefs.InventoryPanel)
	if inventoryRefs.InvDetail then W.registerPanel(inventoryRefs.InvDetail) end

	-- Paired spawning (place to the left of partner)
	local function positionPairBeside(panel, partner)
		if partner.Visible then
			local scale = 1
			local sg2 = partner:FindFirstAncestorOfClass("ScreenGui")
			if sg2 then local us = sg2:FindFirstChildOfClass("UIScale"); if us then scale = us.Scale end end
			local pW = panel.AbsoluteSize.X / scale
			local px = partner.AbsolutePosition.X / scale - pW - 6
			panel.Position = UDim2.new(0, px, partner.Position.Y.Scale, partner.Position.Y.Offset)
		end
	end

	local function toggleWithPair(panel, partner)
		panel.Visible = not panel.Visible
		if panel.Visible then
			positionPairBeside(panel, partner)
			task.defer(function() W.resolveOverlap(panel) end)
		end
	end

	-- Layout reset
	local function resetLayout()
		for panel, pos in pairs(defaultPositions) do panel.Position = pos end
		for panel, size in pairs(defaultSizes) do panel.Size = size end
		hudRefs.HUD.Position = UDim2.new(0, LAYOUT.HudX, 0, LAYOUT.HudY)
		propRefs.PropsPanel.Position = UDim2.new(1, -LAYOUT.PropsX, 0, LAYOUT.PropsY)
		qMenuRefs.QMenu.Position = UDim2.new(1, -12, 1, -40)
		inventoryRefs.InventoryPanel.Position = UDim2.new(0.5, -240, 0.2, 0)
		if inventoryRefs.InvDetail then inventoryRefs.InvDetail.Visible = false end
		if inventoryRefs.InvImportDialog then inventoryRefs.InvImportDialog.Visible = false end
		if inventoryRefs.InvAddDialog then inventoryRefs.InvAddDialog.Visible = false end
	end

	-- Wire toggles (HUD/Props close buttons wired in QOLWiring where ctx is available)
	local function dimToggle(btn, panel)
		btn.Activated:Connect(function() panel.Visible = not panel.Visible; btn.TextColor3 = panel.Visible and T.Gold or T.DarkGold end)
	end
	-- Settings toolbar toggle: wired to toolToggles.toggleSettings below so click + Action
	-- share one path (color stays in sync regardless of trigger).
	settingsRefs.SettingsClose.Activated:Connect(function() settingsRefs.SettingsPanel.Visible = false; toggleRefs.settingsToggle.TextColor3 = T.DarkGold end)
	dimToggle(toggleRefs.counterToggle, counter)
	dimToggle(toggleRefs.qolToggle, qMenuRefs.QMenu)
	if qMenuRefs.QMenuClose then qMenuRefs.QMenuClose.Activated:Connect(function() toggleRefs.qolToggle.TextColor3 = T.DarkGold end) end

	-- Tool-toggle helpers extracted so both QMenu Activated and Actions shortcut
	-- handlers go through the same path (pair positioning + deferred resolveOverlap +
	-- Settings color sync). Exposed via the returned `ui` table.
	local function _toggleSolo(panel)
		panel.Visible = not panel.Visible
		if panel.Visible then task.defer(function() W.resolveOverlap(panel) end) end
	end
	local toolToggles = {
		toggleResize    = function() toggleWithPair(resizeRefs.ResizePanel, retimeRefs.RetimePanel) end,
		toggleRetime    = function() toggleWithPair(retimeRefs.RetimePanel, resizeRefs.ResizePanel) end,
		toggleClipboard = function() toggleWithPair(clipboardRefs.ClipboardPanel, shifterRefs.ShifterPanel) end,
		toggleShifter   = function() toggleWithPair(shifterRefs.ShifterPanel, clipboardRefs.ClipboardPanel) end,
		toggleHue       = function() _toggleSolo(hueRefs.HuePanel) end,
		toggleEmitCode  = function() _toggleSolo(emitCodeRefs.EmitCodePanel) end,
		toggleSettings  = function()
			settingsRefs.SettingsPanel.Visible = not settingsRefs.SettingsPanel.Visible
			toggleRefs.settingsToggle.TextColor3 = settingsRefs.SettingsPanel.Visible and T.Gold or T.DarkGold
		end,
	}
	qMenuRefs.Resize.Activated:Connect(toolToggles.toggleResize)
	qMenuRefs.Retime.Activated:Connect(toolToggles.toggleRetime)
	qMenuRefs.Hue.Activated:Connect(toolToggles.toggleHue)
	qMenuRefs.Clipboard.Activated:Connect(toolToggles.toggleClipboard)
	qMenuRefs.Shifter.Activated:Connect(toolToggles.toggleShifter)
	qMenuRefs.EmitCode.Activated:Connect(toolToggles.toggleEmitCode)
	toggleRefs.settingsToggle.Activated:Connect(toolToggles.toggleSettings)
	settingsRefs.ResetLayout = resetLayout

	if settingsRefs.EditThemeButton then
		settingsRefs.EditThemeButton.Activated:Connect(function()
			themeRefs.ThemeEditor.Visible = true
		end)
	end

	local ui = {}
	for _, tbl in ipairs({hudRefs, propRefs, settingsRefs, qMenuRefs, resizeRefs, retimeRefs, hueRefs, clipboardRefs, shifterRefs, emitCodeRefs, fixRefs, themeRefs, dotsMenuRefs, inventoryRefs, randomizerUI, shortcutUI}) do
		for k, v in pairs(tbl) do ui[k] = v end
	end
	sg.Enabled = true -- Show UI only after everything is built (prevents partial flash under obfuscation)
	ui.ScreenGui = sg; ui.UIScale = uiScale; ui.Counter = counter; ui.CounterLabel = counterLabel
	ui.OptIndicator = optIndicator; ui.OptLabel = optLabel; ui.Toggles = toggleRefs
	-- Tool-toggle helpers exposed so shortcut Actions can mirror toolbar behavior.
	for k, v in pairs(toolToggles) do ui[k] = v end
	return ui
end

UIBuilder.Theme = T
UIBuilder.color3ToHex = C.color3ToHex
UIBuilder.hexToColor3 = C.hexToColor3
UIBuilder.FONT_OPTIONS = C.FONT_OPTIONS
UIBuilder.THEME_PRESETS = C.THEME_PRESETS
UIBuilder.hideDropdownExpansion = W.hideDropdownExpansion
UIBuilder.getThemed = W.getThemed
UIBuilder.cleanup = W.reset -- disconnect UIS connections on teardown
return UIBuilder
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">BuildProperties</string>
              <string name="Source"><![CDATA[-- BuildProperties - Part-Icles V5 (split from UIBuilder/init.luau)
-- Copyright (C) 2026 Qwinkle
local C = require(script.Parent.Constants)
local W = require(script.Parent.Widgets)
local WidgetEvents = require(script.Parent.WidgetEvents)
local T = C.T
local LAYOUT = C.LAYOUT
local BuildProperties = {}

-- Append the Events section to a per-type section body. Each transformed type gets its
-- own collapsible Events block at the bottom of its section list. Returns the events
-- refs sub-table to slot under refs.<Type>.Events.
local function appendEventsTo(typeRefs, section, typeName, layoutOrder)
	if not section then return end
	local body = section:FindFirstChild("Body") or section
	typeRefs.Events = WidgetEvents.buildEventsSection(body, typeName, layoutOrder)
end

function BuildProperties.buildProperties(screenGui)
	local panel = Instance.new("Frame"); panel.Name = "PropertiesPanel"
	panel.BackgroundColor3 = T.PanelBg; panel.BackgroundTransparency = T.PanelAlpha
	panel.Position = UDim2.new(1,-LAYOUT.PropsX,0,LAYOUT.PropsY)
	panel.Size = UDim2.new(0,LAYOUT.PropsWidth,0,LAYOUT.PropsHeight)
	panel.ClipsDescendants = true; panel.Active = true; panel.Visible = false; panel.Parent = screenGui
	W.addCorner(panel, T.BigCorner); W.addStroke(panel); W.addPadding(panel,6,6,6,6)
	table.insert(W.getThemed().panels, panel)
	W.attachPanelBackground(panel)
	W.makeResizable(panel, 200, 100)
	local refs = {}

	-- Header
	local header = W.makeBlob("Header", panel, UDim2.new(1,0,0,26)); header.Position = UDim2.new(0,0,0,0)
	local ht = Instance.new("TextLabel"); ht.BackgroundTransparency = 1; ht.Text = "Properties"
	ht.TextColor3 = T.Gold; ht.Font = T.Font; ht.TextSize = 12; ht.TextXAlignment = Enum.TextXAlignment.Left
	ht.Size = UDim2.new(1,-24,1,0); ht.Position = UDim2.new(0,8,0,0); ht.Parent = header
	local cb = Instance.new("TextButton"); cb.Name = "Close"; cb.BackgroundTransparency = 1
	cb.Text = "X"; cb.TextColor3 = T.DarkGold; cb.Font = T.Font; cb.TextSize = 12
	cb.Size = UDim2.new(0,20,1,0); cb.Position = UDim2.new(1,-22,0,0); cb.ZIndex = 3; cb.Parent = header; refs.CloseButton = cb
	local pdh = Instance.new("TextButton"); pdh.Name = "DragHandle"; pdh.BackgroundTransparency = 1
	pdh.Text = ""; pdh.Size = UDim2.new(1,-24,1,0); pdh.ZIndex = 2; pdh.Parent = header; W.makeDraggable(panel, pdh)
	-- Search bar
	local searchWrap = W.makeBlob("SearchWrap", panel, UDim2.new(1,0,0,20)); searchWrap.Position = UDim2.new(0,0,0,28)
	local sb = Instance.new("TextBox"); sb.Name = "SearchBox"; sb.BackgroundTransparency = 1
	sb.Text = ""; sb.PlaceholderText = "Search properties..."; sb.TextColor3 = T.BrightGold; sb.PlaceholderColor3 = T.DarkGold
	sb.Font = T.Font; sb.TextSize = 9; sb.TextXAlignment = Enum.TextXAlignment.Left; sb.ClearTextOnFocus = false
	sb.Size = UDim2.new(1,-8,1,0); sb.Position = UDim2.new(0,4,0,0); sb.BorderSizePixel = 0; sb.Parent = searchWrap; refs.SearchBox = sb
	-- Scroll
	local scroll = Instance.new("ScrollingFrame"); scroll.Name = "Content"; scroll.BackgroundTransparency = 1
	scroll.Position = UDim2.new(0,0,0,52); scroll.Size = UDim2.new(1,0,1,-52); scroll.CanvasSize = UDim2.new(0,0,0,0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y; scroll.ScrollBarThickness = 3; scroll.ScrollBarImageColor3 = T.ScrollBar
	table.insert(W.getThemed().scrollbars, scroll)
	scroll.BorderSizePixel = 0; scroll.Parent = panel; W.addListLayout(scroll, 4)
	W.addCollapseButton(header, {searchWrap, scroll}, {
		panel = panel, expandedSize = UDim2.new(0, LAYOUT.PropsWidth, 0, LAYOUT.PropsHeight),
		collapsedSize = UDim2.new(0, LAYOUT.PropsWidth, 0, 38), arrowPos = UDim2.new(1,-36,0,0),
	})

	-- ==========================================
	-- PART PROPERTIES
	-- ==========================================
	local partDefs = {
		{name = "Spawning", rows = {
			{key="EmissionMode", label="Mode", type="dropdown", options={"Emit","Animate"}, default="Emit"},
			{key="Orientation", label="Orientation", type="dropdown", options={"None","FacingCamera","FacingCameraWorldUp","VelocityParallel","VelocityPerpendicular"}, default="None"},
			{key="AnimateLoop", label="Loop", type="toggle"},
			{key="Direction", label="Direction", type="dropdown", options={"Top","Bottom","Front","Back","Left","Right"}, default="Top"},
			{key="Enabled", label="Enabled", type="toggle"},
			{key="Rate", label="Rate", type="input", default="10"},
			{key="Lifetime", label="Lifetime", type="input", default="1, 1", placeholder="min, max"},
			{key="SpreadAngle", label="SpreadAngle", type="input", default="0, 0", placeholder="x, y"},
			{key="RotOrder", label="Rot Order", type="dropdown", options={"Global","LocalXYZ","LocalXZY","LocalYXZ","LocalYZX","LocalZXY","LocalZYX"}, default="Global"},
			{key="Rot", label="Rotation", type="axis_input", axes={"X","Y","Z"}, placeholder="min, max", config={kind="axis-link", axes={"RotX","RotY","RotZ"}, evenAttrs={X="RotXEven", Y="RotYEven", Z="RotZEven"}}},
			{key="PosMode", label="Pos. Mode", type="dropdown", options={"Local","Global","RigidLocal"}, default="Local"},
			{key="Pos", label="Position", type="axis_input", axes={"X","Y","Z"}, placeholder="min, max", config={kind="axis-link", axes={"PosX","PosY","PosZ"}, evenAttrs={X="PosXEven", Y="PosYEven", Z="PosZEven"}}},
			{key="ZOffset", label="Z-Offset", type="input", default="0"},
		}},
		{name = "Appearance", rows = {
			{key="Material", label="Material", type="dropdown", options={"Plastic","SmoothPlastic","Neon","Glass","Metal","DiamondPlate","Foil","Brick","Concrete","Granite","Marble","Slate","Wood","WoodPlanks","Fabric","Ice","Sand","Grass","Pebble","Rock"}, default="Plastic"},
			{key="Brightness", label="Brightness", type="graph"},
			{key="Color", label="Color", type="color"},
			{key="Transparency", label="Transparency", type="graph"},
			{key="Size", label="Size", type="axis_graph_select", axes={"X","Y","Z"}, config={kind="axis-link", axes={"SizeX","SizeY","SizeZ"}}},
		}},
		{name = "Movement", collapsed = true, rows = {
			{key="Speed", label="Speed", type="graph"},
			{key="PosOffset", label="Displacement", type="axis_graph_select", axes={"X","Y","Z"}, config={kind="axis-link", axes={"PosOffsetX","PosOffsetY","PosOffsetZ"}}},
			{key="RotMode", label="Rotation Mode", type="dropdown", options={"OverLife","Speed"}, default="OverLife"},
			{key="RotSpeed", label="Rotation Speed", type="axis_graph_select", axes={"X","Y","Z"}, config={kind="axis-link", axes={"RotSpeedX","RotSpeedY","RotSpeedZ"}}},
			{key="Acceleration", label="Acceleration", type="input", default="0, 0, 0", placeholder="x, y, z"},
			{key="Drag", label="Drag", type="input", default="0"},
			{key="DirMode", label="Dir. Mode", type="dropdown", options={"RigidLocal","Local","Global"}, default="RigidLocal"},
			{key="DisplacementMode", label="Displacement Mode", type="dropdown", options={"Global","Local","RigidLocal"}, default="Global"},
			{key="InvertMotion", label="Reverse Motion", type="toggle"},
			{key="AccelerationTowardsInstance", label="Accel toward", type="toggle_group", children={
				{key="AccelTarget", label="Target", type="path", config={kind="instance-picker", objectValue="AccelTarget"}},
				{key="AccelStrength", label="Strength", type="graph"},
			}},
		}},
		{name = "Shape", collapsed = true, rows = {
			{key="UseShape", label="Use shape", type="toggle_group", children={
				{key="Shape",            label="Shape",            type="dropdown", options={"Box","Sphere","Cylinder","Disc"}, default="Box"},
				{key="ShapeInOut",       label="Direction",        type="dropdown", options={"Outward","Inward","InAndOut"}, default="Outward"},
				{key="ShapePartial",     label="Hollow",           type="input",    default="0", placeholder="0=solid, 1=hollow"},
				{key="LookAtInitially",  label="Look at initially", type="toggle"},
				{key="ShapePart",        label="Shape Part",        type="path",    config={kind="instance-picker", objectValue="ShapePart", validate="BasePart"}},
			}},
		}},
		{name = "Flipbook", collapsed = true, rows = {
			{key="FlipMode", label="Mode", type="dropdown", options={"None","OneShot","Loop"}, default="OneShot"},
			{key="FlipFramerate", label="Framerate", type="input", default="30, 30", placeholder="min, max"},
			{key="FlipStartRandom", label="StartRandom", type="toggle"},
			{key="FlipReverse", label="Reverse", type="toggle"},
		}},
		{name = "Advanced", collapsed = true, rows = {
			{key="Timescale", label="Timescale", type="graph"},
			{key="Keyframes", label="Anim. Steps", type="input", default="100"},
			{key="Linger", label="Linger", type="input", default="0", placeholder="seconds"},
			{key="EmitParent", label="Emit Into", type="path", config={kind="instance-picker", objectValue="EmitParent", acceptAnyInstance=true}},
			{key="Link", label="Link Dir.", type="path", config={kind="instance-picker", objectValue="Link", setAttributes={LinkSource="Object"}, clearAttributes={LinkSource="None"}}},
			{key="LinkSource", label="Link", type="dropdown", options={"None","Camera","Object"}, default="None"},
			{key="LinkMode", label="Link Mode", type="dropdown", options={"Weld","Follow","Pivot","WeldWithoutRotation"}, default="Follow"},
			{key="PreloadTexture", label="Preload Texture", type="toggle"},
			{key="Pool", label="Pool", type="toggle"},
		}},
	}

	refs.MeshSection, refs.Part = W.buildTypeSection(scroll, "Meshes", partDefs, 0)
	refs.MeshSection.Visible = false
	appendEventsTo(refs.Part, refs.MeshSection, "Part", 100)
	-- ==========================================
	-- BEAM PROPERTIES
	-- ==========================================
	local beamDefs = {
		{name = "Spawning", rows = {
			{key="EmissionMode", label="Mode", type="dropdown", options={"Emit","Animate"}, default="Emit"},
			{key="AnimateLoop", label="Loop", type="toggle"},
			{key="Enabled", label="Enabled", type="toggle"},
			{key="Rate", label="Rate", type="input", default="10"},
			{key="Lifetime", label="Lifetime", type="input", default="1, 1", placeholder="min, max"},
			{key="Attachment0", label="Attachment 0", type="path", config={kind="instance-picker", renderTemplateProperty="Attachment0", validate="Attachment"}},
			{key="Attachment1", label="Attachment 1", type="path", config={kind="instance-picker", renderTemplateProperty="Attachment1", validate="Attachment"}},
		}},
		{name = "Appearance", rows = {
			{key="Texture", label="Texture", type="input", default="", placeholder="rbxassetid:// or ID"},
			{key="Brightness", label="Brightness", type="graph"},
			{key="Width0", label="Width0", type="graph"},
			{key="Width1", label="Width1", type="graph"},
			{key="LightEmission", label="Light Emission", type="graph"},
			{key="LightInfluence", label="Light Influence", type="graph"},
		}},
		{name = "Geometry", rows = {
			{key="CurveSize0", label="CurveSize0", type="graph"},
			{key="CurveSize1", label="CurveSize1", type="graph"},
			{key="Segments", label="Segments", type="graph"},
			{key="TextureLength", label="Tex. Length", type="graph"},
			{key="TextureSpeed", label="Tex. Speed", type="graph"},
			{key="TextureMode", label="Tex. Mode", type="dropdown", options={"Stretch","Wrap","Static"}, default="Stretch"},
			{key="ZOffset", label="ZOffset", type="input", default="0"},
			{key="FaceCamera", label="FaceCamera", type="toggle"},
		}},
		{name = "Flipbook", collapsed = true, rows = {
			{key="FlipMode", label="Mode", type="dropdown", options={"None","OneShot","Loop"}, default="OneShot"},
			{key="FlipFramerate", label="Framerate", type="input", default="30, 30", placeholder="min, max"},
			{key="FlipStartRandom", label="StartRandom", type="toggle"},
			{key="FlipReverse", label="Reverse", type="toggle"},
		}},
		{name = "Advanced", collapsed = true, rows = {
			{key="Timescale", label="Timescale", type="graph"},
			{key="Keyframes", label="Anim. Steps", type="input", default="100"},
			{key="EmitParent", label="Emit Into", type="path", config={kind="instance-picker", objectValue="EmitParent", acceptAnyInstance=true}},
			{key="PreloadTexture", label="Preload Texture", type="toggle"},
			{key="Pool", label="Pool", type="toggle"},
		}},
	}

	refs.BeamSection, refs.Beam = W.buildTypeSection(scroll, "Beams", beamDefs, 1)
	refs.BeamSection.Visible = false
	appendEventsTo(refs.Beam, refs.BeamSection, "Beam", 100)

	do local beamBody = refs.BeamSection:FindFirstChild("Body"); if beamBody then refs.BlenderSection, refs.BlenderAddBtn, refs.BlenderStateList = W.makeBlenderBox(beamBody, "AddState", "StateList") end end

	-- ==========================================
	-- POINTLIGHT PROPERTIES
	-- ==========================================
	local plDefs = {
		{name = "Spawning", rows = {
			{key="Enabled", label="Enabled", type="toggle"},
			{key="Rate", label="Rate", type="input", default="10"},
			{key="Lifetime", label="Lifetime", type="input", default="1, 1", placeholder="min, max"},
		}},
		{name = "Appearance", rows = {
			{key="Range", label="Range", type="graph"},
			{key="Brightness", label="Brightness", type="graph"},
			{key="Color", label="Color", type="color"},
			{key="Shadows", label="Shadows", type="toggle"},
		}},
		{name = "Advanced", collapsed = true, rows = {
			{key="Timescale", label="Timescale", type="graph"},
			{key="Keyframes", label="Anim. Steps", type="input", default="100"},
			{key="Linger", label="Linger", type="input", default="0"},
			{key="EmitParent", label="Emit Into", type="path", config={kind="instance-picker", objectValue="EmitParent", acceptAnyInstance=true}},
			{key="Pool", label="Pool", type="toggle"},
		}},
	}

	refs.PointLightSection, refs.PointLight = W.buildTypeSection(scroll, "PointLights", plDefs, 2)
	refs.PointLightSection.Visible = false
	appendEventsTo(refs.PointLight, refs.PointLightSection, "PointLight", 100)

	-- ==========================================
	-- HIGHLIGHT PROPERTIES
	-- ==========================================
	local hlDefs = {
		{name = "Spawning", rows = {
			{key="EmissionMode", label="Mode", type="dropdown", options={"Emit","Animate"}, default="Emit"}, {key="AnimateLoop", label="Loop", type="toggle"},
			{key="Enabled", label="Enabled", type="toggle"},
			{key="Rate", label="Rate", type="input", default="10"},
			{key="Lifetime", label="Lifetime", type="input", default="1, 1", placeholder="min, max"},
			{key="Adornee", label="Adornee", type="path", config={kind="instance-picker", objectValue="Adornee", acceptAnyInstance=true}},
		}},
		{name = "Appearance", rows = {
			{key="FillColor", label="Fill Color", type="color"},
			{key="FillTransparency", label="Fill Transparency", type="graph"},
			{key="OutlineColor", label="Outline Color", type="color"},
			{key="OutlineTransparency", label="Outline Transparency", type="graph"},
			{key="DepthMode", label="Depth Mode", type="dropdown", options={"AlwaysOnTop", "Occluded"}},
		}},
		{name = "Advanced", collapsed = true, rows = {
			{key="Timescale", label="Timescale", type="graph"},
			{key="Keyframes", label="Anim. Steps", type="input", default="100"},
			{key="Linger", label="Linger", type="input", default="0"},
			{key="EmitParent", label="Emit Into", type="path", config={kind="instance-picker", objectValue="EmitParent", acceptAnyInstance=true}},
			{key="Pool", label="Pool", type="toggle"},
		}},
	}

	refs.HighlightSection, refs.Highlight = W.buildTypeSection(scroll, "Highlights", hlDefs, 2)
	refs.HighlightSection.Visible = false
	appendEventsTo(refs.Highlight, refs.HighlightSection, "Highlight", 100)

	-- ==========================================
	-- TRAIL PROPERTIES
	-- ==========================================
	local trailDefs = {
		{name = "Emission", rows = {
			{key="Enabled", label="Enabled", type="toggle"},
			{key="Lifetime", label="Lifetime", type="input", default="2"},
			-- Trail emit duration is edited from the EmitSection's Duration textbox at the
			-- top of the panel (writes to the same EmitDuration attribute), so we don't
			-- duplicate it as a row here. PopulateExtra.populateTrails / PropertyInputs /
			-- SelectionHandler all guard on `TR.Duration and TR.Duration.input`, so their
			-- Duration paths become no-ops when the row isn't built.
			{key="Attachment0", label="Attachment 0", type="path", config={kind="instance-picker", directProperty="Attachment0", validate="Attachment"}},
			{key="Attachment1", label="Attachment 1", type="path", config={kind="instance-picker", directProperty="Attachment1", validate="Attachment"}},
		}},
		{name = "Appearance", rows = {
			{key="Texture", label="Texture", type="input", default="", placeholder="rbxassetid:// or ID"},
			{key="Brightness", label="Brightness", type="input", default="1"},
			{key="Transparency", label="Transparency", type="graph"},
			{key="Color", label="Color", type="color"},
			{key="WidthScale", label="WidthScale", type="graph"},
			{key="LightEmission", label="Light Emission", type="input", default="0"},
			{key="LightInfluence", label="Light Influence", type="input", default="1"},
		}},
		{name = "Geometry", rows = {
			{key="MinLength", label="MinLength", type="input", default="0.1"},
			{key="MaxLength", label="MaxLength", type="input", default="0"},
			{key="TextureLength", label="Tex. Length", type="input", default="1"},
			{key="TextureMode", label="Tex. Mode", type="dropdown", options={"Stretch","Wrap","Static"}, default="Stretch"},
			{key="FaceCamera", label="FaceCamera", type="toggle"},
		}},
		{name = "Advanced", collapsed = true, rows = {
			{key="PreloadTexture", label="Preload Texture", type="toggle"},
		}},
	}

	refs.TrailSection, refs.Trail = W.buildTypeSection(scroll, "Trails", trailDefs, 3)
	refs.TrailSection.Visible = false

	-- BeamNative section lives in sibling file to keep BuildProperties under the 500-cap.
	local BPBN = require(script.Parent.BuildPropertiesBeamNative)
	BPBN.buildSection(scroll, refs, 3)

	-- ==========================================
	-- TRAIL EMITTER PROPERTIES (post-Transform-as-Emitter)
	-- ==========================================
	local teDefs = {
		{name = "Spawning", rows = {
			{key="EmissionMode", label="Mode", type="dropdown", options={"Emit","Animate"}, default="Emit"},
			{key="AnimateLoop",  label="Loop", type="toggle"},
			{key="Enabled", label="Enabled", type="toggle"},
			{key="Rate", label="Rate", type="input", default="10"},
			{key="Lifetime", label="Lifetime", type="input", default="2, 2", placeholder="min, max"},
			{key="TrailLife", label="Trail Life", type="input", default="2, 2", placeholder="min, max"},
		}},
		{name = "Appearance", rows = {
			{key="Texture", label="Texture", type="input", default="", placeholder="rbxassetid:// or ID"},
			{key="Brightness", label="Brightness", type="graph"},
			{key="LightEmission", label="Light Emission", type="graph"},
			{key="LightInfluence", label="Light Influence", type="graph"},
			{key="TextureMode", label="Tex. Mode", type="dropdown", options={"Stretch","Wrap","Static"}, default="Stretch"},
			{key="FaceCamera", label="FaceCamera", type="toggle"},
		}},
		{name = "Geometry", rows = {
			{key="TextureLength", label="Tex. Length", type="graph"},
			{key="MinLength", label="MinLength", type="graph"},
			{key="MaxLength", label="MaxLength", type="graph"},
		}},
		{name = "Flipbook", collapsed = true, rows = {
			{key="TrailFlipbookMode", label="Mode", type="dropdown", options={"None","OneShot","Loop","PingPong"}, default="OneShot"},
			{key="TrailFlipbookFramerate", label="Framerate", type="input", default="30, 30", placeholder="min, max"},
			{key="TrailFlipbookStartRandom", label="Start Random", type="toggle"},
			{key="TrailFlipbookReverse", label="Reverse", type="toggle"},
		}},
		{name = "Advanced", collapsed = true, rows = {
			{key="Timescale", label="Timescale", type="graph"},
			{key="Keyframes", label="Anim. Steps", type="input", default="100"},
			{key="Linger", label="Linger", type="input", default="0"},
			{key="EmitParent", label="Emit Into", type="path", config={kind="instance-picker", objectValue="EmitParent", acceptAnyInstance=true}},
			{key="Pool", label="Pool", type="toggle"},
		}},
	}

	refs.TrailEmitterSection, refs.TrailEmitter = W.buildTypeSection(scroll, "TrailEmitters", teDefs, 3)
	refs.TrailEmitterSection.Visible = false
	appendEventsTo(refs.TrailEmitter, refs.TrailEmitterSection, "TrailEmitter", 100)

	do local teBody = refs.TrailEmitterSection:FindFirstChild("Body"); if teBody then refs.TrailBlenderSection, refs.TrailBlenderAddBtn, refs.TrailBlenderStateList = W.makeBlenderBox(teBody, "TrailAddState", "TrailStateList") end end

	-- ==========================================
	-- ATTACHMENT PROPERTIES
	-- ==========================================
	local attachDefs = {
		{name = "Spawning", rows = {
			{key="EmissionMode", label="Mode", type="dropdown", options={"Emit","Animate"}, default="Emit"},
			{key="Orientation", label="Orientation", type="dropdown", options={"None","FacingCamera","FacingCameraWorldUp","VelocityParallel","VelocityPerpendicular"}, default="None"},
			{key="AnimateLoop", label="Loop", type="toggle"},
			{key="Direction", label="Direction", type="dropdown", options={"Top","Bottom","Front","Back","Left","Right"}, default="Top"},
			{key="Enabled", label="Enabled", type="toggle"},
			{key="Rate", label="Rate", type="input", default="10"},
			{key="Lifetime", label="Lifetime", type="input", default="1, 1", placeholder="min, max"},
			{key="SpreadAngle", label="SpreadAngle", type="input", default="0, 0", placeholder="x, y"},
			{key="RotOrder", label="Rot Order", type="dropdown", options={"Global","LocalXYZ","LocalXZY","LocalYXZ","LocalYZX","LocalZXY","LocalZYX"}, default="Global"},
			{key="Rot", label="Rotation", type="axis_input", axes={"X","Y","Z"}, placeholder="min, max", config={kind="axis-link", axes={"RotX","RotY","RotZ"}, evenAttrs={X="RotXEven", Y="RotYEven", Z="RotZEven"}}},
			{key="PosMode", label="Pos. Mode", type="dropdown", options={"Local","Global","RigidLocal"}, default="Local"},
			{key="Pos", label="Position", type="axis_input", axes={"X","Y","Z"}, placeholder="min, max", config={kind="axis-link", axes={"PosX","PosY","PosZ"}, evenAttrs={X="PosXEven", Y="PosYEven", Z="PosZEven"}}},
			{key="ZOffset", label="Z-Offset", type="input", default="0"},
		}},
		{name = "Movement", collapsed = true, rows = {
			{key="Speed", label="Speed", type="graph"},
			{key="PosOffset", label="Displacement", type="axis_graph_select", axes={"X","Y","Z"}, config={kind="axis-link", axes={"PosOffsetX","PosOffsetY","PosOffsetZ"}}},
			{key="RotMode", label="Rotation Mode", type="dropdown", options={"OverLife","Speed"}, default="OverLife"},
			{key="RotSpeed", label="Rotation Speed", type="axis_graph_select", axes={"X","Y","Z"}, config={kind="axis-link", axes={"RotSpeedX","RotSpeedY","RotSpeedZ"}}},
			{key="Acceleration", label="Acceleration", type="input", default="0, 0, 0", placeholder="x, y, z"},
			{key="Drag", label="Drag", type="input", default="0"},
			{key="DirMode", label="Dir. Mode", type="dropdown", options={"RigidLocal","Local","Global"}, default="RigidLocal"},
			{key="DisplacementMode", label="Displacement Mode", type="dropdown", options={"Global","Local","RigidLocal"}, default="Global"},
			{key="InvertMotion", label="Reverse Motion", type="toggle"},
		}},
		{name = "Advanced", collapsed = true, rows = {
			{key="Timescale", label="Timescale", type="graph"},
			{key="Keyframes", label="Anim. Steps", type="input", default="100"},
			{key="Linger", label="Linger", type="input", default="0"},
			{key="EmitParent", label="Emit Into", type="path", config={kind="instance-picker", objectValue="EmitParent", acceptAnyInstance=true}},
			{key="Link", label="Link Dir.", type="path", config={kind="instance-picker", objectValue="Link", setAttributes={LinkSource="Object"}, clearAttributes={LinkSource="None"}}},
			{key="LinkSource", label="Link", type="dropdown", options={"None","Camera","Object"}, default="None"},
			{key="LinkMode", label="Link Mode", type="dropdown", options={"Weld","Follow","Pivot","WeldWithoutRotation"}, default="Follow"},
			{key="Pool", label="Pool", type="toggle"},
		}},
	}

	refs.AttachmentSection, refs.Attachment = W.buildTypeSection(scroll, "Attachments", attachDefs, 4)
	refs.AttachmentSection.Visible = false
	appendEventsTo(refs.Attachment, refs.AttachmentSection, "Attachment", 100)

	-- ==========================================
	-- MODEL PROPERTIES
	-- ==========================================
	local modelDefs = {
		{name = "Spawning", rows = {
			{key="EmissionMode", label="Mode", type="dropdown", options={"Emit","Animate"}, default="Emit"},
			{key="Orientation", label="Orientation", type="dropdown", options={"None","FacingCamera","FacingCameraWorldUp","VelocityParallel","VelocityPerpendicular"}, default="None"},
			{key="AnimateLoop", label="Loop", type="toggle"},
			{key="Direction", label="Direction", type="dropdown", options={"Top","Bottom","Front","Back","Left","Right"}, default="Top"},
			{key="Enabled", label="Enabled", type="toggle"},
			{key="Rate", label="Rate", type="input", default="10"},
			{key="Lifetime", label="Lifetime", type="input", default="1, 1", placeholder="min, max"},
			{key="SpreadAngle", label="SpreadAngle", type="input", default="0, 0", placeholder="x, y"},
			{key="RotOrder", label="Rot Order", type="dropdown", options={"Global","LocalXYZ","LocalXZY","LocalYXZ","LocalYZX","LocalZXY","LocalZYX"}, default="Global"},
			{key="Rot", label="Rotation", type="axis_input", axes={"X","Y","Z"}, placeholder="min, max", config={kind="axis-link", axes={"RotX","RotY","RotZ"}, evenAttrs={X="RotXEven", Y="RotYEven", Z="RotZEven"}}},
			{key="PosMode", label="Pos. Mode", type="dropdown", options={"Local","Global","RigidLocal"}, default="Local"},
			{key="Pos", label="Position", type="axis_input", axes={"X","Y","Z"}, placeholder="min, max", config={kind="axis-link", axes={"PosX","PosY","PosZ"}, evenAttrs={X="PosXEven", Y="PosYEven", Z="PosZEven"}}},
			{key="ZOffset", label="Z-Offset", type="input", default="0"},
		}},
		{name = "Scale", rows = {
			{key="Scale", label="Scale", type="graph"},
			{key="ScaleTextureLength", label="Scale Texture", type="toggle"},
		}},
		{name = "Movement", collapsed = true, rows = {
			{key="Speed", label="Speed", type="graph"},
			{key="PosOffset", label="Displacement", type="axis_graph_select", axes={"X","Y","Z"}, config={kind="axis-link", axes={"PosOffsetX","PosOffsetY","PosOffsetZ"}}},
			{key="RotMode", label="Rotation Mode", type="dropdown", options={"OverLife","Speed"}, default="OverLife"},
			{key="RotSpeed", label="Rotation Speed", type="axis_graph_select", axes={"X","Y","Z"}, config={kind="axis-link", axes={"RotSpeedX","RotSpeedY","RotSpeedZ"}}},
			{key="Acceleration", label="Acceleration", type="input", default="0, 0, 0", placeholder="x, y, z"},
			{key="Drag", label="Drag", type="input", default="0"},
			{key="DirMode", label="Dir. Mode", type="dropdown", options={"RigidLocal","Local","Global"}, default="RigidLocal"},
			{key="DisplacementMode", label="Displacement Mode", type="dropdown", options={"Global","Local","RigidLocal"}, default="Global"},
			{key="InvertMotion", label="Reverse Motion", type="toggle"},
		}},
		{name = "Advanced", collapsed = true, rows = {
			{key="Timescale", label="Timescale", type="graph"},
			{key="Keyframes", label="Anim. Steps", type="input", default="100"},
			{key="Linger", label="Linger", type="input", default="0"},
			{key="PreloadTexture", label="Preload Texture", type="toggle"},
			{key="EmitParent", label="Emit Into", type="path", config={kind="instance-picker", objectValue="EmitParent", acceptAnyInstance=true}},
			{key="Link", label="Link Dir.", type="path", config={kind="instance-picker", objectValue="Link", setAttributes={LinkSource="Object"}, clearAttributes={LinkSource="None"}}},
			{key="LinkSource", label="Link", type="dropdown", options={"None","Camera","Object"}, default="None"},
			{key="LinkMode", label="Link Mode", type="dropdown", options={"Weld","Follow","Pivot","WeldWithoutRotation"}, default="Follow"},
			{key="Pool", label="Pool", type="toggle"},
		}},
	}
	refs.ModelSection, refs.Model = W.buildTypeSection(scroll, "Models", modelDefs, 5)
	appendEventsTo(refs.Model, refs.ModelSection, "Model", 100)
	refs.ModelSection.Visible = false

	-- ==========================================
	-- PARTICLE EMITTER PROPERTIES
	-- ==========================================
	local peDefs = {
		{name = "Spawning", rows = {
			{key="EmissionDirection", label="Direction", type="dropdown", options={"Top","Bottom","Front","Back","Left","Right"}, default="Top"},
			{key="Enabled", label="Enabled", type="toggle"},
			{key="Rate", label="Rate", type="input", default="10"},
			{key="Lifetime", label="Lifetime", type="input", default="1, 1", placeholder="min, max"},
			{key="SpreadAngle", label="SpreadAngle", type="input", default="0, 0", placeholder="x, y"},
		}},
		{name = "Appearance", rows = {
			{key="Texture", label="Texture", type="input", default="", placeholder="rbxassetid:// or ID"},
			{key="Brightness", label="Brightness", type="input", default="1"},
			{key="Size", label="Size", type="graph"},
			{key="Transparency", label="Transparency", type="graph"},
			{key="Squash", label="Squash", type="graph"},
			{key="Color", label="Color", type="color"},
			{key="LightEmission", label="Light Emission", type="input", default="0", placeholder="0-1"},
			{key="LightInfluence", label="Light Influence", type="input", default="1", placeholder="0-1"},
			{key="ZOffset", label="ZOffset", type="input", default="0"},
			{key="Orientation", label="Orientation", type="dropdown", options={"FacingCamera","FacingCameraWorldUp","VelocityParallel","VelocityPerpendicular"}, default="FacingCamera"},
		}},
		{name = "Movement", rows = {
			{key="Speed", label="Speed", type="input", default="0, 0", placeholder="min, max"},
			{key="Rotation", label="Rotation", type="input", default="0, 0", placeholder="min, max"},
			{key="RotSpeed", label="Rotation Speed", type="input", default="0, 0", placeholder="min, max"},
			{key="Acceleration", label="Acceleration", type="input", default="0, 0, 0", placeholder="x, y, z"},
			{key="Drag", label="Drag", type="input", default="0"},
			{key="VelocityInheritance", label="Vel. Inherit", type="input", default="0", placeholder="0-1"},
			{key="TimeScale", label="Time Scale", type="input", default="1"},
			{key="LockedToPart", label="LockedToPart", type="toggle"},
			{key="WindAffectsDrag", label="Wind Drag", type="toggle"},
		}},
		{name = "Shape", collapsed = true, rows = {
			{key="Shape", label="Shape", type="dropdown", options={"Box","Sphere","Cylinder","Disc"}, default="Box"},
			{key="ShapeStyle", label="Style", type="dropdown", options={"Volume","Surface"}, default="Volume"},
			{key="ShapeInOut", label="InOut", type="dropdown", options={"Outward","Inward","InAndOut"}, default="Outward"},
			{key="ShapePartial", label="Hollow", type="input", default="0", placeholder="0=solid, 1=hollow"},
		}},
		{name = "Flipbook", collapsed = true, rows = {
			-- Grid maps user "cols, rows" input to FlipbookLayout (Grid2x2/4x4/8x8 for matching squares,
			-- Custom + FlipbookSizeX/Y for everything else). "0" or "0, 0" disables flipbook (Layout=None).
			{key="FlipbookGrid", label="Grid", type="input", default="0, 0", placeholder="cols, rows"},
			-- Options match Enum.ParticleFlipbookMode exactly (Loop/OneShot/PingPong/Random) so cPEDropdown's
			-- `enumType[text]` lookup always resolves and Populate's `fm.Name` set always finds a matching option.
			{key="FlipbookMode", label="Mode", type="dropdown", options={"Loop","OneShot","PingPong","Random"}, default="Loop"},
			{key="FlipbookFramerate", label="Framerate", type="input", default="30, 30", placeholder="min, max"},
			{key="FlipbookStartRandom", label="StartRandom", type="toggle"},
			{key="FlipbookBlendFrames", label="Blend Frames", type="toggle"},
		}},
		{name = "Advanced", collapsed = true, rows = {
			{key="PreloadTexture", label="Preload Texture", type="toggle"},
		}},
	}

	refs.PESection, refs.PE = W.buildTypeSection(scroll, "Particles", peDefs, 6)
	refs.PESection.Visible = false

	-- Screen-type sections (Blur/Bloom/CC/Atmosphere/ImageLabel) live in BuildPropertiesScreen
	-- so both files stay under the 500-line cap.
	local BPS = require(script.Parent.BuildPropertiesScreen)
	BPS.buildSections(scroll, refs)

	refs.PropsPanel = panel
	refs.PropsScroll = scroll
	return refs
end

function BuildProperties.buildThemeEditor(screenGui)
	local panel = Instance.new("Frame"); panel.Name = "ThemeEditor"
	panel.BackgroundColor3 = T.PanelBg; panel.BackgroundTransparency = T.PanelAlpha
	panel.Position = UDim2.new(0.5,-110,0.5,-180); panel.Size = UDim2.new(0,220,0,0)
	panel.AutomaticSize = Enum.AutomaticSize.Y; panel.Visible = false; panel.ZIndex = 5; panel.Parent = screenGui
	W.addCorner(panel, T.BigCorner); W.addStroke(panel); W.addPadding(panel,6,6,6,6); W.addListLayout(panel,4)
	table.insert(W.getThemed().panels, panel)
	W.attachPanelBackground(panel)

	local refs = {}

	local header = W.makeBlob("Header", panel, UDim2.new(1,0,0,24)); header.LayoutOrder = 0
	local ht = Instance.new("TextLabel"); ht.BackgroundTransparency = 1; ht.Text = "Theme Editor"
	ht.TextColor3 = T.Gold; ht.Font = T.Font; ht.TextSize = 12; ht.TextXAlignment = Enum.TextXAlignment.Left
	ht.Size = UDim2.new(1,-20,1,0); ht.Position = UDim2.new(0,6,0,0); ht.Parent = header
	local dh = Instance.new("TextButton"); dh.BackgroundTransparency = 1; dh.Text = ""
	dh.Size = UDim2.new(1,-20,1,0); dh.ZIndex = 2; dh.Parent = header; W.makeDraggable(panel, dh)

	local function makeThemeColorRow(label, lo, defaultColor)
		local row = Instance.new("Frame"); row.Name = label:gsub("%s+","").."Row"; row.BackgroundTransparency = 1
		row.Size = UDim2.new(1,0,0,24); row.LayoutOrder = lo; row.Parent = panel
		local rl = W.makeBlob("L", row, UDim2.new(0,70,1,0)); W.makeLabel("L", rl, label, T.MutedGold, T.Font, 9)
		local swatchBtn = Instance.new("TextButton"); swatchBtn.Name = "Swatch"; swatchBtn.BackgroundColor3 = defaultColor; swatchBtn.Text = ""
		swatchBtn.Size = UDim2.new(0,20,0,20); swatchBtn.Position = UDim2.new(0,74,0,2); swatchBtn.BorderSizePixel = 0; swatchBtn.AutoButtonColor = false; swatchBtn.Parent = row
		W.addCorner(swatchBtn, UDim.new(0,4)); W.addStroke(swatchBtn)
		local hw = W.makeBlob("HW", row, UDim2.new(1,-100,1,0)); hw.Position = UDim2.new(0,100,0,0)
		local tb = Instance.new("TextBox"); tb.Name = "Hex"; tb.BackgroundTransparency = 1; tb.Text = C.color3ToHex(defaultColor)
		tb.TextColor3 = T.BrightGold; tb.Font = T.Font; tb.TextSize = 10; tb.TextXAlignment = Enum.TextXAlignment.Center
		tb.ClearTextOnFocus = false; tb.Size = UDim2.new(1,-4,1,0); tb.Position = UDim2.new(0,2,0,0); tb.BorderSizePixel = 0; tb.Parent = hw
		return {hex = tb, swatch = swatchBtn}
	end
	refs.AccentColor = makeThemeColorRow("Accent", 1, T.Border); refs.BgColor = makeThemeColorRow("Background", 2, T.PanelBg)
	refs.BlobColor = makeThemeColorRow("Blob", 3, T.BlobBg); refs.SliderColor = makeThemeColorRow("Slider", 4, T.SliderFill)
	refs.ScrollBarColor = makeThemeColorRow("Scroll Bar", 5, T.ScrollBar); refs.TextColor = makeThemeColorRow("Text Accent", 6, T.TextAccent)

	-- Opacity convention: slider 0 = fully opaque, slider 100 = fully transparent. Maps
	-- 1:1 to Roblox's BackgroundTransparency / ImageTransparency (0..1) without inversion.
	local function makeOpacityRow(label, lo, defaultAlpha)
		local row = Instance.new("Frame"); row.BackgroundTransparency = 1; row.Size = UDim2.new(1,0,0,24); row.LayoutOrder = lo; row.Parent = panel
		local rl = W.makeBlob("L", row, UDim2.new(0,100,1,0)); W.makeLabel("L", rl, label, T.MutedGold, T.Font, 8)
		local rw = W.makeBlob("W", row, UDim2.new(1,-104,1,0)); rw.Position = UDim2.new(0,104,0,0)
		local tb = Instance.new("TextBox"); tb.BackgroundTransparency = 1; tb.Text = tostring(math.floor(defaultAlpha * 100 + 0.5))
		tb.TextColor3 = T.BrightGold; tb.Font = T.Font; tb.TextSize = 10; tb.TextXAlignment = Enum.TextXAlignment.Right
		tb.ClearTextOnFocus = false; tb.Size = UDim2.new(1,-8,1,0); tb.Position = UDim2.new(0,4,0,0); tb.BorderSizePixel = 0; tb.Parent = rw
		return tb
	end
	refs.PanelOpacityBox = makeOpacityRow("Panel Opacity %", 7, T.PanelAlpha)
	refs.BlobOpacityBox = makeOpacityRow("Blob Opacity %", 8, T.BlobAlpha)

	-- Background Image row: text input accepting raw asset ID, full rbxassetid:// URL, or empty.
	-- Storage normalizes to T.BgImage; ThemeWiring drives the parse + UpdateTheme call.
	local bgImgRow = Instance.new("Frame"); bgImgRow.BackgroundTransparency = 1; bgImgRow.Size = UDim2.new(1,0,0,24); bgImgRow.LayoutOrder = 8.3; bgImgRow.Parent = panel
	local bgImgL = W.makeBlob("L", bgImgRow, UDim2.new(0,100,1,0)); W.makeLabel("L", bgImgL, "Background Image", T.MutedGold, T.Font, 8)
	local bgImgW = W.makeBlob("W", bgImgRow, UDim2.new(1,-104,1,0)); bgImgW.Position = UDim2.new(0,104,0,0)
	local bgImgBox = Instance.new("TextBox"); bgImgBox.BackgroundTransparency = 1; bgImgBox.Text = T.BgImage or ""
	bgImgBox.PlaceholderText = "rbxassetid://..."; bgImgBox.PlaceholderColor3 = T.DarkGold
	bgImgBox.TextColor3 = T.BrightGold; bgImgBox.Font = T.Font; bgImgBox.TextSize = 9; bgImgBox.TextXAlignment = Enum.TextXAlignment.Left
	bgImgBox.ClearTextOnFocus = false; bgImgBox.Size = UDim2.new(1,-8,1,0); bgImgBox.Position = UDim2.new(0,4,0,0); bgImgBox.BorderSizePixel = 0; bgImgBox.Parent = bgImgW
	bgImgBox.TextTruncate = Enum.TextTruncate.AtEnd
	refs.BgImageBox = bgImgBox

	-- Background Image Opacity %: same inversion as Panel Opacity (slider 0% = transparent).
	refs.BgImageOpacityBox = makeOpacityRow("Bg Image Opacity %", 8.6, T.BgImageTransparency)

	local ftRow = Instance.new("Frame"); ftRow.BackgroundTransparency = 1; ftRow.Size = UDim2.new(1,0,0,24); ftRow.LayoutOrder = 9; ftRow.Parent = panel
	local ftL = W.makeBlob("L", ftRow, UDim2.new(0,50,1,0)); W.makeLabel("L", ftL, "Font", T.MutedGold, T.Font, 9)
	local fontLbl, fontWrap, fontOnChanged = W.makeDropdown("Font", ftRow, C.FONT_OPTIONS, T.Font.Name)
	fontWrap.Size = UDim2.new(1,-54,1,0); fontWrap.Position = UDim2.new(0,54,0,0)
	refs.FontDropdown = fontLbl; refs.FontDropdownOnChanged = fontOnChanged

	local _fsOnChanged = nil
	local fsSl, fsVal, fsSv, fsGv = W.makeSlider(panel, 1, 200, 100, function(v) if _fsOnChanged then _fsOnChanged(v) end end, "%d%%")
	fsSl.LayoutOrder = 9.5
	refs.FontSizeSetVal = fsSv; refs.FontSizeGetVal = fsGv
	refs.setFontSizeOnChanged = function(fn) _fsOnChanged = fn end

	local presetNames = {"Custom"}; for _, p in ipairs(C.THEME_PRESETS) do table.insert(presetNames, p.name) end
	local presetRow = Instance.new("Frame"); presetRow.BackgroundTransparency = 1; presetRow.Size = UDim2.new(1,0,0,LAYOUT.RowHeight); presetRow.LayoutOrder = 10; presetRow.Parent = panel
	local pLbl = W.makeLabel("PresetLbl", presetRow, "Preset"); pLbl.Size = UDim2.new(0,LAYOUT.LabelWidth,1,0)
	local presetLbl, presetWrap, presetOnChanged = W.makeDropdown("PresetDropdown", presetRow, presetNames, "Custom")
	presetWrap.Size = UDim2.new(1,-LAYOUT.LabelWidth-4,1,0); presetWrap.Position = UDim2.new(0,LAYOUT.LabelWidth+2,0,0)
	refs.PresetOnChanged = presetOnChanged; refs.PresetDropdownLbl = presetLbl

	local codeTitle = W.makeBlob("CodeTitle", panel, UDim2.new(1,0,0,18)); codeTitle.LayoutOrder = 11
	W.makeLabel("L", codeTitle, "Theme Code", T.MutedGold, T.Font, 8)
	local codeW = W.makeBlob("CodeW", panel, UDim2.new(1,0,0,36)); codeW.LayoutOrder = 12
	local tcb = Instance.new("TextBox"); tcb.BackgroundTransparency = 1; tcb.Text = ""; tcb.PlaceholderText = "Paste or copy theme code"
	tcb.TextColor3 = T.BrightGold; tcb.PlaceholderColor3 = T.DarkGold; tcb.Font = T.Font; tcb.TextSize = 8; tcb.TextWrapped = true
	tcb.TextXAlignment = Enum.TextXAlignment.Left; tcb.ClearTextOnFocus = false; tcb.Size = UDim2.new(1,-8,1,-4)
	tcb.Position = UDim2.new(0,4,0,2); tcb.BorderSizePixel = 0; tcb.Parent = codeW; refs.ThemeCodeBox = tcb

	local codeBtnRow = Instance.new("Frame"); codeBtnRow.BackgroundTransparency = 1; codeBtnRow.Size = UDim2.new(1,0,0,20); codeBtnRow.LayoutOrder = 13; codeBtnRow.Parent = panel
	W.addListLayout(codeBtnRow, 2, Enum.FillDirection.Horizontal)
	refs.ExportTheme = W.makeButton("Export", codeBtnRow, "Export", UDim2.new(0.5,-1,1,0), T.MutedGold); refs.ExportTheme.TextSize = 9; refs.ExportTheme.LayoutOrder = 0
	refs.ImportTheme = W.makeButton("Import", codeBtnRow, "Import", UDim2.new(0.5,-1,1,0), T.MutedGold); refs.ImportTheme.TextSize = 9; refs.ImportTheme.LayoutOrder = 1

	local actionRow = Instance.new("Frame"); actionRow.BackgroundTransparency = 1; actionRow.Size = UDim2.new(1,0,0,24); actionRow.LayoutOrder = 14; actionRow.Parent = panel
	W.addListLayout(actionRow, 2, Enum.FillDirection.Horizontal)
	refs.ApplyTheme = W.makeButton("Apply", actionRow, "Apply", UDim2.new(0.33,-2,1,0), T.Green); refs.ApplyTheme.TextSize = 10; refs.ApplyTheme.LayoutOrder = 0
	refs.CancelTheme = W.makeButton("Cancel", actionRow, "Cancel", UDim2.new(0.33,-2,1,0), T.DarkGold); refs.CancelTheme.TextSize = 10; refs.CancelTheme.LayoutOrder = 1
	refs.ResetTheme = W.makeButton("Reset", actionRow, "Reset", UDim2.new(0.33,-2,1,0), T.Red); refs.ResetTheme.TextSize = 10; refs.ResetTheme.LayoutOrder = 2

	refs.ThemeEditor = panel; return refs
end
return BuildProperties
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">BuildPropertiesBeamNative</string>
              <string name="Source"><![CDATA[-- BuildPropertiesBeamNative  -  property-panel section for BeamNative (directAccess plain Beam).

local W = require(script.Parent.Widgets)
local BuildPropertiesBeamNative = {}

-- Build the BeamNative section into the Properties scroll frame. Hidden by default;
-- SelectionHandler reveals when BeamNative items are selected.
function BuildPropertiesBeamNative.buildSection(scroll, refs, order)
	local beamNativeDefs = {
		{name = "Emission", rows = {
			{key="Enabled", label="Enabled", type="toggle"},
			{key="Attachment0", label="Attachment 0", type="path", config={kind="instance-picker", directProperty="Attachment0", validate="Attachment"}},
			{key="Attachment1", label="Attachment 1", type="path", config={kind="instance-picker", directProperty="Attachment1", validate="Attachment"}},
		}},
		{name = "Appearance", rows = {
			{key="Texture", label="Texture", type="input", default="", placeholder="rbxassetid:// or ID"},
			{key="Brightness", label="Brightness", type="input", default="1"},
			{key="Transparency", label="Transparency", type="graph"},
			{key="Color", label="Color", type="color"},
			{key="LightEmission", label="Light Emission", type="input", default="0"},
			{key="LightInfluence", label="Light Influence", type="input", default="0"},
			{key="ZOffset", label="ZOffset", type="input", default="0"},
		}},
		{name = "Geometry", rows = {
			{key="Width0", label="Width 0", type="input", default="1"},
			{key="Width1", label="Width 1", type="input", default="1"},
			{key="CurveSize0", label="CurveSize 0", type="input", default="0"},
			{key="CurveSize1", label="CurveSize 1", type="input", default="0"},
			{key="Segments", label="Segments", type="input", default="10"},
			{key="TextureLength", label="Tex. Length", type="input", default="1"},
			{key="TextureSpeed", label="Tex. Speed", type="input", default="1"},
			{key="TextureMode", label="Tex. Mode", type="dropdown", options={"Stretch","Wrap","Static"}, default="Stretch"},
			{key="FaceCamera", label="FaceCamera", type="toggle"},
		}},
		{name = "Advanced", collapsed = true, rows = {
			{key="PreloadTexture", label="Preload Texture", type="toggle"},
		}},
	}
	refs.BeamNativeSection, refs.BeamNative = W.buildTypeSection(scroll, "BeamNatives", beamNativeDefs, order or 3)
	refs.BeamNativeSection.Visible = false
end

return BuildPropertiesBeamNative
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="90">
            <Properties>
              <string name="Name">BuildPropertiesScreen</string>
              <string name="Source"><![CDATA[-- BuildPropertiesScreen  -  property-panel sections for screen-space types (Blur/Bloom/CC/Atmosphere/ImageLabel).
-- Split from BuildProperties.luau to keep both files under the 500-line cap as ImageLabel's definition grew.
-- Consumers: BuildProperties.buildProperties() calls buildSections(scroll, refs) at the end of its own build.

local W = require(script.Parent.Widgets)
local WidgetEvents = require(script.Parent.WidgetEvents)
local BuildPropertiesScreen = {}

local function appendEventsTo(typeRefs, section, typeName)
	if not section then return end
	local body = section:FindFirstChild("Body") or section
	typeRefs.Events = WidgetEvents.buildEventsSection(body, typeName, 100)
end

local function screenSpawning()
	return {name = "Spawning", rows = {
		{key="EmissionMode", label="Mode", type="dropdown", options={"Emit","Animate"}, default="Emit"},
		{key="AnimateLoop",  label="Loop", type="toggle"},
		{key="Enabled",      label="Enabled", type="toggle"},
		{key="Rate",         label="Rate", type="input", default="10"},
		{key="Lifetime",     label="Lifetime", type="input", default="1, 1", placeholder="min, max"},
	}}
end

local function screenAdvanced()
	return {name = "Advanced", collapsed = true, rows = {
		{key="Timescale",  label="Timescale",   type="graph"},
		{key="Keyframes",  label="Anim. Steps", type="input", default="100"},
		{key="Linger",     label="Linger",      type="input", default="0"},
		{key="EmitParent", label="Emit Into",   type="path", config={kind="instance-picker", objectValue="EmitParent", acceptAnyInstance=true}},
	}}
end

-- ImageLabel adds PreloadTexture to its Advanced  -  other screen types don't have texture assets.
local function imageLabelAdvanced()
	return {name = "Advanced", collapsed = true, rows = {
		{key="Timescale",      label="Timescale",       type="graph"},
		{key="Keyframes",      label="Anim. Steps",     type="input", default="100"},
		{key="Linger",         label="Linger",          type="input", default="0"},
		{key="EmitParent",     label="Emit Into",       type="path", config={kind="instance-picker", objectValue="EmitParent", acceptAnyInstance=true}},
		{key="PreloadTexture", label="Preload Texture", type="toggle"},
	}}
end

function BuildPropertiesScreen.buildSections(scroll, refs)
	-- BLUR
	local blurDefs = { screenSpawning(),
		{name = "Appearance", rows = { {key="Size", label="Size", type="graph"} }},
		screenAdvanced(),
	}
	refs.BlurSection, refs.Blur = W.buildTypeSection(scroll, "Blurs", blurDefs, 7)
	refs.BlurSection.Visible = false
	appendEventsTo(refs.Blur, refs.BlurSection, "Blur")

	-- BLOOM
	local bloomDefs = { screenSpawning(),
		{name = "Appearance", rows = {
			{key="Intensity", label="Intensity", type="graph"},
			{key="Size",      label="Size",      type="graph"},
			{key="Threshold", label="Threshold", type="graph"},
		}},
		screenAdvanced(),
	}
	refs.BloomSection, refs.Bloom = W.buildTypeSection(scroll, "Blooms", bloomDefs, 8)
	refs.BloomSection.Visible = false
	appendEventsTo(refs.Bloom, refs.BloomSection, "Bloom")

	-- COLOR CORRECTION
	local ccDefs = { screenSpawning(),
		{name = "Appearance", rows = {
			{key="Brightness", label="Brightness", type="graph"},
			{key="Contrast",   label="Contrast",   type="graph"},
			{key="Saturation", label="Saturation", type="graph"},
			{key="TintColor",  label="TintColor",  type="color"},
		}},
		screenAdvanced(),
	}
	refs.ColorCorrectionSection, refs.ColorCorrection = W.buildTypeSection(scroll, "ColorCorrections", ccDefs, 9)
	refs.ColorCorrectionSection.Visible = false
	appendEventsTo(refs.ColorCorrection, refs.ColorCorrectionSection, "ColorCorrection")

	-- ATMOSPHERE
	local atmDefs = { screenSpawning(),
		{name = "Appearance", rows = {
			{key="Density", label="Density", type="graph"},
			{key="Offset",  label="Offset",  type="graph"},
			{key="Glare",   label="Glare",   type="graph"},
			{key="Haze",    label="Haze",    type="graph"},
			{key="Color",   label="Color",   type="color"},
			{key="Decay",   label="Decay",   type="color"},
		}},
		screenAdvanced(),
	}
	refs.AtmosphereSection, refs.Atmosphere = W.buildTypeSection(scroll, "Atmospheres", atmDefs, 10)
	refs.AtmosphereSection.Visible = false
	appendEventsTo(refs.Atmosphere, refs.AtmosphereSection, "Atmosphere")

	-- IMAGE LABEL
	-- Position / Size parsed via CSV inputs: "ScaleX, OffsetX, ScaleY, OffsetY" -> UDim2.
	-- AnchorPoint / Acceleration parsed via CSV: "x, y" -> Vector2.
	-- Grid parsed as "cols, rows" -> two separate config attrs (GridCols, GridRows) so tooling treats them independently.
	-- Per-frame pixel size is computed at emit time as sheet dimensions / grid (see ImageSheetSize.luau).
	local imageLabelDefs = {
		{name = "Spawning", rows = {
			{key="EmissionMode", label="Mode", type="dropdown", options={"Emit","Animate"}, default="Emit"},
			{key="AnimateLoop",  label="Loop", type="toggle"},
			{key="Enabled",      label="Enabled", type="toggle"},
			{key="Rate",         label="Rate", type="input", default="10"},
			{key="Lifetime",     label="Lifetime", type="input", default="1, 1", placeholder="min, max"},
			{key="RotRange",     label="Rotation", type="input", default="0, 0", placeholder="min, max"},
			{key="RotSpeed",     label="Rot Speed", type="graph"},
			{key="RotMode",      label="Rot Mode",  type="dropdown", options={"OverLife","Speed"}, default="OverLife"},
		}},
		{name = "Appearance", rows = {
			{key="Image",                  label="Image",          type="input", placeholder="rbxassetid://"},
			{key="ImageColor3",            label="ImageColor",     type="color"},
			{key="ImageTransparency",      label="Transparency",   type="graph"},
			{key="BackgroundColor3",       label="BG Color",       type="color"},
			{key="BackgroundTransparency", label="BG Transparency",type="graph"},
			{key="ScaleType",              label="ScaleType",      type="dropdown", options={"Stretch","Slice","Tile","Fit","Crop"}, default="Stretch"},
			{key="ResampleMode",           label="ResampleMode",   type="dropdown", options={"Default","Pixelated"}, default="Default"},
		}},
		{name = "Layout", rows = {
			{key="Position",    label="Position",    type="input", default="0.5, 0, 0.5, 0", placeholder="sx, ox, sy, oy"},
			{key="ImgSize",     label="Size",        type="input", default="0, 100, 0, 100", placeholder="sx, ox, sy, oy"},
			{key="SizeScale",   label="Size Scale",  type="axis_graph_select", axes={"X","Y"}},
			{key="AnchorPoint", label="AnchorPoint", type="input", default="0.5, 0.5", placeholder="x, y"},
			{key="ZIndex",      label="ZIndex",      type="input", default="1"},
		}},
		{name = "Motion", collapsed = true, rows = {
			{key="Speed",         label="Speed (px/s)",   type="graph"},
			{key="EmissionAngle", label="EmissionAngle",  type="input", default="90", placeholder="degrees"},
			{key="SpreadAngle",   label="SpreadAngle",    type="input", default="0",  placeholder="degrees"},
			{key="Acceleration",  label="Acceleration",   type="input", default="0, 0", placeholder="x, y"},
			{key="Drag",          label="Drag",           type="input", default="0"},
			{key="InvertMotion",  label="Reverse Motion", type="toggle"},
		}},
		{name = "Flipbook", collapsed = true, rows = {
			{key="FlipbookSource",      label="Source",     type="dropdown", options={"Decals","Spritesheet"}, default="Decals"},
			-- Canonical Enum.ParticleFlipbookMode option list  -  kept in sync with the native PE
			-- counterpart in BuildProperties.luau (both ship Loop/OneShot/PingPong/Random).
			{key="FlipbookMode",        label="Play Mode",  type="dropdown", options={"Loop","OneShot","PingPong","Random"}, default="Loop"},
			{key="Grid",                label="Grid",       type="input", default="8, 8",   placeholder="cols, rows"},
			{key="FlipbookFramerate",   label="Framerate",  type="input", default="10"},
			{key="FlipbookStartRandom", label="StartRandom",type="toggle"},
			{key="FlipbookReverse",     label="Reverse",    type="toggle"},
		}},
		imageLabelAdvanced(),
	}
	refs.ImageLabelSection, refs.ImageLabel = W.buildTypeSection(scroll, "ImageLabels", imageLabelDefs, 11)
	refs.ImageLabelSection.Visible = false
	appendEventsTo(refs.ImageLabel, refs.ImageLabelSection, "ImageLabel")
	-- Spritesheet-only Grid row starts hidden. Populate flips it visible when FlipbookSource =
	-- Spritesheet on a selected ImageLabel. Without this, it'd show on initial section expand.
	if refs.ImageLabel.Grid and refs.ImageLabel.Grid.input then refs.ImageLabel.Grid.row.Visible = false end
end

return BuildPropertiesScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">ConfigPanel</string>
              <string name="Source"><![CDATA[--[[
	ConfigPanel  -  small modal popups for per-property advanced configuration. Currently exposes:

	  openInstancePicker(opts)  -  picks any Instance from Studio Selection.
	    opts.title    : panel title text
	    opts.label    : prompt label above the instance line ("Pick the target")
	    opts.onSet(inst): called when user clicks Set with the currently-selected Instance
	    opts.onCancel() : called when user dismisses

	Future: openAxisLink(opts) for linking SizeX↔SizeY↔SizeZ etc.
]]

local Selection = game:GetService("Selection")
local UserInputService = game:GetService("UserInputService")

return function(deps)
	local W = deps.W
	local T = deps.T

	local _activePanel = nil

	local function closeActive()
		if _activePanel then
			pcall(function() _activePanel:close() end)
			_activePanel = nil
		end
	end

	local function openInstancePicker(opts)
		closeActive()

		local screenGui = W.getScreenGui and W.getScreenGui() or deps.screenGui
		if not screenGui then
			warn("[Part-Icles] ConfigPanel: missing ScreenGui  -  cannot open picker")
			return
		end

		local panel = Instance.new("Frame")
		panel.Name = "ConfigPanel_InstancePicker"
		panel.BackgroundColor3 = T.PanelBg
		panel.BackgroundTransparency = 0
		-- Tall enough to fit title + context-line + prompt + instance line + buttons.
		panel.Size = UDim2.new(0, 280, 0, 138)
		panel.AnchorPoint = Vector2.new(0.5, 0.5)
		panel.Position = UDim2.new(0.5, 0, 0.5, 0)
		panel.BorderSizePixel = 0
		panel.ZIndex = 200
		panel.Active = true
		panel:SetAttribute("_opaquePanel", true)
		panel:SetAttribute("_noSnap", true)
		panel.Parent = screenGui
		W.addCorner(panel, T.Corner)
		W.addStroke(panel)
		W.addPadding(panel, 8, 8, 8, 8)
		W.attachPanelBackground(panel)

		-- Title bar
		local title = Instance.new("TextLabel")
		title.BackgroundTransparency = 1
		title.Text = opts.title or "Configure"
		title.TextColor3 = T.Gold
		title.Font = T.Font
		title.TextSize = 12
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.ZIndex = 201
		title.Size = UDim2.new(1, -20, 0, 16)
		title.Position = UDim2.new(0, 0, 0, 0)
		title.Parent = panel

		-- Context  -  which items this panel is editing. Stays visible even if user changes Studio
		-- Selection while the panel is open.
		if opts.context and opts.context ~= "" then
			local contextLine = Instance.new("TextLabel")
			contextLine.BackgroundTransparency = 1
			contextLine.Text = "for: " .. opts.context
			contextLine.TextColor3 = T.MutedGold
			contextLine.Font = T.Font
			contextLine.TextSize = 10
			contextLine.TextXAlignment = Enum.TextXAlignment.Left
			contextLine.TextTruncate = Enum.TextTruncate.AtEnd
			contextLine.ZIndex = 201
			contextLine.Size = UDim2.new(1, 0, 0, 14)
			contextLine.Position = UDim2.new(0, 0, 0, 18)
			contextLine.Parent = panel
		end

		local hasContext = opts.context and opts.context ~= ""
		local promptY = hasContext and 40 or 22
		local instanceY = hasContext and 58 or 40

		-- Prompt
		local prompt = Instance.new("TextLabel")
		prompt.BackgroundTransparency = 1
		prompt.Text = opts.label or "Select an instance:"
		prompt.TextColor3 = T.MutedGold
		prompt.Font = T.Font
		prompt.TextSize = 10
		prompt.TextXAlignment = Enum.TextXAlignment.Left
		prompt.ZIndex = 201
		prompt.Size = UDim2.new(1, 0, 0, 14)
		prompt.Position = UDim2.new(0, 0, 0, promptY)
		prompt.Parent = panel

		-- Selected-instance label
		local instanceLine = Instance.new("TextLabel")
		instanceLine.BackgroundColor3 = T.BlobBg
		instanceLine.BackgroundTransparency = T.BlobAlpha
		instanceLine.Text = "Instance: <nil>"
		instanceLine.TextColor3 = T.BrightGold
		instanceLine.Font = T.Font
		instanceLine.TextSize = 11
		instanceLine.TextXAlignment = Enum.TextXAlignment.Left
		instanceLine.TextTruncate = Enum.TextTruncate.AtEnd
		instanceLine.ZIndex = 201
		instanceLine.Size = UDim2.new(1, 0, 0, 22)
		instanceLine.Position = UDim2.new(0, 0, 0, instanceY)
		instanceLine.BorderSizePixel = 0
		instanceLine.Parent = panel
		W.addCorner(instanceLine, UDim.new(0, 4))
		W.addPadding(instanceLine, 6, 6, 0, 0)

		-- Buttons
		local function makeBtn(text, col, x)
			local b = Instance.new("TextButton")
			b.BackgroundColor3 = col
			b.BackgroundTransparency = T.BlobAlpha
			b.Text = text
			b.TextColor3 = T.BrightGold
			b.Font = T.Font
			b.TextSize = 11
			b.Size = UDim2.new(0.5, -3, 0, 22)
			b.Position = UDim2.new(x, x == 0 and 0 or 3, 1, -22)
			b.BorderSizePixel = 0
			b.ZIndex = 201
			b.Parent = panel
			W.addCorner(b, UDim.new(0, 4))
			W.addStroke(b)
			return b
		end
		-- Three buttons when opts.allowClear is set, two otherwise. Clear writes
		-- nil through opts.onClear so picker-managed ObjectValue / direct properties
		-- can be unset without leaving the panel.
		local setBtn, clearBtn, cancelBtn
		if opts.allowClear then
			local function makeBtn3(text, col, x)
				local b = Instance.new("TextButton")
				b.BackgroundColor3 = col; b.BackgroundTransparency = T.BlobAlpha
				b.Text = text; b.TextColor3 = T.BrightGold
				b.Font = T.Font; b.TextSize = 11
				b.Size = UDim2.new(1/3, -3, 0, 22)
				b.Position = UDim2.new(x, x == 0 and 0 or 3, 1, -22)
				b.BorderSizePixel = 0; b.ZIndex = 201; b.Parent = panel
				W.addCorner(b, UDim.new(0, 4)); W.addStroke(b)
				return b
			end
			setBtn = makeBtn3("Set", T.BlobBg, 0)
			clearBtn = makeBtn3("Clear", T.BlobBg, 1/3)
			cancelBtn = makeBtn3("Cancel", T.BlobBg, 2/3)
		else
			setBtn = makeBtn("Set", T.BlobBg, 0)
			cancelBtn = makeBtn("Cancel", T.BlobBg, 0.5)
		end

		local _selected = nil
		-- Recency cache: last non-empty Studio Selection observed during this picker's
		-- lifetime. Acts as fallback when Set is clicked and live Selection is empty  - 
		-- happens when clicking the Set button itself clears focus from Studio Explorer
		-- (Studio quirk: focus shifts to plugin GUI → Selection reported as empty mid-click).
		local _selectedCache = nil
		-- Exclude set built from opts.excludeItems (typically the source items the
		-- picker was opened for) so Set can't accidentally write self-as-target.
		local excludeSet = {}
		if opts.excludeItems then
			for _, ex in ipairs(opts.excludeItems) do excludeSet[ex] = true end
		end
		local function refreshFromSelection()
			local sel = Selection:Get()
			local picked = sel and sel[1] or nil
			-- Skip self-as-target: clear the line so the user has to consciously pick a
			-- different instance instead of accidentally committing self.
			if picked and excludeSet[picked] then picked = nil end
			_selected = picked
			if picked then _selectedCache = picked end
			instanceLine.Text = _selected and ("Instance: " .. _selected:GetFullName())
				or (_selectedCache and ("Instance: " .. _selectedCache:GetFullName() .. " (cached)"))
				or "Instance: <nil>"
		end
		refreshFromSelection()
		-- Register through ConnectionManager so plugin teardown disconnects this
		-- listener even if the picker close path never fires (e.g. plugin disabled
		-- mid-pick). The local `conn` still handles the normal Set/Cancel close.
		local conn = Selection.SelectionChanged:Connect(refreshFromSelection)
		if deps.Connections then deps.Connections["ConfigPanelInstancePicker"] = conn end

		-- 200ms poll: catches Selection states that never fire SelectionChanged during
		-- this picker's lifetime (e.g. Roblox Deferred signal dropping events under load).
		-- Loop exits when panel is destroyed (panel.Parent == nil).
		local _alive = true
		task.spawn(function()
			while _alive do
				task.wait(0.2)
				if not _alive then return end
				local sel = Selection:Get()
				local picked = sel and sel[1] or nil
				if picked and excludeSet[picked] then picked = nil end
				if picked then _selectedCache = picked end
			end
		end)

		local function close(commit)
			_alive = false
			if conn then conn:Disconnect(); conn = nil end
			panel:Destroy()
			if _activePanel and _activePanel.frame == panel then _activePanel = nil end
			-- Commit prefers live Selection; falls back to cache so a Set click that races
			-- with Studio clearing Selection still writes the user's most-recent pick.
			local commitTarget = _selected or _selectedCache
			if commit and opts.onSet then opts.onSet(commitTarget) end
			if not commit and opts.onCancel then opts.onCancel() end
		end

		-- Snapshot Selection on MouseDown  -  fires BEFORE Studio's focus-shift cascade
		-- clears Selection on plugin-GUI click. By the time Activated (MouseUp) fires,
		-- Selection is reported empty. MouseDown runs while Studio Selection still
		-- holds the pick. Mirrored on the panel background so a mouse-down anywhere
		-- in the picker captures the live pick, not just the Set button.
		local function snapshotSelectionNow()
			local sel = Selection:Get()
			local picked = sel and sel[1] or nil
			if picked and excludeSet[picked] then picked = nil end
			if picked then
				_selectedCache = picked
				_selected = picked
				instanceLine.Text = "Instance: " .. picked:GetFullName()
			end
		end
		setBtn.MouseButton1Down:Connect(snapshotSelectionNow)
		panel.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then snapshotSelectionNow() end
		end)

		-- Run opts.validate(picked) BEFORE closing. When validation rejects, the
		-- panel stays open + the prompt label flashes a hint so the user knows
		-- their pick was wrong instead of seeing the panel vanish silently.
		setBtn.Activated:Connect(function()
			-- Force a Selection re-read at click time. Deferred SignalBehavior can let the
			-- Set button fire before our SelectionChanged listener runs, leaving _selected
			-- stale (or pinned to a previous pick like the parent Frame of a CanvasGroup).
			refreshFromSelection()
			-- Live Selection beats cache; cache covers the case where clicking Set itself
			-- caused Studio to report empty Selection (the 0.2s poll captured the last
			-- valid pick before that).
			local target = _selected or _selectedCache
			if not target then
				instanceLine.Text = "No instance selected  -  click one in Studio first"
				instanceLine.TextColor3 = T.Red or Color3.fromRGB(220, 80, 80)
				return
			end
			if opts.validate then
				local okValid, msg = opts.validate(target)
				if not okValid then
					instanceLine.Text = msg or "Invalid selection  -  pick a different instance"
					instanceLine.TextColor3 = T.Red or Color3.fromRGB(220, 80, 80)
					return
				end
			end
			_selected = target
			close(true)
		end)
		cancelBtn.Activated:Connect(function() close(false) end)
		if clearBtn then
			clearBtn.Activated:Connect(function()
				if conn then conn:Disconnect(); conn = nil end
				panel:Destroy()
				if _activePanel and _activePanel.frame == panel then _activePanel = nil end
				if opts.onClear then opts.onClear() end
			end)
		end

		_activePanel = { frame = panel, close = function() close(false) end }
		return _activePanel
	end

	-- Axis-link picker. opts.axes is a list of full property keys (e.g. {"SizeX","SizeY","SizeZ"}).
	-- opts.current is a table { [axisKey] = primaryKey or nil } reflecting current LinkedTo state.
	-- Set callback receives a linkMap of the same shape (primary axis maps to nil).
	local function openAxisLinkPanel(opts)
		closeActive()
		local screenGui = W.getScreenGui and W.getScreenGui() or deps.screenGui
		if not screenGui then warn("[Part-Icles] ConfigPanel: missing ScreenGui"); return end
		local axes = opts.axes or {}
		if #axes == 0 then return end

		local panel = Instance.new("Frame")
		panel.Name = "ConfigPanel_AxisLink"
		panel.BackgroundColor3 = T.PanelBg; panel.BackgroundTransparency = 0
		panel.Size = UDim2.new(0, 280, 0, 158)
		panel.AnchorPoint = Vector2.new(0.5, 0.5); panel.Position = UDim2.new(0.5, 0, 0.5, 0)
		panel.BorderSizePixel = 0; panel.ZIndex = 200; panel.Active = true
		panel:SetAttribute("_opaquePanel", true); panel:SetAttribute("_noSnap", true)
		panel.Parent = screenGui
		W.addCorner(panel, T.Corner); W.addStroke(panel); W.addPadding(panel, 8, 8, 8, 8)

		local title = Instance.new("TextLabel"); title.BackgroundTransparency = 1
		title.Text = opts.title or "Link axes"; title.TextColor3 = T.Gold
		title.Font = T.Font; title.TextSize = 12; title.TextXAlignment = Enum.TextXAlignment.Left
		title.ZIndex = 201; title.Size = UDim2.new(1, 0, 0, 16); title.Position = UDim2.new(0, 0, 0, 0)
		title.Parent = panel

		if opts.context and opts.context ~= "" then
			local ctxLine = Instance.new("TextLabel"); ctxLine.BackgroundTransparency = 1
			ctxLine.Text = "for: " .. opts.context; ctxLine.TextColor3 = T.MutedGold
			ctxLine.Font = T.Font; ctxLine.TextSize = 10; ctxLine.TextXAlignment = Enum.TextXAlignment.Left
			ctxLine.TextTruncate = Enum.TextTruncate.AtEnd; ctxLine.ZIndex = 201
			ctxLine.Size = UDim2.new(1, 0, 0, 14); ctxLine.Position = UDim2.new(0, 0, 0, 18)
			ctxLine.Parent = panel
		end

		-- Build axis-set for sanitizing incoming current state.
		local axisSet = {}
		for _, a in ipairs(axes) do axisSet[a] = true end
		-- Sanitize: drop self-links and any LinkedTo value not in this row's axes list.
		-- Stale or hand-edited bad attrs can otherwise round-trip forever.
		local linkMap = {}
		for _, a in ipairs(axes) do
			local v = opts.current and opts.current[a] or nil
			if v == a or (v ~= nil and not axisSet[v]) then v = nil end
			linkMap[a] = v
		end
		local primary
		for _, a in ipairs(axes) do
			if linkMap[a] == nil then
				local hasFollower = false
				for _, b in ipairs(axes) do if b ~= a and linkMap[b] == a then hasFollower = true; break end end
				if hasFollower then primary = a; break end
			end
		end
		if not primary then primary = axes[1] end
		-- Strip self-links from initial state.
		if linkMap[primary] then linkMap[primary] = nil end

		local prompt = Instance.new("TextLabel"); prompt.BackgroundTransparency = 1
		prompt.Text = "Primary axis (others can link to it):"; prompt.TextColor3 = T.MutedGold
		prompt.Font = T.Font; prompt.TextSize = 10; prompt.TextXAlignment = Enum.TextXAlignment.Left
		prompt.ZIndex = 201; prompt.Size = UDim2.new(1, 0, 0, 14); prompt.Position = UDim2.new(0, 0, 0, 38)
		prompt.Parent = panel

		local pillW = math.floor((280 - 16 - (#axes - 1) * 4) / #axes)
		local pills = {}
		-- Side table: TextButton Instance -> axisKey. Roblox Instances don't accept arbitrary
		-- custom fields so attaching `b.AxisKey = ...` would silently fail and downstream reads
		-- would index nil.
		local pillAxes = {}
		-- Axes the user actually touched. onSet writes only these so a Set on a
		-- mixed multi-selection doesn't overwrite untouched per-item state.
		local dirtyAxes = {}
		local function refreshPills()
			for _, p in ipairs(pills) do
				local axisKey = pillAxes[p]
				if axisKey == primary then
					p.BackgroundColor3 = T.BrightGold; p.BackgroundTransparency = 0
					p.TextColor3 = T.PanelBg; p.Text = axisKey .. " *"
				elseif linkMap[axisKey] == primary then
					p.BackgroundColor3 = T.BlobBg; p.BackgroundTransparency = T.BlobAlpha
					p.TextColor3 = T.BrightGold; p.Text = axisKey .. " ->"
				else
					p.BackgroundColor3 = T.BlobBg; p.BackgroundTransparency = T.BlobAlpha
					p.TextColor3 = T.MutedGold; p.Text = axisKey
				end
			end
		end
		for i, axisKey in ipairs(axes) do
			local b = Instance.new("TextButton"); b.Name = axisKey .. "Pill"
			b.Font = T.Font; b.TextSize = 11; b.BorderSizePixel = 0; b.ZIndex = 201
			b.Size = UDim2.new(0, pillW, 0, 22)
			b.Position = UDim2.new(0, (i - 1) * (pillW + 4), 0, 56)
			b.Parent = panel; W.addCorner(b, UDim.new(0, 4)); W.addStroke(b)
			pillAxes[b] = axisKey
			pills[#pills + 1] = b
			-- Single InputBegan handler for MouseButton1: shift-held promotes axis to primary
			-- (followers re-anchor to the new primary). Plain click toggles linked-to-primary.
			b.InputBegan:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
				local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
				if shift then
					primary = axisKey; linkMap[axisKey] = nil
					for _, other in ipairs(axes) do
						if other ~= primary and linkMap[other] ~= nil then linkMap[other] = primary end
						dirtyAxes[other] = true
					end
				elseif axisKey ~= primary then
					if linkMap[axisKey] == primary then linkMap[axisKey] = nil
					else linkMap[axisKey] = primary end
					dirtyAxes[axisKey] = true
				end
				refreshPills()
			end)
		end
		refreshPills()

		local primaryHint = Instance.new("TextLabel"); primaryHint.BackgroundTransparency = 1
		primaryHint.Text = "(shift-click an axis to make it primary)"; primaryHint.TextColor3 = T.DarkGold
		primaryHint.Font = T.Font; primaryHint.TextSize = 9; primaryHint.TextXAlignment = Enum.TextXAlignment.Left
		primaryHint.ZIndex = 201; primaryHint.Size = UDim2.new(1, 0, 0, 12); primaryHint.Position = UDim2.new(0, 0, 0, 84)
		primaryHint.Parent = panel

		local function makeBtn(text, x)
			local b = Instance.new("TextButton"); b.BackgroundColor3 = T.BlobBg; b.BackgroundTransparency = T.BlobAlpha
			b.Text = text; b.TextColor3 = T.BrightGold; b.Font = T.Font; b.TextSize = 11
			b.Size = UDim2.new(0.5, -3, 0, 22); b.Position = UDim2.new(x, x == 0 and 0 or 3, 1, -22)
			b.BorderSizePixel = 0; b.ZIndex = 201; b.Parent = panel
			W.addCorner(b, UDim.new(0, 4)); W.addStroke(b); return b
		end
		local setBtn = makeBtn("Set", 0); local cancelBtn = makeBtn("Cancel", 0.5)

		local function close(commit)
			panel:Destroy()
			if _activePanel and _activePanel.frame == panel then _activePanel = nil end
			if commit and opts.onSet then opts.onSet(linkMap, dirtyAxes) end
			if not commit and opts.onCancel then opts.onCancel() end
		end
		setBtn.Activated:Connect(function() close(true) end)
		cancelBtn.Activated:Connect(function() close(false) end)
		_activePanel = { frame = panel, close = function() close(false) end }
		return _activePanel
	end

	-- True while either the instance picker OR the axis-link panel is open.
	-- Callers (init.server.lua's SelectionChanged hook) gate handleSelection on
	-- this so a Studio Selection change made WHILE the picker is open doesn't
	-- repopulate the Properties panel out from under the user  -  the picker uses
	-- Selection to read the user's chosen target, but the rest of the plugin
	-- should stay frozen on the source items being configured.
	local function isOpen() return _activePanel ~= nil end

	return {
		openInstancePicker = openInstancePicker,
		openAxisLinkPanel = openAxisLinkPanel,
		closeActive = closeActive,
		isOpen = isOpen,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="92">
            <Properties>
              <string name="Name">Constants</string>
              <string name="Source"><![CDATA[--[[
	UIBuilderConstants  -  Part-Icles V5
	Copyright (C) 2026 Qwinkle
	Theme defaults, layout constants, palette, hex/shade utilities.
	This module is a singleton  -  all consumers share the same T and LAYOUT tables.
]]

local Constants = {}

Constants.T = {
	PanelBg = Color3.fromRGB(35, 22, 12), PanelAlpha = 0.15,
	BlobBg = Color3.fromRGB(30, 18, 10), BlobAlpha = 0.25,
	Border = Color3.fromRGB(180, 130, 70), BorderAlpha = 0.8,
	TextAccent = Color3.fromRGB(196, 162, 101),
	Gold = Color3.fromRGB(196, 162, 101), BrightGold = Color3.fromRGB(232, 213, 168),
	MutedGold = Color3.fromRGB(154, 122, 72), DarkGold = Color3.fromRGB(122, 90, 48),
	Green = Color3.fromRGB(139, 195, 74), Red = Color3.fromRGB(238, 100, 100),
	SliderFill = Color3.fromRGB(180, 60, 60),
	ScrollBar = Color3.fromRGB(154, 122, 72),
	AxisX = Color3.fromRGB(238, 136, 136), AxisY = Color3.fromRGB(136, 238, 136), AxisZ = Color3.fromRGB(136, 136, 238),
	-- BodyFont is honored only on the initial Build paint. UpdateTheme's font-change
	-- loop (UpdateTheme in init.luau) walks all TextLabel/TextButton/TextBox descendants and
	-- forces .Font = T.Font, overwriting any element set to BodyFont. To preserve
	-- the typographic hierarchy across theme-font changes, BodyFont consumers set
	-- the `_noFontOverride` attribute. Set by: Modules/UIBuilder/init.luau,
	-- Modules/UIBuilder/InventoryPanel.luau, Modules/UIBuilder/InventoryDissectDialog.
	-- luau, Modules/UIBuilder/InventoryImportDialog.luau, Modules/UIBuilder/ToolPanels.
	-- luau, InventoryWiring/Grid.luau.
	Font = Enum.Font.FredokaOne, BodyFont = Enum.Font.GothamMedium, FontScale = 1,
	Corner = UDim.new(0, 5), BigCorner = UDim.new(0, 8),
	-- Optional decorative background image rendered behind every panel's content. Empty
	-- BgImage = "" means no image is drawn (the ImageLabel sits inert at ImageTransparency=1).
	-- BgImageTransparency follows Roblox semantics: 1 = fully transparent / hidden, 0 = fully
	-- opaque. Default 1 so legacy themes look identical until a user picks an image.
	BgImage = "", BgImageTransparency = 1,
}

Constants.LAYOUT = {
	HudWidth = 164, HudX = 12, HudY = 12,
	PropsWidth = 280, PropsHeight = 520, PropsX = 292, PropsY = 12,
	SettingsWidth = 200, SettingsHeight = 380,
	LabelWidth = 78, ContentOffset = 82, RowHeight = 22, SectionHead = 22,
}

-- Exact default shades (never derived, always these on reset)
Constants.DEFAULT_TEXT_SHADES = {
	BrightGold = Color3.fromRGB(232, 213, 168),
	Gold = Color3.fromRGB(196, 162, 101),
	MutedGold = Color3.fromRGB(154, 122, 72),
	DarkGold = Color3.fromRGB(122, 90, 48),
}

-- Derive 4 text shades from a custom accent color (used only for non-default colors)
function Constants.deriveTextShades(base)
	local h, s, v = base:ToHSV()
	local bright = Color3.fromHSV(h, math.max(0, s * 0.55), math.min(1, v * 1.2))
	local muted = Color3.fromHSV(h, math.min(1, s * 1.15), v * 0.78)
	local dark = Color3.fromHSV(h, math.min(1, s * 1.25), v * 0.62)
	return bright, base, muted, dark
end

-- Check if a color matches the default text accent
local DEFAULT_TEXT_ACCENT = Color3.fromRGB(196, 162, 101)
function Constants.isDefaultTextAccent(c)
	return math.abs(c.R - DEFAULT_TEXT_ACCENT.R) < 0.02
		and math.abs(c.G - DEFAULT_TEXT_ACCENT.G) < 0.02
		and math.abs(c.B - DEFAULT_TEXT_ACCENT.B) < 0.02
end

-- Hex conversion utilities
function Constants.color3ToHex(c)
	return string.format("#%02X%02X%02X", math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5))
end

function Constants.hexToColor3(hex)
	hex = hex:gsub("#","")
	if #hex == 3 then hex = hex:sub(1,1):rep(2)..hex:sub(2,2):rep(2)..hex:sub(3,3):rep(2) end
	if #hex ~= 6 then return nil end
	local r, g, b = tonumber(hex:sub(1,2),16), tonumber(hex:sub(3,4),16), tonumber(hex:sub(5,6),16)
	if not r or not g or not b then return nil end
	return Color3.fromRGB(r, g, b)
end

Constants.FONT_OPTIONS = {
	"Arial","ArialBold","Bangers","BuilderSans","BuilderSansBold","BuilderSansExtraBold",
	"BuilderSansMedium","Cartoon","Code","Creepster","DenkOne","Fantasy","Fondamento",
	"FredokaOne","GothamBlack","GothamBold","GothamMedium","GothamSSm","Greenhouse",
	"Highway","IndieFlower","JosefinSans","Jura","Kalam","LuckiestGuy","Merriweather",
	"Michroma","Montserrat","MontserratBold","MontserratMedium","Nunito","Oswald",
	"PatrickHand","PermanentMarker","Roboto","RobotoCondensed","RobotoMono","RobotoSlab",
	"SciFi","SourceSans","SourceSansBold","SourceSansItalic","SourceSansSemibold",
	"SpecialElite","TitilliumWeb","Ubuntu","Unknown",
}

Constants.PALETTE = {
	Color3.fromRGB(255,255,255), Color3.fromRGB(200,200,200), Color3.fromRGB(140,140,140), Color3.fromRGB(80,80,80),
	Color3.fromRGB(40,40,40), Color3.fromRGB(20,20,20), Color3.fromRGB(10,5,2), Color3.fromRGB(0,0,0),
	Color3.fromRGB(255,60,60), Color3.fromRGB(255,140,60), Color3.fromRGB(255,220,60), Color3.fromRGB(140,255,60),
	Color3.fromRGB(60,255,100), Color3.fromRGB(60,255,220), Color3.fromRGB(60,180,255), Color3.fromRGB(100,60,255),
	Color3.fromRGB(180,130,70), Color3.fromRGB(140,80,40), Color3.fromRGB(80,50,25), Color3.fromRGB(35,22,12),
	Color3.fromRGB(180,60,60), Color3.fromRGB(60,120,180), Color3.fromRGB(139,195,74), Color3.fromRGB(196,162,101),
	Color3.fromRGB(255,100,150), Color3.fromRGB(200,60,200), Color3.fromRGB(120,60,200), Color3.fromRGB(60,60,180),
	Color3.fromRGB(232,213,168), Color3.fromRGB(154,122,72), Color3.fromRGB(122,90,48), Color3.fromRGB(100,160,230),
}

-- Theme presets (applied via ThemeWiring preset dropdown)
Constants.THEME_PRESETS = {
	{ name="Default Gold", accent=Color3.fromRGB(180,130,70), bg=Color3.fromRGB(35,22,12),
	  blob=Color3.fromRGB(30,18,10), slider=Color3.fromRGB(180,60,60), scrollBar=Color3.fromRGB(154,122,72),
	  textAccent=Color3.fromRGB(196,162,101), panelAlpha=0.15, blobAlpha=0.25, font="FredokaOne" },
	{ name="Midnight Blue", accent=Color3.fromRGB(100,140,200), bg=Color3.fromRGB(15,20,35),
	  blob=Color3.fromRGB(12,16,28), slider=Color3.fromRGB(80,120,200), scrollBar=Color3.fromRGB(70,100,160),
	  textAccent=Color3.fromRGB(160,185,220), panelAlpha=0.12, blobAlpha=0.2, font="FredokaOne" },
	{ name="Crimson Dark", accent=Color3.fromRGB(200,80,80), bg=Color3.fromRGB(30,15,15),
	  blob=Color3.fromRGB(25,12,12), slider=Color3.fromRGB(220,60,60), scrollBar=Color3.fromRGB(160,70,70),
	  textAccent=Color3.fromRGB(220,170,170), panelAlpha=0.15, blobAlpha=0.25, font="FredokaOne" },
	{ name="Forest Green", accent=Color3.fromRGB(100,170,80), bg=Color3.fromRGB(18,28,15),
	  blob=Color3.fromRGB(14,22,12), slider=Color3.fromRGB(80,160,60), scrollBar=Color3.fromRGB(70,130,55),
	  textAccent=Color3.fromRGB(170,210,150), panelAlpha=0.15, blobAlpha=0.25, font="FredokaOne" },
	{ name="Pitch Black", accent=Color3.fromRGB(200,200,200), bg=Color3.fromRGB(10,10,10),
	  blob=Color3.fromRGB(18,18,18), slider=Color3.fromRGB(255,255,255), scrollBar=Color3.fromRGB(80,80,80),
	  textAccent=Color3.fromRGB(220,220,220), panelAlpha=0.05, blobAlpha=0.15, font="GothamMedium" },
	{ name="Monochrome", accent=Color3.fromRGB(180,180,180), bg=Color3.fromRGB(30,30,30),
	  blob=Color3.fromRGB(45,45,45), slider=Color3.fromRGB(160,160,160), scrollBar=Color3.fromRGB(100,100,100),
	  textAccent=Color3.fromRGB(200,200,200), panelAlpha=0.1, blobAlpha=0.2, font="RobotoMono" },
	{ name="Dracula", accent=Color3.fromRGB(189,147,249), bg=Color3.fromRGB(40,42,54),
	  blob=Color3.fromRGB(50,52,66), slider=Color3.fromRGB(255,121,198), scrollBar=Color3.fromRGB(98,114,164),
	  textAccent=Color3.fromRGB(248,248,242), panelAlpha=0.08, blobAlpha=0.2, font="RobotoMono" },
	{ name="Nord", accent=Color3.fromRGB(136,192,208), bg=Color3.fromRGB(46,52,64),
	  blob=Color3.fromRGB(59,66,82), slider=Color3.fromRGB(163,190,140), scrollBar=Color3.fromRGB(76,86,106),
	  textAccent=Color3.fromRGB(216,222,233), panelAlpha=0.08, blobAlpha=0.2, font="GothamMedium" },
	{ name="Sunset", accent=Color3.fromRGB(255,154,80), bg=Color3.fromRGB(35,15,25),
	  blob=Color3.fromRGB(45,20,30), slider=Color3.fromRGB(255,100,120), scrollBar=Color3.fromRGB(180,90,60),
	  textAccent=Color3.fromRGB(255,210,170), panelAlpha=0.12, blobAlpha=0.22, font="FredokaOne" },
}

return Constants
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="93">
            <Properties>
              <string name="Name">HitFilterPanel</string>
              <string name="Source"><![CDATA[--[[
	HitFilterPanel  -  modal for the OnHit Filter row. Two controls:

	  1. Collision Group dropdown  -  RaycastParams.CollisionGroup string. Sourced
	     from PhysicsService:GetRegisteredCollisionGroups() with "(none)" as the
	     unset/default option.
	  2. Exclude List  -  multi-instance picker. Each row is one ObjectValue child
	     of the per-event ExcludeList Folder; RaycastParams.FilterDescendantsInstances
	     ignores the listed Instance + all descendants by Roblox API semantics.

	Writes through to EVERY item in opts.items (multi-select edits apply across
	the selection). ChangeHistoryService waypoint per write. Reuses
	ConfigPanel.openInstancePicker for the Add button.

	Returns: { open(opts), close(), isOpen() }
	opts: { items = {...}, eventName = "OnHit" }
]]

local PhysicsService = game:GetService("PhysicsService")

return function(deps)
	local W = deps.W
	local T = deps.T
	local ConfigPanel = deps.ConfigPanel
	local EventsSchema = deps.EventsSchema
	local ChangeHistoryService = deps.ChangeHistoryService

	local _activePanel = nil
	-- True while an open modal session is collecting writes. closeActive emits the
	-- closing waypoint only when this is true; teardown calls (no session) skip it.
	local _sessionActive = false
	-- Fired once on closeActive when a session is open. Used by EventsConnectors
	-- to refresh the Events panel's Filter label (group + exclude count) without
	-- the user having to re-select the items.
	local _onCloseCallback = nil

	local function closeActive()
		local fireCallback = _sessionActive and _onCloseCallback
		if _sessionActive then
			ChangeHistoryService:SetWaypoint("Part-Icles: OnHit Filters")
			_sessionActive = false
		end
		_onCloseCallback = nil
		if _activePanel then
			pcall(function() _activePanel:Destroy() end)
			_activePanel = nil
		end
		if fireCallback then pcall(fireCallback) end
	end

	-- Returns array of registered group names, "(none)" prepended. PhysicsService
	-- returns {{id, name, mask}, ...}; we project to .name strings.
	local function collectGroupNames()
		local out = { "(none)" }
		local ok, groups = pcall(function() return PhysicsService:GetRegisteredCollisionGroups() end)
		if ok and type(groups) == "table" then
			for _, g in ipairs(groups) do
				if type(g) == "table" and type(g.name) == "string" then
					table.insert(out, g.name)
				end
			end
		end
		return out
	end

	-- Walk every selected item's ExcludeList folder, collect union of {.Value}
	-- references deduped. Each entry tracks how many items have that exclude so
	-- the user can see partial-selection state  -  but for simplicity we just show
	-- the union and write Add to all-without / Remove from all-with.
	local function gatherExcludes(items)
		local seen = {}
		local list = {}
		for _, item in ipairs(items) do
			local cfg = EventsSchema.readEvent(item, "OnHit")
			if cfg then
				local folder = cfg:FindFirstChild("ExcludeList")
				if folder then
					for _, child in ipairs(folder:GetChildren()) do
						if child:IsA("ObjectValue") and child.Value and not seen[child.Value] then
							seen[child.Value] = true
							table.insert(list, child.Value)
						end
					end
				end
			end
		end
		return list
	end

	-- These three mutators are called from inside an open modal session. Undo
	-- waypoints are batched at the open/close boundaries (see `open` below) so
	-- N edits in one session collapse to a single undo step. Per-write waypoints
	-- here would fragment the user's history.
	local function addExcludeToAll(items, inst)
		for _, item in ipairs(items) do
			local cfg = EventsSchema.readEvent(item, "OnHit")
			if cfg then
				local folder = EventsSchema.ensureExcludeListFolder(cfg)
				local alreadyHas = false
				for _, child in ipairs(folder:GetChildren()) do
					if child:IsA("ObjectValue") and child.Value == inst then
						alreadyHas = true
						break
					end
				end
				if not alreadyHas then
					local ov = Instance.new("ObjectValue")
					ov.Name = "Exclude"
					ov.Value = inst
					ov.Parent = folder
				end
			end
		end
	end

	local function removeExcludeFromAll(items, inst)
		for _, item in ipairs(items) do
			local cfg = EventsSchema.readEvent(item, "OnHit")
			if cfg then
				local folder = cfg:FindFirstChild("ExcludeList")
				if folder then
					for _, child in ipairs(folder:GetChildren()) do
						if child:IsA("ObjectValue") and child.Value == inst then
							child:Destroy()
						end
					end
				end
			end
		end
	end

	local function setGroupOnAll(items, groupName)
		-- "(none)" sentinel clears the attribute back to empty string so makeHitParams
		-- skips the CollisionGroup write entirely (matches the schema default).
		local value = (groupName == "(none)") and "" or groupName
		for _, item in ipairs(items) do
			local cfg = EventsSchema.readEvent(item, "OnHit")
			if cfg then cfg:SetAttribute("CollisionGroup", value) end
		end
	end

	-- Read group of items' CollisionGroup attr; nil = mixed, "" = none, else value.
	local function commonGroup(items)
		local first, set = nil, false
		for _, item in ipairs(items) do
			local cfg = EventsSchema.readEvent(item, "OnHit")
			local v = cfg and cfg:GetAttribute("CollisionGroup") or ""
			if not set then first = v; set = true
			elseif v ~= first then return nil end
		end
		return first
	end

	local function open(opts)
		closeActive()
		if not opts or not opts.items or #opts.items == 0 then return end

		-- Filter to items whose type actually supports OnHit. Beam / PointLight /
		-- screens / etc. return nil from readEvent and would silently no-op every
		-- write  -  surface that mismatch to the user instead of opening a dead modal.
		local originalCount = #opts.items
		local filteredItems = {}
		for _, item in ipairs(opts.items) do
			if EventsSchema.isValidForItem(item, "OnHit") then
				table.insert(filteredItems, item)
			end
		end
		if #filteredItems == 0 then
			print("[Part-Icles] OnHit filters not applicable to this selection  -  Beam / PointLight / Trail / screens do not support OnHit.")
			return
		end
		opts.items = filteredItems

		local screenGui = W.getScreenGui and W.getScreenGui() or deps.screenGui
		if not screenGui then return end

		-- Open the undo session BEFORE creating any UI. Waypoints inside the modal
		-- collapse into one undo step bracketed by this + closeActive's waypoint.
		ChangeHistoryService:SetWaypoint("Part-Icles: Before OnHit Filters")
		_sessionActive = true
		_onCloseCallback = opts.onClose  -- re-populate trigger; fired by closeActive

		local panel = Instance.new("Frame")
		panel.Name = "HitFilterPanel"
		panel.BackgroundColor3 = T.PanelBg
		-- T.PanelAlpha matches the main settings panel so the parchment ImageLabel
		-- (attached as a sibling at ZIndex 0 via attachPanelBackground) renders
		-- through the panel's solid color instead of being fully occluded.
		panel.BackgroundTransparency = T.PanelAlpha
		panel.Size = UDim2.new(0, 320, 0, 280)
		panel.AnchorPoint = Vector2.new(0.5, 0.5)
		panel.Position = UDim2.new(0.5, 0, 0.5, 0)
		panel.BorderSizePixel = 0
		panel.ZIndex = 200
		panel.Active = true
		panel:SetAttribute("_opaquePanel", true)
		panel:SetAttribute("_noSnap", true)
		panel.Parent = screenGui
		W.addCorner(panel, T.Corner)
		W.addStroke(panel)
		W.addPadding(panel, 8, 8, 8, 8)
		W.attachPanelBackground(panel)
		_activePanel = panel

		-- Header
		local title = Instance.new("TextLabel")
		title.BackgroundTransparency = 1
		title.Text = "OnHit Filters"
		title.TextColor3 = T.Gold
		title.Font = T.Font
		title.TextSize = 12
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.ZIndex = 201
		title.Size = UDim2.new(1, -20, 0, 16)
		title.Position = UDim2.new(0, 0, 0, 0)
		title.Parent = panel

		-- Drag handle covers the title bar minus the close X. ZIndex 201 keeps it
		-- above the panel's image overlay but below the close button (ZIndex 202).
		local dragHandle = Instance.new("TextButton")
		dragHandle.Name = "DragHandle"
		dragHandle.BackgroundTransparency = 1
		dragHandle.Text = ""
		dragHandle.Size = UDim2.new(1, -20, 0, 16)
		dragHandle.Position = UDim2.new(0, 0, 0, 0)
		dragHandle.ZIndex = 201
		dragHandle.Parent = panel
		W.makeDraggable(panel, dragHandle)

		local closeBtn = Instance.new("TextButton")
		closeBtn.BackgroundTransparency = 1
		closeBtn.Text = "X"
		closeBtn.TextColor3 = T.DarkGold
		closeBtn.Font = T.Font
		closeBtn.TextSize = 12
		closeBtn.Size = UDim2.new(0, 16, 0, 16)
		closeBtn.Position = UDim2.new(1, -16, 0, 0)
		closeBtn.ZIndex = 202
		closeBtn.Parent = panel

		-- "Applies to N of M" notice when the user's selection includes items that
		-- can't take an OnHit filter. Hidden when the filter matches every item.
		if #filteredItems < originalCount then
			local notice = Instance.new("TextLabel")
			notice.BackgroundTransparency = 1
			notice.Text = ("Filters apply to %d of %d selected items"):format(#filteredItems, originalCount)
			notice.TextColor3 = T.MutedGold
			notice.Font = T.Font
			notice.TextSize = 9
			notice.TextXAlignment = Enum.TextXAlignment.Left
			notice.TextTruncate = Enum.TextTruncate.AtEnd
			notice.ZIndex = 201
			notice.Size = UDim2.new(1, 0, 0, 12)
			notice.Position = UDim2.new(0, 0, 0, 18)
			notice.Parent = panel
		end

		-- Collision group row
		local cgLbl = Instance.new("TextLabel")
		cgLbl.BackgroundTransparency = 1
		cgLbl.Text = "Collision Group"
		cgLbl.TextColor3 = T.MutedGold
		cgLbl.Font = T.Font
		cgLbl.TextSize = 10
		cgLbl.TextXAlignment = Enum.TextXAlignment.Left
		cgLbl.ZIndex = 201
		cgLbl.Size = UDim2.new(0, 100, 0, 22)
		cgLbl.Position = UDim2.new(0, 0, 0, 22)
		cgLbl.Parent = panel

		local cgWrap = Instance.new("Frame")
		cgWrap.BackgroundTransparency = 1
		cgWrap.Size = UDim2.new(1, -104, 0, 22)
		cgWrap.Position = UDim2.new(0, 104, 0, 22)
		cgWrap.ZIndex = 201
		cgWrap.Parent = panel

		local groupNames = collectGroupNames()
		local currentGroup = commonGroup(opts.items)
		local defaultText
		if currentGroup == nil then defaultText = "~"
		elseif currentGroup == "" then defaultText = "(none)"
		else defaultText = currentGroup end
		local cgLblWidget, cgFrame, cgSetOnChanged = W.makeDropdown("CGroup", cgWrap, groupNames, defaultText)
		cgFrame.Size = UDim2.new(1, 0, 1, 0)
		cgFrame.Position = UDim2.new(0, 0, 0, 0)
		-- If commonGroup returned nil (mixed), show "~"; dropdown's internal value defaults
		-- to options[1] but we override the display so the user sees the mixed state.
		if currentGroup == nil then cgLblWidget.Text = "~" end
		cgSetOnChanged(function(picked)
			setGroupOnAll(opts.items, picked)
		end)

		-- Exclude List header
		local exHdr = Instance.new("TextLabel")
		exHdr.BackgroundTransparency = 1
		exHdr.Text = "Exclude List (ignores instance + descendants)"
		exHdr.TextColor3 = T.MutedGold
		exHdr.Font = T.Font
		exHdr.TextSize = 10
		exHdr.TextXAlignment = Enum.TextXAlignment.Left
		exHdr.ZIndex = 201
		exHdr.Size = UDim2.new(1, 0, 0, 16)
		exHdr.Position = UDim2.new(0, 0, 0, 52)
		exHdr.Parent = panel

		-- Scroll body for the list
		local scroll = Instance.new("ScrollingFrame")
		scroll.BackgroundColor3 = T.BlobBg
		scroll.BackgroundTransparency = T.BlobAlpha
		scroll.BorderSizePixel = 0
		scroll.Size = UDim2.new(1, 0, 0, 160)
		scroll.Position = UDim2.new(0, 0, 0, 70)
		scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
		scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
		scroll.ScrollBarThickness = 6
		scroll.ZIndex = 201
		scroll.Parent = panel
		W.addCorner(scroll, UDim.new(0, 4))
		W.addPadding(scroll, 4, 4, 4, 4)
		local listLayout = Instance.new("UIListLayout")
		listLayout.SortOrder = Enum.SortOrder.LayoutOrder
		listLayout.Padding = UDim.new(0, 2)
		listLayout.Parent = scroll

		local function renderList()
			for _, child in ipairs(scroll:GetChildren()) do
				if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
					child:Destroy()
				end
			end
			local excludes = gatherExcludes(opts.items)
			if #excludes == 0 then
				local empty = Instance.new("TextLabel")
				empty.BackgroundTransparency = 1
				empty.Text = "(no excludes)"
				empty.TextColor3 = T.DarkGold
				empty.Font = T.Font
				empty.TextSize = 10
				empty.TextXAlignment = Enum.TextXAlignment.Left
				empty.Size = UDim2.new(1, 0, 0, 18)
				empty.LayoutOrder = 0
				empty.ZIndex = 202
				empty.Parent = scroll
				return
			end
			for i, inst in ipairs(excludes) do
				local row = Instance.new("Frame")
				row.BackgroundTransparency = 1
				row.Size = UDim2.new(1, 0, 0, 18)
				row.LayoutOrder = i
				row.ZIndex = 202
				row.Parent = scroll

				local pathLbl = Instance.new("TextLabel")
				pathLbl.BackgroundTransparency = 1
				pathLbl.Text = inst:GetFullName()
				pathLbl.TextColor3 = T.BrightGold
				pathLbl.Font = T.Font
				pathLbl.TextSize = 10
				pathLbl.TextXAlignment = Enum.TextXAlignment.Left
				pathLbl.TextTruncate = Enum.TextTruncate.AtEnd
				pathLbl.Size = UDim2.new(1, -24, 1, 0)
				pathLbl.Position = UDim2.new(0, 0, 0, 0)
				pathLbl.ZIndex = 203
				pathLbl.Parent = row

				local rmBtn = Instance.new("TextButton")
				rmBtn.BackgroundColor3 = T.BlobBg
				rmBtn.BackgroundTransparency = T.BlobAlpha
				rmBtn.Text = "X"
				rmBtn.TextColor3 = T.MutedGold
				rmBtn.Font = T.Font
				rmBtn.TextSize = 10
				rmBtn.Size = UDim2.new(0, 20, 1, 0)
				rmBtn.Position = UDim2.new(1, -20, 0, 0)
				rmBtn.BorderSizePixel = 0
				rmBtn.ZIndex = 203
				rmBtn.Parent = row
				W.addCorner(rmBtn, UDim.new(0, 3))
				rmBtn.Activated:Connect(function()
					removeExcludeFromAll(opts.items, inst)
					renderList()
				end)
			end
		end
		renderList()

		-- Add button
		local addBtn = W.makeButton("AddExclude", panel, "+ Add Exclude",
			UDim2.new(1, 0, 0, 22), T.Gold)
		addBtn.Position = UDim2.new(0, 0, 1, -22)
		addBtn.ZIndex = 201
		addBtn.Activated:Connect(function()
			if not ConfigPanel or not ConfigPanel.openInstancePicker then return end
			ConfigPanel.openInstancePicker({
				title = "Add Exclude",
				label = "Pick an Instance to exclude from OnHit",
				context = (#opts.items == 1) and opts.items[1]:GetFullName() or (#opts.items .. " items"),
				excludeItems = opts.items,
				onSet = function(picked)
					if picked then
						addExcludeToAll(opts.items, picked)
						renderList()
					end
				end,
			})
		end)

		closeBtn.Activated:Connect(function()
			closeActive()
		end)
	end

	local function close()
		closeActive()
	end

	local function isOpen()
		return _activePanel ~= nil
	end

	return {
		open = open,
		close = close,
		isOpen = isOpen,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="94">
            <Properties>
              <string name="Name">InventoryDissectDialog</string>
              <string name="Source"><![CDATA[--[[
	InventoryDissectDialog  -  Part-Icles V5
	Copyright (C) 2026 Qwinkle
	Builds the Dissect Spritesheet dialog UI.
	Returns refs table for wiring.
]]

local C = require(script.Parent.Constants)
local W = require(script.Parent.Widgets)
local T = C.T

local DIALOG_W, DIALOG_H = 300, 240
local Z = 52

-- Alias canonical Widgets.addCorner.
local addCorner = W.addCorner

local InventoryDissectDialog = {}

function InventoryDissectDialog.build(sg)
	local refs = {}
	local _themed = W.getThemed()

	-- Backdrop
	local backdrop = Instance.new("TextButton"); backdrop.Name = "DissectBackdrop"
	backdrop.BackgroundColor3 = Color3.new(0, 0, 0); backdrop.BackgroundTransparency = 0.7
	backdrop.Text = ""; backdrop.AutoButtonColor = false; backdrop.Size = UDim2.new(1, 0, 1, 0)
	backdrop.ZIndex = Z - 1; backdrop.Visible = false; backdrop.Parent = sg; backdrop.BorderSizePixel = 0
	refs.DissectBackdrop = backdrop

	-- Dialog frame
	local dialog = Instance.new("Frame"); dialog.Name = "DissectDialog"
	dialog.BackgroundColor3 = T.PanelBg; dialog.BackgroundTransparency = 0
	dialog.Size = UDim2.new(0, DIALOG_W, 0, DIALOG_H)
	dialog.AnchorPoint = Vector2.new(0.5, 0.5); dialog.Position = UDim2.new(0.5, 0, 0.5, 0)
	dialog.Visible = false; dialog.ZIndex = Z; dialog.ClipsDescendants = true
	dialog:SetAttribute("_noSnap", true); dialog.Parent = sg
	-- Modal dialog should stay fully readable rather than picking up the global panel translucency.
	dialog:SetAttribute("_opaquePanel", true)
	addCorner(dialog, T.BigCorner); W.addStroke(dialog); table.insert(_themed.panels, dialog)
	W.attachPanelBackground(dialog)
	local dp = Instance.new("UIPadding"); dp.PaddingLeft = UDim.new(0, 10); dp.PaddingRight = UDim.new(0, 10)
	dp.PaddingTop = UDim.new(0, 6); dp.PaddingBottom = UDim.new(0, 8); dp.Parent = dialog
	refs.DissectDialog = dialog

	-- Header
	local title = Instance.new("TextLabel"); title.BackgroundTransparency = 1
	title.Text = "Dissect Spritesheets"; title.TextColor3 = T.Gold; title.Font = T.Font; title.TextSize = 11
	title.TextXAlignment = Enum.TextXAlignment.Left; title.Size = UDim2.new(1, -20, 0, 18)
	title.ZIndex = Z + 1; title.Parent = dialog
	local closeBtn = Instance.new("TextButton"); closeBtn.Name = "Close"; closeBtn.BackgroundTransparency = 1
	closeBtn.Text = "X"; closeBtn.TextColor3 = T.DarkGold; closeBtn.Font = T.Font; closeBtn.TextSize = 11
	closeBtn.Size = UDim2.new(0, 16, 0, 18); closeBtn.Position = UDim2.new(1, -16, 0, 0)
	closeBtn.ZIndex = Z + 2; closeBtn.Parent = dialog
	refs.DissectClose = closeBtn
	-- Drag handle
	local dragH = Instance.new("TextButton"); dragH.BackgroundTransparency = 1; dragH.Text = ""
	dragH.Size = UDim2.new(1, -20, 0, 18); dragH.ZIndex = Z + 1; dragH.Parent = dialog
	W.makeDraggable(dialog, dragH)

	-- Grid row: Cols + Rows
	local gridRow = Instance.new("Frame"); gridRow.BackgroundTransparency = 1
	gridRow.Size = UDim2.new(1, 0, 0, 22); gridRow.Position = UDim2.new(0, 0, 0, 22); gridRow.ZIndex = Z + 1; gridRow.Parent = dialog

	local colsLbl = Instance.new("TextLabel"); colsLbl.BackgroundTransparency = 1; colsLbl.Text = "Cols:"
	colsLbl.TextColor3 = T.MutedGold; colsLbl.Font = T.Font; colsLbl.TextSize = 10
	colsLbl.Size = UDim2.new(0, 28, 1, 0); colsLbl.ZIndex = Z + 1; colsLbl.Parent = gridRow
	local colsBox = Instance.new("TextBox"); colsBox.Name = "ColsBox"
	colsBox.BackgroundColor3 = T.BlobBg; colsBox.BackgroundTransparency = T.BlobAlpha
	colsBox.TextColor3 = T.BrightGold; colsBox.Font = T.Font; colsBox.TextSize = 11; colsBox.Text = "4"
	colsBox.ClearTextOnFocus = true; colsBox.Size = UDim2.new(0, 36, 1, 0); colsBox.Position = UDim2.new(0, 30, 0, 0)
	colsBox.BorderSizePixel = 0; colsBox.ZIndex = Z + 1; colsBox.Parent = gridRow
	addCorner(colsBox, UDim.new(0, 4)); table.insert(_themed.blobs, colsBox)

	local rowsLbl = Instance.new("TextLabel"); rowsLbl.BackgroundTransparency = 1; rowsLbl.Text = "Rows:"
	rowsLbl.TextColor3 = T.MutedGold; rowsLbl.Font = T.Font; rowsLbl.TextSize = 10
	rowsLbl.Size = UDim2.new(0, 32, 1, 0); rowsLbl.Position = UDim2.new(0, 76, 0, 0); rowsLbl.ZIndex = Z + 1; rowsLbl.Parent = gridRow
	local rowsBox = Instance.new("TextBox"); rowsBox.Name = "RowsBox"
	rowsBox.BackgroundColor3 = T.BlobBg; rowsBox.BackgroundTransparency = T.BlobAlpha
	rowsBox.TextColor3 = T.BrightGold; rowsBox.Font = T.Font; rowsBox.TextSize = 11; rowsBox.Text = "4"
	rowsBox.ClearTextOnFocus = true; rowsBox.Size = UDim2.new(0, 36, 1, 0); rowsBox.Position = UDim2.new(0, 110, 0, 0)
	rowsBox.BorderSizePixel = 0; rowsBox.ZIndex = Z + 1; rowsBox.Parent = gridRow
	addCorner(rowsBox, UDim.new(0, 4)); table.insert(_themed.blobs, rowsBox)
	refs.DissectCols = colsBox; refs.DissectRows = rowsBox

	-- Label
	local idsLbl = Instance.new("TextLabel"); idsLbl.BackgroundTransparency = 1
	idsLbl.Text = "Asset IDs (one per line, or comma-separated):"; idsLbl.TextColor3 = T.MutedGold; idsLbl.Font = T.Font
	idsLbl.TextSize = 9; idsLbl.TextXAlignment = Enum.TextXAlignment.Left
	idsLbl.Size = UDim2.new(1, -70, 0, 12); idsLbl.Position = UDim2.new(0, 0, 0, 48); idsLbl.ZIndex = Z + 1; idsLbl.Parent = dialog
	local fromSelBtn = Instance.new("TextButton"); fromSelBtn.Name = "FromSelection"
	fromSelBtn.BackgroundColor3 = T.BlobBg; fromSelBtn.BackgroundTransparency = T.BlobAlpha
	fromSelBtn.Text = "From Selection"; fromSelBtn.TextColor3 = T.MutedGold; fromSelBtn.Font = T.Font
	fromSelBtn.TextSize = 8; fromSelBtn.Size = UDim2.new(0, 68, 0, 14); fromSelBtn.Position = UDim2.new(1, -68, 0, 47)
	fromSelBtn.BorderSizePixel = 0; fromSelBtn.ZIndex = Z + 1; fromSelBtn.Parent = dialog
	addCorner(fromSelBtn, UDim.new(0, 3)); table.insert(_themed.blobs, fromSelBtn)
	refs.DissectFromSelection = fromSelBtn

	-- Multiline ID input
	local idWrap = Instance.new("ScrollingFrame"); idWrap.Name = "IDWrap"
	idWrap.BackgroundColor3 = T.BlobBg; idWrap.BackgroundTransparency = T.BlobAlpha
	idWrap.Size = UDim2.new(1, 0, 0, 100); idWrap.Position = UDim2.new(0, 0, 0, 62)
	idWrap.ScrollBarThickness = 2; idWrap.ScrollBarImageColor3 = T.ScrollBar; idWrap.BorderSizePixel = 0
	idWrap.AutomaticCanvasSize = Enum.AutomaticSize.Y; idWrap.CanvasSize = UDim2.new(0, 0, 0, 0)
	idWrap.ZIndex = Z + 1; idWrap.Parent = dialog
	addCorner(idWrap, UDim.new(0, 4)); table.insert(_themed.blobs, idWrap); table.insert(_themed.scrollbars, idWrap)
	local idBox = Instance.new("TextBox"); idBox.Name = "IDBox"; idBox.BackgroundTransparency = 1
	idBox.Text = ""; idBox.PlaceholderText = "123456789\n987654321"; idBox.TextColor3 = T.BrightGold
	idBox.PlaceholderColor3 = T.DarkGold; idBox.Font = Enum.Font.Code; idBox.TextSize = 10
	idBox.TextXAlignment = Enum.TextXAlignment.Left; idBox.TextYAlignment = Enum.TextYAlignment.Top
	idBox.MultiLine = true; idBox.TextWrapped = true; idBox.ClearTextOnFocus = false
	idBox.Size = UDim2.new(1, -8, 1, 0); idBox.Position = UDim2.new(0, 4, 0, 2)
	idBox.BorderSizePixel = 0; idBox.ZIndex = Z + 2; idBox.Parent = idWrap
	-- Pin the monospace Code font: column-aligned ID lists need fixed-width glyphs,
	-- so this box opts out of the theme-font override loop (UpdateTheme in UIBuilder/init.luau)
	-- via the `_noFontOverride` attribute below.
	idBox:SetAttribute("_noFontOverride", true)
	refs.DissectIDBox = idBox

	-- Footer buttons
	local footerY = DIALOG_H - 40
	local uploadDissect = Instance.new("TextButton"); uploadDissect.Name = "UploadDissect"
	uploadDissect.BackgroundColor3 = T.BlobBg; uploadDissect.BackgroundTransparency = T.BlobAlpha
	uploadDissect.Text = "Upload & Dissect"; uploadDissect.TextColor3 = T.MutedGold; uploadDissect.Font = T.Font
	uploadDissect.TextSize = 9; uploadDissect.Size = UDim2.new(0.42, -2, 0, 24)
	uploadDissect.Position = UDim2.new(0, 0, 0, footerY); uploadDissect.BorderSizePixel = 0
	uploadDissect.ZIndex = Z + 1; uploadDissect.Parent = dialog
	addCorner(uploadDissect, UDim.new(0, 4)); W.addStroke(uploadDissect); table.insert(_themed.blobs, uploadDissect)
	refs.DissectUploadBtn = uploadDissect

	local dissectBtn = Instance.new("TextButton"); dissectBtn.Name = "DissectBtn"
	dissectBtn.BackgroundColor3 = T.BlobBg; dissectBtn.BackgroundTransparency = T.BlobAlpha
	dissectBtn.Text = "Dissect"; dissectBtn.TextColor3 = T.Green; dissectBtn.Font = T.Font
	dissectBtn.TextSize = 10; dissectBtn.Size = UDim2.new(0.58, -2, 0, 24)
	dissectBtn.Position = UDim2.new(0.42, 2, 0, footerY); dissectBtn.BorderSizePixel = 0
	dissectBtn.ZIndex = Z + 1; dissectBtn.Parent = dialog
	addCorner(dissectBtn, UDim.new(0, 4)); W.addStroke(dissectBtn); table.insert(_themed.blobs, dissectBtn)
	refs.DissectBtn = dissectBtn

	return refs
end

return InventoryDissectDialog
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="95">
            <Properties>
              <string name="Name">InventoryImportDialog</string>
              <string name="Source"><![CDATA[--[[
	InventoryImportDialog  -  Part-Icles V5
	Copyright (C) 2026 Qwinkle
	Builds the Export/Import JSON dialog UI for local inventory.
	Returns refs table for wiring.
]]

local C = require(script.Parent.Constants)
local W = require(script.Parent.Widgets)
local T = C.T

local DIALOG_W, DIALOG_H = 320, 280
local Z = 50 -- high ZIndex to be on top of everything

-- Alias canonical Widgets.addCorner.
local addCorner = W.addCorner

local InventoryImportDialog = {}

function InventoryImportDialog.build(sg)
	local refs = {}
	local _themed = W.getThemed()

	-- Modal backdrop (blocks clicks to everything behind, closes dialog)
	local backdrop = Instance.new("TextButton"); backdrop.Name = "InvImportBackdrop"
	backdrop.BackgroundColor3 = Color3.new(0,0,0); backdrop.BackgroundTransparency = 0.7
	backdrop.Text = ""; backdrop.AutoButtonColor = false; backdrop.Size = UDim2.new(1,0,1,0); backdrop.ZIndex = Z - 1
	backdrop.Visible = false; backdrop.Parent = sg; backdrop.BorderSizePixel = 0
	refs.InvImportBackdrop = backdrop

	-- Main dialog frame
	local dialog = Instance.new("Frame"); dialog.Name = "InvImportDialog"
	dialog.BackgroundColor3 = T.PanelBg; dialog.BackgroundTransparency = 0
	dialog.Size = UDim2.new(0, DIALOG_W, 0, DIALOG_H)
	dialog.AnchorPoint = Vector2.new(0.5, 0.5); dialog.Position = UDim2.new(0.5, 0, 0.5, 0)
	dialog.Visible = false; dialog.ZIndex = Z; dialog.ClipsDescendants = true
	dialog:SetAttribute("_noSnap", true); dialog.Parent = sg
	-- Modal dialog should stay fully readable rather than picking up the global panel translucency.
	dialog:SetAttribute("_opaquePanel", true)
	addCorner(dialog, T.BigCorner); W.addStroke(dialog); table.insert(_themed.panels, dialog)
	W.attachPanelBackground(dialog)
	local dp = Instance.new("UIPadding"); dp.PaddingLeft = UDim.new(0, 10); dp.PaddingRight = UDim.new(0, 10)
	dp.PaddingTop = UDim.new(0, 6); dp.PaddingBottom = UDim.new(0, 8); dp.Parent = dialog
	refs.InvImportDialog = dialog

	-- Header
	local header = Instance.new("Frame"); header.Name = "Header"; header.BackgroundTransparency = 1
	header.Size = UDim2.new(1, 0, 0, 20); header.ZIndex = Z + 1; header.Parent = dialog
	local title = Instance.new("TextLabel"); title.BackgroundTransparency = 1
	title.Text = "Export / Import Local Inventory"; title.TextColor3 = T.Gold
	title.Font = T.Font; title.TextSize = 11; title.TextXAlignment = Enum.TextXAlignment.Left
	title.Size = UDim2.new(1, -20, 1, 0); title.Position = UDim2.new(0, 2, 0, 0)
	title.ZIndex = Z + 1; title.Parent = header
	local closeBtn = Instance.new("TextButton"); closeBtn.Name = "Close"; closeBtn.BackgroundTransparency = 1
	closeBtn.Text = "X"; closeBtn.TextColor3 = T.DarkGold; closeBtn.Font = T.Font; closeBtn.TextSize = 10
	closeBtn.Size = UDim2.new(0, 16, 0, 16); closeBtn.Position = UDim2.new(1, -16, 0, 0)
	closeBtn.ZIndex = Z + 1; closeBtn.Parent = header
	refs.InvImportClose = closeBtn
	local dragH = Instance.new("TextButton"); dragH.BackgroundTransparency = 1; dragH.Text = ""
	dragH.Size = UDim2.new(1, -20, 1, 0); dragH.ZIndex = Z + 1; dragH.Parent = header
	W.makeDraggable(dialog, dragH)

	-- Multiline text area
	local textWrap = Instance.new("ScrollingFrame"); textWrap.Name = "TextWrap"
	textWrap.BackgroundColor3 = T.BlobBg; textWrap.BackgroundTransparency = T.BlobAlpha
	textWrap.Size = UDim2.new(1, 0, 1, -76); textWrap.Position = UDim2.new(0, 0, 0, 24)
	textWrap.ScrollBarThickness = 3; textWrap.ScrollBarImageColor3 = T.ScrollBar
	textWrap.CanvasSize = UDim2.new(0, 0, 0, 0); textWrap.AutomaticCanvasSize = Enum.AutomaticSize.Y
	textWrap.BorderSizePixel = 0; textWrap.ZIndex = Z + 1; textWrap.Parent = dialog
	addCorner(textWrap, UDim.new(0, 4)); table.insert(_themed.blobs, textWrap); table.insert(_themed.scrollbars, textWrap)
	local textBox = Instance.new("TextBox"); textBox.Name = "TextBox"
	textBox.BackgroundTransparency = 1; textBox.Text = ""
	textBox.PlaceholderText = "Paste JSON here to import, or click Export..."
	textBox.PlaceholderColor3 = T.DarkGold; textBox.TextColor3 = T.BrightGold
	textBox.Font = T.BodyFont; textBox:SetAttribute("_noFontOverride", true); textBox.TextSize = 9; textBox.TextWrapped = true
	textBox.TextXAlignment = Enum.TextXAlignment.Left; textBox.TextYAlignment = Enum.TextYAlignment.Top
	textBox.ClearTextOnFocus = false; textBox.MultiLine = true
	textBox.Size = UDim2.new(1, -8, 0, 0); textBox.AutomaticSize = Enum.AutomaticSize.Y
	textBox.Position = UDim2.new(0, 4, 0, 4); textBox.ZIndex = Z + 1; textBox.Parent = textWrap
	refs.InvImportTextBox = textBox

	-- Button row
	local exportBtn = Instance.new("TextButton"); exportBtn.Name = "Export"
	exportBtn.BackgroundColor3 = T.BlobBg; exportBtn.BackgroundTransparency = T.BlobAlpha
	exportBtn.Text = "Export"; exportBtn.TextColor3 = T.Gold; exportBtn.Font = T.Font; exportBtn.TextSize = 10
	exportBtn.Size = UDim2.new(0.48, 0, 0, 22); exportBtn.Position = UDim2.new(0, 0, 1, -44)
	exportBtn.BorderSizePixel = 0; exportBtn.ZIndex = Z + 1; exportBtn.Parent = dialog
	addCorner(exportBtn, UDim.new(0, 4)); W.addStroke(exportBtn); table.insert(_themed.blobs, exportBtn)
	refs.InvExportBtn = exportBtn

	local importBtn = Instance.new("TextButton"); importBtn.Name = "Import"
	importBtn.BackgroundColor3 = T.Green; importBtn.Text = "Import"
	importBtn.TextColor3 = Color3.new(1, 1, 1); importBtn.Font = T.Font; importBtn.TextSize = 10
	importBtn.Size = UDim2.new(0.48, 0, 0, 22); importBtn.Position = UDim2.new(0.52, 0, 1, -44)
	importBtn.BorderSizePixel = 0; importBtn.ZIndex = Z + 1; importBtn.Parent = dialog
	addCorner(importBtn, UDim.new(0, 4)); W.addStroke(importBtn)
	refs.InvImportBtn = importBtn

	-- Status label
	local status = Instance.new("TextLabel"); status.Name = "Status"; status.BackgroundTransparency = 1
	status.Text = ""; status.TextColor3 = T.MutedGold; status.Font = T.Font; status.TextSize = 9
	status.Size = UDim2.new(1, 0, 0, 16); status.Position = UDim2.new(0, 0, 1, -18)
	status.TextXAlignment = Enum.TextXAlignment.Center; status.ZIndex = Z + 1; status.Parent = dialog
	refs.InvImportStatus = status

	return refs
end

return InventoryImportDialog
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">InventoryPanel</string>
              <string name="Source"><![CDATA[--[[
	InventoryPanel  -  Part-Icles V5
	Copyright (C) 2026 Qwinkle
	Builds the Inventory panel UI: sidebar, tabs, thumbnail grid, detail popup,
	loading/error states, tooltip, result count.
	Returns refs table for wiring.
]]

local C = require(script.Parent.Constants)
local W = require(script.Parent.Widgets)
local T = C.T

local PANEL_W, PANEL_H = 600, 380
local SIDEBAR_W = 110
local TAB_H = 24
local SEARCH_H = 26
-- Detail panel width is defined inline (DETAIL_PANEL_W)

-- Alias canonical Widgets.addCorner.
local addCorner = W.addCorner

local InventoryPanel = {}

function InventoryPanel.build(sg)
	local refs = {}
	local _themed = W.getThemed()

	-- Main panel
	local panel = Instance.new("Frame"); panel.Name = "InventoryPanel"
	panel.BackgroundColor3 = T.PanelBg; panel.BackgroundTransparency = 0
	panel.Size = UDim2.new(0, PANEL_W, 0, PANEL_H); panel.Position = UDim2.new(0.5, -PANEL_W/2, 0.2, 0)
	panel.Visible = false; panel.ClipsDescendants = true; panel.Active = true; panel.Parent = sg
	addCorner(panel, T.BigCorner); W.addStroke(panel)
	table.insert(_themed.panels, panel)
	-- Inventory uses a custom 3-layer background instead of the global sibling-overlay helper.
	-- Negative ZIndex on bg + image so default-ZIndex content (grid scroller, sidebar buttons,
	-- search input  -  anything that doesn't set ZIndex explicitly defaults to 1) still renders
	-- ON TOP without each content widget having to opt in. Layering, back to front:
	--   ImageLabel (ZIndex=-2)  -  BgImage at the very back.
	--   bg Frame   (ZIndex=-1)  -  theme color + (inverted) transparency. Sits IN FRONT of the
	--                  image so the image only shows through the bg's transparency.
	--   content    (ZIndex >= 1, defaults or explicit 10/25/50 etc.)
	local bg = Instance.new("Frame"); bg.Name = "Background"
	bg.BackgroundColor3 = T.PanelBg; bg.BackgroundTransparency = T.PanelAlpha
	bg.BorderSizePixel = 0; bg.Size = UDim2.new(1, 0, 1, 0); bg.Position = UDim2.new(0, 0, 0, 0)
	bg.ZIndex = -1; bg.Parent = panel
	table.insert(_themed.panels, bg)
	local bgImage = Instance.new("ImageLabel"); bgImage.Name = "PanelBackgroundImage"
	bgImage.BackgroundTransparency = 1; bgImage.BorderSizePixel = 0
	bgImage.AnchorPoint = Vector2.new(0.5, 0.5)
	bgImage.Position = UDim2.new(0.5, 0, 0.5, 0); bgImage.Size = UDim2.new(1, 0, 1, 0)
	bgImage.ZIndex = -2; bgImage.Image = T.BgImage or ""
	bgImage.ImageTransparency = T.BgImageTransparency or 1
	bgImage.ScaleType = Enum.ScaleType.Stretch; bgImage.Parent = panel
	table.insert(_themed.panelImages, bgImage)
	refs.InventoryPanel = panel
	W.makeResizable(panel, 600, 40)


	-- Header
	local header = Instance.new("Frame"); header.Name = "Header"; header.BackgroundTransparency = 1
	header.Size = UDim2.new(1, 0, 0, 22); header.Position = UDim2.new(0, 0, 0, 4); header.ZIndex = 10; header.Parent = panel
	local title = Instance.new("TextLabel"); title.BackgroundTransparency = 1; title.Text = "Inventory"
	title.TextColor3 = T.Gold; title.Font = T.Font; title.TextSize = 12
	title.TextXAlignment = Enum.TextXAlignment.Left; title.Size = UDim2.new(1, -28, 1, 0)
	title.Position = UDim2.new(0, 10, 0, 0); title.Parent = header
	local closeBtn = Instance.new("TextButton"); closeBtn.Name = "Close"; closeBtn.BackgroundTransparency = 1
	closeBtn.Text = "X"; closeBtn.TextColor3 = T.DarkGold; closeBtn.Font = T.Font; closeBtn.TextSize = 11
	closeBtn.Size = UDim2.new(0, 20, 1, 0); closeBtn.Position = UDim2.new(1, -24, 0, 0); closeBtn.ZIndex = 12; closeBtn.Parent = header
	refs.InventoryClose = closeBtn
	-- Drag handle
	local dragH = Instance.new("TextButton"); dragH.BackgroundTransparency = 1; dragH.Text = ""
	dragH.Size = UDim2.new(1, -28, 1, 0); dragH.ZIndex = 11; dragH.Parent = header
	W.makeDraggable(panel, dragH)

	local contentY = 28

	-- Search bar + result count + filter button
	local FILTER_W = 64; local SEARCH_GAP = 4
	local searchWrap = Instance.new("Frame"); searchWrap.Name = "Search"; searchWrap.BackgroundColor3 = T.BlobBg
	-- Proportional Size so the frame reflows when the panel resizes. Width =
	-- total - sidebar offset - filter button - gap - right margin.
	searchWrap.BackgroundTransparency = T.BlobAlpha
	searchWrap.Size = UDim2.new(1, -(SIDEBAR_W + 8 + FILTER_W + SEARCH_GAP + 8), 0, SEARCH_H)
	searchWrap.Position = UDim2.new(0, SIDEBAR_W + 8, 0, contentY); searchWrap.Parent = panel
	addCorner(searchWrap, UDim.new(0, 4)); W.addStroke(searchWrap); table.insert(_themed.blobs, searchWrap)
	local searchBox = Instance.new("TextBox"); searchBox.Name = "SearchBox"; searchBox.BackgroundTransparency = 1
	searchBox.PlaceholderText = "Search..."; searchBox.Text = ""; searchBox.TextColor3 = T.BrightGold
	searchBox.PlaceholderColor3 = T.DarkGold; searchBox.Font = T.Font; searchBox.TextSize = 11
	searchBox.ClearTextOnFocus = false; searchBox.Size = UDim2.new(1, -60, 1, 0); searchBox.Position = UDim2.new(0, 4, 0, 0)
	searchBox.TextXAlignment = Enum.TextXAlignment.Left; searchBox.Parent = searchWrap
	refs.InvSearch = searchBox
	local countLabel = Instance.new("TextLabel"); countLabel.Name = "ResultCount"; countLabel.BackgroundTransparency = 1
	countLabel.Text = ""; countLabel.TextColor3 = T.DarkGold; countLabel.Font = T.Font; countLabel.TextSize = 9
	countLabel.Size = UDim2.new(0, 52, 1, 0); countLabel.Position = UDim2.new(1, -54, 0, 0)
	countLabel.TextXAlignment = Enum.TextXAlignment.Right; countLabel.Parent = searchWrap
	refs.InvResultCount = countLabel
	-- Filter dropdown button (right of search bar)
	local filterBtn = Instance.new("TextButton"); filterBtn.Name = "FilterBtn"
	filterBtn.BackgroundColor3 = T.BlobBg; filterBtn.BackgroundTransparency = T.BlobAlpha
	filterBtn.Text = "Filters \u{25BC}"; filterBtn.TextColor3 = T.Gold; filterBtn.Font = T.Font; filterBtn.TextSize = 10
	filterBtn.Size = UDim2.new(0, FILTER_W, 0, SEARCH_H); filterBtn.BorderSizePixel = 0
	-- Anchor from the right edge so filterBtn reflows with the panel. filterBtn sits
	-- 8px from the right edge to match the trailing +8 in searchWrap's negative-
	-- offset calc, giving SEARCH_GAP between them.
	filterBtn.Position = UDim2.new(1, -(FILTER_W + 8), 0, contentY)
	filterBtn.Parent = panel; addCorner(filterBtn, UDim.new(0, 4)); W.addStroke(filterBtn); table.insert(_themed.blobs, filterBtn)
	refs.InvFilterBtn = filterBtn
	-- Filter dropdown list (hidden, positioned below button)  -  right-aligned with filterBtn.
	local FILTER_DROP_W = FILTER_W + 30
	local filterDrop = Instance.new("ScrollingFrame"); filterDrop.Name = "FilterDropdown"
	filterDrop.BackgroundColor3 = T.PanelBg; filterDrop.BackgroundTransparency = 0
	filterDrop.Size = UDim2.new(0, FILTER_DROP_W, 0, 180)
	filterDrop.Position = UDim2.new(1, -(FILTER_DROP_W + 8), 0, contentY + SEARCH_H + 2)
	filterDrop.Visible = false; filterDrop.ZIndex = 30; filterDrop.BorderSizePixel = 0
	filterDrop.ScrollBarThickness = 3; filterDrop.ScrollBarImageColor3 = T.ScrollBar
	filterDrop.CanvasSize = UDim2.new(0,0,0,0); filterDrop.AutomaticCanvasSize = Enum.AutomaticSize.Y
	filterDrop.Parent = panel; addCorner(filterDrop, UDim.new(0, 4)); W.addStroke(filterDrop)
	local fdl = Instance.new("UIListLayout"); fdl.Padding = UDim.new(0,1); fdl.SortOrder = Enum.SortOrder.LayoutOrder; fdl.Parent = filterDrop
	local fdp = Instance.new("UIPadding"); fdp.PaddingTop = UDim.new(0,2); fdp.PaddingBottom = UDim.new(0,2)
	fdp.PaddingLeft = UDim.new(0,2); fdp.PaddingRight = UDim.new(0,2); fdp.Parent = filterDrop
	filterDrop:SetAttribute("_opaquePanel", true)
	table.insert(_themed.panels, filterDrop); table.insert(_themed.scrollbars, filterDrop)
	refs.InvFilterDropdown = filterDrop

	-- Tabs (All / Static / Flipbook / Favs / Recent)
	local tabY = contentY + SEARCH_H + 4
	local tabFrame = Instance.new("Frame"); tabFrame.Name = "Tabs"; tabFrame.BackgroundTransparency = 1
	-- Proportional Size so tabs reflow on panel resize.
	tabFrame.Size = UDim2.new(1, -(SIDEBAR_W + 20), 0, TAB_H); tabFrame.Position = UDim2.new(0, SIDEBAR_W + 8, 0, tabY)
	tabFrame.Parent = panel
	local tl = Instance.new("UIListLayout"); tl.Padding = UDim.new(0, 3); tl.FillDirection = Enum.FillDirection.Horizontal
	tl.SortOrder = Enum.SortOrder.LayoutOrder; tl.Parent = tabFrame
	local function makeTab(name, text, lo)
		local b = Instance.new("TextButton"); b.Name = name; b.BackgroundColor3 = T.BlobBg
		b.BackgroundTransparency = T.BlobAlpha; b.Text = text; b.TextColor3 = T.MutedGold
		b.Font = T.Font; b.TextSize = 10; b.Size = UDim2.new(0, 55, 1, 0); b.LayoutOrder = lo
		b.BorderSizePixel = 0; b.AutoButtonColor = false; b.Parent = tabFrame; addCorner(b, UDim.new(0, 4))
		W.addStroke(b); table.insert(_themed.blobs, b); return b
	end
	refs.TabAll = makeTab("TabAll", "All", 0)
	refs.TabStatic = makeTab("TabStatic", "Static", 1)
	refs.TabFlipbook = makeTab("TabFlipbook", "Flipbook", 2)
	refs.TabFavourites = makeTab("TabFavourites", "\u{2605} Favs", 3)
	refs.TabRecents = makeTab("TabRecents", "Recent", 4)

	-- Sidebar (category list  -  collapsible sections built in wiring)
	local sidebarFrame = Instance.new("ScrollingFrame"); sidebarFrame.Name = "Sidebar"
	sidebarFrame.BackgroundColor3 = T.BlobBg; sidebarFrame.BackgroundTransparency = T.BlobAlpha
	-- Vertical proportional so sidebar height grows with the panel.
	sidebarFrame.Size = UDim2.new(0, SIDEBAR_W, 1, -(contentY + 32))
	sidebarFrame.Position = UDim2.new(0, 4, 0, contentY); sidebarFrame.BorderSizePixel = 0
	sidebarFrame.ScrollBarThickness = 3; sidebarFrame.ScrollBarImageColor3 = T.ScrollBar
	sidebarFrame.CanvasSize = UDim2.new(0, 0, 0, 0); sidebarFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
	sidebarFrame.Parent = panel; addCorner(sidebarFrame, UDim.new(0, 4)); W.addStroke(sidebarFrame)
	table.insert(_themed.blobs, sidebarFrame); table.insert(_themed.scrollbars, sidebarFrame)
	local sl = Instance.new("UIListLayout"); sl.Padding = UDim.new(0, 1); sl.SortOrder = Enum.SortOrder.LayoutOrder; sl.Parent = sidebarFrame
	local sp = Instance.new("UIPadding"); sp.PaddingTop = UDim.new(0, 3); sp.PaddingBottom = UDim.new(0, 3)
	sp.PaddingLeft = UDim.new(0, 2); sp.PaddingRight = UDim.new(0, 5); sp.Parent = sidebarFrame
	refs.InvSidebar = sidebarFrame
	-- Export/Import button pinned to bottom of sidebar area
	local eiBtn = Instance.new("TextButton"); eiBtn.Name = "ExportImport"
	eiBtn.BackgroundColor3 = T.BlobBg; eiBtn.BackgroundTransparency = T.BlobAlpha
	eiBtn.Text = "Export / Import"; eiBtn.TextColor3 = T.MutedGold; eiBtn.Font = T.Font; eiBtn.TextSize = 10
	eiBtn.Size = UDim2.new(0, SIDEBAR_W - 8, 0, 20); eiBtn.BorderSizePixel = 0
	eiBtn.AnchorPoint = Vector2.new(0, 1); eiBtn.Position = UDim2.new(0, 8, 1, -6)
	eiBtn.Parent = panel; addCorner(eiBtn, UDim.new(0, 4)); W.addStroke(eiBtn); table.insert(_themed.blobs, eiBtn)
	refs.InvExportImportBtn = eiBtn

	-- Action toolbar (context-sensitive buttons, shown for local modes)
	local toolY = tabY + TAB_H + 4
	local toolFrame = Instance.new("Frame"); toolFrame.Name = "Toolbar"; toolFrame.BackgroundTransparency = 1
	-- Proportional reflow on panel resize.
	toolFrame.Size = UDim2.new(1, -(SIDEBAR_W + 20), 0, TAB_H); toolFrame.Visible = false
	toolFrame.Position = UDim2.new(0, SIDEBAR_W + 8, 0, toolY); toolFrame.Parent = panel
	local ttl = Instance.new("UIListLayout"); ttl.Padding = UDim.new(0,3); ttl.FillDirection = Enum.FillDirection.Horizontal
	ttl.SortOrder = Enum.SortOrder.LayoutOrder; ttl.Parent = toolFrame
	local function makeToolBtn(name, text, lo)
		local b = Instance.new("TextButton"); b.Name = name; b.BackgroundColor3 = T.BlobBg; b.BackgroundTransparency = T.BlobAlpha
		b.Text = text; b.TextColor3 = T.MutedGold; b.Font = T.Font; b.TextSize = 10
		b.Size = UDim2.new(0, 0, 1, 0); b.AutomaticSize = Enum.AutomaticSize.X
		b.LayoutOrder = lo; b.BorderSizePixel = 0; b.Parent = toolFrame; addCorner(b, UDim.new(0,4))
		local tbp = Instance.new("UIPadding"); tbp.PaddingLeft = UDim.new(0,6); tbp.PaddingRight = UDim.new(0,6); tbp.Parent = b
		W.addStroke(b); table.insert(_themed.blobs, b); return b
	end
	refs.InvToolbar = toolFrame
	refs.InvToolImport = makeToolBtn("Import", "Import Selected", 0)
	-- Import options arrow (opens dropdown with Bundle/Paths toggles)
	local impArrow = Instance.new("TextButton"); impArrow.Name = "ImportArrow"
	impArrow.BackgroundColor3 = T.BlobBg; impArrow.BackgroundTransparency = T.BlobAlpha
	impArrow.Text = "\u{25BC}"; impArrow.TextColor3 = T.MutedGold; impArrow.Font = T.Font; impArrow.TextSize = 8
	impArrow.Size = UDim2.new(0, 16, 1, 0); impArrow.LayoutOrder = 1; impArrow.BorderSizePixel = 0; impArrow.Parent = toolFrame
	addCorner(impArrow, UDim.new(0, 4)); W.addStroke(impArrow); table.insert(_themed.blobs, impArrow)
	refs.InvImportArrow = impArrow
	-- Import options dropdown (parented to panel, not toolbar, so it renders above grid)
	local impDrop = Instance.new("Frame"); impDrop.Name = "ImportDropdown"; impDrop.BackgroundColor3 = T.PanelBg
	impDrop.BackgroundTransparency = 0; impDrop.Size = UDim2.new(0, 180, 0, 0); impDrop.AutomaticSize = Enum.AutomaticSize.Y
	impDrop.Position = UDim2.new(0, SIDEBAR_W + 8, 0, 0); impDrop.ZIndex = 50 -- Y set dynamically by wiring
	impDrop.Active = true; impDrop.Visible = false; impDrop.Parent = panel
	impDrop:SetAttribute("_opaquePanel", true) -- exclude from panel transparency
	addCorner(impDrop, UDim.new(0, 4)); W.addStroke(impDrop); table.insert(_themed.panels, impDrop)
	local idly = Instance.new("UIListLayout"); idly.Padding = UDim.new(0, 1); idly.SortOrder = Enum.SortOrder.LayoutOrder; idly.Parent = impDrop
	local idpad = Instance.new("UIPadding"); idpad.PaddingLeft = UDim.new(0, 4); idpad.PaddingRight = UDim.new(0, 4)
	idpad.PaddingTop = UDim.new(0, 4); idpad.PaddingBottom = UDim.new(0, 4); idpad.Parent = impDrop
	local function makeImportOpt(name, text, lo)
		local o = Instance.new("TextButton"); o.Name = name; o.BackgroundColor3 = T.BlobBg
		o.BackgroundTransparency = T.BlobAlpha; o.Text = text; o.TextColor3 = T.MutedGold
		o.Font = T.Font; o.TextSize = 10; o.Size = UDim2.new(1, 0, 0, 20); o.LayoutOrder = lo
		o.TextXAlignment = Enum.TextXAlignment.Left; o.BorderSizePixel = 0; o.ZIndex = 51; o.Parent = impDrop
		addCorner(o, UDim.new(0, 3)); table.insert(_themed.blobs, o)
		local op = Instance.new("UIPadding"); op.PaddingLeft = UDim.new(0, 6); op.Parent = o; return o
	end
	refs.InvOptBundle = makeImportOpt("Bundle", "\u{2610} Bundle (import as one)", 0)
	refs.InvOptPaths = makeImportOpt("Paths", "\u{2610} Paths (save locations)", 1)
	refs.InvImportDropdown = impDrop
	refs.InvToolUpload = makeToolBtn("Upload", "Upload", 2)
	refs.InvToolDissect = makeToolBtn("Dissect", "Dissect", 3)
	-- Thumbnail grid
	local gridY = toolY + 24; local gridFrame = Instance.new("ScrollingFrame"); gridFrame.Name = "Grid"
	gridFrame.BackgroundTransparency = 1; gridFrame.BorderSizePixel = 0
	-- Proportional reflow  -  grid stretches with panel for both width AND height.
	gridFrame.Size = UDim2.new(1, -(SIDEBAR_W + 20), 1, -(gridY + 8))
	gridFrame.Position = UDim2.new(0, SIDEBAR_W + 8, 0, gridY)
	gridFrame.ScrollBarThickness = 4; gridFrame.ScrollBarImageColor3 = T.ScrollBar
	gridFrame.CanvasSize = UDim2.new(0, 0, 0, 0) -- managed by wiring (virtualized)
	gridFrame.Parent = panel; gridFrame.ClipsDescendants = true
	local gp = Instance.new("UIPadding"); gp.PaddingLeft = UDim.new(0,3); gp.PaddingTop = UDim.new(0,20); gp.Parent = gridFrame
	table.insert(_themed.scrollbars, gridFrame)
	refs.InvGrid = gridFrame

	-- Loading/error state (centered in grid area)
	local loadFrame = Instance.new("Frame"); loadFrame.Name = "LoadingState"; loadFrame.BackgroundTransparency = 1
	loadFrame.Size = UDim2.new(1, 0, 0, 60); loadFrame.Position = UDim2.new(0, 0, 0.3, 0); loadFrame.Parent = gridFrame
	local loadLabel = Instance.new("TextLabel"); loadLabel.Name = "LoadLabel"; loadLabel.BackgroundTransparency = 1
	loadLabel.Text = "Loading textures..."; loadLabel.TextColor3 = T.DarkGold; loadLabel.Font = T.Font; loadLabel.TextSize = 11
	loadLabel.Size = UDim2.new(1, 0, 0, 16); loadLabel.Parent = loadFrame
	local errorLabel = Instance.new("TextLabel"); errorLabel.Name = "ErrorLabel"; errorLabel.BackgroundTransparency = 1
	errorLabel.Text = ""; errorLabel.TextColor3 = T.Red; errorLabel.Font = T.BodyFont; errorLabel:SetAttribute("_noFontOverride", true); errorLabel.TextSize = 9
	errorLabel.TextWrapped = true; errorLabel.Size = UDim2.new(1, -16, 0, 20); errorLabel.Position = UDim2.new(0, 8, 0, 18)
	errorLabel.Visible = false; errorLabel.Parent = loadFrame
	local retryBtn = Instance.new("TextButton"); retryBtn.Name = "Retry"; retryBtn.BackgroundColor3 = T.BlobBg
	retryBtn.BackgroundTransparency = T.BlobAlpha; retryBtn.Text = "Retry"; retryBtn.TextColor3 = T.Gold
	retryBtn.Font = T.Font; retryBtn.TextSize = 10; retryBtn.Size = UDim2.new(0, 60, 0, 20)
	retryBtn.AnchorPoint = Vector2.new(0.5, 0); retryBtn.Position = UDim2.new(0.5, 0, 0, 40)
	retryBtn.BorderSizePixel = 0; retryBtn.Visible = false; retryBtn.Parent = loadFrame
	addCorner(retryBtn, UDim.new(0, 4)); W.addStroke(retryBtn); table.insert(_themed.blobs, retryBtn)
	refs.InvLoadingFrame = loadFrame
	refs.InvLoadingLabel = loadLabel
	refs.InvErrorLabel = errorLabel
	refs.InvRetryBtn = retryBtn

	-- Hover tooltip (shared, auto-sized, repositioned on hover)
	local tooltip = Instance.new("TextLabel"); tooltip.Name = "Tooltip"
	tooltip.BackgroundColor3 = T.PanelBg; tooltip.BackgroundTransparency = 0.1
	tooltip.TextColor3 = T.BrightGold; tooltip.Font = T.BodyFont; tooltip:SetAttribute("_noFontOverride", true); tooltip.TextSize = 9
	tooltip.AutomaticSize = Enum.AutomaticSize.X; tooltip.TextWrapped = false
	tooltip.Size = UDim2.new(0, 0, 0, 14); tooltip.MaxVisibleGraphemes = -1
	tooltip.Visible = false; tooltip.ZIndex = 25; tooltip.Parent = panel
	addCorner(tooltip, UDim.new(0, 3)); W.addStroke(tooltip); table.insert(_themed.panels, tooltip)
	local ttp = Instance.new("UIPadding"); ttp.PaddingLeft = UDim.new(0,4); ttp.PaddingRight = UDim.new(0,4); ttp.Parent = tooltip
	local ttc = Instance.new("UISizeConstraint"); ttc.MaxSize = Vector2.new(140, 14); ttc.Parent = tooltip
	refs.InvTooltip = tooltip

	-- =========================================================
	-- DETAIL SIDE PANEL (separate panel, parented to ScreenGui)
	-- =========================================================
	local DETAIL_PANEL_W = 200
	local detail = Instance.new("Frame"); detail.Name = "InvDetailPanel"
	detail.BackgroundColor3 = T.PanelBg; detail.BackgroundTransparency = 0
	detail.Size = UDim2.new(0, DETAIL_PANEL_W, 0, PANEL_H)
	detail.Visible = false
	detail.ClipsDescendants = true; detail.Parent = sg
	addCorner(detail, T.BigCorner); W.addStroke(detail); table.insert(_themed.panels, detail)
	local dp = Instance.new("UIPadding"); dp.PaddingLeft = UDim.new(0, 8); dp.PaddingRight = UDim.new(0, 8)
	dp.PaddingTop = UDim.new(0, 4); dp.PaddingBottom = UDim.new(0, 8); dp.Parent = detail
	refs.InvDetail = detail

	-- Detail header (draggable)
	local dHeader = Instance.new("Frame"); dHeader.Name = "Header"; dHeader.BackgroundTransparency = 1
	dHeader.Size = UDim2.new(1, 0, 0, 20); dHeader.Parent = detail
	local dTitle = Instance.new("TextLabel"); dTitle.BackgroundTransparency = 1; dTitle.Text = "Details"
	dTitle.TextColor3 = T.Gold; dTitle.Font = T.Font; dTitle.TextSize = 11
	dTitle.TextXAlignment = Enum.TextXAlignment.Left; dTitle.Size = UDim2.new(0, 44, 1, 0)
	dTitle.Position = UDim2.new(0, 2, 0, 0); dTitle.Parent = dHeader
	local favBtn = Instance.new("TextButton"); favBtn.Name = "Favourite"
	favBtn.BackgroundColor3 = T.BlobBg; favBtn.BackgroundTransparency = T.BlobAlpha
	favBtn.Text = "Favourite"; favBtn.TextColor3 = T.MutedGold
	favBtn.Font = T.Font; favBtn.TextSize = 10; favBtn.Size = UDim2.new(0, 64, 0, 16)
	favBtn.Position = UDim2.new(0, 48, 0, 2); favBtn.BorderSizePixel = 0; favBtn.Parent = dHeader
	addCorner(favBtn, UDim.new(0, 4)); W.addStroke(favBtn); table.insert(_themed.blobs, favBtn)
	refs.InvFavBtn = favBtn
	local detailClose = Instance.new("TextButton"); detailClose.Name = "DetailClose"
	detailClose.BackgroundTransparency = 1; detailClose.Text = "X"; detailClose.TextColor3 = T.DarkGold
	detailClose.Font = T.Font; detailClose.TextSize = 10; detailClose.Size = UDim2.new(0, 16, 0, 16)
	detailClose.Position = UDim2.new(1, -16, 0, 0); detailClose.Parent = dHeader
	refs.InvDetailClose = detailClose

	-- Scrolling content area (between header and bottom buttons)
	local dContent = Instance.new("ScrollingFrame"); dContent.Name = "Content"
	dContent.BackgroundTransparency = 1; dContent.BorderSizePixel = 0
	dContent.Position = UDim2.new(0, 0, 0, 24); dContent.Size = UDim2.new(1, 0, 1, -74)
	dContent.ScrollBarThickness = 4; dContent.ScrollingDirection = Enum.ScrollingDirection.Y
	dContent.CanvasSize = UDim2.new(0, 0, 0, 0); dContent.AutomaticCanvasSize = Enum.AutomaticSize.Y
	dContent.ScrollBarImageColor3 = T.DarkGold; dContent.Parent = detail

	-- Detail preview image (centered, square)  -  inside scrolling content
	local prevSize = DETAIL_PANEL_W - 24
	local prevImg = Instance.new("ImageLabel"); prevImg.Name = "Preview"
	prevImg.BackgroundTransparency = 1; prevImg.Size = UDim2.new(0, prevSize, 0, prevSize)
	prevImg.AnchorPoint = Vector2.new(0.5, 0); prevImg.Position = UDim2.new(0.5, 0, 0, 0)
	prevImg.BorderSizePixel = 0; prevImg.ScaleType = Enum.ScaleType.Fit; prevImg.Parent = dContent
	addCorner(prevImg, UDim.new(0,4)); refs.InvDetailPreview = prevImg
	-- Asset ViewportFrame (overlays same area, hidden by default)
	local avpf = Instance.new("ViewportFrame"); avpf.Name = "AssetViewport"
	avpf.BackgroundColor3 = T.PanelBg; avpf.Size = UDim2.new(0,prevSize,0,prevSize); avpf.BorderSizePixel = 0
	avpf.AnchorPoint = Vector2.new(0.5,0); avpf.Position = UDim2.new(0.5,0,0,0)
	avpf.Ambient = Color3.new(0.5,0.5,0.5); avpf.LightColor = Color3.new(1,1,1)
	avpf.LightDirection = Vector3.new(-1,-1,-1); avpf.Visible = false; avpf.Parent = dContent
	addCorner(avpf, UDim.new(0,4)); table.insert(_themed.panels, avpf); refs.InvAssetViewport = avpf

	-- Detail info rows (below preview, inside scrolling content)
	local infoY = prevSize + 6
	local function makeInfoRow(name, labelText, y)
		local lbl = Instance.new("TextLabel"); lbl.Name = name.."Label"; lbl.BackgroundTransparency = 1
		lbl.Text = labelText; lbl.TextColor3 = T.MutedGold; lbl.Font = T.Font; lbl.TextSize = 9
		lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Size = UDim2.new(1, 0, 0, 11)
		lbl.Position = UDim2.new(0, 0, 0, y); lbl.Parent = dContent
		local val = Instance.new("TextLabel"); val.Name = name; val.BackgroundTransparency = 1
		val.Text = ""; val.TextColor3 = T.BrightGold; val.Font = T.Font; val.TextSize = 10
		val.TextXAlignment = Enum.TextXAlignment.Left; val.TextWrapped = true
		-- AutomaticSize.Y so wrapped multi-line values aren't clipped at a fixed 13px
		-- height  -  long names need to grow into a second line.
		val.Size = UDim2.new(1, 0, 0, 13); val.AutomaticSize = Enum.AutomaticSize.Y
		val.Position = UDim2.new(0, 0, 0, y + 11)
		val.Parent = dContent
		return val, lbl
	end
	-- Name row: TextBox (editable for local entries, read-only for remote)
	local nameLbl = Instance.new("TextLabel"); nameLbl.Name = "NameLabel"; nameLbl.BackgroundTransparency = 1
	nameLbl.Text = "Name"; nameLbl.TextColor3 = T.MutedGold; nameLbl.Font = T.Font; nameLbl.TextSize = 9
	nameLbl.TextXAlignment = Enum.TextXAlignment.Left; nameLbl.Size = UDim2.new(1,0,0,11)
	nameLbl.Position = UDim2.new(0,0,0,infoY); nameLbl.Parent = dContent
	local nameEditIcon = Instance.new("TextLabel"); nameEditIcon.Name = "EditIcon"; nameEditIcon.BackgroundTransparency = 1
	nameEditIcon.Text = "\u{270F}"; nameEditIcon.TextColor3 = T.DarkGold; nameEditIcon.Font = T.Font; nameEditIcon.TextSize = 9
	nameEditIcon.Size = UDim2.new(0,12,0,11); nameEditIcon.Position = UDim2.new(0,30,0,infoY)
	nameEditIcon.Visible = false; nameEditIcon.Parent = dContent
	refs.InvDetailEditIcon = nameEditIcon
	local nameVal = Instance.new("TextBox"); nameVal.Name = "Name"; nameVal.BackgroundTransparency = 1
	nameVal.Text = ""; nameVal.TextColor3 = T.BrightGold; nameVal.Font = T.Font; nameVal.TextSize = 10
	nameVal.TextXAlignment = Enum.TextXAlignment.Left; nameVal.TextWrapped = true
	nameVal.TextEditable = false; nameVal.ClearTextOnFocus = false
	nameVal.Size = UDim2.new(1,0,0,13); nameVal.Position = UDim2.new(0,0,0,infoY+11)
	nameVal.BorderSizePixel = 0; nameVal.Parent = dContent
	refs.InvDetailName = nameVal
	-- ID row: use TextBox so user can select + Ctrl+C
	local idLbl = Instance.new("TextLabel"); idLbl.Name = "IDLabel"; idLbl.BackgroundTransparency = 1
	idLbl.Text = "ID"; idLbl.TextColor3 = T.MutedGold; idLbl.Font = T.Font; idLbl.TextSize = 9
	idLbl.TextXAlignment = Enum.TextXAlignment.Left; idLbl.Size = UDim2.new(1, 0, 0, 11)
	idLbl.Position = UDim2.new(0, 0, 0, infoY + 26); idLbl.Parent = dContent
	local idVal = Instance.new("TextBox"); idVal.Name = "ID"; idVal.BackgroundTransparency = 1
	idVal.Text = ""; idVal.TextColor3 = T.BrightGold; idVal.Font = T.Font; idVal.TextSize = 10
	idVal.TextXAlignment = Enum.TextXAlignment.Left; idVal.TextEditable = false; idVal.ClearTextOnFocus = false
	idVal.Size = UDim2.new(1, -42, 0, 13); idVal.Position = UDim2.new(0, 0, 0, infoY + 37)
	idVal.Parent = dContent
	refs.InvDetailID = idVal; refs.InvDetailIDLabel = idLbl
	local kwVal, kwLbl = makeInfoRow("Keywords", "Keywords", infoY + 56)
	refs.InvDetailKeywords = kwVal; refs.InvDetailKeywordsLabel = kwLbl
	refs.InvDetailInfo = makeInfoRow("Info", "Info", infoY + 82)

	-- Grid row: editable TextBox (only shown for texture entries)
	local gridLbl = Instance.new("TextLabel"); gridLbl.Name = "GridLabel"; gridLbl.BackgroundTransparency = 1
	gridLbl.Text = "Grid"; gridLbl.TextColor3 = T.MutedGold; gridLbl.Font = T.Font; gridLbl.TextSize = 9
	gridLbl.TextXAlignment = Enum.TextXAlignment.Left; gridLbl.Size = UDim2.new(1,0,0,11)
	gridLbl.Position = UDim2.new(0,0,0,infoY + 108); gridLbl.Parent = dContent
	local gridVal = Instance.new("TextBox"); gridVal.Name = "Grid"; gridVal.BackgroundTransparency = 1
	gridVal.Text = ""; gridVal.TextColor3 = T.BrightGold; gridVal.Font = T.Font; gridVal.TextSize = 10
	gridVal.TextXAlignment = Enum.TextXAlignment.Left; gridVal.PlaceholderText = "e.g. 8 for 8x8"
	gridVal.PlaceholderColor3 = T.DarkGold; gridVal.TextEditable = false; gridVal.ClearTextOnFocus = false
	gridVal.Size = UDim2.new(1,0,0,13); gridVal.Position = UDim2.new(0,0,0,infoY + 119)
	gridVal.BorderSizePixel = 0; gridVal.Parent = dContent
	refs.InvDetailGrid = gridVal; refs.InvDetailGridLabel = gridLbl

	-- Copy ID button (adjacent to ID value)
	local copyIdBtn = Instance.new("TextButton"); copyIdBtn.Name = "CopyID"
	copyIdBtn.BackgroundColor3 = T.BlobBg; copyIdBtn.BackgroundTransparency = T.BlobAlpha
	copyIdBtn.Text = "Copy"; copyIdBtn.TextColor3 = T.MutedGold; copyIdBtn.Font = T.Font; copyIdBtn.TextSize = 9
	copyIdBtn.Size = UDim2.new(0, 36, 0, 13); copyIdBtn.Position = UDim2.new(1, -40, 0, infoY + 37)
	copyIdBtn.BorderSizePixel = 0; copyIdBtn.Parent = dContent
	addCorner(copyIdBtn, UDim.new(0, 3)); W.addStroke(copyIdBtn); table.insert(_themed.blobs, copyIdBtn)
	refs.InvCopyIdBtn = copyIdBtn

	-- Buttons (bottom: trust → delete → insert)
	-- Trust Asset button: clears ImportedUntrusted on every event of every Studio-selected
	-- transformed item. Visible only for Asset entries (other inventory types have no events).
	local trustBtn = Instance.new("TextButton"); trustBtn.Name = "TrustAsset"
	trustBtn.BackgroundColor3 = T.BlobBg; trustBtn.BackgroundTransparency = T.BlobAlpha
	trustBtn.Text = "Trust Asset"; trustBtn.TextColor3 = T.Gold; trustBtn.Font = T.Font; trustBtn.TextSize = 10
	trustBtn.Size = UDim2.new(1, 0, 0, 22); trustBtn.Position = UDim2.new(0, 0, 1, -76)
	trustBtn.BorderSizePixel = 0; trustBtn.Visible = false; trustBtn.Parent = detail
	addCorner(trustBtn, UDim.new(0, 4)); W.addStroke(trustBtn); table.insert(_themed.blobs, trustBtn)
	refs.InvTrustBtn = trustBtn

	-- Delete button (for custom/local entries, hidden by default)
	local deleteBtn = Instance.new("TextButton"); deleteBtn.Name = "Delete"
	deleteBtn.BackgroundColor3 = T.BlobBg; deleteBtn.BackgroundTransparency = T.BlobAlpha
	deleteBtn.Text = "Delete"; deleteBtn.TextColor3 = T.Red; deleteBtn.Font = T.Font; deleteBtn.TextSize = 10
	deleteBtn.Size = UDim2.new(1, 0, 0, 22); deleteBtn.Position = UDim2.new(0, 0, 1, -50)
	deleteBtn.BorderSizePixel = 0; deleteBtn.Visible = false; deleteBtn.Parent = detail
	addCorner(deleteBtn, UDim.new(0, 4)); W.addStroke(deleteBtn); table.insert(_themed.blobs, deleteBtn)
	refs.InvDeleteBtn = deleteBtn

	local insertBtn = Instance.new("TextButton"); insertBtn.Name = "Insert"
	insertBtn.BackgroundColor3 = T.Green; insertBtn.Text = "Insert"
	insertBtn.TextColor3 = Color3.new(1, 1, 1); insertBtn.Font = T.Font; insertBtn.TextSize = 11
	insertBtn.Size = UDim2.new(1, 0, 0, 22); insertBtn.Position = UDim2.new(0, 0, 1, -24)
	insertBtn.BorderSizePixel = 0; insertBtn.Parent = detail
	addCorner(insertBtn, UDim.new(0, 4)); W.addStroke(insertBtn)
	refs.InvInsertBtn = insertBtn

	-- Add Texture dialog (small overlay on main panel)
	local addDialog = Instance.new("Frame"); addDialog.Name = "AddTextureDialog"
	addDialog.BackgroundColor3 = T.PanelBg; addDialog.BackgroundTransparency = 0
	addDialog.Size = UDim2.new(0, 220, 0, 100); addDialog.AnchorPoint = Vector2.new(0.5, 0.5)
	addDialog.Position = UDim2.new(0.5, 0, 0.5, 0); addDialog.Visible = false; addDialog.ZIndex = 28
	addDialog.Parent = panel; addCorner(addDialog, T.BigCorner); W.addStroke(addDialog)
	addDialog:SetAttribute("_opaquePanel", true) -- modal stays opaque vs global panel translucency
	table.insert(_themed.panels, addDialog)
	local adp = Instance.new("UIPadding"); adp.PaddingLeft = UDim.new(0,8); adp.PaddingRight = UDim.new(0,8)
	adp.PaddingTop = UDim.new(0,6); adp.PaddingBottom = UDim.new(0,6); adp.Parent = addDialog
	local adTitle = Instance.new("TextLabel"); adTitle.BackgroundTransparency = 1
	adTitle.Text = "Add Custom Texture"; adTitle.TextColor3 = T.Gold; adTitle.Font = T.Font; adTitle.TextSize = 10
	adTitle.Size = UDim2.new(1,0,0,14); adTitle.TextXAlignment = Enum.TextXAlignment.Left; adTitle.Parent = addDialog
	local adIdBox = Instance.new("TextBox"); adIdBox.Name = "IdBox"; adIdBox.BackgroundColor3 = T.BlobBg
	adIdBox.BackgroundTransparency = T.BlobAlpha; adIdBox.PlaceholderText = "Asset ID (numbers only)"
	adIdBox.PlaceholderColor3 = T.DarkGold; adIdBox.TextColor3 = T.BrightGold; adIdBox.Font = T.Font
	adIdBox.TextSize = 10; adIdBox.ClearTextOnFocus = false; adIdBox.Text = ""
	adIdBox.Size = UDim2.new(1,0,0,20); adIdBox.Position = UDim2.new(0,0,0,18); adIdBox.ZIndex = 29
	adIdBox.Parent = addDialog; addCorner(adIdBox, UDim.new(0,4)); W.addStroke(adIdBox); table.insert(_themed.blobs, adIdBox)
	local adNameBox = Instance.new("TextBox"); adNameBox.Name = "NameBox"; adNameBox.BackgroundColor3 = T.BlobBg
	adNameBox.BackgroundTransparency = T.BlobAlpha; adNameBox.PlaceholderText = "Name (optional)"
	adNameBox.PlaceholderColor3 = T.DarkGold; adNameBox.TextColor3 = T.BrightGold; adNameBox.Font = T.Font
	adNameBox.TextSize = 10; adNameBox.ClearTextOnFocus = false; adNameBox.Text = ""
	adNameBox.Size = UDim2.new(1,0,0,20); adNameBox.Position = UDim2.new(0,0,0,42); adNameBox.ZIndex = 29
	adNameBox.Parent = addDialog; addCorner(adNameBox, UDim.new(0,4)); W.addStroke(adNameBox); table.insert(_themed.blobs, adNameBox)
	local adAddBtn = Instance.new("TextButton"); adAddBtn.Name = "Confirm"
	adAddBtn.BackgroundColor3 = T.Green; adAddBtn.Text = "Add"; adAddBtn.TextColor3 = Color3.new(1,1,1)
	adAddBtn.Font = T.Font; adAddBtn.TextSize = 10; adAddBtn.Size = UDim2.new(0.48,0,0,20)
	adAddBtn.Position = UDim2.new(0,0,0,66); adAddBtn.BorderSizePixel = 0; adAddBtn.ZIndex = 29
	adAddBtn.Parent = addDialog; addCorner(adAddBtn, UDim.new(0,4)); W.addStroke(adAddBtn)
	local adCancelBtn = Instance.new("TextButton"); adCancelBtn.Name = "Cancel"
	adCancelBtn.BackgroundColor3 = T.BlobBg; adCancelBtn.BackgroundTransparency = T.BlobAlpha
	adCancelBtn.Text = "Cancel"; adCancelBtn.TextColor3 = T.MutedGold; adCancelBtn.Font = T.Font
	adCancelBtn.TextSize = 10; adCancelBtn.Size = UDim2.new(0.48,0,0,20)
	adCancelBtn.Position = UDim2.new(0.52,0,0,66); adCancelBtn.BorderSizePixel = 0; adCancelBtn.ZIndex = 29
	adCancelBtn.Parent = addDialog; addCorner(adCancelBtn, UDim.new(0,4)); W.addStroke(adCancelBtn); table.insert(_themed.blobs, adCancelBtn)
	refs.InvAddDialog = addDialog; refs.InvAddIdBox = adIdBox; refs.InvAddNameBox = adNameBox
	refs.InvAddConfirmBtn = adAddBtn; refs.InvAddCancelBtn = adCancelBtn

	-- Import + Dissect dialogs (separate panels)
	for k, v in pairs(require(script.Parent.InventoryImportDialog).build(sg)) do refs[k] = v end
	for k, v in pairs(require(script.Parent.InventoryDissectDialog).build(sg)) do refs[k] = v end
	-- Flipbook name prompt (for Upload in local_flipbooks mode)
	local fbBackdrop = Instance.new("TextButton"); fbBackdrop.Name = "FBNameBackdrop"
	fbBackdrop.BackgroundColor3 = Color3.new(0,0,0); fbBackdrop.BackgroundTransparency = 0.7
	fbBackdrop.Text = ""; fbBackdrop.AutoButtonColor = false; fbBackdrop.Size = UDim2.new(1,0,1,0)
	fbBackdrop.ZIndex = 49; fbBackdrop.Visible = false; fbBackdrop.Parent = sg; fbBackdrop.BorderSizePixel = 0
	local fbDialog = Instance.new("Frame"); fbDialog.Name = "FBNameDialog"
	fbDialog.BackgroundColor3 = T.PanelBg; fbDialog.BackgroundTransparency = 0
	fbDialog.Size = UDim2.new(0,220,0,90); fbDialog.AnchorPoint = Vector2.new(0.5,0.5)
	fbDialog.Position = UDim2.new(0.5,0,0.5,0); fbDialog.Visible = false; fbDialog.ZIndex = 50
	fbDialog:SetAttribute("_noSnap", true); fbDialog.Parent = sg
	fbDialog:SetAttribute("_opaquePanel", true) -- modal stays opaque vs global panel translucency
	addCorner(fbDialog, T.BigCorner); W.addStroke(fbDialog); table.insert(_themed.panels, fbDialog)
	local fbPad = Instance.new("UIPadding"); fbPad.PaddingLeft=UDim.new(0,8); fbPad.PaddingRight=UDim.new(0,8)
	fbPad.PaddingTop=UDim.new(0,6); fbPad.PaddingBottom=UDim.new(0,6); fbPad.Parent = fbDialog
	local fbLbl = Instance.new("TextLabel"); fbLbl.BackgroundTransparency = 1; fbLbl.Text = "Flipbook Name:"
	fbLbl.TextColor3 = T.Gold; fbLbl.Font = T.Font; fbLbl.TextSize = 11; fbLbl.TextXAlignment = Enum.TextXAlignment.Left
	fbLbl.Size = UDim2.new(1,0,0,16); fbLbl.ZIndex = 51; fbLbl.Parent = fbDialog
	local fbDrag = Instance.new("TextButton"); fbDrag.BackgroundTransparency = 1; fbDrag.Text = ""
	fbDrag.Size = UDim2.new(1,0,0,16); fbDrag.ZIndex = 51; fbDrag.Parent = fbDialog; W.makeDraggable(fbDialog, fbDrag)
	local fbInput = Instance.new("TextBox"); fbInput.Name = "FBNameInput"
	fbInput.BackgroundColor3 = T.BlobBg; fbInput.BackgroundTransparency = T.BlobAlpha
	fbInput.TextColor3 = T.BrightGold; fbInput.Font = T.Font; fbInput.TextSize = 11; fbInput.Text = ""
	fbInput.ClearTextOnFocus = false; fbInput.Size = UDim2.new(1,0,0,22); fbInput.Position = UDim2.new(0,0,0,20)
	fbInput.BorderSizePixel = 0; fbInput.ZIndex = 51; fbInput.Parent = fbDialog
	addCorner(fbInput, UDim.new(0,4)); table.insert(_themed.blobs, fbInput)
	local fbOk = Instance.new("TextButton"); fbOk.Name = "FBNameOK"; fbOk.BackgroundColor3 = T.BlobBg
	fbOk.BackgroundTransparency = T.BlobAlpha; fbOk.Text = "OK"; fbOk.TextColor3 = T.Green; fbOk.Font = T.Font
	fbOk.TextSize = 10; fbOk.Size = UDim2.new(0.48,0,0,22); fbOk.Position = UDim2.new(0,0,0,48)
	fbOk.BorderSizePixel = 0; fbOk.ZIndex = 51; fbOk.Parent = fbDialog
	addCorner(fbOk, UDim.new(0,4)); W.addStroke(fbOk); table.insert(_themed.blobs, fbOk)
	local fbCancel = Instance.new("TextButton"); fbCancel.Name = "FBNameCancel"; fbCancel.BackgroundColor3 = T.BlobBg
	fbCancel.BackgroundTransparency = T.BlobAlpha; fbCancel.Text = "Cancel"; fbCancel.TextColor3 = T.DarkGold
	fbCancel.Font = T.Font; fbCancel.TextSize = 10; fbCancel.Size = UDim2.new(0.48,0,0,22)
	fbCancel.Position = UDim2.new(0.52,0,0,48); fbCancel.BorderSizePixel = 0; fbCancel.ZIndex = 51
	fbCancel.Parent = fbDialog; addCorner(fbCancel, UDim.new(0,4)); W.addStroke(fbCancel); table.insert(_themed.blobs, fbCancel)
	refs.FBNameBackdrop = fbBackdrop; refs.FBNameDialog = fbDialog
	refs.FBNameInput = fbInput; refs.FBNameOK = fbOk; refs.FBNameCancel = fbCancel

	return refs
end

return InventoryPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">RandomizerPanel</string>
              <string name="Source"><![CDATA[--[[
	RandomizerPanel  -  Part-Icles V5 Randomizer System
	Copyright (C) 2026 Qwinkle

	Modal panel scaffolding:
	  - panel frame with title + close button
	  - section list (populated by RandomizerWiring.populateSections)
	  - Roll / Apply / Cancel button row

	Layout:
	  [Randomize Panel  -  modal]
	  [tristate checkbox tree of randomizable properties + Group axes / palette toggles]
	  [Roll]   [Apply]   [Cancel]

	Snapshot-preview-apply flow (handled in RandomizerWiring):
	  Open  -> QOL.snapshotItem per item
	  Roll  -> per-item per-prop derive() + roll() + RandomizerWriter.write()
	  Apply -> ChangeHistory waypoint, drop snapshots
	  Cancel -> QOL.restoreSnapshots(snapshots), close
]]

local C = require(script.Parent.Constants)
local W = require(script.Parent.Widgets)
local T = C.T

local RandomizerPanel = {}

-- Build the modal panel frame. Returns refs map: {panel, sectionList, rollAllBtn,
-- applyBtn, cancelBtn, headerCloseBtn}. headerCloseBtn is W.makeToolPanel's built-in
-- `Hd.Close` (re-exposed here so wiring can attach a Cancel handler  -  every close
-- path must route through wiring.cancel() to restore preview snapshots). Caller
-- wires the buttons via the RandomizerWiring companion module.
function RandomizerPanel.build(sg)
	-- Modal panel ~ same dimensions as InventoryPanel for visual consistency. _opaquePanel
	-- so it stays opaque when global panel translucency is set; _noSnap so it doesn't
	-- participate in resolveOverlap (modal-positioned in front of Properties panel).
	-- 220px width: rows are simple (label blob + toggle); 220 fits the longest prop
	-- names (e.g. "AccelerationTowardsInstance") with truncation as fallback.
	local panel = W.makeToolPanel(sg, "Randomize", 220, 400)
	panel:SetAttribute("_opaquePanel", true)
	panel:SetAttribute("_noSnap", true)
	panel.Visible = false  -- toolbar toggle controls visibility

	local refs = {panel = panel}

	-- W.makeToolPanel already installs an `Hd.Close` button that hides the panel via
	-- `panel.Visible = false`. We expose it as `headerCloseBtn` so the wiring layer
	-- can attach its own Cancel handler  -  ALL close paths must route through
	-- wiring.cancel() to restore preview snapshots.
	local hd = panel:FindFirstChild("Hd")
	if hd then refs.headerCloseBtn = hd:FindFirstChild("Close") end

	-- Section list (scrolling). Populated by RandomizerWiring.populateSections.
	local sectionList = Instance.new("ScrollingFrame")
	sectionList.Name = "SectionList"
	sectionList.BackgroundTransparency = 1
	sectionList.BorderSizePixel = 0
	sectionList.Position = UDim2.new(0, 4, 0, 26)
	sectionList.Size = UDim2.new(1, -8, 1, -56)
	sectionList.CanvasSize = UDim2.new(0, 0, 0, 0)
	sectionList.AutomaticCanvasSize = Enum.AutomaticSize.Y
	sectionList.ScrollBarThickness = 2
	sectionList.ScrollBarImageColor3 = T.ScrollBar
	sectionList.Parent = panel
	W.addListLayout(sectionList, 4, Enum.FillDirection.Vertical)
	refs.sectionList = sectionList

	-- Placeholder shown only until RandomizerWiring.populateSections rebuilds the list
	-- (which destroys all TextLabel/Frame children of sectionList).
	local placeholder = Instance.new("TextLabel")
	placeholder.Name = "Placeholder"
	placeholder.BackgroundTransparency = 1
	placeholder.Text = "Loading…"
	placeholder.TextColor3 = T.DarkGold
	placeholder.Font = T.Font
	placeholder.TextSize = 8
	placeholder.TextWrapped = true
	placeholder.TextXAlignment = Enum.TextXAlignment.Center
	placeholder.Size = UDim2.new(1, 0, 0, 32)
	placeholder.Parent = sectionList

	-- Three buttons evenly across the row.
	local btnRow = Instance.new("Frame")
	btnRow.BackgroundTransparency = 1
	btnRow.Size = UDim2.new(1, -8, 0, 22)
	btnRow.Position = UDim2.new(0, 4, 1, -26)
	btnRow.Parent = panel
	W.addListLayout(btnRow, 2, Enum.FillDirection.Horizontal)

	refs.rollAllBtn = W.makeButton("RandRoll", btnRow, "Roll", UDim2.new(1/3, -2, 1, 0))
	refs.rollAllBtn.LayoutOrder = 0
	refs.rollAllBtn.TextSize = 9
	refs.applyBtn = W.makeButton("RandApply", btnRow, "Apply", UDim2.new(1/3, -2, 1, 0), T.Gold)
	refs.applyBtn.LayoutOrder = 1
	refs.applyBtn.TextSize = 9
	refs.cancelBtn = W.makeButton("RandCancel", btnRow, "Cancel", UDim2.new(1/3, -2, 1, 0), T.DarkGold)
	refs.cancelBtn.LayoutOrder = 2
	refs.cancelBtn.TextSize = 9

	return refs
end

return RandomizerPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">ShortcutPanel</string>
              <string name="Source"><![CDATA[--[[
	ShortcutPanel  -  Part-Icles V5 ShortcutKey System
	Copyright (C) 2026 Qwinkle

	Modal panel scaffolding for the Shortcuts UI. A separate panel (not a tab in
	Settings) opened by the "Shortcuts" button in Settings. Modal-ish: overlays
	Properties; closeable.

	Layout (hold-P leader; chord shows as "P + key"):
	  [ShortcutPanel  -  modal]
	  [Search shortcuts...]                   (text filter)
	  [Unbind all]              [Close]       (header buttons)
	  ─────────────────────────────────────
	  ▼ UI
	    Toggle UI           (unbound)        [Bind] [X]
	    Toggle Inventory    P + I            [Bind] [X]   (after user binds it)
	    ...
	  ▼ Tools / Edit / Animate / Emit / Editor (collapsible per ActionCatalog category)

	Build returns refs map: {panel, scrollList, searchBox, resetBtn, headerCloseBtn}.
	Capture-state UX, conflict warning, and save flow are wired by
	`Modules/Shortcuts/Wiring.luau` and the runtime in `Modules/Shortcuts/init.luau`.

	`implemented = true` filter applied at populate time so stub Action entries
	(ResetSelection, OpenGraphEditor, OpenColorPicker) don't appear in the bind list  - 
	users only see bindable actions.
]]

local C = require(script.Parent.Constants)
local W = require(script.Parent.Widgets)
local T = C.T

local ShortcutPanel = {}

function ShortcutPanel.build(sg)
	-- 300x420  -  wider than RandomizerPanel because each row needs combo display + 2
	-- buttons. With nameBlob 130 + comboBlob -208 reserve + buttons 78 right gutter,
	-- 300 leaves ~120px for the combo display, enough for "P + Shift+X".
	local panel = W.makeToolPanel(sg, "Shortcuts", 300, 420)
	panel:SetAttribute("_opaquePanel", true)
	panel:SetAttribute("_noSnap", true)
	panel.Visible = false

	local refs = {panel = panel}

	-- Built-in header close from W.makeToolPanel; expose for wiring layer.
	local hd = panel:FindFirstChild("Hd")
	if hd then refs.headerCloseBtn = hd:FindFirstChild("Close") end

	-- P-guard description. Explains why every shortcut starts with P so users
	-- understand the leader convention before they Bind anything.
	local descBlob = W.makeBlob("PGuardDesc", panel, UDim2.new(1, -8, 0, 48))
	descBlob.Position = UDim2.new(0, 4, 0, 26)
	W.addPadding(descBlob, 6, 6, 4, 4)
	local desc = Instance.new("TextLabel")
	desc.Name = "DescText"
	desc.BackgroundTransparency = 1
	desc.Text = 'Press the chord you want to bind. P is the runtime leader  -  you\'ll hold P + the bound chord to fire the shortcut. Don\'t press P during capture.'
	desc.TextWrapped = true
	desc.TextColor3 = T.MutedGold
	desc.Font = T.Font
	desc.TextSize = 9
	desc.TextXAlignment = Enum.TextXAlignment.Left
	desc.TextYAlignment = Enum.TextYAlignment.Top
	desc.Size = UDim2.new(1, 0, 1, 0)
	desc.Parent = descBlob

	-- Search box (text filter). Filter logic lives in Modules/Shortcuts/Wiring.luau.
	local searchBox = Instance.new("TextBox")
	searchBox.Name = "ShortcutsSearch"
	searchBox.PlaceholderText = "Search shortcuts..."
	searchBox.Text = ""
	searchBox.ClearTextOnFocus = false
	searchBox.Font = T.Font
	searchBox.TextSize = 9
	searchBox.TextColor3 = T.MutedGold
	searchBox.PlaceholderColor3 = T.DarkGold
	searchBox.BackgroundColor3 = T.BlobBg
	searchBox.BackgroundTransparency = T.BlobAlpha
	searchBox.BorderSizePixel = 0
	searchBox.TextXAlignment = Enum.TextXAlignment.Left
	searchBox.Position = UDim2.new(0, 4, 0, 78)
	searchBox.Size = UDim2.new(1, -8, 0, 18)
	searchBox.Parent = panel
	W.addCorner(searchBox, UDim.new(0, 3))
	W.addPadding(searchBox, 0, 0, 4, 4)
	refs.searchBox = searchBox

	-- Reset-all button. Two-click confirm flow wired by Modules/Shortcuts/Wiring.luau.
	local resetBtn = W.makeButton("ShortcutsReset", panel, "Unbind all", UDim2.new(1, -8, 0, 18), T.DarkGold)
	resetBtn.Position = UDim2.new(0, 4, 0, 100)
	resetBtn.TextSize = 9
	refs.resetBtn = resetBtn

	-- Scrollable action list. Populated by Wiring from ctx.Actions filtered by
	-- `def.implemented == true`.
	local scrollList = Instance.new("ScrollingFrame")
	scrollList.Name = "ShortcutsList"
	scrollList.BackgroundTransparency = 1
	scrollList.BorderSizePixel = 0
	scrollList.Position = UDim2.new(0, 4, 0, 122)
	scrollList.Size = UDim2.new(1, -8, 1, -128)
	scrollList.CanvasSize = UDim2.new(0, 0, 0, 0)
	scrollList.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scrollList.ScrollBarThickness = 1
	scrollList.ScrollBarImageColor3 = T.ScrollBar
	scrollList.Parent = panel
	W.addListLayout(scrollList, 4, Enum.FillDirection.Vertical)
	refs.scrollList = scrollList

	-- Placeholder shown only until Wiring.populate replaces with per-category rows.
	local placeholder = Instance.new("TextLabel")
	placeholder.Name = "Placeholder"
	placeholder.BackgroundTransparency = 1
	placeholder.Text = "Loading…"
	placeholder.TextColor3 = T.DarkGold
	placeholder.Font = T.Font
	placeholder.TextSize = 8
	placeholder.TextWrapped = true
	placeholder.TextXAlignment = Enum.TextXAlignment.Center
	placeholder.Size = UDim2.new(1, 0, 0, 32)
	placeholder.Parent = scrollList

	return refs
end

return ShortcutPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">ToolPanels</string>
              <string name="Source"><![CDATA[-- UIToolPanels  -  Part-Icles V5. Copyright (C) 2026 Qwinkle
-- QOL tool panel builders: QMenu, Resize, Retime, Clipboard, Shifter, FixBanner.
-- Reads clipboard descriptors from TypeRegistry where possible (PE lists stay hardcoded).

local C = require(script.Parent.Constants)
local W = require(script.Parent.Widgets)
local PropertyCatalog = require(script.Parent.Parent.PropertyCatalog)
local T = C.T
local LAYOUT = C.LAYOUT

local ToolPanels = {}

-- Display name overrides: raw property key → friendly UI label (for clipboard/shifter toggles)
local DISPLAY_NAMES = {
	PartLife="Linger", TotalKeyFrames="Anim. Steps", ShapePartial="Hollow",
	VelocityVectored="Dir. Relative", InvertMotion="Reverse Motion", RotMode="Rotation Mode",
	RotSpeedX="Rot Speed X", RotSpeedY="Rot Speed Y", RotSpeedZ="Rot Speed Z",
	RotX="Rot X", RotY="Rot Y", RotZ="Rot Z", EmissionDirection="Direction",
	FlipbookMode="Flipbook Mode", FlipbookFramerate="Framerate",
	FlipbookStartRandom="Start Random", FlipbookReverse="Reverse",
	LightEmission="Light Emission", LightInfluence="Light Influence",
	TextureLength="Tex. Length", TextureSpeed="Tex. Speed", TextureMode="Tex. Mode",
	SizeX="Size X", SizeY="Size Y", SizeZ="Size Z", RotSpeed="Rot Speed",
	PosOffsetX="Displacement X", PosOffsetY="Displacement Y", PosOffsetZ="Displacement Z",
	DisplacementMode="Displacement Mode",
}
ToolPanels.DISPLAY_NAMES = DISPLAY_NAMES

-- Search box helper for Clipboard/Shifter panels
local function _makeSearchBox(parent, yPos)
	local sb = W.makeBlob("Search", parent, UDim2.new(1,0,0,18)); sb.Position = UDim2.new(0,0,0,yPos)
	local box = Instance.new("TextBox"); box.BackgroundTransparency = 1; box.PlaceholderText = "Search..."
	box.Text = ""; box.TextColor3 = T.BrightGold; box.PlaceholderColor3 = T.DarkGold; box.Font = T.Font; box.TextSize = 9
	box.ClearTextOnFocus = false; box.Size = UDim2.new(1,-4,1,0); box.Position = UDim2.new(0,2,0,0)
	box.TextXAlignment = Enum.TextXAlignment.Left; box.BorderSizePixel = 0; box.Parent = sb; return box
end

-- Word-boundary match: start of label or after space/underscore. Query escaped against
-- Luau pattern specials so chars like `(`, `.`, `%`, `[`, `*` match literally.
local function _escapePattern(s) return (s:gsub("[%(%)%.%%%+%-%*%?%[%]%^%$]", "%%%1")) end
local function _labelMatches(label, q)
	local esc = _escapePattern(q)
	return label:sub(1, #q) == q or label:find("[%s_]" .. esc) ~= nil
end

-- Wire search filtering on a scroll frame (call after building toggles).
-- External code (selection-filter, type-toggles) calls
-- `ToolPanels.invalidateSearchSnapshot(searchBox)` when it changes visibility while
-- a search is active. The next clear-search re-snapshots from post-filter state
-- instead of restoring stale pre-filter visibility (which would undo the filter).
function ToolPanels.invalidateSearchSnapshot(searchBox)
	if searchBox then searchBox:SetAttribute("_savedDirty", true) end
end

function ToolPanels.wireSearch(searchBox, scrollFrame)
	if not searchBox or not scrollFrame then return end
	local _saved = {} -- {[frame] = wasVisible} snapshot before search (bodies + rows)
	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		local query = searchBox.Text:lower()
		local isSearch = query ~= ""
		-- If external code (filter toggle) marked the snapshot dirty, drop it and
		-- re-snapshot from current state. Otherwise clearing search would restore
		-- stale pre-filter visibility and undo the filter's just-applied changes.
		if searchBox:GetAttribute("_savedDirty") then
			_saved = {}
			searchBox:SetAttribute("_savedDirty", nil)
		end
		-- Save state on first search (bodies + rows from selection filter)
		if isSearch and next(_saved) == nil then
			for _, d in ipairs(scrollFrame:GetDescendants()) do
				if d:IsA("Frame") and (d.Name == "Body" or d:GetAttribute("PropRow") or d.Name:match("Section$") or d.Name:match("Sub$")) then _saved[d] = d.Visible end
			end
			for _, s in ipairs(scrollFrame:GetChildren()) do if s:IsA("Frame") then _saved[s] = s.Visible end end
		end
		if isSearch then
			local hits = {}
			for _, d in ipairs(scrollFrame:GetDescendants()) do
				if d:IsA("Frame") and d:GetAttribute("PropRow") then
					local lbl = d:FindFirstChildWhichIsA("TextLabel")
					if lbl then
						local match = _saved[d] and _labelMatches(lbl.Text:lower(), query)
						d.Visible = match or false
						if match then local c = d.Parent; while c and c ~= scrollFrame do hits[c] = true; c = c.Parent end end
					end
				end
			end
			for _, d in ipairs(scrollFrame:GetDescendants()) do
				if d:IsA("Frame") and (d.Name:match("Section$") or d.Name:match("Sub$")) then d.Visible = hits[d] or false
				elseif d.Name == "Body" and d:IsA("Frame") then d.Visible = hits[d] or false end
			end
			for _, s in ipairs(scrollFrame:GetChildren()) do if s:IsA("Frame") then s.Visible = hits[s] or false end end
		else
			for d, vis in pairs(_saved) do d.Visible = vis end; _saved = {}
		end
		-- Sync arrows
		for _, d in ipairs(scrollFrame:GetDescendants()) do
			local hdr = d:IsA("Frame") and d:FindFirstChild("Header")
			if hdr then local ar = hdr:FindFirstChild("Arrow"); if ar then
				local body = d:FindFirstChild("Body"); if body then ar.Text = body.Visible and "\u{25BC}" or "\u{25B6}" end
			end end
		end
	end)
end

-- PE props are hardcoded (not in TypeRegistry  -  PE is native Roblox)
-- Exposed via ToolPanels.PE_SECTIONS so RandomizerWiring (and future PropertyCatalog
-- consumers) can pass the same PE section list that Clipboard uses.
ToolPanels.PE_SECTIONS = nil
local PE_SECTIONS = {
	{name = "Spawning", props = {"Rate", "Lifetime", "SpreadAngle"}},
	{name = "Emission", props = {"EmitCount", "EmitDelay", "EmitDuration"}},
	{name = "Appearance", props = {"Brightness", "Size", "Transparency", "Color", "Squash", "LightEmission", "LightInfluence", "ZOffset"}},
	{name = "Movement", props = {"Speed", "RotSpeed", "Rotation", "Acceleration", "Drag", "VelocityInheritance", "TimeScale", "WindAffectsDrag"}},
	{name = "Flipbook", props = {"FlipbookFramerate", "FlipbookBlendFrames"}},
}
local PE_SECTIONS_SHIFTER = {
	{name = "Spawning", props = {"Rate", "Lifetime", "SpreadAngle"}},
	{name = "Emission", props = {"EmitCount", "EmitDelay", "EmitDuration"}},
	{name = "Appearance", props = {"Brightness", "Size", "Transparency", "Squash", "LightEmission", "LightInfluence", "ZOffset"}},
	{name = "Movement", props = {"Speed", "RotSpeed", "Rotation", "Acceleration", "Drag", "VelocityInheritance", "TimeScale"}},
	{name = "Flipbook", props = {"FlipbookFramerate"}},
}
ToolPanels.PE_SECTIONS = PE_SECTIONS

-- Type-name + ctx-field-key constants live in PropertyCatalog (single source of truth).
-- ToolPanels reads via the local alias below; ClipShiftFix reads via
-- `ToolPanels.TYPE_ITEM_KEYS` which we re-expose for backwards compat.
local TYPE_ITEM_KEYS = PropertyCatalog.TYPE_ITEM_KEYS

-- Forwarding shim: body lives in `Modules/PropertyCatalog`. Same return shape.
local function _mergeClipboards(TypeRegistry, peSections, excludeProps)
	return PropertyCatalog.merge(TypeRegistry, peSections, excludeProps)
end

-- Cached maps (populated during build, accessed by ClipShiftFix via ToolPanels.propTypeMap)
ToolPanels.propTypeMap = {}; ToolPanels.propTypeMapShifter = {}; ToolPanels.TYPE_ITEM_KEYS = TYPE_ITEM_KEYS

-- ==================== Q MENU ====================
function ToolPanels.buildQMenu(sg)
	local panel = Instance.new("Frame"); panel.Name = "QMenu"
	panel.BackgroundColor3 = T.PanelBg; panel.BackgroundTransparency = T.PanelAlpha
	panel.AnchorPoint = Vector2.new(1, 1)
	-- Offset left of the Settings panel (SettingsWidth=200 + 12 right margin + 8 gap)
	-- so Tools doesn't overlap Settings when both are open at default positions.
	panel.Position = UDim2.new(1, -(LAYOUT.SettingsWidth + 12 + 8 + 12), 1, -40)
	local QMENU_H = 277  -- 237 base + 20 for Randomize + 20 for Forge Convert
	panel.Size = UDim2.new(0, LAYOUT.HudWidth, 0, QMENU_H)
	panel.ClipsDescendants = true; panel.Active = true; panel.Visible = false; panel.Parent = sg
	W.addCorner(panel, T.BigCorner); W.addStroke(panel); W.addPadding(panel,4,4,4,4); W.addListLayout(panel,3)
	table.insert(W.getThemed().panels, panel)
	W.attachPanelBackground(panel)
	local db = W.makeBlob("Drag", panel, UDim2.new(1,0,0,22)); db.LayoutOrder = 0
	local dt = Instance.new("TextLabel"); dt.BackgroundTransparency = 1; dt.Text = "Tools"; dt.TextColor3 = T.Gold; dt.Font = T.Font; dt.TextSize = 11; dt.Size = UDim2.new(1,-18,1,0)
	dt.Position = UDim2.new(0,4,0,0); dt.TextXAlignment = Enum.TextXAlignment.Left; dt.Parent = db
	local qClose = Instance.new("TextButton"); qClose.Name = "Close"; qClose.BackgroundTransparency = 1
	qClose.Text = "X"; qClose.TextColor3 = T.DarkGold; qClose.Font = T.Font; qClose.TextSize = 10
	qClose.Size = UDim2.new(0,14,1,0); qClose.Position = UDim2.new(1,-14,0,0); qClose.ZIndex = 3; qClose.Parent = db
	qClose.Activated:Connect(function() panel.Visible = false end)
	local dh = Instance.new("TextButton"); dh.BackgroundTransparency = 1; dh.Text = ""
	dh.Size = UDim2.new(1,-18,1,0); dh.ZIndex = 2; dh.Parent = db; W.makeDraggable(panel, dh)
	local refs = {}; local bodyItems = {}
	for i, name in ipairs({"Resize","Retime","Hue","Clipboard","Shifter","Randomize","Scan","Insert","EmitCode","ForgeConvert"}) do
		refs[name] = W.makeButton("Q_"..name, panel, name, UDim2.new(1,0,0,20), T.MutedGold)
		refs[name].TextSize = 10; refs[name].LayoutOrder = i; table.insert(bodyItems, refs[name])
	end
	refs.Insert.Text = "Insert Module"; refs.Scan.Text = "Scan All"; refs.EmitCode.Text = "Emit Code"
	refs.ForgeConvert.Text = "Convert from Forge"

	refs.OptToggle = W.makeButton("Q_Opt", panel, "Opt. Indicator", UDim2.new(1,0,0,20), T.MutedGold)
	refs.OptToggle.TextSize = 10; refs.OptToggle.LayoutOrder = 8; refs.OptToggle:SetAttribute("IsOn", false)
	refs.OptToggle.Activated:Connect(function()
		local isOn = not refs.OptToggle:GetAttribute("IsOn"); refs.OptToggle:SetAttribute("IsOn", isOn)
		refs.OptToggle.TextColor3 = isOn and T.Gold or T.MutedGold
	end)
	table.insert(bodyItems, refs.OptToggle)

	W.addCollapseButton(db, bodyItems, {
		panel = panel, expandedSize = UDim2.new(0, LAYOUT.HudWidth, 0, QMENU_H),
		collapsedSize = UDim2.new(0, LAYOUT.HudWidth, 0, 30),
	})
	refs.QMenu = panel; refs.QMenuClose = qClose; return refs
end

-- =========================================================
-- RESIZE
-- =========================================================
function ToolPanels.buildResize(sg)
	local panel = W.makeToolPanel(sg, "Resize", 120, 128)
	local refs = {}
	local sl, vd, sv, gv = W.makeSlider(panel, 0.5, 2, 1, nil, "%.2fx", true)
	sl.Position = UDim2.new(0,5,0,22); sl.Size = UDim2.new(1,-10,0,28)
	refs.ResizeGetVal = gv; refs.ResizeSetVal = sv; refs.ResizeInput = vd

	local adRow = Instance.new("Frame"); adRow.BackgroundTransparency = 1
	adRow.Size = UDim2.new(1,0,0,14); adRow.Position = UDim2.new(0,0,0,52); adRow.Parent = panel
	local adLbl = Instance.new("TextLabel"); adLbl.BackgroundTransparency = 1; adLbl.Text = "Include Descendants"
	adLbl.TextColor3 = T.DarkGold; adLbl.Font = T.Font; adLbl.TextSize = 8; adLbl.TextTruncate = Enum.TextTruncate.AtEnd
	adLbl.Size = UDim2.new(1,-34,1,0); adLbl.Position = UDim2.new(0,0,0,0); adLbl.Parent = adRow
	refs.ResizeDescToggle = W.makeToggle("ResDesc", adRow); refs.ResizeDescToggle.Position = UDim2.new(1,-30,0,-1)
	-- Default to ON  -  users nearly always want descendants included when resizing containers
	refs.ResizeDescToggle:SetAttribute("IsOn", true); refs.ResizeDescToggle.BackgroundColor3 = Color3.fromRGB(40,55,30)
	local rDot = refs.ResizeDescToggle:FindFirstChild("Dot"); if rDot then rDot.BackgroundColor3 = T.Green; rDot.Position = UDim2.new(0,14,0,2) end

	local ssRow = Instance.new("Frame"); ssRow.BackgroundTransparency = 1
	ssRow.Size = UDim2.new(1,0,0,14); ssRow.Position = UDim2.new(0,0,0,68); ssRow.Parent = panel
	local ssLbl = Instance.new("TextLabel"); ssLbl.BackgroundTransparency = 1; ssLbl.Text = "Scale Spawn Area"
	ssLbl.TextColor3 = T.DarkGold; ssLbl.Font = T.Font; ssLbl.TextSize = 8
	ssLbl.TextTruncate = Enum.TextTruncate.AtEnd; ssLbl.Size = UDim2.new(1,-34,1,0); ssLbl.Position = UDim2.new(0,0,0,0); ssLbl.Parent = ssRow
	refs.ResizeScaleShapeToggle = W.makeToggle("ResShape", ssRow); refs.ResizeScaleShapeToggle.Position = UDim2.new(1,-30,0,-1)

	local btnRow = Instance.new("Frame"); btnRow.BackgroundTransparency = 1
	btnRow.Size = UDim2.new(1,0,0,20); btnRow.Position = UDim2.new(0,0,1,-24); btnRow.Parent = panel
	W.addListLayout(btnRow, 2, Enum.FillDirection.Horizontal)
	refs.ResizeApply = W.makeButton("Ap", btnRow, "Apply", UDim2.new(0.5,-1,1,0)); refs.ResizeApply.LayoutOrder = 0; refs.ResizeApply.TextSize = 9
	refs.ResizeReset = W.makeButton("Rs", btnRow, "Reset", UDim2.new(0.5,-1,1,0), T.DarkGold); refs.ResizeReset.LayoutOrder = 1; refs.ResizeReset.TextSize = 9

	refs.ResizeSlider = sl
	refs.ResizePanel = panel; return refs
end

-- =========================================================
-- RETIME
-- =========================================================
function ToolPanels.buildRetime(sg)
	local panel = W.makeToolPanel(sg, "Retime", 120, 110)
	local refs = {}
	local sl, vd, sv, gv = W.makeSlider(panel, 0.5, 2, 1, nil, "%.2fx", true)
	sl.Position = UDim2.new(0,5,0,22); sl.Size = UDim2.new(1,-10,0,28)
	refs.RetimeGetVal = gv; refs.RetimeSetVal = sv; refs.RetimeInput = vd

	local adRow = Instance.new("Frame"); adRow.BackgroundTransparency = 1
	adRow.Size = UDim2.new(1,0,0,14); adRow.Position = UDim2.new(0,0,0,52); adRow.Parent = panel
	local adLbl = Instance.new("TextLabel"); adLbl.BackgroundTransparency = 1; adLbl.Text = "Include Descendants"
	adLbl.TextColor3 = T.DarkGold; adLbl.Font = T.Font; adLbl.TextSize = 8; adLbl.TextTruncate = Enum.TextTruncate.AtEnd
	adLbl.Size = UDim2.new(1,-34,1,0); adLbl.Position = UDim2.new(0,0,0,0); adLbl.Parent = adRow
	refs.RetimeDescToggle = W.makeToggle("RetDesc", adRow); refs.RetimeDescToggle.Position = UDim2.new(1,-30,0,-1)
	-- Default to ON  -  users nearly always want descendants included when retiming containers
	refs.RetimeDescToggle:SetAttribute("IsOn", true); refs.RetimeDescToggle.BackgroundColor3 = Color3.fromRGB(40,55,30)
	local rtDot = refs.RetimeDescToggle:FindFirstChild("Dot"); if rtDot then rtDot.BackgroundColor3 = T.Green; rtDot.Position = UDim2.new(0,14,0,2) end

	local btnRow = Instance.new("Frame"); btnRow.BackgroundTransparency = 1
	btnRow.Size = UDim2.new(1,0,0,20); btnRow.Position = UDim2.new(0,0,1,-24); btnRow.Parent = panel
	W.addListLayout(btnRow, 2, Enum.FillDirection.Horizontal)
	refs.RetimeApply = W.makeButton("Ap", btnRow, "Apply", UDim2.new(0.5,-1,1,0)); refs.RetimeApply.LayoutOrder = 0; refs.RetimeApply.TextSize = 9
	refs.RetimeReset = W.makeButton("Rs", btnRow, "Reset", UDim2.new(0.5,-1,1,0), T.DarkGold); refs.RetimeReset.LayoutOrder = 1; refs.RetimeReset.TextSize = 9

	refs.RetimeSlider = sl
	refs.RetimePanel = panel; return refs
end

-- =========================================================
-- CLIPBOARD
-- =========================================================
function ToolPanels.buildClipboard(sg, TypeRegistry)
	local panel = W.makeToolPanel(sg, "Clipboard", 110, 280)
	local refs = {}
	local br = Instance.new("Frame"); br.BackgroundTransparency = 1; br.Size = UDim2.new(1,0,0,20)
	br.Position = UDim2.new(0,0,0,22); br.Parent = panel
	W.addListLayout(br, 2, Enum.FillDirection.Horizontal)
	refs.ClipCopy = W.makeButton("Cp", br, "Copy", UDim2.new(0.5,-1,1,0)); refs.ClipCopy.LayoutOrder = 0; refs.ClipCopy.TextSize = 9
	refs.ClipPaste = W.makeButton("Ps", br, "Paste", UDim2.new(0.5,-1,1,0)); refs.ClipPaste.LayoutOrder = 1; refs.ClipPaste.TextSize = 9
	local csb = _makeSearchBox(panel, 46); refs.ClipSearch = csb
	local sc = Instance.new("ScrollingFrame"); sc.Name = "Scroll"; sc.BackgroundTransparency = 1
	sc.Position = UDim2.new(0,0,0,66); sc.Size = UDim2.new(1,0,1,-66)
	sc.CanvasSize = UDim2.new(0,0,0,0); sc.AutomaticCanvasSize = Enum.AutomaticSize.Y
	sc.ScrollBarThickness = 2; sc.ScrollBarImageColor3 = T.ScrollBar; sc.BorderSizePixel = 0
	sc.Parent = panel; W.addListLayout(sc, 2); table.insert(W.getThemed().scrollbars, sc)

	-- Build unified categories (union of all types + PE)
	local merged, ptm = _mergeClipboards(TypeRegistry, PE_SECTIONS)
	ToolPanels.propTypeMap = ptm
	W.buildPropToggles(sc, merged, "Properties", 0, DISPLAY_NAMES)
	ToolPanels.wireSearch(csb, sc)
	refs.ClipboardPanel = panel; refs.ClipboardScroll = sc; return refs
end

-- =========================================================
-- SHIFTER
-- =========================================================
function ToolPanels.buildShifter(sg, TypeRegistry)
	local panel = W.makeToolPanel(sg, "Shifter", 110, 280)
	local refs = {}
	local vw = W.makeBlob("VW", panel, UDim2.new(1,0,0,22)); vw.Position = UDim2.new(0,0,0,22)
	refs.ShiftInput = Instance.new("TextBox"); refs.ShiftInput.BackgroundTransparency = 1
	refs.ShiftInput.Text = "1.0"; refs.ShiftInput.TextColor3 = T.BrightGold; refs.ShiftInput.Font = T.Font
	refs.ShiftInput.TextSize = 13; refs.ShiftInput.TextXAlignment = Enum.TextXAlignment.Center
	refs.ShiftInput.ClearTextOnFocus = false; refs.ShiftInput.Size = UDim2.new(1,-4,1,0)
	refs.ShiftInput.Position = UDim2.new(0,2,0,0); refs.ShiftInput.BorderSizePixel = 0; refs.ShiftInput.Parent = vw
	local or2 = Instance.new("Frame"); or2.BackgroundTransparency = 1; or2.Size = UDim2.new(1,0,0,20)
	or2.Position = UDim2.new(0,0,0,47); or2.Parent = panel; W.addListLayout(or2, 2, Enum.FillDirection.Horizontal)
	refs.ShiftMul = W.makeButton("Mul", or2, "x", UDim2.new(0.25,-2,1,0)); refs.ShiftMul.LayoutOrder = 0; refs.ShiftMul.TextSize = 11
	refs.ShiftDiv = W.makeButton("Div", or2, "/", UDim2.new(0.25,-2,1,0)); refs.ShiftDiv.LayoutOrder = 1; refs.ShiftDiv.TextSize = 11
	refs.ShiftAdd = W.makeButton("Add", or2, "+", UDim2.new(0.25,-2,1,0)); refs.ShiftAdd.LayoutOrder = 2; refs.ShiftAdd.TextSize = 11
	refs.ShiftSub = W.makeButton("Sub", or2, "-", UDim2.new(0.25,-2,1,0)); refs.ShiftSub.LayoutOrder = 3; refs.ShiftSub.TextSize = 11
	local er = Instance.new("Frame"); er.BackgroundTransparency = 1; er.Size = UDim2.new(1,0,0,14)
	er.Position = UDim2.new(0,0,0,70); er.Parent = panel
	local el = Instance.new("TextLabel"); el.BackgroundTransparency = 1; el.Text = "Scale Envelope"
	el.TextColor3 = T.DarkGold; el.Font = T.Font; el.TextSize = 8
	el.TextTruncate = Enum.TextTruncate.AtEnd; el.Size = UDim2.new(1,-34,1,0); el.Parent = er
	refs.EnvelopeToggle = W.makeToggle("Env", er); refs.EnvelopeToggle.Position = UDim2.new(1,-30,0,-1)
	local ssb = _makeSearchBox(panel, 88); refs.ShiftSearch = ssb
	local sc = Instance.new("ScrollingFrame"); sc.Name = "Scroll"; sc.BackgroundTransparency = 1
	sc.Position = UDim2.new(0,0,0,108); sc.Size = UDim2.new(1,0,1,-108)
	sc.CanvasSize = UDim2.new(0,0,0,0); sc.AutomaticCanvasSize = Enum.AutomaticSize.Y
	sc.ScrollBarThickness = 2; sc.ScrollBarImageColor3 = T.ScrollBar; sc.BorderSizePixel = 0
	sc.Parent = panel; W.addListLayout(sc, 2); table.insert(W.getThemed().scrollbars, sc)

	-- Build unified categories for shifter. Exclusions: booleans, enums, strings, ColorSequences,
	-- and Events (each event is a snapshot tree, not a numeric value to shift).
	-- Vector2 / Vector3 / UDim2 are shiftable component-wise (see QOL._opVec2 / _opVec3 / _opUDim2).
	local mergedS, ptmS = _mergeClipboards(TypeRegistry, PE_SECTIONS_SHIFTER, {
		Blender = true,
		-- Booleans (not mathematically operable)
		FlipbookReverse = true, VelocityVectored = true, InvertMotion = true, FaceCamera = true, FlipbookStartRandom = true,
		UseShape = true, LookAtInitially = true, Enabled = true, Shadows = true,
		AccelerationTowardsInstance = true, PreloadTexture = true, Pool = true,
		ScaleTextureLength = true,
		RotXEven = true, RotYEven = true, RotZEven = true,
		PosXEven = true, PosYEven = true, PosZEven = true,
		-- Enums / string modes (not mathematically operable)
		EmissionDirection = true, Material = true, RotMode = true, RotOrder = true, PosMode = true, DirMode = true, DisplacementMode = true,
		Shape = true, ShapeInOut = true, Orientation = true,
		TextureMode = true, FlipbookMode = true, FlipbookSource = true, ScaleType = true, ResampleMode = true,
		-- Events (per-event snapshot tree  -  not numeric).
		OnEmit = true, OnDeath = true, OnDestruction = true, OnHit = true,
		-- ColorSequences (explicitly skipped in shiftItems)
		Color = true, Decay = true, TintColor = true, ImageColor3 = true, BackgroundColor3 = true,
		-- string / ContentId  -  ImageLabel's Image asset ID isn't numeric. Trail Duration
		-- is a string-formatted NumberRange ("min, max") with directAccess; can't shift directly.
		Image = true, Duration = true,
	})
	ToolPanels.propTypeMapShifter = ptmS
	W.buildPropToggles(sc, mergedS, "Properties", 0, DISPLAY_NAMES)
	ToolPanels.wireSearch(ssb, sc)
	refs.ShifterPanel = panel; refs.ShifterScroll = sc; return refs
end

-- =========================================================
-- HUE CHANGER
-- =========================================================
function ToolPanels.buildHueChanger(sg)
	local panel = W.makeToolPanel(sg, "HueChanger", 80, 360)
	local refs = {}
	local UIS = game:GetService("UserInputService")
	local HANDLE_H = 8

	-- Builds a vertical slider with gradient background. Returns (getVal, setVal, track)
	-- xScale: 0-1 horizontal position (Scale-based for responsive layout)
	local function makeVSlider(parent, xScale, gradient, minVal, maxVal, defaultVal)
		local track = Instance.new("Frame"); track.Name = "Track"; track.BorderSizePixel = 0
		track.Size = UDim2.new(0.2, 0, 1, -90); track.AnchorPoint = Vector2.new(0.5, 0)
		track.Position = UDim2.new(xScale, 0, 0, 26)
		track.BackgroundColor3 = Color3.new(1,1,1); track.Parent = parent
		local cr = Instance.new("UICorner"); cr.CornerRadius = UDim.new(0,4); cr.Parent = track
		local gr = Instance.new("UIGradient"); gr.Rotation = 90; gr.Parent = track
		gr.Color = gradient
		local handle = Instance.new("Frame"); handle.Name = "Handle"; handle.BorderSizePixel = 0
		handle.BackgroundColor3 = Color3.new(1,1,1); handle.Size = UDim2.new(1,4,0,HANDLE_H)
		handle.AnchorPoint = Vector2.new(0.5,0.5); handle.Position = UDim2.new(0.5,0,0.5,0)
		handle.ZIndex = 3; handle.Parent = track
		local hc = Instance.new("UICorner"); hc.CornerRadius = UDim.new(0,3); hc.Parent = handle
		local hs = Instance.new("UIStroke"); hs.Color = Color3.new(0,0,0); hs.Thickness = 1; hs.Parent = handle
		local cur = defaultVal; local dragging = false
		local lo, hi = math.min(minVal, maxVal), math.max(minVal, maxVal)
		local function setVal(v, skip)
			cur = math.clamp(v, lo, hi)
			local t = (cur - minVal) / (maxVal - minVal)
			handle.Position = UDim2.new(0.5, 0, t, 0)
		end
		local function getVal() return cur end
		local btn = Instance.new("TextButton"); btn.BackgroundTransparency = 1; btn.Text = ""
		btn.Size = UDim2.new(1,0,1,0); btn.ZIndex = 4; btn.Parent = track
		btn.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
		end)
		btn.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
		end)
		local uisC = W.getUISConnections()
		table.insert(uisC, UIS.InputChanged:Connect(function(i)
			if not dragging or i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
			local absY = track.AbsolutePosition.Y; local absH = track.AbsoluteSize.Y
			local rel = math.clamp((i.Position.Y - absY) / absH, 0, 1)
			setVal(minVal + rel * (maxVal - minVal))
		end))
		table.insert(uisC, UIS.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
		end))
		btn.Activated:Connect(function()
			local m = UIS:GetMouseLocation(); local absY = track.AbsolutePosition.Y; local absH = track.AbsoluteSize.Y
			local rel = math.clamp((m.Y - absY) / absH, 0, 1)
			setVal(minVal + rel * (maxVal - minVal))
		end)
		setVal(defaultVal)
		return getVal, setVal, track
	end

	-- Rainbow gradient for Hue
	local hueGrad = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromHSV(0,1,1)), ColorSequenceKeypoint.new(0.167, Color3.fromHSV(0.167,1,1)),
		ColorSequenceKeypoint.new(0.333, Color3.fromHSV(0.333,1,1)), ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5,1,1)),
		ColorSequenceKeypoint.new(0.667, Color3.fromHSV(0.667,1,1)), ColorSequenceKeypoint.new(0.833, Color3.fromHSV(0.833,1,1)),
		ColorSequenceKeypoint.new(1, Color3.fromHSV(0,1,1)),
	})
	-- Saturation: white → full color (red as reference)
	local satGrad = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.new(1,1,1)), ColorSequenceKeypoint.new(1, Color3.fromHSV(0,1,1))})
	-- Value: white → black
	local valGrad = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.new(1,1,1)), ColorSequenceKeypoint.new(1, Color3.new(0,0,0))})

	local hgv, hsv = makeVSlider(panel, 1/6, hueGrad, -0.5, 0.5, 0)
	local sgv, ssv = makeVSlider(panel, 3/6, satGrad, -1, 1, 0)
	local vgv, vsv = makeVSlider(panel, 5/6, valGrad, 1, -1, 0)

	-- Labels (below tracks, same Scale X positions)
	local function addLabel(text, xScale)
		local l = Instance.new("TextLabel"); l.BackgroundTransparency = 1; l.Text = text
		l.TextColor3 = T.MutedGold; l.Font = T.Font; l.TextSize = 7; l.TextXAlignment = Enum.TextXAlignment.Center
		l.AnchorPoint = Vector2.new(0.5, 0); l.Size = UDim2.new(0.2, 0, 0, 10)
		l.Position = UDim2.new(xScale, 0, 1, -62); l.Parent = panel
	end
	addLabel("H", 1/6); addLabel("S", 3/6); addLabel("V", 5/6)

	-- Apply / Reset buttons
	local btnRow = Instance.new("Frame"); btnRow.BackgroundTransparency = 1
	btnRow.Size = UDim2.new(1,0,0,20); btnRow.Position = UDim2.new(0,0,1,-24); btnRow.Parent = panel
	W.addListLayout(btnRow, 2, Enum.FillDirection.Horizontal)
	refs.HueApply = W.makeButton("Ap", btnRow, "Apply", UDim2.new(0.5,-1,1,0)); refs.HueApply.LayoutOrder = 0; refs.HueApply.TextSize = 9
	refs.HueReset = W.makeButton("Rs", btnRow, "Reset", UDim2.new(0.5,-1,1,0), T.DarkGold); refs.HueReset.LayoutOrder = 1; refs.HueReset.TextSize = 9

	refs.HueGetVal = hgv; refs.HueSetVal = hsv
	refs.SatGetVal = sgv; refs.SatSetVal = ssv
	refs.ValGetVal = vgv; refs.ValSetVal = vsv
	refs.HuePanel = panel; return refs
end

-- =========================================================
-- FIX BANNER
-- =========================================================
function ToolPanels.buildFixBanner(sg)
	local banner = Instance.new("Frame"); banner.Name = "FixBanner"
	banner.BackgroundColor3 = T.PanelBg; banner.BackgroundTransparency = T.PanelAlpha
	banner.Position = UDim2.new(1, -140, 0.5, -40)
	banner.Size = UDim2.new(0, 128, 0, 0); banner.AutomaticSize = Enum.AutomaticSize.Y
	banner.Visible = false; banner.Parent = sg
	W.addCorner(banner, T.BigCorner); W.addStroke(banner); W.addPadding(banner, 6, 6, 6, 6); W.addListLayout(banner, 4)
	table.insert(W.getThemed().panels, banner)

	local refs = {}

	local titleBlob = W.makeBlob("TitleBlob", banner, UDim2.new(1, 0, 0, 24)); titleBlob.LayoutOrder = 0
	refs.FixTitleLabel = Instance.new("TextLabel"); refs.FixTitleLabel.BackgroundTransparency = 1
	refs.FixTitleLabel.Text = "Issues Found"; refs.FixTitleLabel.TextColor3 = T.Gold; refs.FixTitleLabel.Font = T.Font; refs.FixTitleLabel.TextSize = 11
	refs.FixTitleLabel.TextXAlignment = Enum.TextXAlignment.Center; refs.FixTitleLabel.Size = UDim2.new(1, 0, 1, 0); refs.FixTitleLabel.Parent = titleBlob

	local countBlob = W.makeBlob("CountBlob", banner, UDim2.new(1, 0, 0, 20)); countBlob.LayoutOrder = 1
	refs.FixCountLabel = Instance.new("TextLabel"); refs.FixCountLabel.BackgroundTransparency = 1
	refs.FixCountLabel.Text = "0 items"; refs.FixCountLabel.TextColor3 = T.BrightGold
	refs.FixCountLabel.Font = T.Font; refs.FixCountLabel.TextSize = 10
	refs.FixCountLabel.TextXAlignment = Enum.TextXAlignment.Center
	refs.FixCountLabel.Size = UDim2.new(1, 0, 1, 0); refs.FixCountLabel.Parent = countBlob

	refs.FixButton = W.makeButton("FixBtn", banner, "Fix", UDim2.new(1, 0, 0, 28), T.Green)
	refs.FixButton.TextSize = 13; refs.FixButton.LayoutOrder = 2

	refs.MigrateButton = W.makeButton("MigrateBtn", banner, "Upgrade Format", UDim2.new(1, 0, 0, 28), Color3.fromRGB(100, 160, 230))
	refs.MigrateButton.TextSize = 13; refs.MigrateButton.LayoutOrder = 3; refs.MigrateButton.Visible = false

	refs.FixDismiss = W.makeButton("Dismiss", banner, "Dismiss", UDim2.new(1, 0, 0, 22), T.DarkGold)
	refs.FixDismiss.TextSize = 9; refs.FixDismiss.LayoutOrder = 4
	refs.FixDismiss.Activated:Connect(function() banner.Visible = false end)

	refs.FixBanner = banner
	return refs
end

-- =========================================================
-- EMIT CODE
-- =========================================================
function ToolPanels.buildEmitCode(sg)
	local panel = W.makeToolPanel(sg, "Emit Code", 260, 220)
	local refs = {}
	-- Code display (multiline, monospace, read-only feel)
	local codeWrap = Instance.new("Frame"); codeWrap.Name = "CodeWrap"
	codeWrap.BackgroundColor3 = T.PanelBg; codeWrap.BackgroundTransparency = T.PanelAlpha
	codeWrap.BorderSizePixel = 0; codeWrap.Size = UDim2.new(1,0,1,-50)
	codeWrap.Position = UDim2.new(0,0,0,22); codeWrap.ClipsDescendants = true; codeWrap.Parent = panel
	W.addCorner(codeWrap); W.addStroke(codeWrap); table.insert(W.getThemed().panels, codeWrap)
	local codeBox = Instance.new("TextBox"); codeBox.Name = "CodeBox"
	codeBox.BackgroundTransparency = 1; codeBox.Text = "-- Select Part-Icle items to generate emit code"
	codeBox.TextColor3 = T.BrightGold; codeBox.Font = Enum.Font.Code; codeBox.TextSize = 10
	codeBox.TextXAlignment = Enum.TextXAlignment.Left; codeBox.TextYAlignment = Enum.TextYAlignment.Top
	codeBox.TextWrapped = true; codeBox.MultiLine = true; codeBox.ClearTextOnFocus = false
	codeBox.TextEditable = false; codeBox:SetAttribute("_noFontOverride", true); codeBox.Size = UDim2.new(1,-8,1,-8)
	codeBox.Position = UDim2.new(0,4,0,4); codeBox.BorderSizePixel = 0; codeBox.Parent = codeWrap
	refs.EmitCodeBox = codeBox
	-- Button row
	local btnRow = Instance.new("Frame"); btnRow.BackgroundTransparency = 1
	btnRow.Size = UDim2.new(1,0,0,22); btnRow.Position = UDim2.new(0,0,1,-26); btnRow.Parent = panel
	W.addListLayout(btnRow, 4, Enum.FillDirection.Horizontal)
	refs.EmitCodeCopy = W.makeButton("Cp", btnRow, "Select All", UDim2.new(0.5,-2,1,0)); refs.EmitCodeCopy.LayoutOrder = 0; refs.EmitCodeCopy.TextSize = 9
	refs.EmitCodeRun = W.makeButton("Rn", btnRow, "Run", UDim2.new(0.5,-2,1,0), T.Green); refs.EmitCodeRun.LayoutOrder = 1; refs.EmitCodeRun.TextSize = 9
	refs.EmitCodePanel = panel; return refs
end

return ToolPanels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">WidgetAxis</string>
              <string name="Source"><![CDATA[--[[
	WidgetAxis  -  Part-Icles V5
	Copyright (C) 2026 Qwinkle
	Axis-based widget factories (graph rows, input rows, inline axis selectors).
	Loaded by Widgets.luau  -  receives the shared W table and adds functions to it.
]]

local C = require(script.Parent.Constants)
local T = C.T
local LAYOUT = C.LAYOUT

-- Axis colors lookup
local AXIS_COLORS = {X = T.AxisX, Y = T.AxisY, Z = T.AxisZ}

-- Derive a muted background tint from an axis color (for selected state)
local function axisSelectedBg(color)
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(h, math.min(s * 0.6, 1), v * 0.25)
end

return function(W)
	local addCorner, addStroke = W.addCorner, W.addStroke
	-- Cross-file invariant: each axis button registered here is consumed by
	-- `UIBuilder:UpdateTheme`'s axis-button refresh loop. That loop reads the button's
	-- `_selected` attribute (set by makeInlineAxisSelect/Input/GraphSelect below) to gate
	-- selected-style paint vs default paint. Keep the registered shape `{btn, color, selBg}`
	-- in sync with that consumer.
	local function trackAxis(btn, color, selBg)
		table.insert(W.getThemed().axisButtons, {btn = btn, color = color, selBg = selBg})
	end

	function W.makeAxisGraphRow(parent, axis, color, order, withCheckbox)
		local row = Instance.new("Frame"); row.Name = axis.."Row"; row.BackgroundTransparency = 1
		row.Size = UDim2.new(1,0,0,LAYOUT.RowHeight); row.LayoutOrder = order or 0; row.Parent = parent

		local xOffset = 18
		local checkbox = nil

		if withCheckbox then
			-- Small checkbox (14x14) before the axis label
			checkbox = Instance.new("TextButton"); checkbox.Name = "Checkbox"; checkbox.BackgroundColor3 = T.BlobBg
			checkbox.BackgroundTransparency = T.BlobAlpha; checkbox.Text = ""; checkbox.Size = UDim2.new(0,14,0,14)
			checkbox.Position = UDim2.new(0,0,0.5,-7); checkbox.BorderSizePixel = 0; checkbox.AutoButtonColor = false
			checkbox.Parent = row; addCorner(checkbox, UDim.new(0,3)); addStroke(checkbox)
			local checkMark = Instance.new("TextLabel"); checkMark.Name = "Mark"; checkMark.BackgroundTransparency = 1
			checkMark.Text = ""; checkMark.TextColor3 = color; checkMark.Font = Enum.Font.GothamBold; checkMark.TextSize = 10
			checkMark.Size = UDim2.new(1,0,1,0); checkMark.Parent = checkbox
			-- Register checkMark for theme refresh on axis color changes.
			table.insert(W.getThemed().axisColored, { inst = checkMark, prop = "TextColor3", axis = axis })
			row:SetAttribute("Checked", false)
			checkbox.Activated:Connect(function()
				local checked = not row:GetAttribute("Checked"); row:SetAttribute("Checked", checked)
				checkMark.Text = checked and "✓" or ""
				checkbox.BackgroundColor3 = checked and Color3.fromRGB(40,55,30) or T.BlobBg
			end)
			xOffset = 34 -- shift axis label + graph button right
		end

		local axLbl = Instance.new("TextButton"); axLbl.Name = "AxisLabel"; axLbl.BackgroundTransparency = 1
		axLbl.Text = axis; axLbl.TextColor3 = color; axLbl.Font = T.Font; axLbl.TextSize = 11
		axLbl.Size = UDim2.new(0,16,1,0); axLbl.Position = UDim2.new(0, xOffset - 18, 0, 0); axLbl.Parent = row
		if withCheckbox then axLbl.Position = UDim2.new(0, 16, 0, 0) end

		local gBtn, gFrame, selLbl = W.makeSelectButton(axis, nil, color)
		gFrame.Position = UDim2.new(0,xOffset,0,0); gFrame.Size = UDim2.new(1,-xOffset,1,0); gFrame.Parent = row
		return {row = row, axisBtn = axLbl, graphBtn = gBtn, graphFrame = gFrame, selectLabel = selLbl, checkbox = checkbox}
	end

	function W.makeAxisInputRow(parent, axis, color, order, placeholder)
		local row = Instance.new("Frame"); row.Name = axis.."Row"; row.BackgroundTransparency = 1
		row.Size = UDim2.new(1,0,0,LAYOUT.RowHeight); row.LayoutOrder = order or 0; row.Parent = parent
		local axLbl = Instance.new("TextLabel"); axLbl.Name = "AxisLabel"; axLbl.BackgroundTransparency = 1
		axLbl.Text = axis; axLbl.TextColor3 = color; axLbl.Font = T.Font; axLbl.TextSize = 11
		axLbl.Size = UDim2.new(0,16,1,0); axLbl.Parent = row
		local wrap = W.makeBlob("InputWrap", row, UDim2.new(1,-18,1,0)); wrap.Position = UDim2.new(0,18,0,0)
		local tb = Instance.new("TextBox"); tb.Name = "Input"; tb.BackgroundTransparency = 1
		tb.Text = "0, 0"; tb.PlaceholderText = placeholder or "min, max"
		tb.TextColor3 = T.BrightGold; tb.PlaceholderColor3 = T.DarkGold; tb.Font = T.Font; tb.TextSize = 10
		tb.TextXAlignment = Enum.TextXAlignment.Left; tb.ClearTextOnFocus = false
		tb.Size = UDim2.new(1,-8,1,0); tb.Position = UDim2.new(0,4,0,0); tb.BorderSizePixel = 0; tb.Parent = wrap
		return {row = row, input = tb}
	end

	-- =========================================================
	-- INLINE AXIS ROW (compact horizontal X/Y/Z toggles + Edit or Input)
	-- =========================================================

	-- axis_select: [Label] [X][Y][Z] [Edit] [...]   -  for graph properties
	function W.makeInlineAxisSelect(parent, key, axes, order)

		local row = Instance.new("Frame"); row.Name = key.."Row"; row.BackgroundTransparency = 1
		row.Size = UDim2.new(1,0,0,LAYOUT.RowHeight); row.LayoutOrder = order or 0; row.Parent = parent

		-- Axis toggle buttons (right of label area)
		local axBtns = {}
		local selected = {}
		local _onSelChanged = nil
		local btnWidth = 18
		for i, axis in ipairs(axes) do
			local color = AXIS_COLORS[axis] or T.MutedGold
			local selBg = axisSelectedBg(color)
			local ab = Instance.new("TextButton"); ab.Name = axis.."Btn"
			ab.BackgroundColor3 = T.BlobBg; ab.BackgroundTransparency = T.BlobAlpha
			ab.Text = axis; ab.TextColor3 = T.DarkGold; ab.Font = T.Font; ab.TextSize = 10
			ab.Size = UDim2.new(0,btnWidth,0,18); ab.Position = UDim2.new(0, (i-1)*(btnWidth+2), 0.5, -9)
			ab.BorderSizePixel = 0; ab.AutoButtonColor = false; ab.Parent = row
			addCorner(ab, UDim.new(0,3))
			selected[axis] = false
			ab:SetAttribute("_selected", false)
			ab.Activated:Connect(function()
				selected[axis] = not selected[axis]
				ab:SetAttribute("_selected", selected[axis])
				ab.BackgroundColor3 = selected[axis] and selBg or T.BlobBg
				ab.BackgroundTransparency = selected[axis] and 0.15 or T.BlobAlpha
				ab.TextColor3 = selected[axis] and color or T.DarkGold
				if _onSelChanged then _onSelChanged() end
			end)
			trackAxis(ab, color, selBg)
			axBtns[axis] = ab
		end

		-- Edit button (after axis buttons)
		local editOffset = #axes * (btnWidth + 2) + 2
		local editBtn, editFrame, editLbl, dotsBtn = W.makeSelectButton(key, nil, T.MutedGold)
		editFrame.Position = UDim2.new(0, editOffset, 0, 0)
		editFrame.Size = UDim2.new(1, -editOffset, 1, 0); editFrame.Parent = row

		local function getSelected()
			local result = {}
			for _, axis in ipairs(axes) do
				if selected[axis] then table.insert(result, key..axis) end
			end
			return result
		end

		local function setOnSelectionChanged(fn) _onSelChanged = fn end

		return {row = row, axisButtons = axBtns, editBtn = editBtn, editFrame = editFrame,
			selectLabel = editLbl, dotsBtn = dotsBtn, getSelected = getSelected, setOnSelectionChanged = setOnSelectionChanged}
	end

	-- axis_graph_select: [Label] [X][Y][Z] [value] [...]   -  graph-style axis properties
	function W.makeInlineAxisGraphSelect(parent, key, axes, order)

		local row = Instance.new("Frame"); row.Name = key.."Row"; row.BackgroundTransparency = 1
		row.Size = UDim2.new(1,0,0,LAYOUT.RowHeight); row.LayoutOrder = order or 0; row.Parent = parent

		local axBtns = {}
		-- selectedOrder retains click sequence: selectedOrder[1] is "primary" (the axis whose graph
		-- displays in the shared TextBox/EditButton). Differs from makeInlineAxisSelect /
		-- makeInlineAxisInput which use unordered `selected[axis]=bool` because they have no shared
		-- display field that needs a focus axis.
		local selectedOrder = {}
		local _onSelChanged = nil
		local btnWidth = 18
		local primaryStrokes = {} -- UIStroke per axis button (created on demand)

		-- Update primary axis visual indicator
		local function updatePrimaryIndicator()
			for _, axis in ipairs(axes) do
				local ab = axBtns[axis]
				if not ab then continue end
				local stroke = primaryStrokes[axis]
				if selectedOrder[1] == axis then
					-- Primary: bright stroke
					if not stroke then
						stroke = Instance.new("UIStroke"); stroke.Name = "PrimaryStroke"
						stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
						stroke.Thickness = 1.5; stroke.Parent = ab
						primaryStrokes[axis] = stroke
					end
					stroke.Color = AXIS_COLORS[axis] or T.MutedGold
					stroke.Transparency = 0.2
					stroke.Enabled = true
				else
					if stroke then stroke.Enabled = false end
				end
			end
		end

		for i, axis in ipairs(axes) do
			local color = AXIS_COLORS[axis] or T.MutedGold
			local selBg = axisSelectedBg(color)
			local ab = Instance.new("TextButton"); ab.Name = axis.."Btn"
			ab.BackgroundColor3 = T.BlobBg; ab.BackgroundTransparency = T.BlobAlpha
			ab.Text = axis; ab.TextColor3 = T.DarkGold; ab.Font = T.Font; ab.TextSize = 10
			ab.Size = UDim2.new(0,btnWidth,0,18); ab.Position = UDim2.new(0, (i-1)*(btnWidth+2), 0.5, -9)
			ab.BorderSizePixel = 0; ab.AutoButtonColor = false; ab.Parent = row
			addCorner(ab, UDim.new(0,3))
			ab:SetAttribute("_selected", false)
			ab.Activated:Connect(function()
				local wasSelected = false
				for j, a in ipairs(selectedOrder) do
					if a == axis then table.remove(selectedOrder, j); wasSelected = true; break end
				end
				if not wasSelected then
					table.insert(selectedOrder, axis)
				end
				local isOn = not wasSelected
				ab:SetAttribute("_selected", isOn)
				ab.BackgroundColor3 = isOn and selBg or T.BlobBg
				ab.BackgroundTransparency = isOn and 0.15 or T.BlobAlpha
				ab.TextColor3 = isOn and color or T.DarkGold
				updatePrimaryIndicator()
				if _onSelChanged then _onSelChanged() end
			end)
			trackAxis(ab, color, selBg)
			axBtns[axis] = ab
		end

		-- Graph-style blob (TextBox + ... button) after axis buttons
		local editOffset = #axes * (btnWidth + 2) + 2
		local blob = W.makeBlob(key.."Graph", row, UDim2.new(1,-editOffset,1,0))
		blob.Position = UDim2.new(0, editOffset, 0, 0)
		local input = Instance.new("TextBox"); input.Name = key.."Input"; input.BackgroundTransparency = 1
		input.Text = ""; input.PlaceholderText = ""
		input.TextColor3 = T.BrightGold; input.PlaceholderColor3 = T.DarkGold; input.Font = T.Font; input.TextSize = 11
		input.TextXAlignment = Enum.TextXAlignment.Left; input.ClearTextOnFocus = false
		input.Size = UDim2.new(1,-22,1,0); input.Position = UDim2.new(0,4,0,0); input.BorderSizePixel = 0; input.Parent = blob
		local dotsBtn = Instance.new("TextButton"); dotsBtn.Name = "DotsBtn"; dotsBtn.BackgroundTransparency = 1
		dotsBtn.Text = "\u{22EF}"; dotsBtn.TextColor3 = T.BrightGold; dotsBtn.TextTransparency = 0; dotsBtn.Font = T.Font; dotsBtn.TextSize = 14
		dotsBtn.Size = UDim2.new(0,18,1,0); dotsBtn.Position = UDim2.new(1,-18,0,0)
		dotsBtn.ZIndex = 3; dotsBtn.Parent = blob

		local function getSelected()
			local result = {}
			for _, axis in ipairs(selectedOrder) do
				table.insert(result, key..axis)
			end
			return result
		end

		local function getPrimary()
			if #selectedOrder > 0 then return key..selectedOrder[1] end
			return nil
		end

		local function setOnSelectionChanged(fn) _onSelChanged = fn end

		return {row = row, axisButtons = axBtns, input = input, dotsBtn = dotsBtn,
			getSelected = getSelected, getPrimary = getPrimary, setOnSelectionChanged = setOnSelectionChanged}
	end

	-- axis_input: [Label] [X][Y][Z] [input]   -  for value properties
	-- evenAttrs (optional): {X="RotXEven", Y="RotYEven", Z="RotZEven"} or similar. When
	-- present, each axis pill renders a small toggle dot in its top-right corner that
	-- toggles the matching cfg attribute. Dot is gold when ON, dark gold + transparent
	-- when OFF. Click triggers the connector (wired in PropertyInputs.luau via the
	-- exposed `evenButtons` ref). Visual state syncs from cfg in the populate pass.
	function W.makeInlineAxisInput(parent, key, axes, order, placeholder, evenAttrs)

		local row = Instance.new("Frame"); row.Name = key.."Row"; row.BackgroundTransparency = 1
		row.Size = UDim2.new(1,0,0,LAYOUT.RowHeight); row.LayoutOrder = order or 0; row.Parent = parent

		local axBtns = {}
		local evenBtns = {}
		local selected = {}
		local _onSelChanged = nil
		local btnWidth = 18
		for i, axis in ipairs(axes) do
			local color = AXIS_COLORS[axis] or T.MutedGold
			local selBg = axisSelectedBg(color)
			local ab = Instance.new("TextButton"); ab.Name = axis.."Btn"
			ab.BackgroundColor3 = T.BlobBg; ab.BackgroundTransparency = T.BlobAlpha
			ab.Text = axis; ab.TextColor3 = T.DarkGold; ab.Font = T.Font; ab.TextSize = 10
			ab.Size = UDim2.new(0,btnWidth,0,18); ab.Position = UDim2.new(0, (i-1)*(btnWidth+2), 0.5, -9)
			ab.BorderSizePixel = 0; ab.AutoButtonColor = false; ab.Parent = row
			addCorner(ab, UDim.new(0,3))
			selected[axis] = false
			ab:SetAttribute("_selected", false)
			ab.Activated:Connect(function()
				selected[axis] = not selected[axis]
				ab:SetAttribute("_selected", selected[axis])
				ab.BackgroundColor3 = selected[axis] and selBg or T.BlobBg
				ab.BackgroundTransparency = selected[axis] and 0.15 or T.BlobAlpha
				ab.TextColor3 = selected[axis] and color or T.DarkGold
				if _onSelChanged then _onSelChanged() end
			end)
			trackAxis(ab, color, selBg)
			axBtns[axis] = ab

			-- Even-distribution dot in the axis pill's top-right corner. Owned by the
			-- pill (parented to ab) so it tracks the pill's position; ZIndex bump keeps
			-- it on top of the pill's background. Click toggles its `_even` attribute;
			-- the connector reads that attribute on Activated and writes the cfg attr.
			if evenAttrs and evenAttrs[axis] then
				local dot = Instance.new("TextButton"); dot.Name = "Even"
				dot.Size = UDim2.new(0, 5, 0, 5); dot.Position = UDim2.new(1, -6, 0, 1)
				dot.BackgroundColor3 = T.DarkGold; dot.BackgroundTransparency = 0.4
				dot.Text = ""; dot.BorderSizePixel = 0; dot.AutoButtonColor = false
				dot.ZIndex = (ab.ZIndex or 1) + 1; dot.Parent = ab
				addCorner(dot, UDim.new(1, 0))
				dot:SetAttribute("_even", false)
				dot:SetAttribute("_evenAttr", evenAttrs[axis])
				dot:SetAttribute("_axis", axis)
				evenBtns[axis] = dot
				-- Register for theme refresh so DarkGold/BrightGold edits propagate without
				-- waiting for the next populate-driven refresh.
				table.insert(W.getThemed().evenDots, dot)
			end
		end

		-- Input field (after axis buttons)
		local inputOffset = #axes * (btnWidth + 2) + 2
		local inputWrap = W.makeBlob("InputWrap", row, UDim2.new(1,-inputOffset,1,0))
		inputWrap.Position = UDim2.new(0, inputOffset, 0, 0)
		local tb = Instance.new("TextBox"); tb.Name = "Input"; tb.BackgroundTransparency = 1
		tb.Text = ""; tb.PlaceholderText = placeholder or "value"
		tb.TextColor3 = T.BrightGold; tb.PlaceholderColor3 = T.DarkGold; tb.Font = T.Font; tb.TextSize = 10
		tb.TextXAlignment = Enum.TextXAlignment.Left; tb.ClearTextOnFocus = false
		tb.Size = UDim2.new(1,-8,1,0); tb.Position = UDim2.new(0,4,0,0); tb.BorderSizePixel = 0; tb.Parent = inputWrap

		local function getSelected()
			local result = {}
			for _, axis in ipairs(axes) do
				if selected[axis] then table.insert(result, key..axis) end
			end
			return result
		end

		local function setOnSelectionChanged(fn) _onSelChanged = fn end

		return {row = row, axisButtons = axBtns, evenButtons = evenBtns, input = tb,
			getSelected = getSelected, setOnSelectionChanged = setOnSelectionChanged}
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="101">
            <Properties>
              <string name="Name">WidgetEvents</string>
              <string name="Source"><![CDATA[--[[
	WidgetEvents  -  Properties-panel UI for the Events system.

	Builds a collapsible "Events" section inside the per-type Properties panel scroll.
	One row per supported event (OnEmit / OnDeath / OnDestruction / OnHit) shaped as:

		[Toggle] OnEmit
		   ├── description text
		   ├── Emit:    [Instance picker / "(unsupported)" badge]
		   ├── Mode:    [AtPosition v]
		   ├── Script:  [Run Script toggle] [ Edit Script ]
		   ├── Chain:   [depth slider 1..32]
		   └── [ Reset Event ]

	Children frame is hidden when the event Enabled attribute is false. Selection-driven
	populate calls `setEnabled` / dropdown / picker refs to reflect the per-item state.

	Returns refs structured as:

		refs.Events = {
			OnEmit = { row, toggle, fields, description, EmitTarget = {label, dotsBtn},
			           EmitMode = {dropdown, setOnChanged}, ScriptEnabled = {toggle},
			           EditScript = TextButton, ChainDepth = {input, setVal, getVal},
			           ResetEvent = TextButton },
			OnDeath = { ... },
			...
		}

	The OnHit row is omitted for types where the event has no meaning per
	`EventsSchema.isValidForTypeName` (Beam / PointLight / screens / ImageLabel). We use the
	type-name variant because the section is built once per type, before any item exists.
]]

local C = require(script.Parent.Constants)
local W = require(script.Parent.Widgets)
local T = C.T
local LAYOUT = C.LAYOUT
local EventsSchema = require(script.Parent.Parent.Part.EventsSchema)

local WidgetEvents = {}

local EVENT_LABELS = {
	OnEmit        = "On Emit",
	OnDeath       = "On Death",
	OnDestruction = "On Destruction",
	OnHit         = "On Hit",
}
local EVENT_DESCRIPTIONS = {
	OnEmit        = "Fires right after a particle clone spawns + enters the Heartbeat loop.",
	OnDeath       = "Fires when a particle's lifetime exhausts (each cycle if AnimateLoop=true).",
	OnDestruction = "Fires once just before the visual is destroyed (after PartLife linger).",
	OnHit         = "Fires per-frame on a sweep raycast hit between previous and current pose.",
}
-- Section build is per-type, not per-item, so we route through the schema's type-name
-- API. Skipping isValidForTypeName and hardcoding a local ONHIT table here would silently
-- drift the moment the schema's per-type validity changes (e.g. screen ImageLabel
-- gaining OnHit support post-v1).

local function makeBlobLabel(parent, text, size, color, font, sz)
	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.Text = text
	lbl.TextColor3 = color or T.Gold
	lbl.Font = font or T.Font
	lbl.TextSize = sz or 9
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextYAlignment = Enum.TextYAlignment.Top
	lbl.TextWrapped = true
	lbl.Size = size or UDim2.new(1, -8, 0, 18)
	lbl.Position = UDim2.new(0, 4, 0, 0)
	lbl.BorderSizePixel = 0
	lbl.Parent = parent
	lbl.AutomaticSize = Enum.AutomaticSize.Y
	return lbl
end

local function makeBlobRowSlot(parent, label, contentSize)
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.BorderSizePixel = 0
	row.Size = UDim2.new(1, 0, 0, LAYOUT.RowHeight)
	row.Parent = parent
	local lblBlob = W.makeBlob("L", row, UDim2.new(0, 60, 1, 0))
	W.makeLabel("L", lblBlob, label, T.MutedGold, T.Font, 8)
	local content = Instance.new("Frame")
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.Position = UDim2.new(0, 64, 0, 0)
	content.Size = contentSize or UDim2.new(1, -64, 1, 0)
	content.Parent = row
	return row, content
end

-- Build one event block (toggle + children). Returns the refs sub-table for that event.
local function buildEventBlock(parent, eventName, layoutOrder)
	local block = Instance.new("Frame")
	block.Name = eventName .. "Block"
	block.BackgroundTransparency = 1
	block.BorderSizePixel = 0
	block.Size = UDim2.new(1, 0, 0, 0)
	block.AutomaticSize = Enum.AutomaticSize.Y
	block.LayoutOrder = layoutOrder
	block.Parent = parent
	W.addListLayout(block, 3)

	local refs = {}

	-- Top row: toggle + label.
	local headerRow = Instance.new("Frame")
	headerRow.BackgroundTransparency = 1
	headerRow.BorderSizePixel = 0
	headerRow.Size = UDim2.new(1, 0, 0, LAYOUT.RowHeight)
	headerRow.LayoutOrder = 0
	headerRow.Parent = block
	local lblBlob = W.makeBlob("Lbl", headerRow, UDim2.new(1, -34, 1, 0))
	W.makeLabel("L", lblBlob, EVENT_LABELS[eventName] or eventName, T.Gold, T.Font, 10)
	local togBlob = W.makeBlob("TogBlob", headerRow, UDim2.new(0, 30, 1, 0))
	togBlob.Position = UDim2.new(1, -30, 0, 0)
	-- makeToggle (NOT makeToggleInBlob): the latter wraps a fresh blob sized
	-- (1, -ContentOffset, 0, RowHeight) which is wider than our 30px container and
	-- collides with the label blob to its left.
	local tog = W.makeToggle("Toggle", togBlob)
	tog.Position = UDim2.new(0.5, -14, 0.5, -8)
	refs.row = block
	refs.toggle = tog

	-- Children container  -  visibility tied to Enabled state via populate.
	local fields = Instance.new("Frame")
	fields.Name = "Fields"
	fields.BackgroundTransparency = 1
	fields.BorderSizePixel = 0
	fields.Size = UDim2.new(1, 0, 0, 0)
	fields.AutomaticSize = Enum.AutomaticSize.Y
	fields.LayoutOrder = 1
	fields.Visible = false
	fields.Parent = block
	W.addListLayout(fields, 3)
	refs.fields = fields

	-- Untrusted-import badge. Hidden by default; Populate flips visibility when any
	-- selected item has cfg.ImportedUntrusted=true. Trust permits running but does
	-- NOT enable the event (toggle stays the enable action).
	local untrustedBadge = makeBlobLabel(fields,
		"Untrusted  -  review the script, then click Trust before this can run.",
		nil, T.Red or T.Gold, T.Font, 8)
	untrustedBadge.LayoutOrder = -1
	untrustedBadge.Visible = false
	refs.UntrustedBadge = untrustedBadge

	-- Description text.
	local desc = makeBlobLabel(fields, EVENT_DESCRIPTIONS[eventName] or "", nil, T.MutedGold, T.Font, 8)
	desc.LayoutOrder = 0
	refs.description = desc

	-- Emit picker row  -  cInstancePicker label + dotsBtn. Wired by EventsConnectors.
	-- FullName label + "..." button opens the instance-picker modal.
	local pickerRow, pickerContent = makeBlobRowSlot(fields, "Emit", nil)
	pickerRow.LayoutOrder = 1
	local pickerBlob = W.makeBlob("PickW", pickerContent, UDim2.new(1, -22, 1, 0))
	local pickerLbl = Instance.new("TextLabel")
	pickerLbl.BackgroundTransparency = 1
	-- TextLabel has no PlaceholderText (Studio raises invalid-property at build time).
	-- Empty-state is communicated via the literal "(none)" with a dimmed color, swapped
	-- to the live FullName + BrightGold by Populate when an EmitTarget exists.
	pickerLbl.Text = "(none)"
	pickerLbl.TextColor3 = T.MutedGold
	pickerLbl.Font = T.Font; pickerLbl.TextSize = 9
	pickerLbl.TextXAlignment = Enum.TextXAlignment.Left
	pickerLbl.TextTruncate = Enum.TextTruncate.AtEnd
	pickerLbl.Size = UDim2.new(1, -8, 1, 0)
	pickerLbl.Position = UDim2.new(0, 4, 0, 0)
	pickerLbl.Parent = pickerBlob
	local dotsBtn = W.makeButton("Dots", pickerContent, "...", UDim2.new(0, 18, 1, 0), T.DarkGold)
	dotsBtn.Position = UDim2.new(1, -20, 0, 0)
	dotsBtn.TextSize = 11
	refs.EmitTarget = { label = pickerLbl, dotsBtn = dotsBtn }

	-- EmitMode dropdown.
	local modeRow, modeContent = makeBlobRowSlot(fields, "Mode", nil)
	modeRow.LayoutOrder = 2
	local modeBtn, modeFrame, modeSetOnChanged =
		W.makeDropdown("Mode", modeContent, { "AtPosition", "AtSource", "AtTarget", "AtCFrame" }, "AtPosition")
	modeFrame.Size = UDim2.new(1, 0, 1, 0)
	modeFrame.Position = UDim2.new(0, 0, 0, 0)
	refs.EmitMode = { dropdown = modeBtn, setOnChanged = modeSetOnChanged }

	-- Script row: Run Script toggle + Edit Script button.
	local scriptRow, scriptContent = makeBlobRowSlot(fields, "Script", nil)
	scriptRow.LayoutOrder = 3
	local seBlob = W.makeBlob("ScrTog", scriptContent, UDim2.new(0, 30, 1, 0))
	-- Same rationale as the header toggle: makeToggleInBlob's wrapper would overflow.
	local seToggle = W.makeToggle("Toggle", seBlob)
	seToggle.Position = UDim2.new(0.5, -14, 0.5, -8)
	local editBtn = W.makeButton("Edit", scriptContent, "Edit Script",
		UDim2.new(1, -36, 1, 0), T.MutedGold)
	editBtn.Position = UDim2.new(0, 36, 0, 0)
	editBtn.TextSize = 9
	refs.ScriptEnabled = { toggle = seToggle }
	refs.EditScript = editBtn

	-- ChainDepthLimit numeric input.
	local depthRow, depthContent = makeBlobRowSlot(fields, "Chain", nil)
	depthRow.LayoutOrder = 4
	local depthBlob = W.makeBlob("DW", depthContent, UDim2.new(1, 0, 1, 0))
	local depthBox = Instance.new("TextBox")
	depthBox.BackgroundTransparency = 1
	depthBox.Text = "4"
	depthBox.TextColor3 = T.BrightGold
	depthBox.Font = T.Font; depthBox.TextSize = 10
	depthBox.TextXAlignment = Enum.TextXAlignment.Center
	depthBox.ClearTextOnFocus = false
	depthBox.Size = UDim2.new(1, -8, 1, 0)
	depthBox.Position = UDim2.new(0, 4, 0, 0)
	depthBox.PlaceholderText = "1..32"
	depthBox.PlaceholderColor3 = T.DarkGold
	depthBox.BorderSizePixel = 0
	depthBox.Parent = depthBlob
	refs.ChainDepth = { input = depthBox }

	-- OnHit-only Collision dropdown. Off (default) = pass-through. Kill / Stop / Bounce
	-- change the particle's behavior at the hit point. Built only for OnHit since other
	-- events have no impact concept; OnHit itself is already restricted to Part /
	-- Attachment / Model via EventsSchema.VALID_PER_TYPE so type-gating is implicit.
	if eventName == "OnHit" then
		local collRow, collContent = makeBlobRowSlot(fields, "Collide", nil)
		collRow.LayoutOrder = 5
		local collBtn, collFrame, collSetOnChanged =
			W.makeDropdown("Collide", collContent, { "Off", "Kill", "Stop", "Bounce" }, "Off")
		collFrame.Size = UDim2.new(1, 0, 1, 0)
		collFrame.Position = UDim2.new(0, 0, 0, 0)
		refs.Collision = { dropdown = collBtn, setOnChanged = collSetOnChanged }

		-- Collision physics tunables (visible only when Collision == Bounce; Populate
		-- toggles row.Visible from the live cfg state). Kill/Stop modes don't consume
		-- these tunables so the rows stay hidden under those modes. Bounciness /
		-- Friction / Spin act as restitution / tangential damping / angular impulse
		-- coefficient respectively.
		local function makePhysicsRow(label, layoutOrder, default)
			local row, content = makeBlobRowSlot(fields, label, nil)
			row.LayoutOrder = layoutOrder
			row.Visible = false
			local blob = W.makeBlob(label .. "W", content, UDim2.new(1, 0, 1, 0))
			local box = Instance.new("TextBox")
			box.BackgroundTransparency = 1
			box.Text = tostring(default)
			box.TextColor3 = T.BrightGold
			box.Font = T.Font; box.TextSize = 10
			box.TextXAlignment = Enum.TextXAlignment.Center
			box.ClearTextOnFocus = false
			box.Size = UDim2.new(1, -8, 1, 0)
			box.Position = UDim2.new(0, 4, 0, 0)
			box.BorderSizePixel = 0
			box.Parent = blob
			return row, box
		end
		local bRow, bBox = makePhysicsRow("Bounce%",  6, 0.7)
		local fRow, fBox = makePhysicsRow("Friction", 7, 0.2)
		local sRow, sBox = makePhysicsRow("Spin",     8, 0.5)
		refs.Bounciness = { row = bRow, input = bBox }
		refs.Friction   = { row = fRow, input = fBox }
		refs.SpinAttr   = { row = sRow, input = sBox }

		-- OnHit raycast throttle. Independent of Collision mode (the OnHit fire itself
		-- gets gated, not just the bounce branch) so this row stays visible regardless
		-- of the Collision dropdown's value. 0 = check every Heartbeat tick (default,
		-- current behavior); higher values reduce per-particle raycast cost at the
		-- cost of tunneling between checks. Range clamped 0..0.5 by sanitize.
		local hRow, hBox = makePhysicsRow("HitTick", 9, 0)
		hRow.Visible = true
		refs.HitCheckInterval = { row = hRow, input = hBox }

		-- Filter row: dots-button opens the HitFilterPanel modal (Collision Group
		-- dropdown + Exclude List). Same picker-row shape as EmitTarget so the visual
		-- weight stays consistent with the existing rows.
		local fltRow, fltContent = makeBlobRowSlot(fields, "Filter", nil)
		fltRow.LayoutOrder = 10
		local fltLbl = Instance.new("TextLabel")
		fltLbl.BackgroundTransparency = 1
		fltLbl.Text = "(none)"
		fltLbl.TextColor3 = T.MutedGold
		fltLbl.Font = T.Font
		fltLbl.TextSize = 9
		fltLbl.TextXAlignment = Enum.TextXAlignment.Left
		fltLbl.TextTruncate = Enum.TextTruncate.AtEnd
		fltLbl.Size = UDim2.new(1, -24, 1, 0)
		fltLbl.Position = UDim2.new(0, 4, 0, 0)
		fltLbl.Parent = fltContent
		local fltDotsBtn = W.makeButton("Dots", fltContent, "...", UDim2.new(0, 18, 1, 0), T.DarkGold)
		fltDotsBtn.Position = UDim2.new(1, -20, 0, 0)
		fltDotsBtn.TextSize = 11
		refs.Filter = { label = fltLbl, dotsBtn = fltDotsBtn }
	end

	-- Trust Script button. Hidden by default; Populate flips visible when any selected item
	-- has cfg.ImportedUntrusted=true. EventsConnectors calls EventsSchema.trustEvent on click.
	-- Trust permits running; user still flips Enabled separately.
	local trustBtn = W.makeButton("Trust", fields, "Trust Script",
		UDim2.new(1, 0, 0, LAYOUT.RowHeight), T.Green or T.Gold)
	trustBtn.LayoutOrder = 11
	trustBtn.TextSize = 10
	trustBtn.Visible = false
	refs.TrustScript = trustBtn

	-- Reset Event button. Wired with confirm-then-fire in EventsConnectors.
	local resetBtn = W.makeButton("Reset", fields, "Reset Event",
		UDim2.new(1, 0, 0, LAYOUT.RowHeight), T.Red)
	resetBtn.LayoutOrder = 12
	resetBtn.TextSize = 10
	refs.ResetEvent = resetBtn

	return refs
end

--- Build the Events section into `scrollParent` for a given type. Returns the events
--- refs sub-table the caller stores under refs.Events. `typeName` controls which event
--- rows are shown  -  OnHit is omitted for non-collision-bearing types.
function WidgetEvents.buildEventsSection(scrollParent, typeName, layoutOrder)
	local section, body = W.makeSection(scrollParent, "Events", layoutOrder, true)
	local refs = {}
	local order = 0
	for _, eventName in ipairs(EventsSchema.EVENT_NAMES) do
		if EventsSchema.isValidForTypeName(typeName, eventName) then
			refs[eventName] = buildEventBlock(body, eventName, order)
			order += 1
		end
	end
	refs._section = section
	refs._body = body
	return refs
end

return WidgetEvents
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="102">
            <Properties>
              <string name="Name">WidgetPropToggles</string>
              <string name="Source"><![CDATA[--[[
	WidgetPropToggles  -  Part-Icles V5
	Copyright (C) 2026 Qwinkle
	Prop toggle system for Clipboard/Shifter tool panels.
	Supports checkboxes, drag-select, select-all on headers, and checkbox propagation.
	Loaded by Widgets.luau  -  receives the shared W table and adds buildPropToggles to it.
]]

local UserInputService = game:GetService("UserInputService")
local C = require(script.Parent.Constants)
local T = C.T

return function(W)

local _dragConnection = nil
local _allDragStates = {}

function W.resetDragState()
	_allDragStates = {}
	if _dragConnection then _dragConnection:Disconnect(); _dragConnection = nil end
end

-- =========================================================
-- CHECKBOX HELPERS
-- =========================================================

local function makeChk(parent)
	local c = Instance.new("TextLabel")
	c.Name = "Chk"; c.BackgroundTransparency = 1
	c.Text = "☐"; c.TextColor3 = T.DarkGold
	c.Font = T.Font; c.TextSize = 10
	c.Size = UDim2.new(0, 14, 1, 0)
	c.AnchorPoint = Vector2.new(1, 0)
	c.Position = UDim2.new(1, -2, 0, 0)
	c.ZIndex = 3; c.Parent = parent
	return c
end

local function setChk(chk, on)
	chk.Text = on and "☑" or "☐"
	chk.TextColor3 = on and T.Gold or T.DarkGold
end

-- Check if ALL descendants with "Selected" attribute are true
local function allSelected(body)
	for _, d in ipairs(body:GetDescendants()) do
		if d:GetAttribute("Selected") == false then return false end
	end
	return true
end

-- =========================================================
-- PROPERTY TOGGLE ROW
-- =========================================================

local function makePropToggle(parent, propName, layoutOrder, dragState, onChanged, displayNames)
	local row = W.makeBlob(propName .. "Tog", parent, UDim2.new(1, 0, 0, 16))
	row.LayoutOrder = layoutOrder
	row:SetAttribute("Selected", false); row:SetAttribute("PropRow", true)
	row:SetAttribute("PropKey", propName) -- raw key for clipboard/shift lookup

	local displayName = displayNames and displayNames[propName] or propName
	local label = W.makeLabel("L", row, displayName, T.MutedGold, T.Font, 8)
	label.Position = UDim2.new(0, 4, 0, 0)

	local chk = makeChk(row)

	local function apply(sel)
		row:SetAttribute("Selected", sel)
		setChk(chk, sel)
		if onChanged then onChanged() end
	end

	local btn = Instance.new("TextButton")
	btn.Name = "Click"; btn.BackgroundTransparency = 1
	btn.Text = ""; btn.Size = UDim2.new(1, 0, 1, 0); btn.Parent = row

	-- Click-drag pattern: MouseButton1Down toggles immediately AND arms drag mode in one event.
	-- Using Activated would wait for release, breaking the "click-and-sweep" UX where a drag
	-- across a row of toggles flips them all to the same state as the first-clicked toggle.
	-- dragState.mode is the new state of the FIRST click; subsequent MouseEnters apply that mode.
	btn.MouseButton1Down:Connect(function()
		local newSel = not row:GetAttribute("Selected")
		dragState.active = true; dragState.mode = newSel
		apply(newSel)
	end)

	btn.MouseEnter:Connect(function()
		-- Skip apply when row already matches drag mode. Drag-select can fire
		-- MouseEnter many times for re-entered rows; without the skip each re-entry
		-- re-runs apply → onChanged → potentially O(N) work per row, total O(N×D).
		if dragState.active and row:GetAttribute("Selected") ~= dragState.mode then
			apply(dragState.mode)
		end
	end)
end

-- =========================================================
-- SUB-SECTION (category level: "Spawning", "Appearance", etc.)
-- =========================================================

local function makeSubSection(parent, name, order)
	local container = Instance.new("Frame")
	container.Name = name:gsub("%s+", "") .. "Sub"
	container.BackgroundTransparency = 1
	container.Size = UDim2.new(1, 0, 0, 0)
	container.AutomaticSize = Enum.AutomaticSize.Y
	container.LayoutOrder = order; container.Parent = parent
	W.addListLayout(container, 0)

	-- Header blob
	local head = W.makeBlob("Header", container, UDim2.new(1, 0, 0, 18))
	head.LayoutOrder = 0

	local arrow = W.makeLabel("Arrow", head, "▶", T.DarkGold, T.Font, 7)
	arrow.Size = UDim2.new(0, 12, 1, 0); arrow.Position = UDim2.new(0, 2, 0, 0)

	W.makeLabel("Title", head, name, T.MutedGold, T.Font, 9).Position = UDim2.new(0, 14, 0, 0)

	-- Body
	local body = Instance.new("Frame")
	body.Name = "Body"; body.BackgroundTransparency = 1
	body.Size = UDim2.new(1, 0, 0, 0)
	body.AutomaticSize = Enum.AutomaticSize.Y
	body.LayoutOrder = 1; body.Visible = false; body.Parent = container
	W.addListLayout(body, 1); W.addPadding(body, 8, 2, 0, 0)

	-- Collapse toggle (arrow area only)
	local collapseBtn = Instance.new("TextButton")
	collapseBtn.Name = "Toggle"; collapseBtn.BackgroundTransparency = 1
	collapseBtn.Text = ""; collapseBtn.Size = UDim2.new(0, 14, 1, 0); collapseBtn.Parent = head
	collapseBtn.Activated:Connect(function()
		body.Visible = not body.Visible
		arrow.Text = body.Visible and "▼" or "▶"
	end)

	return body, head
end

-- =========================================================
-- SELECT-ALL WIRING (for both type and sub-section headers)
-- =========================================================

local function wireSelectAll(head, body, arrowWidth, onChanged)
	local hchk = makeChk(head)

	-- Select-all button covers title area (right of arrow)
	local aw = arrowWidth or 18
	local selBtn = Instance.new("TextButton")
	selBtn.Name = "SelectAll"; selBtn.BackgroundTransparency = 1; selBtn.Text = ""
	selBtn.Size = UDim2.new(1, -aw, 1, 0)
	selBtn.Position = UDim2.new(0, aw, 0, 0)
	selBtn.ZIndex = 2; selBtn.Parent = head

	selBtn.Activated:Connect(function()
		-- Determine target state: if any unselected → select all, else deselect all
		local on = not allSelected(body)

		-- Expand on select, collapse on deselect
		local ar = head:FindFirstChild("Arrow")
		body.Visible = on
		if ar then ar.Text = on and "▼" or "▶" end

		-- Apply to all property toggles and all nested checkboxes
		for _, d in ipairs(body:GetDescendants()) do
			if d:GetAttribute("Selected") ~= nil then d:SetAttribute("Selected", on) end
			if d.Name == "Chk" and d:IsA("TextLabel") then setChk(d, on) end
		end
		setChk(hchk, on)

		-- Notify parent to recompute its checkbox
		if onChanged then onChanged() end
	end)

	-- Return the checkbox so parent can refresh it
	return hchk
end

-- =========================================================
-- REFRESH HELPERS (checkbox propagation up the tree)
-- =========================================================

local function makeRefresher(body, chk)
	return function()
		setChk(chk, allSelected(body))
	end
end

-- =========================================================
-- PUBLIC: buildPropToggles
-- =========================================================

function W.buildPropToggles(parent, propList, sectionName, order, displayNames)
	local container, body, head = W.makeSection(parent, sectionName, order, false)

	-- Shared drag state for this type section
	local dragState = { active = false, mode = false }
	table.insert(_allDragStates, dragState)
	if not _dragConnection then
		_dragConnection = UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				for _, ds in ipairs(_allDragStates) do ds.active = false end
			end
		end)
	end

	-- Type-level select-all (wired after sub-sections so propagation works)
	local typeChk = wireSelectAll(head, body)
	local refreshTypeChk = makeRefresher(body, typeChk)

	if #propList > 0 and type(propList[1]) == "table" then
		-- Sectioned clipboard: array of {name, props}
		for si, sec in ipairs(propList) do
			local secBody, secHead = makeSubSection(body, sec.name, si)
			local secChk = wireSelectAll(secHead, secBody, 14, refreshTypeChk)
			local refreshSecChk = makeRefresher(secBody, secChk)

			-- When a property changes → refresh category checkbox → refresh type checkbox
			local function onPropChanged()
				refreshSecChk()
				refreshTypeChk()
			end

			for pi, pn in ipairs(sec.props) do
				makePropToggle(secBody, pn, pi, dragState, onPropChanged, displayNames)
			end
		end
	else
		-- Flat list fallback
		for i, pn in ipairs(propList) do
			makePropToggle(body, pn, i, dragState, refreshTypeChk, displayNames)
		end
	end

	return container
end

end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="103">
            <Properties>
              <string name="Name">WidgetSections</string>
              <string name="Source"><![CDATA[--[[
	WidgetSections  -  Part-Icles V5
	Copyright (C) 2026 Qwinkle
	Section, expandable, slider, prop toggles, and buildTypeSection.
	Loaded by Widgets.luau  -  receives the shared W table and adds functions to it.
]]

local UserInputService = game:GetService("UserInputService")
local C = require(script.Parent.Constants)
local T = C.T
local LAYOUT = C.LAYOUT

return function(W)
	local addCorner, addStroke, addPadding, addListLayout = W.addCorner, W.addStroke, W.addPadding, W.addListLayout
	-- Call W.getUISConnections() fresh at each site  -  reset() replaces the table.

	-- Read-only path display for EmitParent
	function W.makePathLabel(name, parent)
		local f = W.makeBlob(name.."Wrap", parent, UDim2.new(1,-LAYOUT.ContentOffset,0,LAYOUT.RowHeight))
		local lbl = Instance.new("TextLabel"); lbl.Name = name; lbl.BackgroundTransparency = 1
		lbl.Text = "none"; lbl.TextColor3 = T.DarkGold; lbl.Font = T.Font; lbl.TextSize = 9
		lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.TextTruncate = Enum.TextTruncate.AtEnd
		lbl.Size = UDim2.new(1,-8,1,0); lbl.Position = UDim2.new(0,4,0,0); lbl.Parent = f
		return lbl, f
	end

	-- Shared floating dots menu (created once per Build, repositioned on each open)
	function W.buildDotsMenu(screenGui)
		local menu = Instance.new("Frame"); menu.Name = "DotsMenu"
		menu.BackgroundColor3 = T.PanelBg; menu.BackgroundTransparency = 0.05
		menu.Size = UDim2.new(0,90,0,0); menu.AutomaticSize = Enum.AutomaticSize.Y
		menu.Visible = false; menu.ZIndex = 20; menu.Parent = screenGui
		addCorner(menu, T.Corner); addStroke(menu); addPadding(menu,3,3,3,3); addListLayout(menu, 2)

		local refs = {}
		local function makeMenuItem(name, text, lo)
			local btn = Instance.new("TextButton"); btn.Name = name
			btn.BackgroundColor3 = T.BlobBg; btn.BackgroundTransparency = T.BlobAlpha
			btn.Text = text; btn.TextColor3 = T.MutedGold; btn.Font = T.Font; btn.TextSize = 9
			btn.Size = UDim2.new(1,0,0,18); btn.BorderSizePixel = 0; btn.LayoutOrder = lo
			btn.AutoButtonColor = true; btn.Parent = menu; addCorner(btn, UDim.new(0,3)); table.insert(W.getThemed().blobs, btn)
			return btn
		end
		refs.CopyBtn = makeMenuItem("Copy", "Copy graph", 0)
		refs.PasteBtn = makeMenuItem("Paste", "Paste graph", 1)
		refs.ResetBtn = makeMenuItem("Reset", "Reset default", 2)
		refs.Menu = menu
		return refs
	end

	-- =========================================================
	-- TOOL PANEL TEMPLATE
	-- =========================================================
	function W.makeToolPanel(sg, name, w, h)
		local panel = Instance.new("Frame"); panel.Name = name.."Panel"
		panel.BackgroundColor3 = T.PanelBg; panel.BackgroundTransparency = T.PanelAlpha
		panel.Size = UDim2.new(0,w,0,h); panel.ClipsDescendants = true; panel.Active = true; panel.Visible = false; panel.Parent = sg
		addCorner(panel, T.BigCorner); addStroke(panel); addPadding(panel,5,5,5,5)
		table.insert(W.getThemed().panels, panel)
		W.attachPanelBackground(panel)
		local hd = W.makeBlob("Hd", panel, UDim2.new(1,0,0,18)); hd.Position = UDim2.new(0,0,0,0); hd.ZIndex = 10
		local t = Instance.new("TextLabel"); t.BackgroundTransparency = 1; t.Text = name
		t.TextColor3 = T.Gold; t.Font = T.Font; t.TextSize = 10; t.TextXAlignment = Enum.TextXAlignment.Left
		t.Size = UDim2.new(1,-16,1,0); t.Position = UDim2.new(0,4,0,0); t.Parent = hd
		local cb = Instance.new("TextButton"); cb.Name = "Close"; cb.BackgroundTransparency = 1
		cb.Text = "X"; cb.TextColor3 = T.DarkGold; cb.Font = T.Font; cb.TextSize = 9
		cb.Size = UDim2.new(0,12,1,0); cb.Position = UDim2.new(1,-14,0,0); cb.ZIndex = 12; cb.Parent = hd
		cb.Activated:Connect(function() panel.Visible = false end)
		local dg = Instance.new("TextButton"); dg.BackgroundTransparency = 1; dg.Text = ""
		dg.Size = UDim2.new(1,-16,1,0); dg.ZIndex = 11; dg.Parent = hd; W.makeDraggable(panel, dg)
		W.makeResizable(panel, math.max(w, 80), 40)
		return panel
	end

	function W.makeSection(parent, sectionName, order, startCollapsed)
		local container = Instance.new("Frame"); container.Name = sectionName:gsub("%s+","").."Section"
		container.BackgroundTransparency = 1; container.Size = UDim2.new(1,0,0,0)
		container.AutomaticSize = Enum.AutomaticSize.Y; container.LayoutOrder = order; container.Parent = parent
		addListLayout(container, 0)
		local head = W.makeBlob("Header", container, UDim2.new(1,0,0,LAYOUT.SectionHead)); head.LayoutOrder = 0
		local arrow = Instance.new("TextLabel"); arrow.Name = "Arrow"; arrow.BackgroundTransparency = 1
		arrow.Text = startCollapsed and "▶" or "▼"; arrow.TextColor3 = T.DarkGold; arrow.Font = T.Font; arrow.TextSize = 8
		arrow.Size = UDim2.new(0,14,1,0); arrow.Position = UDim2.new(0,4,0,0); arrow.Parent = head
		local title = Instance.new("TextLabel"); title.Name = "Title"; title.BackgroundTransparency = 1
		title.Text = sectionName; title.TextColor3 = T.Gold; title.Font = T.Font; title.TextSize = 11
		title.TextXAlignment = Enum.TextXAlignment.Left; title.Size = UDim2.new(1,-20,1,0); title.Position = UDim2.new(0,18,0,0); title.Parent = head
		local body = Instance.new("Frame"); body.Name = "Body"; body.BackgroundTransparency = 1
		body.Size = UDim2.new(1,0,0,0); body.AutomaticSize = Enum.AutomaticSize.Y
		body.LayoutOrder = 1; body.Visible = not startCollapsed; body.Parent = container
		addListLayout(body, 3); addPadding(body, 4, 4, 4, 4)
		local hb = Instance.new("TextButton"); hb.Name = "Toggle"; hb.BackgroundTransparency = 1; hb.Text = ""
		hb.Size = UDim2.new(1,0,1,0); hb.Parent = head
		hb.Activated:Connect(function() body.Visible = not body.Visible; arrow.Text = body.Visible and "▼" or "▶" end)
		return container, body, head
	end

	function W.makeExpandable(parent, labelText, children, order, hasBatchEdit)
		local outerBlob = W.makeBlob(labelText:gsub("%s+","").."Blob", parent, UDim2.new(1,0,0,0))
		outerBlob.AutomaticSize = Enum.AutomaticSize.Y; outerBlob.LayoutOrder = order or 0

		local wrapper = Instance.new("Frame"); wrapper.Name = labelText:gsub("%s+","").."Expandable"
		wrapper.BackgroundTransparency = 1; wrapper.Size = UDim2.new(1,0,0,0)
		wrapper.AutomaticSize = Enum.AutomaticSize.Y; wrapper.Parent = outerBlob
		addListLayout(wrapper, 3); addPadding(wrapper, 4, 4, 3, 3)

		local headerRow = Instance.new("Frame"); headerRow.Name = "HeaderRow"; headerRow.BackgroundTransparency = 1
		headerRow.Size = UDim2.new(1,0,0,20); headerRow.LayoutOrder = 0; headerRow.Parent = wrapper

		local arrow = Instance.new("TextLabel"); arrow.Name = "Arrow"; arrow.BackgroundTransparency = 1
		arrow.Text = "▶"; arrow.TextColor3 = T.DarkGold; arrow.Font = T.Font; arrow.TextSize = 8
		arrow.Size = UDim2.new(0,12,1,0); arrow.Position = UDim2.new(0,0,0,0); arrow.Parent = headerRow

		local lbl = W.makeLabel("Label", headerRow, labelText, T.MutedGold, T.Font, 10)

		local batchBtn = nil
		if hasBatchEdit then
			lbl.Size = UDim2.new(1,-60,1,0); lbl.Position = UDim2.new(0,14,0,0)
			batchBtn = Instance.new("TextButton"); batchBtn.Name = "BatchEdit"
			batchBtn.BackgroundColor3 = T.BlobBg; batchBtn.BackgroundTransparency = T.BlobAlpha
			batchBtn.Text = "Edit Sel."; batchBtn.TextColor3 = T.MutedGold; batchBtn.Font = T.Font; batchBtn.TextSize = 8
			batchBtn.Size = UDim2.new(0,44,0,16); batchBtn.Position = UDim2.new(1,-46,0,2)
			batchBtn.BorderSizePixel = 0; batchBtn.ZIndex = 3; batchBtn.Parent = headerRow
			addCorner(batchBtn, UDim.new(0,4)); addStroke(batchBtn); table.insert(W.getThemed().blobs, batchBtn)
		else
			lbl.Size = UDim2.new(1,-14,1,0); lbl.Position = UDim2.new(0,14,0,0)
		end

		-- When hasBatchEdit, batchBtn occupies the right ~50px. clickBtn covers
		-- everything EXCEPT that area (1, -50, 1, 0) so the row header has no
		-- dead-zone where clicks go nowhere.
		local clickBtn = Instance.new("TextButton"); clickBtn.Name = "ClickExpand"; clickBtn.BackgroundTransparency = 1
		clickBtn.Text = ""; clickBtn.Size = hasBatchEdit and UDim2.new(1,-50,1,0) or UDim2.new(1,0,1,0); clickBtn.Parent = headerRow

		local subBody = Instance.new("Frame"); subBody.Name = "SubBody"; subBody.BackgroundTransparency = 1
		subBody.Size = UDim2.new(1,0,0,0); subBody.AutomaticSize = Enum.AutomaticSize.Y
		subBody.Visible = false; subBody.LayoutOrder = 1; subBody.Parent = wrapper; addListLayout(subBody, 3)

		local elements = {}
		for i, child in ipairs(children) do elements[child.key or child.label] = child.builder(subBody, i) end
		clickBtn.Activated:Connect(function() subBody.Visible = not subBody.Visible; arrow.Text = subBody.Visible and "▼" or "▶" end)

		-- Helper to get checked axes (for batch editing)
		local getCheckedAxes = nil
		if hasBatchEdit then
			getCheckedAxes = function()
				local checked = {}
				for _, child in ipairs(children) do
					local key = child.key or child.label
					local elem = elements[key]
					if elem and elem.row and elem.row:GetAttribute("Checked") then
						table.insert(checked, key)
					end
				end
				return checked
			end
		end

		return outerBlob, elements, batchBtn, getCheckedAxes
	end

	-- =========================================================
	-- SLIDER
	-- =========================================================
	function W.makeSlider(parent, minVal, maxVal, defaultVal, onChanged, fmt, logScale)
		fmt = fmt or "%.2f"
		local c = Instance.new("Frame"); c.Name = "Slider"; c.BackgroundTransparency = 1
		c.Size = UDim2.new(1,0,0,28); c.Parent = parent
		local valLbl = Instance.new("TextBox"); valLbl.Name = "Val"; valLbl.BackgroundTransparency = 1
		valLbl.Text = string.format(fmt, defaultVal); valLbl.TextColor3 = T.BrightGold
		valLbl.Font = T.Font; valLbl.TextSize = 16; valLbl.TextXAlignment = Enum.TextXAlignment.Center
		valLbl.Size = UDim2.new(1,0,0,16); valLbl.ClearTextOnFocus = false; valLbl.BorderSizePixel = 0; valLbl.Parent = c
		local track = W.makeBlob("Track", c, UDim2.new(1,-4,0,6)); track.Position = UDim2.new(0,2,0,18)
		local fill = Instance.new("Frame"); fill.Name = "Fill"; fill.BackgroundColor3 = T.SliderFill or Color3.fromRGB(180,60,60)
		fill.BackgroundTransparency = 0.3; fill.BorderSizePixel = 0; fill.Size = UDim2.new(0.5,0,1,0); fill.Parent = track
		addCorner(fill, UDim.new(0,3)); table.insert(W.getThemed().fills, fill)
		local handle = Instance.new("TextButton"); handle.Name = "Handle"
		handle.BackgroundColor3 = T.BrightGold; handle.BackgroundTransparency = 0.1
		handle.Text = ""; handle.Size = UDim2.new(0,8,0,10); handle.Position = UDim2.new(0.5,-4,0,-2)
		handle.BorderSizePixel = 0; handle.Parent = track; addCorner(handle, UDim.new(0,4))
		-- Log-scale helpers (for multiplicative sliders like resize/retime: 0.5x–2x with 1x centered)
		local logRatio = logScale and math.log(maxVal / minVal) or 0
		local function valToAlpha(v)
			if logScale then return math.clamp(math.log(v / minVal) / logRatio, 0, 1) end
			return math.clamp((v - minVal) / (maxVal - minVal), 0, 1)
		end
		local function alphaToVal(a)
			if logScale then return minVal * math.exp(a * logRatio) end
			return minVal + (maxVal - minVal) * a
		end
		local cur = defaultVal
		local function setVal(v, silent)
			cur = v
			local a = valToAlpha(v); fill.Size = UDim2.new(a,0,1,0)
			handle.Position = UDim2.new(a,-4,0,-2); valLbl.Text = string.format(fmt, v)
			if not silent and onChanged then onChanged(v) end
		end
		local dragging = false
		local function upd(input) local ap = track.AbsolutePosition.X; local as = track.AbsoluteSize.X
			if as == 0 then return end; setVal(alphaToVal(math.clamp((input.Position.X-ap)/as,0,1)))
		end
		handle.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end end)
		handle.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
		track.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; upd(i) end end)
		local c1 = UserInputService.InputChanged:Connect(function(i) if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then upd(i) end end)
		local c2 = UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
		local uisC = W.getUISConnections(); table.insert(uisC, c1); table.insert(uisC, c2)
		-- Manual text input: allow values outside slider range (negatives + zero too); visual clamps to edges.
		valLbl.FocusLost:Connect(function() local raw = valLbl.Text:gsub("[^%d%.%-]",""); local n = tonumber(raw); if n then setVal(n) end end)
		setVal(defaultVal, true)
		return c, valLbl, setVal, function() return cur end
	end
	-- Row type dispatch table for buildTypeSection (replaces 130-line if-elseif chain)
	local ROW_BUILDERS = {}
	ROW_BUILDERS.select = function(r, sb, d, ri)
		r[d.key] = {}; W.makeRow(sb, d.label, function(p)
			local btn, frame, selLbl, dotsBtn = W.makeSelectButton(d.key, nil, d.color)
			frame.Parent = p; r[d.key].graphBtn = btn; r[d.key].selectLabel = selLbl; r[d.key].dotsBtn = dotsBtn; return frame
		end, ri)
	end
	ROW_BUILDERS.graph = function(r, sb, d, ri)
		r[d.key] = {}; W.makeRow(sb, d.label, function(p)
			local refs = W.makeGraphRow(d.key, nil); refs.frame.Parent = p; r[d.key] = refs; return refs.frame
		end, ri)
	end
	ROW_BUILDERS.color = function(r, sb, d, ri)
		r[d.key] = {}; W.makeRow(sb, d.label, function(p)
			local refs = W.makeColorRow(d.key, nil); refs.frame.Parent = p; r[d.key] = refs; return refs.frame
		end, ri)
	end
	-- input/toggle/dropdown row builders expose the row Frame as r[d.key].row so callers can
	-- show/hide a row without walking the brittle `widget.Parent.Parent.Visible` chain  -  that
	-- chain breaks if anyone ever inserts an extra wrapper layer between the widget and the row.
	-- W.makeRow returns the row Frame as its first return value; we capture and store it.
	ROW_BUILDERS.input = function(r, sb, d, ri)
		r[d.key] = {}
		local row = W.makeRow(sb, d.label, function(p)
			local tb, frame = W.makeInput(d.key, nil, d.default or "0", d.placeholder)
			frame.Parent = p
			r[d.key].input = tb
			return frame
		end, ri)
		r[d.key].row = row
	end
	ROW_BUILDERS.toggle = function(r, sb, d, ri)
		r[d.key] = {}
		local row = W.makeRow(sb, d.label, function(p)
			local tog, wrap = W.makeToggleInBlob(d.key.."Toggle", nil)
			wrap.Parent = p
			r[d.key].toggle = tog
			return wrap
		end, ri)
		r[d.key].row = row
	end
	ROW_BUILDERS.dropdown = function(r, sb, d, ri)
		r[d.key] = {}
		local row = W.makeRow(sb, d.label, function(p)
			local btn, frame, soc = W.makeDropdown(d.key, nil, d.options, d.default)
			frame.Parent = p
			r[d.key].dropdown = btn
			r[d.key].setOnChanged = soc
			return frame
		end, ri)
		r[d.key].row = row
	end
	ROW_BUILDERS.expandable_select = function(r, sb, d, ri)
		local ac = {}; for _, a in ipairs({"X","Y","Z"}) do
			table.insert(ac, {key=d.key..a, label=a, builder=function(p,i) return W.makeAxisGraphRow(p,a,T["Axis"..a],i,true) end})
		end
		local _, elems, batchBtn, getChecked = W.makeExpandable(sb, d.label, ac, ri, true)
		for _, a in ipairs({"X","Y","Z"}) do r[d.key..a] = elems[d.key..a] end
		r[d.key.."_batchBtn"] = batchBtn; r[d.key.."_getChecked"] = getChecked
	end
	ROW_BUILDERS.expandable_input = function(r, sb, d, ri)
		local ac = {}; for _, a in ipairs({"X","Y","Z"}) do
			table.insert(ac, {key=d.key..a, label=a, builder=function(p,i) return W.makeAxisInputRow(p,a,T["Axis"..a],i,d.placeholder) end})
		end
		local _, elems = W.makeExpandable(sb, d.label, ac, ri)
		for _, a in ipairs({"X","Y","Z"}) do r[d.key..a] = elems[d.key..a] end
	end
	-- Adds a small `*` config-icon button to the row's LabelBlob and stores it on the row's ref
	-- table. Caller (PropertyInputs / Connectors) wires the click via Connectors.cConfigButton.
	-- Shared between path rows and axis rows so any `config={...}` row gets a clickable gear.
	local function addConfigCog(refTable, rowFrame, d)
		if not d.config then return end
		local labelBlob = rowFrame:FindFirstChild("LabelBlob")
		if not labelBlob then return end
		local cog = Instance.new("TextButton"); cog.Name = d.key .. "ConfigBtn"
		cog.BackgroundColor3 = T.BlobBg; cog.BackgroundTransparency = T.BlobAlpha
		cog.Text = "*"; cog.TextColor3 = T.BrightGold; cog.Font = T.Font; cog.TextSize = 11
		cog.Size = UDim2.new(0, 16, 0, 16); cog.AnchorPoint = Vector2.new(0, 0.5)
		cog.Position = UDim2.new(0, 2, 0.5, 0); cog.BorderSizePixel = 0
		cog.Parent = labelBlob
		addCorner(cog, UDim.new(0, 3))
		local labelInst = labelBlob:FindFirstChild("Label")
		if labelInst then labelInst.Position = UDim2.new(0, 22, 0, 0); labelInst.Size = UDim2.new(1, -22, 1, 0) end
		refTable.configBtn = cog
		refTable.configKind = d.config
	end

	local function buildInlineAxis(r, sb, d, ri, maker)
		local axes = d.axes or {"X","Y","Z"}
		-- evenAttrs travels via the row's config table (the same place axis-link metadata
		-- lives) since both features extend the axis-input row in tandem. Only the value-
		-- input maker (makeInlineAxisInput) consumes it; passing through to graph_select /
		-- axis_select is a no-op since those don't read the 6th arg.
		local evenAttrs = d.config and d.config.evenAttrs or nil
		W.makeRow(sb, d.label, function(p)
			local refs = maker(p, d.key, axes, ri, d.placeholder, evenAttrs)
			refs.row.Size = UDim2.new(1,0,1,0); refs.row.Position = UDim2.new(0,0,0,0); r[d.key] = refs
			addConfigCog(r[d.key], p, d)
			return refs.row
		end, ri)
	end
	ROW_BUILDERS.axis_select = function(r, sb, d, ri) buildInlineAxis(r, sb, d, ri, W.makeInlineAxisSelect) end
	ROW_BUILDERS.axis_graph_select = function(r, sb, d, ri) buildInlineAxis(r, sb, d, ri, W.makeInlineAxisGraphSelect) end
	ROW_BUILDERS.axis_input = function(r, sb, d, ri) buildInlineAxis(r, sb, d, ri, W.makeInlineAxisInput) end
	ROW_BUILDERS.toggle_group = function(r, sb, d, ri)
		r[d.key] = {}; W.makeRow(sb, d.label, function(p)
			local tog, wrap = W.makeToggleInBlob(d.key.."Toggle", nil); wrap.Parent = p; r[d.key].toggle = tog; return wrap
		end, ri)
		if d.children then
			local cf = Instance.new("Frame"); cf.Name = d.key.."Fields"; cf.BackgroundTransparency = 1
			cf.Size = UDim2.new(1,0,0,0); cf.AutomaticSize = Enum.AutomaticSize.Y; cf.LayoutOrder = ri + 100
			cf.Parent = sb; addListLayout(cf, 3); r[d.key].fields = cf
			for ci, cDef in ipairs(d.children) do
				local cb = ROW_BUILDERS[cDef.type]
				if cb then cb(r, cf, cDef, ci) end
			end
		end
	end
	ROW_BUILDERS.path = function(r, sb, d, ri)
		r[d.key] = {}; W.makeRow(sb, d.label, function(p)
			local lbl, frame = W.makePathLabel(d.key, nil); frame.Parent = p; r[d.key].label = lbl
			addConfigCog(r[d.key], p, d)
			return frame
		end, ri)
	end
	ROW_BUILDERS.wip = function(r, sb, d, ri)
		r[d.key] = {}; W.makeRow(sb, d.label, function(p)
			local f = W.makeBlob(d.key.."Wip", nil, UDim2.new(1,-LAYOUT.ContentOffset,0,LAYOUT.RowHeight))
			local lbl = Instance.new("TextLabel"); lbl.BackgroundTransparency = 1; lbl.Text = "WIP"
			lbl.TextColor3 = T.DarkGold; lbl.Font = T.Font; lbl.TextSize = 9
			lbl.TextXAlignment = Enum.TextXAlignment.Center; lbl.Size = UDim2.new(1,0,1,0); lbl.Parent = f
			f.Parent = p; return f
		end, ri)
	end

	function W.buildTypeSection(scrollParent, typeName, propDefs, order)
		local typeContainer, typeBody = W.makeSection(scrollParent, typeName, order, false)
		local r = {}
		for si, secDef in ipairs(propDefs) do
			local _, secBody = W.makeSection(typeBody, secDef.name, si, secDef.collapsed)
			for ri, rowDef in ipairs(secDef.rows) do
				local builder = ROW_BUILDERS[rowDef.type]
				if builder then builder(r, secBody, rowDef, ri) end
			end
		end
		return typeContainer, r
	end

	function W.addCollapseButton(header, bodyItems, opts)
		opts = opts or {}
		local arrow = Instance.new("TextButton"); arrow.Name = "CollapseArrow"
		arrow.BackgroundTransparency = 1; arrow.Text = "▼"; arrow.TextColor3 = T.DarkGold
		arrow.Font = T.Font; arrow.TextSize = 8; arrow.Size = UDim2.new(0,14,1,0)
		if not opts.anchorLeft then arrow.AnchorPoint = Vector2.new(1,0) end
		arrow.Position = opts.arrowPos or UDim2.new(1,-16,0,0)
		arrow.ZIndex = 3; arrow.Parent = header
		local expanded = true
		local lastExpandedSize = opts.expandedSize -- track actual size (updated on collapse)
		arrow.Activated:Connect(function()
			expanded = not expanded
			arrow.Text = expanded and "▼" or "▶"
			for _, item in ipairs(bodyItems) do item.Visible = expanded end
			if opts.panel and lastExpandedSize then
				local colW = opts.collapsedSize and opts.collapsedSize.X.Offset or lastExpandedSize.X.Offset
				local colH = opts.collapsedSize and opts.collapsedSize.Y.Offset or 38
				if expanded then
					opts.panel.Size = lastExpandedSize
				else
					-- Save current size before collapsing (may have been resized by user)
					lastExpandedSize = opts.panel.Size
					opts.panel.Size = UDim2.new(0, colW, 0, colH)
				end
				local expH = lastExpandedSize.Y.Offset
				local delta = expH - colH
				-- Keep top edge stable for bottom-anchored panels (AnchorPoint.Y > 0)
				if opts.panel.AnchorPoint.Y > 0 then
					local p = opts.panel.Position
					local shift = expanded and delta or -delta
					opts.panel.Position = UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset + shift)
				end
			end
		end)
		return arrow
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">Widgets</string>
              <string name="Source"><![CDATA[--[[
	UIWidgets  -  Part-Icles V5
	Copyright (C) 2026 Qwinkle
	Reusable widget factories, theme tracking, drag/snap system.
	Requires UIBuilderConstants for T and LAYOUT references.
]]

local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local C = require(script.Parent.Constants)
local T = C.T
local LAYOUT = C.LAYOUT

local Widgets = {}

-- Themed element tracking (cleared on reset)
-- axisColored  -  list of {inst, axisName} for non-button elements (e.g. checkmarks,
-- strokes inside axis rows) that follow the AxisX/Y/Z theme colors. Refreshed by
-- UpdateTheme.
-- evenDots: list of EvenDistribution per-axis dot buttons that follow T.BrightGold
-- (on) / T.DarkGold (off) based on `_even` attribute. Without theme registration,
-- theme edits leave the dots stuck on initial-time colors until the next
-- selection-change refresh.
local _themed = { panels = {}, strokes = {}, fills = {}, blobs = {}, texts = {}, scrollbars = {}, toggles = {}, axisButtons = {}, axisColored = {}, panelImages = {}, evenDots = {} }
local _uisConnections = {}
local _allPanels = {}

function Widgets.reset()
	for _, conn in ipairs(_uisConnections) do conn:Disconnect() end
	_uisConnections = {}
	_themed = { panels = {}, strokes = {}, fills = {}, blobs = {}, texts = {}, scrollbars = {}, toggles = {}, axisButtons = {}, axisColored = {}, panelImages = {}, evenDots = {} }
	_allPanels = {}
	if Widgets.resetDragState then Widgets.resetDragState() end
end

function Widgets.getThemed() return _themed end
function Widgets.getAllPanels() return _allPanels end
function Widgets.getUISConnections() return _uisConnections end

-- =========================================================
-- LOW-LEVEL HELPERS
-- =========================================================
function Widgets.addCorner(p, r) local c = Instance.new("UICorner"); c.CornerRadius = r or T.Corner; c.Parent = p; return c end
function Widgets.addStroke(p) local s = Instance.new("UIStroke"); s.Color = T.Border; s.Transparency = T.BorderAlpha; s.Thickness = 1; s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = p; table.insert(_themed.strokes, s); return s end
function Widgets.addPadding(p, l, r, t, b) local pd = Instance.new("UIPadding"); pd.PaddingLeft = UDim.new(0,l or 6); pd.PaddingRight = UDim.new(0,r or 6); pd.PaddingTop = UDim.new(0,t or 6); pd.PaddingBottom = UDim.new(0,b or 6); pd.Parent = p; return pd end
function Widgets.addListLayout(p, pad, dir, hA) local l = Instance.new("UIListLayout"); l.Padding = UDim.new(0,pad or 4); l.FillDirection = dir or Enum.FillDirection.Vertical; l.HorizontalAlignment = hA or Enum.HorizontalAlignment.Left; l.SortOrder = Enum.SortOrder.LayoutOrder; l.Parent = p; return l end

-- Decorative full-bleed background image for a panel. ZIndex=0 sits behind every default-
-- ZIndex sibling under the global Sibling ZIndexBehavior. Image + ImageTransparency driven by
-- T.BgImage / T.BgImageTransparency through UpdateTheme; the live ImageLabel is registered in
-- _themed.panelImages so theme refresh can reapply both fields on each change.
--
-- AutomaticSize panels (Settings, Properties, Theme Editor, HUD) can't host the ImageLabel
-- as a child with Size.Y.Scale=1 because UIListLayout's AbsoluteContentSize sums children's
-- AbsoluteSize.Y, AutomaticSize.Y grows the panel to that sum, ImageLabel grows with it,
-- AbsoluteContentSize grows again  -  divergent every frame. Park the ImageLabel as a SIBLING
-- of the panel inside the same ScreenGui ancestor and mirror Position / Size / Visible via
-- property-changed signals. UIScale on the ScreenGui scales render-time, so we divide the
-- absolute pixel coords by `_getScale(panel)` to keep overlay pixel-accurate.
function Widgets.attachPanelBackground(panel)
	-- Sibling overlay for ALL panels  -  never a child of the panel. Reasons:
	--   - Panels with UIListLayout would lay out the child ImageLabel into a layout slot,
	--     and AnchorPoint=(0.5,0.5)+Size=(1,0,1,0) would render half outside the panel.
	--   - AutomaticSize.Y panels would feedback-loop with a Size.Y.Scale=1 child.
	-- Park the overlay at the ScreenGui ancestor; mirror Position / Size / Visible via
	-- property-changed signals. UIScale.Scale divides absolute coords so the overlay
	-- stays pixel-aligned with the panel underneath.
	local img = Instance.new("ImageLabel")
	img.Name = "PanelBackgroundImage"
	img.BackgroundTransparency = 1
	img.BorderSizePixel = 0
	img.ZIndex = 0
	img.AnchorPoint = Vector2.new(0, 0)
	img.Image = T.BgImage or ""
	img.ImageTransparency = T.BgImageTransparency or 1
	img.ScaleType = Enum.ScaleType.Stretch
	img.Visible = panel.Visible
	-- Match the panel's rounded corners so the overlay doesn't render as a square past
	-- the panel's UICorner edges. Read the panel's own UICorner radius if present, else
	-- default to BigCorner (most panels use BigCorner).
	local panelCorner = panel:FindFirstChildOfClass("UICorner")
	local imgCorner = Instance.new("UICorner")
	imgCorner.CornerRadius = panelCorner and panelCorner.CornerRadius or T.BigCorner
	imgCorner.Parent = img
	local function sync()
		if not panel.Parent then img.Visible = false; return end
		local sg = panel:FindFirstAncestorOfClass("ScreenGui")
		if not sg then img.Visible = false; return end
		if img.Parent ~= sg then img.Parent = sg end
		local us = sg:FindFirstChildOfClass("UIScale")
		local sc = (us and us.Scale ~= 0) and us.Scale or 1
		img.Position = UDim2.fromOffset(panel.AbsolutePosition.X / sc, panel.AbsolutePosition.Y / sc)
		img.Size = UDim2.fromOffset(panel.AbsoluteSize.X / sc, panel.AbsoluteSize.Y / sc)
		img.Visible = panel.Visible
	end
	img.Parent = panel:FindFirstAncestorOfClass("ScreenGui") or panel.Parent or panel
	sync()
	table.insert(_uisConnections, panel:GetPropertyChangedSignal("Parent"):Connect(sync))
	table.insert(_uisConnections, panel:GetPropertyChangedSignal("AbsolutePosition"):Connect(sync))
	table.insert(_uisConnections, panel:GetPropertyChangedSignal("AbsoluteSize"):Connect(sync))
	table.insert(_uisConnections, panel:GetPropertyChangedSignal("Visible"):Connect(sync))
	table.insert(_themed.panelImages, img)
	return img
end
-- Alias kept so any consumer using the panel-as-ImageLabel-style call still resolves.
Widgets.applyPanelBackground = Widgets.attachPanelBackground

-- Shortcuts for local use
local addCorner, addStroke, addListLayout = Widgets.addCorner, Widgets.addStroke, Widgets.addListLayout

-- =========================================================
-- WIDGET FACTORIES
-- =========================================================
function Widgets.makeBlob(name, parent, size)
	local f = Instance.new("Frame"); f.Name = name; f.BackgroundColor3 = T.BlobBg; f.BackgroundTransparency = T.BlobAlpha
	f.BorderSizePixel = 0; f.Size = size or UDim2.new(1,0,0,28)
	if parent then f.Parent = parent end; addCorner(f); addStroke(f); table.insert(_themed.blobs, f); return f
end

function Widgets.makeLabel(name, parent, text, color, font, sz)
	local l = Instance.new("TextLabel"); l.Name = name; l.BackgroundTransparency = 1; l.Text = text
	l.TextColor3 = color or T.Gold; l.Font = font or T.Font; l.TextSize = sz or 11
	l.TextXAlignment = Enum.TextXAlignment.Left; l.Size = UDim2.new(1,-6,1,0); l.Position = UDim2.new(0,4,0,0)
	l.BorderSizePixel = 0; l.TextTruncate = Enum.TextTruncate.AtEnd
	if parent then l.Parent = parent end; return l
end

function Widgets.makeInput(name, parent, defaultText, placeholder)
	local f = Widgets.makeBlob(name.."Wrap", parent, UDim2.new(1,-LAYOUT.ContentOffset,0,LAYOUT.RowHeight))
	local tb = Instance.new("TextBox"); tb.Name = name; tb.BackgroundTransparency = 1
	tb.Text = defaultText or "0"; tb.PlaceholderText = placeholder or ""
	tb.TextColor3 = T.BrightGold; tb.PlaceholderColor3 = T.DarkGold; tb.Font = T.Font; tb.TextSize = 11
	tb.TextXAlignment = Enum.TextXAlignment.Left; tb.Size = UDim2.new(1,-8,1,0); tb.Position = UDim2.new(0,4,0,0)
	tb.ClearTextOnFocus = false; tb.BorderSizePixel = 0; tb.Parent = f
	return tb, f
end

function Widgets.makeButton(name, parent, text, size, color)
	local b = Instance.new("TextButton"); b.Name = name; b.BackgroundColor3 = T.BlobBg; b.BackgroundTransparency = T.BlobAlpha
	b.Text = text; b.TextColor3 = color or T.Gold; b.Font = T.Font; b.TextSize = 11
	b.Size = size or UDim2.new(0,50,0,28); b.BorderSizePixel = 0; b.AutoButtonColor = true
	if parent then b.Parent = parent end; addCorner(b); addStroke(b); table.insert(_themed.blobs, b); return b
end

function Widgets.makeToggle(name, parent)
	local outer = Instance.new("TextButton"); outer.Name = name; outer.BackgroundColor3 = T.BlobBg
	outer.BackgroundTransparency = T.BlobAlpha; outer.Text = ""; outer.Size = UDim2.new(0,28,0,16)
	outer.BorderSizePixel = 0; outer.AutoButtonColor = false
	if parent then outer.Parent = parent end; addCorner(outer, UDim.new(0,8)); addStroke(outer); table.insert(_themed.toggles, outer)
	local dot = Instance.new("Frame"); dot.Name = "Dot"; dot.BackgroundColor3 = T.DarkGold
	dot.Size = UDim2.new(0,12,0,12); dot.Position = UDim2.new(0,2,0,2); dot.BorderSizePixel = 0
	dot.Parent = outer; addCorner(dot, UDim.new(0,6))
	outer:SetAttribute("IsOn", false)
	-- Visuals are driven by AttributeChanged so external SetAttribute (e.g. Randomizer
	-- section-header tristate "all-or-none" cycle) updates dot + bg in addition to
	-- clicks. Handling visuals only inside Activated would leave the toggle stuck on
	-- whichever look matched the previous click after an external SetAttribute.
	local function _applyToggleVisuals()
		local isOn = outer:GetAttribute("IsOn") == true
		if isOn then outer.BackgroundColor3 = Color3.fromRGB(40,55,30); dot.BackgroundColor3 = T.Green; dot.Position = UDim2.new(0,14,0,2)
		else outer.BackgroundColor3 = T.BlobBg; dot.BackgroundColor3 = T.DarkGold; dot.Position = UDim2.new(0,2,0,2) end
	end
	outer.Activated:Connect(function()
		outer:SetAttribute("IsOn", not (outer:GetAttribute("IsOn") == true))
	end)
	outer:GetAttributeChangedSignal("IsOn"):Connect(_applyToggleVisuals)
	return outer
end

function Widgets.makeToggleInBlob(name, parent)
	local wrap = Widgets.makeBlob(name.."Wrap", parent, UDim2.new(1,-LAYOUT.ContentOffset,0,LAYOUT.RowHeight))
	local tog = Widgets.makeToggle(name, wrap); tog.Position = UDim2.new(0,4,0.5,-8); return tog, wrap
end

function Widgets.makeSelectButton(name, parent, axisColor)
	local f = Widgets.makeBlob(name.."Select", parent, UDim2.new(1,-LAYOUT.ContentOffset,0,LAYOUT.RowHeight))
	local lbl = Instance.new("TextLabel"); lbl.Name = "SelectLabel"; lbl.BackgroundTransparency = 1
	lbl.Text = "Edit"; lbl.TextColor3 = axisColor or T.MutedGold; lbl.Font = T.Font; lbl.TextSize = 10
	lbl.TextXAlignment = Enum.TextXAlignment.Center; lbl.Size = UDim2.new(1,-18,1,0); lbl.Parent = f
	local btn = Instance.new("TextButton"); btn.Name = "ClickArea"; btn.BackgroundTransparency = 1
	btn.Text = ""; btn.Size = UDim2.new(1,-18,1,0); btn.Parent = f
	-- Dots menu button
	local dotsBtn = Instance.new("TextButton"); dotsBtn.Name = "DotsBtn"; dotsBtn.BackgroundTransparency = 1
	dotsBtn.Text = "\u{22EE}"; dotsBtn.TextColor3 = T.BrightGold; dotsBtn.TextTransparency = 0; dotsBtn.Font = T.Font; dotsBtn.TextSize = 14
	dotsBtn.Size = UDim2.new(0,16,1,0); dotsBtn.Position = UDim2.new(1,-16,0,0)
	dotsBtn.ZIndex = 3; dotsBtn.Parent = f
	return btn, f, lbl, dotsBtn
end

-- Graph row: [TextBox] [...]  -  for NumberSequence properties (Roblox-native style)
function Widgets.makeGraphRow(name, parent)
	local f = Widgets.makeBlob(name.."Graph", parent, UDim2.new(1,-LAYOUT.ContentOffset,0,LAYOUT.RowHeight))
	local tb = Instance.new("TextBox"); tb.Name = name.."Input"; tb.BackgroundTransparency = 1
	tb.Text = "0"; tb.PlaceholderText = ""
	tb.TextColor3 = T.BrightGold; tb.PlaceholderColor3 = T.DarkGold; tb.Font = T.Font; tb.TextSize = 11
	tb.TextXAlignment = Enum.TextXAlignment.Left; tb.ClearTextOnFocus = false
	tb.Size = UDim2.new(1,-22,1,0); tb.Position = UDim2.new(0,4,0,0); tb.BorderSizePixel = 0; tb.Parent = f
	local dotsBtn = Instance.new("TextButton"); dotsBtn.Name = "DotsBtn"; dotsBtn.BackgroundTransparency = 1
	dotsBtn.Text = "\u{22EF}"; dotsBtn.TextColor3 = T.BrightGold; dotsBtn.TextTransparency = 0; dotsBtn.Font = T.Font; dotsBtn.TextSize = 14
	dotsBtn.Size = UDim2.new(0,18,1,0); dotsBtn.Position = UDim2.new(1,-18,0,0)
	dotsBtn.ZIndex = 3; dotsBtn.Parent = f
	return {input = tb, dotsBtn = dotsBtn, frame = f}
end

-- Color row: [swatch] [TextBox] [...]  -  for ColorSequence properties (Roblox-native style)
function Widgets.makeColorRow(name, parent)
	local f = Widgets.makeBlob(name.."Color", parent, UDim2.new(1,-LAYOUT.ContentOffset,0,LAYOUT.RowHeight))
	-- Color swatch
	local swatch = Instance.new("Frame"); swatch.Name = "Swatch"
	swatch.BackgroundColor3 = Color3.new(1,1,1); swatch.BorderSizePixel = 0
	swatch.Size = UDim2.new(0,14,0,14); swatch.Position = UDim2.new(0,4,0.5,-7)
	swatch.ZIndex = 2; swatch.Parent = f; addCorner(swatch, UDim.new(0,3))
	local swatchBtn = Instance.new("TextButton"); swatchBtn.Name = "SwatchBtn"; swatchBtn.BackgroundTransparency = 1
	swatchBtn.Text = ""; swatchBtn.Size = UDim2.new(0,14,0,14); swatchBtn.Position = UDim2.new(0,4,0.5,-7)
	swatchBtn.ZIndex = 3; swatchBtn.Parent = f
	-- TextBox for RGB input
	local tb = Instance.new("TextBox"); tb.Name = name.."Input"; tb.BackgroundTransparency = 1
	tb.Text = "255, 255, 255"; tb.PlaceholderText = ""
	tb.TextColor3 = T.BrightGold; tb.PlaceholderColor3 = T.DarkGold; tb.Font = T.Font; tb.TextSize = 11
	tb.TextXAlignment = Enum.TextXAlignment.Left; tb.ClearTextOnFocus = false
	tb.Size = UDim2.new(1,-40,1,0); tb.Position = UDim2.new(0,22,0,0); tb.BorderSizePixel = 0; tb.Parent = f
	-- Dots button
	local dotsBtn = Instance.new("TextButton"); dotsBtn.Name = "DotsBtn"; dotsBtn.BackgroundTransparency = 1
	dotsBtn.Text = "\u{22EF}"; dotsBtn.TextColor3 = T.BrightGold; dotsBtn.TextTransparency = 0; dotsBtn.Font = T.Font; dotsBtn.TextSize = 14
	dotsBtn.Size = UDim2.new(0,18,1,0); dotsBtn.Position = UDim2.new(1,-18,0,0)
	dotsBtn.ZIndex = 3; dotsBtn.Parent = f
	return {swatch = swatch, swatchBtn = swatchBtn, input = tb, dotsBtn = dotsBtn, frame = f}
end

-- Inline expandable dropdown options
local _activeDropdownExpansion = nil
local _activeDropdownBtn = nil
local _activeDropdownArrow = nil
local _dropdownOptButtons = {}
-- Tracks the ScrollingFrame whose ScrollingEnabled was forced false by a hover-
-- on-dropdown so callers that close the dropdown out-of-band (selection change,
-- panel close) can restore it instead of waiting for an unrelated MouseLeave.
local _hoverScrollDisabled = nil

local function hideDropdownExpansion()
	if _activeDropdownExpansion then
		_activeDropdownExpansion:Destroy()
		_activeDropdownExpansion = nil
	end
	if _activeDropdownArrow then _activeDropdownArrow.Text = "\u{25BC}" end
	if _hoverScrollDisabled and _hoverScrollDisabled.Parent then
		_hoverScrollDisabled.ScrollingEnabled = true
	end
	_hoverScrollDisabled = nil
	_activeDropdownBtn = nil
	_activeDropdownArrow = nil
	_dropdownOptButtons = {}
end
Widgets.hideDropdownExpansion = hideDropdownExpansion

local function _dropdownHL() return Color3.new(math.min(T.BlobBg.R+0.08,1), math.min(T.BlobBg.G+0.09,1), math.min(T.BlobBg.B+0.06,1)) end
local function updateDropdownHighlight(selectedIdx)
	local hl = _dropdownHL()
	for i, ob in ipairs(_dropdownOptButtons) do
		ob.BackgroundColor3 = (i == selectedIdx) and hl or T.BlobBg
		ob.BackgroundTransparency = (i == selectedIdx) and 0.1 or T.BlobAlpha
		ob.TextColor3 = (i == selectedIdx) and T.BrightGold or T.MutedGold
	end
end

function Widgets.makeDropdown(name, parent, options, default)
	-- TextButton wrapper  -  Active=true by default
	local f = Instance.new("TextButton"); f.Name = name.."Wrap"
	f.BackgroundColor3 = T.BlobBg; f.BackgroundTransparency = T.BlobAlpha
	f.Text = ""; f.Size = UDim2.new(1,-LAYOUT.ContentOffset,0,LAYOUT.RowHeight)
	f.BorderSizePixel = 0; f.AutoButtonColor = false
	if parent then f.Parent = parent end
	addCorner(f); addStroke(f); table.insert(_themed.blobs, f)

	-- Disable parent scroll when hovering dropdown so MouseWheel only cycles options
	f.MouseEnter:Connect(function()
		local scroll = f:FindFirstAncestorWhichIsA("ScrollingFrame")
		if scroll then
			scroll.ScrollingEnabled = false
			_hoverScrollDisabled = scroll
		end
	end)
	f.MouseLeave:Connect(function()
		local scroll = f:FindFirstAncestorWhichIsA("ScrollingFrame")
		if scroll then scroll.ScrollingEnabled = true end
		if _hoverScrollDisabled == scroll then _hoverScrollDisabled = nil end
	end)

	local lbl = Instance.new("TextLabel"); lbl.Name = name; lbl.BackgroundTransparency = 1
	lbl.Text = default or options[1] or ""; lbl.TextColor3 = T.BrightGold; lbl.Font = T.Font; lbl.TextSize = 10
	lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Size = UDim2.new(1,-16,1,0); lbl.Position = UDim2.new(0,4,0,0)
	lbl.Parent = f

	-- Arrow indicator
	local arrow = Instance.new("TextLabel"); arrow.BackgroundTransparency = 1
	arrow.Text = "\u{25BC}"; arrow.TextColor3 = T.DarkGold; arrow.Font = T.Font; arrow.TextSize = 7
	arrow.Size = UDim2.new(0,10,1,0); arrow.Position = UDim2.new(1,-10,0,0); arrow.Parent = f

	local idx = 1; for i, o in ipairs(options) do if o == default then idx = i; break end end
	local _onChanged = nil

	local function setValue(newIdx)
		idx = newIdx; lbl.Text = options[idx]
		if _onChanged then _onChanged(options[idx]) end
	end

	-- Scroll on hover: cycle options
	f.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			if input.Position.Z > 0 then
				idx = idx % #options + 1
			else
				idx = (idx - 2) % #options + 1
			end
			setValue(idx)
			if _activeDropdownBtn == f then
				updateDropdownHighlight(idx)
			end
		end
	end)

	-- Click: expand inline options list below the row
	f.Activated:Connect(function()
		if _activeDropdownBtn == f then
			hideDropdownExpansion(); return
		end
		hideDropdownExpansion()
		_activeDropdownBtn = f
		_activeDropdownArrow = arrow
		arrow.Text = "\u{25B2}" -- up arrow

		-- Parent to ScreenGui so it escapes ScrollingFrame clipping
		local sg = f:FindFirstAncestorOfClass("ScreenGui")
		if not sg then return end

		-- AbsolutePosition is in screen pixels; divide by UIScale to get ScreenGui coordinates
		local scale = 1
		local uiScaleObj = sg:FindFirstChildOfClass("UIScale")
		if uiScaleObj then scale = uiScaleObj.Scale end

		local absPos = f.AbsolutePosition
		local absSize = f.AbsoluteSize

		local optFrame = Instance.new("Frame"); optFrame.Name = name.."Options"
		optFrame.BackgroundColor3 = T.PanelBg; optFrame.BackgroundTransparency = 0.05
		optFrame.Position = UDim2.new(0, absPos.X / scale, 0, (absPos.Y + absSize.Y) / scale)
		optFrame.Size = UDim2.new(0, absSize.X / scale, 0, 0)
		optFrame.AutomaticSize = Enum.AutomaticSize.Y
		-- ZIndex 250 keeps the option list above modal panels (HitFilterPanel,
		-- ConfigPanel) which sit at ZIndex 200. ScreenGui uses Sibling z-order,
		-- so the expansion must beat both the modal frame AND its children.
		optFrame.ZIndex = 250; optFrame.ClipsDescendants = false
		optFrame.Parent = sg
		addCorner(optFrame, T.Corner); addStroke(optFrame)
		addListLayout(optFrame, 1)

		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 4); pad.PaddingRight = UDim.new(0, 4)
		pad.PaddingTop = UDim.new(0, 3); pad.PaddingBottom = UDim.new(0, 3)
		pad.Parent = optFrame

		_activeDropdownExpansion = optFrame
		_dropdownOptButtons = {}

		for i, opt in ipairs(options) do
			local ob = Instance.new("TextButton"); ob.Name = "Opt"..i
			ob.BackgroundColor3 = (i == idx) and _dropdownHL() or T.BlobBg
			ob.BackgroundTransparency = (i == idx) and 0.1 or T.BlobAlpha
			ob.Text = opt; ob.TextColor3 = (i == idx) and T.BrightGold or T.MutedGold
			ob.Font = T.Font; ob.TextSize = 9; ob.TextXAlignment = Enum.TextXAlignment.Left
			ob.Size = UDim2.new(1, 0, 0, 18); ob.BorderSizePixel = 0; ob.LayoutOrder = i
			ob.AutoButtonColor = true; ob.ZIndex = 250; ob.Parent = optFrame
			addCorner(ob, UDim.new(0,3))
			table.insert(_dropdownOptButtons, ob)
			ob.Activated:Connect(function()
				setValue(i)
				hideDropdownExpansion()
			end)
		end

		-- Flip upward if dropdown would clip below viewport
		local estimatedH = #options * 19 + 6
		local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
		if vp then
			local bottomEdge = (absPos.Y + absSize.Y) / scale + estimatedH
			if bottomEdge > vp.Y / scale then
				optFrame.Position = UDim2.new(0, absPos.X / scale, 0, (absPos.Y - estimatedH) / scale)
			end
		end
	end)

	local function setOnChanged(fn) _onChanged = fn end
	return lbl, f, setOnChanged
end

-- =========================================================
-- PANEL TRACKING / DRAG / SNAP
-- =========================================================
function Widgets.registerPanel(panel)
	table.insert(_allPanels, panel)
end

local function _getScale(i) local sg = i:FindFirstAncestorOfClass("ScreenGui")
	if sg then local us = sg:FindFirstChildOfClass("UIScale"); if us then return us.Scale end end; return 1 end

-- Panels overlap freely. Only auto-correction is the viewport clamp below which keeps
-- panels reachable when dragged off-screen. `_allPanels` + `_noSnap` attributes are
-- reserved for future opt-out / scale helpers; neither suppresses the clamp.
function Widgets.resolveOverlap(panel, _depth, _vp)
	if not panel.Visible then return end
	local scale = _getScale(panel)
	local vp = _vp or (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080))
	local pw, ph = panel.AbsoluteSize.X, panel.AbsoluteSize.Y
	-- Clamp to viewport  -  keeps panels reachable even when dragged off-screen.
	local vpS = vp / scale
	local aX, aY = panel.AbsolutePosition.X / scale, panel.AbsolutePosition.Y / scale
	local cX = math.clamp(aX, 0, math.max(vpS.X - pw/scale, 0))
	local cY = math.clamp(aY, 0, math.max(vpS.Y - ph/scale, 0))
	if math.abs(cX-aX) > 1 or math.abs(cY-aY) > 1 then local p = panel.Position
		panel.Position = UDim2.new(p.X.Scale, p.X.Offset+(cX-aX), p.Y.Scale, p.Y.Offset+(cY-aY)) end
end

function Widgets.makeDraggable(frame, handle)
	local dragging = false
	local ds, sp, dragScale
	handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true; ds = i.Position; sp = frame.Position; dragScale = _getScale(frame)
		end
	end)
	handle.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
			task.defer(function() Widgets.resolveOverlap(frame) end)
		end
	end)
	local c1 = UserInputService.InputChanged:Connect(function(i)
		if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
			local d = i.Position - ds
			frame.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X / dragScale, sp.Y.Scale, sp.Y.Offset + d.Y / dragScale)
		end
	end)
	local c2 = UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
			task.defer(function() Widgets.resolveOverlap(frame) end)
		end
	end)
	table.insert(_uisConnections, c1); table.insert(_uisConnections, c2)
end

-- =========================================================
-- ROW
-- =========================================================
function Widgets.makeRow(parent, labelText, contentBuilder, order)
	local row = Instance.new("Frame"); row.Name = labelText:gsub("%s+","").."Row"
	row.BackgroundTransparency = 1; row.Size = UDim2.new(1,0,0,LAYOUT.RowHeight); row.LayoutOrder = order or 0; row.Parent = parent
	local lb = Widgets.makeBlob("LabelBlob", row, UDim2.new(0,LAYOUT.LabelWidth,1,0))
	Widgets.makeLabel("Label", lb, labelText, T.MutedGold, T.Font, 10)
	local content = contentBuilder(row)
	if content and content:IsA("GuiObject") then content.Position = UDim2.new(0,LAYOUT.ContentOffset,0,0); content.Size = UDim2.new(1,-LAYOUT.ContentOffset,1,0) end
	return row, content
end

-- Shared Blender section builder. Beam + TrailEmitter both render an "Add State" button
-- above a vertically-stacked StateList; this returns the trio (section, addBtn, stateList)
-- so callers can stash refs and wire the Add handler.
function Widgets.makeBlenderBox(body, btnName, stateListName)
	local section, sectionBody = Widgets.makeSection(body, "Blender", 10, true)
	local addBtn = Widgets.makeButton(btnName, sectionBody, "+ Add State", UDim2.new(1,0,0,20), T.MutedGold); addBtn.TextSize = 9; addBtn.LayoutOrder = 0
	local sl = Instance.new("Frame"); sl.Name = stateListName; sl.BackgroundTransparency = 1
	sl.Size = UDim2.new(1,0,0,0); sl.AutomaticSize = Enum.AutomaticSize.Y; sl.LayoutOrder = 1; sl.Parent = sectionBody; Widgets.addListLayout(sl, 3)
	return section, addBtn, sl
end

-- Toast notification system. Used for transient error / info messages that need to
-- surface to the user without forcing a modal (e.g. "Model has no PrimaryPart").
-- Stacks vertically in the bottom-right of the plugin's main ScreenGui. Auto-
-- dismisses after `duration` seconds. Severity controls the accent stripe color:
-- "info" (gold), "warn" (orange), "error" (red).
local _toastStack = {} -- active toasts, top of stack = bottom of screen
local _toastSG -- ScreenGui parent (lazy-initialized once we have ctx)

-- Set the parent ScreenGui (called once from init.server.lua / UIBuilder).
function Widgets.setToastParent(sg) _toastSG = sg end

local TOAST_W, TOAST_H, TOAST_PAD = 240, 48, 8

local function _repositionToasts()
	for i, toast in ipairs(_toastStack) do
		toast.Position = UDim2.new(1, -TOAST_W - 16, 1, -16 - i * (TOAST_H + TOAST_PAD))
	end
end

function Widgets.showToast(message, severity, duration)
	if not _toastSG then warn("[Part-Icles] showToast called before setToastParent: " .. tostring(message)); return end
	severity = severity or "info"
	duration = duration or 4
	local accentColor = severity == "error" and Color3.fromRGB(220, 80, 60)
		or severity == "warn" and Color3.fromRGB(220, 150, 60)
		or T.Gold

	local toast = Instance.new("Frame")
	toast.Name = "Toast"; toast.Size = UDim2.new(0, TOAST_W, 0, TOAST_H)
	toast.AnchorPoint = Vector2.new(0, 1)
	toast.BackgroundColor3 = T.PanelBg; toast.BackgroundTransparency = 0.05
	toast.BorderSizePixel = 0; toast.ZIndex = 50; toast.Parent = _toastSG
	Widgets.addCorner(toast, T.Corner)
	Widgets.addStroke(toast)

	local stripe = Instance.new("Frame"); stripe.Name = "Accent"
	stripe.Size = UDim2.new(0, 3, 1, 0); stripe.BorderSizePixel = 0
	stripe.BackgroundColor3 = accentColor; stripe.ZIndex = 51; stripe.Parent = toast
	Widgets.addCorner(stripe, UDim.new(0, 2))

	local lbl = Instance.new("TextLabel"); lbl.Name = "Msg"; lbl.BackgroundTransparency = 1
	lbl.Position = UDim2.new(0, 10, 0, 0); lbl.Size = UDim2.new(1, -16, 1, 0)
	lbl.Text = tostring(message); lbl.TextColor3 = T.BrightGold; lbl.Font = T.Font; lbl.TextSize = 11
	lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.TextWrapped = true; lbl.ZIndex = 51; lbl.Parent = toast

	table.insert(_toastStack, toast)
	_repositionToasts()

	task.delay(duration, function()
		if toast and toast.Parent then
			for i, t in ipairs(_toastStack) do
				if t == toast then table.remove(_toastStack, i); break end
			end
			pcall(function() toast:Destroy() end)
			_repositionToasts()
		end
	end)
end

-- enableTextScaling removed: professional tool UIs use fixed text sizes.
-- Panel resizing changes input/content width, not font size. Overflow
-- handled by TextTruncate + minimum panel widths in makeResizable.

-- EDGE RESIZE (hover edge → highlight → drag to resize)
function Widgets.makeResizable(panel, minW, minH)
	minW = minW or 80; minH = minH or 60
	local EDGE_W = 12; local HOVER_DELAY = 0.4; local CR = T.BigCorner.Offset
	local sg = panel:FindFirstAncestorOfClass("ScreenGui")
	local HW = EDGE_W / 2
	local fadeIn = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local fadeOut = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local edges = {
		{name="R", size=UDim2.new(0,EDGE_W,1,0), pos=UDim2.new(1,-HW,0,0), ax="x", dir=1},
		{name="L", size=UDim2.new(0,EDGE_W,1,0), pos=UDim2.new(0,-HW,0,0), ax="x", dir=-1, moveAxis=true},
		{name="B", size=UDim2.new(1,0,0,EDGE_W), pos=UDim2.new(0,0,1,-HW), ax="y", dir=1},
		{name="T", size=UDim2.new(1,0,0,EDGE_W), pos=UDim2.new(0,0,0,-HW), ax="y", dir=-1, moveAxis=true},
	}
	for _, edge in ipairs(edges) do
		local handle = Instance.new("TextButton"); handle.Name = "Edge_"..edge.name
		handle.BackgroundTransparency = 1; handle.Text = ""; handle.Size = edge.size
		handle.Position = edge.pos; handle.ZIndex = 8; handle.BorderSizePixel = 0
		handle.AutoButtonColor = false; handle.Parent = panel
		local highlight = Instance.new("Frame"); highlight.Name = "EHL_"..edge.name
		highlight.BackgroundColor3 = T.Gold; highlight.BackgroundTransparency = 1
		highlight.BorderSizePixel = 0; highlight.Visible = false; highlight.ZIndex = 50
		if sg then highlight.Parent = sg end

		local hoverTimer, activated, resizing = nil, false, false
		local startMouse, startSize, startPos, scale

		local function positionHighlight()
			if not sg or not panel.Parent then return end
			local sc = _getScale(panel); local ap = panel.AbsolutePosition / sc; local as = panel.AbsoluteSize / sc
			if edge.name == "R" then highlight.Position = UDim2.new(0, ap.X+as.X, 0, ap.Y+CR); highlight.Size = UDim2.new(0, 3, 0, as.Y-CR*2)
			elseif edge.name == "L" then highlight.Position = UDim2.new(0, ap.X-3, 0, ap.Y+CR); highlight.Size = UDim2.new(0, 3, 0, as.Y-CR*2)
			elseif edge.name == "B" then highlight.Position = UDim2.new(0, ap.X+CR, 0, ap.Y+as.Y); highlight.Size = UDim2.new(0, as.X-CR*2, 0, 3)
			elseif edge.name == "T" then highlight.Position = UDim2.new(0, ap.X+CR, 0, ap.Y-3); highlight.Size = UDim2.new(0, as.X-CR*2, 0, 3) end
		end

		handle.MouseEnter:Connect(function()
			if resizing then return end
			hoverTimer = task.delay(HOVER_DELAY, function()
				positionHighlight(); highlight.Visible = true; activated = true
				TweenService:Create(highlight, fadeIn, {BackgroundTransparency = 0.35}):Play()
			end)
		end)
		handle.MouseLeave:Connect(function()
			if hoverTimer then task.cancel(hoverTimer); hoverTimer = nil end
			if not resizing then
				activated = false
				local tw = TweenService:Create(highlight, fadeOut, {BackgroundTransparency = 1}); tw:Play()
				tw.Completed:Once(function() if not activated then highlight.Visible = false end end)
			end
		end)
		handle.MouseButton1Down:Connect(function()
			if not activated then return end
			resizing = true; scale = _getScale(panel)
			startMouse = UserInputService:GetMouseLocation()
			startSize = panel.Size; startPos = panel.Position; positionHighlight()
		end)
		local c1 = UserInputService.InputChanged:Connect(function(input)
			if not resizing or input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
			local mouse = UserInputService:GetMouseLocation()
			local dx, dy = (mouse.X - startMouse.X) / scale, (mouse.Y - startMouse.Y) / scale
			local w, h, px, py = startSize.X.Offset, startSize.Y.Offset, startPos.X.Offset, startPos.Y.Offset
			if edge.ax == "x" then local nW = math.max(minW, w+dx*edge.dir); panel.Size = UDim2.new(0,nW,startSize.Y.Scale,h); if edge.moveAxis then panel.Position = UDim2.new(startPos.X.Scale,px+(w-nW),startPos.Y.Scale,py) end
			else local nH = math.max(minH, h+dy*edge.dir); panel.Size = UDim2.new(startSize.X.Scale,w,0,nH); if edge.moveAxis then panel.Position = UDim2.new(startPos.X.Scale,px,startPos.Y.Scale,py+(h-nH)) end end
			positionHighlight()
		end)
		local c2 = UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 and resizing then
				resizing = false; activated = false
				local tw = TweenService:Create(highlight, fadeOut, {BackgroundTransparency = 1}); tw:Play()
				tw.Completed:Once(function() highlight.Visible = false end)
				task.defer(function() Widgets.resolveOverlap(panel) end)
			end
		end)
		table.insert(_uisConnections, c1); table.insert(_uisConnections, c2)
	end
end

-- Load split modules that add functions to this table
require(script.Parent.WidgetAxis)(Widgets)
require(script.Parent.WidgetSections)(Widgets)
require(script.Parent.WidgetPropToggles)(Widgets)
return Widgets
