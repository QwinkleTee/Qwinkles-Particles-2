1SS?J)PkSY:opDj0TC`_M%GR1P2fhXQM(Ms;0n\3\*fm!L?Q/3"H01LF+$q4rU'U#W#P1+oZgq<o(gQA8<2mmBC#KR"c5drJQ`Iat"/q>O9<*0Yd:R6WlCjj)`4#t.H+c1e`P)V?rVsY-!5="+]=]);W=type;local s=string.rep;local m=assert;local V={[0]=1,2,4,8,16,32,64,128,256,512,1024,2048,4096,8192,16384,32768,65536,131072,262144,524288,1048576,2097152,4194304,8388608,16777216,33554432,67108864,134217728,268435456,536870912,1073741824,2147483648,4294967296};local Z=function(h)local p,A,k,c=0,#h,0,0xFFFFFFFF;local v=function()p=p+1;return E(h,p,p);end;local E="";for h=1,5 do k=k*256+v();end;local function h(R)local u=0;for I=R,1,-1.0 do c=c/2;c=c-c%1;u=u*2;if not(k<c)then k=k-c;u=u+1;end;if c<=0x00FFFFFF then c=c*256;k=k*256+v();end;end;return u;end;local R={[0]=0,0,0,0,1,2,3,4,5,6,4,5};local function u(I,P)local N,K,d=c/2048,I[P];N=N-N%1;local X=N*K;if k<X then c=X;N=(2048-K)/32;N=N-N%1;K=K+N;d=0;else c=c-X;local N=K/32;k=k-X;N=N-N%1;K=K-N;d=1;end;I[P]=K;if c<=0x00FFFFFF then c=c*256;k=k*256+v();end;return d;end;local function k(c,v,I)local P=1;for N=1,c do P=P*2+u(I,P);end;return(P-v);end;local function c(v,I,P)local N,K=0,1;for d=0,P-1 do local P=u(I,v+K);K=K*2+P;N=N+P*V[d];end;return N;end;local function v(I,P)local N=1;for K=7,0,-1.0 do local d=(I/V[K])%2;d=d-d%1;K=u(P,N+(d*256)+256);N=N*2+K;if d~=K then while N<0x100 do N=N*2+u(P,N);end;break;end;end;return(N%256);end;local I=0;local function P(N,K)if u(N,1)==0 then return k(3,8,N[3][K]);elseif u(N,2)==0 then return 8+k(3,8,N[4][K]);end;return k(8,256,N[5])+16.0;end;local N,K=0,{[0]=0};local function d(X)local a={};for Y=0,X-1 do a[Y]=1024.0;end;return a;end;local function X(a,Y)local U={};for D=0,Y-1 do local Y={};U[D]=Y;for D=0,a-1 do Y[D]=1024.0;end;end;return U;end;local function a()return{1024.0,1024.0,X(8,1),X(8,1),d(256)};end;local function Y()local U,D,e,g,M,T,O,b,_,F,t,x,H,C,y,G=X(0x300,8),X(1,12),0,0,d(12),d(12),0,d(12),d(12),X(1,12),0,X(64,4),d(115.0),d(16),a(),a();while p<=A do local p=(I%1);if u(D[N],p)==0 then local A=K[I];local d=A/V[5.0];d=