          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Part</string>
            <string name="Source"><![CDATA[--[[
	Part-Icles Core  -  runtime engine.

	Call :Activate() once at script start to connect the Heartbeat loop.
	Call :Deactivate() at teardown to disconnect + clean up active emits.

	---- Emit (one item, no recursion) ----
	:Emit(item, link?, emitCtx?)
	   Fires one immediate emit on `item` (BasePart / Attachment / Model / Beam / etc.).
	   Use :AbsoluteEmit when you want children to fire too.

	:EmitAnimate(item, link?, emitCtx?)
	   Starts one Animate cycle on `item`. Visual animates in place (3D types) or
	   spawns a singleton clone (Screen / ImageLabel).

	:EnableEmit(item, link?, emitCtx?)
	   Honors authored EmitCount + EmitDelay + EmitDuration attributes. Fires the
	   burst then runs the loopBody for EmitDuration seconds.

	:EnableEmitAt(item, originCF, options?)
	   Like :EnableEmit but spawns from `originCF` instead of `item`'s authored CFrame.
	   Supports BasePart / Attachment / Model only. options = { ChainCtx, OriginResolver,
	   UseFullOrigin, IgnoreLink }. UseFullOrigin defaults true (includes rotation);
	   IgnoreLink defaults false (respects authored Link weld).

	---- Recursive emit (item + all descendants) ----
	:AbsoluteEmit(item, _parentFiredPE?, emitCtx?) -> duration: number?
	   Fires every emitter under `item` (transformed items via :EnableEmit, raw PE / Trail
	   / Beam via native APIs). Walks the descendant tree, deduping via _parentFiredPE.
	   Returns total real-time duration in seconds (or nil for infinite  -  AnimateLoop
	   unbounded, Timescale stuck at 0). Pair with .await(n) for an emit-and-wait pattern.

	:AbsoluteEmitAt(item, originCF, options?) -> duration: number?
	   Recursive form of :EnableEmitAt. Same emitCtx threading as :AbsoluteEmit; transformed
	   descendants spawn from `originCF` instead of their authored CFrame. Raw types in the
	   tree emit from their authored position (origin override is BasePart/Attachment/Model
	   only). Returns total duration (or nil for infinite).

	---- Enable / Disable (no emit  -  just on/off state) ----
	:Enable(item, link?, duration?, emitCtx?)
	   Starts the continuous-emit loopBody for `duration` seconds (defaults to math.huge).
	   Animate-mode short-circuits to AnimateLoop=true + :EmitAnimate.

	:Disable(item)
	   Stops all activity on `item`: cancels loops, clears Active tables, sets cfg.Enabled=false,
	   cancels PE/Trail native gens, sets raw Beam/Highlight descendants Enabled=false.

	:AbsoluteEnable(item)
	   Recursive enable. Transformed item → cfg.Enabled=true + :Enable(math.huge), sets
	   _PartIclePlaying gate so the EnabledLoop listener doesn't double-fire. Raw PE / Trail
	   / Beam / Highlight descendants get Enabled=true. Containers (Folder, Model, BasePart)
	   walk children with the covered flag so descendants aren't double-toggled.

	:AbsoluteDisable(item)
	   Recursive disable. Transformed item → :Disable. Raw PE / Trail / Beam / Highlight
	   descendants get Enabled=false. Symmetric to :AbsoluteEnable.

	---- Timescale (per-particle time distortion) ----
	:SetTimescale(item, scale, duration?, permanent?)
	   Override Timescale to `scale` for `duration` seconds (or until next ClearTimescale
	   if `permanent`). Wins over authored Timescale graph during its window.

	:ClearTimescale(item)
	   Remove the override; authored Timescale graph (or 1) resumes.

	:AbsoluteSetTimescale / :AbsoluteClearTimescale
	   Recursive variants over `item` + transformed descendants.

	---- Authoring / texture / state ----
	:Transform(part)                                  -  convert into a Part-Icle emitter
	:TransformModel(model, typeDef)                   -  Model variant
	:Preload(root, force?)                            -  pin textures for upcoming emit
	:Deload(root, force?)                             -  release texture pins
	:GetData(item)                                    -  flat data table read from config
	:GetFolder() / :GetPoolFolder()                   -  runtime folder accessors
	:ReapplyLink(pData)                               -  per-frame link CFrame writer

	---- Statics + sub-services ----
	.await(n)                                         -  yields task for n seconds; nil = no-op
	.parseDuration(raw)                               -  parse "min,max" range string to number
	.LinkService                                      -  standalone link-tracking service
	.TransformCompleted                               -  BindableEvent fired post-:Transform

	---- emitCtx ----
	emitCtx (optional table threaded through every emit path):
	  ChainCtx            = { ChainId, Depth } event-chain context
	  EmitIndex           = burst-index (set by EnableEmit's count loop)
	  EmitCount           = burst-count
	  EventOriginCF       = origin override (set by EnableEmitAt / AbsoluteEmitAt)
	  EventOriginResolver = live-resolver function fired at spawn time
	  UseFullOrigin       = bool; AtCFrame includes rotation
	  IgnoreLink          = bool; bypass authored Link weld
]]

local UIS = game:GetService('UserInputService')
local _RunService = game:GetService('RunService')
local ParticlesMod = require(script.Particles)

local Particle = {}
Particle.Beam = {}
-- Focus tracking; connections stored so Deactivate can release them. Client-only.
Particle._focused = true
Particle._unfocusedAt = 0
if _RunService:IsClient() then
	Particle._focusConn = UIS.WindowFocused:Connect(function() Particle._focused = true; Particle._unfocusedAt = 0 end)
	Particle._blurConn = UIS.WindowFocusReleased:Connect(function() Particle._focused = false; Particle._unfocusedAt = os.clock() end)
end

-- Engine state.
Particle.ActiveEmits = {}    -- pData array for live clones; Heartbeat walks this
Particle.ActiveLoops = {}    -- item → Enable-loop task thread
Particle.ActiveAnimates = {} -- item → pData (max 1 cycle per source)
-- Chain-driven duration loops run detached so parallel chain fires don't cancel each other.
Particle.ActiveChainLoops = {}
Particle.Connection = nil
Particle._CachedFolder = nil
Particle._engineGen = 0
-- Hard cap on concurrent particles; user Module code still runs at cap.
Particle.MAX_ACTIVE_PARTICLES = 1000
Particle._capWarnLastAt = 0
-- PartLife linger visuals (post-pData) count toward the cap.
Particle._lingerVisualCount = 0

-- Mixin pattern: sub-modules attach methods to Particle.
require(script.GetData)(Particle)
require(script.Transform)(Particle)
require(script.Update)(Particle)
require(script.UpdateBeam)(Particle)
-- Timescale loaded before Emit mixins so Particle._seedTsOverride is attached when those emit-site seed calls run.
require(script.Timescale)(Particle)
require(script.Emit)(Particle)
require(script.EmitAnimate)(Particle)
require(script.EmitModel)(Particle)
require(script.UpdateModel)(Particle)
require(script.PointLight)(Particle)
require(script.Highlight)(Particle)
require(script.TrailEmitter)(Particle)
require(script.ScreenEmit)(Particle)
require(script.ImageEmit)(Particle)
require(script.LinkTrack)(Particle)
require(script.Orientation)(Particle)
require(script.ZOffset)(Particle)
-- Engine mixin owns Activate / Deactivate / GetFolder / GetPoolFolder (big Heartbeat
-- callback split out to keep init.luau under the 500-line code cap).
require(script.Engine)(Particle)
-- Lifecycle loaded last (touches earlier mixins).
require(script.Lifecycle)(Particle)

-- Once-per-session warning fired when a public emit-creating method is called
-- before :Activate(). Particles will be created but the Heartbeat isn't connected,
-- so they'll never advance. Helps scripters spot the missing :Activate() call
-- instead of debugging invisible particles.
function Particle:_warnIfNotActivated(methodName)
	if self.Connection then return end
	if self._notActivatedWarned then return end
	self._notActivatedWarned = true
	warn(string.format(
		"[Part-Icles] :%s() called before :Activate()  -  particles will not update until the engine is activated. Call Particle:Activate() once at startup.",
		methodName
	))
end

-- Apply Orientation + ZOffset on emit frame to avoid a 1-frame snap.
function Particle:_applyEmitVisualPasses(pData)
	local t = pData.Type
	if t ~= "Part" and t ~= "Model" and t ~= "Attachment" then return end
	local cam = workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position
	-- Seed _postUpdateCF from spawn pose so frame-1 overlays don't compound on themselves.
	local hasO = pData.Orientation and pData.Orientation ~= "None"
	local hasZ = pData.ZOffset and pData.ZOffset ~= 0
	if hasO or hasZ then pData._postUpdateCF = (t == "Model") and pData.VisualPart:GetPivot() or pData.VisualPart.CFrame end
	if hasO then self:ApplyOrientation(pData, 1/60, camPos) end
	if hasZ then self:ApplyZOffset(pData, camPos) end
end

-- Activate / Deactivate / GetFolder / GetPoolFolder live in Modules/Part/Engine.luau (mixin).

-- One-shot emit. Dispatches to the per-type EmitX. `link` is optional  -  for types that support
-- Linking (Parts / Attachment / Model), pass the instance whose CFrame the emit is tied to.
-- `emitCtx` is an optional context table propagated by the Events runtime + EnableEmitAt:
--   { ChainCtx = {ChainId, Depth}, EmitIndex = 1-based, EventOriginCF = CFrame, IgnoreLink = bool }
-- EventOriginCF + IgnoreLink are honoured by EmitPart / EmitAttachment / EmitModel for origin
-- override. Other types ignore those fields and emit at their authored CFrame.
function Particle:Emit(item, link, emitCtx)
	if not item or not item.Parent then return end
	self:_warnIfNotActivated("Emit")
	-- Hard cap on concurrent particles. Skip the visual emit but let Events.fire's
	-- user-Module spawn continue (Module is spawned separately, not from this dispatch).
	-- Once-per-second warn so a sustained overflow doesn't flood Output with one warn
	-- per dropped emit.
	-- Lingering visuals (PartLife > 0 path in Lifecycle) outlive their ActiveEmits entry
	-- but still consume world resources, so they count against the cap. _lingerVisualCount
	-- is incremented when a visual enters linger, decremented on destroy (or via
	-- _lingerCounted attribute idempotency).
	local cap = self.MAX_ACTIVE_PARTICLES or 1000
	if #self.ActiveEmits + (self._lingerVisualCount or 0) >= cap then
		local now = os.clock()
		if now - (self._capWarnLastAt or 0) >= 1 then
			self._capWarnLastAt = now
			warn(("[Part-Icles] active particle cap (%d) reached  -  new emits skipped (user Module code still runs)."):format(cap))
		end
		return
	end
	if item:IsA("Beam") and item:FindFirstChild("PartIcleProperties") then
		self:EmitBeam(item, link, emitCtx)
	elseif item:IsA("Beam") or (item:IsA("Trail") and not item:FindFirstChild("PartIcleProperties")) then
		-- directAccess Beam (BeamNative) or directAccess Trail: no emit pipeline. Schedule the
		-- enable-for-Duration toggle that doEmitOnce uses so API-level Particle:Emit has parity.
		-- Trail's EmitDuration is sometimes a "min,max" string  -  take max for the schedule.
		local raw, d = item:GetAttribute("EmitDuration"), 0
		if typeof(raw) == "number" then d = raw
		elseif raw ~= nil then local m1, m2 = tostring(raw):match("([%-%.%d]+)%s*,%s*([%-%.%d]+)")
			d = (m1 and m2) and math.max(tonumber(m1) or 0, tonumber(m2) or 0) or (tonumber(tostring(raw)) or 0)
		end
		if d > 0 then
			task.delay(item:GetAttribute("EmitDelay") or 0, function()
				if not (item and item.Parent) then return end
				item.Enabled = true
				task.delay(d, function() if item and item.Parent then item.Enabled = false end end)
			end)
		end
	elseif item:IsA("Trail") then
		self:EmitTrail(item, link, emitCtx)
	elseif item:IsA("PointLight") then
		self:EmitPointLight(item, link, emitCtx)
	elseif item:IsA("Highlight") then
		self:EmitHighlight(item, link, emitCtx)
	elseif item:IsA("Attachment") then
		self:EmitAttachment(item, link, emitCtx)
	elseif item:IsA("Model") then
		self:EmitModel(item, link, emitCtx)
	elseif item:IsA("BlurEffect") then
		self:EmitBlur(item, link, emitCtx)
	elseif item:IsA("BloomEffect") then
		self:EmitBloom(item, link, emitCtx)
	elseif item:IsA("ColorCorrectionEffect") then
		self:EmitColorCorrection(item, link, emitCtx)
	elseif item:IsA("Atmosphere") then
		self:EmitAtmosphere(item, link, emitCtx)
	elseif item:IsA("ImageLabel") then
		self:EmitImageLabel(item, link, emitCtx)
	elseif item:IsA("BasePart") then
		self:EmitPart(item, link, emitCtx)
	end
	-- Unknown / unwired types silently no-op.
end

-- Particle:Enable, Particle:Disable, Particle:EmitAnimate, Particle:EnableEmit, and the
-- local cancelAnimation helper live in Modules/Part/Lifecycle.luau (loaded as a mixin above).

-- Recursive fire-everything-under-root. For a transformed item, runs EnableEmit (full emit timing).
-- For a raw ParticleEmitter / Trail, fires its native API directly. Walks descendants so one call
-- on a Folder/Model containing many emitters fires them all. `_parentFiredPE` is an internal flag
-- that prevents double-firing when an ancestor already covered a subtree's native PEs via
-- ParticlesMod.EnableEmit (which internally uses GetDescendants).
local _Duration = require(script.Duration)

-- Yield helper. Companion to Particle:AbsoluteEmit's duration return value.
-- Called as `Particle.await(n)` (no colon). Nil / non-positive durations are no-ops
-- so `Particle.await(Particle:AbsoluteEmit(item))` is safe for infinite-cycle emitters.
function Particle.await(n)
	if n == nil then return end
	if type(n) ~= "number" then return end
	if n <= 0 then return end
	task.wait(n)
end

-- _absoluteEmitFire dispatches the actual emit recursion; AbsoluteEmit wraps it +
-- computes the true wall-clock duration. Split keeps the recursive Activate-warn
-- to fire once at the top level instead of every nested descendant call.
function Particle:_absoluteEmitFire(item, _parentFiredPE, emitCtx)
	if item:GetAttribute("Transformed") then
		self:EnableEmit(item, nil, emitCtx)
		return
	end

	-- Engine-session predicate threaded into native PE/Trail helpers so a delayed
	-- :Emit / :Enable doesn't fire after Particle:Deactivate.
	local alive = self:_makeAliveCheck()

	-- Raw ParticleEmitter: fire directly. EmitCount defaults to 1 when the attribute is absent,
	-- matching the Studio Emit button's inline behavior. tonumber coerces string-typed attrs
	-- (e.g. EmitCount="5" set via Studio's attribute UI) so the `<= 0` comparison can't error.
	if item:IsA("ParticleEmitter") then
		if _parentFiredPE then return end
		local count = tonumber(item:GetAttribute("EmitCount")) or 1
		local emitDelay = tonumber(item:GetAttribute("EmitDelay")) or 0
		local emitDuration = tonumber(item:GetAttribute("EmitDuration")) or 0
		-- Zero-as-zero  -  see Modules/Part/Particles.luau.
		if count <= 0 and emitDuration <= 0 then return end
		-- Capture the native gen at schedule time so an AbsoluteDisable during EmitDelay
		-- invalidates this delayed start instead of resurrecting the emitter past the delay.
		local scheduledGen = ParticlesMod.ReadNativeGen(item)
		local function doEmit()
			if not alive() or not ParticlesMod.IsNativeGenCurrent(item, scheduledGen) then return end
			if count > 0 then item:Emit(count) end
			-- SetEnabledForDuration schedules a native-gen-tokened delayed-off so the
			-- cleanup still runs even after engine death, while a newer emit session
			-- bumping the gen prevents this closure from clobbering its window.
			if emitDuration > 0 then ParticlesMod.SetEnabledForDuration(item, emitDuration) end
		end
		if emitDelay > 0 then task.delay(emitDelay, doEmit) else doEmit() end
		return
	end

	-- Raw Trail: delegate to existing single-instance helper (parses EmitDuration range).
	if item:IsA("Trail") then
		if _parentFiredPE then return end
		ParticlesMod.EnableEmitSingle(item, alive)
		return
	end

	-- Raw Beam: continuous-streak rendering between authored Attachment0 / Attachment1.
	-- EmitDuration attribute gates a timed Enable-for-duration window; absent / zero leaves
	-- the authored Enabled state alone. No EmitCount semantic (Beams stream, not burst).
	if item:IsA("Beam") then
		if _parentFiredPE then return end
		local emitDuration = tonumber(item:GetAttribute("EmitDuration")) or 0
		local emitDelay = tonumber(item:GetAttribute("EmitDelay")) or 0
		if emitDuration > 0 then
			local scheduledGen = ParticlesMod.ReadNativeGen(item)
			local function doEmit()
				if not alive() or not ParticlesMod.IsNativeGenCurrent(item, scheduledGen) then return end
				ParticlesMod.SetEnabledForDuration(item, emitDuration)
			end
			if emitDelay > 0 then task.delay(emitDelay, doEmit) else doEmit() end
		end
		return
	end

	-- Fire native PEs for BaseParts and Attachments.
	-- Skip if a parent already called EnableEmit (which uses GetDescendants, so our PEs are already covered).
	local shouldFirePE = (item:IsA("BasePart") or item:IsA("Attachment") or item:IsA("Model")) and not _parentFiredPE
	if shouldFirePE then ParticlesMod.EnableEmit(item, alive) end

	-- Propagate the "covered" state: if we fired here OR an ancestor fired, children are already
	-- covered. The `or _parentFiredPE` term keeps a suppressed intermediate (e.g. an Attachment
	-- inside an already-fired Part) from clearing the flag  -  descendant PEs would double-fire.
	local firedCovered = shouldFirePE or _parentFiredPE
	for _, child in item:GetChildren() do
		if item:IsA("BasePart") and child:IsA("BasePart") and not child:GetAttribute("Transformed") then
			continue
		end
		self:_absoluteEmitFire(child, firedCovered, emitCtx)
	end
end

-- Recursive emit. Walks `item` + descendants firing every emitter:
--   - Transformed item → :EnableEmit (honors EmitCount + EmitDelay + EmitDuration).
--   - Raw ParticleEmitter → :Emit(count) + Enabled-for-duration window.
--   - Raw Trail → :EnableEmitSingle.
--   - Raw Beam → SetEnabledForDuration.
--   - BasePart / Attachment / Model → ParticlesMod.EnableEmit covers all native PE/Trail
--     descendants at once; recursion threads `firedCovered` so nested raw emitters
--     aren't double-fired.
-- Returns total real-time wallclock duration in seconds across every spawned effect
-- (EmitDelay + EmitDuration + Timescale-distorted Lifetime + PartLife, recursing
-- nested transformed descendants). Returns nil when any branch is effectively infinite
-- (AnimateLoop unbounded, Timescale=0, or Timescale terminal value with wrong sign).
-- Pair with .await(n) for emit-and-wait. emitCtx threads through (see file header).
function Particle:AbsoluteEmit(item, _parentFiredPE, emitCtx)
	self:_warnIfNotActivated("AbsoluteEmit")
	if not item then return 0 end
	self:_absoluteEmitFire(item, _parentFiredPE, emitCtx)
	return _Duration.computeMaxDuration(item, 0)
end

-- Recursive :EnableEmitAt. Two-pass hybrid:
--
-- (A) `item` IS a transformed Part-Icle:
--   Emit via the existing engine pipeline with origin override threaded through
--   emitCtx. No clone of the source  -  engine handles nested transformed descendants
--   automatically via the standard emit pipeline.
--
-- (B) `item` is a non-transformed 3D container (BasePart / Model / Attachment):
--   Pass 1  -  every transformed Part-Icle descendant emits via engine pipeline with
--   per-node origin override (`originCF * anchor:ToObjectSpace(node.CFrame)`). NO
--   clone of any transformed item. Each Part-Icle's 60+ attributes / RenderTemplate
--   stay in place; only the engine's per-emit Pool.acquireOrClone is invoked.
--   Pass 2  -  clone the container WITHOUT its transformed descendants (stripped from
--   the clone) so only the non-transformed parts + raw PE / Trail / Beam survive.
--   Anchor + PivotTo the clone to originCF, parent into emit folder, fire raw
--   native dispatch on the clone, scheduled destroy after totalDur.
--
-- Result: transformed Part-Icles use the lightweight engine-level origin override
-- (no 60+ attribute copy). Raw native emitters get their proper clone-and-place
-- treatment. Repeated calls are independent (each call clones a fresh raw subtree).
--
-- options (optional table):
--   ChainCtx            event-chain context
--   OriginResolver      function() -> CFrame, evaluated at spawn time (live origin)
--   UseFullOrigin       bool; AtCFrame includes rotation. Default true
--   IgnoreLink          bool; bypass authored Link. Default false. Auto-false when Link override set
--   Link                Instance; per-call Link target override
--   LinkMode            string; "Follow" / "Pivot" / "Weld" / "WeldWithoutRotation"
--   EmitParent          Instance; per-call emit-folder override
--
-- Returns total real-time duration (or nil for infinite). Pair with .await(n).
function Particle:AbsoluteEmitAt(item, originCF, options)
	self:_warnIfNotActivated("AbsoluteEmitAt")
	if not item or not originCF then return 0 end
	options = options or {}
	local totalDur = _Duration.computeMaxDuration(item, 0)

	-- (A) Transformed root: thread emitCtx into the engine pipeline.
	if item:GetAttribute("Transformed") then
		local hasLinkOverride = options.Link ~= nil
		local emitCtx = {
			ChainCtx            = options.ChainCtx,
			EventOriginCF       = originCF,
			EventOriginResolver = options.OriginResolver,
			UseFullOrigin       = options.UseFullOrigin ~= false,
			IgnoreLink          = options.IgnoreLink == true and not hasLinkOverride,
			Link                = options.Link,
			LinkMode            = options.LinkMode,
			EmitParent          = options.EmitParent,
		}
		self:EnableEmit(item, options.Link, emitCtx)
		return totalDur
	end

	-- (B) Non-transformed 3D container: hybrid two-pass.
	if not (item:IsA("BasePart") or item:IsA("Model") or item:IsA("Attachment")) then
		return 0
	end

	-- Snapshot anchorCF so per-node origin (Pass 1) + clone reposition (Pass 2) both
	-- reference the same authored pivot baseline.
	local anchorCF
	if item:IsA("Model") then
		local ok, p = pcall(item.GetPivot, item); if ok then anchorCF = p end
	elseif item:IsA("BasePart") then anchorCF = item.CFrame
	elseif item:IsA("Attachment") then anchorCF = item.WorldCFrame end

	local function readWorldCF(it)
		if it:IsA("Model") then local ok, cf = pcall(it.GetPivot, it); return ok and cf or nil end
		if it:IsA("Attachment") then return it.WorldCFrame end
		if it:IsA("BasePart") then return it.CFrame end
		return nil
	end

	local function originFor(node)
		if not anchorCF then return originCF end
		local nodeCF = readWorldCF(node)
		if not nodeCF then return originCF end
		return originCF * anchorCF:ToObjectSpace(nodeCF)
	end

	local function ctxFor(node)
		return {
			ChainCtx            = options.ChainCtx,
			EventOriginCF       = originFor(node),
			EventOriginResolver = options.OriginResolver,
			UseFullOrigin       = options.UseFullOrigin ~= false,
			IgnoreLink          = options.IgnoreLink == true,
		}
	end

	-- Pass 1: per-node origin override for transformed Part-Icles on the ORIGINAL.
	-- Walks down stopping at each transformed leaf (engine pipeline recurses inside
	-- the leaf's RenderTemplate during emit, so we don't recurse past it ourselves).
	local function walkTransformed(node)
		if node:GetAttribute("Transformed") then
			self:EnableEmit(node, nil, ctxFor(node))
			return
		end
		for _, child in node:GetChildren() do
			walkTransformed(child)
		end
	end
	walkTransformed(item)

	-- Internal SkipClone path: caller owns the cloneRoot lifecycle (pool acquire +
	-- positioning + release). Skip Pass 2's clone+anchor+pivot+destroy block; fire
	-- raw native PE/Trail/Beam descendants in-place on the caller's pre-positioned
	-- subtree. Events.luau uses this so its pool reuse + Folder/PE wrappers stay
	-- intact while still picking up Pass 1's per-node origin override semantics.
	if options.SkipClone then
		ParticlesMod.EnableEmit(item, self:_makeAliveCheck())
		return totalDur
	end

	-- Pass 2: detect raw native emitters not covered by Pass 1. Skip Pass 2 entirely
	-- when nothing raw exists (saves the clone cost for pure Part-Icle containers).
	local function _underTransformedAncestor(desc)
		local cur = desc.Parent
		while cur and cur ~= item do
			if cur:GetAttribute("Transformed") then return true end
			cur = cur.Parent
		end
		return false
	end
	local hasRawEmitter = false
	for _, desc in ipairs(item:GetDescendants()) do
		if (desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam"))
			and not desc:GetAttribute("Transformed")
			and not _underTransformedAncestor(desc) then
			hasRawEmitter = true; break
		end
	end
	if not hasRawEmitter then return totalDur end

	local ok, clone = pcall(item.Clone, item)
	if not ok or not clone then return totalDur end
	pcall(function() clone.Archivable = false end)

	-- Strip transformed descendants from the clone (Pass 1 fired them on the
	-- original; keeping them in the clone would double-fire + waste the clone of
	-- their 60+ attributes).
	for _, desc in ipairs(clone:GetDescendants()) do
		if desc:GetAttribute("Transformed") then pcall(function() desc:Destroy() end) end
	end

	-- Anchor every remaining BasePart in the clone so PivotTo holds.
	if clone:IsA("BasePart") then pcall(function() clone.Anchored = true end) end
	for _, desc in ipairs(clone:GetDescendants()) do
		if desc:IsA("BasePart") then pcall(function() desc.Anchored = true end) end
	end

	-- Compute target CFrame. UseFullOrigin=true → originCF as-is. UseFullOrigin=false
	-- → use originCF's position with the container's authored rotation.
	local targetCF = originCF
	if not (options.UseFullOrigin ~= false) and anchorCF then
		targetCF = CFrame.new(originCF.Position) * anchorCF.Rotation
	end
	if clone:IsA("Model") then
		pcall(function() clone:PivotTo(targetCF) end)
	elseif clone:IsA("BasePart") then
		pcall(function() clone.CFrame = targetCF end)
	elseif clone:IsA("Attachment") then
		pcall(function() clone:Destroy() end)
		return totalDur
	end

	clone.Parent = self:GetFolder()
	-- Fire raw dispatch on the stripped clone. Transformed branch in _absoluteEmitFire
	-- is unreachable post-strip; only the raw PE / Trail / Beam / native-walk branches fire.
	self:_absoluteEmitFire(clone, nil, nil)

	-- Destroy clone after full emit window. Cap at 60s for infinite-duration emitters
	-- so the clone doesn't leak when totalDur is nil.
	local destroyDelay = totalDur or 60
	task.delay(destroyDelay, function()
		if clone and clone.Parent then pcall(function() clone:Destroy() end) end
	end)

	return totalDur
end

-- Particle:EnableEmitAt lives in Lifecycle.luau alongside EnableEmit / EmitAnimate /
-- Disable so the emission-control public APIs share a file. Same module-mixin pattern.

-- AbsoluteEnable / AbsoluteDisable live in Lifecycle.luau alongside Particle:Disable so the
-- single-item and recursive-state APIs share a file. Same recursion shape as AbsoluteEmit
-- (Transformed → engine path; raw PE/Trail → native .Enabled; container → walk descendants
-- skipping transformed sub-emitter RTs).

-- Preload / Deload API  -  texture-pin every texture-bearing item under `root`. Use `Preload` before
-- a skill cast so the first emit doesn't stutter on texture decode; `Deload` after the skill is
-- permanently retired to free GPU memory. Only items with `PreloadTexture=true` are touched unless
-- `force=true` is passed, in which case every transformed item / raw PE / raw Trail under root
-- gets pinned regardless of opt-in.
local _TexturePin = require(script.TexturePin)
local function _isPreloadable(i) return i:GetAttribute("Transformed") or i:IsA("ParticleEmitter") or i:IsA("Trail") end
local function _walk(root, force, action)
	if not root then return end
	local function visit(inst)
		if _isPreloadable(inst) and (force or inst:GetAttribute("PreloadTexture") == true) then action(inst) end
		for _, c in inst:GetChildren() do visit(c) end
	end
	visit(root)
end
-- Texture-pin every PreloadTexture=true descendant under `root` so the first emit
-- after Preload doesn't stall on texture decode. `force=true` pins every transformed
-- item / raw PE / raw Trail regardless of opt-in.
function Particle:Preload(root, force) _walk(root, force, _TexturePin.pinSubtree) end
-- Inverse of Preload; releases pinned textures so the engine can free GPU memory.
function Particle:Deload(root, force) _walk(root, force, _TexturePin.unpinSubtree) end

-- Standalone LinkService API. Reuses LinkMode dispatch on arbitrary BaseParts /
-- Models / Attachments  -  independent from the particle emit pipeline.
Particle.LinkService = require(script.LinkService)

-- Mutate the source item's authored Link/EmitParent. Use these for persistent
-- runtime wiring; per-call EnableEmitAt/AbsoluteEmitAt options are ephemeral.

-- target: Instance -> Link.Value + LinkSource="Object"
--         "camera"  -> LinkSource="Camera"
--         nil       -> LinkSource="None" + clear Link.Value
-- mode: optional, "Follow" / "Pivot" / "Weld" / "WeldWithoutRotation"
function Particle:SetLink(item, target, mode)
	if not item or not item:GetAttribute("Transformed") then return end
	if target == "camera" then
		pcall(function() item:SetAttribute("LinkSource", "Camera") end)
	elseif target == nil then
		pcall(function() item:SetAttribute("LinkSource", "None") end)
		local lk = item:FindFirstChild("Link")
		if lk and lk:IsA("ObjectValue") then lk.Value = nil end
	elseif typeof(target) == "Instance" then
		local lk = item:FindFirstChild("Link")
		if not lk then
			lk = Instance.new("ObjectValue")
			lk.Name = "Link"
			lk.Parent = item
		end
		lk.Value = target
		pcall(function() item:SetAttribute("LinkSource", "Object") end)
	end
	if mode then pcall(function() item:SetAttribute("LinkMode", mode) end) end
end

-- parent: Instance -> EmitParent.Value (cloned visuals go there)
--         nil      -> remove EmitParent (engine default emit folder used)
function Particle:SetEmitParent(item, parent)
	if not item or not item:GetAttribute("Transformed") then return end
	if parent == nil then
		local ep = item:FindFirstChild("EmitParent")
		if ep then pcall(function() ep:Destroy() end) end
		return
	end
	if typeof(parent) ~= "Instance" then return end
	local ep = item:FindFirstChild("EmitParent")
	if not ep then
		ep = Instance.new("ObjectValue")
		ep.Name = "EmitParent"
		ep.Parent = item
	end
	ep.Value = parent
end

-- Luau autocomplete + IntelliSense: the mixin pattern `require(script.X)(Particle)`
-- attaches methods at runtime, which Luau's static analyzer cannot follow. The cast
-- below tells the analyzer the public shape so users typing `Part:` see every API.
-- Field types are conservative (Instance + any) since most accept multiple authoring
-- types via internal dispatch (BasePart / Attachment / Model / Beam / etc.).
export type ParticleAPI = {
	-- Lifecycle
	Activate: (self: ParticleAPI) -> (),
	Deactivate: (self: ParticleAPI) -> (),
	Enable: (self: ParticleAPI, item: Instance, link: Instance?, duration: number?, emitCtx: any?) -> (),
	Disable: (self: ParticleAPI, item: Instance) -> (),
	AbsoluteEnable: (self: ParticleAPI, item: Instance) -> (),
	AbsoluteDisable: (self: ParticleAPI, item: Instance) -> (),

	-- Emit
	Emit: (self: ParticleAPI, item: Instance, link: Instance?, emitCtx: any?) -> (),
	EmitAnimate: (self: ParticleAPI, item: Instance, link: Instance?, emitCtx: any?) -> (),
	EnableEmit: (self: ParticleAPI, item: Instance, link: Instance?, emitCtx: any?) -> (),
	EnableEmitAt: (self: ParticleAPI, item: Instance, originCF: CFrame, options: {[string]: any}?) -> (),
	AbsoluteEmit: (self: ParticleAPI, item: Instance, _parentFiredPE: boolean?, emitCtx: any?) -> number?,
	AbsoluteEmitAt: (self: ParticleAPI, item: Instance, originCF: CFrame, options: {[string]: any}?) -> number?,

	-- Timescale
	SetTimescale: (self: ParticleAPI, item: Instance, scale: number, duration: number?, permanent: boolean?) -> (),
	ClearTimescale: (self: ParticleAPI, item: Instance) -> (),
	AbsoluteSetTimescale: (self: ParticleAPI, item: Instance, scale: number, duration: number?, permanent: boolean?) -> (),
	AbsoluteClearTimescale: (self: ParticleAPI, item: Instance) -> (),

	-- Authoring + utilities
	Transform: (self: ParticleAPI, part: Instance) -> (),
	TransformModel: (self: ParticleAPI, model: Model, typeDef: any) -> (),
	Preload: (self: ParticleAPI, root: Instance, force: boolean?) -> (),
	Deload: (self: ParticleAPI, root: Instance, force: boolean?) -> (),
	SetLink: (self: ParticleAPI, item: Instance, target: (Instance | string)?, mode: string?) -> (),
	SetEmitParent: (self: ParticleAPI, item: Instance, parent: Instance?) -> (),
	GetData: (self: ParticleAPI, item: Instance) -> any,
	GetFolder: (self: ParticleAPI) -> Folder,
	GetPoolFolder: (self: ParticleAPI) -> Folder,
	ReapplyLink: (self: ParticleAPI, pData: any) -> (),

	-- Statics
	await: (n: number?) -> (),
	parseDuration: (raw: any) -> number?,
	LinkService: typeof(require(script.LinkService)),
	TransformCompleted: BindableEvent,
	Beam: {[string]: any},
	MAX_ACTIVE_PARTICLES: number,
	ActiveEmits: {any},
	ActiveLoops: {[Instance]: thread},
	ActiveAnimates: {[Instance]: any},
}

return Particle :: ParticleAPI
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">AxisLinks</string>
              <string name="Source"><![CDATA[--[[
	AxisLinks  -  graph-axis alias pass shared between EmitPart and AnimateLoop refresh.
	When two axes are linked, the follower's graph + seed point at the primary's, so they track
	tick-for-tick. `sanitize` is the chokepoint that filters cross-group / self / chain / cycle.
]]

local AxisLinks = {}

local GRAPH_FOLLOWERS = {"SizeX","SizeY","SizeZ","RotSpeedX","RotSpeedY","RotSpeedZ","PosOffsetX","PosOffsetY","PosOffsetZ"}

-- Same-group axis link metadata. Cross-group links rejected at sanitize.
local AXIS_GROUPS = {
	{"SizeX","SizeY","SizeZ"},
	{"RotSpeedX","RotSpeedY","RotSpeedZ"},
	{"PosOffsetX","PosOffsetY","PosOffsetZ"},
	{"RotX","RotY","RotZ"},
	{"PosX","PosY","PosZ"},
}
local AXIS_GROUP_OF = {}
for _, group in ipairs(AXIS_GROUPS) do
	local set = {}
	for _, a in ipairs(group) do set[a] = true end
	for _, a in ipairs(group) do AXIS_GROUP_OF[a] = set end
end

-- Resolve a follower's link target. Returns nil for no-link / self-link / cross-group / chain / cycle.
local function resolveAxisLink(raw, follower)
	local primary = raw and raw[follower] or nil
	if not primary or primary == "" or primary == follower then return nil end
	local group = AXIS_GROUP_OF[follower]
	if not group or not group[primary] then return nil end
	local primaryLink = raw[primary]
	if primaryLink and primaryLink ~= "" and primaryLink ~= primary and group[primaryLink] then return nil end
	return primary
end

-- Sanitize raw {axisKey -> rawAttrString} into resolved {follower -> primary or nil}.
function AxisLinks.sanitize(raw)
	local resolved = {}
	for _, group in ipairs(AXIS_GROUPS) do
		for _, a in ipairs(group) do resolved[a] = resolveAxisLink(raw, a) end
	end
	return resolved
end

function AxisLinks.applyGraphAxisAliases(graphs, seeds, axisLinks)
	if not axisLinks or not graphs or not seeds then return end
	for _, follower in ipairs(GRAPH_FOLLOWERS) do
		local primary = axisLinks[follower]
		if primary and primary ~= follower and graphs[primary] and seeds[primary] then
			graphs[follower] = graphs[primary]
			seeds[follower] = seeds[primary]
		end
	end
end

-- Range-axis sampler. Primary axes sampled once, linked followers reuse primary's scalar.
-- EvenDistribution: `{axis}Even` + emitCtx → t = i/N (skips Min so circular ranges don't
-- collide at 0/360). N=1 → midpoint.
function AxisLinks.sampleRangeAxes(data, axisLinks, axes, RangeMod, emitCtx)
	local emitIndex = emitCtx and emitCtx.EmitIndex
	local emitCount = emitCtx and emitCtx.EmitCount
	local hasEvenCtx = emitIndex and emitCount and emitCount > 0
	local sampled = {}
	for _, k in ipairs(axes) do
		local primary = axisLinks and axisLinks[k]
		if not primary then
			local even = data[k .. "Even"] == true
			if even and hasEvenCtx then
				local r = data[k]
				local t
				if emitCount == 1 then t = 0.5
				else t = emitIndex / emitCount end
				sampled[k] = r.Min + (r.Max - r.Min) * t
			else
				sampled[k] = RangeMod.RandomValueFromRange(data[k])
			end
		end
	end
	for _, k in ipairs(axes) do
		if sampled[k] == nil then
			local primary = axisLinks and axisLinks[k]
			sampled[k] = (primary and sampled[primary]) or RangeMod.RandomValueFromRange(data[k])
		end
	end
	return sampled
end

-- AnimateLoop refresh: rebuild Graphs from freshData, re-roll seeds, re-apply axis aliases.
function AxisLinks.refreshLoopGraphsAndSeeds(pData, freshData, GraphMod)
	if not pData.Graphs then return end
	for k, _ in pairs(pData.Graphs) do
		if freshData[k] ~= nil then pData.Graphs[k] = freshData[k] end
	end
	if pData.Seeds then for k, _ in pairs(pData.Seeds) do
		if pData.Graphs[k] then pData.Seeds[k] = GraphMod.GenerateSeed(pData.Graphs[k]) end
	end end
	AxisLinks.applyGraphAxisAliases(pData.Graphs, pData.Seeds, freshData.AxisLinks)
end

return AxisLinks
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">Duration</string>
              <string name="Source"><![CDATA[--[[
	Duration  -  compute true real-time wallclock for an emit dispatch.
	Honors EmitDelay, EmitDuration ranges, AnimateLoop, PartLife, and Timescale
	graph distortion (numerical integration; piecewise-linear graphs have no closed form).
	Returns nil to signal "effectively infinite" (AnimateLoop unbounded, Timescale=0,
	or Timescale clamps to a sign that never reaches the death boundary).
]]

local Graph = require(script.Parent.Graph)

local Duration = {}

local INTEGRATION_STEPS = 200

local function resolveDuration(raw)
	if raw == nil then return 0 end
	if typeof(raw) == "number" then return raw end
	local vals = {}
	for v in tostring(raw):gmatch("[^,]+") do
		local n = tonumber(v:match("^%s*(.-)%s*$"))
		if n then table.insert(vals, n) end
	end
	if #vals == 0 then return 0 end
	if #vals == 1 then return vals[1] end
	return math.max(vals[1], vals[2])
end

-- Wallclock time from spawn to death for one particle authored with the given
-- lifetime + Timescale curve. Two-phase: integrate ts(real_i) for real_i in [0,1]
-- (wall time 0 → lifetime), then if effective hasn't crossed the boundary, extend
-- with the terminal ts(1) value held constant until the boundary is reached.
function Duration.computeTrueLifetime(lifetime, timescaleGraph, seed)
	if not lifetime or lifetime <= 0 then return 0 end
	if not timescaleGraph then return lifetime end

	if Graph.IsStatic(timescaleGraph) then
		local v = Graph.GetStaticValue(timescaleGraph, 1)
		if v == 1 then return lifetime end
		if v == 0 then return nil end
		if v > 0 then return lifetime / v end
		return lifetime / (-v)
	end

	local seed_ = seed or {}
	local ts0 = Graph.QueryPointsWithTime(0, timescaleGraph, seed_)
	local reverse = ts0 < 0
	local eff = reverse and lifetime or 0
	local realT = 0
	local dRealT = lifetime / INTEGRATION_STEPS

	for i = 1, INTEGRATION_STEPS do
		local real_i = i / INTEGRATION_STEPS
		local ts = Graph.QueryPointsWithTime(real_i, timescaleGraph, seed_)
		local prevEff = eff
		eff = eff + ts * dRealT
		if not reverse and eff >= lifetime then
			local frac = (lifetime - prevEff) / (eff - prevEff)
			return realT + frac * dRealT
		end
		if reverse and eff <= 0 then
			local frac = prevEff / (prevEff - eff)
			return realT + frac * dRealT
		end
		realT = realT + dRealT
	end

	-- Phase 2: real_i clamps at 1, ts stays constant at ts(1) per Update.luau math.
	local tsTerminal = Graph.QueryPointsWithTime(1, timescaleGraph, seed_)
	if reverse then
		if tsTerminal >= 0 then return nil end
		return realT + eff / (-tsTerminal)
	end
	if tsTerminal <= 0 then return nil end
	return realT + (lifetime - eff) / tsTerminal
end

-- Returns a lifecycle descriptor for a single item, or nil when the item is not
-- fire-eligible (no count, no duration, not a recognized emitter type).
-- Descriptor fields:
--   emitDelay   = scheduling delay before this item starts firing
--   emitDur     = burst window or continuous-Enable duration in seconds
--   lifecycle   = trailing real-time after emit ends until the last spawned particle dies
--   infinite    = true when this item is unbounded (AnimateLoop without EmitDuration,
--                 or Timescale that never reaches the death boundary)
function Duration.computeItemLifecycle(item)
	if item:GetAttribute("Transformed") then
		local config = item:FindFirstChild("PartIcleProperties")
		local emitDelay = item:GetAttribute("EmitDelay") or 0
		local emitDur = resolveDuration(item:GetAttribute("EmitDuration"))
		local rawCount = item:GetAttribute("EmitCount")
		local count = rawCount == nil and 1 or rawCount
		local emissionMode = item:GetAttribute("EmissionMode") or "Emit"
		local animateLoop = item:GetAttribute("AnimateLoop") == true

		if emissionMode == "Animate" and animateLoop and emitDur <= 0 then
			return { emitDelay = emitDelay, emitDur = 0, lifecycle = 0, infinite = true }
		end
		local fires = (count > 0) or (emitDur > 0) or (emissionMode == "Animate")
		if not fires then return nil end

		local lifetime = config and config:GetAttribute("Lifetime")
		local lifetimeMax = 0
		if typeof(lifetime) == "NumberRange" then lifetimeMax = lifetime.Max
		elseif type(lifetime) == "number" then lifetimeMax = lifetime end

		local timescale = config and config:GetAttribute("Timescale")
		local trueLife = Duration.computeTrueLifetime(lifetimeMax, timescale, nil)
		if trueLife == nil then
			return { emitDelay = emitDelay, emitDur = emitDur, lifecycle = 0, infinite = true }
		end

		local partLife = (config and config:GetAttribute("PartLife")) or 0
		-- Animate mode runs at minimum one full lifecycle even with EmitDuration=0.
		if emissionMode == "Animate" and trueLife > emitDur then emitDur = trueLife end

		return { emitDelay = emitDelay, emitDur = emitDur, lifecycle = trueLife + partLife, infinite = false }
	end

	if item:IsA("ParticleEmitter") then
		local rawCount = item:GetAttribute("EmitCount")
		local count = rawCount == nil and 1 or rawCount
		local emitDelay = tonumber(item:GetAttribute("EmitDelay")) or 0
		local emitDur = tonumber(item:GetAttribute("EmitDuration")) or 0
		if count <= 0 and emitDur <= 0 then return nil end
		local life = item.Lifetime
		local lifeMax = (typeof(life) == "NumberRange" and life.Max) or 0
		return { emitDelay = emitDelay, emitDur = emitDur, lifecycle = lifeMax, infinite = false }
	end

	if item:IsA("Trail") then
		local tDelay = item:GetAttribute("EmitDelay") or 0
		local tDur = resolveDuration(item:GetAttribute("EmitDuration"))
		if tDur <= 0 then return nil end
		return { emitDelay = tDelay, emitDur = tDur, lifecycle = item.Lifetime or 0, infinite = false }
	end

	if item:IsA("Beam") then
		local bDelay = tonumber(item:GetAttribute("EmitDelay")) or 0
		local bDur = tonumber(item:GetAttribute("EmitDuration")) or 0
		if bDur <= 0 then return nil end
		return { emitDelay = bDelay, emitDur = bDur, lifecycle = 0, infinite = false }
	end

	return nil
end

-- Recursive walk. Returns the max finish-time across this item and its emit-eligible
-- descendants, OR nil if any branch is infinite. Mirrors EmitDispatch.descendantMaxEmitTime
-- traversal: transformed-no-op short-circuits subtree, RenderTemplate children only
-- recurse into transformed descendants (nested per-clone emitters).
function Duration.computeMaxDuration(item, accumDelay)
	if not item then return 0 end
	accumDelay = accumDelay or 0

	local info = Duration.computeItemLifecycle(item)
	local myFinish = 0
	local childAccum = accumDelay
	local skipChildren = false

	if info then
		if info.infinite then return nil end
		myFinish = accumDelay + info.emitDelay + info.emitDur + info.lifecycle
		childAccum = accumDelay + info.emitDelay
		if item:GetAttribute("Transformed") then
			-- Transformed-but-no-fire would have returned nil above; non-fire descendants
			-- inside a transformed item don't run as their own AbsoluteEmit.
		end
	else
		if item:GetAttribute("Transformed") then
			skipChildren = true
		end
	end

	if not skipChildren then
		for _, child in ipairs(item:GetChildren()) do
			if child.Name == "RenderTemplate" then
				for _, desc in ipairs(child:GetDescendants()) do
					if desc:GetAttribute("Transformed") then
						local sub = Duration.computeMaxDuration(desc, childAccum)
						if sub == nil then return nil end
						if sub > myFinish then myFinish = sub end
					end
				end
			else
				local sub = Duration.computeMaxDuration(child, childAccum)
				if sub == nil then return nil end
				if sub > myFinish then myFinish = sub end
			end
		end
	end

	return myFinish
end

return Duration
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">Emit</string>
              <string name="Source"><![CDATA[--[[
	Emit Mixin  -  per-type one-shot emit for Part / Attachment / Beam.
	Clones RT, computes initial CFrame + direction, pushes pData onto Particle.ActiveEmits.
	Motion math shared with Motion Preview via PreSimulateForward / PreSimulateAttachmentForward.
]]

local GraphMod = require(script.Parent.Graph)
local RangeMod = require(script.Parent.Range)
local AxisLinksMod = require(script.Parent.AxisLinks)
local ParticlesMod = require(script.Parent.Particles)
local MeshFlipMod = require(script.Parent.Flipbook)
local EventsMod = require(script.Parent.Events)
local Constants = require(script.Parent.PartConstants)
local Pool = require(script.Parent.Pool)
local NestedEmit = require(script.Parent.NestedEmit)
local StaticPass = require(script.Parent.StaticPass)
local DirectionVectors = Constants.DirectionVectors
local shapeFunctions = Constants.shapeFunctions

-- Walk up the parent chain to find the nearest BasePart. Attachment nested inside
-- Attachment(s) must compose through ancestors; we anchor the visual to the first
-- BasePart so its parent-local CFrame math behaves consistently with sibling-emit types.
local function _findBasePartAncestor(inst)
	local p = inst.Parent
	while p do
		if p:IsA("BasePart") then return p end
		p = p.Parent
	end
	return nil
end

return function(Particle)

-- One Part emit. Initial CFrame: link/LinkMode → Shape offset → RotXYZ → Position offset
-- → strip rotation if DirMode=Global. InvertMotion pre-simulates to endpoint.
-- emitCtx (optional): {ChainCtx, EmitIndex, EventOriginCF, EventOriginResolver, IgnoreLink, UseFullOrigin}
-- EventOriginResolver wins over EventOriginCF (live vs snapshot).
function Particle:EmitPart(part, link, emitCtx)
	if not part or not part.Parent then return end
	local data = self:GetData(part)
	if not data or not data.RenderTemplate then return end
	-- Per-call ctx overrides (set by EnableEmitAt / AbsoluteEmitAt options).
	if emitCtx then
		if emitCtx.LinkMode then data.LinkMode = emitCtx.LinkMode end
		if emitCtx.EmitParent then data.EmitParent = emitCtx.EmitParent end
	end
	if emitCtx and emitCtx.IgnoreLink then
		link = nil
	else
		link = link or data.Link
	end

	local Time = RangeMod.RandomValueFromRange(data.Lifetime)
	if Time <= 0 then Time = 0.001 end

	-- Follow drops link rotation; Weld/Pivot compose it.
	local unrotatedCF
	local originOverrideCF
	if emitCtx then
		if emitCtx.EventOriginResolver then originOverrideCF = emitCtx.EventOriginResolver() end
		if not originOverrideCF then originOverrideCF = emitCtx.EventOriginCF end
	end
	if originOverrideCF then
		if emitCtx and emitCtx.UseFullOrigin then
			unrotatedCF = originOverrideCF -- AtCFrame: full source orientation
		else
			-- AtPosition / AtSource: replace position only, keep target rotation.
			unrotatedCF = CFrame.new(originOverrideCF.Position) * part.CFrame.Rotation
		end
	elseif link then
		local lCF = Constants.resolveLinkCFrame(link)
		local lPos = lCF.Position
		if data.LinkMode == "Follow" then unrotatedCF = CFrame.new(lPos) * part.CFrame.Rotation
		else unrotatedCF = CFrame.new(lPos) * lCF.Rotation * part.CFrame.Rotation end
	else unrotatedCF = part.CFrame end
	local dirInfo = DirectionVectors[data.EmissionDirection] or DirectionVectors[Enum.NormalId.Top]
	local rawWorldDirection = unrotatedCF[dirInfo.vector] * dirInfo.multiplier

	-- Shape branch. UseShape gates; shape function returns offset / rotation / outward direction.
	-- ShapePart override: when set, sample volume + spawn position in ShapePart's frame.
	-- nil falls back to existing source-frame behavior (unrotatedCF).
	local localOffset = Vector3.new()
	local shapeDir = nil
	local initialCF = unrotatedCF
	if data.UseShape then
		local shapeFunc = shapeFunctions[data.ParticleData.Shape]
		if shapeFunc then
			local shapeSrc = data.ShapePart or part
			local shapeCF = data.ShapePart and data.ShapePart.CFrame or unrotatedCF
			local sOffset, sRotation, sDirVec = shapeFunc(shapeSrc, data.ParticleData)
			localOffset = sOffset
			local sio = data.ParticleData.ShapeInOut
			if sio == Enum.ParticleEmitterShapeInOut.Inward then
				sDirVec = -sDirVec
			elseif sio == Enum.ParticleEmitterShapeInOut.InAndOut then
				if math.random() < 0.5 then sDirVec = -sDirVec end
			end
			shapeDir = (shapeCF - shapeCF.Position):VectorToWorldSpace(sDirVec)
			if data.ParticleData.LookAtInitially then
				local rx, ry, rz = initialCF:ToEulerAnglesXYZ()
				initialCF = CFrame.new((shapeCF * CFrame.new(localOffset)).Position)
					* sRotation * CFrame.Angles(rx, ry, rz)
			else
				initialCF = CFrame.new((shapeCF * CFrame.new(localOffset)).Position) * initialCF.Rotation
			end
		else
			initialCF = CFrame.new((initialCF * CFrame.new(localOffset)).Position) * initialCF.Rotation
		end
	else
		initialCF = CFrame.new((initialCF * CFrame.new(localOffset)).Position) * initialCF.Rotation
	end

	local dirMode = data.DirMode or "RigidLocal"
	local rotS = AxisLinksMod.sampleRangeAxes(data, data.AxisLinks, {"RotX","RotY","RotZ"}, RangeMod, emitCtx)
	local RX, RY, RZ = rotS.RotX, rotS.RotY, rotS.RotZ
	local rotXYZ = Constants.composeRotation(data.RotOrder or "Global", RX, RY, RZ)
	initialCF = initialCF * rotXYZ

	initialCF = Constants.applyPositionOffset(initialCF, data, link, part, RangeMod, AxisLinksMod, emitCtx)

	-- Global DirMode: drop emitter+link rotation; keep RotXYZ.
	if dirMode == "Global" then
		initialCF = CFrame.new(initialCF.Position) * rotXYZ
	end

	local baseDirection
	if shapeDir then
		baseDirection = shapeDir
	elseif dirMode == "Local" then
		baseDirection = initialCF[dirInfo.vector] * dirInfo.multiplier
	elseif dirMode == "Global" then
		baseDirection = CFrame.new()[dirInfo.vector] * dirInfo.multiplier
	else
		baseDirection = rawWorldDirection
	end
	local randomX, randomY = 0, 0
	if data.ParticleData.SpreadAngle.X > 0 or data.ParticleData.SpreadAngle.Y > 0 then
		randomX = (math.random() * 2 - 1) * data.ParticleData.SpreadAngle.X
		randomY = (math.random() * 2 - 1) * data.ParticleData.SpreadAngle.Y
	end
	local spreadRotation = CFrame.Angles(math.rad(randomX), math.rad(randomY), 0)

	local cf = CFrame.lookAt(Vector3.new(), baseDirection)
	cf = cf * spreadRotation
	baseDirection = cf.LookVector

	local seeds = {
		SizeX = GraphMod.GenerateSeed(data.SizeX), SizeY = GraphMod.GenerateSeed(data.SizeY), SizeZ = GraphMod.GenerateSeed(data.SizeZ),
		RotSpeedX = GraphMod.GenerateSeed(data.RotSpeedX), RotSpeedY = GraphMod.GenerateSeed(data.RotSpeedY), RotSpeedZ = GraphMod.GenerateSeed(data.RotSpeedZ),
		PosOffsetX = GraphMod.GenerateSeed(data.PosOffsetX), PosOffsetY = GraphMod.GenerateSeed(data.PosOffsetY), PosOffsetZ = GraphMod.GenerateSeed(data.PosOffsetZ),
		Speed = GraphMod.GenerateSeed(data.Speed), Brightness = GraphMod.GenerateSeed(data.Brightness),
		Transparency = GraphMod.GenerateSeed(data.Transparency),
		AccelStrength = GraphMod.GenerateSeed(data.AccelStrength),
		Timescale = GraphMod.GenerateSeed(data.Timescale),
	}

	-- Axis-link alias: followers adopt primary's seed + graph; mutates data + seeds in-place.
	AxisLinksMod.applyGraphAxisAliases(data, seeds, data.AxisLinks)

	local invertMotion = data.InvertMotion
	local simLocalCFrames = nil
	local simEffectiveTKF = nil

	if invertMotion then
		simLocalCFrames, simEffectiveTKF = self:PreSimulateForward(data, seeds, initialCF, baseDirection, spreadRotation, link, Time, nil, initialCF.Rotation * rotXYZ:Inverse())
	end

	local visualPart = Pool.acquireOrCopyBare(data.RenderTemplate, "Part", data.Pool)
	visualPart.Archivable = false
	local parentCF_now
	if link then
		local lC = Constants.resolveLinkCFrame(link)
		-- Only Weld uses full link CFrame; Follow/Pivot keep motion world-space.
		parentCF_now = (data.LinkMode == "Follow" or data.LinkMode == "Pivot") and CFrame.new(lC.Position) or lC
	else parentCF_now = CFrame.new() end
	local localCF

	if invertMotion and simLocalCFrames then
		-- Place at endpoint of forward sim. Index by effective TKF since presim caps at 500.
		local endLocalCF = simLocalCFrames[simEffectiveTKF or data.TotalKeyFrames] or simLocalCFrames[0]
		localCF = endLocalCF
		visualPart.CFrame = parentCF_now * localCF
	else
		localCF = link and parentCF_now:ToObjectSpace(initialCF) or initialCF
		visualPart.CFrame = parentCF_now * localCF
	end

	local pData = {
		Type = "Part",
		VisualPart = visualPart,
		Link = link,
		LinkMode = data.LinkMode,
		Events = data.Events,
		SpecialMesh = visualPart:FindFirstChildOfClass('SpecialMesh'),
		Decal = visualPart:FindFirstChildOfClass('Decal'),
		-- SurfaceAppearance: flipbook routes to ColorMap, Transparency/Color graphs drive MeshPart
		-- because SurfaceAppearance has no per-instance Transparency / Color3 surface.
		SurfaceAppearance = visualPart:FindFirstChildOfClass('SurfaceAppearance'),

		StartTime = os.clock(),
		TotalKeyFrames = invertMotion and simEffectiveTKF or math.max(1, data.TotalKeyFrames),
		CurrentStep = 0,
		AccumulatedDT = 0,
		LifeTime = Time,
		PartLife = data.PartLife,
		CurrentPosition = visualPart.Position,
		LocalCF = localCF,

		BaseDirection = baseDirection,
		-- Accumulated velocity contribution from Acceleration. Tracked explicitly so OnHit
		-- Bounce can reflect it along the hit normal (a closed-form `accel * elapsedSec`
		-- would keep integrating from t=0 across a bounce, diverging from physics).
		_accelVel = Vector3.zero,
		-- Speed multiplier: scales the speed graph's output. Compounds across bounces
		-- when Bounciness < 1  -  each bounce loses energy along the normal, so the
		-- particle's effective speed decreases on impact.
		SpeedMultiplier = 1,
		-- Persistent angular velocity from collision impulses (deg/sec, world axes).
		-- Bounce's tangential drag converts to spin; this rate compounds with each
		-- glancing impact. _spinAccum tracks the integrated rotation contribution.
		_spinRate = Vector3.zero,
		_spinAccumX = 0,
		_spinAccumY = 0,
		_spinAccumZ = 0,
		EmissionDirection = data.EmissionDirection,
		SpreadRotation = spreadRotation,
		Acceleration = data.ParticleData.Acceleration,
		Drag = data.ParticleData.Drag,
		VelocityVectored = data.VelocityVectored,

		InvertMotion = invertMotion,
		SimLocalCFrames = simLocalCFrames,

		RotMode = data.RotMode or "OverLife",
		RotOrder = data.RotOrder or "Global",
		AccRotX = 0, AccRotY = 0, AccRotZ = 0,

		Orientation = data.Orientation,
		ZOffset = data.ZOffset,
		_localWorldCF = localCF, -- seed for LinkTrack frame 0

		-- PosOffsetX/Y/Z trajectory state. DisplacementMode selects which rotation
		-- to apply: Local = SpawnRotation (post-RotXYZ particle frame); RigidLocal
		-- = SpawnEmitterRotation (same frame as SpawnRotation but with the per-
		-- particle RotXYZ contribution algebraically removed via rotXYZ:Inverse());
		-- Global = no rotation. HasPosOffsetGraphs gates per-frame work.
		SpawnRotation = localCF.Rotation,
		SpawnEmitterRotation = localCF.Rotation * rotXYZ:Inverse(),
		DisplacementMode = data.DisplacementMode,
		-- Body bbox half-diagonal for Jolt-style point-velocity sleep check.
		-- Captures rotation-induced edge speed when CoM is near-stationary.
		_sleepRadius = (visualPart and visualPart:IsA("BasePart") and visualPart.Size.Magnitude * 0.5) or 1.0,
		_prevWorldOff = Vector3.zero,
		HasPosOffsetGraphs = data.PosOffsetX ~= nil or data.PosOffsetY ~= nil or data.PosOffsetZ ~= nil,

		-- Target-accel: target.Position read live each frame, target ref fixed at emit.
		-- Disabled with InvertMotion (cached SimLocalCFrames can't track moving targets).
		HasTargetAccel = data.AccelerationTowardsInstance == true and data.AccelTarget ~= nil and data.AccelStrength ~= nil and not data.InvertMotion,
		AccelTarget = data.AccelTarget,
		TargetVel = Vector3.zero,
		NeedsFullIteration = data.VelocityVectored,
		NeedsRotAccum = (data.RotMode == "Speed") and not data.VelocityVectored,
		HasDrag = data.ParticleData.Drag ~= 0,
		HasAccel = data.ParticleData.Acceleration.Magnitude > 0,
		HasDecal = visualPart:FindFirstChildOfClass('Decal') ~= nil,

		Graphs = {
			SizeX = data.SizeX, SizeY = data.SizeY, SizeZ = data.SizeZ,
			RotSpeedX = data.RotSpeedX, RotSpeedY = data.RotSpeedY, RotSpeedZ = data.RotSpeedZ,
			PosOffsetX = data.PosOffsetX, PosOffsetY = data.PosOffsetY, PosOffsetZ = data.PosOffsetZ,
			Speed = data.Speed, Brightness = data.Brightness,
			Transparency = data.Transparency, Color = data.Color,
			AccelStrength = data.AccelStrength,
			Timescale = data.Timescale,
		},

		Seeds = seeds,
		_effectiveElapsed = GraphMod.InitialEffectiveElapsed(data.Timescale, seeds.Timescale, Time),
	}

	-- 1-frame pop prevention for PosOffset graphs: sample at t=0, apply to spawn
	-- pose so frame-0 visual already includes the initial offset. Initialize
	-- _prevWorldOff to worldOff(0) so the first Update step's delta is measured
	-- from this baseline (not from zero  -  which would cause a teleport at step 1
	-- for front-loaded curves where posOff ramps fast initially).
	if pData.HasPosOffsetGraphs then
		local oX = pData.Graphs.PosOffsetX and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetX, pData.Seeds.PosOffsetX) or 0
		local oY = pData.Graphs.PosOffsetY and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetY, pData.Seeds.PosOffsetY) or 0
		local oZ = pData.Graphs.PosOffsetZ and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetZ, pData.Seeds.PosOffsetZ) or 0
		local worldOff = Constants.resolveDisplacement(Vector3.new(oX, oY, oZ),
			data.DisplacementMode or "Global", pData.SpawnRotation, pData.SpawnEmitterRotation)
		pData._prevWorldOff = worldOff
		if oX ~= 0 or oY ~= 0 or oZ ~= 0 then
			pData.LocalCF = pData.LocalCF + worldOff
			pData.VisualPart.CFrame = pData.VisualPart.CFrame + worldOff
		end
	end

	-- 1-frame pop prevention.
	local startSize = Vector3.new(GraphMod.QueryPointsWithTime(0, pData.Graphs.SizeX, pData.Seeds.SizeX), GraphMod.QueryPointsWithTime(0, pData.Graphs.SizeY, pData.Seeds.SizeY), GraphMod.QueryPointsWithTime(0, pData.Graphs.SizeZ, pData.Seeds.SizeZ))
	local startTrans = GraphMod.QueryPointsWithTime(0, pData.Graphs.Transparency, pData.Seeds.Transparency)
	local startColor = GraphMod.QueryColorPointWithTime(0, pData.Graphs.Color)
	local startBright = GraphMod.QueryPointsWithTime(0, pData.Graphs.Brightness, pData.Seeds.Brightness)

	if pData.SpecialMesh then
		pData.SpecialMesh.Scale = startSize
	else
		pData.VisualPart.Size = startSize
	end

	if pData.SurfaceAppearance then
		-- Color graph tints SA.Color raw; Brightness graph drives SA.EmissiveTint only.
		-- EmissiveTint write pcall-guarded for older Studio builds without the property.
		pData.VisualPart.Transparency = startTrans
		pData.VisualPart.Color = Color3.fromRGB(startColor.R * 255, startColor.G * 255, startColor.B * 255)
		pData.SurfaceAppearance.Color = Color3.fromRGB(startColor.R * 255, startColor.G * 255, startColor.B * 255)
		pcall(function() pData.SurfaceAppearance.EmissiveTint = Color3.new(startColor.R * startBright, startColor.G * startBright, startColor.B * startBright) end)
	elseif pData.Decal then
		pData.Decal.Transparency = startTrans
		pData.Decal.Color3 = Color3.fromRGB(startColor.R * 255 * startBright, startColor.G * 255 * startBright, startColor.B * 255 * startBright)
	else
		-- Plain MeshPart: Brightness multiplies SA/Decal only.
		pData.VisualPart.Transparency = startTrans
		pData.VisualPart.Color = Color3.fromRGB(startColor.R * 255, startColor.G * 255, startColor.B * 255)
	end

	-- Disable PEs BEFORE Parent so they don't auto-emit on workspace entry;
	-- EnableEmitSingle below controls their timing.
	for _, desc in visualPart:GetDescendants() do
		if desc:IsA("ParticleEmitter") then desc.Enabled = false end
	end

	visualPart.Parent = data.EmitParent or self:GetFolder()

	for _, desc in visualPart:GetDescendants() do
		if desc:IsA("Trail") then
			if desc:GetAttribute("Transformed") then continue end
			local underTransformed = false
			local cur = desc.Parent
			while cur and cur ~= visualPart do
				if cur:GetAttribute("Transformed") then underTransformed = true; break end
				cur = cur.Parent
			end
			if underTransformed then continue end
			local dur = desc:GetAttribute("EmitDuration")
			if dur ~= nil then
				if desc.Enabled ~= true then
					desc.Enabled = true
				end
				if desc:GetAttribute("_pooledTrailEnabled") ~= nil then
					desc:SetAttribute("_pooledTrailEnabled", true)
				end
			end
		end
	end

	-- Restore pooled Trails (deferred 1 Heartbeat). Snapshot was synced above
	-- so this is consistent with our pre-Parent enable for fresh emits.
	Pool.restoreTrails(visualPart, "Part")

	-- EnableEmitSingle schedules the EmitDuration-end Trail.Enabled=false and
	-- the PE Emit(count) burst. Trail.Enabled=true was already set above; this
	-- just registers the disable timer + PE emission.
	local alive = self:_makeAliveCheck()
	for _, child in visualPart:GetChildren() do
		if child:IsA("Attachment") then ParticlesMod.EnableEmitChildrenAndRepeatForAttachments(child, alive) end
		ParticlesMod.EnableEmitSingle(child, alive)
	end

	if self._parentScaleMap and self._parentScaleMap[part] then
		pData.ParentScale = self._parentScaleMap[part]
	end

	pData._sourceItem = part
	Particle._seedTsOverride(pData, part)
	if data.Pool ~= false then pData._sourceRT, pData._poolKind = data.RenderTemplate, "Part" end
	-- Static-graph short-circuit: constant-valued graphs nil out + stamp pData._static<Name>.
	StaticPass.apply(pData)
	-- _applyEmitVisualPasses MUST precede _registerEmit (OnEmit payload reads post-pass CFrame).
	self:_applyEmitVisualPasses(pData)
	self:_registerEmit(pData, emitCtx)

	-- Flipbook target: SA.ColorMap if present, else Decal.Texture, else MeshPart.TextureID
	-- when the visual is a plain MeshPart with no Decal/SA child to write to.
	if data.CachedMeshTextures and #data.CachedMeshTextures > 0 then
		local flipTarget = pData.SurfaceAppearance or pData.Decal
		if not flipTarget and visualPart:IsA("MeshPart") then flipTarget = visualPart end
		if flipTarget then
			MeshFlipMod.Flip(pData, data.ParticleData, data.CachedMeshTextures, flipTarget, Time)
		end
	end

	-- Nested Part-Icles: source-walk; link = visualPart drives position. See NestedEmit.luau.
	pData._nestedAlive = { true }
	NestedEmit.walk(self, data.RenderTemplate, visualPart, pData._nestedAlive, emitCtx)
end

-- Attachment variant  -  sim runs in parent-BasePart-local space. DirMode 3-way split:
-- Local = post-RotXYZ; Global = world axis rebased; RigidLocal = pre-RotXYZ.
function Particle:EmitAttachment(attachment, link, emitCtx)
	if not attachment or not attachment.Parent then return end
	local data = self:GetData(attachment)
	if not data or not data.RenderTemplate then return end
	if emitCtx then
		if emitCtx.LinkMode then data.LinkMode = emitCtx.LinkMode end
		if emitCtx.EmitParent then data.EmitParent = emitCtx.EmitParent end
	end
	if emitCtx and emitCtx.IgnoreLink then
		link = nil
	else
		link = link or data.Link
	end

	local Time = RangeMod.RandomValueFromRange(data.Lifetime)
	if Time <= 0 then Time = 0.001 end

	-- Source world pose composes the full chain (Attachment-in-Attachment-in-BasePart).
	-- WorldCFrame is the only correct read when parent is non-BasePart; .CFrame alone
	-- yields parent-local relative to a non-BasePart frame that breaks compose math.
	local sourceWorldCF = attachment.WorldCFrame
	local worldCF
	local originOverrideCF
	if emitCtx then
		if emitCtx.EventOriginResolver then originOverrideCF = emitCtx.EventOriginResolver() end
		if not originOverrideCF then originOverrideCF = emitCtx.EventOriginCF end
	end
	if originOverrideCF then
		if emitCtx and emitCtx.UseFullOrigin then
			worldCF = originOverrideCF -- AtCFrame: full source orientation
		else
			worldCF = CFrame.new(originOverrideCF.Position) * sourceWorldCF.Rotation
		end
	elseif link then
		local linkWorldCF = Constants.resolveLinkCFrame(link)
		if data.LinkMode == "Follow" then
			worldCF = CFrame.new(linkWorldCF.Position) * sourceWorldCF.Rotation
		else
			worldCF = CFrame.new(linkWorldCF.Position) * linkWorldCF.Rotation * sourceWorldCF.Rotation
		end
	else
		worldCF = sourceWorldCF
	end
	-- Walk up to find a BasePart anchor; nested-Attachment source compose through
	-- actualParent's CFrame. All downstream local-space math runs in actualParent-local.
	local actualParent = data.EmitParent or _findBasePartAncestor(attachment) or self:GetFolder()
	local actualParentCF = (actualParent and actualParent:IsA("BasePart")) and actualParent.CFrame or CFrame.new()
	local localCF = actualParentCF:ToObjectSpace(worldCF)
	local dirInfo = DirectionVectors[data.EmissionDirection] or DirectionVectors[Enum.NormalId.Top]

	-- Initial rotation (always applied)
	local dirMode = data.DirMode or "RigidLocal"
	local rotS = AxisLinksMod.sampleRangeAxes(data, data.AxisLinks, {"RotX","RotY","RotZ"}, RangeMod, emitCtx)
	local RX, RY, RZ = rotS.RotX, rotS.RotY, rotS.RotZ
	-- Initial RotX/Y/Z compose through RotOrder; see EmitPart for the rationale.
	local rotXYZ = Constants.composeRotation(data.RotOrder or "Global", RX, RY, RZ)
	local rotatedLocalCF = localCF * rotXYZ

	-- Base direction (3-way: Local / RigidLocal / Global). Sim frame is parent-local.
	local baseDirection
	if dirMode == "Local" then
		baseDirection = rotatedLocalCF[dirInfo.vector] * dirInfo.multiplier
	elseif dirMode == "Global" then
		-- World-space axis converted to actualParent-local (handles nested-Attachment via
		-- the BasePart anchor we walked up to). Folder-anchored fallback stays world-space.
		local worldAxis = CFrame.new()[dirInfo.vector] * dirInfo.multiplier
		if actualParent and actualParent:IsA("BasePart") then
			baseDirection = actualParent.CFrame:VectorToObjectSpace(worldAxis)
		else
			baseDirection = worldAxis
		end
	else -- RigidLocal: pre-RotXYZ pose in actualParent-local
		baseDirection = localCF[dirInfo.vector] * dirInfo.multiplier
	end

	localCF = rotatedLocalCF

	-- simFrameCF = actualParentCF so applyPositionOffset converts world offset into
	-- actualParent-local space (matches our sim frame after the BasePart walk-up).
	localCF = Constants.applyPositionOffset(localCF, data, link, attachment, RangeMod, AxisLinksMod, emitCtx, actualParentCF)

	-- Global: apply inv(actualParent.Rotation) so parent cancels at engine-multiply,
	-- leaving rotXYZ alone. Uses actualParent (BasePart anchor) so nested-Attachment
	-- sources don't fall to identity here.
	if dirMode == "Global" then
		if actualParent and actualParent:IsA("BasePart") then
			localCF = CFrame.new(localCF.Position) * actualParent.CFrame.Rotation:Inverse() * rotXYZ
		else
			localCF = CFrame.new(localCF.Position) * rotXYZ
		end
	end

	local randomX, randomY = 0, 0
	if data.ParticleData.SpreadAngle.X > 0 or data.ParticleData.SpreadAngle.Y > 0 then
		randomX = (math.random() * 2 - 1) * data.ParticleData.SpreadAngle.X
		randomY = (math.random() * 2 - 1) * data.ParticleData.SpreadAngle.Y
	end
	local spreadRotation = CFrame.Angles(math.rad(randomX), math.rad(randomY), 0)

	local cf = CFrame.lookAt(Vector3.new(), baseDirection)
	cf = cf * spreadRotation
	baseDirection = cf.LookVector

	local seeds = {
		Speed = GraphMod.GenerateSeed(data.Speed),
		RotSpeedX = GraphMod.GenerateSeed(data.RotSpeedX),
		RotSpeedY = GraphMod.GenerateSeed(data.RotSpeedY),
		RotSpeedZ = GraphMod.GenerateSeed(data.RotSpeedZ),
		PosOffsetX = GraphMod.GenerateSeed(data.PosOffsetX),
		PosOffsetY = GraphMod.GenerateSeed(data.PosOffsetY),
		PosOffsetZ = GraphMod.GenerateSeed(data.PosOffsetZ),
		Timescale = GraphMod.GenerateSeed(data.Timescale),
	}
	-- Aliases: RotSpeed only (no Size on Attachments).
	AxisLinksMod.applyGraphAxisAliases(data, seeds, data.AxisLinks)

	local invertMotion = data.InvertMotion
	local simLocalCFrames = nil
	local simEffectiveTKF = nil

	if invertMotion then
		simLocalCFrames, simEffectiveTKF = self:PreSimulateAttachmentForward(data, seeds, localCF, baseDirection, spreadRotation, Time, nil, localCF.Rotation * rotXYZ:Inverse())
	end

	local visualAttachment = Pool.acquireOrCopyBare(data.RenderTemplate, "Attachment", data.Pool)
	visualAttachment.Archivable = false

	if invertMotion and simLocalCFrames then
		local endLocalCF = simLocalCFrames[simEffectiveTKF or data.TotalKeyFrames] or simLocalCFrames[0]
		localCF = endLocalCF
	end

	-- actualParent + actualParentCF computed earlier (before sim) so PreSimulate
	-- and rotation/shape compose operate in the right frame.

	visualAttachment.CFrame = localCF
	visualAttachment.Parent = actualParent

	-- Restore nested-Trail Enabled snapshot after Parent so they track from spawn pose.
	-- Mirrors the Part path at line ~273.
	Pool.restoreTrails(visualAttachment, "Attachment")

	-- pData.LocalCF in parentCF_now-local space (link path) or actualParent-local (unlinked).
	local pDataLocalCF = localCF
	if link then
		local linkWorldCF = Constants.resolveLinkCFrame(link)
		local convCF = (actualParent and actualParent:IsA("BasePart")) and actualParent.CFrame or CFrame.new()
		local linkLocalCF = convCF:ToObjectSpace(linkWorldCF)
		local parentCF_now
		if data.LinkMode == "Follow" or data.LinkMode == "Pivot" then
			parentCF_now = CFrame.new(linkLocalCF.Position)
		else
			parentCF_now = linkLocalCF
		end
		pDataLocalCF = parentCF_now:ToObjectSpace(localCF)
	end

	local pData = {
		Type = "Attachment",
		VisualPart = visualAttachment,
		Link = link,
		LinkMode = data.LinkMode,
		Events = data.Events,

		StartTime = os.clock(),
		TotalKeyFrames = invertMotion and simEffectiveTKF or math.max(1, data.TotalKeyFrames),
		CurrentStep = 0,
		AccumulatedDT = 0,
		LifeTime = Time,
		PartLife = data.PartLife,
		LocalCF = pDataLocalCF,
		_localWorldCF = pDataLocalCF, -- seed for LinkTrack frame 0
		BaseDirection = baseDirection,
		_accelVel = Vector3.zero,
		SpeedMultiplier = 1,
		_spinRate = Vector3.zero,
		_spinAccumX = 0, _spinAccumY = 0, _spinAccumZ = 0,
		EmissionDirection = data.EmissionDirection,
		SpreadRotation = spreadRotation,
		Acceleration = data.ParticleData.Acceleration,
		Drag = data.ParticleData.Drag,
		VelocityVectored = data.VelocityVectored,

		InvertMotion = invertMotion,
		SimLocalCFrames = simLocalCFrames,

		RotMode = data.RotMode or "OverLife",
		RotOrder = data.RotOrder or "Global",
		AccRotX = 0, AccRotY = 0, AccRotZ = 0,

		Orientation = data.Orientation,
		ZOffset = data.ZOffset,

		-- PosOffsetX/Y/Z trajectory graph state (see Part emit above for semantics).
		SpawnRotation = pDataLocalCF.Rotation,
		SpawnEmitterRotation = pDataLocalCF.Rotation * rotXYZ:Inverse(),
		DisplacementMode = data.DisplacementMode,
		-- Attachment has no Size; 1.0 fallback for the sleep point-velocity check.
		_sleepRadius = 1.0,
		_prevWorldOff = Vector3.zero,
		HasPosOffsetGraphs = data.PosOffsetX ~= nil or data.PosOffsetY ~= nil or data.PosOffsetZ ~= nil,

		NeedsFullIteration = data.VelocityVectored,
		NeedsRotAccum = (data.RotMode == "Speed") and not data.VelocityVectored,
		HasDrag = data.ParticleData.Drag ~= 0,
		HasAccel = data.ParticleData.Acceleration.Magnitude > 0,

		Graphs = {
			Speed = data.Speed,
			RotSpeedX = data.RotSpeedX, RotSpeedY = data.RotSpeedY, RotSpeedZ = data.RotSpeedZ,
			PosOffsetX = data.PosOffsetX, PosOffsetY = data.PosOffsetY, PosOffsetZ = data.PosOffsetZ,
			Timescale = data.Timescale,
		},
		Seeds = seeds,
		_effectiveElapsed = GraphMod.InitialEffectiveElapsed(data.Timescale, seeds.Timescale, Time),
	}

	-- 1-frame pop prevention for PosOffset (see EmitPart for semantics).
	if pData.HasPosOffsetGraphs then
		local oX = pData.Graphs.PosOffsetX and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetX, pData.Seeds.PosOffsetX) or 0
		local oY = pData.Graphs.PosOffsetY and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetY, pData.Seeds.PosOffsetY) or 0
		local oZ = pData.Graphs.PosOffsetZ and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetZ, pData.Seeds.PosOffsetZ) or 0
		local worldOff = Constants.resolveDisplacement(Vector3.new(oX, oY, oZ),
			data.DisplacementMode or "Global", pData.SpawnRotation, pData.SpawnEmitterRotation)
		pData._prevWorldOff = worldOff
		if oX ~= 0 or oY ~= 0 or oZ ~= 0 then
			pData.LocalCF = pData.LocalCF + worldOff
			pData.VisualPart.CFrame = pData.VisualPart.CFrame + worldOff
		end
	end

	pData._sourceItem = attachment
	Particle._seedTsOverride(pData, attachment)
	if data.Pool ~= false then pData._sourceRT, pData._poolKind = data.RenderTemplate, "Attachment" end
	-- Static-graph short-circuit: constant-valued graphs nil out + stamp pData._static<Name>.
	StaticPass.apply(pData)
	self:_applyEmitVisualPasses(pData)
	self:_registerEmit(pData, emitCtx)

	for _, desc in visualAttachment:GetDescendants() do
		if desc:IsA("ParticleEmitter") then desc.Enabled = false end
	end
	local aliveAtt = self:_makeAliveCheck()
	for _, child in visualAttachment:GetChildren() do
		if child:IsA("Attachment") then ParticlesMod.EnableEmitChildrenAndRepeatForAttachments(child, aliveAtt) end
		ParticlesMod.EnableEmitSingle(child, aliveAtt)
	end

	-- Nested Part-Icles: source-walk; link = visualAttachment drives position.
	pData._nestedAlive = { true }
	NestedEmit.walk(self, data.RenderTemplate, visualAttachment, pData._nestedAlive, emitCtx)
end

-- Beams: no spatial motion (welded to Attachment0/1). Animation via per-prop graphs,
-- GraphBlender, and BeamFlipbooks. Static graphs read once at emit.
function Particle:EmitBeam(beam, link, emitCtx)
	if not beam or not beam.Parent then return end
	local data = self:GetData(beam)
	if not data or not data.RenderTemplate then return end

	-- PoolHide flipped Enabled=false on release; flip back here.
	local visualBeam = Pool.acquireOrClone(data.RenderTemplate, "Beam", data.Pool)
	visualBeam.Archivable = false
	visualBeam.Enabled = true
	if data.FaceCamera ~= nil then visualBeam.FaceCamera = data.FaceCamera end
	if data.ZOffset ~= nil then visualBeam.ZOffset = data.ZOffset end
	if data.TextureMode ~= nil then visualBeam.TextureMode = data.TextureMode end

	-- Rebind parent-scope Attachment0/1 refs via parent's clone map (nested-emit path).
	if emitCtx and emitCtx._parentCloneMap then
		local map = emitCtx._parentCloneMap
		if visualBeam.Attachment0 and map[visualBeam.Attachment0] then visualBeam.Attachment0 = map[visualBeam.Attachment0] end
		if visualBeam.Attachment1 and map[visualBeam.Attachment1] then visualBeam.Attachment1 = map[visualBeam.Attachment1] end
	end

	-- Static / animated beam property split.
	local animatedProps = {}
	for name, sequence in pairs(data.BeamProps) do
		if sequence then
			if GraphMod.IsStatic(sequence) then
				visualBeam[name] = GraphMod.GetStaticValue(sequence, visualBeam[name])
			else
				local seed = GraphMod.GenerateSeed(sequence)
				animatedProps[name] = { Sequence = sequence, Seed = seed }
				if name ~= "TextureSpeed" then
					local initVal = GraphMod.QueryPointsWithTime(0, sequence, seed)
					if name == "Segments" then initVal = math.max(20, math.round(initVal)) end
					visualBeam[name] = initVal
				end
			end
		end
	end

	-- Disable engine TextureSpeed accumulation; UpdateBeam computes offset.
	if animatedProps.TextureSpeed then
		visualBeam.TextureSpeed = 0
	end

	local transStates, colorStates = GraphMod.CollectGraphStates(data.GraphBlender)

	-- Cache merged keypoint times per adjacent pair.
	local transMergedTimes = {}
	for idx = 1, #transStates - 1 do
		transMergedTimes[idx] = GraphMod.PrecomputeMergedTimes(transStates[idx].Graph, transStates[idx + 1].Graph)
	end
	local colorMergedTimes = {}
	for idx = 1, #colorStates - 1 do
		colorMergedTimes[idx] = GraphMod.PrecomputeMergedColorTimes(colorStates[idx].Graph, colorStates[idx + 1].Graph)
	end

	-- Apply initial blender state (1-frame pop prevention).
	if #transStates > 0 then visualBeam.Transparency = transStates[1].Graph end
	if #colorStates > 0 then visualBeam.Color = colorStates[1].Graph end

	visualBeam.Parent = data.EmitParent or self:GetFolder()

	local safeLifeTime = RangeMod.RandomValueFromRange(data.Lifetime)
	if safeLifeTime <= 0 then safeLifeTime = 0.001 end
	local beamTimescaleSeed = GraphMod.GenerateSeed(data.BeamTimescale)

	local pData = {
		Type = "Beam",
		VisualPart = visualBeam,
		Link = link,
		Events = data.Events,
		StartTime = os.clock(),
		TotalKeyFrames = math.max(1, data.TotalKeyFrames),
		CurrentStep = 0,
		LifeTime = safeLifeTime,
		PartLife = data.PartLife or 0,

		AnimatedProps = animatedProps,

		TransStates = transStates,
		ColorStates = colorStates,
		TransMergedTimes = transMergedTimes,
		ColorMergedTimes = colorMergedTimes,

		Graphs = { Timescale = data.BeamTimescale },
		Seeds = { Timescale = beamTimescaleSeed },
		_effectiveElapsed = GraphMod.InitialEffectiveElapsed(data.BeamTimescale, beamTimescaleSeed, safeLifeTime),
	}

	-- Inherit parent model scale; cache bases for static props.
	if self._parentScaleMap and self._parentScaleMap[beam] then
		pData.ParentScale = self._parentScaleMap[beam]
		pData._baseWidth0 = visualBeam.Width0
		pData._baseWidth1 = visualBeam.Width1
		pData._baseCurveSize0 = visualBeam.CurveSize0
		pData._baseCurveSize1 = visualBeam.CurveSize1
		pData._baseTextureLength = visualBeam.TextureLength
		pData._baseSegments = visualBeam.Segments
	end

	pData._sourceItem = beam
	Particle._seedTsOverride(pData, beam)
	if data.Pool ~= false then pData._sourceRT, pData._poolKind = data.RenderTemplate, "Beam" end
	-- No _applyEmitVisualPasses for Beam (spatial-mesh only).
	self:_registerEmit(pData, emitCtx)

	if data.CachedBeamTextures and #data.CachedBeamTextures > 0 and data.FlipbookParticle then
		MeshFlipMod.FlipBeam(pData, data.FlipbookParticle, data.CachedBeamTextures, visualBeam, safeLifeTime)
	end
end

end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">EmitAnimate</string>
              <string name="Source"><![CDATA[--[[
	EmitAnimate Mixin  -  Animate-mode emit for Part / Attachment / Beam.
	Operates on RenderTemplate directly (no clone). On Lifetime expiry, init.luau's Heartbeat
	resets position + snapshots; with AnimateLoop=true it replays. AnimateItem stamps pData
	for the loop branch. Screen / ImageLabel animate lives in ScreenEmit / ImageEmit.
]]

local GraphMod = require(script.Parent.Graph)
local RangeMod = require(script.Parent.Range)
local ParticlesMod = require(script.Parent.Particles)
local Constants = require(script.Parent.PartConstants)
local AxisLinksMod = require(script.Parent.AxisLinks)
local EventsMod = require(script.Parent.Events)
local StaticPass = require(script.Parent.StaticPass)
local DirectionVectors = Constants.DirectionVectors
local shapeFunctions = Constants.shapeFunctions

return function(Particle)

-- Part Animate. Mirrors Emit.luau but visualPart = LIVE RenderTemplate.
function Particle:EmitPartAnimate(part, link, emitCtx)
	if not part or not part.Parent then return end
	local data = self:GetData(part)
	if not data or not data.RenderTemplate then return end
	link = link or data.Link

	local Time = RangeMod.RandomValueFromRange(data.Lifetime)
	if Time <= 0 then Time = 0.001 end

	local visualPart = data.RenderTemplate -- LIVE source RT, not a clone
	local initialAnchorCF = visualPart.CFrame

	local unrotatedCF
	if link then
		local lCF = Constants.resolveLinkCFrame(link)
		local lPos = lCF.Position
		if data.LinkMode == "Follow" then unrotatedCF = CFrame.new(lPos) * part.CFrame.Rotation
		else unrotatedCF = CFrame.new(lPos) * lCF.Rotation * part.CFrame.Rotation end
	else unrotatedCF = part.CFrame end
	local dirInfo = DirectionVectors[data.EmissionDirection] or DirectionVectors[Enum.NormalId.Top]
	local rawWorldDirection = unrotatedCF[dirInfo.vector] * dirInfo.multiplier

	-- Shape branch (see Emit.luau for full rationale). ShapePart override mirrors Emit.luau.
	local localOffset = Vector3.new()
	local shapeDir = nil
	local initialCF = unrotatedCF
	if data.UseShape then
		local shapeFunc = shapeFunctions[data.ParticleData.Shape]
		if shapeFunc then
			local shapeSrc = data.ShapePart or part
			local shapeCF = data.ShapePart and data.ShapePart.CFrame or unrotatedCF
			local sOffset, sRotation, sDirVec = shapeFunc(shapeSrc, data.ParticleData)
			localOffset = sOffset
			local sio = data.ParticleData.ShapeInOut
			if sio == Enum.ParticleEmitterShapeInOut.Inward then
				sDirVec = -sDirVec
			elseif sio == Enum.ParticleEmitterShapeInOut.InAndOut then
				if math.random() < 0.5 then sDirVec = -sDirVec end
			end
			shapeDir = (shapeCF - shapeCF.Position):VectorToWorldSpace(sDirVec)
			if data.ParticleData.LookAtInitially then
				local rx, ry, rz = initialCF:ToEulerAnglesXYZ()
				initialCF = CFrame.new((shapeCF * CFrame.new(localOffset)).Position)
					* sRotation * CFrame.Angles(rx, ry, rz)
			else
				initialCF = CFrame.new((shapeCF * CFrame.new(localOffset)).Position) * initialCF.Rotation
			end
		else
			initialCF = CFrame.new((initialCF * CFrame.new(localOffset)).Position) * initialCF.Rotation
		end
	else
		initialCF = CFrame.new((initialCF * CFrame.new(localOffset)).Position) * initialCF.Rotation
	end

	local dirMode = data.DirMode or "RigidLocal"
	local rotS = AxisLinksMod.sampleRangeAxes(data, data.AxisLinks, {"RotX","RotY","RotZ"}, RangeMod, emitCtx)
	local RX, RY, RZ = rotS.RotX, rotS.RotY, rotS.RotZ
	local rotXYZ = Constants.composeRotation(data.RotOrder or "Global", RX, RY, RZ)
	initialCF = initialCF * rotXYZ

	initialCF = Constants.applyPositionOffset(initialCF, data, link, part, RangeMod, AxisLinksMod, emitCtx)

	if dirMode == "Global" then
		initialCF = CFrame.new(initialCF.Position) * rotXYZ
	end

	local baseDirection
	if shapeDir then
		baseDirection = shapeDir
	elseif dirMode == "Local" then
		baseDirection = initialCF[dirInfo.vector] * dirInfo.multiplier
	elseif dirMode == "Global" then
		baseDirection = CFrame.new()[dirInfo.vector] * dirInfo.multiplier
	else
		baseDirection = rawWorldDirection
	end

	local randomX, randomY = 0, 0
	if data.ParticleData.SpreadAngle.X > 0 or data.ParticleData.SpreadAngle.Y > 0 then
		randomX = (math.random() * 2 - 1) * data.ParticleData.SpreadAngle.X
		randomY = (math.random() * 2 - 1) * data.ParticleData.SpreadAngle.Y
	end
	local spreadRotation = CFrame.Angles(math.rad(randomX), math.rad(randomY), 0)
	local cf = CFrame.lookAt(Vector3.new(), baseDirection)
	cf = cf * spreadRotation
	baseDirection = cf.LookVector

	local seeds = {
		SizeX = GraphMod.GenerateSeed(data.SizeX), SizeY = GraphMod.GenerateSeed(data.SizeY), SizeZ = GraphMod.GenerateSeed(data.SizeZ),
		RotSpeedX = GraphMod.GenerateSeed(data.RotSpeedX), RotSpeedY = GraphMod.GenerateSeed(data.RotSpeedY), RotSpeedZ = GraphMod.GenerateSeed(data.RotSpeedZ),
		PosOffsetX = GraphMod.GenerateSeed(data.PosOffsetX), PosOffsetY = GraphMod.GenerateSeed(data.PosOffsetY), PosOffsetZ = GraphMod.GenerateSeed(data.PosOffsetZ),
		Speed = GraphMod.GenerateSeed(data.Speed), Brightness = GraphMod.GenerateSeed(data.Brightness),
		Transparency = GraphMod.GenerateSeed(data.Transparency),
		AccelStrength = GraphMod.GenerateSeed(data.AccelStrength),
		Timescale = GraphMod.GenerateSeed(data.Timescale),
	}
	AxisLinksMod.applyGraphAxisAliases(data, seeds, data.AxisLinks)

	local invertMotion = data.InvertMotion
	local simLocalCFrames = nil
	local simEffectiveTKF = nil
	if invertMotion then
		simLocalCFrames, simEffectiveTKF = self:PreSimulateForward(data, seeds, initialCF, baseDirection, spreadRotation, link, Time, nil, initialCF.Rotation * rotXYZ:Inverse())
	end

	local parentCF_now
	if link then
		local lC = Constants.resolveLinkCFrame(link)
		parentCF_now = (data.LinkMode == "Follow" or data.LinkMode == "Pivot") and CFrame.new(lC.Position) or lC
	else parentCF_now = CFrame.new() end
	local localCF
	if invertMotion and simLocalCFrames then
		local endLocalCF = simLocalCFrames[simEffectiveTKF or data.TotalKeyFrames] or simLocalCFrames[0]
		localCF = endLocalCF
	else
		localCF = link and parentCF_now:ToObjectSpace(initialCF) or initialCF
	end
	visualPart.CFrame = parentCF_now * localCF

	local pData = {
		Type = "Part",
		VisualPart = visualPart,
		Link = link,
		LinkMode = data.LinkMode,
		Events = data.Events,
		SpecialMesh = visualPart:FindFirstChildOfClass('SpecialMesh'),
		Decal = visualPart:FindFirstChildOfClass('Decal'),
		-- SA has no per-instance Transparency/Color3; Color graph writes to SA.Color, MeshPart stays raw.
		SurfaceAppearance = visualPart:FindFirstChildOfClass('SurfaceAppearance'),
		-- Snapshot SA.Color + MeshPart.Color so finishAnimate restores authored tint.
		_initialSAColor = (function()
			local sa = visualPart:FindFirstChildOfClass('SurfaceAppearance')
			return sa and sa.Color or nil
		end)(),
		_initialPartColor = visualPart:IsA("BasePart") and visualPart.Color or nil,

		StartTime = os.clock(),
		TotalKeyFrames = invertMotion and simEffectiveTKF or math.max(1, data.TotalKeyFrames),
		CurrentStep = 0, AccumulatedDT = 0,
		LifeTime = Time, PartLife = data.PartLife or 0,
		CurrentPosition = visualPart.Position,
		LocalCF = localCF,

		BaseDirection = baseDirection,
		-- AnimateLoop replay restores from this so Bounce reflections don't leak into next cycle.
		_initialBaseDirection = baseDirection,
		EmissionDirection = data.EmissionDirection,
		SpreadRotation = spreadRotation,
		Acceleration = data.ParticleData.Acceleration,
		Drag = data.ParticleData.Drag,
		VelocityVectored = data.VelocityVectored,

		InvertMotion = invertMotion,
		SimLocalCFrames = simLocalCFrames,

		RotMode = data.RotMode or "OverLife",
		RotOrder = data.RotOrder or "Global",
		AccRotX = 0, AccRotY = 0, AccRotZ = 0,

		Orientation = data.Orientation,
		ZOffset = data.ZOffset,
		_localWorldCF = localCF,

		-- PosOffset trajectory state (see Emit.luau Part path for semantics).
		SpawnRotation = localCF.Rotation,
		SpawnEmitterRotation = localCF.Rotation * rotXYZ:Inverse(),
		DisplacementMode = data.DisplacementMode,
		_sleepRadius = (visualPart and visualPart:IsA("BasePart") and visualPart.Size.Magnitude * 0.5) or 1.0,
		_prevWorldOff = Vector3.zero,
		HasPosOffsetGraphs = data.PosOffsetX ~= nil or data.PosOffsetY ~= nil or data.PosOffsetZ ~= nil,

		NeedsFullIteration = data.VelocityVectored,
		NeedsRotAccum = (data.RotMode == "Speed") and not data.VelocityVectored,
		HasDrag = data.ParticleData.Drag ~= 0,
		HasAccel = data.ParticleData.Acceleration.Magnitude > 0,
		HasDecal = visualPart:FindFirstChildOfClass('Decal') ~= nil,
		-- InvertMotion + target-accel mutually exclusive (cached SimLocalCFrames can't track).
		HasTargetAccel = data.AccelerationTowardsInstance == true and data.AccelTarget ~= nil and data.AccelStrength ~= nil and not data.InvertMotion,
		AccelTarget = data.AccelTarget,
		TargetVel = Vector3.zero,

		Graphs = {
			SizeX = data.SizeX, SizeY = data.SizeY, SizeZ = data.SizeZ,
			RotSpeedX = data.RotSpeedX, RotSpeedY = data.RotSpeedY, RotSpeedZ = data.RotSpeedZ,
			PosOffsetX = data.PosOffsetX, PosOffsetY = data.PosOffsetY, PosOffsetZ = data.PosOffsetZ,
			Speed = data.Speed, Brightness = data.Brightness,
			Transparency = data.Transparency, Color = data.Color,
			AccelStrength = data.AccelStrength,
			Timescale = data.Timescale,
		},
		Seeds = seeds,
		_effectiveElapsed = GraphMod.InitialEffectiveElapsed(data.Timescale, seeds.Timescale, Time),

		IsAnimate = true, AnimateItem = part,
		InitialAnchorCF = initialAnchorCF, InitialLocalCF = localCF,
	}

	if pData.HasPosOffsetGraphs then
		local oX = pData.Graphs.PosOffsetX and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetX, pData.Seeds.PosOffsetX) or 0
		local oY = pData.Graphs.PosOffsetY and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetY, pData.Seeds.PosOffsetY) or 0
		local oZ = pData.Graphs.PosOffsetZ and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetZ, pData.Seeds.PosOffsetZ) or 0
		local worldOff = Constants.resolveDisplacement(Vector3.new(oX, oY, oZ),
			data.DisplacementMode or "Global", pData.SpawnRotation, pData.SpawnEmitterRotation)
		pData._prevWorldOff = worldOff
		if oX ~= 0 or oY ~= 0 or oZ ~= 0 then
			pData.LocalCF = pData.LocalCF + worldOff
			pData.VisualPart.CFrame = pData.VisualPart.CFrame + worldOff
		end
	end

	-- 1-frame pop prevention.
	local startSize = Vector3.new(
		GraphMod.QueryPointsWithTime(0, pData.Graphs.SizeX, pData.Seeds.SizeX),
		GraphMod.QueryPointsWithTime(0, pData.Graphs.SizeY, pData.Seeds.SizeY),
		GraphMod.QueryPointsWithTime(0, pData.Graphs.SizeZ, pData.Seeds.SizeZ)
	)
	local startTrans = GraphMod.QueryPointsWithTime(0, pData.Graphs.Transparency, pData.Seeds.Transparency)
	local startColor = GraphMod.QueryColorPointWithTime(0, pData.Graphs.Color)
	local startBright = GraphMod.QueryPointsWithTime(0, pData.Graphs.Brightness, pData.Seeds.Brightness)

	if pData.SpecialMesh then pData.SpecialMesh.Scale = startSize
	else pData.VisualPart.Size = startSize end

	if pData.SurfaceAppearance then
		-- Color graph tints SA.Color raw; Brightness graph drives SA.EmissiveTint only.
		pData.VisualPart.Transparency = startTrans
		pData.VisualPart.Color = Color3.fromRGB(startColor.R * 255, startColor.G * 255, startColor.B * 255)
		pData.SurfaceAppearance.Color = Color3.fromRGB(startColor.R * 255, startColor.G * 255, startColor.B * 255)
		pcall(function() pData.SurfaceAppearance.EmissiveTint = Color3.new(startColor.R * startBright, startColor.G * startBright, startColor.B * startBright) end)
	elseif pData.Decal then
		pData.Decal.Transparency = startTrans
		pData.Decal.Color3 = Color3.fromRGB(startColor.R * 255 * startBright, startColor.G * 255 * startBright, startColor.B * 255 * startBright)
	else
		-- Plain MeshPart: Brightness multiplies SA/Decal only, not the mesh Color.
		pData.VisualPart.Transparency = startTrans
		pData.VisualPart.Color = Color3.fromRGB(startColor.R * 255, startColor.G * 255, startColor.B * 255)
	end

	-- LIVE source RT; EnableEmitSingle drives each child's per-cycle lifecycle.
	local alivePartAn = self:_makeAliveCheck()
	for _, child in visualPart:GetChildren() do
		if child:IsA("Attachment") then ParticlesMod.EnableEmitChildrenAndRepeatForAttachments(child, alivePartAn) end
		ParticlesMod.EnableEmitSingle(child, alivePartAn)
	end

	if self._parentScaleMap and self._parentScaleMap[part] then
		pData.ParentScale = self._parentScaleMap[part]
	end

	pData._sourceItem = part
	Particle._seedTsOverride(pData, part)
	StaticPass.apply(pData)
	self.ActiveAnimates[part] = pData
	self:_applyEmitVisualPasses(pData)
	self:_registerEmit(pData, emitCtx)

	for _, desc in visualPart:GetDescendants() do
		if desc:GetAttribute("Transformed") then
			self:EnableEmit(desc, desc.Parent, EventsMod.descendCtx(emitCtx))
		end
	end
end

-- Attachment Animate. Parent-local sim mirrors EmitAttachment; visual is the RT child (not cloned).
function Particle:EmitAttachmentAnimate(attachment, link, emitCtx)
	if not attachment or not attachment.Parent then return end
	local data = self:GetData(attachment)
	if not data or not data.RenderTemplate then return end
	link = link or data.Link

	local Time = RangeMod.RandomValueFromRange(data.Lifetime)
	if Time <= 0 then Time = 0.001 end

	local visualAttachment = data.RenderTemplate -- NOT a clone
	local initialAnchorCF = visualAttachment.CFrame

	-- Visual IS the RT child of the source Attachment; sim runs in source-local space so
	-- the visual's world pose composes via source.WorldCFrame * localCF. Starting at
	-- identity keeps Transform.luau:96's invariant (RT.CFrame = identity) consistent
	-- regardless of how the source itself is parented (BasePart, Attachment, deeper).
	local localCF = CFrame.new()
	local dirInfo = DirectionVectors[data.EmissionDirection] or DirectionVectors[Enum.NormalId.Top]

	local dirMode = data.DirMode or "RigidLocal"
	local rotS = AxisLinksMod.sampleRangeAxes(data, data.AxisLinks, {"RotX","RotY","RotZ"}, RangeMod, emitCtx)
	local RX, RY, RZ = rotS.RotX, rotS.RotY, rotS.RotZ
	local rotXYZ = Constants.composeRotation(data.RotOrder or "Global", RX, RY, RZ)
	local rotatedLocalCF = localCF * rotXYZ

	local baseDirection
	if dirMode == "Local" then
		baseDirection = rotatedLocalCF[dirInfo.vector] * dirInfo.multiplier
	elseif dirMode == "Global" then
		-- Convert world axis to source-local frame via source.WorldCFrame so the math
		-- works whether source is parented to BasePart, Attachment, or nested deeper.
		local worldAxis = CFrame.new()[dirInfo.vector] * dirInfo.multiplier
		baseDirection = attachment.WorldCFrame:VectorToObjectSpace(worldAxis)
	else
		baseDirection = localCF[dirInfo.vector] * dirInfo.multiplier
	end

	localCF = rotatedLocalCF

	-- simFrameCF = source.WorldCFrame; sim runs in source-local frame (visual IS RT
	-- child of source). WorldCFrame composes arbitrary nest depth automatically.
	localCF = Constants.applyPositionOffset(localCF, data, link, attachment, RangeMod, AxisLinksMod, emitCtx, attachment.WorldCFrame)

	-- Global DirMode: world-align visual; cancel source.WorldRotation so the engine-
	-- composed (source.WorldCFrame * RT.CFrame) lands at rotXYZ in world space.
	if dirMode == "Global" then
		localCF = CFrame.new(localCF.Position) * attachment.WorldCFrame.Rotation:Inverse() * rotXYZ
	end

	local randomX, randomY = 0, 0
	if data.ParticleData.SpreadAngle.X > 0 or data.ParticleData.SpreadAngle.Y > 0 then
		randomX = (math.random() * 2 - 1) * data.ParticleData.SpreadAngle.X
		randomY = (math.random() * 2 - 1) * data.ParticleData.SpreadAngle.Y
	end
	local spreadRotation = CFrame.Angles(math.rad(randomX), math.rad(randomY), 0)
	local cf = CFrame.lookAt(Vector3.new(), baseDirection)
	cf = cf * spreadRotation
	baseDirection = cf.LookVector

	local seeds = {
		Speed = GraphMod.GenerateSeed(data.Speed),
		RotSpeedX = GraphMod.GenerateSeed(data.RotSpeedX),
		RotSpeedY = GraphMod.GenerateSeed(data.RotSpeedY),
		RotSpeedZ = GraphMod.GenerateSeed(data.RotSpeedZ),
		PosOffsetX = GraphMod.GenerateSeed(data.PosOffsetX),
		PosOffsetY = GraphMod.GenerateSeed(data.PosOffsetY),
		PosOffsetZ = GraphMod.GenerateSeed(data.PosOffsetZ),
		Timescale = GraphMod.GenerateSeed(data.Timescale),
	}
	AxisLinksMod.applyGraphAxisAliases(data, seeds, data.AxisLinks)

	local invertMotion = data.InvertMotion
	local simLocalCFrames = nil
	local simEffectiveTKF = nil
	if invertMotion then
		simLocalCFrames, simEffectiveTKF = self:PreSimulateAttachmentForward(data, seeds, localCF, baseDirection, spreadRotation, Time, nil, localCF.Rotation * rotXYZ:Inverse())
	end

	if invertMotion and simLocalCFrames then
		localCF = simLocalCFrames[simEffectiveTKF or data.TotalKeyFrames] or simLocalCFrames[0]
	end

	visualAttachment.CFrame = localCF

	local pData = {
		Type = "Attachment",
		VisualPart = visualAttachment,
		Link = link,
		LinkMode = data.LinkMode,
		Events = data.Events,
		StartTime = os.clock(),
		TotalKeyFrames = invertMotion and simEffectiveTKF or math.max(1, data.TotalKeyFrames),
		CurrentStep = 0, AccumulatedDT = 0,
		LifeTime = Time, PartLife = data.PartLife or 0,
		LocalCF = localCF,
		_localWorldCF = localCF,
		BaseDirection = baseDirection,
		_initialBaseDirection = baseDirection,
		EmissionDirection = data.EmissionDirection,
		SpreadRotation = spreadRotation,
		Acceleration = data.ParticleData.Acceleration,
		Drag = data.ParticleData.Drag,
		VelocityVectored = data.VelocityVectored,
		InvertMotion = invertMotion,
		SimLocalCFrames = simLocalCFrames,
		RotMode = data.RotMode or "OverLife",
		RotOrder = data.RotOrder or "Global",
		AccRotX = 0, AccRotY = 0, AccRotZ = 0,
		Orientation = data.Orientation,
		ZOffset = data.ZOffset,
		NeedsFullIteration = data.VelocityVectored,
		NeedsRotAccum = (data.RotMode == "Speed") and not data.VelocityVectored,
		HasDrag = data.ParticleData.Drag ~= 0,
		HasAccel = data.ParticleData.Acceleration.Magnitude > 0,
		-- PosOffset trajectory state (see Emit.luau Part path for semantics).
		SpawnRotation = localCF.Rotation,
		SpawnEmitterRotation = localCF.Rotation * rotXYZ:Inverse(),
		DisplacementMode = data.DisplacementMode,
		_sleepRadius = (visualPart and visualPart:IsA("BasePart") and visualPart.Size.Magnitude * 0.5) or 1.0,
		_prevWorldOff = Vector3.zero,
		HasPosOffsetGraphs = data.PosOffsetX ~= nil or data.PosOffsetY ~= nil or data.PosOffsetZ ~= nil,
		Graphs = {
			Speed = data.Speed,
			RotSpeedX = data.RotSpeedX, RotSpeedY = data.RotSpeedY, RotSpeedZ = data.RotSpeedZ,
			PosOffsetX = data.PosOffsetX, PosOffsetY = data.PosOffsetY, PosOffsetZ = data.PosOffsetZ,
			Timescale = data.Timescale,
		},
		Seeds = seeds,
		_effectiveElapsed = GraphMod.InitialEffectiveElapsed(data.Timescale, seeds.Timescale, Time),
		IsAnimate = true, AnimateItem = attachment,
		InitialAnchorCF = initialAnchorCF, InitialLocalCF = localCF,
	}

	if pData.HasPosOffsetGraphs then
		local oX = pData.Graphs.PosOffsetX and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetX, pData.Seeds.PosOffsetX) or 0
		local oY = pData.Graphs.PosOffsetY and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetY, pData.Seeds.PosOffsetY) or 0
		local oZ = pData.Graphs.PosOffsetZ and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetZ, pData.Seeds.PosOffsetZ) or 0
		local worldOff = Constants.resolveDisplacement(Vector3.new(oX, oY, oZ),
			data.DisplacementMode or "Global", pData.SpawnRotation, pData.SpawnEmitterRotation)
		pData._prevWorldOff = worldOff
		if oX ~= 0 or oY ~= 0 or oZ ~= 0 then
			pData.LocalCF = pData.LocalCF + worldOff
			pData.VisualPart.CFrame = pData.VisualPart.CFrame + worldOff
		end
	end

	pData._sourceItem = attachment
	Particle._seedTsOverride(pData, attachment)
	StaticPass.apply(pData)
	self.ActiveAnimates[attachment] = pData
	self:_applyEmitVisualPasses(pData)
	self:_registerEmit(pData, emitCtx)

	-- LIVE source RT; EnableEmitSingle drives each child's per-cycle lifecycle.
	local aliveAttAn = self:_makeAliveCheck()
	for _, child in visualAttachment:GetChildren() do
		if child:IsA("Attachment") then ParticlesMod.EnableEmitChildrenAndRepeatForAttachments(child, aliveAttAn) end
		ParticlesMod.EnableEmitSingle(child, aliveAttAn)
	end

	for _, desc in visualAttachment:GetDescendants() do
		if desc:GetAttribute("Transformed") then
			self:EnableEmit(desc, desc.Parent, EventsMod.descendCtx(emitCtx))
		end
	end
end

-- Beam Animate. Static/animated split mirrors EmitBeam; visual is the LIVE RT.
function Particle:EmitBeamAnimate(beam, link, emitCtx)
	if not beam or not beam.Parent then return end
	local data = self:GetData(beam)
	if not data or not data.RenderTemplate then return end

	local visualBeam = data.RenderTemplate -- LIVE source, not a clone
	-- Snapshot mutated properties so finishAnimate restores authored visual.
	local beamSnapshot = {
		Brightness = visualBeam.Brightness,
		CurveSize0 = visualBeam.CurveSize0,
		CurveSize1 = visualBeam.CurveSize1,
		Width0 = visualBeam.Width0,
		Width1 = visualBeam.Width1,
		LightEmission = visualBeam.LightEmission,
		LightInfluence = visualBeam.LightInfluence,
		Segments = visualBeam.Segments,
		TextureLength = visualBeam.TextureLength,
		TextureSpeed = visualBeam.TextureSpeed,
		Transparency = visualBeam.Transparency,
		Color = visualBeam.Color,
		FaceCamera = visualBeam.FaceCamera,
		Enabled = visualBeam.Enabled,
	}
	if data.FaceCamera ~= nil then visualBeam.FaceCamera = data.FaceCamera end

	-- Static / animated beam property split.
	local animatedProps = {}
	for name, sequence in pairs(data.BeamProps) do
		if sequence then
			if GraphMod.IsStatic(sequence) then
				visualBeam[name] = GraphMod.GetStaticValue(sequence, visualBeam[name])
			else
				local seed = GraphMod.GenerateSeed(sequence)
				animatedProps[name] = { Sequence = sequence, Seed = seed }
				if name ~= "TextureSpeed" then
					local initVal = GraphMod.QueryPointsWithTime(0, sequence, seed)
					if name == "Segments" then initVal = math.max(20, math.round(initVal)) end
					visualBeam[name] = initVal
				end
			end
		end
	end

	-- Disable engine TextureSpeed accumulation; UpdateBeam computes offset.
	if animatedProps.TextureSpeed then
		visualBeam.TextureSpeed = 0
	end

	local transStates, colorStates = GraphMod.CollectGraphStates(data.GraphBlender)

	local transMergedTimes = {}
	for idx = 1, #transStates - 1 do
		transMergedTimes[idx] = GraphMod.PrecomputeMergedTimes(transStates[idx].Graph, transStates[idx + 1].Graph)
	end
	local colorMergedTimes = {}
	for idx = 1, #colorStates - 1 do
		colorMergedTimes[idx] = GraphMod.PrecomputeMergedColorTimes(colorStates[idx].Graph, colorStates[idx + 1].Graph)
	end

	-- Apply initial blender state (1-frame pop prevention).
	if #transStates > 0 then visualBeam.Transparency = transStates[1].Graph end
	if #colorStates > 0 then visualBeam.Color = colorStates[1].Graph end

	visualBeam.Enabled = true

	local safeLifeTime = RangeMod.RandomValueFromRange(data.Lifetime)
	if safeLifeTime <= 0 then safeLifeTime = 0.001 end
	local beamTimescaleSeed = GraphMod.GenerateSeed(data.BeamTimescale)

	local pData = {
		Type = "Beam",
		VisualPart = visualBeam,
		Link = link,
		Events = data.Events,
		StartTime = os.clock(),
		TotalKeyFrames = math.max(1, data.TotalKeyFrames),
		CurrentStep = 0,
		LifeTime = safeLifeTime,
		PartLife = data.PartLife or 0,
		AnimatedProps = animatedProps,
		TransStates = transStates, ColorStates = colorStates,
		TransMergedTimes = transMergedTimes, ColorMergedTimes = colorMergedTimes,
		BeamSnapshot = beamSnapshot,
		Graphs = { Timescale = data.BeamTimescale },
		Seeds = { Timescale = beamTimescaleSeed },
		_effectiveElapsed = GraphMod.InitialEffectiveElapsed(data.BeamTimescale, beamTimescaleSeed, safeLifeTime),
		IsAnimate = true, AnimateItem = beam,
	}

	-- Inherit parent model scale for live width scaling.
	if self._parentScaleMap and self._parentScaleMap[beam] then
		pData.ParentScale = self._parentScaleMap[beam]
		pData._baseWidth0 = visualBeam.Width0
		pData._baseWidth1 = visualBeam.Width1
		pData._baseCurveSize0 = visualBeam.CurveSize0
		pData._baseCurveSize1 = visualBeam.CurveSize1
		pData._baseTextureLength = visualBeam.TextureLength
		pData._baseSegments = visualBeam.Segments
	end

	pData._sourceItem = beam
	Particle._seedTsOverride(pData, beam)
	self.ActiveAnimates[beam] = pData
	self:_registerEmit(pData, emitCtx)
end

-- AnimateLoop refresh of non-spatial fields. Spatial state stays (full rebuild is per-type).
function Particle:_refreshAnimateNonSpatial(pData, freshData)
	if not freshData then return end
	if freshData.EmissionDirection then pData.EmissionDirection = freshData.EmissionDirection end
	if freshData.Orientation then pData.Orientation = freshData.Orientation end
	if freshData.ZOffset ~= nil then pData.ZOffset = freshData.ZOffset end
	if freshData.RotOrder then pData.RotOrder = freshData.RotOrder end
	if freshData.PartLife ~= nil then pData.PartLife = freshData.PartLife end
	-- Timescale attrName variants per type; exactly one is set.
	local tsG = freshData.Timescale or freshData.BeamTimescale or freshData.AtmTimescale or freshData.PLTimescale
	if tsG and pData.Graphs then pData.Graphs.Timescale = tsG; pData.Seeds.Timescale = GraphMod.GenerateSeed(tsG) end
	if freshData.ParticleData and freshData.ParticleData.SpreadAngle then
		local sa = freshData.ParticleData.SpreadAngle
		local rx, ry = 0, 0
		if sa.X > 0 or sa.Y > 0 then
			rx = (math.random() * 2 - 1) * sa.X
			ry = (math.random() * 2 - 1) * sa.Y
		end
		pData.SpreadRotation = CFrame.Angles(math.rad(rx), math.rad(ry), 0)
	end
end

end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">EmitModel</string>
              <string name="Source"><![CDATA[--[[
	EmitModel Mixin  -  Emit + Animate for Model emitters.
	Whole-model clone, :PivotTo for position, :ScaleTo for size (cascades to children).
]]

local GraphMod = require(script.Parent.Graph)
local RangeMod = require(script.Parent.Range)
local AxisLinksMod = require(script.Parent.AxisLinks)
local ParticlesMod = require(script.Parent.Particles)
local TypeRegistry = require(script.Parent.TypeRegistry)
local EventsMod = require(script.Parent.Events)
local Constants = require(script.Parent.PartConstants)
local Pool = require(script.Parent.Pool)
local NestedEmit = require(script.Parent.NestedEmit)
local StaticPass = require(script.Parent.StaticPass)
local DirectionVectors = Constants.DirectionVectors

return function(Particle)

-- One-shot Model emit. Pivot = model:GetPivot; mirrors EmitPart minus shape geometry.
function Particle:EmitModel(model, link, emitCtx)
	if not model or not model.Parent then return end
	local data = self:GetData(model)
	if not data or not data.RenderTemplate then return end
	if emitCtx then
		if emitCtx.LinkMode then data.LinkMode = emitCtx.LinkMode end
		if emitCtx.EmitParent then data.EmitParent = emitCtx.EmitParent end
	end
	if emitCtx and emitCtx.IgnoreLink then
		link = nil
	else
		link = link or data.Link
	end

	local Time = RangeMod.RandomValueFromRange(data.Lifetime)
	if Time <= 0 then Time = 0.001 end

	-- Event-origin override replaces pivot position; preserves authored rotation.
	local pivotCF = model:GetPivot()
	local originOverrideCF
	if emitCtx then
		if emitCtx.EventOriginResolver then originOverrideCF = emitCtx.EventOriginResolver() end
		if not originOverrideCF then originOverrideCF = emitCtx.EventOriginCF end
	end
	local unrotatedCF
	if originOverrideCF then
		if emitCtx and emitCtx.UseFullOrigin then
			unrotatedCF = originOverrideCF -- AtCFrame: full source CFrame
		else
			unrotatedCF = CFrame.new(originOverrideCF.Position) * pivotCF.Rotation
		end
	else
		unrotatedCF = pivotCF
	end
	local dirInfo = DirectionVectors[data.EmissionDirection] or DirectionVectors[Enum.NormalId.Top]
	local rawWorldDirection = unrotatedCF[dirInfo.vector] * dirInfo.multiplier

	local initialCF = unrotatedCF

	local dirMode = data.DirMode or "RigidLocal"
	local rotS = AxisLinksMod.sampleRangeAxes(data, data.AxisLinks, {"RotX","RotY","RotZ"}, RangeMod, emitCtx)
	local RX, RY, RZ = rotS.RotX, rotS.RotY, rotS.RotZ
	local rotXYZ = Constants.composeRotation(data.RotOrder or "Global", RX, RY, RZ)
	initialCF = initialCF * rotXYZ

	initialCF = Constants.applyPositionOffset(initialCF, data, link, model, RangeMod, AxisLinksMod, emitCtx)

	if dirMode == "Global" then
		initialCF = CFrame.new(initialCF.Position) * rotXYZ
	end

	local baseDirection
	if dirMode == "Local" then
		baseDirection = initialCF[dirInfo.vector] * dirInfo.multiplier
	elseif dirMode == "Global" then
		baseDirection = CFrame.new()[dirInfo.vector] * dirInfo.multiplier
	else
		baseDirection = rawWorldDirection
	end

	local randomX, randomY = 0, 0
	if data.ParticleData.SpreadAngle.X > 0 or data.ParticleData.SpreadAngle.Y > 0 then
		randomX = (math.random() * 2 - 1) * data.ParticleData.SpreadAngle.X
		randomY = (math.random() * 2 - 1) * data.ParticleData.SpreadAngle.Y
	end
	local spreadRotation = CFrame.Angles(math.rad(randomX), math.rad(randomY), 0)

	local cf = CFrame.lookAt(Vector3.new(), baseDirection)
	cf = cf * spreadRotation
	baseDirection = cf.LookVector

	local seeds = {
		RotSpeedX = GraphMod.GenerateSeed(data.RotSpeedX),
		RotSpeedY = GraphMod.GenerateSeed(data.RotSpeedY),
		RotSpeedZ = GraphMod.GenerateSeed(data.RotSpeedZ),
		PosOffsetX = GraphMod.GenerateSeed(data.PosOffsetX),
		PosOffsetY = GraphMod.GenerateSeed(data.PosOffsetY),
		PosOffsetZ = GraphMod.GenerateSeed(data.PosOffsetZ),
		Speed = GraphMod.GenerateSeed(data.Speed),
		Scale = GraphMod.GenerateSeed(data.Scale),
		Timescale = GraphMod.GenerateSeed(data.Timescale),
	}
	AxisLinksMod.applyGraphAxisAliases(data, seeds, data.AxisLinks)

	local invertMotion = data.InvertMotion
	local simLocalCFrames = nil
	local simEffectiveTKF = nil

	if invertMotion then
		simLocalCFrames, simEffectiveTKF = self:PreSimulateForward(data, seeds, initialCF, baseDirection, spreadRotation, link, Time, nil, initialCF.Rotation * rotXYZ:Inverse())
	end

	local visualModel = Pool.acquireOrCopyBare(data.RenderTemplate, "Model", data.Pool)
	visualModel.Archivable = false
	-- Pool reuse can carry over the prior cycle's final ScaleTo value. Snapshot the
	-- authored RT scale once + restore before the graph-driven ScaleTo writes its t=0
	-- value below so the visible state never reflects a stale scale, even for one frame.
	do
		local rt = data.RenderTemplate
		if rt and visualModel:GetAttribute("_pooledModelScale") == nil then
			local ok, s = pcall(function() return rt:GetScale() end)
			if ok and s then visualModel:SetAttribute("_pooledModelScale", s) end
		end
		local priorScale = visualModel:GetAttribute("_pooledModelScale")
		if priorScale then pcall(function() visualModel:ScaleTo(priorScale) end) end
	end
	local parentCF_now
	if link then
		local lC = Constants.resolveLinkCFrame(link)
		parentCF_now = (data.LinkMode == "Follow" or data.LinkMode == "Pivot") and CFrame.new(lC.Position) or lC
	else parentCF_now = CFrame.new() end
	local localCF

	if invertMotion and simLocalCFrames then
		local endLocalCF = simLocalCFrames[simEffectiveTKF or data.TotalKeyFrames] or simLocalCFrames[0]
		localCF = endLocalCF
		visualModel:PivotTo(parentCF_now * localCF)
	else
		localCF = link and parentCF_now:ToObjectSpace(initialCF) or initialCF
		visualModel:PivotTo(parentCF_now * localCF)
	end

	local pData = {
		Type = "Model",
		VisualPart = visualModel,
		Link = link,
		LinkMode = data.LinkMode,
		Events = data.Events,

		StartTime = os.clock(),
		TotalKeyFrames = invertMotion and simEffectiveTKF or math.max(1, data.TotalKeyFrames),
		CurrentStep = 0,
		AccumulatedDT = 0,
		LifeTime = Time,
		PartLife = data.PartLife,
		CurrentPosition = visualModel:GetPivot().Position,
		LocalCF = localCF,

		BaseDirection = baseDirection,
		_accelVel = Vector3.zero,
		SpeedMultiplier = 1,
		_spinRate = Vector3.zero,
		_spinAccumX = 0, _spinAccumY = 0, _spinAccumZ = 0,
		EmissionDirection = data.EmissionDirection,
		SpreadRotation = spreadRotation,
		Acceleration = data.ParticleData.Acceleration,
		Drag = data.ParticleData.Drag,
		VelocityVectored = data.VelocityVectored,

		InvertMotion = invertMotion,
		SimLocalCFrames = simLocalCFrames,

		RotMode = data.RotMode or "OverLife",
		RotOrder = data.RotOrder or "Global",
		AccRotX = 0, AccRotY = 0, AccRotZ = 0,

		Orientation = data.Orientation,
		ZOffset = data.ZOffset,
		_localWorldCF = localCF,

		-- PosOffsetX/Y/Z trajectory graph state (see Emit.luau Part path for semantics).
		SpawnRotation = localCF.Rotation,
		SpawnEmitterRotation = localCF.Rotation * rotXYZ:Inverse(),
		DisplacementMode = data.DisplacementMode,
		-- Model has no .Size; 1.0 fallback for sleep point-velocity check.
		_sleepRadius = 1.0,
		_prevWorldOff = Vector3.zero,
		HasPosOffsetGraphs = data.PosOffsetX ~= nil or data.PosOffsetY ~= nil or data.PosOffsetZ ~= nil,

		NeedsFullIteration = data.VelocityVectored,
		NeedsRotAccum = (data.RotMode == "Speed") and not data.VelocityVectored,
		HasDrag = data.ParticleData.Drag ~= 0,
		HasAccel = data.ParticleData.Acceleration.Magnitude > 0,

		Graphs = {
			RotSpeedX = data.RotSpeedX, RotSpeedY = data.RotSpeedY, RotSpeedZ = data.RotSpeedZ,
			PosOffsetX = data.PosOffsetX, PosOffsetY = data.PosOffsetY, PosOffsetZ = data.PosOffsetZ,
			Speed = data.Speed, Scale = data.Scale,
			Timescale = data.Timescale,
		},
		Seeds = seeds,
		_effectiveElapsed = GraphMod.InitialEffectiveElapsed(data.Timescale, seeds.Timescale, Time),
	}

	if pData.HasPosOffsetGraphs then
		local oX = pData.Graphs.PosOffsetX and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetX, pData.Seeds.PosOffsetX) or 0
		local oY = pData.Graphs.PosOffsetY and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetY, pData.Seeds.PosOffsetY) or 0
		local oZ = pData.Graphs.PosOffsetZ and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetZ, pData.Seeds.PosOffsetZ) or 0
		local worldOff = Constants.resolveDisplacement(Vector3.new(oX, oY, oZ),
			data.DisplacementMode or "Global", pData.SpawnRotation, pData.SpawnEmitterRotation)
		pData._prevWorldOff = worldOff
		if oX ~= 0 or oY ~= 0 or oZ ~= 0 then
			pData.LocalCF = pData.LocalCF + worldOff
			pData.VisualPart:PivotTo(pData.VisualPart:GetPivot() + worldOff)
		end
	end

	-- Cache descendant Beams for Segments clamp after ScaleTo.
	local vBeams = {}
	for _, desc in visualModel:GetDescendants() do
		if desc:IsA("Beam") and not desc:GetAttribute("Transformed") then table.insert(vBeams, desc) end
	end
	if #vBeams > 0 then pData._visualBeams = vBeams end

	-- 1-frame pop prevention.
	local startScale = math.max(0.001, GraphMod.QueryPointsWithTime(0, pData.Graphs.Scale, pData.Seeds.Scale))
	visualModel:ScaleTo(startScale)
	for _, beam in ipairs(vBeams) do if beam.Segments < 20 then beam.Segments = 20 end end

	visualModel.Parent = data.EmitParent or self:GetFolder()

	-- Restore pooled Trails AFTER PivotTo + Parent so trails track from spawn, not pool pose.
	Pool.restoreTrails(visualModel, "Model")

	for _, desc in visualModel:GetDescendants() do
		if desc:IsA("ParticleEmitter") then desc.Enabled = false end
	end
	local alive = self:_makeAliveCheck()
	for _, desc in visualModel:GetDescendants() do
		ParticlesMod.EnableEmitSingle(desc, alive)
	end

	pData._sourceItem = model
	Particle._seedTsOverride(pData, model)
	if data.Pool ~= false then pData._sourceRT, pData._poolKind = data.RenderTemplate, "Model" end
	StaticPass.apply(pData)
	self:_applyEmitVisualPasses(pData)
	self:_registerEmit(pData, emitCtx)

	-- Nested Part-Icles: source-walk with per-node origin override. See NestedEmit.luau.
	-- _parentScaleMap is keyed by SOURCE node (not cloned desc) so live-beam scale
	-- lookups still resolve when nested emit runs against the original instance.
	pData._nestedAlive = { true }
	self._parentScaleMap = self._parentScaleMap or {}
	local parentScaleInfo = {
		Graph = pData.Graphs.Scale, Seed = pData.Seeds.Scale,
		TotalKeyFrames = pData.TotalKeyFrames, StartTime = pData.StartTime, LifeTime = pData.LifeTime,
		-- nil/true → scale Beam.TextureLength with model scale (preserves tile count).
		-- false → leave authored TextureLength alone (tiles repeat more as beam grows).
		ScaleTextureLength = data.ScaleTextureLength ~= false,
	}
	local scaleKeys = {}
	NestedEmit.walk(self, data.RenderTemplate, visualModel, pData._nestedAlive, emitCtx, function(node)
		self._parentScaleMap[node] = parentScaleInfo
		scaleKeys[#scaleKeys+1] = node
	end)
	pData._scaleMapKeys = scaleKeys
end

-- Model Animate. LIVE source RT (no clone). AnimateLoop re-runs with fresh data.
function Particle:EmitModelAnimate(model, link, emitCtx)
	if not model or not model.Parent then return end
	local data = self:GetData(model)
	if not data or not data.RenderTemplate then return end
	link = link or data.Link

	local Time = RangeMod.RandomValueFromRange(data.Lifetime)
	if Time <= 0 then Time = 0.001 end

	local visualModel = data.RenderTemplate -- LIVE source, not a clone
	local initialAnchorCF = visualModel:GetPivot()

	local unrotatedCF = model:GetPivot()
	local dirInfo = DirectionVectors[data.EmissionDirection] or DirectionVectors[Enum.NormalId.Top]
	local rawWorldDirection = unrotatedCF[dirInfo.vector] * dirInfo.multiplier

	local initialCF = unrotatedCF

	local dirMode = data.DirMode or "RigidLocal"
	local rotS = AxisLinksMod.sampleRangeAxes(data, data.AxisLinks, {"RotX","RotY","RotZ"}, RangeMod, emitCtx)
	local RX, RY, RZ = rotS.RotX, rotS.RotY, rotS.RotZ
	local rotXYZ = Constants.composeRotation(data.RotOrder or "Global", RX, RY, RZ)
	initialCF = initialCF * rotXYZ

	initialCF = Constants.applyPositionOffset(initialCF, data, link, model, RangeMod, AxisLinksMod, emitCtx)

	if dirMode == "Global" then
		initialCF = CFrame.new(initialCF.Position) * rotXYZ
	end

	local baseDirection
	if dirMode == "Local" then
		baseDirection = initialCF[dirInfo.vector] * dirInfo.multiplier
	elseif dirMode == "Global" then
		baseDirection = CFrame.new()[dirInfo.vector] * dirInfo.multiplier
	else
		baseDirection = rawWorldDirection
	end

	local randomX, randomY = 0, 0
	if data.ParticleData.SpreadAngle.X > 0 or data.ParticleData.SpreadAngle.Y > 0 then
		randomX = (math.random() * 2 - 1) * data.ParticleData.SpreadAngle.X
		randomY = (math.random() * 2 - 1) * data.ParticleData.SpreadAngle.Y
	end
	local spreadRotation = CFrame.Angles(math.rad(randomX), math.rad(randomY), 0)
	local cf = CFrame.lookAt(Vector3.new(), baseDirection)
	cf = cf * spreadRotation
	baseDirection = cf.LookVector

	local seeds = {
		RotSpeedX = GraphMod.GenerateSeed(data.RotSpeedX),
		RotSpeedY = GraphMod.GenerateSeed(data.RotSpeedY),
		RotSpeedZ = GraphMod.GenerateSeed(data.RotSpeedZ),
		PosOffsetX = GraphMod.GenerateSeed(data.PosOffsetX),
		PosOffsetY = GraphMod.GenerateSeed(data.PosOffsetY),
		PosOffsetZ = GraphMod.GenerateSeed(data.PosOffsetZ),
		Speed = GraphMod.GenerateSeed(data.Speed),
		Scale = GraphMod.GenerateSeed(data.Scale),
		Timescale = GraphMod.GenerateSeed(data.Timescale),
	}
	AxisLinksMod.applyGraphAxisAliases(data, seeds, data.AxisLinks)

	local invertMotion = data.InvertMotion
	local simLocalCFrames = nil
	local simEffectiveTKF = nil
	if invertMotion then
		simLocalCFrames, simEffectiveTKF = self:PreSimulateForward(data, seeds, initialCF, baseDirection, spreadRotation, link, Time, nil, initialCF.Rotation * rotXYZ:Inverse())
	end

	local parentCF_now
	if link then
		local lC = Constants.resolveLinkCFrame(link)
		parentCF_now = (data.LinkMode == "Follow" or data.LinkMode == "Pivot") and CFrame.new(lC.Position) or lC
	else parentCF_now = CFrame.new() end
	local localCF
	if invertMotion and simLocalCFrames then
		local endLocalCF = simLocalCFrames[simEffectiveTKF or data.TotalKeyFrames] or simLocalCFrames[0]
		localCF = endLocalCF
	else
		localCF = link and parentCF_now:ToObjectSpace(initialCF) or initialCF
	end
	visualModel:PivotTo(parentCF_now * localCF)

	local pData = {
		Type = "Model",
		VisualPart = visualModel,
		Link = link,
		LinkMode = data.LinkMode,
		Events = data.Events,

		StartTime = os.clock(),
		TotalKeyFrames = invertMotion and simEffectiveTKF or math.max(1, data.TotalKeyFrames),
		CurrentStep = 0, AccumulatedDT = 0,
		LifeTime = Time, PartLife = data.PartLife or 0,
		CurrentPosition = visualModel:GetPivot().Position,
		LocalCF = localCF,

		BaseDirection = baseDirection,
		_accelVel = Vector3.zero,
		SpeedMultiplier = 1,
		_spinRate = Vector3.zero,
		_spinAccumX = 0, _spinAccumY = 0, _spinAccumZ = 0,
		EmissionDirection = data.EmissionDirection,
		SpreadRotation = spreadRotation,
		Acceleration = data.ParticleData.Acceleration,
		Drag = data.ParticleData.Drag,
		VelocityVectored = data.VelocityVectored,

		InvertMotion = invertMotion,
		SimLocalCFrames = simLocalCFrames,

		RotMode = data.RotMode or "OverLife",
		RotOrder = data.RotOrder or "Global",
		AccRotX = 0, AccRotY = 0, AccRotZ = 0,

		Orientation = data.Orientation,
		ZOffset = data.ZOffset,
		_localWorldCF = localCF,

		-- PosOffsetX/Y/Z trajectory graph state (see Emit.luau Part path for semantics).
		SpawnRotation = localCF.Rotation,
		SpawnEmitterRotation = localCF.Rotation * rotXYZ:Inverse(),
		DisplacementMode = data.DisplacementMode,
		-- Model has no .Size; 1.0 fallback for sleep point-velocity check.
		_sleepRadius = 1.0,
		_prevWorldOff = Vector3.zero,
		HasPosOffsetGraphs = data.PosOffsetX ~= nil or data.PosOffsetY ~= nil or data.PosOffsetZ ~= nil,

		NeedsFullIteration = data.VelocityVectored,
		NeedsRotAccum = (data.RotMode == "Speed") and not data.VelocityVectored,
		HasDrag = data.ParticleData.Drag ~= 0,
		HasAccel = data.ParticleData.Acceleration.Magnitude > 0,

		Graphs = {
			RotSpeedX = data.RotSpeedX, RotSpeedY = data.RotSpeedY, RotSpeedZ = data.RotSpeedZ,
			PosOffsetX = data.PosOffsetX, PosOffsetY = data.PosOffsetY, PosOffsetZ = data.PosOffsetZ,
			Speed = data.Speed, Scale = data.Scale,
			Timescale = data.Timescale,
		},
		Seeds = seeds,
		_effectiveElapsed = GraphMod.InitialEffectiveElapsed(data.Timescale, seeds.Timescale, Time),

		IsAnimate = true, AnimateItem = model,
		InitialAnchorCF = initialAnchorCF, InitialLocalCF = localCF,
		-- Snapshot scale so finishAnimate / cancelAnimation restore authored value.
		InitialScale = (function() local ok, s = pcall(function() return model:GetScale() end); return ok and s or 1 end)(),
	}

	if pData.HasPosOffsetGraphs then
		local oX = pData.Graphs.PosOffsetX and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetX, pData.Seeds.PosOffsetX) or 0
		local oY = pData.Graphs.PosOffsetY and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetY, pData.Seeds.PosOffsetY) or 0
		local oZ = pData.Graphs.PosOffsetZ and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetZ, pData.Seeds.PosOffsetZ) or 0
		local worldOff = Constants.resolveDisplacement(Vector3.new(oX, oY, oZ),
			data.DisplacementMode or "Global", pData.SpawnRotation, pData.SpawnEmitterRotation)
		pData._prevWorldOff = worldOff
		if oX ~= 0 or oY ~= 0 or oZ ~= 0 then
			pData.LocalCF = pData.LocalCF + worldOff
			pData.VisualPart:PivotTo(pData.VisualPart:GetPivot() + worldOff)
		end
	end

	local vBeams = {}
	for _, desc in visualModel:GetDescendants() do
		if desc:IsA("Beam") and not desc:GetAttribute("Transformed") then table.insert(vBeams, desc) end
	end
	if #vBeams > 0 then pData._visualBeams = vBeams end

	local startScale = math.max(0.001, GraphMod.QueryPointsWithTime(0, pData.Graphs.Scale, pData.Seeds.Scale))
	visualModel:ScaleTo(startScale)
	for _, beam in ipairs(vBeams) do if beam.Segments < 20 then beam.Segments = 20 end end

	-- LIVE source, no pre-disable; EnableEmitSingle handles each descendant.
	local aliveAnim = self:_makeAliveCheck()
	for _, desc in visualModel:GetDescendants() do
		ParticlesMod.EnableEmitSingle(desc, aliveAnim)
	end

	pData._sourceItem = model
	Particle._seedTsOverride(pData, model)
	StaticPass.apply(pData)
	self.ActiveAnimates[model] = pData
	self:_applyEmitVisualPasses(pData)
	self:_registerEmit(pData, emitCtx)

	-- Nested Part-Icles: fire each transformed descendant; record parent scale info.
	self._parentScaleMap = self._parentScaleMap or {}
	local parentScaleInfo = {
		Graph = pData.Graphs.Scale, Seed = pData.Seeds.Scale,
		TotalKeyFrames = pData.TotalKeyFrames, StartTime = pData.StartTime, LifeTime = pData.LifeTime,
		-- nil/true → scale Beam.TextureLength with model scale (preserves tile count).
		-- false → leave authored TextureLength alone (tiles repeat more as beam grows).
		ScaleTextureLength = data.ScaleTextureLength ~= false,
	}
	local scaleKeys = {}
	for _, desc in visualModel:GetDescendants() do
		if desc:GetAttribute("Transformed") then
			self._parentScaleMap[desc] = parentScaleInfo
			scaleKeys[#scaleKeys+1] = desc
			self:EnableEmit(desc, desc.Parent, EventsMod.descendCtx(emitCtx))
		end
	end
	pData._scaleMapKeys = scaleKeys
end

end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">Engine</string>
              <string name="Source"><![CDATA[--[[
	Engine mixin  -  Heartbeat loop + Activate / Deactivate / GetFolder / GetPoolFolder.

	Activate connects the per-frame Heartbeat that walks ActiveEmits → UpdateX,
	handles death, replays AnimateLoop cycles, and runs the OnHit raycast pass.
	Deactivate is the symmetric teardown.
]]

local RunService = game:GetService('RunService')
local UIS = game:GetService('UserInputService')

local GraphMod = require(script.Parent.Graph)
local RangeMod = require(script.Parent.Range)
local ParticlesMod = require(script.Parent.Particles)
local AxisLinksMod = require(script.Parent.AxisLinks)
local EventsMod = require(script.Parent.Events)
local EventsCollision = require(script.Parent.EventsCollision)
local Pool = require(script.Parent.Pool)
local Constants = require(script.Parent.PartConstants)
local StaticPass = require(script.Parent.StaticPass)

return function(Particle)

-- Start the Heartbeat loop. Each tick walks ActiveEmits → UpdateX; replay on AnimateLoop, swap-pop on death.
function Particle:Activate()
	if self.Connection then return end

	-- Bump engine-session gen so pending closures from prior sessions bail.
	self._engineGen = (self._engineGen or 0) + 1

	-- Reset the not-activated warning latch so a Deactivate → Emit cycle re-warns
	-- on each new Activate session.
	self._notActivatedWarned = false

	-- Reconnect focus listeners (disconnected in Deactivate). Client-only.
	if RunService:IsClient() then
		if not self._focusConn then
			self._focusConn = UIS.WindowFocused:Connect(function()
				self._focused = true
				self._unfocusedAt = 0
			end)
		end
		if not self._blurConn then
			self._blurConn = UIS.WindowFocusReleased:Connect(function()
				self._focused = false
				self._unfocusedAt = os.clock()
			end)
		end
	end

	-- Pin textures for PreloadTexture=true items already in scene.
	for _, service in ipairs({
		workspace,
		game:GetService("Lighting"),
		game:GetService("ReplicatedStorage"),
		game:GetService("StarterGui"),
		game:GetService("StarterPack"),
		game:GetService("ReplicatedFirst"),
	}) do
		pcall(function() self:Preload(service, false) end)
	end

	self.Connection = RunService.Heartbeat:Connect(function(dt)
		EventsMod.tickFrame()
		-- Pool tick before the empty-emits early-return so idle pools still TTL-evict.
		local currentTime = os.clock()
		Pool.tick(currentTime)
		local emits = self.ActiveEmits
		if #emits == 0 then return end
		local camPos; do local cam = workspace.CurrentCamera; if cam then camPos = cam.CFrame.Position end end
		local i = 1

		while i <= #emits do
			local pData = emits[i]
			-- _forceDead (payload.Kill) short-circuits the per-type Update for immediate death.
			local isDead = pData._forceDead == true
			-- Capture step pre-Update so the post-Update cache refresh detects step advance for unlinked particles.
			local prevStep = pData.CurrentStep

			if not isDead then
				if pData.Type == "Part" then
					isDead = self:UpdatePart(pData, dt, currentTime)
				elseif pData.Type == "Beam" then
					isDead = self:UpdateBeam(pData, dt, currentTime)
				elseif pData.Type == "PointLight" then
					isDead = self:UpdatePointLight(pData, dt, currentTime)
				elseif pData.Type == "Highlight" then
					isDead = self:UpdateHighlight(pData, dt, currentTime)
				elseif pData.Type == "TrailEmitter" then
					isDead = self:UpdateTrail(pData, dt, currentTime)
				elseif pData.Type == "Attachment" then
					isDead = self:UpdateAttachment(pData, dt, currentTime)
				elseif pData.Type == "Model" then
					isDead = self:UpdateModel(pData, dt, currentTime)
				elseif pData.Type == "Screen" then
					isDead = self:UpdateScreen(pData, dt, currentTime)
				elseif pData.Type == "ImageLabel" then
					isDead = self:UpdateImageLabel(pData, dt, currentTime)
				end
			end

			-- Per-frame passes run outside the step gate for smooth tracking between keyframes.
			-- Skip on dead particles to avoid one extra wasted frame + last-frame flicker.
			-- `_postUpdateCF` caches the pre-overlay base CFrame so Orientation and ZOffset
			-- can apply as ABSOLUTE overlays. Refresh whenever Update wrote a fresh CFrame
			-- this frame (CurrentStep advanced) or ReapplyLink writes one (every frame for
			-- linked particles). Unlinked between-step frames retain the last step's cache
			-- as the correct overlay base.
			if not isDead then
				if pData.Link then self:ReapplyLink(pData) end
				-- Settle pass post-Update so gravity-torque composes after step rotation.
				local t = pData.Type
				if pData._settleEngaged and not pData._collisionStopped
					and (t == "Part" or t == "Model" or t == "Attachment") then
					EventsCollision.applySettle(pData, dt)
				end
				-- Only Part / Model / Attachment consume `_postUpdateCF` via overlays. Beam,
				-- PointLight, Screen, ImageLabel have no `.CFrame` property  -  gate the cache
				-- write to the consumer types so a Beam with Link doesn't error every Heartbeat.
				if (t == "Part" or t == "Model" or t == "Attachment") and (pData.Link or pData.CurrentStep ~= prevStep) then pData._postUpdateCF = (t == "Model") and pData.VisualPart:GetPivot() or pData.VisualPart.CFrame end
				if pData.Orientation and pData.Orientation ~= "None" then self:ApplyOrientation(pData, dt, camPos) end
				if pData.ZOffset and pData.ZOffset ~= 0 then self:ApplyZOffset(pData, camPos) end
			end

			-- OnHit raycast: AFTER all visual-pass CFrame writes (ReapplyLink + Orientation
			-- + ZOffset), so the segment matches the rendered position rather than the
			-- mid-pass intermediate. Internal pData.Events.OnHit gate makes this a cheap
			-- no-op when not configured. Runs even on death frame so fast particles don't
			-- have a blind segment between last-update and removal.
			EventsMod.afterUpdate(self, pData, isDead, currentTime)

			if isDead then
				-- OnDeath fires before any swap-and-pop / animate restart. AnimateLoop
				-- replay also fires OnDeath every cycle boundary; replay branch resets
				-- _killedManually after this fire so the new cycle starts clean.
				self:_fireOnDeath(pData)
				if pData.IsAnimate then
					if pData.AnimateItem and pData.AnimateItem.Parent and pData.AnimateItem:GetAttribute("AnimateLoop") then
						-- Reset and replay  -  re-read properties so live edits take effect.
						pData.StartTime = currentTime
						pData.CurrentStep = 0
						if pData.AccumulatedDT then pData.AccumulatedDT = 0 end
						if pData.InitialLocalCF then pData.LocalCF = pData.InitialLocalCF end
						if pData.AccRotX then pData.AccRotX = 0; pData.AccRotY = 0; pData.AccRotZ = 0 end
						-- Reset accumulated target-acceleration velocity so each loop iteration
						-- starts fresh from the base trajectory.
						if pData.TargetVel then pData.TargetVel = Vector3.zero end
						-- Reset OnHit Collision-mode state so each cycle replays from a clean
						-- slate (otherwise _collisionStopped / spin / SpeedMultiplier / reflected
						-- _accelVel compound across cycles). BaseDirection restored from the
						-- emit-time snapshot.
						pData._collisionStopped = false
						pData._spinRate = Vector3.zero
						pData._spinAccumX = 0
						pData._spinAccumY = 0
						pData._spinAccumZ = 0
						pData.SpeedMultiplier = 1
						if pData._accelVel then pData._accelVel = Vector3.zero end
						if pData._prevWorldOff then
							pData._prevWorldOff = Vector3.zero
							-- Drop OnHit-bounce mirror axes so each AnimateLoop cycle starts
							-- with un-mirrored trajectory state matching emit-time baseline.
							pData._displacementMirrorX = nil
							pData._displacementMirrorY = nil
							pData._displacementMirrorZ = nil
							-- Apply PosOffset(0) so cycle restart matches emit-time spawn pose
							-- (front-loaded curves would otherwise pop on the first step).
							if pData.HasPosOffsetGraphs and pData.Graphs and pData.SpawnRotation then
								local oX = pData.Graphs.PosOffsetX and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetX, pData.Seeds.PosOffsetX) or 0
								local oY = pData.Graphs.PosOffsetY and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetY, pData.Seeds.PosOffsetY) or 0
								local oZ = pData.Graphs.PosOffsetZ and GraphMod.QueryPointsWithTime(0, pData.Graphs.PosOffsetZ, pData.Seeds.PosOffsetZ) or 0
								if oX ~= 0 or oY ~= 0 or oZ ~= 0 then
									local worldOff = Constants.resolveDisplacement(Vector3.new(oX, oY, oZ),
										pData.DisplacementMode or "Global", pData.SpawnRotation, pData.SpawnEmitterRotation)
									pData._prevWorldOff = worldOff
									pData.LocalCF = pData.LocalCF + worldOff
									if pData.VisualPart and pData.VisualPart.Parent then
										if pData.Type == "Model" then
											pcall(function() pData.VisualPart:PivotTo(pData.VisualPart:GetPivot() + worldOff) end)
										else
											pData.VisualPart.CFrame = pData.VisualPart.CFrame + worldOff
										end
									end
								end
							end
						end
						if pData._initialBaseDirection then pData.BaseDirection = pData._initialBaseDirection end
						pData._lastOrientPos = nil
						-- Reset LinkTrack base (`_localWorldCF`) and overlay base (`_postUpdateCF`)
						-- so that on the first no-step frames of the new cycle, ApplyOrientation /
						-- ApplyZOffset compose against the replay's initial pose, not the last
						-- cycle's terminal pose.
						pData._localWorldCF, pData._postUpdateCF = pData.InitialLocalCF, pData.InitialLocalCF
						-- Clear GraphBlender state-search caches so next frame's monotonic-t search
						-- restarts from index 1. Otherwise the cached lastIdx points past the new
						-- t≈0, the search no-ops, and LerpGraph extrapolates with a negative alpha.
						pData._lastTransIdx = nil; pData._lastColorIdx = nil
						-- Stale-data fallback if freshData is nil. Fresh-data path overrides
						-- this AFTER the per-cycle refresh so the new Timescale + LifeTime apply.
						pData._effectiveElapsed = GraphMod.InitialEffectiveElapsed(pData.Graphs and pData.Graphs.Timescale, pData.Seeds and pData.Seeds.Timescale, pData.LifeTime)
						pData._hitHistory = nil
						if pData.Type == "ImageLabel" then pData.PosX = 0; pData.PosY = 0; pData.EnvVelX = 0; pData.EnvVelY = 0; pData.AccRot = 0 end
						local freshData = self:GetData(pData.AnimateItem)
						if freshData then
							pData.Events = freshData.Events
							pData._killedManually = false
							pData._fireOnDeathOverride = false
							pData._hitFired = false
							pData.LifeTime = RangeMod.RandomValueFromRange(freshData.Lifetime)
							if pData.LifeTime <= 0 then pData.LifeTime = 0.001 end
							pData.TotalKeyFrames = math.max(1, freshData.TotalKeyFrames)
							if freshData.ParticleData then
								pData.Acceleration = freshData.ParticleData.Acceleration
								pData.Drag = freshData.ParticleData.Drag
								pData.HasDrag = freshData.ParticleData.Drag ~= 0
								pData.HasAccel = freshData.ParticleData.Acceleration.Magnitude > 0
							end
							-- Refresh cached flags that affect simulation behavior. Loop-restart honors
							-- live edits to AccelerationTowardsInstance / AccelTarget / InvertMotion.
							-- Target-accel is frame-granularity in branches 3/4 (one sample per
							-- Heartbeat) so it doesn't force NeedsFullIteration; only VelocityVectored
							-- does, because direction feedback requires per-step CFrame writes.
							pData.InvertMotion = freshData.InvertMotion or false
							pData.AccelTarget = freshData.AccelTarget
							pData.HasTargetAccel = freshData.AccelerationTowardsInstance == true and freshData.AccelTarget ~= nil and freshData.AccelStrength ~= nil and not pData.InvertMotion
							pData.TargetVel = Vector3.zero
							if freshData.VelocityVectored ~= nil then pData.VelocityVectored = freshData.VelocityVectored end
							pData.NeedsFullIteration = pData.VelocityVectored or false
							if freshData.RotMode then pData.RotMode = freshData.RotMode; pData.NeedsRotAccum = (freshData.RotMode == "Speed") and not (pData.VelocityVectored or false) end
							-- Refresh Link + LinkMode so a mid-loop LinkSource flip (None → Camera)
							-- takes effect on the next animate cycle. ReapplyLink reads pData.Link
							-- per frame, so updating it here is enough.
							pData.Link = freshData.Link
							pData.LinkMode = freshData.LinkMode
							-- Refresh non-spatial setup fields via the per-type helpers. Spatial
							-- LocalCF rebuild (3D) and image-display refresh (2D) live in those helpers.
							if pData.Type == "ImageLabel" then
								self:_refreshImageLabelAnimateNonSpatial(pData, freshData)
							else
								self:_refreshAnimateNonSpatial(pData, freshData)
							end
							-- Restore any graphs the prior cycle's StaticPass nil'd so refreshLoopGraphsAndSeeds'
							-- pairs(pData.Graphs) iteration picks them up. Static-pass at end of block
							-- re-detects + re-nils as appropriate.
							StaticPass.restoreFromFreshData(pData, freshData)
							AxisLinksMod.refreshLoopGraphsAndSeeds(pData, freshData, GraphMod)
							-- Re-detect static graphs from fresh pData.Graphs. Idempotent: clears
							-- stale _static<Name> fields so a graph switched from static→dynamic mid-
							-- cycle re-arms the per-frame sample path. ImageLabel SizeScale both-axes-
							-- static collapse mirrored from buildImageLabelPData so the per-frame Size
							-- block short-circuits (frame-0 wrote the constant Size).
							StaticPass.apply(pData)
							if pData.Type == "ImageLabel"
								and pData._staticSizeScaleX and pData._staticSizeScaleY then
								pData._staticSizeScaleX = nil
								pData._staticSizeScaleY = nil
							end
							-- Must run after fresh Timescale graph + LifeTime are in place.
							pData._effectiveElapsed = GraphMod.InitialEffectiveElapsed(pData.Graphs and pData.Graphs.Timescale, pData.Seeds and pData.Seeds.Timescale, pData.LifeTime)
							-- ImageLabel InvertMotion: re-seed end-state for next cycle (mirrors the
							-- emit-time setup in buildImageLabelPData) so each cycle integrates from
							-- the inverted end-pose with negative dt.
							if pData.Type == "ImageLabel" then
								-- ImgInvertMotion lives under its raw attribute name (GetData reads it
								-- directly, no TypeRegistry attrName mapping into freshData.InvertMotion).
								pData.InvertMotion = freshData.ImgInvertMotion or false
								if pData.InvertMotion then
									local endX, endY, endVelX, endVelY = self:_computeImageLabelEndState(freshData, pData.DirX or 0, pData.DirY or 0, pData.LifeTime, pData.Seeds)
									pData.PosX, pData.PosY = endX, endY
									pData.EnvVelX, pData.EnvVelY = endVelX, endVelY
									pData._effectiveElapsed = pData.LifeTime
									pData._invertDtSign = -1
								else
									pData._invertDtSign = nil
								end
							end
							-- Rebuild SimLocalCFrames whenever InvertMotion is true. Loop restart
							-- can land on a different InvertMotion / TotalKeyFrames than the last
							-- cycle, and inverted UpdatePart indexes the cache by step. Drop the
							-- cache on InvertMotion=false so a later flip-on triggers a fresh build.
							if pData.InvertMotion and pData.AnimateItem and pData.AnimateItem.Parent then
								local restartCF
								local isAttachment = pData.Type == "Attachment"
								if pData.Type == "Model" then
									local ok, cf = pcall(function() return pData.AnimateItem:GetPivot() end)
									if ok then restartCF = cf end
								elseif isAttachment then
									-- Parent-local; matches EmitAnimate's `localCF = attachment.CFrame`.
									restartCF = pData.AnimateItem.CFrame
								elseif pData.AnimateItem:IsA("BasePart") then
									restartCF = pData.AnimateItem.CFrame
								end
								if restartCF then
									local ok2, sim, effTKF = pcall(function()
										if isAttachment then
											return self:PreSimulateAttachmentForward(freshData, pData.Seeds, restartCF, pData.BaseDirection, pData.SpreadRotation, pData.LifeTime, nil, pData.SpawnEmitterRotation)
										else
											return self:PreSimulateForward(freshData, pData.Seeds, restartCF, pData.BaseDirection, pData.SpreadRotation, pData.Link, pData.LifeTime, nil, pData.SpawnEmitterRotation)
										end
									end)
									if ok2 then
										pData.SimLocalCFrames = sim
										if effTKF then pData.TotalKeyFrames = effTKF end
									end
								end
							elseif not pData.InvertMotion then
								pData.SimLocalCFrames = nil
							end
							-- Beam: rebuild AnimatedProps + GraphBlender states from fresh data. Also
							-- refresh cached _baseWidth0/Width1/CurveSize0/CurveSize1/TextureLength/
							-- Segments from the source's CURRENT values so live edits to non-animated
							-- graph props propagate into the next animate-loop iteration.
							if pData.Type == "Beam" and freshData.BeamProps then
								local vb = pData.VisualPart
								local ap = {}
								for name, sequence in pairs(freshData.BeamProps) do
									if sequence then
										if GraphMod.IsStatic(sequence) then
											if vb then vb[name] = GraphMod.GetStaticValue(sequence, vb[name]) end
										else ap[name] = { Sequence = sequence, Seed = GraphMod.GenerateSeed(sequence) } end
									end
								end
								pData.AnimatedProps = ap
								if vb then
									pData._baseWidth0 = vb.Width0
									pData._baseWidth1 = vb.Width1
									pData._baseCurveSize0 = vb.CurveSize0
									pData._baseCurveSize1 = vb.CurveSize1
									pData._baseTextureLength = vb.TextureLength
									pData._baseSegments = vb.Segments
								end
								if ap.TextureSpeed and vb then vb.TextureSpeed = 0 end
								if freshData.GraphBlender then
									local ts, cs = GraphMod.CollectGraphStates(freshData.GraphBlender)
									pData.TransStates = ts; pData.ColorStates = cs
									local tmt = {}; for idx = 1, #ts - 1 do tmt[idx] = GraphMod.PrecomputeMergedTimes(ts[idx].Graph, ts[idx+1].Graph) end
									local cmt = {}; for idx = 1, #cs - 1 do cmt[idx] = GraphMod.PrecomputeMergedColorTimes(cs[idx].Graph, cs[idx+1].Graph) end
									pData.TransMergedTimes = tmt; pData.ColorMergedTimes = cmt
									if #ts > 0 and vb then vb.Transparency = ts[1].Graph end
									if #cs > 0 and vb then vb.Color = cs[1].Graph end
								end
							end
							if freshData.PLRange then pData.PLRange = freshData.PLRange end
							if freshData.PLBrightness then pData.PLBrightness = freshData.PLBrightness end
							if freshData.PLColor then pData.PLColor = freshData.PLColor end
						end
						-- Animate-loop replay reset target: read source's CURRENT CFrame each cycle so
						-- parent moves carry through (cached InitialAnchorCF would freeze at emit-time pose).
						if pData.AnimateItem and pData.AnimateItem.Parent and pData.VisualPart and pData.VisualPart.Parent then
							if pData.Type == "Model" then
								local ok, sourceCF = pcall(function() return pData.AnimateItem:GetPivot() end)
								if ok and sourceCF then pData.VisualPart:PivotTo(sourceCF) end
							elseif pData.AnimateItem:IsA("BasePart") then
								pData.VisualPart.CFrame = pData.AnimateItem.CFrame
							elseif pData.AnimateItem:IsA("Attachment") then
								-- RT is a CHILD of the source Attachment; identity preserves the
								-- parent-local invariant established by Transform.luau:96. Writing
								-- source.CFrame here bakes the source's own offset INTO the RT.
								pData.VisualPart.CFrame = CFrame.new()
							end
						end
						self:_fireAnimateCycleRestartEvents(pData)
						i += 1
					else
						-- One-shot animate finish. PartLife keeps the visual at its last frame for N
						-- seconds before position reset + hide.
						local visualPart = pData.VisualPart
						local pType = pData.Type
						local initialAnchorCF = pData.InitialAnchorCF
						local initialScale = pData.InitialScale
						local hasDecal = pData.HasDecal
						local animateItem = pData.AnimateItem
						local partLife = pData.PartLife or 0
						local isSharedRT = (pType == "Part" or pType == "Attachment" or pType == "Model" or pType == "Beam")
						-- Per-cycle finish token. Each Animate cycle bumps `_animateFinishGen`
						-- on the source item; this finish closure captures the value at schedule
						-- time and bails if a newer cycle has armed its own finish since.
						local finishGen
						if animateItem then
							finishGen = (animateItem:GetAttribute("_animateFinishGen") or 0) + 1
							pcall(function() animateItem:SetAttribute("_animateFinishGen", finishGen) end)
						end
						local function finishAnimate()
							if not visualPart or not visualPart.Parent then return end
							if isSharedRT and animateItem and self.ActiveAnimates[animateItem] then return end
							if animateItem and animateItem.Parent and finishGen and animateItem:GetAttribute("_animateFinishGen") ~= finishGen then return end
							-- OnDestruction fires JUST BEFORE the visual is restored/destroyed/hidden.
							-- AnimateLoop replay doesn't reach here (death-handler restarts cycle
							-- without calling finishAnimate), so this is genuinely terminal.
							self:_fireOnDestruction(pData, visualPart)
							if initialAnchorCF then
								if pType == "Model" then
									pcall(function() visualPart:PivotTo(initialAnchorCF) end)
									if initialScale then pcall(function() visualPart:ScaleTo(initialScale) end) end
								else pcall(function() visualPart.CFrame = initialAnchorCF end) end
							end
							if pType == "Screen" or pType == "ImageLabel" then
								pcall(function() visualPart:Destroy() end)
							elseif pType == "Beam" or pType == "Highlight" or pType == "TrailEmitter" then
								local snap = pData.BeamSnapshot or pData.HighlightSnapshot or pData.TrailEmitterSnapshot
								if snap then
									pcall(function() for k, v in pairs(snap) do visualPart[k] = v end end)
								end
								pcall(function() visualPart.Enabled = false end)
							else
								pcall(function()
									visualPart.Transparency = 1
									if hasDecal then local d = visualPart:FindFirstChildOfClass("Decal"); if d then d.Transparency = 1 end end
									local sa = pData._initialSAColor and visualPart:FindFirstChildOfClass("SurfaceAppearance")
									if sa then sa.Color = pData._initialSAColor end
									if pData._initialPartColor and visualPart:IsA("BasePart") then visualPart.Color = pData._initialPartColor end
								end)
							end
						end
						-- Clear ActiveAnimates BEFORE running finishAnimate (see prior comment block).
						self.ActiveAnimates[animateItem] = nil
						if partLife > 0 then task.delay(partLife, finishAnimate) else finishAnimate() end
						if pData._scaleMapKeys and self._parentScaleMap then
							for _, desc in ipairs(pData._scaleMapKeys) do
								self._parentScaleMap[desc] = nil
							end
						end
						if pData._nestedAlive then pData._nestedAlive[1] = false end
						local n = #emits
						if i < n then emits[i] = emits[n] end
						emits[n] = nil
					end
				else
					-- Normal emit: destroy visual, swap-and-pop. OnDestruction fires JUST
					-- BEFORE destroy (immediate path) or inside the deferred closure (linger
					-- path) so user scripts read the final pose pre-destroy.
					local visualPart = pData.VisualPart
					if pData.PartLife and pData.PartLife > 0 then
						-- Track this visualPart in self._lingerByItem so Particle:Disable
						-- can destroy linger clones early when Stop fires. Also bump the
						-- linger visual counter so MAX_ACTIVE_PARTICLES reflects rendered
						-- linger clones; flag the visual so each path that destroys it
						-- decrements at most once.
						local source = pData._sourceItem
						if source and visualPart then
							self._lingerByItem = self._lingerByItem or {}
							local list = self._lingerByItem[source] or {}
							table.insert(list, visualPart)
							self._lingerByItem[source] = list
							pcall(function() visualPart:SetAttribute("_lingerCounted", true) end)
							self._lingerVisualCount += 1
						end
						-- Stamp linger start so OnDestruction's payload.LingerElapsed
						-- can report actual time-in-linger when fired (early-Disable
						-- destroys mid-linger; full PartLife when delay completes).
						pData._lingerStartTime = os.clock()
						task.delay(pData.PartLife, function()
							self:_fireOnDestruction(pData, visualPart)
							if visualPart then
								local counted = false
								pcall(function() counted = visualPart:GetAttribute("_lingerCounted") == true end)
								if counted then
									self._lingerVisualCount = math.max(0, (self._lingerVisualCount or 0) - 1)
									pcall(function() visualPart:SetAttribute("_lingerCounted", nil) end)
								end
								-- Pool-eligible if non-animate and pData has source RT stamps
								-- (Emit.luau / EmitModel.luau / PointLight.luau set them).
								self:_releaseOrDestroy(pData, visualPart)
							end
							if source and self._lingerByItem and self._lingerByItem[source] then
								local list = self._lingerByItem[source]
								for k = #list, 1, -1 do
									if list[k] == visualPart then
										local n = #list
										if k < n then list[k] = list[n] end
										list[n] = nil
									end
								end
								if #list == 0 then self._lingerByItem[source] = nil end
							end
						end)
					else
						-- PartLife=0: OnDestruction same-frame as OnDeath, then release/destroy.
						self:_fireOnDestruction(pData, visualPart)
						self:_releaseOrDestroy(pData, visualPart)
					end
					if pData._scaleMapKeys and self._parentScaleMap then
						for _, desc in ipairs(pData._scaleMapKeys) do
							self._parentScaleMap[desc] = nil
						end
					end
					if pData._nestedAlive then pData._nestedAlive[1] = false end
					local n = #emits
					if i < n then emits[i] = emits[n] end
					emits[n] = nil
				end
			else
				i += 1
			end
		end
	end)
end

-- Shut down the engine. Disconnects Heartbeat, destroys every live clone, cancels loops, restores
-- animate sources, and clears texture pins. Safe to call multiple times.
function Particle:Deactivate()
	-- Bump engine-session generation FIRST. Any pending EnableEmit / Enable
	-- task.delay closure that captured the prior gen will now bail via
	-- genStillCurrent's `self._engineGen == engineGen` check, instead of
	-- spawning particles after teardown disconnected the Heartbeat.
	self._engineGen = (self._engineGen or 0) + 1
	if self.Connection then
		self.Connection:Disconnect()
		self.Connection = nil
	end
	-- Disconnect UIS focus tracking  -  module reload would otherwise leak the two
	-- WindowFocused/WindowFocusReleased connections firing on dead-module closures.
	if self._focusConn then self._focusConn:Disconnect(); self._focusConn = nil end
	if self._blurConn then self._blurConn:Disconnect(); self._blurConn = nil end
	if self._parentScaleMap then table.clear(self._parentScaleMap) end
	if self._lingerByItem then table.clear(self._lingerByItem) end
	-- Pending PartLife linger closures hold no engineGen guard, so they continue
	-- decrementing past Deactivate. Zero the counter here so a quick Off→On toggle
	-- doesn't see an inflated _lingerVisualCount restricting fresh emits via the cap
	-- check. The math.max(0, ... - 1) guard in the closure tolerates the reset.
	self._lingerVisualCount = 0
	-- Clean up all active particles. Skip 3D animate-mode pData: their VisualPart IS the source's
	-- live RenderTemplate child (not a clone)  -  destroying it would orphan the source instance.
	-- Flush pool BEFORE iterating ActiveEmits  -  pool entries are non-active clones we
	-- own; their Destroy is bookkeeping-light and short-circuits the workspace sweep
	-- below from finding them (the sweep matches on _PartIcleEmit attribute, which
	-- pooled entries still carry).
	Pool.flushAll()
	for i = #self.ActiveEmits, 1, -1 do
		local pData = self.ActiveEmits[i]
		local skip = pData.IsAnimate and (pData.Type == "Part" or pData.Type == "Attachment"
			or pData.Type == "Beam" or pData.Type == "Model")
		if not skip and pData.VisualPart then
			pcall(function() pData.VisualPart:Destroy() end)
		end
		if pData._nestedAlive then pData._nestedAlive[1] = false end
		self.ActiveEmits[i] = nil
	end
	-- Reset animate items via cancelAnimation (restores source RT to authored state).
	local animateKeys = {}
	for item in pairs(self.ActiveAnimates) do table.insert(animateKeys, item) end
	for _, item in ipairs(animateKeys) do
		pcall(function() self:_cancelAnimation(item) end)
	end
	table.clear(self.ActiveAnimates)
	for item, thread in pairs(self.ActiveLoops) do
		pcall(function() task.cancel(thread) end)
		self.ActiveLoops[item] = nil
	end
	-- Cancel chain-driven duration loops + clear buckets so the map doesn't sit
	-- pinned until module reload. `_engineGen` drift above also makes the threads
	-- self-terminate; this just frees the table refs.
	if self.ActiveChainLoops then for _, bucket in pairs(self.ActiveChainLoops) do for _, t in ipairs(bucket) do pcall(task.cancel, t) end end; table.clear(self.ActiveChainLoops) end
	if self._CachedFolder and self._CachedFolder.Parent then
		self._CachedFolder:Destroy()
	end
	self._CachedFolder = nil
	if self._CachedPoolFolder and self._CachedPoolFolder.Parent then
		self._CachedPoolFolder:Destroy()
	end
	self._CachedPoolFolder = nil
	-- Sweep workspace + Lighting + the auto-managed CoreGui ScreenGui for any emitted items that
	-- escaped normal tracking (PointLights parent to original part; PartLife-delayed items removed
	-- from ActiveEmits early; screen effects live in Lighting; ImageLabels live in our ScreenHost).
	local function sweep(root) for _, desc in root:GetDescendants() do if desc:GetAttribute("_PartIcleEmit") then pcall(desc.Destroy, desc) end end end
	sweep(workspace); sweep(game:GetService("Lighting"))
	local ScreenHost = require(script.Parent.ScreenHost)
	if ScreenHost.exists() then sweep(ScreenHost.get()); ScreenHost.destroy() end
	local TexturePin = require(script.Parent.TexturePin)
	TexturePin.clear()
	-- Tear down Events compile cache: disconnects every Source/AncestryChanged signal +
	-- destroys every `_CompiledEventModule` clone so toggle-off-on cycles don't leak
	-- signal connections firing on dead-module closures.
	EventsMod.cleanup()
	-- LinkService owns an independent per-frame PreRender / Heartbeat connection +
	-- Anchored snapshot table. Deactivate disconnects + restores so toggle cycles
	-- don't leak link tracking or strand parts in Anchored=true state.
	if self.LinkService and self.LinkService.Deactivate then
		pcall(function() self.LinkService:Deactivate() end)
	end
end

-- Lazy-create (and cache) the bucket folder where ACTIVELY emitted Part/Attachment/Model clones
-- live. Idle pool entries get re-parented to a SEPARATE `Part_IclesPooled` folder on Pool.release
-- (see Pool.luau) so the Explorer makes it obvious which clones are live vs idle/recyclable.
-- Both folders parent to workspace.Terrain (out of the explorer workspace list); Archivable=false
-- keeps them out of undo + place file saves.
function Particle:GetFolder()
	if self._CachedFolder and self._CachedFolder.Parent then
		return self._CachedFolder
	end
	local folder = workspace.Terrain:FindFirstChild('EmittedPartsUsingPart_icle')
	if not folder then
		folder = Instance.new('Folder')
		folder.Name = "EmittedPartsUsingPart_icle"
		folder.Archivable = false
		folder.Parent = workspace.Terrain
	end
	self._CachedFolder = folder
	return folder
end

-- Idle-pool bucket. Pool.release re-parents released visuals here so authoring users can see
-- exactly which clones are recyclable vs. actively emitting (in the GetFolder bucket).
function Particle:GetPoolFolder()
	if self._CachedPoolFolder and self._CachedPoolFolder.Parent then
		return self._CachedPoolFolder
	end
	local folder = workspace.Terrain:FindFirstChild('Part_IclesPooled')
	if not folder then
		folder = Instance.new('Folder')
		folder.Name = "Part_IclesPooled"
		folder.Archivable = false
		folder.Parent = workspace.Terrain
	end
	self._CachedPoolFolder = folder
	return folder
end

end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">Events</string>
              <string name="Source"><![CDATA[--[[
	Events  -  Part-Icles runtime; helper module (not a mixin).
	  - Compile cache for per-event Modules (clone-and-require, invalidates on Source change).
	  - ChainCtx (ChainId + Depth) propagation; per-event ChainDepthLimit + hard ceiling.
	  - Per-frame burst cap + once-per-second drop reporting.
	  - Payload builder, world-pos/CFrame helpers, Events.fire dispatcher.
	  - emitTargetInstance / _emitTransformed: EmitTarget + EmitMode → EnableEmit / EnableEmitAt.
	  - afterUpdate: per-frame OnHit raycast.

	Cross-file invariants:
	  - pData.Events is FROZEN at emit (EventsSchema.readEnabled snapshot); hot path never re-reads.
	  - pData.EventChainCtx propagates through _registerEmit + every event fire.
	  - Plugin teardown MUST call Events.cleanup() to release Module connections.
]]

local TypeRegistry = require(script.Parent.TypeRegistry)
local EventsCollision = require(script.Parent.EventsCollision)
local EventsPayload = require(script.Parent.EventsPayload)
local EventsSchema = require(script.Parent.EventsSchema)
local Pool = require(script.Parent.Pool)

local Events = {}

local MAX_EVENT_FIRES_PER_FRAME = 256
local DEFAULT_CHAIN_DEPTH_LIMIT = 4
local HARD_CHAIN_DEPTH_CEILING  = 32
local CONFIG_NAME = TypeRegistry.CONFIG_NAME
local EVENTS_FOLDER_NAME = "Events"

-- Per-Module compile cache; key = source ModuleScript. _invalidate clears entries.
local cache = {}

-- Per-frame burst state.
Events._frameCount = 0
Events._burstDropped = 0
Events._burstReportPending = false

local _depthDropPending = false
local _depthDropped = 0

-- Bumped by cleanup() so stale 1s-delay warn closures bail.
local _reportGeneration = 0

-- Warn-once sentinels for emit-mode mismatches.
local _unsupportedOriginWarned = {}
local _nilOriginWarned = {}

local _nextChainId = 0
local function nextChainId()
	_nextChainId += 1
	return _nextChainId
end

function Events.newChainCtx()
	return { ChainId = nextChainId(), Depth = 0 }
end

-- Shallow copy emitCtx + EmitIndex (1-based) for burst-loop clones.
function Events.withEmitIndex(emitCtx, i)
	if not emitCtx then return { EmitIndex = i } end
	local out = { EmitIndex = i }
	for k, v in pairs(emitCtx) do
		if k ~= "EmitIndex" then out[k] = v end
	end
	return out
end

-- Shallow copy + EmitIndex + EmitCount; required pair for EvenDistribution sampler.
function Events.withEmitIndexAndCount(emitCtx, i, n)
	if not emitCtx then return { EmitIndex = i, EmitCount = n } end
	local out = { EmitIndex = i, EmitCount = n }
	for k, v in pairs(emitCtx) do
		if k ~= "EmitIndex" and k ~= "EmitCount" then out[k] = v end
	end
	return out
end

-- Strip origin-override fields when threading emitCtx into a chained sub-emit;
-- preserves ChainCtx + EmitIndex/EmitCount. Used by Events chain dispatches.
function Events.descendCtx(emitCtx)
	if not emitCtx then return nil end
	if emitCtx.EventOriginCF == nil and emitCtx.IgnoreLink == nil
		and emitCtx.UseFullOrigin == nil and emitCtx.EventOriginResolver == nil then
		return emitCtx
	end
	return {
		ChainCtx  = emitCtx.ChainCtx,
		EmitIndex = emitCtx.EmitIndex,
		EmitCount = emitCtx.EmitCount,
	}
end

-- Compile / cache

-- Plugin context allows Source reads; play / non-plugin lacks PluginOrOpenCloud capability.
-- Play mode: skip clone+require (Source immutable anyway, direct require works).
local _isPluginContext = pcall(function() return (Instance.new("ModuleScript")).Source end)

function Events._compile(moduleScript)
	if not _isPluginContext then
		local ok, fn = pcall(require, moduleScript)
		if not ok then return nil, fn elseif type(fn) ~= "function" then return nil, "module must return function(payload)" end
		return fn, nil, nil
	end
	local clone = moduleScript:Clone()
	clone.Name = "_CompiledEventModule"
	clone.Archivable = false
	clone.Parent = moduleScript.Parent
	local ok, fn = pcall(require, clone)
	if not ok then
		clone:Destroy()
		return nil, fn
	end
	if type(fn) ~= "function" then
		clone:Destroy()
		return nil, "module must return function(payload)"
	end
	return fn, nil, clone
end

function Events._isCacheValid(cacheEntry, moduleScript)
	if not cacheEntry or not moduleScript or not moduleScript:IsA("ModuleScript") then return false end
	if moduleScript.Name ~= "Module" then return false end
	local eventCfg = cacheEntry.expectedEventCfg
	if not eventCfg or not eventCfg.Parent then return false end
	if eventCfg.Name ~= cacheEntry.expectedEventName then return false end
	if not eventCfg.Parent or eventCfg.Parent.Name ~= EVENTS_FOLDER_NAME then return false end
	return moduleScript.Parent == eventCfg
end

-- Single chokepoint to release signals + destroy clone + drop cache entry.
function Events._invalidate(moduleScript)
	local entry = cache[moduleScript]
	if not entry then return end
	if entry.sourceConn then entry.sourceConn:Disconnect(); entry.sourceConn = nil end
	if entry.ancestryConn then entry.ancestryConn:Disconnect(); entry.ancestryConn = nil end
	if entry.nameConn then entry.nameConn:Disconnect(); entry.nameConn = nil end
	if entry.compiledClone then
		pcall(function() entry.compiledClone:Destroy() end)
		entry.compiledClone = nil
	end
	cache[moduleScript] = nil
end

-- Get-or-compile; recompiles on dirty (Source changed) or tree-position mismatch.
function Events.compile(moduleScript)
	if not moduleScript or not moduleScript:IsA("ModuleScript") then return nil end
	local entry = cache[moduleScript]
	if entry and not entry.dirty and Events._isCacheValid(entry, moduleScript) then
		return entry.fn
	end
	-- Stale entry: invalidate first so signals don't double-fire on the new entry.
	if entry then Events._invalidate(moduleScript) end

	local fn, err, clone = Events._compile(moduleScript)
	if not fn then
		Events.reportScriptError(moduleScript, err)
		return nil
	end

	local eventCfg = moduleScript.Parent
	if not eventCfg or not eventCfg:IsA("Configuration") then
		clone:Destroy()
		return nil
	end

	local newEntry = {
		fn = fn,
		expectedEventCfg = eventCfg,
		expectedEventName = eventCfg.Name,
		dirty = false,
		compiledClone = clone,
	}
	-- Mark dirty on Source-change; recompile lazily on next fire. Play / non-plugin contexts
	-- lack the PluginOrOpenCloud capability and Source is immutable there anyway  -  skip.
	if _isPluginContext then
		newEntry.sourceConn = moduleScript:GetPropertyChangedSignal("Source"):Connect(function()
			if cache[moduleScript] then cache[moduleScript].dirty = true end
		end)
	end
	-- Module dragged out / destroyed → invalidate.
	newEntry.ancestryConn = moduleScript.AncestryChanged:Connect(function()
		if not Events._isCacheValid(cache[moduleScript], moduleScript) then
			Events._invalidate(moduleScript)
		end
	end)
	-- Snap user-renames back to "Module" so the cache-validity check doesn't
	-- treat every fire as stale and trigger a clone+require+destroy cycle.
	newEntry.nameConn = moduleScript:GetPropertyChangedSignal("Name"):Connect(function()
		if moduleScript.Name ~= "Module" then
			pcall(function() moduleScript.Name = "Module" end)
		end
	end)
	cache[moduleScript] = newEntry
	return fn
end

function Events.cleanup()
	-- Snapshot keys first; mutating during pairs() is undefined.
	local keys = {}
	for moduleScript in pairs(cache) do table.insert(keys, moduleScript) end
	for _, moduleScript in ipairs(keys) do Events._invalidate(moduleScript) end
	-- Bump report gen so in-flight task.delay warn closures bail.
	_reportGeneration += 1
	Events._frameCount = 0
	Events._burstDropped = 0
	Events._burstReportPending = false
	_depthDropped = 0
	_depthDropPending = false
	table.clear(_unsupportedOriginWarned)
	table.clear(_nilOriginWarned)
end

-- Burst cap + reporting

-- Once-per-second summary; per-frame would flood Output at 60fps overflow.
function Events._reportBurst()
	Events._burstDropped += 1
	if not Events._burstReportPending then
		Events._burstReportPending = true
		local gen = _reportGeneration
		task.delay(1, function()
			if gen ~= _reportGeneration then return end
			if Events._burstDropped > 0 then
				warn(("[Part-Icles Events] dropped %d event fires this second."):format(Events._burstDropped))
			end
			Events._burstDropped = 0
			Events._burstReportPending = false
		end)
	end
end

function Events.reserveFrameFire()
	if Events._frameCount >= MAX_EVENT_FIRES_PER_FRAME then
		Events._reportBurst()
		return false
	end
	Events._frameCount += 1
	return true
end

-- Called once per Heartbeat to reset the per-frame counter.
function Events.tickFrame()
	Events._frameCount = 0
end

function Events.dropDepth(eventName)
	_depthDropped += 1
	if not _depthDropPending then
		_depthDropPending = true
		local gen = _reportGeneration
		task.delay(1, function()
			if gen ~= _reportGeneration then return end
			if _depthDropped > 0 then
				warn(("[Part-Icles Events] dropped %d event fire(s) this second (chain depth limit reached%s)."):format(
					_depthDropped, eventName and (" on " .. eventName) or ""))
			end
			_depthDropped = 0
			_depthDropPending = false
		end)
	end
end

function Events.reportScriptError(moduleScript, err)
	local path = moduleScript and moduleScript:GetFullName() or "<destroyed>"
	warn(("[Part-Icles Events] %s\n  %s"):format(path, tostring(err)))
end

-- World-position helpers (type-correct across Attachment/Model/Beam/PL/Screen).
function Events.getWorldCF(pData)
	local v = pData.VisualPart
	if not v or not v.Parent then return nil end
	if v:IsA("BasePart") then return v.CFrame end
	if v:IsA("Attachment") then return v.WorldCFrame end
	if v:IsA("Model") then return v:GetPivot() end
	if v:IsA("PointLight") then
		local p = v.Parent
		if p and p:IsA("BasePart") then return p.CFrame end
		if p and p:IsA("Attachment") then return p.WorldCFrame end
		return nil
	end
	if v:IsA("Beam") then
		local a0 = v.Attachment0
		if a0 then
			local a1 = v.Attachment1
			if a1 then return CFrame.new((a0.WorldPosition + a1.WorldPosition) * 0.5) end
			return CFrame.new(a0.WorldPosition)
		end
		return nil
	end
	return nil
end

function Events.getWorldPosition(pData)
	local cf = Events.getWorldCF(pData)
	return cf and cf.Position or nil
end

function Events.getSourceWorldCF(sourceItem)
	if not sourceItem or not sourceItem.Parent then return nil end
	if sourceItem:IsA("BasePart") then return sourceItem.CFrame end
	if sourceItem:IsA("Attachment") then return sourceItem.WorldCFrame end
	if sourceItem:IsA("Model") then return sourceItem:GetPivot() end
	if sourceItem:IsA("Beam") then
		local a0 = sourceItem.Attachment0
		if a0 then
			local a1 = sourceItem.Attachment1
			if a1 then return CFrame.new((a0.WorldPosition + a1.WorldPosition) * 0.5) end
			return CFrame.new(a0.WorldPosition)
		end
		return nil
	end
	if sourceItem:IsA("PointLight") then
		local p = sourceItem.Parent
		if p and p:IsA("BasePart") then return p.CFrame end
		if p and p:IsA("Attachment") then return p.WorldCFrame end
		return nil
	end
	return nil
end

-- ============================================================================
-- OnHit raycast filter
-- ============================================================================

-- Explicit table.insert because Lua's `{a, nil, b}` literal is sparse; would drop
-- whichever entry is nil and silently shift the rest, omitting later filters.
function Events.makeHitParams(pData)
	local p = RaycastParams.new()
	p.FilterType = Enum.RaycastFilterType.Exclude
	local filter = {}
	if pData.VisualPart then table.insert(filter, pData.VisualPart) end
	if pData._sourceItem then table.insert(filter, pData._sourceItem) end
	if pData._sourceItem then
		local rt = pData._sourceItem:FindFirstChild("RenderTemplate")
		if rt then table.insert(filter, rt) end
		-- EmitParent ObjectValue: filter the picked anchor + its descendants so the
		-- first afterUpdate raycast doesn't fire OnHit on the user's emission anchor.
		local ep = pData._sourceItem:FindFirstChild("EmitParent")
		if ep and ep:IsA("ObjectValue") and ep.Value then
			table.insert(filter, ep.Value)
		end
	end
	-- Attachments self-hit on first ray without filtering parent BasePart.
	if pData.VisualPart and pData.VisualPart:IsA("Attachment") and pData.VisualPart.Parent then
		table.insert(filter, pData.VisualPart.Parent)
	end
	-- User-configured OnHit filters from the source's per-event cfg. Read once at
	-- emit time (not on heartbeat), so mid-session edits apply to the next emit
	-- cycle. Missing cfg / missing attrs / missing folder all read as "no filter".
	if pData._sourceItem then
		local cfg = EventsSchema.readEvent(pData._sourceItem, "OnHit")
		if cfg then
			local group = cfg:GetAttribute("CollisionGroup")
			if type(group) == "string" and group ~= "" then
				-- pcall guards against the user deleting the group in Studio's collision
				-- editor between cfg-write and this read; the raycast falls back to
				-- "no group" behavior instead of erroring out per particle.
				pcall(function() p.CollisionGroup = group end)
			end
			local excludeFolder = cfg:FindFirstChild("ExcludeList")
			if excludeFolder then
				for _, child in ipairs(excludeFolder:GetChildren()) do
					if child:IsA("ObjectValue") and child.Value then
						table.insert(filter, child.Value)
					end
				end
			end
		end
	end
	p.FilterDescendantsInstances = filter
	p.IgnoreWater = true
	return p
end

-- Payload builder. Thin wrapper; per-event field population lives in EventsPayload.build.
function Events.makePayload(particle, pData, eventName, emitCtx)
	return EventsPayload.build(pData, eventName, emitCtx, Events.getWorldCF(pData))
end

-- EmitMode + dispatch

-- Push OnHit spawn off the hit surface along its normal so the emitted particle's first
-- raycast doesn't immediately re-fire OnHit on the same surface.
local ONHIT_SPAWN_NORMAL_OFFSET = 0.1

-- Resolve origin CF for non-AtTarget modes (AtPosition / AtSource / AtCFrame).
-- OnEmit uses LIVE source position so EmitDelay-gapped emits track movement.
-- OnHit: offset along payload.HitNormal so spawn is just outside the surface.
function Events.resolveEmitModeCF(mode, payload, pData)
	if mode == "AtPosition" then
		if payload and payload._eventName == "OnEmit" then
			local cf = Events.getWorldCF(pData)
			if cf then return cf end
			-- Source destroyed mid-EmitDelay; fall back to last-frame CurrentPosition.
			if pData.CurrentPosition then return CFrame.new(pData.CurrentPosition) end
		end
		local pos = payload.HitPosition or payload.DeathPosition or payload.EmitPosition
		if pos and payload._eventName == "OnHit" and payload.HitNormal then
			pos = pos + payload.HitNormal * ONHIT_SPAWN_NORMAL_OFFSET
		end
		return pos and CFrame.new(pos) or nil
	elseif mode == "AtSource" then
		return Events.getSourceWorldCF(pData._sourceItem)
	elseif mode == "AtCFrame" then
		if payload and payload._eventName == "OnEmit" then
			local cf = Events.getWorldCF(pData)
			if cf then return cf end
		end
		local cf = payload and payload.WorldCFrame
		if cf and payload._eventName == "OnHit" and payload.HitNormal then
			cf = cf + payload.HitNormal * ONHIT_SPAWN_NORMAL_OFFSET
		end
		return cf or nil
	end
	return nil
end

function Events._supportsOriginOverride(target)
	return target:IsA("BasePart") or target:IsA("Attachment") or target:IsA("Model")
end

-- Build a holder BasePart with the standard isolated-emit-clone properties.
-- Used to host a cloned ParticleEmitter or Attachment when the source isn't itself a BasePart/Model.
local function _newHolderPart()
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Transparency = 1
	p.Size = Vector3.new(0.001, 0.001, 0.001)
	p.Archivable = false
	return p
end

-- Anchor every BasePart descendant of a clone so it doesn't drift / fall in workspace.Terrain.
local function _anchorClone(root)
	if root:IsA("BasePart") then root.Anchored = true end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then d.Anchored = true end
	end
end

-- Position the clone root at originCF. Model → :PivotTo (whole descendant tree);
-- BasePart → .CFrame; Attachment → .WorldCFrame (requires BasePart parent to be set first).
local function _positionClone(root, originCF)
	if root:IsA("Model") then
		root:PivotTo(originCF)
	elseif root:IsA("BasePart") then
		root.CFrame = originCF
	elseif root:IsA("Attachment") then
		root.WorldCFrame = originCF
	end
end

-- Shared persistent holder Part inside the live emit folder. Bare-Attachment EmitTarget
-- clones parent to this single BasePart and write .WorldCFrame directly  -  no per-fire
-- holder Part created. The holder is anchored at origin, invisible, untouched after creation.
local function _getAttachmentHolder(particle)
	local pooled = particle:GetFolder()
	local h = pooled:FindFirstChild("_AttachmentHolder")
	if h then return h end
	h = _newHolderPart()
	h.Name = "_AttachmentHolder"
	h.CFrame = CFrame.new()
	h.Parent = pooled
	return h
end

-- Pool integration helpers ---------------------------------------------------------------
-- Stamp the authored Enabled state on every PE/Trail descendant of a fresh clone. The pool
-- forces Enabled=false on release (so a returned clone doesn't keep emitting from the pool
-- folder) and restores from this attribute on acquire  -  preserves authored Enabled=true
-- behavior across pool cycles.
local function _stampAuthoredEnabled(root)
	local function visit(inst)
		if inst:IsA("ParticleEmitter") or inst:IsA("Trail") then
			pcall(function() inst:SetAttribute("_PartIcleAuthoredEnabled", inst.Enabled) end)
		end
	end
	visit(root)
	for _, d in ipairs(root:GetDescendants()) do visit(d) end
end

-- Restore Enabled from the stamped attribute after Pool.acquire returns a cached clone.
-- Missing attribute → defaults to false (safer than true; no runaway emission).
local function _restoreAuthoredEnabled(root)
	local function visit(inst)
		if inst:IsA("ParticleEmitter") or inst:IsA("Trail") then
			local v = inst:GetAttribute("_PartIcleAuthoredEnabled")
			pcall(function() inst.Enabled = v == true end)
		end
	end
	visit(root)
	for _, d in ipairs(root:GetDescendants()) do visit(d) end
end

-- Disable every PE/Trail descendant before releasing the clone. Prevents the pool folder
-- from showing live emission. PoolHide.hide also handles Trail.Enabled for the Part/Model
-- kinds via its own snapshot; this is additive and idempotent.
local function _killEmittersForRelease(root)
	local function visit(inst)
		if inst:IsA("ParticleEmitter") or inst:IsA("Trail") then
			pcall(function() inst.Enabled = false end)
		end
	end
	visit(root)
	for _, d in ipairs(root:GetDescendants()) do visit(d) end
end

-- Map an EmitTarget instance to the PoolHide kind that matches its _buildEmitClone wrapper.
-- Folder + PE both route to BasePart-style hiding because their wrappers ARE BaseParts
-- (Model wrapper for Folder, holder Part for PE).
local function _kindFor(target)
	if target:IsA("BasePart") then return "Part" end
	if target:IsA("Model") then return "Model" end
	if target:IsA("Folder") then return "Model" end
	if target:IsA("Attachment") then return "Attachment" end
	if target:IsA("ParticleEmitter") then return "Part" end
	return "Part"
end

-- Sum the worst-case emit window over every PE / Trail in the clone. emitDelay+emitDuration
-- covers spawn span; Lifetime.Max covers the visual tail after the last spawn. 2s floor.
local function _computeCloneLifetime(root)
	local maxWindow = 2
	local function visit(inst)
		if inst:IsA("ParticleEmitter") then
			local emitDelay = tonumber(inst:GetAttribute("EmitDelay")) or 0
			local emitDuration = tonumber(inst:GetAttribute("EmitDuration")) or 0
			local lifeMax = 2
			pcall(function() lifeMax = math.max(lifeMax, inst.Lifetime.Max) end)
			local total = emitDelay + emitDuration + lifeMax + 0.5
			if total > maxWindow then maxWindow = total end
		elseif inst:IsA("Trail") then
			local emitDuration = tonumber(inst:GetAttribute("EmitDuration")) or 0
			local lifeT = 2
			pcall(function() lifeT = math.max(lifeT, inst.Lifetime) end)
			local total = emitDuration + lifeT + 0.5
			if total > maxWindow then maxWindow = total end
		end
	end
	visit(root)
	for _, d in ipairs(root:GetDescendants()) do visit(d) end
	-- Ceiling: pathological authored Lifetimes (e.g. 1e6) would otherwise hold the clone in
	-- the live folder until session end. Spawned particles continue independently of the holder.
	if maxWindow > 600 then maxWindow = 600 end
	return maxWindow
end

-- Build the clone root for a given EmitTarget. One holder per fire  -  regardless of how many
-- PE/Trail/Attachment descendants the target has. AbsoluteEmit on the returned root walks
-- the cloned subtree itself, firing every descendant emitter.
--
-- target type → wrapper:
--   BasePart    → clone:Clone() (positions via .CFrame; descendants follow as siblings)
--   Model       → clone:Clone() (positions via :PivotTo; affects all descendant BaseParts)
--   Folder      → Model wrapper containing cloned Folder (Folder lacks CFrame; Model:PivotTo
--                 affects descendant BaseParts inside the cloned Folder)
--   Attachment  → holder Part containing cloned Attachment (Attachment needs BasePart parent)
--   ParticleEmitter → holder Part containing cloned PE (PE needs BasePart/Attachment parent)
local function _buildEmitClone(target)
	local root
	if target:IsA("BasePart") then
		root = target:Clone()
		root.Archivable = false
	elseif target:IsA("Model") then
		-- Trusts source Model.WorldPivot as the authored anchor. If user authored WorldPivot
		-- offset from their BaseParts, the prefab fires offset by design  -  Model is user-authored,
		-- only the Folder branch (synthetic wrapper) stamps WorldPivot itself.
		root = target:Clone()
		root.Archivable = false
	elseif target:IsA("Folder") then
		local wrapper = Instance.new("Model")
		wrapper.Archivable = false
		local folderClone = target:Clone()
		folderClone.Archivable = false
		folderClone.Parent = wrapper
		-- Pivot wrapper at the first cloned BasePart's authored POSITION (not full CFrame) so
		-- PivotTo(originCF) lands that anchor at originCF without picking up the BasePart's
		-- authored rotation. AtCFrame mode applies originCF's rotation directly; AtPosition
		-- preserves the prefab's authored sibling layout. Skip ForgeConverter's synthetic
		-- anchor stubs (`_isAnchor` attribute)  -  they sit at origin and would shift the
		-- pivot away from authored emitter offsets when picked first by descendant order.
		for _, d in ipairs(folderClone:GetDescendants()) do
			if d:IsA("BasePart") and not d:GetAttribute("_isAnchor") then
				wrapper.WorldPivot = CFrame.new(d.Position)
				break
			end
		end
		root = wrapper
	elseif target:IsA("Attachment") then
		-- No per-fire holder Part. Caller parents the clone to the shared _AttachmentHolder
		-- inside the live folder and writes .WorldCFrame directly.
		root = target:Clone()
	elseif target:IsA("ParticleEmitter") then
		local holder = _newHolderPart()
		-- Inherit source parent BasePart's Size so PE.Shape="Box" emission preserves authored area.
		-- Holder.Transparency stays 1 (from _newHolderPart)  -  invisible regardless of size.
		if target.Parent and target.Parent:IsA("BasePart") then
			pcall(function() holder.Size = target.Parent.Size end)
		end
		local peClone = target:Clone()
		peClone.Parent = holder
		root = holder
	end
	if root then
		_stampAuthoredEnabled(root)
		-- Stamp `_PartIcleEmit` so init.luau's workspace sweep catches the clone at Deactivate
		-- even if the user reparented it out of the live folder mid-emit. Mirror of the same
		-- attribute Pool.acquireOrClone stamps on regular-emit clones (Pool.luau:216).
		pcall(function() root:SetAttribute("_PartIcleEmit", true) end)
	end
	return root
end

-- depthLimit owned by source event's cfg; target's own cap re-checks at its own fire.
-- Origin-override path for a Transformed Part-Icle item. Uses the engine's EnableEmitAt
-- so the firing particle's session tracks the emit, instead of spawning an independent
-- clone session  -  applies only when EmitTarget IS a Transformed item directly.
function Events._emitTransformed(particle, target, mode, payload, pData, chainCtx, depthLimit)
	chainCtx = chainCtx or Events.newChainCtx()
	depthLimit = depthLimit or DEFAULT_CHAIN_DEPTH_LIMIT
	local nextDepth = chainCtx.Depth + 1
	-- `>=` so limit=1 means "no nested emits" (drops first nested at nextDepth=1).
	if nextDepth >= depthLimit then
		Events.dropDepth(payload and payload._eventName)
		return
	end
	local subCtx = { ChainId = chainCtx.ChainId, Depth = nextDepth }
	local subEmitCtx = { ChainCtx = subCtx }

	if mode == "AtTarget" then
		particle:EnableEmit(target, nil, subEmitCtx)
		return
	end

	if not Events._supportsOriginOverride(target) then
		local key = tostring(mode) .. ":" .. target.ClassName
		if not _unsupportedOriginWarned[key] then
			_unsupportedOriginWarned[key] = true
			warn(("[Part-Icles Events] transformed %s target requires EmitMode=AtTarget"):format(target.ClassName))
		end
		return
	end

	local originCF = Events.resolveEmitModeCF(mode, payload, pData)
	if not originCF then
		local key = tostring(mode) .. ":" .. tostring(payload and payload._eventName)
		if not _nilOriginWarned[key] then
			_nilOriginWarned[key] = true
			warn(("[Part-Icles Events] EmitMode %q has no resolvable origin (payload position nil)"):format(tostring(mode)))
		end
		return
	end
	if not particle.EnableEmitAt then
		warn("[Part-Icles Events] EnableEmitAt missing on particle; skipped origin-override emit")
		return
	end
	-- Resolver re-runs at spawn time (after target's EmitDelay) so OnEmit AtPosition tracks live.
	local function originResolver()
		return Events.resolveEmitModeCF(mode, payload, pData) or originCF
	end
	local useFullOrigin = (mode == "AtCFrame")
	particle:EnableEmitAt(target, originCF, {
		IgnoreLink = true,
		ChainCtx = subCtx,
		OriginResolver = originResolver,
		UseFullOrigin = useFullOrigin,
	})
end

-- EmitTarget dispatcher. Single-shot for native fan-out: clone the outermost container ONCE,
-- position it, AbsoluteEmit on the clone. AbsoluteEmit recurses through the cloned subtree
-- and fires every PE/Trail descendant from its correct relative position (layout preserved
-- automatically via the parent transform  -  no per-child offset math needed).
--
-- Path selection:
--   • mode == AtTarget or nil, or target is Trail   → AbsoluteEmit on original (no clone, no override)
--   • target IS Transformed (a Part-Icle item)      → _emitTransformed (engine session path)
--   • everything else (native container, PE, etc.)  → clone outermost, position, fire, destroy
function Events.emitTargetInstance(particle, target, mode, payload, pData, chainCtx, depthLimit)
	if not target or not target.Parent then return end

	if mode == nil or mode == "AtTarget" or target:IsA("Trail") then
		if target:GetAttribute("Transformed") then
			Events._emitTransformed(particle, target, mode, payload, pData, chainCtx, depthLimit)
		else
			pcall(function() particle:AbsoluteEmit(target, false, { ChainCtx = chainCtx }) end)
		end
		return
	end

	if target:GetAttribute("Transformed") then
		Events._emitTransformed(particle, target, mode, payload, pData, chainCtx, depthLimit)
		return
	end

	local originCF = Events.resolveEmitModeCF(mode, payload, pData)
	if not originCF then
		pcall(function() particle:AbsoluteEmit(target, false, { ChainCtx = chainCtx }) end)
		return
	end

	-- Pool acquire (cached clone) → fall back to fresh _buildEmitClone on miss.
	local kind = _kindFor(target)
	local cloneRoot = Pool.acquire(target, kind)
	local isFreshClone = false
	if not cloneRoot then
		cloneRoot = _buildEmitClone(target)
		if not cloneRoot then
			pcall(function() particle:AbsoluteEmit(target, false, { ChainCtx = chainCtx }) end)
			return
		end
		isFreshClone = true
	end
	-- Restore authored Enabled state on cached clones (release forced it false to silence
	-- the pool folder). Fresh clones already have authored Enabled from :Clone().
	if not isFreshClone then
		_restoreAuthoredEnabled(cloneRoot)
	end

	if cloneRoot:IsA("Attachment") then
		-- Parent FIRST: WorldCFrame setter relies on parent BasePart's CFrame for the
		-- inverse-transform math. Setting WorldCFrame on an unparented Attachment is a no-op
		-- (or fall-through to local CFrame, depending on engine state).
		cloneRoot.Parent = _getAttachmentHolder(particle)
		cloneRoot.WorldCFrame = originCF
	else
		_anchorClone(cloneRoot)
		_positionClone(cloneRoot, originCF)
		cloneRoot.Parent = particle:GetFolder()
		-- Re-pivot after parenting: PivotTo before Parent set is allowed but Studio renderer
		-- occasionally caches stale pre-parent pose for one frame. Re-applying is cheap insurance.
		_positionClone(cloneRoot, originCF)
	end

	-- Delegate to AbsoluteEmitAt with SkipClone so transformed Part-Icles nested
	-- inside the cloneRoot pick up per-node origin override (Pass 1's
	-- `originCF * anchor:ToObjectSpace(node.CFrame)` math). Caller owns cloneRoot
	-- lifecycle (pool acquire/release below); SkipClone short-circuits the clone +
	-- destroy block inside AbsoluteEmitAt. Per-mode option defaults mirror the
	-- prior manual positioning behavior (AtPosition = position-only, AtCFrame =
	-- full pose; both detach authored Link per the event-spawn convention).
	local emitOptions = {
		ChainCtx      = chainCtx,
		UseFullOrigin = (mode == "AtCFrame"),
		IgnoreLink    = (mode == "AtPosition" or mode == "AtCFrame"),
		SkipClone     = true,
	}
	pcall(function() particle:AbsoluteEmitAt(cloneRoot, originCF, emitOptions) end)

	-- Release back to pool after the worst-case emit window. Kill in-flight emission first
	-- so the cached clone is silent in the pool folder until next acquire.
	local lifetime = _computeCloneLifetime(cloneRoot)
	task.delay(lifetime, function()
		if not cloneRoot.Parent then return end
		_killEmittersForRelease(cloneRoot)
		Pool.release(cloneRoot, target, kind, nil)
	end)
end

-- Fire dispatcher

function Events.fire(particle, pData, eventName, chainCtx, payload)
	chainCtx = chainCtx or Events.newChainCtx()
	local cfg = pData.Events and pData.Events[eventName]
	-- Enabled gate first; disabled events don't burn depth budget or warn.
	if not cfg or not cfg.Enabled then return end

	-- Two depth checks: fire-side (this event) and _emitTransformed-side (downstream fan-out).
	local depthLimit = math.clamp(math.floor(tonumber(cfg.ChainDepthLimit) or DEFAULT_CHAIN_DEPTH_LIMIT), 1, HARD_CHAIN_DEPTH_CEILING)
	if chainCtx.Depth >= depthLimit then
		Events.dropDepth(eventName)
		return
	end

	-- Nothing wired → no dispatch.
	if not cfg.EmitTarget and not cfg.Module then return end

	-- Backfill payload first so payload.X writes below don't nil-index.
	if not payload then
		payload = Events.makePayload(particle, pData, eventName, nil)
	end
	payload._eventName = payload._eventName or eventName

	-- Burst cap after config check.
	if not Events.reserveFrameFire() then return end

	payload.Source = payload.Source or pData._sourceItem
	payload.Particle = payload.Particle or pData.VisualPart
	payload.RenderTemplate = payload.RenderTemplate or payload.Particle

	-- Inject helpers only when Module runs (avoid closure alloc for EmitTarget-only events).
	if cfg.Module then
		payload.Emit = function(target, mode)
			Events.emitTargetInstance(particle, target, mode or cfg.EmitMode, payload, pData, chainCtx, depthLimit)
		end
		payload.Kill = function()
			if particle._killParticle then
				particle:_killParticle(pData, { fireOnDeath = false })
			end
		end
		-- Setters auto-flip the matching skip flag so per-frame graph writes don't clobber the override.
		EventsPayload.attachSkipSetters(payload, pData)
		payload.SetColor = function(color) EventsPayload.applyColor(pData, color) end
		payload.SetTransparency = function(amount) EventsPayload.applyTransparency(pData, amount) end
		payload.Teleport = function(cf) EventsPayload.applyTeleport(pData, cf) end
		EventsPayload.attachAdvancedSetters(payload, pData)
		payload.SetSpeedMultiplier = function(scalar)
			if type(scalar) == "number" then pData.SpeedMultiplier = scalar end
		end
		-- New total LifeTime in seconds. Clamped to 0.001 to avoid div-by-zero in
		-- the real_i (currentTime - StartTime) / LifeTime computation.
		payload.SetLifetime = function(seconds)
			if type(seconds) == "number" then pData.LifeTime = math.max(0.001, seconds) end
		end
	end

	-- Active-particle cap: skip cfg.EmitTarget when at cap, but always run Module.
	local capHit = #particle.ActiveEmits + (particle._lingerVisualCount or 0) >= (particle.MAX_ACTIVE_PARTICLES or 1000)

	if cfg.EmitTarget and not capHit then
		Events.emitTargetInstance(particle, cfg.EmitTarget, cfg.EmitMode, payload, pData, chainCtx, depthLimit)
	end

	if cfg.Module then
		local fn = Events.compile(cfg.Module)
		if fn then
			task.spawn(function()
				local ok, err = xpcall(fn, debug.traceback, payload)
				if not ok then Events.reportScriptError(cfg.Module, err) end
			end)
		end
	end
end

-- OnHit per-frame hook

-- Min displacement for a raycast; filters ReapplyLink / Orientation jitter.
local HIT_MIN_DIST = 0.05

-- Per-frame OnHit raycast. _hitFired stays sticky on Stop / re-arms on clean miss.
-- Reverse Timescale suppresses OnHit but updates LastHitCheckPos so forward resume gets a fresh segment.
function Events.afterUpdate(particle, pData, isDead, currentTime)
	if not pData.Events or not pData.Events.OnHit then return end
	if pData._lastEffectiveDt and pData._lastEffectiveDt < 0 then
		pData.LastHitCheckPos = Events.getWorldPosition(pData)
		pData.LastHitCheckTime = currentTime
		return
	end
	local newPos = Events.getWorldPosition(pData)
	if not newPos then return end
	if not pData.LastHitCheckPos then
		pData.LastHitCheckPos = newPos
		pData.LastHitCheckTime = currentTime
		return
	end

	-- HitCheckInterval throttle; LastHitCheckPos pins so segment grows during skip window.
	local interval = pData.Events.OnHit.HitCheckInterval or 0
	if interval > 0 then
		local lastT = pData.LastHitCheckTime or 0
		if currentTime - lastT < interval then return end
	end

	local prevPos = pData.LastHitCheckPos
	local prevTime = pData.LastHitCheckTime or currentTime
	local segmentDT = currentTime - prevTime
	if segmentDT <= 0 then segmentDT = 1/60 end
	local dir = newPos - prevPos
	if dir.Magnitude > HIT_MIN_DIST then
		local hit = workspace:Raycast(prevPos, dir, pData.HitParams)
		if hit then
			if not pData._hitFired then
				local payload = Events.makePayload(particle, pData, "OnHit", nil)
				payload.HitInstance = hit.Instance
				payload.Other = hit.Instance
				payload.HitPosition = hit.Position
				payload.HitNormal = hit.Normal
				Events.fire(particle, pData, "OnHit", pData.EventChainCtx, payload)

				-- "snap" → helper updated LastHitCheckPos, caller returns. "off" → caller continues.
				if EventsCollision.handle(particle, pData, hit, dir, segmentDT) == "snap" then return end
			end
		else
			-- Clean miss → particle has cleared the previous surface. Re-arm so the next
			-- surface contact can fire OnHit again (Off-mode per-collision behavior).
			-- Stop mode keeps `_hitFired` sticky via `_collisionStopped` so a link-moved
			-- frozen particle doesn't re-fire after being explicitly halted.
			if not pData._collisionStopped then
				pData._hitFired = false
			end
		end
		pData.LastHitCheckPos = newPos
		pData.LastHitCheckTime = currentTime
	end
end

return Events
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">EventsCollision</string>
              <string name="Source"><![CDATA[--[[
	EventsCollision  -  OnHit collision modes (Off / Kill / Stop / Bounce) for Part / Attachment / Model.
	Bounce splits velocity into normal+tangent w.r.t. hit.Normal, restitutes (Bounciness),
	damps tangent (Friction), kicks angular velocity from nrm×v_t (Spin) for forward-roll feel.
	Cross-file: Update / UpdateModel must integrate SpeedMultiplier + _spinRate each frame.
]]

local Constants = require(script.Parent.PartConstants)
local GraphMod = require(script.Parent.Graph)

local EventsCollision = {}

-- Pre-bounce vMag (studs/sec) gate. Below this engages _settleEngaged + scales
-- bounce-spin damping toward zero (rolling-friction proxy).
local REST_VELOCITY_THRESHOLD = 1.0

-- Restitution clamp (Jolt mMinVelocityForRestitution / Box2D b2_velocityThreshold).
-- Below this, e := 0  -  inelastic. Breaks Zeno micro-bouncing.
local MIN_REST_VELOCITY = 0.5

-- Point-velocity (linear + |spinRate|·radius) below this advances _restTimer.
-- Jolt mPointVelocitySleepThreshold = 0.03 m/s, scaled to stud units.
local SLEEP_VELOCITY_THRESHOLD = 0.1

-- Rest-timer threshold for permanent freeze. Matches Box2D + Jolt 0.5s default.
local TIME_BEFORE_SLEEP = 0.5

-- Angular damping (1/sec) on _spinRate while settling. Half-life ≈ 0.116s.
local ANGULAR_REST_DRAG = 6.0

-- Damp authored RotSpeedX/Y/Z graph contribution to zero during settle. Without
-- this, settled body keeps rotating from RotMode=OverLife / RotMode=Speed grids.
local ROT_GRAPH_DAMP = 6.0

-- Per-particle ±range jitter (width fraction; 0.4 = ±20%) on bounce + settle
-- params. Decorrelates same-burst particles so bounce count + settle time
-- vary naturally instead of all particles converging in lockstep.
local BOUNCINESS_JITTER_RANGE = 0.4
local FRICTION_JITTER_RANGE = 0.4
local REST_CLAMP_JITTER_RANGE = 0.4
local SLEEP_TIME_JITTER_RANGE = 0.4

-- Gravity-torque gain: τ = sin(tilt)·|g|·GAIN. 0.5 → ~70 deg/sec² at 45° + default gravity.
local TIPPING_GAIN = 0.5

-- Permanent-freeze thresholds (both must hold): spin deg/sec, tilt radians.
local SPIN_FREEZE_EPSILON = 0.5
local ANGLE_FREEZE_EPSILON = 0.02

-- Body-local axes scanned for face-down orientation (the six box faces).
local _BODY_AXES = {
	Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0),
	Vector3.new(0, 1, 0), Vector3.new(0, -1, 0),
	Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
}

-- Hit history for negative-Timescale reverse. Newest-keep ring: reverse playback
-- always crosses recent hits first, so dropping the oldest preserves rewind
-- fidelity for the most recent HIT_HISTORY_CAP collisions.
local HIT_HISTORY_CAP = 16

local function _snapshotPData(pData, kind)
	return {
		time = pData._effectiveElapsed or 0,
		kind = kind,
		BaseDirection = pData.BaseDirection,
		SpeedMultiplier = pData.SpeedMultiplier,
		_accelVel = pData._accelVel,
		TargetVel = pData.TargetVel,
		_spinRate = pData._spinRate,
		_spinAccumX = pData._spinAccumX,
		_spinAccumY = pData._spinAccumY,
		_spinAccumZ = pData._spinAccumZ,
		AccRotX = pData.AccRotX,
		AccRotY = pData.AccRotY,
		AccRotZ = pData.AccRotZ,
		LocalCF = pData.LocalCF,
		_localWorldCF = pData._localWorldCF,
		CurrentPosition = pData.CurrentPosition,
		_hitFired = pData._hitFired,
		LastHitCheckPos = pData.LastHitCheckPos,
		_collisionStopped = pData._collisionStopped,
		CurrentStep = pData.CurrentStep,
		AccumulatedDT = pData.AccumulatedDT,
		-- PosOffset bounce reflection: mirror axes (nil pre-first-bounce) + the
		-- delta-accumulation baseline _prevWorldOff. Both flip on Bounce; both must
		-- restore on reverse-Timescale rewind across the hit boundary.
		_displacementMirrorX = pData._displacementMirrorX,
		_displacementMirrorY = pData._displacementMirrorY,
		_displacementMirrorZ = pData._displacementMirrorZ,
		_prevWorldOff = pData._prevWorldOff,
		-- Settle state flag + rest-timer accumulator (Box2D/Jolt sleep pattern).
		-- Both restore on reverse-Timescale rewind so the body un-settles cleanly.
		_settleEngaged = pData._settleEngaged,
		_restTimer = pData._restTimer,
		_settleRotDamp = pData._settleRotDamp,
		_settleContactPos = pData._settleContactPos,
		_settleSpawnHalf = pData._settleSpawnHalf,
		-- Last surface normal  -  gravity-torque target reference for tip math.
		_lastHitNormal = pData._lastHitNormal,
	}
end

local function _pushHit(pData, snap)
	pData._hitHistory = pData._hitHistory or {}
	-- Drop oldest when full so the newest hit is always recorded.
	if #pData._hitHistory >= HIT_HISTORY_CAP then
		table.remove(pData._hitHistory, 1)
	end
	table.insert(pData._hitHistory, snap)
end

-- Called by Update when dt < 0; iterates back-to-front so earliest crossed hit wins.
function EventsCollision.restoreHitsOnReverse(pData, priorEff, newEff)
	local history = pData._hitHistory
	if not history then return end
	for i = #history, 1, -1 do
		local h = history[i]
		if h.time > newEff and h.time <= priorEff then
			pData.BaseDirection = h.BaseDirection
			pData.SpeedMultiplier = h.SpeedMultiplier
			pData._accelVel = h._accelVel
			pData.TargetVel = h.TargetVel
			pData._spinRate = h._spinRate
			pData._spinAccumX = h._spinAccumX
			pData._spinAccumY = h._spinAccumY
			pData._spinAccumZ = h._spinAccumZ
			pData.AccRotX = h.AccRotX
			pData.AccRotY = h.AccRotY
			pData.AccRotZ = h.AccRotZ
			pData.LocalCF = h.LocalCF
			pData._localWorldCF = h._localWorldCF
			pData.CurrentPosition = h.CurrentPosition
			pData._hitFired = h._hitFired
			pData.LastHitCheckPos = h.LastHitCheckPos
			pData._collisionStopped = h._collisionStopped
			pData.CurrentStep = h.CurrentStep
			pData.AccumulatedDT = h.AccumulatedDT
			pData._displacementMirrorX = h._displacementMirrorX
			pData._displacementMirrorY = h._displacementMirrorY
			pData._displacementMirrorZ = h._displacementMirrorZ
			pData._prevWorldOff = h._prevWorldOff
			pData._settleEngaged = h._settleEngaged
			pData._restTimer = h._restTimer
			pData._settleRotDamp = h._settleRotDamp
			pData._settleContactPos = h._settleContactPos
			pData._settleSpawnHalf = h._settleSpawnHalf
			pData._lastHitNormal = h._lastHitNormal
			table.remove(history, i)
		end
	end
end

-- Per-type write: BasePart .CFrame, Model :PivotTo, Attachment world→parent-local.
local function applySnapCFrame(pData, snapCF)
	local v = pData.VisualPart
	if not v or not v.Parent then return end
	if pData.Type == "Model" then v:PivotTo(snapCF); return end
	if pData.Type == "Attachment" then
		local parent = v.Parent
		v.CFrame = (parent and parent:IsA("BasePart")) and parent.CFrame:ToObjectSpace(snapCF) or snapCF
		return
	end
	v.CFrame = snapCF
end

-- World CFrame read: Model = pivot, Attachment = parent*local.
local function readWorldCF(pData)
	local v = pData.VisualPart
	if not v or not v.Parent then return CFrame.new() end
	if pData.Type == "Model" then return v:GetPivot() end
	if pData.Type == "Attachment" then
		local p = v.Parent
		return (p and p:IsA("BasePart")) and (p.CFrame * v.CFrame) or v.CFrame
	end
	return v.CFrame
end

-- Parent-link world CFrame for Part/Model bounce LocalCF rebuild.
local function bounceParentCF(pData)
	local link = pData.Link
	if not link or not link.Parent then return CFrame.new() end
	local lCF = Constants.resolveLinkCFrame(link)
	if not lCF then return CFrame.new() end
	if pData.LinkMode == "Follow" or pData.LinkMode == "Pivot" then
		return CFrame.new(lCF.Position)
	end
	return lCF
end

-- Attachment LocalCF lives in parentCF_now (actualParent-local); convert snap via actualParent first.
local function attachmentBounceLocalPos(pData, snapPos)
	local visualAtt = pData.VisualPart
	local actualParent = visualAtt and visualAtt.Parent
	local convCF = (actualParent and actualParent:IsA("BasePart")) and actualParent.CFrame or CFrame.new()
	local link = pData.Link
	local parentCF_now
	if link and link.Parent then
		local linkWorldCF = Constants.resolveLinkCFrame(link)
		local linkLocalCF = convCF:ToObjectSpace(linkWorldCF)
		if pData.LinkMode == "Follow" or pData.LinkMode == "Pivot" then
			parentCF_now = CFrame.new(linkLocalCF.Position)
		else
			parentCF_now = linkLocalCF
		end
	else
		parentCF_now = CFrame.new()
	end
	local snapInActualParent = convCF:PointToObjectSpace(snapPos)
	return parentCF_now:PointToObjectSpace(snapInActualParent)
end

-- Snap to hit.Position keeping current rotation. Kill = destroy. Stop = freeze + age out.
-- Stop snapshots pData first for reverse-Timescale restore; Kill doesn't.
local function handleKillOrStop(particle, pData, hit, mode)
	local stopSnap = (mode ~= "Kill") and _snapshotPData(pData, "Stop") or nil
	local existing = readWorldCF(pData)
	local snapCF = CFrame.new(hit.Position) * (existing - existing.Position)
	applySnapCFrame(pData, snapCF)
	pData.CurrentPosition = hit.Position
	if mode == "Kill" then
		if particle._killParticle then
			particle:_killParticle(pData, { fireOnDeath = true })
		end
	else
		-- Sync companion CFrame caches with the snap so next Heartbeat's ReapplyLink (LinkTrack)
		-- and ApplyOrientation (Orientation) reads don't pull the particle back to pre-stop pos.
		if pData.LocalCF then
			local localPos
			if pData.Type == "Attachment" then
				localPos = attachmentBounceLocalPos(pData, hit.Position)
			else
				localPos = bounceParentCF(pData):PointToObjectSpace(hit.Position)
			end
			pData.LocalCF = CFrame.new(localPos) * (pData.LocalCF - pData.LocalCF.Position)
			pData._localWorldCF = pData.LocalCF
		end
		pData._postUpdateCF = snapCF
		pData._collisionStopped = true
		pData.LastHitCheckPos = hit.Position
		pData._hitFired = true
		if stopSnap then _pushHit(pData, stopSnap) end
	end
end

-- Split V into normal+tangent, restitute (-e*V_n), damp ((1-μ)*V_t). Magnitude folds into
-- SpeedMultiplier (BaseDirection stays unit). _accelVel + TargetVel are absolute, no rescale.
local function handleBounce(pData, hit, dir, segmentDT)
	local nrm = hit.Normal
	local oh = pData.Events.OnHit
	-- Lazy-init per-particle jitter on first bounce. Decorrelates same-burst particles
	-- so bounce count + settle time spread naturally instead of converging in lockstep.
	pData._bouncinessJitter = pData._bouncinessJitter or (1 + (math.random() - 0.5) * BOUNCINESS_JITTER_RANGE)
	pData._frictionJitter = pData._frictionJitter or (1 + (math.random() - 0.5) * FRICTION_JITTER_RANGE)
	pData._restClampJitter = pData._restClampJitter or (1 + (math.random() - 0.5) * REST_CLAMP_JITTER_RANGE)
	pData._sleepTimeJitter = pData._sleepTimeJitter or (1 + (math.random() - 0.5) * SLEEP_TIME_JITTER_RANGE)
	local e = (oh.Bounciness or 0.7) * pData._bouncinessJitter
	local mu = (oh.Friction or 0.2) * pData._frictionJitter
	local spinCoef = oh.Spin or 0.5
	if not segmentDT or segmentDT <= 0 then segmentDT = 1/60 end

	-- Snapshot pre-mutation for reverse-Timescale; pushed at function exit.
	local hitSnap = _snapshotPData(pData, "Bounce")

	-- Surface normal for applySettle's gravity-torque tip target. Most-recent wins.
	pData._lastHitNormal = nrm

	-- Restitution clamp (Jolt/Box2D pattern): below threshold, force inelastic
	-- (e=0) so low-velocity contacts can't trigger infinite micro-bounces.
	local v_normal_speed = math.abs((dir / segmentDT):Dot(nrm))
	local e_eff = e
	if v_normal_speed < MIN_REST_VELOCITY * (pData._restClampJitter or 1) then e_eff = 0 end

	local bd = pData.BaseDirection
	if bd then
		local bdN = bd:Dot(nrm) * nrm
		local bdT = bd - bdN
		local bdPost = -e_eff * bdN + (1 - mu) * bdT
		local mag = bdPost.Magnitude
		if mag > 1e-4 then
			pData.BaseDirection = bdPost.Unit
			pData.SpeedMultiplier = (pData.SpeedMultiplier or 1) * mag
		else
			-- bdPost ≈ 0 (e=0 perpendicular hit): stall linear motion; accel can still lift.
			pData.SpeedMultiplier = 0
		end
	end

	local av = pData._accelVel
	if av then
		local aN = av:Dot(nrm) * nrm
		local aT = av - aN
		pData._accelVel = -e_eff * aN + (1 - mu) * aT
	end

	local tv = pData.TargetVel
	if tv then
		local tN = tv:Dot(nrm) * nrm
		local tT = tv - tN
		pData.TargetVel = -e_eff * tN + (1 - mu) * tT
	end

	-- Angular kick from tangent velocity. Cross order nrm × v_t produces forward-roll
	-- (e.g. +X over +Y floor → -Z spin). restFactor scales damping toward 0 as
	-- pre-bounce speed approaches zero  -  rolling-friction proxy at rest.
	local existingSpin = pData._spinRate or Vector3.zero
	local v_t = (dir - dir:Dot(nrm) * nrm) / segmentDT
	local vMag = (dir / segmentDT).Magnitude
	local kick = Vector3.zero
	if v_t.Magnitude > 1e-4 then
		kick = nrm:Cross(v_t) * (spinCoef * 3.33)
	end
	local restFactor = math.min(1, vMag / REST_VELOCITY_THRESHOLD)
	pData._spinRate = existingSpin * (1 - mu) * restFactor + kick

	-- _settleEngaged sticks on first low-velocity bounce. Enables Coulomb contact
	-- constraint in PartConstants.applyContactAccel + gravity-torque tipping in
	-- applySettle. Cleared only by _clearSettleState (external mutator wake).
	if vMag < REST_VELOCITY_THRESHOLD then
		if not pData._settleEngaged then
			-- Cache surface contact point + initial half-extent so applySettle can
			-- keep the body's bottom face flush with the surface as Size shrinks
			-- (prevents floating-vanish when Size graph fades to 0).
			local visual = pData.VisualPart
			if visual and visual:IsA("BasePart") then
				local halfExtent = visual.Size.Magnitude * 0.5
				pData._settleSpawnHalf = halfExtent
				pData._settleContactPos = visual.Position - nrm * halfExtent
			end
		end
		pData._settleEngaged = true
	end

	-- PosOffset trajectory reflection: mirror each cached axis vector about hit.Normal
	-- so PosOffset-driven motion bounces off surfaces just like Speed-driven motion.
	-- Lazy-init at first bounce; nil mirror axes elsewhere skip the matrix-apply
	-- fast-path inside Constants.resolveDisplacement.
	if pData.HasPosOffsetGraphs then
		local function _reflect(v) return v - 2 * v:Dot(nrm) * nrm end
		local mx = pData._displacementMirrorX or Vector3.xAxis
		local my = pData._displacementMirrorY or Vector3.yAxis
		local mz = pData._displacementMirrorZ or Vector3.zAxis
		pData._displacementMirrorX = _reflect(mx)
		pData._displacementMirrorY = _reflect(my)
		pData._displacementMirrorZ = _reflect(mz)
		-- Re-baseline _prevWorldOff under the new mirror so the next per-frame delta
		-- (newWorldOff - _prevWorldOff) doesn't snap. Sample current PosOffset graphs
		-- and apply the freshly-updated mirror.
		local steppedI = (pData.CurrentStep or 0) / math.max(pData.TotalKeyFrames, 1)
		local oX = pData.Graphs.PosOffsetX and GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.PosOffsetX, pData.Seeds.PosOffsetX) or 0
		local oY = pData.Graphs.PosOffsetY and GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.PosOffsetY, pData.Seeds.PosOffsetY) or 0
		local oZ = pData.Graphs.PosOffsetZ and GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.PosOffsetZ, pData.Seeds.PosOffsetZ) or 0
		pData._prevWorldOff = Constants.resolveDisplacement(Vector3.new(oX, oY, oZ),
			pData.DisplacementMode or "Global", pData.SpawnRotation, pData.SpawnEmitterRotation,
			pData._displacementMirrorX, pData._displacementMirrorY, pData._displacementMirrorZ)
	end

	-- Offset along normal so next ray doesn't re-hit the same face.
	local snapPos = hit.Position + nrm * 0.05
	-- LocalCF position only; rotation gets re-composed on top by UpdatePart.
	if pData.LocalCF then
		local localPos
		if pData.Type == "Attachment" then
			localPos = attachmentBounceLocalPos(pData, snapPos)
		else
			localPos = bounceParentCF(pData):PointToObjectSpace(snapPos)
		end
		pData.LocalCF = CFrame.new(localPos) * (pData.LocalCF - pData.LocalCF.Position)
		pData._localWorldCF = pData.LocalCF
	end
	local existing = readWorldCF(pData)
	local snapCF = CFrame.new(snapPos) * (existing - existing.Position)
	applySnapCFrame(pData, snapCF)
	-- Mirror of handleKillOrStop: keep _postUpdateCF in sync so unlinked-particle Orientation
	-- pass doesn't snap the visual back to its pre-bounce CFrame next Heartbeat.
	pData._postUpdateCF = snapCF
	pData.CurrentPosition = snapPos
	pData.LastHitCheckPos = snapPos
	pData._hitFired = false

	_pushHit(pData, hitSnap)
end

-- Per-frame settle pass: spin decay, gravity-torque tip (τ ∝ sin(tilt)·|g| about
-- worldDown × hitNormal), size-sink, Box2D/Jolt rest-timer freeze.
function EventsCollision.applySettle(pData, dt)
	if not pData or pData._collisionStopped then return end
	if not pData._settleEngaged then return end
	if pData.NeedsFullIteration then return end
	if dt and dt > 0 then
		local decay = math.exp(-ANGULAR_REST_DRAG * dt)
		pData._spinRate = (pData._spinRate or Vector3.zero) * decay
		-- Authored RotSpeed graph contribution decays to zero in parallel.
		-- Update.luau reads pData._settleRotDamp at every RotSpeed sample site.
		pData._settleRotDamp = (pData._settleRotDamp or 1) * math.exp(-ROT_GRAPH_DAMP * dt)
	end
	local nrm = pData._lastHitNormal
	if not nrm or nrm.Magnitude < 1e-4 then return end
	local visual = pData.VisualPart
	if not visual or not visual.Parent then return end

	local currentCF = readWorldCF(pData)
	local down = -nrm
	local bestAxis = _BODY_AXES[1]
	local bestDot = -math.huge
	for _, ax in ipairs(_BODY_AXES) do
		local worldAx = currentCF:VectorToWorldSpace(ax)
		local d = worldAx:Dot(down)
		if d > bestDot then
			bestDot = d
			bestAxis = ax
		end
	end
	local worldDownAxis = currentCF:VectorToWorldSpace(bestAxis)
	local tiltAngle = math.acos(math.clamp(worldDownAxis:Dot(down), -1, 1))
	local torqueAxisRaw = worldDownAxis:Cross(down)
	if torqueAxisRaw.Magnitude > 1e-4 and tiltAngle > 1e-4 and dt and dt > 0 then
		-- Authored Acceleration is the gravity source. Zero-gravity emitters skip tipping
		-- (no torque), matching physical intuition.
		local accelVec = pData.Acceleration or Vector3.zero
		local gravityMag = accelVec.Magnitude
		if gravityMag > 1 then
			local torqueMag = math.sin(tiltAngle) * gravityMag * TIPPING_GAIN
			local torqueVec = torqueAxisRaw.Unit * torqueMag
			pData._spinRate = (pData._spinRate or Vector3.zero) + torqueVec * dt
		end
	end

	-- Size-sink: re-anchor CFrame.Position so the bottom face stays flush with
	-- the surface as Size shrinks (Roblox centers Part rendering on .Position).
	if pData._settleContactPos and pData._settleSpawnHalf and visual:IsA("BasePart") then
		local currentHalf = visual.Size.Magnitude * 0.5
		local newPos = pData._settleContactPos + nrm * currentHalf
		applySnapCFrame(pData, CFrame.new(newPos) * (currentCF - currentCF.Position))
	end

	-- Rest-timer accumulator (Box2D/Jolt sleep pattern). Point-velocity samples the
	-- bbox edge so rotation-induced motion blocks sleep, not just CoM stillness.
	local r = pData._sleepRadius or 1.0
	local spinMag = (pData._spinRate or Vector3.zero).Magnitude
	local angularPointVel = spinMag * r * (math.pi / 180)
	local linMag = math.abs(pData.SpeedMultiplier or 0) + (pData._accelVel or Vector3.zero).Magnitude
	local v_eff = linMag + angularPointVel
	if v_eff < SLEEP_VELOCITY_THRESHOLD then
		pData._restTimer = (pData._restTimer or 0) + dt
	else
		pData._restTimer = 0
	end
	if (pData._restTimer or 0) >= TIME_BEFORE_SLEEP * (pData._sleepTimeJitter or 1)
		and tiltAngle < ANGLE_FREEZE_EPSILON then
		pData._collisionStopped = true
		pData._spinRate = Vector3.zero
		pData._accelVel = Vector3.zero
		pData.SpeedMultiplier = 0
		pData.TargetVel = Vector3.zero
	end
end

-- "snap" → caller returns immediately. "off" → caller updates LastHitCheckPos.
-- Bounce + InvertMotion downgrades to Kill (cached SimLocalCFrames can't reflect mid-flight).
-- Animate-mode VisualPart is the live source; Kill/Stop/Bounce would corrupt it, so they downgrade to Off.
function EventsCollision.handle(particle, pData, hit, dir, segmentDT)
	local mode = pData.Events.OnHit.Collision or "Off"
	if mode == "Bounce" and pData.InvertMotion then mode = "Kill" end
	if pData.IsAnimate and (mode == "Kill" or mode == "Stop" or mode == "Bounce") then
		mode = "Off"
	end

	if mode == "Kill" or mode == "Stop" then
		handleKillOrStop(particle, pData, hit, mode)
		return "snap"
	elseif mode == "Bounce" then
		handleBounce(pData, hit, dir, segmentDT)
		return "snap"
	end

	pData._hitFired = true
	return "off"
end

return EventsCollision
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">EventsPayload</string>
              <string name="Source"><![CDATA[--[[
	EventsPayload  -  payload-builder + type-dispatched mutators bound to a fired event's payload.

	build(pData, eventName, emitCtx, cf)
	  Constructs the payload table the user's Module script receives. Per-event extras
	  (HitPosition / DeathPosition / EmitIndex / Age / LingerElapsed) are populated by
	  Events.fire / Events.afterUpdate after this call.

	apply* helpers (operate on pData directly; the payload.<Setter> closures wire to these):
	  applyColor          → visual.Color3 + pData.SkipColor=true
	  applyTransparency   → visual.Transparency + pData.SkipTransparency=true
	  applyTeleport       → visual.CFrame / :PivotTo + reset orientation / hit-check anchors
	  applyAddSpin        → pData._spinRate += vec (per-axis angular velocity)
	  applyAddImpulse     → pData._accelVel += vec (acceleration-velocity accumulator kick)
	  applyFreezeTime     → pData._frozen=on (suspends effective-elapsed advance)
	  applyPause          → applyFreezeTime(true) + auto-clear after seconds
	  applySetSize        → BasePart.Size / Model ScaleTo / ImageLabel UDim2
	  applySetVelocity    → BaseDirection (unit) + speed-override magnitude
	  applyResurrect      → clears _killedManually / _forceDead (undoes payload.Kill)

	attach* helpers (wire setter closures onto payload):
	  attachSkipSetters     → SetSkipColor / SetSkipTransparency / SetSkipSize
	  attachAdvancedSetters → AddSpin / AddImpulse / FreezeTime / Pause / SetSize / SetVelocity / Resurrect

	Convention: every Set* that mutates a graphed channel auto-flips the matching pData.Skip*
	so per-frame graph writes don't clobber the override on the next Heartbeat. SetSkip* expose
	manual control of the same gate without writing a value.
]]

local EventsPayload = {}

-- Construct a payload table for a fired event. Caller passes a precomputed `cf` (world CFrame
-- or nil for screen kinds) to avoid circular dependency on Events.getWorldCF. Includes:
--   • Source identity + visual aliases.
--   • Life-cycle state (LifeProgress, TimeRemaining, StartTime, LifeTime).
--   • Speed-related: SpeedMultiplier (raw scalar; user computes velocity via BaseDirection if needed).
--   • ChainDepth (0 for root events, increments per cross-emitter hop).
--   • EmitCount (burst-size for OnEmit; nil for other events).
--   • Per-event extras: EmitPosition, Age, DeathPosition, LingerElapsed.
function EventsPayload.build(pData, eventName, emitCtx, cf)
	local pos = cf and cf.Position or nil
	local now = os.clock()
	local elapsed = pData.StartTime and math.max(0, now - pData.StartTime) or 0
	local lifeTime = pData.LifeTime or 0
	local lifeProgress = (lifeTime > 0) and math.min(1, elapsed / lifeTime) or 0
	local timeRemaining = math.max(0, lifeTime - elapsed)
	local speedMult = pData.SpeedMultiplier or 1
	local p = {
		SourceItem      = pData._sourceItem,
		Source          = pData._sourceItem,
		Particle        = pData.VisualPart,
		RenderTemplate  = pData.VisualPart,
		WorldCFrame     = cf,
		WorldPosition   = pos,
		LifeProgress    = lifeProgress,
		TimeRemaining   = timeRemaining,
		StartTime       = pData.StartTime,
		LifeTime        = lifeTime,
		SpeedMultiplier = speedMult,
		ChainDepth      = pData.EventChainCtx and pData.EventChainCtx.Depth or 0,
		EmitCount       = emitCtx and emitCtx.EmitCount,
		_eventName      = eventName,
	}
	if eventName == "OnEmit" then
		p.EmitPosition = pos
		p.EmitIndex = emitCtx and emitCtx.EmitIndex
	elseif eventName == "OnDeath" then
		p.DeathPosition = pos
		-- Real wall-time age. Mid-life Kill reports < LifeTime; natural death equals it.
		if pData.StartTime then
			p.Age = math.max(0, now - pData.StartTime)
		else
			p.Age = pData.LifeTime
		end
	elseif eventName == "OnDestruction" then
		p.DeathPosition = pos
		-- Wall-time inside the linger window. PartLife=0 path has no linger so elapsed=0.
		if pData._lingerStartTime then
			p.LingerElapsed = math.max(0, now - pData._lingerStartTime)
		else
			p.LingerElapsed = 0
		end
	end
	return p
end

-- Color3 write per particle Type. Animatable color targets vary by kind:
-- Part/Model: BasePart.Color + SurfaceAppearance.Color (when present).
-- Beam: Color = ColorSequence.new(color)  -  beams take a sequence; collapse to a one-stop
--       sequence so the override sticks across the full beam length.
-- PointLight: Color (Color3 directly).
-- ImageLabel: ImageColor3.
-- Screen: ColorCorrection → TintColor; Atmosphere → Color. Blur/Bloom have no color.
function EventsPayload.applyColor(pData, color)
	if typeof(color) ~= "Color3" then return end
	pData.SkipColor = true
	local v = pData.VisualPart
	if not v or not v.Parent then return end
	local t = pData.Type
	if t == "Part" or t == "Model" then
		if v:IsA("BasePart") then pcall(function() v.Color = color end) end
		local sa = v.FindFirstChildOfClass and v:FindFirstChildOfClass("SurfaceAppearance")
		if sa then pcall(function() sa.Color = color end) end
	elseif t == "Beam" or t == "TrailEmitter" or t == "BeamNative" then
		pcall(function() v.Color = ColorSequence.new(color) end)
	elseif t == "PointLight" then
		pcall(function() v.Color = color end)
	elseif t == "Highlight" then
		pcall(function() v.FillColor = color end)
		pcall(function() v.OutlineColor = color end)
	elseif t == "ImageLabel" then
		pcall(function() v.ImageColor3 = color end)
	elseif t == "Screen" then
		if pData.Kind == "ColorCorrection" then
			pcall(function() v.TintColor = color end)
		elseif pData.Kind == "Atmosphere" then
			pcall(function() v.Color = color end)
		end
	end
end

-- Scalar 0..1 transparency write per particle Type.
-- PointLight has no transparency; cache the authored Brightness on first call (via
-- _baseBrightness) and modulate as base * (1 - amount) so SetTransparency(1) snuffs the
-- light and SetTransparency(0) restores it. Without the snapshot, repeated calls would
-- compound the multiplicative attenuation.
-- Screen kinds without a transparency analog (Blur/Bloom/Atmosphere) are no-ops; the
-- SkipTransparency flag still flips so the user can use it as a trigger for other logic.
function EventsPayload.applyTransparency(pData, amount)
	if type(amount) ~= "number" then return end
	amount = math.max(0, math.min(1, amount))
	pData.SkipTransparency = true
	local v = pData.VisualPart
	if not v or not v.Parent then return end
	local t = pData.Type
	if t == "Part" or t == "Model" then
		if v:IsA("BasePart") then pcall(function() v.Transparency = amount end) end
		local d = v.FindFirstChildOfClass and v:FindFirstChildOfClass("Decal")
		if d then pcall(function() d.Transparency = amount end) end
	elseif t == "Beam" or t == "TrailEmitter" or t == "BeamNative" then
		pcall(function() v.Transparency = NumberSequence.new(amount) end)
	elseif t == "PointLight" then
		local base = pData._baseBrightness or v.Brightness
		pData._baseBrightness = base
		pcall(function() v.Brightness = base * (1 - amount) end)
	elseif t == "Highlight" then
		pcall(function() v.FillTransparency = amount end)
		pcall(function() v.OutlineTransparency = amount end)
	elseif t == "ImageLabel" then
		pcall(function() v.ImageTransparency = amount end)
	end
end

-- Attach Skip* setters in one call. Each flips the corresponding
-- pData.Skip{Color,Transparency,Size} flag. Update branches gate per-frame writes.
-- SkipColor / SkipTransparency: Part / Beam / PointLight / ImageLabel / Screen.
-- SkipSize: Part (Update.luau) + ImageLabel (ImageEmit). Beam Width / PointLight
-- Range still write; symmetric coverage deferred.
-- SetSkipRotation NOT yet wired  -  Update.luau's rotation is interleaved with position
-- accumulation (NeedsRotAccum/VelocityVectored coupling); skipping requires deeper rework.
function EventsPayload.attachSkipSetters(payload, pData)
	payload.SetSkipColor = function(value) pData.SkipColor = value == true end
	payload.SetSkipTransparency = function(value) pData.SkipTransparency = value == true end
	payload.SetSkipSize = function(value) pData.SkipSize = value == true end
end

-- Teleport  -  write a new world CFrame to the visual + reset position-accumulator state.
-- Part / Attachment: VisualPart.CFrame = cf. Recompute LocalCF as parent's ToObjectSpace
-- of cf (or cf itself when unlinked). Resets _localWorldCF and _postUpdateCF so Orientation
-- + ZOffset overlays compose against the new pose. LastHitCheckPos resets to cf.Position so
-- the next OnHit raycast doesn't span the teleport gap and fire on a wall the particle
-- "passed through."
-- Model: VisualPart:PivotTo(cf). Same LocalCF / cache resets.
-- Beam / PointLight / ImageLabel / Screen kinds: no-op (no per-particle CFrame; PointLight
-- inherits its parent's position).
-- Wake a settled particle. Called from Teleport / AddImpulse / SetVelocity so
-- script-driven re-launch resumes natural physics with no stale settle state.
local function _clearSettleState(pData)
	pData._settleEngaged = false
	pData._restTimer = 0
	pData._settleRotDamp = 1
	pData._settleContactPos = nil
	pData._settleSpawnHalf = nil
	pData._lastHitNormal = nil
	pData._collisionStopped = false
	pData._displacementMirrorX = nil
	pData._displacementMirrorY = nil
	pData._displacementMirrorZ = nil
end

function EventsPayload.applyTeleport(pData, cf)
	if typeof(cf) ~= "CFrame" then return end
	_clearSettleState(pData)
	local v = pData.VisualPart
	if not v or not v.Parent then return end
	local t = pData.Type
	if t == "Part" then
		pcall(function() v.CFrame = cf end)
	elseif t == "Attachment" then
		-- Attachment.CFrame is parent-local; convert world cf via parent.
		local parent = v.Parent
		if parent and parent:IsA("BasePart") then
			pcall(function() v.CFrame = parent.CFrame:ToObjectSpace(cf) end)
		else
			pcall(function() v.CFrame = cf end)
		end
	elseif t == "Model" then
		pcall(function() v:PivotTo(cf) end)
	else
		return
	end
	-- Recompute LocalCF. Frame depends on Type + Link:
	--   • Part/Model unlinked: world-space (Update.luau composes parentCF_now=identity).
	--   • Part/Model linked:   link-relative (parentCF_now = link world CFrame).
	--   • Attachment any:      attachment-parent-relative (Update.luau's Attachment
	--     branch composes against visualPart.Parent.CFrame; LocalCF lives in that
	--     parent space whether or not Link is set).
	if t == "Attachment" then
		local visualParent = v.Parent
		if visualParent and visualParent:IsA("BasePart") then
			pData.LocalCF = visualParent.CFrame:ToObjectSpace(cf)
		else
			pData.LocalCF = cf
		end
	else
		local lk = pData.Link
		if lk and lk.Parent then
			local linkCF
			if lk:IsA("Attachment") then linkCF = lk.WorldCFrame
			elseif lk:IsA("Model") then linkCF = lk:GetPivot()
			else linkCF = lk.CFrame end
			pData.LocalCF = linkCF:ToObjectSpace(cf)
		else
			pData.LocalCF = cf
		end
	end
	pData._localWorldCF = pData.LocalCF
	-- _postUpdateCF mirrors the live VisualPart.CFrame readout (init.luau:165). For
	-- Attachment that's parent-local (matches what was just written above); for
	-- Part/Model that's world. Re-read from the visual rather than re-deriving.
	if t == "Attachment" then
		pData._postUpdateCF = v.CFrame
	elseif t == "Model" then
		pData._postUpdateCF = v:GetPivot()
	else
		pData._postUpdateCF = cf
	end
	pData.CurrentPosition = cf.Position
	pData.LastHitCheckPos = cf.Position
	pData._lastOrientPos = nil -- next ApplyOrientation reseeds velocity from this frame
end

-- Add a Vector3 angular kick to pData._spinRate. EventsCollision.handleBounce
-- already populates this from `nrm × v_t`; user adds further tumble via this helper.
function EventsPayload.applyAddSpin(pData, vec)
	if typeof(vec) ~= "Vector3" then return end
	pData._spinRate = (pData._spinRate or Vector3.zero) + vec
end

-- Add a Vector3 impulse to pData._accelVel (acceleration-velocity accumulator). Update.luau's
-- per-step accel integration reads + writes _accelVel; user-added impulses persist into next step.
function EventsPayload.applyAddImpulse(pData, vec)
	if typeof(vec) ~= "Vector3" then return end
	_clearSettleState(pData)
	pData._accelVel = (pData._accelVel or Vector3.zero) + vec
end

-- Toggle pData._timeFrozen. Update branches gate effective-elapsed advance on this flag.
-- Marks `_freezeTimeExplicit` so a concurrent Pause's auto-clear doesn't undo the user's
-- indefinite freeze.
function EventsPayload.applyFreezeTime(pData, on)
	pData._timeFrozen = on == true
	pData._freezeTimeExplicit = on == true
end

-- Temporary FreezeTime: set _timeFrozen, schedule clear. Multi-call windows: a later Pause
-- bumps the gen so the earlier delay's clear is invalidated. Auto-clear respects an
-- explicit FreezeTime  -  if user has called FreezeTime(true), Pause's clear is a no-op so
-- the explicit freeze persists.
function EventsPayload.applyPause(pData, seconds)
	if type(seconds) ~= "number" or seconds <= 0 then return end
	pData._timeFrozen = true
	local gen = (pData._pauseGen or 0) + 1
	pData._pauseGen = gen
	task.delay(seconds, function()
		if pData._pauseGen == gen and not pData._freezeTimeExplicit then
			pData._timeFrozen = false
		end
	end)
end

-- Direct VisualPart.Size write + auto-flip SkipSize so per-frame Size graphs don't clobber.
-- Type-dispatch: BasePart Size (Vector3), Attachment has no Size, ImageLabel uses UDim2  -  for
-- ImageLabel pass a UDim2 instead of Vector3 (gated by typeof).
function EventsPayload.applySetSize(pData, size)
	pData.SkipSize = true
	local v = pData.VisualPart
	if not v or not v.Parent then return end
	local t = pData.Type
	if t == "Part" or t == "Model" then
		if typeof(size) == "Vector3" and v:IsA("BasePart") then
			pcall(function() v.Size = size end)
		elseif typeof(size) == "Vector3" and t == "Model" then
			-- Model has no Size; map to ScaleTo using x component as uniform scale.
			pcall(function() v:ScaleTo(math.max(0.001, size.X)) end)
		end
	elseif t == "ImageLabel" then
		if typeof(size) == "UDim2" then pcall(function() v.Size = size end) end
	end
end

-- Replace baseDirection (unit) + override speed magnitude. Update.luau's speed sampling
-- reads pData._speedOverride when set, bypassing authored Speed graph + speedMult. Pass nil
-- vec to clear the override and resume authored sampling.
function EventsPayload.applySetVelocity(pData, vec)
	if vec == nil then
		pData._speedOverride = nil
		return
	end
	if typeof(vec) ~= "Vector3" then return end
	_clearSettleState(pData)
	local mag = vec.Magnitude
	if mag < 1e-4 then
		pData.SpeedMultiplier = 0
		pData._speedOverride = 0
		return
	end
	pData.BaseDirection = vec / mag
	pData._speedOverride = mag
end

-- Clear _killedManually + _forceDead. Must run BEFORE next Heartbeat processes the death
-- frame, OR inside the same OnHit Module body that called Kill. After the death-frame, visual
-- is destroyed/hidden  -  too late to revive.
function EventsPayload.applyResurrect(pData)
	pData._killedManually = false
	pData._forceDead = false
end

-- Wire all advanced setters in one call. Keeps Events.luau slim (one line per attach instead
-- of seven). Caller passes the live payload + pData refs.
function EventsPayload.attachAdvancedSetters(payload, pData)
	payload.AddSpin = function(vec) EventsPayload.applyAddSpin(pData, vec) end
	payload.AddImpulse = function(vec) EventsPayload.applyAddImpulse(pData, vec) end
	payload.FreezeTime = function(on) EventsPayload.applyFreezeTime(pData, on) end
	payload.Pause = function(seconds) EventsPayload.applyPause(pData, seconds) end
	payload.SetSize = function(size) EventsPayload.applySetSize(pData, size) end
	payload.SetVelocity = function(vec) EventsPayload.applySetVelocity(pData, vec) end
	payload.Resurrect = function() EventsPayload.applyResurrect(pData) end
end

return EventsPayload
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">EventsSchema</string>
              <string name="Source"><![CDATA[--[[
	EventsSchema  -  read/write/sanitize for the per-item Events tree.
	Tree: PartIcleProperties/Events/<EventName Configuration>/{Enabled, EmitMode, ScriptEnabled,
	ChainDepthLimit, EmitTarget (ObjectValue), Module (ModuleScript)}.
	Trail excluded (directAccess + continuous). OnHit only on Part/Attachment/Model.
]]

local TypeRegistry = require(script.Parent.TypeRegistry)

local EventsSchema = {}

local EVENTS_FOLDER_NAME = "Events"
local EVENT_NAMES = { "OnEmit", "OnDeath", "OnDestruction", "OnHit" }
EventsSchema.EVENT_NAMES = EVENT_NAMES
EventsSchema.EVENTS_FOLDER_NAME = EVENTS_FOLDER_NAME

local EMIT_MODES = { AtPosition = true, AtSource = true, AtTarget = true, AtCFrame = true }
EventsSchema.EMIT_MODES = EMIT_MODES

-- OnHit Collision: Off (pass-through) / Kill (snap+destroy) / Stop (freeze) / Bounce (reflect).
local COLLISION_MODES = { Off = true, Kill = true, Stop = true, Bounce = true }
EventsSchema.COLLISION_MODES = COLLISION_MODES

local function clampDepthValue(v)
	local n = tonumber(v)
	if not n then return 4 end
	return math.clamp(math.floor(n), 1, 32)
end

local function safeEmitMode(v)
	if type(v) == "string" and EMIT_MODES[v] then return v end
	return "AtPosition"
end

local function safeCollisionMode(v)
	if type(v) == "string" and COLLISION_MODES[v] then return v end
	return "Off"
end

local function clampUnit(v, lo, hi, default)
	local n = tonumber(v)
	if not n then return default end
	if n < lo then return lo end
	if n > hi then return hi end
	return n
end

EventsSchema.clampChainDepth = clampDepthValue
EventsSchema.safeEmitMode = safeEmitMode
EventsSchema.safeCollisionMode = safeCollisionMode
EventsSchema.clampUnit = clampUnit

-- Per-type event validity (OnHit only on collision-bearing types).
local VALID_PER_TYPE = {
	Part        = { OnEmit = true, OnDeath = true, OnDestruction = true, OnHit = true  },
	Beam        = { OnEmit = true, OnDeath = true, OnDestruction = true, OnHit = false },
	Attachment  = { OnEmit = true, OnDeath = true, OnDestruction = true, OnHit = true  },
	Model       = { OnEmit = true, OnDeath = true, OnDestruction = true, OnHit = true  },
	PointLight  = { OnEmit = true, OnDeath = true, OnDestruction = true, OnHit = false },
	Highlight   = { OnEmit = true, OnDeath = true, OnDestruction = true, OnHit = false },
	TrailEmitter = { OnEmit = true, OnDeath = true, OnDestruction = true, OnHit = false },
	Atmosphere  = { OnEmit = true, OnDeath = true, OnDestruction = true, OnHit = false },
	Blur        = { OnEmit = true, OnDeath = true, OnDestruction = true, OnHit = false },
	Bloom       = { OnEmit = true, OnDeath = true, OnDestruction = true, OnHit = false },
	ColorCorrection = { OnEmit = true, OnDeath = true, OnDestruction = true, OnHit = false },
	ImageLabel  = { OnEmit = true, OnDeath = true, OnDestruction = true, OnHit = false },
}

-- Per-event defaults. Enabled=false so ensureEvent paths don't implicitly arm the runtime.
local DEFAULT_ATTRS = {
	Enabled         = false,
	EmitMode        = "AtPosition",
	ScriptEnabled   = false,
	ChainDepthLimit = 4,
	Collision       = "Off",
	-- Collision physics: 0..1 each. Bounciness = normal restitution; Friction = tangential
	-- damping; Spin = nrm×v_t coefficient.
	Bounciness      = 0.7,
	Friction        = 0.2,
	Spin            = 0.5,
	-- 0 = check every Heartbeat. Clamp 0..0.5.
	HitCheckInterval = 0,
	-- OnHit raycast filters. CollisionGroup = "" means raycast leaves the group
	-- unset (matches every group). ExcludeList lives as a child Folder of ObjectValues
	-- (see ensureExcludeListFolder); missing folder reads as "no excludes".
	CollisionGroup = "",
}

-- Default Module source  -  commented payload reference for the Edit Script panel.
-- Outer literal uses [==[ ... ]==] so the inner --[[ ... ]] block comment's `]]`
-- doesn't terminate the long-string early.
local DEFAULT_MODULE_SOURCE = [==[--[[
	Part-Icles event handler.

	Source emitters supported: Part / Beam / PointLight / Attachment / Model /
	Highlight / TrailEmitter / Blur / Bloom / ColorCorrection / Atmosphere /
	ImageLabel.

	Raw ParticleEmitters and raw Trails are NOT supported as event SOURCES (they
	have no event-binding UI). As event TARGETS they ARE supported: a raw PE
	target gets wrapped in a holder Part at the emit-position; a raw Trail target
	emits in-place (the position override is ignored).
]]
-- ============================================================================
--  READ ONLY  (data fields  -  writing has no engine effect)
-- ============================================================================
--   Shared (every event scope)
--     payload.Source                            -- the source emitter Instance
--     payload.Particle, payload.RenderTemplate  -- the live emitted clone (RenderTemplate is a legacy alias)
--     payload.WorldCFrame                       -- world-space CFrame (nil for screen types)
--     payload.WorldPosition                     -- world position (nil for screen types)
--     payload.StartTime                         -- os.clock() at spawn
--     payload.LifeTime                          -- configured lifetime in seconds (use SetLifetime to change)
--     payload.LifeProgress                      -- t in [0, 1] of life elapsed (clamped)
--     payload.TimeRemaining                     -- seconds until natural death (max(0, LifeTime - elapsed))
--     payload.SpeedMultiplier                   -- current bounce-attenuated speed scalar (1 by default)
--     payload.ChainDepth                        -- depth of this event in the cross-emitter chain (0 = root)
--
--   OnEmit only
--     payload.EmitPosition                      -- Vector3 (alias for WorldPosition in OnEmit scope)
--     payload.EmitIndex                         -- 1-based batch index
--     payload.EmitCount                         -- batch size when emitted via burst (nil otherwise)
--
--   OnHit only
--     payload.HitPosition                       -- Vector3
--     payload.HitNormal                         -- Vector3
--     payload.HitInstance, payload.Other        -- the hit Instance (Other is an alias)
--
--   OnDeath only
--     payload.DeathPosition                     -- Vector3 (alias for WorldPosition in OnDeath scope)
--     payload.Age                               -- particle age in seconds
--
--   OnDestruction only
--     payload.DeathPosition                     -- Vector3 (alias for WorldPosition in OnDestruction scope)
--     payload.LingerElapsed                     -- seconds elapsed since linger started
--
-- ============================================================================
--  MUTATORS  (functions  -  call to change the live particle's state)
--             All mutators are available in every event scope.
-- ============================================================================
--   Emission control
--     payload.Emit(target, mode)         -- mode = "AtPosition"|"AtSource"|"AtTarget"|"AtCFrame"
--     payload.Kill()                     -- destroy/disable particle; Animate-mode-aware
--     payload.Resurrect()                -- undo a Kill (clears _killedManually + _forceDead)
--
--   Graph-channel override (auto-skip future graph writes on that channel)
--     payload.SetColor(color3)
--     payload.SetTransparency(scalar)
--     payload.SetSize(size)              -- BasePart.Size (Vector3) / Model ScaleTo / ImageLabel UDim2
--
--   Graph-channel skip (manual gate; no value write)
--     payload.SetSkipColor(bool)
--     payload.SetSkipTransparency(bool)
--     payload.SetSkipSize(bool)          -- Part only for now
--
--   Lifecycle
--     payload.SetLifetime(seconds)       -- set NEW total LifeTime; <=0.001 = instant kill next frame
--     payload.FreezeTime(bool)           -- toggle effective-elapsed advance (true = paused)
--     payload.Pause(seconds)             -- temporary FreezeTime; auto-clears after duration
--
--   Spatial / kinematic
--     payload.Teleport(cframe)           -- write VisualPart to a new CFrame (Part/Attachment/Model only)
--     payload.SetVelocity(vec3)          -- replace BaseDirection (unit) + speed override (magnitude)
--     payload.SetSpeedMultiplier(scalar) -- multiplicative scalar applied per-step
--     payload.AddSpin(vec3)              -- add angular velocity to pData._spinRate
--     payload.AddImpulse(vec3)           -- kick pData._accelVel (acceleration-velocity accumulator)
return function(payload)
	-- your code here
end
]==]

-- Internal: walk an item to its Events folder. Returns nil for non-config-mode types
-- (Trail) or items without the folder created yet. Doesn't create the folder.
local function getConfig(item)
	if not item then return nil end
	local typeDef = TypeRegistry.getTypeFor(item)
	if not typeDef or typeDef.directAccess then return nil end
	return TypeRegistry.getConfig(item)
end

local function getTypeName(item)
	local _, typeName = TypeRegistry.getTypeFor(item)
	return typeName
end

--- Lookup the Events folder under this item's PartIcleProperties. Returns nil if the
--- folder hasn't been created yet (lazy creation). Trail / unknown types return nil.
function EventsSchema.read(item)
	local config = getConfig(item)
	if not config then return nil end
	local folder = config:FindFirstChild(EVENTS_FOLDER_NAME)
	if folder and folder:IsA("Folder") then return folder end
	return nil
end

--- Returns true if `eventName` is valid for this item's type. Used by UI to hide
--- inapplicable rows (e.g. OnHit on a Beam) and by setEnabled/ensureEvent to refuse
--- creation of disallowed events.
function EventsSchema.isValidForItem(item, eventName)
	local typeName = getTypeName(item)
	if not typeName then return false end
	return EventsSchema.isValidForTypeName(typeName, eventName)
end

--- Type-name variant. UIBuilder/WidgetEvents calls this at section-build time when no
--- live item is available (the section is constructed once per type, not per selection).
--- Mirrors isValidForItem so the UI can never render rows the schema would refuse to
--- create  -  keeping a parallel local table in WidgetEvents would silently drift.
function EventsSchema.isValidForTypeName(typeName, eventName)
	local valid = VALID_PER_TYPE[typeName]
	return valid and valid[eventName] == true or false
end

--- Returns the per-event Configuration child if present. Doesn't create.
function EventsSchema.readEvent(item, eventName)
	local folder = EventsSchema.read(item)
	if not folder then return nil end
	local cfg = folder:FindFirstChild(eventName)
	if cfg and cfg:IsA("Configuration") then return cfg end
	return nil
end

--- Returns the ExcludeList Folder under an OnHit cfg, creating it lazily. Children
--- are ObjectValues whose .Value is the excluded Instance  -  RaycastParams ignores
--- those Instances + all descendants, so picking a Model excludes the whole tree.
--- HitFilterPanel writes here; makeHitParams reads.
function EventsSchema.ensureExcludeListFolder(cfg)
	if not cfg then return nil end
	local folder = cfg:FindFirstChild("ExcludeList")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "ExcludeList"
		folder.Parent = cfg
	end
	return folder
end

--- Snapshot of currently-enabled events for runtime consumption. Returns nil when no
--- event is enabled (or folder missing). Each entry is a PLAIN TABLE of captured
--- attribute values + the Module reference (only when ScriptEnabled=true)  -  NOT a live
--- Configuration ref. Snapshot semantics matter at emit time: cfg can mutate mid-flight
--- under user authoring, and a live ref would let the runtime see half-applied state.
---
--- Fail-closed on `ImportedUntrusted`: if a per-event Configuration has the attribute
--- set, runtime SKIPS it regardless of its Enabled value. Inventory / cloud import
--- pipeline stamps this attribute on imported events; the user must explicitly clear
--- it via the UI's "Trust this asset" button after reviewing the Module source.
---
--- Snapshot shape per event:
---   {
---       Enabled         = true,            -- always true (gate is at the readEnabled level)
---       EmitMode        = "AtPosition",
---       ScriptEnabled   = false,
---       ChainDepthLimit = 4,
---       EmitTarget      = <Instance|nil>,  -- ObjectValue.Value snapshot
---       Module          = <ModuleScript|nil>,  -- only when ScriptEnabled
---   }
function EventsSchema.readEnabled(item)
	local folder = EventsSchema.read(item)
	if not folder then return nil end
	local out
	for _, name in ipairs(EVENT_NAMES) do
		-- Per-type validity gate: VALID_PER_TYPE forbids OnHit on Beam / PointLight /
		-- screens / ImageLabel because they have no discrete-particle collision concept.
		-- Sanitize removes invalid configs on save / import, but a hand-edited cfg between
		-- write and the next sanitize would otherwise reach the runtime path and crash
		-- (e.g. Beam has no .CFrame, so EventsCollision.readWorldCF errors). Filter here
		-- so readEnabled and the schema agree on what's runtime-eligible.
		if not EventsSchema.isValidForItem(item, name) then continue end
		local cfg = folder:FindFirstChild(name)
		if cfg and cfg:IsA("Configuration") and cfg:GetAttribute("Enabled") == true
			and not cfg:GetAttribute("ImportedUntrusted")
		then
			local et = cfg:FindFirstChild("EmitTarget")
			local scriptOn = cfg:GetAttribute("ScriptEnabled") == true
			local mod = scriptOn and cfg:FindFirstChild("Module") or nil
			if mod and not mod:IsA("ModuleScript") then mod = nil end
			out = out or {}
			out[name] = {
				Enabled         = true,
				EventName       = name,
				EmitMode        = safeEmitMode(cfg:GetAttribute("EmitMode")),
				ScriptEnabled   = scriptOn,
				ChainDepthLimit = clampDepthValue(cfg:GetAttribute("ChainDepthLimit")),
				EmitTarget      = et and et:IsA("ObjectValue") and et.Value or nil,
				Module          = mod,
				-- Collision is OnHit-only at runtime; cheap to include for all events.
				Collision       = safeCollisionMode(cfg:GetAttribute("Collision")),
				Bounciness      = clampUnit(cfg:GetAttribute("Bounciness"), 0, 1, 0.7),
				Friction        = clampUnit(cfg:GetAttribute("Friction"), 0, 1, 0.2),
				Spin            = clampUnit(cfg:GetAttribute("Spin"), 0, 2, 0.5),
				HitCheckInterval = clampUnit(cfg:GetAttribute("HitCheckInterval"), 0, 0.5, 0),
			}
		end
	end
	return out
end

--- Lazily create the Events folder under PartIcleProperties. Returns the folder.
function EventsSchema.ensure(item)
	local config = getConfig(item)
	if not config then return nil end
	local folder = config:FindFirstChild(EVENTS_FOLDER_NAME)
	if folder and folder:IsA("Folder") then return folder end
	-- Replace if a non-Folder instance with the reserved name slipped in.
	if folder then folder:Destroy() end
	folder = Instance.new("Folder")
	folder.Name = EVENTS_FOLDER_NAME
	folder.Parent = config
	return folder
end

--- Lazily create the per-event Configuration. Stamps default attributes and the Module
--- ModuleScript with the stub source. Refuses creation when the event isn't valid for
--- the item's type. Idempotent: returns existing cfg unchanged when already created.
function EventsSchema.ensureEvent(item, eventName)
	if not EventsSchema.isValidForItem(item, eventName) then return nil end
	local folder = EventsSchema.ensure(item)
	if not folder then return nil end
	local cfg = folder:FindFirstChild(eventName)
	if cfg and cfg:IsA("Configuration") then return cfg end
	if cfg then cfg:Destroy() end
	cfg = Instance.new("Configuration")
	cfg.Name = eventName
	for attrName, attrVal in pairs(DEFAULT_ATTRS) do
		cfg:SetAttribute(attrName, attrVal)
	end
	local emitTarget = Instance.new("ObjectValue")
	emitTarget.Name = "EmitTarget"
	emitTarget.Value = nil
	emitTarget.Parent = cfg
	local moduleScript = Instance.new("ModuleScript")
	moduleScript.Name = "Module"
	moduleScript.Source = DEFAULT_MODULE_SOURCE
	moduleScript.Parent = cfg
	cfg.Parent = folder
	return cfg
end

--- Toggle an event's Enabled attribute. Creates the per-event Configuration on first
--- enable; toggle-off keeps the cfg + Module on disk (user code is work, don't lose it
--- because they untoggled). Returns the cfg or nil if the event isn't valid here.
function EventsSchema.setEnabled(item, eventName, enabled)
	if enabled then
		local cfg = EventsSchema.ensureEvent(item, eventName)
		if not cfg then return nil end
		cfg:SetAttribute("Enabled", true)
		-- setEnabled MUST NOT clear ImportedUntrusted. Otherwise the ordinary event toggle
		-- becomes an implicit trust action. Trust requires the dedicated trustEvent /
		-- trustAllEvents methods, wired from a visible "Trust Script" UI action.
		--
		-- If the user toggles an untrusted event on without trusting first, readEnabled
		-- still gates on `not ImportedUntrusted` so the runtime stays safe.
		return cfg
	end
	local cfg = EventsSchema.readEvent(item, eventName)
	if not cfg then return nil end
	cfg:SetAttribute("Enabled", false)
	return cfg
end

--- Explicit user-driven trust action. Clears ImportedUntrusted on a single event.
--- UI ("Trust Script" button on the per-event row) calls this AFTER the user has
--- reviewed the Module source in Studio's Script Editor. Doesn't touch Enabled  - 
--- enabling is a separate user action via setEnabled.
function EventsSchema.trustEvent(item, eventName)
	local cfg = EventsSchema.readEvent(item, eventName)
	if not cfg then return false end
	if cfg:GetAttribute("ImportedUntrusted") then
		cfg:SetAttribute("ImportedUntrusted", nil)
		return true
	end
	return false
end

--- Bulk trust action. Clears ImportedUntrusted on every event under this item.
--- UI ("Trust Asset" button on the Inventory detail panel) calls this. Caller is
--- expected to confirm with the user (modal or inline confirm) before invoking;
--- this method is the schema-side write only.
function EventsSchema.trustAllEvents(item)
	local folder = EventsSchema.read(item)
	if not folder then return false end
	local cleared = false
	for _, cfg in ipairs(folder:GetChildren()) do
		if cfg:IsA("Configuration") and cfg:GetAttribute("ImportedUntrusted") then
			cfg:SetAttribute("ImportedUntrusted", nil)
			cleared = true
		end
	end
	return cleared
end

--- Stamp every event Configuration on this item with ImportedUntrusted=true and
--- Enabled=false. Called by the Inventory / cloud import pipeline after a fresh
--- DeserializeInstancesAsync call. Imported events can carry arbitrary Luau in the
--- Module ModuleScript that would execute on first event fire  -  fail-closed by
--- default so the user has to explicitly trust the asset before scripts run.
---
--- Clearing ImportedUntrusted requires the explicit trustEvent / trustAllEvents
--- methods (wired from a visible Trust Script / Trust Asset UI action). setEnabled
--- never clears the flag.
function EventsSchema.stampImportedUntrusted(item)
	local folder = EventsSchema.read(item)
	if not folder then return false end
	local stamped = false
	for _, cfg in ipairs(folder:GetChildren()) do
		if cfg:IsA("Configuration") then
			cfg:SetAttribute("ImportedUntrusted", true)
			cfg:SetAttribute("Enabled", false)
			stamped = true
		end
	end
	return stamped
end

--- Reset Event button: blow away the per-event Configuration (loses authored Module
--- source). Caller is expected to confirm with the user before invoking. Returns true
--- when something was deleted.
function EventsSchema.deleteEvent(item, eventName)
	local cfg = EventsSchema.readEvent(item, eventName)
	if not cfg then return false end
	cfg:Destroy()
	-- If the Events folder is now empty, delete it too. Keeps "no events configured"
	-- distinguishable from "events configured but all disabled".
	local folder = EventsSchema.read(item)
	if folder and #folder:GetChildren() == 0 then folder:Destroy() end
	return true
end

--- Sanity-repair the Events tree on this item. Called by Migrate.fix.
---  - Drops Folder/Configuration children whose names aren't in EVENT_NAMES.
---  - Drops events that aren't valid for this item's type (e.g. OnHit on a Beam).
---  - Backfills missing default attributes on existing event Configurations.
---  - Ensures every cfg has an EmitTarget ObjectValue + Module ModuleScript child.
---  - Drops any `_CompiledEventModule` clones the runtime parented for caching.
--- Returns true if any change was made.
function EventsSchema.sanitize(item)
	local folder = EventsSchema.read(item)
	if not folder then return false end
	local changed = false
	local validSet = {}
	for _, n in ipairs(EVENT_NAMES) do validSet[n] = true end
	for _, child in ipairs(folder:GetChildren()) do
		-- Drop unrecognized siblings  -  anything not a per-event Configuration with a
		-- known event name. The compile-cache clones (named "_CompiledEventModule")
		-- live elsewhere, but if a clone leaked into the Events folder we kill it here.
		if not (child:IsA("Configuration") and validSet[child.Name]) then
			child:Destroy()
			changed = true
		elseif not EventsSchema.isValidForItem(item, child.Name) then
			-- Event name is known but doesn't apply to this type (OnHit on a Beam, etc.).
			child:Destroy()
			changed = true
		else
			-- Backfill missing default attributes.
			for attrName, defaultVal in pairs(DEFAULT_ATTRS) do
				if child:GetAttribute(attrName) == nil then
					child:SetAttribute(attrName, defaultVal)
					changed = true
				end
			end
			-- Clamp ChainDepthLimit to the documented 1..32 range. Drops any non-numeric
			-- value back to the default 4  -  protects runtime apply() / readEnabled from
			-- stringly-typed garbage data on disk-imported assets.
			local depth = child:GetAttribute("ChainDepthLimit")
			local clamped = clampDepthValue(depth)
			if depth ~= clamped then
				child:SetAttribute("ChainDepthLimit", clamped)
				changed = true
			end
			-- Snap EmitMode back to AtPosition when imported assets carry an unrecognized
			-- string. Mirrors safeEmitMode in readEnabled but at sanitize time so disk
			-- state matches runtime expectations.
			local mode = child:GetAttribute("EmitMode")
			local safe = safeEmitMode(mode)
			if mode ~= safe then
				child:SetAttribute("EmitMode", safe)
				changed = true
			end
			-- Same coercion for Collision. OnHit-only at runtime; non-OnHit events keep
			-- the attribute but it's inert. Imported assets with bogus values snap to "Off".
			local cmode = child:GetAttribute("Collision")
			local csafe = safeCollisionMode(cmode)
			if cmode ~= csafe then
				child:SetAttribute("Collision", csafe)
				changed = true
			end
			-- Clamp Bounciness / Friction / Spin to safe ranges. Backfill defaults if missing.
			local physicsRows = {
				{ name = "Bounciness",       lo = 0, hi = 1,   default = 0.7 },
				{ name = "Friction",         lo = 0, hi = 1,   default = 0.2 },
				{ name = "Spin",             lo = 0, hi = 2,   default = 0.5 },
				{ name = "HitCheckInterval", lo = 0, hi = 0.5, default = 0 },
			}
			for _, row in ipairs(physicsRows) do
				local raw = child:GetAttribute(row.name)
				local clamped = clampUnit(raw, row.lo, row.hi, row.default)
				if raw ~= clamped then
					child:SetAttribute(row.name, clamped)
					changed = true
				end
			end
			-- EmitTarget ObjectValue child.
			local et = child:FindFirstChild("EmitTarget")
			if not et or not et:IsA("ObjectValue") then
				if et then et:Destroy() end
				et = Instance.new("ObjectValue")
				et.Name = "EmitTarget"
				et.Parent = child
				changed = true
			end
			-- Module ModuleScript child.
			local mod = child:FindFirstChild("Module")
			if not mod or not mod:IsA("ModuleScript") then
				if mod then mod:Destroy() end
				mod = Instance.new("ModuleScript")
				mod.Name = "Module"
				mod.Source = DEFAULT_MODULE_SOURCE
				mod.Parent = child
				changed = true
			end
			-- Drop any stray cache clones siblings of Module.
			for _, sub in ipairs(child:GetChildren()) do
				if sub.Name == "_CompiledEventModule" then
					sub:Destroy()
					changed = true
				end
			end
		end
	end
	-- Empty-folder cleanup.
	if #folder:GetChildren() == 0 then
		folder:Destroy()
		changed = true
	end
	return changed
end

--- Capture the current Events tree as a plain Lua table for clipboard / migration use.
--- Returns nil when no events folder exists. Snapshot omits the cache clone since it's
--- runtime-only state.
---
--- Wired by `ClipShiftFix.luau` per-event clipboard copy/paste. ImportedUntrusted is
--- preserved through the snapshot/apply round-trip: a trusted event copied from one
--- item does NOT become trusted on the paste target if the source was untrusted, and
--- an untrusted event won't silently re-trust just by skipping the flag.
---
--- EmitTargetPresent flags ObjectValue presence on the source so apply() can
--- distinguish "source had no target, clear destination" from "source field
--- absent entirely, leave destination alone".
function EventsSchema.snapshot(item)
	local folder = EventsSchema.read(item)
	if not folder then return nil end
	local snap
	for _, name in ipairs(EVENT_NAMES) do
		local cfg = folder:FindFirstChild(name)
		if cfg and cfg:IsA("Configuration") then
			snap = snap or {}
			local entry = {
				Enabled           = cfg:GetAttribute("Enabled"),
				EmitMode          = cfg:GetAttribute("EmitMode"),
				ScriptEnabled     = cfg:GetAttribute("ScriptEnabled"),
				ChainDepthLimit   = cfg:GetAttribute("ChainDepthLimit"),
				Collision         = cfg:GetAttribute("Collision"),
				Bounciness        = cfg:GetAttribute("Bounciness"),
				Friction          = cfg:GetAttribute("Friction"),
				Spin              = cfg:GetAttribute("Spin"),
				HitCheckInterval  = cfg:GetAttribute("HitCheckInterval"),
				ImportedUntrusted = cfg:GetAttribute("ImportedUntrusted") == true,
			}
			local et = cfg:FindFirstChild("EmitTarget")
			-- EmitTarget.Value is an Instance ref. Resolution at apply time can't restore
			-- across game-tree boundaries (clipboard between places, asset-import) so the
			-- snapshot stores the FullName for diagnostic display + the live ref for same-
			-- session paste. Apply uses the live ref when valid; FullName is fallback log.
			if et and et:IsA("ObjectValue") then
				entry.EmitTargetPresent = true
				entry.EmitTargetValue = et.Value
				entry.EmitTargetPath = et.Value and et.Value:GetFullName() or nil
			end
			local mod = cfg:FindFirstChild("Module")
			if mod and mod:IsA("ModuleScript") then
				entry.ModuleSource = mod.Source
			end
			snap[name] = entry
		end
	end
	return snap
end

--- Apply a snapshot back onto an item. Skips events that aren't valid for this item's
--- type (snapshotting an OnHit from a Part and pasting onto a Beam silently drops the
--- OnHit entry). Existing events on the target are NOT pre-cleared  -  existing cfgs are
--- updated in-place; missing ones are created.
function EventsSchema.apply(item, snap)
	if not snap then return false end
	local applied = false
	for name, entry in pairs(snap) do
		if EventsSchema.isValidForItem(item, name) then
			local cfg = EventsSchema.ensureEvent(item, name)
			if cfg then
				if entry.Enabled ~= nil then cfg:SetAttribute("Enabled", entry.Enabled == true) end
				if entry.EmitMode ~= nil then cfg:SetAttribute("EmitMode", safeEmitMode(entry.EmitMode)) end
				if entry.ScriptEnabled ~= nil then cfg:SetAttribute("ScriptEnabled", entry.ScriptEnabled == true) end
				if entry.ChainDepthLimit ~= nil then
					cfg:SetAttribute("ChainDepthLimit", clampDepthValue(entry.ChainDepthLimit))
				end
				if entry.Collision ~= nil then
					cfg:SetAttribute("Collision", safeCollisionMode(entry.Collision))
				end
				if entry.Bounciness ~= nil then cfg:SetAttribute("Bounciness", clampUnit(entry.Bounciness, 0, 1, 0.7)) end
				if entry.Friction ~= nil then cfg:SetAttribute("Friction", clampUnit(entry.Friction, 0, 1, 0.2)) end
				if entry.Spin ~= nil then cfg:SetAttribute("Spin", clampUnit(entry.Spin, 0, 2, 0.5)) end
				if entry.HitCheckInterval ~= nil then cfg:SetAttribute("HitCheckInterval", clampUnit(entry.HitCheckInterval, 0, 0.5, 0)) end
				-- ImportedUntrusted round-trip: untrusted source stays untrusted, trusted
				-- source clears destination's untrusted flag. Paste of a trusted event
				-- onto a previously-imported untrusted destination unblocks the paste,
				-- because the user has now provided trusted source code by an explicit
				-- copy/paste action (clipboard is user-driven, unlike asset import).
				if entry.ImportedUntrusted == true then
					cfg:SetAttribute("ImportedUntrusted", true)
				else
					cfg:SetAttribute("ImportedUntrusted", nil)
				end
				local et = cfg:FindFirstChild("EmitTarget")
				if et and et:IsA("ObjectValue") and entry.EmitTargetPresent then
					-- Write even when EmitTargetValue is nil so paste can clear a
					-- stale destination target. Snapshot sets EmitTargetPresent
					-- whenever the source had an ObjectValue field.
					et.Value = entry.EmitTargetValue
				end
				local mod = cfg:FindFirstChild("Module")
				if mod and mod:IsA("ModuleScript") and entry.ModuleSource ~= nil then
					mod.Source = entry.ModuleSource
				end
				applied = true
			end
		end
	end
	return applied
end

return EventsSchema
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">Flipbook</string>
              <string name="Source"><![CDATA[-- Flipbook  -  texture cycling for Part meshes, Beams, and ImageLabels.
-- Reads numbered Decal/Texture children from a Flipbooks folder, sorted by name.

local ContentProvider = game:GetService("ContentProvider")
local RangeMod = require(script.Parent.Range)
local MeshFlipbook = {}

-- Read + sort once at emit time, cache in data.CachedMeshTextures. Stray non-Decal/Texture children skipped.
function MeshFlipbook.GetSortedTextures(flipbookFolder: Folder): {string}
	local decalObjects = {}
	for _, child in pairs(flipbookFolder:GetChildren()) do
		if child:IsA("Decal") or child:IsA("Texture") then
			table.insert(decalObjects, child)
		end
	end
	if #decalObjects == 0 then return {} end

	table.sort(decalObjects, function(a, b)
		return (tonumber(a.Name) or 0) < (tonumber(b.Name) or 0)
	end)

	local textures = {}
	for _, obj in ipairs(decalObjects) do
		table.insert(textures, obj.Texture)
	end

	-- Preload textures so frame swaps are instant.
	if #textures > 0 then
		task.spawn(function()
			ContentProvider:PreloadAsync(textures)
		end)
	end

	return textures
end

-- Same as GetSortedTextures but Decal-only (Beam flipbook folders).
function MeshFlipbook.GetSortedBeamTextures(flipbookFolder: Folder): {string}
	local decalObjects = {}
	for _, child in pairs(flipbookFolder:GetChildren()) do
		if child:IsA("Decal") then
			table.insert(decalObjects, child)
		end
	end
	if #decalObjects == 0 then return {} end

	table.sort(decalObjects, function(a, b)
		return (tonumber(a.Name) or 0) < (tonumber(b.Name) or 0)
	end)

	local textures = {}
	for _, obj in ipairs(decalObjects) do
		table.insert(textures, obj.Texture)
	end

	if #textures > 0 then
		task.spawn(function()
			ContentProvider:PreloadAsync(textures)
		end)
	end

	return textures
end

-- One-time warn for SurfaceAppearance.ColorMap write fails (PluginSecurity in runtime).
local _surfaceColorMapWarned = false
local function _writeFrame(target, prop, value)
	local ok, err = pcall(function() target[prop] = value end)
	if not ok and prop == "ColorMap" and not _surfaceColorMapWarned then
		_surfaceColorMapWarned = true
		warn(("[Part-Icles] SurfaceAppearance flipbook ColorMap write failed (%s). " ..
			"ColorMap is PluginSecurity  -  SurfaceAppearance flipbooks only animate in plugin context. " ..
			"For runtime games, use Decal / Texture flipbooks instead."):format(tostring(err)))
	end
end

-- SurfaceAppearance writes to ColorMap; MeshPart writes to TextureID;
-- Decal/Texture/Beam write to Texture.
local function _texProp(target)
	if target and target:IsA("SurfaceAppearance") then return "ColorMap" end
	if target and target:IsA("MeshPart") then return "TextureID" end
	return "Texture"
end

-- Loop: cycle textures for lifetime. Frame index = pData._effectiveElapsed so Timescale,
-- FreezeTime, Pause, signed-reverse all affect playback. Wall-clock cap is the safety
-- exit; primary teardown is Heartbeat destroying the visual.
local function _loop(pData, particle, decals, target, lifetime)
	if #decals == 0 then return end

	local framerate = RangeMod.RandomValueFromRange(particle.FlipbookFramerate)
	-- Clamp to 0.1 so framerate=0 doesn't produce 1/0 = inf.
	if not framerate or framerate < 0.1 then framerate = 0.1 end
	local frameDelay = 1 / framerate
	local n = #decals
	local rev = particle.FlipbookReverse
	local startOffset = particle.FlipbookStartRandom and math.random(0, n - 1) or 0
	local startTime = os.clock()
	local prop = _texProp(target)

	task.spawn(function()
		local lastFrame = -1
		while os.clock() - startTime < lifetime * 4 do
			if not target or not target.Parent then return end
			if pData and (not pData.VisualPart or not pData.VisualPart.Parent) then return end
			local elapsed = (pData and pData._effectiveElapsed) or (os.clock() - startTime)
			local frameIndex = (math.floor(elapsed / frameDelay) + startOffset) % n + 1
			if rev then frameIndex = n - frameIndex + 1 end
			if frameIndex ~= lastFrame then
				_writeFrame(target, prop, decals[frameIndex])
				lastFrame = frameIndex
			end
			task.wait()
		end
	end)
end

-- OneShot: play textures once over lifetime, guarantee final frame shown before death.
-- Uses pData._effectiveElapsed for frame mapping (Timescale-aware, FreezeTime-aware).
local function _oneShot(pData, particle, decals, target, lifetime)
	if #decals == 0 then return end

	local n = #decals
	local rev = particle.FlipbookReverse
	local startOffset = particle.FlipbookStartRandom and math.random(0, n - 1) or 0
	local startTime = os.clock()
	local prop = _texProp(target)

	task.spawn(function()
		local lastFrame = -1
		while os.clock() - startTime < lifetime * 4 do
			if not target or not target.Parent then return end
			if pData and (not pData.VisualPart or not pData.VisualPart.Parent) then break end
			local elapsed = (pData and pData._effectiveElapsed) or (os.clock() - startTime)
			local frameIndex = math.min(math.floor(elapsed / lifetime * n) + 1, n)
			frameIndex = (frameIndex - 1 + startOffset) % n + 1
			if rev then frameIndex = n - frameIndex + 1 end
			if frameIndex ~= lastFrame then
				_writeFrame(target, prop, decals[frameIndex])
				lastFrame = frameIndex
			end
			task.wait()
		end
		if target and target.Parent then
			local finalFrame = (n - 1 + startOffset) % n + 1
			if rev then finalFrame = n - finalFrame + 1 end
			_writeFrame(target, prop, decals[finalFrame])
		end
	end)
end

-- Target is Decal (Texture) or SurfaceAppearance (ColorMap); _texProp picks the slot.
-- pData is required for Timescale/FreezeTime/Pause/reverse-Timescale-aware frame indexing;
-- nil pData falls back to wall-clock elapsed for backwards compat.
function MeshFlipbook.Flip(pData, particle, decals: {string}, target, lifetime)
	if not particle or not particle.FlipbookMode then return end

	if particle.FlipbookMode == Enum.ParticleFlipbookMode.Loop then
		_loop(pData, particle, decals, target, lifetime)
	elseif particle.FlipbookMode == Enum.ParticleFlipbookMode.OneShot then
		_oneShot(pData, particle, decals, target, lifetime)
	end
end

function MeshFlipbook.FlipBeam(pData, flipbookParticle, decals: {string}, beam, lifetime)
	if not flipbookParticle or not decals or not flipbookParticle.FlipbookMode then return end

	local mode = flipbookParticle.FlipbookMode
	if mode == Enum.ParticleFlipbookMode.Loop then
		_loop(pData, flipbookParticle, decals, beam, lifetime)
	elseif mode == Enum.ParticleFlipbookMode.OneShot then
		_oneShot(pData, flipbookParticle, decals, beam, lifetime)
	end
end

return MeshFlipbook
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">GetData</string>
              <string name="Source"><![CDATA[--[[
	GetData Mixin  -  Particle:GetData(item) reads every config attribute into a flat data table.
	Returns nil for non-transformed items.
]]

local MeshFlipMod = require(script.Parent.Flipbook)
local TypeRegistry = require(script.Parent.TypeRegistry)
local AxisLinksMod = require(script.Parent.AxisLinks)
local EventsSchema = require(script.Parent.EventsSchema)

-- Enum.X[name] throws on unknown names; pcall + default keeps emit alive on bad migrations.
local function safeEnum(enumType, name, default)
	if not name then return default end
	local ok, val = pcall(function() return enumType[name] end)
	return (ok and val) or default
end

-- Read raw <axis>LinkedTo, hand to AxisLinks.sanitize for filtering.
local function readAxisLinks(config)
	local raw = {
		SizeX = config:GetAttribute("SizeXLinkedTo"), SizeY = config:GetAttribute("SizeYLinkedTo"), SizeZ = config:GetAttribute("SizeZLinkedTo"),
		RotSpeedX = config:GetAttribute("RotSpeedXLinkedTo"), RotSpeedY = config:GetAttribute("RotSpeedYLinkedTo"), RotSpeedZ = config:GetAttribute("RotSpeedZLinkedTo"),
		PosOffsetX = config:GetAttribute("PosOffsetXLinkedTo"), PosOffsetY = config:GetAttribute("PosOffsetYLinkedTo"), PosOffsetZ = config:GetAttribute("PosOffsetZLinkedTo"),
		RotX = config:GetAttribute("RotXLinkedTo"), RotY = config:GetAttribute("RotYLinkedTo"), RotZ = config:GetAttribute("RotZLinkedTo"),
		PosX = config:GetAttribute("PosXLinkedTo"), PosY = config:GetAttribute("PosYLinkedTo"), PosZ = config:GetAttribute("PosZLinkedTo"),
	}
	return AxisLinksMod.sanitize(raw)
end

return function(Particle)

-- Resolve `item`'s authored config into a flat `data` table used by every emit /
-- update path: graphs, NumberRanges, Booleans, Link target, AxisLinks, EmitMode, etc.
function Particle:GetData(item)
	local data = {}

	local config = TypeRegistry.getConfig(item)
	if not config then return nil end

	local ep = item:FindFirstChild("EmitParent")
	data.EmitParent = ep and ep:IsA("ObjectValue") and ep.Value or nil

	-- LinkSource (None / Camera / Object) picks what; LinkMode (Weld / Follow / Pivot) picks how.
	local lk = item:FindFirstChild("Link")
	local linkedInst = lk and lk:IsA("ObjectValue") and lk.Value or nil
	local linkSource = item:GetAttribute("LinkSource")
	if not linkSource then linkSource = linkedInst and "Object" or "None" end
	if linkSource == "Camera" then
		data.Link = workspace.CurrentCamera
	elseif linkSource == "Object" then
		data.Link = linkedInst
	else
		data.Link = nil
	end
	data.LinkMode = item:GetAttribute("LinkMode") or "Follow"

	data.RenderTemplate = item:FindFirstChild("RenderTemplate")

	-- Events snapshot frozen at emit; runtime fire reads only this, never live cfg.
	data.Events = EventsSchema.readEnabled(item)

	local tkf = config:GetAttribute("TotalKeyFrames") or 0
	data.TotalKeyFrames = tkf > 0 and tkf or 100

	data.CheckEnabled = function() return config.Parent ~= nil and config:GetAttribute("Enabled") == true end

	-- MODEL
	if item:IsA("Model") then
		data.PartLife = config:GetAttribute("PartLife") or 0
		data.DirMode = config:GetAttribute("DirMode") or ((config:GetAttribute("VelocityVectored") and "Local") or "RigidLocal")
		data.VelocityVectored = (data.DirMode == "Local")
		data.InvertMotion = config:GetAttribute("InvertMotion") or false
		data.RotMode = config:GetAttribute("RotMode") or "OverLife"
		data.RotOrder = config:GetAttribute("RotOrder") or "Global"
		data.Lifetime = config:GetAttribute("Lifetime") or NumberRange.new(1)
		data.Rate = config:GetAttribute("Rate") or 10

		data.EmissionDirection = safeEnum(Enum.NormalId, config:GetAttribute("EmissionDirection"), Enum.NormalId.Top)

		data.ParticleData = {
			SpreadAngle = config:GetAttribute("SpreadAngle") or Vector2.new(0, 0),
			Acceleration = config:GetAttribute("Acceleration") or Vector3.new(0, 0, 0),
			Drag = config:GetAttribute("Drag") or 0,
		}

		data.Speed = config:GetAttribute("Speed")
		data.Scale = config:GetAttribute("Scale")
		data.Timescale = config:GetAttribute("Timescale")

		data.RotX = config:GetAttribute("RotX") or NumberRange.new(0)
		data.RotY = config:GetAttribute("RotY") or NumberRange.new(0)
		data.RotZ = config:GetAttribute("RotZ") or NumberRange.new(0)
		data.RotXEven = config:GetAttribute("RotXEven") == true
		data.RotYEven = config:GetAttribute("RotYEven") == true
		data.RotZEven = config:GetAttribute("RotZEven") == true

		data.PosX = config:GetAttribute("PosX") or NumberRange.new(0)
		data.PosY = config:GetAttribute("PosY") or NumberRange.new(0)
		data.PosZ = config:GetAttribute("PosZ") or NumberRange.new(0)
		data.PosXEven = config:GetAttribute("PosXEven") == true
		data.PosYEven = config:GetAttribute("PosYEven") == true
		data.PosZEven = config:GetAttribute("PosZEven") == true
		data.PosMode = config:GetAttribute("PosMode") or "Local"
		data.DisplacementMode = config:GetAttribute("DisplacementMode") or "Global"

		data.RotSpeedX = config:GetAttribute("RotSpeedX")
		data.RotSpeedY = config:GetAttribute("RotSpeedY")
		data.RotSpeedZ = config:GetAttribute("RotSpeedZ")

		data.PosOffsetX = config:GetAttribute("PosOffsetX")
		data.PosOffsetY = config:GetAttribute("PosOffsetY")
		data.PosOffsetZ = config:GetAttribute("PosOffsetZ")

		data.Orientation = config:GetAttribute("Orientation") or "None"
		data.ZOffset = config:GetAttribute("ZOffset") or 0

		data.AxisLinks = readAxisLinks(config)
		data.Pool = config:GetAttribute("Pool")
		-- Gates descendant Beam's TextureLength * pFactor in UpdateBeam (parent-scale block).
		data.ScaleTextureLength = config:GetAttribute("ScaleTextureLength")

		return data
	end

	-- BLUR
	if item:IsA("BlurEffect") then
		data.PartLife = config:GetAttribute("PartLife") or 0
		data.Lifetime = config:GetAttribute("Lifetime") or NumberRange.new(1)
		data.Rate = config:GetAttribute("Rate") or 10
		data.BlurSize = config:GetAttribute("BlurSize")
		data.Timescale = config:GetAttribute("Timescale")
		return data
	end

	-- BLOOM
	if item:IsA("BloomEffect") then
		data.PartLife = config:GetAttribute("PartLife") or 0
		data.Lifetime = config:GetAttribute("Lifetime") or NumberRange.new(1)
		data.Rate = config:GetAttribute("Rate") or 10
		data.BloomIntensity = config:GetAttribute("BloomIntensity")
		data.BloomSize = config:GetAttribute("BloomSize")
		data.BloomThreshold = config:GetAttribute("BloomThreshold")
		data.Timescale = config:GetAttribute("Timescale")
		return data
	end

	-- COLOR CORRECTION
	if item:IsA("ColorCorrectionEffect") then
		data.PartLife = config:GetAttribute("PartLife") or 0
		data.Lifetime = config:GetAttribute("Lifetime") or NumberRange.new(1)
		data.Rate = config:GetAttribute("Rate") or 10
		data.CCBrightness = config:GetAttribute("CCBrightness")
		data.CCContrast = config:GetAttribute("CCContrast")
		data.CCSaturation = config:GetAttribute("CCSaturation")
		data.CCTintColor = config:GetAttribute("CCTintColor")
		data.Timescale = config:GetAttribute("Timescale")
		return data
	end

	-- ATMOSPHERE
	if item:IsA("Atmosphere") then
		data.PartLife = config:GetAttribute("PartLife") or 0
		data.Lifetime = config:GetAttribute("Lifetime") or NumberRange.new(1)
		data.Rate = config:GetAttribute("Rate") or 10
		data.AtmDensity = config:GetAttribute("AtmDensity")
		data.AtmOffset = config:GetAttribute("AtmOffset")
		data.AtmGlare = config:GetAttribute("AtmGlare")
		data.AtmHaze = config:GetAttribute("AtmHaze")
		data.AtmColor = config:GetAttribute("AtmColor")
		data.AtmDecay = config:GetAttribute("AtmDecay")
		data.AtmTimescale = config:GetAttribute("AtmTimescale")
		return data
	end

	-- IMAGE LABEL
	if item:IsA("ImageLabel") then
		data.PartLife = config:GetAttribute("PartLife") or 0
		data.Lifetime = config:GetAttribute("Lifetime") or NumberRange.new(1)
		data.Rate = config:GetAttribute("Rate") or 10
		data.ImageTransparency      = config:GetAttribute("ImageTransparency")
		data.BackgroundTransparency = config:GetAttribute("BackgroundTransparency")
		data.ImgSpeed               = config:GetAttribute("ImgSpeed")
		data.SizeScaleX             = config:GetAttribute("SizeScaleX")
		data.SizeScaleY             = config:GetAttribute("SizeScaleY")
		data.ImgRotRange            = config:GetAttribute("ImgRotRange") or NumberRange.new(0)
		data.ImgRotSpeed            = config:GetAttribute("ImgRotSpeed")
		data.ImgRotMode             = config:GetAttribute("ImgRotMode") or "OverLife"
		data.ImageColor3       = config:GetAttribute("ImageColor3")
		data.BackgroundColor3  = config:GetAttribute("BackgroundColor3")
		data.Image             = config:GetAttribute("Image") or ""
		data.ImgPosition       = config:GetAttribute("Position") or UDim2.fromScale(0.5, 0.5)
		data.ImgSizeUDim       = config:GetAttribute("ImgSize") or UDim2.fromOffset(100, 100)
		data.ImgAnchorPoint    = config:GetAttribute("AnchorPoint") or Vector2.new(0.5, 0.5)
		data.ImgZIndex         = config:GetAttribute("ZIndex") or 1
		data.ImgScaleType      = safeEnum(Enum.ScaleType, config:GetAttribute("ScaleType"), Enum.ScaleType.Stretch)
		data.ImgResampleMode   = safeEnum(Enum.ResamplerMode, config:GetAttribute("ResampleMode"), Enum.ResamplerMode.Default)
		data.ImgEmissionAngle  = config:GetAttribute("EmissionAngle") or 90
		data.ImgSpreadAngle    = config:GetAttribute("ImgSpreadAngle") or 0
		data.ImgAcceleration   = config:GetAttribute("ImgAcceleration") or Vector2.new(0, 0)
		data.ImgDrag           = config:GetAttribute("ImgDrag") or 0
		data.ImgInvertMotion   = config:GetAttribute("ImgInvertMotion") or false
		-- FlipbookSource: Decals folder vs Spritesheet grid.
		data.ImgFlipbookSource      = config:GetAttribute("ImgFlipbookSource") or "Decals"
		data.ImgFlipbookMode = safeEnum(Enum.ParticleFlipbookMode, config:GetAttribute("ImgFlipbookMode"), Enum.ParticleFlipbookMode.Loop)
		data.ImgFlipbookStartRandom = config:GetAttribute("ImgFlipbookStartRandom") or false
		-- Fallback values must match TypeDataScreen registry defaults.
		data.ImgGridCols            = config:GetAttribute("GridCols") or 8
		data.ImgGridRows            = config:GetAttribute("GridRows") or 1
		data.ImgFlipbookFramerate   = config:GetAttribute("ImgFlipbookFramerate") or NumberRange.new(10)
		data.ImgFlipbookReverse     = config:GetAttribute("ImgFlipbookReverse") or false
		-- Sheet dims stamped at edit time. Trust _SheetSize only when _SheetAsset matches current Image.
		local sSize = config:GetAttribute("_SheetSize")
		local sAsset = config:GetAttribute("_SheetAsset")
		local currentId = (type(data.Image) == "string") and (data.Image:match("rbxassetid://(%d+)") or data.Image:match("^(%d+)$")) or nil
		if typeof(sSize) == "Vector2" and sAsset and sAsset == currentId then data.SheetSize = sSize end
		data.ImageFlipbooks = item:FindFirstChild("ImageFlipbooks")
		data.ImgTimescale = config:GetAttribute("ImgTimescale")
		data.Pool = config:GetAttribute("Pool")
		return data
	end

	-- POINTLIGHT
	if item:IsA("PointLight") then
		data.PartLife = config:GetAttribute("PartLife") or 0
		data.Lifetime = config:GetAttribute("Lifetime") or NumberRange.new(1)
		data.Rate = config:GetAttribute("Rate") or 10
		data.PLRange = config:GetAttribute("PLRange")
		data.PLBrightness = config:GetAttribute("PLBrightness")
		data.PLColor = config:GetAttribute("PLColor")
		data.PLTimescale = config:GetAttribute("PLTimescale")
		data.Shadows = config:GetAttribute("Shadows")
		data.Pool = config:GetAttribute("Pool")
		return data
	end

	-- HIGHLIGHT  -  non-spatial, attached entity. Adornee resolved as ObjectValue child
	-- (falls back to source.Parent when unset). No Link / EmissionDirection / motion.
	if item:IsA("Highlight") then
		data.PartLife = config:GetAttribute("PartLife") or 0
		data.Lifetime = config:GetAttribute("Lifetime") or NumberRange.new(1)
		data.Rate = config:GetAttribute("Rate") or 10
		data.HLFillColor = config:GetAttribute("HLFillColor")
		data.HLFillTransparency = config:GetAttribute("HLFillTransparency")
		data.HLOutlineColor = config:GetAttribute("HLOutlineColor")
		data.HLOutlineTransparency = config:GetAttribute("HLOutlineTransparency")
		data.HLTimescale = config:GetAttribute("HLTimescale")
		data.HLDepthMode = safeEnum(Enum.HighlightDepthMode, config:GetAttribute("HLDepthMode"), Enum.HighlightDepthMode.AlwaysOnTop)
		local adornee = item:FindFirstChild("Adornee")
		data.Adornee = adornee and adornee:IsA("ObjectValue") and adornee.Value or nil
		data.Pool = config:GetAttribute("Pool")
		return data
	end

	-- TRAILEMITTER  -  Trail with PartIcleProperties Configuration child (full particle pipeline).
	-- Discriminated from directAccess Trail by the config presence check above.
	if item:IsA("Trail") then
		data.PartLife = config:GetAttribute("PartLife") or 0
		data.Lifetime = config:GetAttribute("Lifetime") or NumberRange.new(2)
		data.Rate = config:GetAttribute("Rate") or 10
		data.TEmitTimescale = config:GetAttribute("TEmitTimescale")
		data.TEmitBrightness = config:GetAttribute("TEmitBrightness")
		data.TEmitLightEmission = config:GetAttribute("TEmitLightEmission")
		data.TEmitLightInfluence = config:GetAttribute("TEmitLightInfluence")
		data.TEmitTextureLength = config:GetAttribute("TEmitTextureLength")
		data.TEmitMinLength = config:GetAttribute("TEmitMinLength")
		data.TEmitMaxLength = config:GetAttribute("TEmitMaxLength")
		data.TrailLife = config:GetAttribute("TEmitTrailLife") or NumberRange.new(2)
		data.TrailFlipbookMode = safeEnum(Enum.ParticleFlipbookMode, config:GetAttribute("TEmitFlipbookMode"), Enum.ParticleFlipbookMode.OneShot)
		data.TrailFlipbookFramerate = config:GetAttribute("TEmitFlipbookFramerate") or NumberRange.new(30)
		data.TrailFlipbookStartRandom = config:GetAttribute("TEmitFlipbookStartRandom")
		data.TrailFlipbookReverse = config:GetAttribute("TEmitFlipbookReverse")
		data.TrailFlipbooks = item:FindFirstChild("TrailFlipbooks")
		-- Texture / TextureMode / FaceCamera live on the cloned RT directly; no Configuration mirror.
		data.GraphBlender = item:FindFirstChild("GraphBlender")
		data.Pool = config:GetAttribute("Pool")
		return data
	end

	-- ATTACHMENT
	if item:IsA("Attachment") then
		data.PartLife = config:GetAttribute("PartLife") or 0
		data.DirMode = config:GetAttribute("DirMode") or ((config:GetAttribute("VelocityVectored") and "Local") or "RigidLocal")
		data.VelocityVectored = (data.DirMode == "Local")
		data.InvertMotion = config:GetAttribute("InvertMotion") or false
		data.RotMode = config:GetAttribute("RotMode") or "OverLife"
		data.RotOrder = config:GetAttribute("RotOrder") or "Global"
		data.Lifetime = config:GetAttribute("Lifetime") or NumberRange.new(1)
		data.Rate = config:GetAttribute("Rate") or 10

		data.EmissionDirection = safeEnum(Enum.NormalId, config:GetAttribute("EmissionDirection"), Enum.NormalId.Top)

		data.ParticleData = {
			SpreadAngle = config:GetAttribute("SpreadAngle") or Vector2.new(0, 0),
			Acceleration = config:GetAttribute("Acceleration") or Vector3.new(0, 0, 0),
			Drag = config:GetAttribute("Drag") or 0,
		}

		data.Speed = config:GetAttribute("Speed")
		data.Timescale = config:GetAttribute("Timescale")

		data.RotX = config:GetAttribute("RotX") or NumberRange.new(0)
		data.RotY = config:GetAttribute("RotY") or NumberRange.new(0)
		data.RotZ = config:GetAttribute("RotZ") or NumberRange.new(0)
		data.RotXEven = config:GetAttribute("RotXEven") == true
		data.RotYEven = config:GetAttribute("RotYEven") == true
		data.RotZEven = config:GetAttribute("RotZEven") == true

		data.PosX = config:GetAttribute("PosX") or NumberRange.new(0)
		data.PosY = config:GetAttribute("PosY") or NumberRange.new(0)
		data.PosZ = config:GetAttribute("PosZ") or NumberRange.new(0)
		data.PosXEven = config:GetAttribute("PosXEven") == true
		data.PosYEven = config:GetAttribute("PosYEven") == true
		data.PosZEven = config:GetAttribute("PosZEven") == true
		data.PosMode = config:GetAttribute("PosMode") or "Local"
		data.DisplacementMode = config:GetAttribute("DisplacementMode") or "Global"

		data.RotSpeedX = config:GetAttribute("RotSpeedX")
		data.RotSpeedY = config:GetAttribute("RotSpeedY")
		data.RotSpeedZ = config:GetAttribute("RotSpeedZ")

		data.PosOffsetX = config:GetAttribute("PosOffsetX")
		data.PosOffsetY = config:GetAttribute("PosOffsetY")
		data.PosOffsetZ = config:GetAttribute("PosOffsetZ")

		data.Orientation = config:GetAttribute("Orientation") or "None"
		data.ZOffset = config:GetAttribute("ZOffset") or 0

		data.AxisLinks = readAxisLinks(config)
		data.Pool = config:GetAttribute("Pool")

		return data
	end

	data.PartLife = config:GetAttribute("PartLife") or 0

	-- BEAM
	if item:IsA("Beam") then
		data.GraphBlender = item:FindFirstChild("GraphBlender")
		data.Lifetime = config:GetAttribute("BeamLifetime") or NumberRange.new(1)
		data.Rate = config:GetAttribute("Rate") or 10

		data.BeamFlipbooks = item:FindFirstChild("BeamFlipbooks")
		data.FlipbookParticle = {
			FlipbookMode = safeEnum(Enum.ParticleFlipbookMode, config:GetAttribute("BeamFlipbookMode"), nil),
			FlipbookFramerate = config:GetAttribute("BeamFlipbookFramerate") or nil,
			FlipbookStartRandom = config:GetAttribute("BeamFlipbookStartRandom") or false,
			FlipbookReverse = config:GetAttribute("BeamFlipbookReverse") or false,
		}

		if data.BeamFlipbooks then
			data.CachedBeamTextures = MeshFlipMod.GetSortedBeamTextures(data.BeamFlipbooks)
		end

		data.FaceCamera = config:GetAttribute("FaceCamera")
		data.ZOffset = config:GetAttribute("ZOffset")
		data.TextureMode = safeEnum(Enum.TextureMode, config:GetAttribute("BeamTextureMode"), nil)
		data.BeamProps = {
			Brightness = config:GetAttribute("BeamBrightness"),
			CurveSize0 = config:GetAttribute("CurveSize0"),
			CurveSize1 = config:GetAttribute("CurveSize1"),
			Width0 = config:GetAttribute("Width0"),
			Width1 = config:GetAttribute("Width1"),
			LightEmission = config:GetAttribute("LightEmission"),
			LightInfluence = config:GetAttribute("BeamLightInfluence"),
			Segments = config:GetAttribute("Segments"),
			TextureLength = config:GetAttribute("TextureLength"),
			TextureSpeed = config:GetAttribute("TextureSpeed"),
		}
		data.BeamTimescale = config:GetAttribute("BeamTimescale")
		data.Pool = config:GetAttribute("Pool")
		return data
	end

	-- PART (default)
	data.MeshFlipbooks = item:FindFirstChild("MeshFlipbooks")
	if data.MeshFlipbooks then
		data.CachedMeshTextures = MeshFlipMod.GetSortedTextures(data.MeshFlipbooks)
	end

	data.DirMode = config:GetAttribute("DirMode") or ((config:GetAttribute("VelocityVectored") and "Local") or "RigidLocal")
	data.VelocityVectored = (data.DirMode == "Local")
	data.InvertMotion = config:GetAttribute("InvertMotion") or false
	data.RotMode = config:GetAttribute("RotMode") or "OverLife"
	data.RotOrder = config:GetAttribute("RotOrder") or "Global"
	data.Lifetime = config:GetAttribute("Lifetime") or NumberRange.new(1)
	data.Rate = config:GetAttribute("Rate") or 10

	-- Target acceleration: AccelTarget readable types match getTargetPosition's dispatch
	-- (BasePart, Attachment, Camera, Model via GetPivot, Bone via TransformedWorldCFrame).
	data.AccelerationTowardsInstance = config:GetAttribute("AccelerationTowardsInstance") or false
	data.AccelStrength = config:GetAttribute("AccelStrength") or NumberSequence.new(0)
	do
		local at = item:FindFirstChild("AccelTarget")
		local picked = at and at:IsA("ObjectValue") and at.Value or nil
		if picked and (picked:IsA("BasePart") or picked:IsA("Attachment") or picked:IsA("Camera") or picked:IsA("Model") or picked:IsA("Bone")) then
			data.AccelTarget = picked
		else
			data.AccelTarget = nil
		end
	end
	-- ShapePart override (Part with UseShape=true): if set, particles sample shape volume
	-- + spawn at this BasePart's CFrame instead of the source's. nil = source fallback.
	do
		local sp = item:FindFirstChild("ShapePart")
		local picked = sp and sp:IsA("ObjectValue") and sp.Value or nil
		if picked and picked:IsA("BasePart") and picked.Parent then
			data.ShapePart = picked
		else
			data.ShapePart = nil
		end
	end

	data.Shape = safeEnum(Enum.ParticleEmitterShape, config:GetAttribute("Shape"), Enum.ParticleEmitterShape.Box)
	data.ShapeInOut = safeEnum(Enum.ParticleEmitterShapeInOut, config:GetAttribute("ShapeInOut"), Enum.ParticleEmitterShapeInOut.Outward)
	data.EmissionDirection = safeEnum(Enum.NormalId, config:GetAttribute("EmissionDirection"), Enum.NormalId.Top)
	data.UseShape = config:GetAttribute("UseShape") == true
	data.LookAtInitially = config:GetAttribute("LookAtInitially") == true

	data.ParticleData = {
		Shape = data.Shape,
		ShapeInOut = data.ShapeInOut,
		ShapePartial = math.clamp(config:GetAttribute("ShapePartial") or 0, 0, 1),
		UseShape = data.UseShape,
		LookAtInitially = data.LookAtInitially,
		EmissionDirection = data.EmissionDirection,
		SpreadAngle = config:GetAttribute("SpreadAngle") or Vector2.new(0, 0),
		Acceleration = config:GetAttribute("Acceleration") or Vector3.new(0, 0, 0),
		Drag = config:GetAttribute("Drag") or 0,
		FlipbookMode = safeEnum(Enum.ParticleFlipbookMode, config:GetAttribute("FlipbookMode"), nil),
		FlipbookFramerate = config:GetAttribute("FlipbookFramerate") or nil,
		FlipbookStartRandom = config:GetAttribute("FlipbookStartRandom") or false,
		FlipbookReverse = config:GetAttribute("FlipbookReverse") or false,
	}

	data.Transparency = config:GetAttribute("Transparency")
	data.Color = config:GetAttribute("Color")
	data.Speed = config:GetAttribute("Speed")
	data.Brightness = config:GetAttribute("Brightness")
	data.Timescale = config:GetAttribute("Timescale")

	data.AxisLinks = readAxisLinks(config)

	data.SizeX = config:GetAttribute("SizeX")
	data.SizeY = config:GetAttribute("SizeY")
	data.SizeZ = config:GetAttribute("SizeZ")

	data.RotX = config:GetAttribute("RotX") or NumberRange.new(0)
	data.RotY = config:GetAttribute("RotY") or NumberRange.new(0)
	data.RotZ = config:GetAttribute("RotZ") or NumberRange.new(0)
	data.RotXEven = config:GetAttribute("RotXEven") == true
	data.RotYEven = config:GetAttribute("RotYEven") == true
	data.RotZEven = config:GetAttribute("RotZEven") == true

	data.PosX = config:GetAttribute("PosX") or NumberRange.new(0)
	data.PosY = config:GetAttribute("PosY") or NumberRange.new(0)
	data.PosZ = config:GetAttribute("PosZ") or NumberRange.new(0)
	data.PosXEven = config:GetAttribute("PosXEven") == true
	data.PosYEven = config:GetAttribute("PosYEven") == true
	data.PosZEven = config:GetAttribute("PosZEven") == true
	data.PosMode = config:GetAttribute("PosMode") or "Local"
	data.DisplacementMode = config:GetAttribute("DisplacementMode") or "Global"

	data.RotSpeedX = config:GetAttribute("RotSpeedX")
	data.RotSpeedY = config:GetAttribute("RotSpeedY")
	data.RotSpeedZ = config:GetAttribute("RotSpeedZ")

	data.PosOffsetX = config:GetAttribute("PosOffsetX")
	data.PosOffsetY = config:GetAttribute("PosOffsetY")
	data.PosOffsetZ = config:GetAttribute("PosOffsetZ")

	data.Orientation = config:GetAttribute("Orientation") or "None"
	data.ZOffset = config:GetAttribute("ZOffset") or 0

	data.Pool = config:GetAttribute("Pool")

	return data
end

end
]]></string>
            </Properties>
