          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">Graph</string>
              <string name="Source"><![CDATA[-- Graph  -  sampling primitives for NumberSequence + ColorSequence graphs.
-- Seed shape: {[keypointIndex] = number}. Single intensity per seed correlates drift
-- across keypoints (adjacent points drift together instead of jittering independently).

local function clamp(x, a, b) if x < a then return a end if x > b then return b end return x end
local function lerp(a, b, t) return a + (b - a) * t end

local Graph = {}

-- Roll a fresh envelope seed; each keypoint gets ±intensity*Envelope (one intensity, one sign).
function Graph.GenerateSeed(graph: NumberSequence?)
	local seed = {}
	-- Legacy items can lack newly-added graphs; empty seed → QueryPointsWithTime falls through.
	if not graph or typeof(graph) ~= "NumberSequence" then return seed end
	local kp = graph.Keypoints
	local intensity = math.random()
	local isPositive = math.random() >= 0.5
	for i = 1, #kp do
		if kp[i].Envelope > 0 then
			if isPositive then
				seed[i] = intensity * kp[i].Envelope
			else
				seed[i] = -intensity * kp[i].Envelope
			end
		end
	end
	return seed
end

function Graph.GenerateSeeds(graph: NumberSequence, NoOfSeeds: number)
	local seeds = {}
	for i = 1, NoOfSeeds do
		seeds[i] = Graph.GenerateSeed(graph)
	end
	return seeds
end

-- Sample a NumberSequence at t∈[0,1] with optional envelope seed.
function Graph.QueryPointsWithTime(t: number, graph: NumberSequence, seed: {number})
	t = math.clamp(t, 0, 1)
	local keypoints = graph.Keypoints
	local n = #keypoints

	if n == 1 then return keypoints[1].Value + (seed[1] or 0) end

	local lo, hi = 1, n
	while lo < hi - 1 do
		local mid = (lo + hi) // 2
		if keypoints[mid].Time <= t then lo = mid else hi = mid end
	end
	local k1 = keypoints[lo]
	local k2 = keypoints[lo + 1]
	local span = k2.Time - k1.Time
	local point = span > 0 and (t - k1.Time) / span or 0
	local k1value = k1.Value + (seed[lo] or 0)
	local k2value = k2.Value + (seed[lo + 1] or 0)
	return k1value + ((k2value - k1value) * point)
end

-- Sample a ColorSequence at t∈[0,1]. ColorSequences have no envelope, so no seed.
function Graph.QueryColorPointWithTime(t: number, graph: ColorSequence)
	t = math.clamp(t, 0, 1)
	local kp = graph.Keypoints
	local n = #kp
	if n == 0 then return Color3.new(1, 1, 1) end
	if n == 1 then return kp[1].Value end
	if t <= kp[1].Time then return kp[1].Value end

	local lo, hi = 1, n
	while lo < hi - 1 do
		local mid = (lo + hi) // 2
		if kp[mid].Time <= t then lo = mid else hi = mid end
	end
	local k1 = kp[lo]
	local k2 = kp[lo + 1]
	local span = k2.Time - k1.Time
	local point = span > 0 and (t - k1.Time) / span or 0
	return k1.Value:Lerp(k2.Value, point)
end

-- Trapezoidal integral of a NumberSequence over [0, t]. Used by TextureSpeed.
function Graph.IntegrateUpTo(t: number, sequence: NumberSequence, seed: {number}): number
	t = math.clamp(t, 0, 1)
	local keypoints = sequence.Keypoints
	local n = #keypoints
	if n == 0 then return 0 end
	if n == 1 then return (keypoints[1].Value + (seed[1] or 0)) * t end

	local total = 0
	for i = 1, n - 1 do
		local k1 = keypoints[i]
		local k2 = keypoints[i + 1]
		if t <= k1.Time then break end

		local v1 = k1.Value + (seed[i] or 0)
		local v2 = k2.Value + (seed[i + 1] or 0)
		local segEnd = math.min(t, k2.Time)
		local segLength = segEnd - k1.Time
		local span = k2.Time - k1.Time
		local alpha = span > 0 and (segEnd - k1.Time) / span or 0
		local vEnd = v1 + (v2 - v1) * alpha

		total = total + (v1 + vEnd) / 2 * segLength
		if t <= k2.Time then break end
	end
	return total
end

-- True if the sequence produces a constant value (single keypoint zero-envelope or all-equal).
function Graph.IsStatic(sequence: NumberSequence): boolean
	if not sequence then return true end
	local kps = sequence.Keypoints
	-- Non-zero envelope → per-particle randomness, so not static.
	if #kps == 1 then return kps[1].Envelope == 0 end
	local val = kps[1].Value
	if kps[1].Envelope ~= 0 then return false end
	for i = 2, #kps do
		if kps[i].Value ~= val or kps[i].Envelope ~= 0 then return false end
	end
	return true
end

function Graph.GetStaticValue(sequence: NumberSequence, defaultValue: number): number
	if not sequence or #sequence.Keypoints == 0 then
		return defaultValue
	end
	return sequence.Keypoints[1].Value
end

-- Merge unique sorted times from two NumberSequence or ColorSequence (both expose Keypoints[].Time).
local function _mergeSequenceTimes(seqA, seqB)
	local times = {}
	local seen = {}
	for _, seq in ipairs({seqA, seqB}) do
		for _, kp in ipairs(seq.Keypoints) do
			if not seen[kp.Time] then
				seen[kp.Time] = true
				table.insert(times, kp.Time)
			end
		end
	end
	table.sort(times)
	return times
end

function Graph.BlendGraphWithTime(GraphA: NumberSequence, GraphB: NumberSequence, SpeedGraph: NumberSequence, alpha: number)
	alpha = clamp(alpha or 1, 0, 1)
	local times = _mergeSequenceTimes(GraphA, GraphB)
	local blendFactor = Graph.QueryPointsWithTime(alpha, SpeedGraph, {})

	local newKps = {}
	for _, t in ipairs(times) do
		local valA = Graph.QueryPointsWithTime(t, GraphA, {})
		local valB = Graph.QueryPointsWithTime(t, GraphB, {})
		table.insert(newKps, NumberSequenceKeypoint.new(t, lerp(valA, valB, blendFactor)))
	end
	return NumberSequence.new(newKps)
end

function Graph.BlendColorGraphWithTime(GraphA: ColorSequence, GraphB: ColorSequence, SpeedGraph: NumberSequence, alpha: number)
	alpha = clamp(alpha or 1, 0, 1)
	local times = _mergeSequenceTimes(GraphA, GraphB)
	local blendFactor = Graph.QueryPointsWithTime(alpha, SpeedGraph, {})

	local newKps = {}
	for _, t in ipairs(times) do
		local colorA = Graph.QueryColorPointWithTime(t, GraphA)
		local colorB = Graph.QueryColorPointWithTime(t, GraphB)
		table.insert(newKps, ColorSequenceKeypoint.new(t, colorA:Lerp(colorB, blendFactor)))
	end
	return ColorSequence.new(newKps)
end

-- Linear blend between two NumberSequences at alpha (no speed graph). Beam graph blender.
function Graph.LerpGraph(GraphA: NumberSequence, GraphB: NumberSequence, alpha: number): NumberSequence
	alpha = clamp(alpha or 0, 0, 1)
	local times = _mergeSequenceTimes(GraphA, GraphB)
	local newKps = {}
	for _, t in ipairs(times) do
		local valA = Graph.QueryPointsWithTime(t, GraphA, {})
		local valB = Graph.QueryPointsWithTime(t, GraphB, {})
		table.insert(newKps, NumberSequenceKeypoint.new(t, lerp(valA, valB, alpha)))
	end
	return NumberSequence.new(newKps)
end

function Graph.LerpColorGraph(GraphA: ColorSequence, GraphB: ColorSequence, alpha: number): ColorSequence
	alpha = clamp(alpha or 0, 0, 1)
	local times = _mergeSequenceTimes(GraphA, GraphB)
	local newKps = {}
	for _, t in ipairs(times) do
		local colorA = Graph.QueryColorPointWithTime(t, GraphA)
		local colorB = Graph.QueryColorPointWithTime(t, GraphB)
		table.insert(newKps, ColorSequenceKeypoint.new(t, colorA:Lerp(colorB, alpha)))
	end
	return ColorSequence.new(newKps)
end

-- Cache merged times once at emit time so per-frame LerpGraphFast skips the merge.
function Graph.PrecomputeMergedTimes(GraphA: NumberSequence, GraphB: NumberSequence): {number}
	return _mergeSequenceTimes(GraphA, GraphB)
end

function Graph.PrecomputeMergedColorTimes(GraphA: ColorSequence, GraphB: ColorSequence): {number}
	return _mergeSequenceTimes(GraphA, GraphB)
end

-- Endpoint short-circuit: alpha 0/1 returns the source sequence to skip per-frame allocation.
function Graph.LerpGraphFast(GraphA: NumberSequence, GraphB: NumberSequence, alpha: number, mergedTimes: {number}): NumberSequence
	alpha = clamp(alpha or 0, 0, 1)
	if alpha == 0 then return GraphA end
	if alpha == 1 then return GraphB end
	local newKps = {}
	for _, t in ipairs(mergedTimes) do
		local valA = Graph.QueryPointsWithTime(t, GraphA, {})
		local valB = Graph.QueryPointsWithTime(t, GraphB, {})
		table.insert(newKps, NumberSequenceKeypoint.new(t, lerp(valA, valB, alpha)))
	end
	return NumberSequence.new(newKps)
end

function Graph.LerpColorGraphFast(GraphA: ColorSequence, GraphB: ColorSequence, alpha: number, mergedTimes: {number}): ColorSequence
	alpha = clamp(alpha or 0, 0, 1)
	if alpha == 0 then return GraphA end
	if alpha == 1 then return GraphB end
	local newKps = {}
	for _, t in ipairs(mergedTimes) do
		local colorA = Graph.QueryColorPointWithTime(t, GraphA)
		local colorB = Graph.QueryColorPointWithTime(t, GraphB)
		table.insert(newKps, ColorSequenceKeypoint.new(t, colorA:Lerp(colorB, alpha)))
	end
	return ColorSequence.new(newKps)
end

-- Collect Beam GraphBlender states from Configuration children (Time/Transparency/Color attrs).
function Graph.CollectGraphStates(graphBlender)
	local transStates, colorStates = {}, {}
	if not graphBlender then return transStates, colorStates end

	for _, child in pairs(graphBlender:GetChildren()) do
		if not child:IsA("Configuration") then continue end
		local time = child:GetAttribute("Time")
		if time == nil then
			local num = tonumber(string.match(child.Name, "%d+"))
			time = num and (num - 1) or 0
		end
		local trans = child:GetAttribute("Transparency")
		if trans and typeof(trans) == "NumberSequence" then
			table.insert(transStates, {Time = time, Graph = trans})
		end
		local color = child:GetAttribute("Color")
		if color and typeof(color) == "ColorSequence" then
			table.insert(colorStates, {Time = time, Graph = color})
		end
	end

	table.sort(transStates, function(a, b) return a.Time < b.Time end)
	table.sort(colorStates, function(a, b) return a.Time < b.Time end)
	-- Normalize fallback values into 0-1 range.
	for _, states in ipairs({transStates, colorStates}) do
		if #states > 1 and states[#states].Time > 1 then
			local maxTime = states[#states].Time
			if maxTime > 0 then for _, s in ipairs(states) do s.Time = s.Time / maxTime end end
		end
	end

	return transStates, colorStates
end

-- Initial _effectiveElapsed for a particle whose Timescale starts negative.
-- ts(0) < 0 → start at end of life (i=1), rewind to 0; otherwise start at 0.
function Graph.InitialEffectiveElapsed(graph, seed, lifeTime)
	if not graph or typeof(graph) ~= "NumberSequence" then return 0 end
	-- Empty seed fallback: i=0 is deterministic on the first keypoint regardless of envelope.
	local ts0 = Graph.QueryPointsWithTime(0, graph, seed or {})
	return (ts0 < 0) and lifeTime or 0
end

-- Scale a NumberSequence: values *= factor, envelopes *= abs(factor).
function Graph.ScaleSequence(seq, factor)
	if not seq or typeof(seq) ~= "NumberSequence" then return seq end
	local kps = seq.Keypoints
	local new = {}
	local absFactor = math.abs(factor)
	for _, kp in ipairs(kps) do
		table.insert(new, NumberSequenceKeypoint.new(kp.Time, kp.Value * factor, kp.Envelope * absFactor))
	end
	return NumberSequence.new(new)
end

return Graph
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">Highlight</string>
              <string name="Source"><![CDATA[--[[
	Highlight Mixin  -  Emit + Update for Highlight particles.
	Non-spatial (no motion, no Link). Animates FillColor / FillTransparency / OutlineColor /
	OutlineTransparency over Lifetime via NumberSequence + ColorSequence graphs. Adornee
	resolved at emit from the ObjectValue child; source.Parent fallback when unset.
]]

local GraphMod = require(script.Parent.Graph)
local RangeMod = require(script.Parent.Range)
local Pool = require(script.Parent.Pool)

return function(Particle)

-- Per-frame Heartbeat update for Highlight particles. Samples FillColor / FillTransparency /
-- OutlineColor / OutlineTransparency graphs at the current life step, with SetTimescale override
-- gating the time-axis.
function Particle:UpdateHighlight(pData, dt, currentTime)
	-- Signed-reverse timescale support: see Update.luau UpdatePart. SetTimescale override wins for its window.
	local real_i = math.min(math.max((currentTime - pData.StartTime) / pData.LifeTime, 0), 1)
	local ts
	if pData._tsOverride ~= nil and currentTime < (pData._tsOverrideUntil or 0) then
		ts = pData._tsOverride
	else
		ts = pData.Graphs.Timescale and GraphMod.QueryPointsWithTime(real_i, pData.Graphs.Timescale, pData.Seeds.Timescale) or 1
	end
	local dtTs = dt * ts
	local lifeTime = pData.LifeTime
	local priorEff = pData._effectiveElapsed or 0
	local newEff = priorEff + (pData._timeFrozen and 0 or dtTs)
	if newEff < 0 then newEff = 0 end
	if newEff > lifeTime then newEff = lifeTime end
	pData._effectiveElapsed = newEff
	local atForwardEnd = newEff >= lifeTime
	local atBackwardEnd = newEff <= 0
	local elapsedTime = newEff
	local i = elapsedTime / lifeTime

	if not pData.VisualPart or not pData.VisualPart.Parent then return true end
	if pData.TotalKeyFrames <= 0 then return true end
	local graphFinished = real_i >= 1
	local isDying = graphFinished and (atForwardEnd or atBackwardEnd)
	i = math.min(math.max(i, 0), 1)

	local targetStep = math.floor(i * pData.TotalKeyFrames)

	if targetStep ~= pData.CurrentStep then
		pData.CurrentStep = targetStep
		local steppedI = pData.CurrentStep / pData.TotalKeyFrames

		if pData.Graphs.HLFillColor and not pData.SkipColor then
			pData.VisualPart.FillColor = GraphMod.QueryColorPointWithTime(steppedI, pData.Graphs.HLFillColor)
		end
		if pData.Graphs.HLFillTransparency and not pData.SkipTransparency then
			pData.VisualPart.FillTransparency = GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.HLFillTransparency, pData.Seeds.HLFillTransparency)
		end
		if pData.Graphs.HLOutlineColor and not pData.SkipColor then
			pData.VisualPart.OutlineColor = GraphMod.QueryColorPointWithTime(steppedI, pData.Graphs.HLOutlineColor)
		end
		if pData.Graphs.HLOutlineTransparency and not pData.SkipTransparency then
			pData.VisualPart.OutlineTransparency = GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.HLOutlineTransparency, pData.Seeds.HLOutlineTransparency)
		end
	end

	return isDying
end

-- Adornee resolution: ObjectValue child → source.Adornee → source.Parent IF it's a BasePart or Model
-- (highlightable). Returning nil silently skips rendering  -  better than accidentally Adorneeing
-- Workspace and highlighting the whole place.
local function _resolveAdornee(data, source)
	if data.Adornee then return data.Adornee end
	local cur = source.Adornee
	if cur then return cur end
	local p = source.Parent
	if p and (p:IsA("BasePart") or p:IsA("Model")) then return p end
	return nil
end

-- Spawn a Highlight particle: clones RenderTemplate, resolves Adornee, registers in ActiveEmits.
function Particle:EmitHighlight(highlight, link, emitCtx)
	if not highlight or not highlight.Parent then return end
	local data = self:GetData(highlight)
	if not data or not data.RenderTemplate then return end

	-- PoolHide flipped Enabled=false on release; flip back here.
	local visual = Pool.acquireOrClone(data.RenderTemplate, "Highlight", data.Pool)
	visual.Archivable = false
	visual.Enabled = true
	if data.HLDepthMode then visual.DepthMode = data.HLDepthMode end
	visual.Adornee = _resolveAdornee(data, highlight)
	local parentInstance = data.EmitParent or highlight.Parent

	local safeLifeTime = RangeMod.RandomValueFromRange(data.Lifetime)
	if safeLifeTime <= 0 then safeLifeTime = 0.001 end

	local seedFillTrans = data.HLFillTransparency and GraphMod.GenerateSeed(data.HLFillTransparency) or {}
	local seedOutlineTrans = data.HLOutlineTransparency and GraphMod.GenerateSeed(data.HLOutlineTransparency) or {}
	local seedTimescale = GraphMod.GenerateSeed(data.HLTimescale)

	-- Apply initial values before parenting (1-frame pop prevention).
	if data.HLFillColor then
		visual.FillColor = GraphMod.QueryColorPointWithTime(0, data.HLFillColor)
	end
	if data.HLFillTransparency then
		visual.FillTransparency = GraphMod.QueryPointsWithTime(0, data.HLFillTransparency, seedFillTrans)
	end
	if data.HLOutlineColor then
		visual.OutlineColor = GraphMod.QueryColorPointWithTime(0, data.HLOutlineColor)
	end
	if data.HLOutlineTransparency then
		visual.OutlineTransparency = GraphMod.QueryPointsWithTime(0, data.HLOutlineTransparency, seedOutlineTrans)
	end

	visual.Parent = parentInstance

	local pData = {
		Type = "Highlight",
		VisualPart = visual,
		Events = data.Events,
		StartTime = os.clock(),
		TotalKeyFrames = math.max(1, data.TotalKeyFrames),
		CurrentStep = 0,
		LifeTime = safeLifeTime,
		PartLife = data.PartLife or 0,

		Graphs = {
			HLFillColor = data.HLFillColor,
			HLFillTransparency = data.HLFillTransparency,
			HLOutlineColor = data.HLOutlineColor,
			HLOutlineTransparency = data.HLOutlineTransparency,
			Timescale = data.HLTimescale,
		},
		Seeds = {
			HLFillTransparency = seedFillTrans,
			HLOutlineTransparency = seedOutlineTrans,
			Timescale = seedTimescale,
		},
		_effectiveElapsed = GraphMod.InitialEffectiveElapsed(data.HLTimescale, seedTimescale, safeLifeTime),
	}

	pData._sourceItem = highlight
	Particle._seedTsOverride(pData, highlight)
	if data.Pool ~= false then pData._sourceRT, pData._poolKind = data.RenderTemplate, "Highlight" end
	self:_registerEmit(pData, emitCtx)
end

-- Animate mode: operate on live RenderTemplate (no clone). Lifecycle.cancelAnimation restores the
-- intrinsic FillColor / Transparency / OutlineColor / Transparency from BeamSnapshot-equivalent.
function Particle:EmitHighlightAnimate(highlight, link, emitCtx)
	if not highlight or not highlight.Parent then return end
	if self.ActiveAnimates[highlight] then return end
	local data = self:GetData(highlight)
	if not data or not data.RenderTemplate then return end

	local visual = data.RenderTemplate -- LIVE source, not a clone

	-- Snapshot BEFORE mutating so cancelAnimation restores authored values (mirrors Beam pattern).
	local snapshot = {
		FillColor = visual.FillColor,
		FillTransparency = visual.FillTransparency,
		OutlineColor = visual.OutlineColor,
		OutlineTransparency = visual.OutlineTransparency,
		DepthMode = visual.DepthMode,
		Adornee = visual.Adornee,
		Enabled = visual.Enabled,
	}

	visual.Enabled = true
	if data.HLDepthMode then visual.DepthMode = data.HLDepthMode end
	visual.Adornee = _resolveAdornee(data, highlight)

	local safeLifeTime = RangeMod.RandomValueFromRange(data.Lifetime)
	if safeLifeTime <= 0 then safeLifeTime = 0.001 end

	local seedFillTrans = data.HLFillTransparency and GraphMod.GenerateSeed(data.HLFillTransparency) or {}
	local seedOutlineTrans = data.HLOutlineTransparency and GraphMod.GenerateSeed(data.HLOutlineTransparency) or {}
	local seedTimescale = GraphMod.GenerateSeed(data.HLTimescale)

	local pData = {
		Type = "Highlight",
		VisualPart = visual,
		Events = data.Events,
		StartTime = os.clock(),
		TotalKeyFrames = math.max(1, data.TotalKeyFrames),
		CurrentStep = 0,
		LifeTime = safeLifeTime,
		PartLife = data.PartLife or 0,
		IsAnimate = true,
		AnimateItem = highlight,
		HighlightSnapshot = snapshot,

		Graphs = {
			HLFillColor = data.HLFillColor,
			HLFillTransparency = data.HLFillTransparency,
			HLOutlineColor = data.HLOutlineColor,
			HLOutlineTransparency = data.HLOutlineTransparency,
			Timescale = data.HLTimescale,
		},
		Seeds = {
			HLFillTransparency = seedFillTrans,
			HLOutlineTransparency = seedOutlineTrans,
			Timescale = seedTimescale,
		},
		_effectiveElapsed = GraphMod.InitialEffectiveElapsed(data.HLTimescale, seedTimescale, safeLifeTime),
	}

	pData._sourceItem = highlight
	Particle._seedTsOverride(pData, highlight)
	self.ActiveAnimates[highlight] = pData
	self:_registerEmit(pData, emitCtx)
end

end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">ImageEmit</string>
              <string name="Source"><![CDATA[-- ImageEmit  -  Emit/Animate/Update for ImageLabel emitters.
-- 2D screen-space motion + flipbook (own Heartbeat branch, Type="ImageLabel").
-- Position = (Speed*direction + envVel) * dt; Acceleration + Drag drive envVel.

local ContentProvider = game:GetService("ContentProvider")
local GraphMod = require(script.Parent.Graph)
local RangeMod = require(script.Parent.Range)
local ScreenHost = require(script.Parent.ScreenHost)
local Pool = require(script.Parent.Pool)
local StaticPass = require(script.Parent.StaticPass)

return function(Particle)

-- Dedup keyed on Image asset ID so a noisy emit (rate=100/s) prints once per session.
local _warnedSheets = {}

-- Parent priority: EmitParent > nearest _PartIcleEmit ancestor (nested) > ScreenHost.
local function resolveImageParent(data, source)
	if data.EmitParent then return data.EmitParent end
	if source then
		local cur = source.Parent
		while cur and cur ~= game do
			if cur:GetAttribute("_PartIcleEmit") then return source.Parent end
			cur = cur.Parent
		end
	end
	return ScreenHost.get()
end

-- Sorted Decal children of ImageFlipbooks (numeric name).
local function gatherFlipbookDecals(folder)
	if not folder then return nil end
	local list = {}
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("Decal") then table.insert(list, child) end
	end
	table.sort(list, function(a, b)
		local an, bn = tonumber(a.Name), tonumber(b.Name)
		if an and bn then return an < bn end
		return a.Name < b.Name
	end)
	return #list > 0 and list or nil
end

-- Fire-and-forget PreloadAsync; ContentProvider de-dupes.
local function preloadEmitAssets(data, decals)
	local assetList = {}
	if decals then for _, d in ipairs(decals) do table.insert(assetList, d) end end
	if data.Image and data.Image ~= "" then table.insert(assetList, data.Image) end
	if #assetList == 0 then return end
	task.spawn(function() pcall(ContentProvider.PreloadAsync, ContentProvider, assetList) end)
end

-- Frame index per FlipbookMode. OneShot/PingPong scale across Lifetime; Loop uses framerate;
-- Random picks one per interval (per-pData state). StartRandom only affects Loop.
local function resolveFrame(pData, n, elapsed)
	if n <= 0 then return 0 end
	local mode = pData.FlipbookMode
	local frame
	if mode == Enum.ParticleFlipbookMode.OneShot then
		local t = pData.LifeTime > 0 and math.min(1, elapsed / pData.LifeTime) or 1
		frame = math.min(math.floor(t * n), n - 1)
	elseif mode == Enum.ParticleFlipbookMode.PingPong then
		local t = pData.LifeTime > 0 and math.min(1, elapsed / pData.LifeTime) or 1
		local cyc = t * 2
		if cyc <= 1 then frame = math.floor(cyc * n) else frame = math.floor((2 - cyc) * n) end
		frame = math.max(0, math.min(frame, n - 1))
	elseif mode == Enum.ParticleFlipbookMode.Random then
		local fr = pData.FlipbookFramerate or 24
		local interval = (fr > 0) and (1 / fr) or 1
		local intervalIdx = math.floor(elapsed / interval)
		if pData._lastRandomInterval ~= intervalIdx then
			pData._lastRandomInterval = intervalIdx
			pData._currentRandomFrame = math.random(0, n - 1)
		end
		frame = pData._currentRandomFrame or math.random(0, n - 1)
	else -- Loop (default)
		local raw = elapsed * pData.FlipbookFramerate + (pData.FlipbookStartOffset or 0) * n
		frame = math.floor(raw) % n
	end
	if pData.FlipbookReverse then frame = n - 1 - frame end
	return frame
end

-- Decals: swap .Image; Spritesheet: shift ImageRectOffset across a grid.
-- lastFrame dedup: skip the property write when frame index hasn't changed.
local function applyFlipbookFrame(pData, elapsed)
	if not pData.FlipbookFramerate or pData.FlipbookFramerate <= 0 then return end
	if pData.FlipbookSource == "Decals" and pData.FlipbookDecals then
		local n = #pData.FlipbookDecals
		if n == 0 then return end
		local frame = resolveFrame(pData, n, elapsed)
		if frame == pData._lastFlipbookFrame then return end
		pData._lastFlipbookFrame = frame
		local dec = pData.FlipbookDecals[frame + 1]
		if dec and dec.Texture then pData.VisualPart.Image = dec.Texture end
	elseif pData.FlipbookSource == "Spritesheet" then
		local cols = math.max(1, pData.GridCols or 1)
		local rows = math.max(1, pData.GridRows or 1)
		local total = cols * rows
		local frame = resolveFrame(pData, total, elapsed)
		local sheet = pData.SheetSize
		if not sheet then return end
		if frame == pData._lastFlipbookFrame then return end
		pData._lastFlipbookFrame = frame
		local fw, fh = sheet.X / cols, sheet.Y / rows
		pData.VisualPart.ImageRectSize = Vector2.new(fw, fh)
		pData.VisualPart.ImageRectOffset = Vector2.new((frame % cols) * fw, math.floor(frame / cols) * fh)
	end
end

-- Forward-integrate 2D motion over Lifetime and return final (endX, endY, endVelX,
-- endVelY). Mirrors UpdateImageLabel's per-frame math (Speed graph × 100 + Accel
-- × 100 + Drag decay), at coarse 60-step granularity. Used to seed InvertMotion's
-- spawn pose: position = end-pos, EnvVel = end-vel. Negative-dt integration then
-- retraces the forward trajectory exactly (accel-driven motion only reverses
-- correctly when starting EnvVel is the forward end-state, not zero).
local function _simulateForward2D(data, dirX, dirY, lifetime, seeds)
	local steps = 60
	local stepDt = lifetime / steps
	local accelX = (data.ImgAcceleration or Vector2.new()).X
	local accelY = (data.ImgAcceleration or Vector2.new()).Y
	local drag = data.ImgDrag or 0
	local posX, posY = 0, 0
	local envX, envY = 0, 0
	for s = 1, steps do
		local t = s / steps
		local speed = 0
		if data.ImgSpeed then
			speed = GraphMod.QueryPointsWithTime(t, data.ImgSpeed, seeds.ImgSpeed) * 100
		end
		envX += accelX * 100 * stepDt
		envY += accelY * 100 * stepDt
		if drag > 0 then
			local decay = math.max(0, 1 - drag * stepDt)
			envX *= decay; envY *= decay
		end
		posX += (speed * dirX + envX) * stepDt
		posY += (speed * dirY + envY) * stepDt
	end
	return posX, posY, envX, envY
end

-- Expose so Engine.luau's AnimateLoop replay can re-seed end-state per cycle.
Particle._computeImageLabelEndState = function(_self, data, dirX, dirY, lifetime, seeds)
	return _simulateForward2D(data, dirX, dirY, lifetime, seeds)
end

-- Build pData from data; shared by Emit + Animate.
local function buildImageLabelPData(data, visual, item, isAnimate)
	-- One walk + sort of ImageFlipbooks per emit; reused by frame-0 setup + pData stamp.
	local flipbookDecals = gatherFlipbookDecals(data.ImageFlipbooks)
	-- EmissionAngle: 0=right, 90=up, 180=left, 270=down. GUI Y is inverted.
	local ea = data.ImgEmissionAngle or 90
	local sp = data.ImgSpreadAngle or 0
	local angle = ea + (math.random() * 2 - 1) * sp
	local rad = math.rad(angle)
	local dx, dy = math.cos(rad), -math.sin(rad)
	-- InvertMotion: spawn at trajectory's END position + flip dt sign per frame so
	-- motion retraces backward to the original start. Don't flip dx/dy  -  velocity
	-- direction stays forward; the dt sign is what reverses traversal.

	local safeLife = RangeMod.RandomValueFromRange(data.Lifetime)
	if safeLife <= 0 then safeLife = 0.001 end

	local seeds = {
		ImageTransparency      = data.ImageTransparency and GraphMod.GenerateSeed(data.ImageTransparency) or {},
		BackgroundTransparency = data.BackgroundTransparency and GraphMod.GenerateSeed(data.BackgroundTransparency) or {},
		ImgSpeed               = data.ImgSpeed and GraphMod.GenerateSeed(data.ImgSpeed) or {},
		ImgRotSpeed            = data.ImgRotSpeed and GraphMod.GenerateSeed(data.ImgRotSpeed) or {},
		SizeScaleX             = data.SizeScaleX and GraphMod.GenerateSeed(data.SizeScaleX) or {},
		SizeScaleY             = data.SizeScaleY and GraphMod.GenerateSeed(data.SizeScaleY) or {},
		Timescale              = data.ImgTimescale and GraphMod.GenerateSeed(data.ImgTimescale) or {},
	}

	local initialRot = RangeMod.RandomValueFromRange(data.ImgRotRange or NumberRange.new(0))
	local baseSize = data.ImgSizeUDim or UDim2.fromOffset(100, 100)

	-- Frame 0 sample to avoid pop.
	if data.ImageTransparency then visual.ImageTransparency = GraphMod.QueryPointsWithTime(0, data.ImageTransparency, seeds.ImageTransparency) end
	if data.BackgroundTransparency then visual.BackgroundTransparency = GraphMod.QueryPointsWithTime(0, data.BackgroundTransparency, seeds.BackgroundTransparency) end
	if data.ImageColor3 then visual.ImageColor3 = GraphMod.QueryColorPointWithTime(0, data.ImageColor3) end
	if data.BackgroundColor3 then visual.BackgroundColor3 = GraphMod.QueryColorPointWithTime(0, data.BackgroundColor3) end
	visual.Image = data.Image or ""
	visual.ScaleType = data.ImgScaleType or Enum.ScaleType.Stretch
	visual.ResampleMode = data.ImgResampleMode or Enum.ResamplerMode.Default
	visual.AnchorPoint = data.ImgAnchorPoint or Vector2.new(0.5, 0.5)
	visual.ZIndex = data.ImgZIndex or 1
	visual.Rotation = initialRot
	local sx0 = data.SizeScaleX and GraphMod.QueryPointsWithTime(0, data.SizeScaleX, seeds.SizeScaleX) or 1
	local sy0 = data.SizeScaleY and GraphMod.QueryPointsWithTime(0, data.SizeScaleY, seeds.SizeScaleY) or 1
	visual.Size = UDim2.new(baseSize.X.Scale * sx0, baseSize.X.Offset * sx0, baseSize.Y.Scale * sy0, baseSize.Y.Offset * sy0)
	visual.Position = data.ImgPosition or UDim2.fromScale(0.5, 0.5)

	local framerate = 10
	if data.ImgFlipbookFramerate then framerate = RangeMod.RandomValueFromRange(data.ImgFlipbookFramerate) end

	-- StartRandom is Loop-only (resolveFrame ignores FlipbookStartOffset for
	-- OneShot / PingPong / Random). One shared start frame for visual setup +
	-- Loop runtime offset so the first Heartbeat doesn't snap to a different frame.
	local mode = data.ImgFlipbookMode or Enum.ParticleFlipbookMode.Loop
	local applyStartRandom = data.ImgFlipbookStartRandom and mode == Enum.ParticleFlipbookMode.Loop
	local startFrame = 0
	local startFrameOffset = 0

	-- Sheet size missing → whole-sheet render. Decals mode ignores SheetSize.
	local sheetSize = data.SheetSize

	-- Frame-0 flipbook setup so first tick isn't stuck on base Image.
	local source = data.ImgFlipbookSource or "Decals"
	-- Spritesheet mode silently no-ops both crop paths when SheetSize is nil (HTTP fetchAndStamp
	-- pending, denied, or worker 404). Warn once per asset so user gets an actionable diagnostic
	-- instead of staring at a full-sheet emit.
	if source == "Spritesheet" and not sheetSize and data.Image and data.Image ~= "" and not _warnedSheets[data.Image] then
		_warnedSheets[data.Image] = true
		warn(string.format("Part-Icles: Spritesheet flipbook  -  sheet dimensions unknown for %s. Emit will render full sheet until dimensions resolve.", data.Image))
	end
	if source == "Decals" then
		-- Reset lingering Spritesheet crop.
		visual.ImageRectSize = Vector2.new(0, 0); visual.ImageRectOffset = Vector2.new(0, 0)
		if flipbookDecals and #flipbookDecals > 0 then
			local n = #flipbookDecals
			if applyStartRandom then
				startFrame = math.random(0, n - 1)
				startFrameOffset = startFrame / n
			end
			local dec = flipbookDecals[startFrame + 1]
			if dec and dec.Texture and dec.Texture ~= "" then visual.Image = dec.Texture end
		end
	elseif source == "Spritesheet" and sheetSize then
		local cols = math.max(1, data.ImgGridCols or 1)
		local rows = math.max(1, data.ImgGridRows or 1)
		local total = cols * rows
		if applyStartRandom and total > 0 then
			startFrame = math.random(0, total - 1)
			startFrameOffset = startFrame / total
		end
		local fw, fh = sheetSize.X / cols, sheetSize.Y / rows
		visual.ImageRectSize = Vector2.new(fw, fh)
		visual.ImageRectOffset = Vector2.new((startFrame % cols) * fw, math.floor(startFrame / cols) * fh)
	end

	local pData = {
		Type = "ImageLabel",
		VisualPart = visual,
		StartTime = os.clock(),
		LifeTime = safeLife,
		TotalKeyFrames = math.max(1, data.TotalKeyFrames or 100),
		CurrentStep = 0,
		PartLife = data.PartLife or 0,

		BasePosition = data.ImgPosition or UDim2.fromScale(0.5, 0.5),
		BaseSize = baseSize,
		DirX = dx, DirY = dy,
		EnvVelX = 0, EnvVelY = 0,
		PosX = 0,  PosY = 0,
		AccelX = (data.ImgAcceleration or Vector2.new()).X,
		AccelY = (data.ImgAcceleration or Vector2.new()).Y,
		Drag = data.ImgDrag or 0,

		InitialRotation = initialRot,
		RotMode = data.ImgRotMode or "OverLife",
		AccRot = 0,
		InvertMotion = data.ImgInvertMotion or false,

		Graphs = {
			ImageTransparency      = data.ImageTransparency,
			BackgroundTransparency = data.BackgroundTransparency,
			ImgSpeed               = data.ImgSpeed,
			ImgRotSpeed            = data.ImgRotSpeed,
			SizeScaleX             = data.SizeScaleX,
			SizeScaleY             = data.SizeScaleY,
			ImageColor3            = data.ImageColor3,
			BackgroundColor3       = data.BackgroundColor3,
			Timescale              = data.ImgTimescale,
		},
		Seeds = seeds,
		_effectiveElapsed = GraphMod.InitialEffectiveElapsed(data.ImgTimescale, seeds.Timescale, safeLife),

		FlipbookSource   = data.ImgFlipbookSource or "Decals",
		FlipbookMode     = data.ImgFlipbookMode or Enum.ParticleFlipbookMode.Loop,
		FlipbookFramerate = framerate,
		FlipbookStartOffset = startFrameOffset,
		FlipbookReverse  = data.ImgFlipbookReverse or false,
		FlipbookDecals   = flipbookDecals,
		SheetSize = sheetSize,
		GridCols = data.ImgGridCols or 8,
		GridRows = data.ImgGridRows or 1,

		IsAnimate = isAnimate or nil,
		AnimateItem = isAnimate and item or nil,
	}

	-- InvertMotion: seed PosX/PosY + EnvVelX/Y to the forward trajectory's end-state
	-- and run elapsed counter from lifeTime back to 0 via per-frame _invertDtSign.
	-- EnvVel seed is required for accel-driven motion to reverse correctly  -  with
	-- EnvVel=0 the negative-dt integration accumulates accel in the wrong direction
	-- and doesn't retrace the forward path.
	if data.ImgInvertMotion then
		local endX, endY, endVelX, endVelY = _simulateForward2D(data, dx, dy, safeLife, seeds)
		pData.PosX, pData.PosY = endX, endY
		pData.EnvVelX, pData.EnvVelY = endVelX, endVelY
		pData._effectiveElapsed = safeLife
		pData._invertDtSign = -1
	end

	-- Static-graph short-circuit via shared StaticPass module. Constant-valued
	-- NumberSequence graphs nil out of pData.Graphs + stamp pData._static<Name>.
	-- Frame-0 setup already wrote the visual for ImageTransparency / BackgroundTransparency,
	-- so the nil'd-graph short-circuits the per-step write. Speed / RotSpeed / SizeScale
	-- store the constant on pData._static<Name>; UpdateImageLabel reads it instead of
	-- sampling. ColorSequence graphs not covered (ColorSequence has no IsStatic helper;
	-- color writes are already step-quantized).
	StaticPass.apply(pData)
	-- SizeScale both-axes-static collapse: when X and Y both constant, nil their static
	-- fields too so the per-frame Size block short-circuits entirely (frame-0 captured
	-- the visual Size). Mixed (one static, one dynamic) keeps the static field so the
	-- block samples only the dynamic axis.
	if pData._staticSizeScaleX and pData._staticSizeScaleY then
		pData._staticSizeScaleX = nil
		pData._staticSizeScaleY = nil
	end

	return pData
end

function Particle:EmitImageLabel(item, link, emitCtx)
	local data = self:GetData(item)
	if not data or not data.RenderTemplate then return end

	-- Pool reuse: fresh clones strip ImageFlipbooks (textures come from pData.FlipbookDecals);
	-- pooled clones already have it stripped from prior acquire.
	local visual = Pool.acquireOrClone(data.RenderTemplate, "ImageLabel", data.Pool)
	visual.Archivable = false
	visual.Visible = true
	local cloneFF = visual:FindFirstChild("ImageFlipbooks")
	if cloneFF then cloneFF:Destroy() end

	local pData = buildImageLabelPData(data, visual, item, false)
	pData.Link = link
	pData._sourceItem = item
	Particle._seedTsOverride(pData, item)
	pData.Events = data.Events
	if data.Pool ~= false then pData._sourceRT, pData._poolKind = data.RenderTemplate, "ImageLabel" end
	preloadEmitAssets(data, pData.FlipbookDecals)
	visual.Parent = resolveImageParent(data, item)
	self:_registerEmit(pData, emitCtx)

	-- Nested ImageLabels parent next to source via _PartIcleEmit ancestry; UDim2 Scale stays relative.
	for _, desc in visual:GetDescendants() do
		if desc:GetAttribute("Transformed") and desc:IsA("ImageLabel") then
			self:EnableEmit(desc, nil, emitCtx)
		end
	end
end

-- Singleton clone-animate; refuses duplicate emits while active.
function Particle:EmitImageLabelAnimate(item, link, emitCtx)
	if self.ActiveAnimates[item] then return end
	local data = self:GetData(item)
	if not data or not data.RenderTemplate then return end

	local visual = data.RenderTemplate:Clone()
	visual.Archivable = false
	visual.Visible = true
	visual:SetAttribute("_PartIcleEmit", true)
	local cloneFF = visual:FindFirstChild("ImageFlipbooks"); if cloneFF then cloneFF:Destroy() end

	local pData = buildImageLabelPData(data, visual, item, true)
	pData.Link = link
	pData._sourceItem = item
	Particle._seedTsOverride(pData, item)
	pData.Events = data.Events
	preloadEmitAssets(data, pData.FlipbookDecals)
	visual.Parent = resolveImageParent(data, item)
	self.ActiveAnimates[item] = pData
	self:_registerEmit(pData, emitCtx)

	for _, desc in visual:GetDescendants() do
		if desc:GetAttribute("Transformed") and desc:IsA("ImageLabel") then
			self:EnableEmit(desc, nil, emitCtx)
		end
	end
end

-- Per-frame update; returns true when lifetime ends.
function Particle:UpdateImageLabel(pData, dt, currentTime)
	local visual = pData.VisualPart
	if not visual or not visual.Parent then return true end
	if pData.TotalKeyFrames <= 0 then return true end

	-- Timescale v2 (signed reverse): see Update.luau UpdatePart. SetTimescale override wins for its window.
	local real_i = math.min(math.max((currentTime - pData.StartTime) / pData.LifeTime, 0), 1)
	local ts
	if pData._tsOverride ~= nil and currentTime < (pData._tsOverrideUntil or 0) then
		ts = pData._tsOverride
	else
		ts = pData.Graphs.Timescale and GraphMod.QueryPointsWithTime(real_i, pData.Graphs.Timescale, pData.Seeds.Timescale) or 1
	end
	dt = dt * ts
	-- InvertMotion: flip dt sign so elapsed counter walks back from lifeTime → 0
	-- (seeded at lifeTime in buildImageLabelPData). PosX/PosY were seeded to the
	-- trajectory's END so the negative-dt integration retraces backward.
	if pData._invertDtSign then dt = dt * pData._invertDtSign end
	local lifeTime = pData.LifeTime
	local priorEff = pData._effectiveElapsed or 0
	local newEff = priorEff + (pData._timeFrozen and 0 or dt)
	if newEff < 0 then newEff = 0 end
	if newEff > lifeTime then newEff = lifeTime end
	pData._effectiveElapsed = newEff
	-- After-clamp dt: boundary frames see partial step instead of overshooting.
	dt = newEff - priorEff
	local atForwardEnd = newEff >= lifeTime
	local atBackwardEnd = newEff <= 0
	local elapsed = newEff
	local i = elapsed / lifeTime
	local graphFinished = real_i >= 1
	local isDying = graphFinished and (atForwardEnd or atBackwardEnd)
	if i > 1 then i = 1 end
	if i < 0 then i = 0 end

	-- All motion + rotation + size + color/transparency writes gate on step advance
	-- (TotalKeyFrames quantization), matching Part / Beam / Highlight / etc. Sub-step
	-- frames accumulate dt into pData.AccumulatedDT; on step transition the accumulated
	-- delta drives one integration pass + one visual write batch. Flipbook stays per-frame
	-- because its cadence is FlipbookFramerate, independent of TKF.
	local graphs = pData.Graphs
	local seeds = pData.Seeds
	pData.AccumulatedDT = (pData.AccumulatedDT or 0) + dt

	local targetStep = math.floor(i * pData.TotalKeyFrames)
	if targetStep ~= pData.CurrentStep then
		local frameDT = pData.AccumulatedDT
		pData.AccumulatedDT = 0
		pData.CurrentStep = targetStep
		local t = targetStep / pData.TotalKeyFrames

		-- Speed sampled at step boundary. Drag decay still references continuous elapsed
		-- (math.exp closed form, identical to per-frame variant; not dt-dependent).
		local speed = 0
		if pData._staticImgSpeed then
			speed = pData._staticImgSpeed * 100
		elseif graphs.ImgSpeed then
			speed = GraphMod.QueryPointsWithTime(t, graphs.ImgSpeed, seeds.ImgSpeed) * 100
		end
		if speed ~= 0 and pData.Drag > 0 then speed = speed * math.exp(-pData.Drag * elapsed) end

		-- EnvVel integrates Acceleration over the cross-frame batch (frameDT). Drag decay
		-- linear-approx — frameDT bounded by step-interval (1/(TKF/LifeTime)) so for typical
		-- TKF=100 still small.
		pData.EnvVelX += pData.AccelX * 100 * frameDT
		pData.EnvVelY += pData.AccelY * 100 * frameDT
		if pData.Drag > 0 then
			local decay = math.max(0, 1 - pData.Drag * frameDT)
			pData.EnvVelX *= decay; pData.EnvVelY *= decay
		end

		local vx = speed * pData.DirX + pData.EnvVelX
		local vy = speed * pData.DirY + pData.EnvVelY
		pData.PosX += vx * frameDT
		pData.PosY += vy * frameDT
		local bp = pData.BasePosition
		visual.Position = UDim2.new(bp.X.Scale, bp.X.Offset + pData.PosX, bp.Y.Scale, bp.Y.Offset + pData.PosY)

		-- Rotation. OverLife = absolute angle; Speed = deg/sec accumulator. Both add InitialRotation.
		local rs
		if pData._staticImgRotSpeed then
			rs = pData._staticImgRotSpeed
		elseif graphs.ImgRotSpeed then
			rs = GraphMod.QueryPointsWithTime(t, graphs.ImgRotSpeed, seeds.ImgRotSpeed)
		end
		if rs then
			local newRot
			if pData.RotMode == "Speed" then
				pData.AccRot += rs * frameDT
				newRot = pData.InitialRotation + pData.AccRot
			else
				newRot = pData.InitialRotation + rs
			end
			if newRot ~= pData._lastRotation then
				visual.Rotation = newRot
				pData._lastRotation = newRot
			end
		end

		-- Size scale.
		local hasSizeX = pData._staticSizeScaleX or graphs.SizeScaleX
		local hasSizeY = pData._staticSizeScaleY or graphs.SizeScaleY
		if (hasSizeX or hasSizeY) and not pData.SkipSize then
			local sx = pData._staticSizeScaleX
				or (graphs.SizeScaleX and GraphMod.QueryPointsWithTime(t, graphs.SizeScaleX, seeds.SizeScaleX))
				or 1
			local sy = pData._staticSizeScaleY
				or (graphs.SizeScaleY and GraphMod.QueryPointsWithTime(t, graphs.SizeScaleY, seeds.SizeScaleY))
				or 1
			if sx ~= pData._lastSizeX or sy ~= pData._lastSizeY then
				local bs = pData.BaseSize
				visual.Size = UDim2.new(bs.X.Scale * sx, bs.X.Offset * sx, bs.Y.Scale * sy, bs.Y.Offset * sy)
				pData._lastSizeX, pData._lastSizeY = sx, sy
			end
		end

		-- Color / transparency. Gate on SkipColor / SkipTransparency for runtime overrides
		-- via payload.SetSkipColor / SetSkipTransparency.
		if graphs.ImageTransparency and not pData.SkipTransparency then visual.ImageTransparency = GraphMod.QueryPointsWithTime(t, graphs.ImageTransparency, seeds.ImageTransparency) end
		if graphs.BackgroundTransparency and not pData.SkipTransparency then visual.BackgroundTransparency = GraphMod.QueryPointsWithTime(t, graphs.BackgroundTransparency, seeds.BackgroundTransparency) end
		if graphs.ImageColor3 and not pData.SkipColor then visual.ImageColor3 = GraphMod.QueryColorPointWithTime(t, graphs.ImageColor3) end
		if graphs.BackgroundColor3 and not pData.SkipColor then visual.BackgroundColor3 = GraphMod.QueryColorPointWithTime(t, graphs.BackgroundColor3) end
	end

	-- Flipbook independent of TKF (uses FlipbookFramerate); runs per-frame with internal lastFrame dedup.
	applyFlipbookFrame(pData, elapsed)

	return isDying
end

-- AnimateLoop refresh: non-spatial fields only (spatial accumulators reset by replay).
function Particle:_refreshImageLabelAnimateNonSpatial(pData, freshData)
	if not freshData then return end
	local ea = freshData.ImgEmissionAngle or 90
	local sp = freshData.ImgSpreadAngle or 0
	local angle = ea + (math.random() * 2 - 1) * sp
	local rad = math.rad(angle)
	local dx, dy = math.cos(rad), -math.sin(rad)
	-- InvertMotion no longer flips dx/dy here. Engine's AnimateLoop branch handles
	-- inversion by seeding PosX/PosY to the trajectory's end + per-frame negative dt.
	pData.DirX = dx; pData.DirY = dy
	if freshData.ImgAcceleration then
		pData.AccelX = freshData.ImgAcceleration.X
		pData.AccelY = freshData.ImgAcceleration.Y
	end
	if freshData.ImgDrag ~= nil then pData.Drag = freshData.ImgDrag end
	if freshData.ImgPosition then pData.BasePosition = freshData.ImgPosition end
	if freshData.ImgSizeUDim then pData.BaseSize = freshData.ImgSizeUDim end
	if freshData.ImgRotMode then pData.RotMode = freshData.ImgRotMode end
	if freshData.ImgRotRange then pData.InitialRotation = RangeMod.RandomValueFromRange(freshData.ImgRotRange) end
	if freshData.ImgFlipbookSource then pData.FlipbookSource = freshData.ImgFlipbookSource end
	if freshData.ImgFlipbookMode then pData.FlipbookMode = freshData.ImgFlipbookMode end
	if freshData.ImgFlipbookFramerate then pData.FlipbookFramerate = RangeMod.RandomValueFromRange(freshData.ImgFlipbookFramerate) end
	if freshData.ImgFlipbookReverse ~= nil then pData.FlipbookReverse = freshData.ImgFlipbookReverse end
	if freshData.ImgGridCols then pData.GridCols = freshData.ImgGridCols end
	if freshData.ImgGridRows then pData.GridRows = freshData.ImgGridRows end
	if freshData.SheetSize ~= nil then pData.SheetSize = freshData.SheetSize end
	if freshData.ImageFlipbooks then pData.FlipbookDecals = gatherFlipbookDecals(freshData.ImageFlipbooks) end
	if freshData.ImgTimescale and pData.Graphs then pData.Graphs.Timescale = freshData.ImgTimescale; pData.Seeds.Timescale = GraphMod.GenerateSeed(freshData.ImgTimescale) end
end

end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">Lifecycle</string>
              <string name="Source"><![CDATA[--[[
	Lifecycle Mixin  -  cancelAnimation, Particle:Disable, EmitAnimate, EnableEmit.
	`_emitGen` attribute: each EnableEmit bumps + captures locally; delayed closures
	bail when live attribute has moved on. Disable also bumps to cancel pending closures.
]]

local Selection = game:GetService("Selection")
local RunService = game:GetService("RunService")
local IS_STUDIO = RunService:IsStudio()
-- Probe Plugin capability via Selection:Get; gates IsEdit + Selection sites below.
local IS_PLUGIN = pcall(function() return Selection:Get() end)
-- loopBody emit yield: PreRender on client so the resumed emit lands after Roblox's
-- attachment-transform propagation completes for the frame; Trail's first sample then
-- reads the clean spawn pose. Server falls back to Heartbeat (PreRender client-only).
local LOOP_YIELD_EVENT = RunService:IsClient() and RunService.PreRender or RunService.Heartbeat
local TypeRegistry = require(script.Parent.TypeRegistry)
local ParticlesMod = require(script.Parent.Particles)
local Events = require(script.Parent.Events)
local Pool = require(script.Parent.Pool)

return function(Particle)
	-- Cancel an in-flight Animate cycle: restore position, clean up, remove from ActiveEmits.
	-- Beam restores via snapshot + Enabled=false (no InitialAnchorCF on Beam pData).
	local function cancelAnimation(self, item)
		local existing = self.ActiveAnimates[item]
		if not existing then return end
		-- Snapshot-restore runs BEFORE the CFrame write below: with the inverse order,
		-- one Heartbeat frame could render the visual at initial-pose still carrying the
		-- final-cycle Width/Color/Transparency = visible 1-frame pop on cancel.
		if (existing.Type == "Beam" or existing.Type == "Highlight" or existing.Type == "TrailEmitter")
			and existing.VisualPart and existing.VisualPart.Parent then
			local snap = existing.BeamSnapshot or existing.HighlightSnapshot or existing.TrailEmitterSnapshot
			if snap then
				pcall(function()
					for name, value in pairs(snap) do existing.VisualPart[name] = value end
				end)
			end
			existing.VisualPart.Enabled = false
		end
		if existing.InitialAnchorCF and existing.VisualPart and existing.VisualPart.Parent then
			if existing.Type == "Model" then
				existing.VisualPart:PivotTo(existing.InitialAnchorCF)
				if existing.InitialScale then
					pcall(function() existing.VisualPart:ScaleTo(existing.InitialScale) end)
				end
			elseif existing.Type ~= "Beam" then
				existing.VisualPart.CFrame = existing.InitialAnchorCF
			end
		end
		-- Part/Attachment hide via Transparency=1 (mirrors finishAnimate in init.luau).
		if (existing.Type == "Part" or existing.Type == "Attachment") and existing.VisualPart and existing.VisualPart.Parent then
			pcall(function()
				existing.VisualPart.Transparency = 1
				if existing.HasDecal then
					local d = existing.VisualPart:FindFirstChildOfClass("Decal")
					if d then d.Transparency = 1 end
				end
			end)
		end
		if (existing.Type == "Screen" or existing.Type == "ImageLabel") and existing.VisualPart then
			pcall(function() existing.VisualPart:Destroy() end)
		end
		-- Native PE/Trail children clean themselves up via gen-token; no manual disable here.
		if existing._scaleMapKeys and self._parentScaleMap then
			for _, desc in ipairs(existing._scaleMapKeys) do
				self._parentScaleMap[desc] = nil
			end
		end
		for idx = #self.ActiveEmits, 1, -1 do
			if self.ActiveEmits[idx] == existing then
				local n = #self.ActiveEmits
				if idx < n then self.ActiveEmits[idx] = self.ActiveEmits[n] end
				self.ActiveEmits[n] = nil
				break
			end
		end
		self.ActiveAnimates[item] = nil
	end

	-- Public wrapper for Particle:Deactivate.
	function Particle:_cancelAnimation(item)
		cancelAnimation(self, item)
	end

	-- Stop all activity on item; flip config.Enabled=false so listener doesn't restart.
	-- Wraps user-driven attribute writes (AnimateLoop=false, Enabled=false, snapshot
	-- restore via cancelAnimation) in a single waypoint pair so undo reverts the whole
	-- disable as one step instead of leaving the user with an unrecoverable post-disable state.
	function Particle:Disable(item)
		if not item then return end
		-- Waypoints are a plugin-only undo-stack feature. The Part module also ships
		-- as the standalone Qwinkles-Particles-2-Module which runs in production
		-- game contexts where `ChangeHistoryService:SetWaypoint` is wrong (no-op or
		-- warning). Gate on `RunService:IsEdit()` so only Studio edit mode (the
		-- plugin) brackets the waypoint pair; runtime callers skip it cleanly.
		local CHS = IS_PLUGIN and game:GetService("RunService"):IsEdit() and game:GetService("ChangeHistoryService") or nil
		if CHS then CHS:SetWaypoint("Part-Icles: Before Disable") end
		if Particle.ActiveLoops[item] then
			task.cancel(Particle.ActiveLoops[item])
			Particle.ActiveLoops[item] = nil
		end
		-- Cancel chain-driven duration loops; multiple parallel chains possible.
		local chainBucket = Particle.ActiveChainLoops[item]
		if chainBucket then
			for _, t in ipairs(chainBucket) do pcall(task.cancel, t) end
			Particle.ActiveChainLoops[item] = nil
		end
		item:SetAttribute("AnimateLoop", false)
		-- Bump _emitGen so pending EnableEmit closures bail.
		local gen = (item:GetAttribute("_emitGen") or 0) + 1
		pcall(function() item:SetAttribute("_emitGen", gen) end)
		cancelAnimation(self, item)
		local config = TypeRegistry.getConfig(item)
		if config then config:SetAttribute("Enabled", false) end
		-- Clear playing flag + rolling EvenDistribution counter.
		pcall(function() item:SetAttribute("_PartIclePlaying", nil) end)
		pcall(function() item:SetAttribute("_evenRollingIdx", nil) end)
		for _, desc in ipairs(item:GetDescendants()) do
			if desc:GetAttribute("Transformed") then
				-- Nested transformed item (e.g. a Highlight inside a transformed Part):
				-- recurse Disable so its ActiveLoops / config.Enabled / native descendants
				-- clean up alongside the outer item's teardown.
				self:Disable(desc)
			elseif desc:IsA("ParticleEmitter") or desc:IsA("Trail") then
				ParticlesMod.CancelNative(desc)
			elseif desc:IsA("Beam") or desc:IsA("Highlight") then
				-- Raw Beam / Highlight descendants have no gen-token cancellation pathway;
				-- straight Enabled=false stops them. Mirrors AbsoluteEnable's descendant
				-- walk which already flips these types true.
				pcall(function() desc.Enabled = false end)
			end
		end
		-- Release live one-shots; backward walk for swap-and-pop. Route through
		-- _releaseOrDestroy so pool-eligible visuals re-enter the pool instead
		-- of forcing a cold re-warm on every Disable→Enable toggle.
		local active = self.ActiveEmits
		for idx = #active, 1, -1 do
			local pData = active[idx]
			if pData and pData._sourceItem == item then
				if pData.VisualPart and pData.VisualPart.Parent then
					self:_releaseOrDestroy(pData, pData.VisualPart)
				end
				if pData._scaleMapKeys and self._parentScaleMap then
					for _, desc in ipairs(pData._scaleMapKeys) do
						self._parentScaleMap[desc] = nil
					end
				end
				local n = #active
				if idx < n then active[idx] = active[n] end
				active[n] = nil
			end
		end
		-- PartLife linger clones outlive their pData. self._lingerByItem tracks them so
		-- Disable can finish them early. Idempotent linger-cap decrement via _lingerCounted
		-- attribute so the delayed callback doesn't double-decrement.
		if self._lingerByItem and self._lingerByItem[item] then
			for _, visualPart in ipairs(self._lingerByItem[item]) do
				if visualPart then
					local counted = false
					pcall(function() counted = visualPart:GetAttribute("_lingerCounted") == true end)
					if counted then
						self._lingerVisualCount = math.max(0, (self._lingerVisualCount or 0) - 1)
						pcall(function() visualPart:SetAttribute("_lingerCounted", nil) end)
					end
					if visualPart.Parent then
						pcall(function() visualPart:Destroy() end)
					end
				end
			end
			self._lingerByItem[item] = nil
		end
		if CHS then CHS:SetWaypoint("Part-Icles: Disable") end
	end

	-- Skip descendants under a nested Transformed item (recursion reaches them separately).
	local function _hasTransformedAncestor(desc, root)
		local p = desc.Parent
		while p and p ~= root do
			if p:GetAttribute("Transformed") then return true end
			p = p.Parent
		end
		return false
	end

	-- Recursive enable. Walks `item` + descendants:
	--   - Transformed item → cfg.Enabled=true + :Enable(math.huge). Sets _PartIclePlaying
	--     first so the EnabledLoop listener bails (prevents double-Enable / 1-frame pop).
	--   - Raw PE / Trail / Beam / Highlight descendant → .Enabled=true.
	--   - Container (Folder / Model / BasePart / Attachment) → walks descendants once,
	--     then recurses children with `_parentCovered` so raw descendants don't double-toggle.
	-- Pair with :AbsoluteDisable for full lifecycle. _parentCovered is internal.
	function Particle:AbsoluteEnable(item, _parentCovered)
		if not item then return end
		if item:GetAttribute("Transformed") then
			-- Set _PartIclePlaying BEFORE flipping cfg.Enabled so EnabledLoop.handleToggle
			-- bails on the attribute change (it gates on _PartIclePlaying). Otherwise the
			-- direct Enable below and the listener's handleToggle both spawn loopBody,
			-- causing a cancel+restart pop on every AbsoluteEnable call (visible 1-frame
			-- artifact on Animate mode, off-by-one emit shift on Emit mode). Particle:Disable
			-- clears the attribute on the matching AbsoluteDisable.
			pcall(function() item:SetAttribute("_PartIclePlaying", true) end)
			local config = TypeRegistry.getConfig(item)
			if config then config:SetAttribute("Enabled", true) end
			-- Direct Enable call covers standalone-runtime (no listener to react to attribute).
			self:Enable(item, nil, math.huge)
			return
		end
		if item:IsA("ParticleEmitter") or item:IsA("Trail") or item:IsA("Beam") or item:IsA("Highlight") then
			if _parentCovered then return end
			pcall(function() item.Enabled = true end)
			return
		end
		local shouldCover = (item:IsA("BasePart") or item:IsA("Attachment") or item:IsA("Model")) and not _parentCovered
		if shouldCover then
			for _, desc in ipairs(item:GetDescendants()) do
				if (desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam") or desc:IsA("Highlight"))
					and not desc:GetAttribute("Transformed")
					and not _hasTransformedAncestor(desc, item) then
					pcall(function() desc.Enabled = true end)
				end
			end
		end
		local covered = shouldCover or _parentCovered
		for _, child in item:GetChildren() do
			if item:IsA("BasePart") and child:IsA("BasePart") and not child:GetAttribute("Transformed") then
				continue
			end
			self:AbsoluteEnable(child, covered)
		end
	end

	-- Recursive disable. Inverse of :AbsoluteEnable:
	--   - Transformed item → :Disable (cancels loops, clears state, drops cfg.Enabled).
	--   - Raw PE / Trail / Beam / Highlight descendant → .Enabled=false.
	--   - Container → walks descendants once, recurses children with covered flag.
	-- _parentCovered is internal.
	function Particle:AbsoluteDisable(item, _parentCovered)
		if not item then return end
		if item:GetAttribute("Transformed") then
			self:Disable(item)
			return
		end
		if item:IsA("ParticleEmitter") or item:IsA("Trail") or item:IsA("Beam") or item:IsA("Highlight") then
			if _parentCovered then return end
			pcall(function() item.Enabled = false end)
			return
		end
		local shouldCover = (item:IsA("BasePart") or item:IsA("Attachment") or item:IsA("Model")) and not _parentCovered
		if shouldCover then
			for _, desc in ipairs(item:GetDescendants()) do
				if (desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam") or desc:IsA("Highlight"))
					and not desc:GetAttribute("Transformed")
					and not _hasTransformedAncestor(desc, item) then
					pcall(function() desc.Enabled = false end)
				end
			end
		end
		local covered = shouldCover or _parentCovered
		for _, child in item:GetChildren() do
			if item:IsA("BasePart") and child:IsA("BasePart") and not child:GetAttribute("Transformed") then
				continue
			end
			self:AbsoluteDisable(child, covered)
		end
	end

	-- Start one Animate cycle. 3D = animate source in-place; Screen/ImageLabel = singleton clone.
	function Particle:EmitAnimate(item, link, emitCtx)
		self:_warnIfNotActivated("EmitAnimate")
		local isCloneAnimate = item:IsA("BlurEffect")
			or item:IsA("BloomEffect")
			or item:IsA("ColorCorrectionEffect")
			or item:IsA("Atmosphere")
			or item:IsA("ImageLabel")
		if isCloneAnimate and self.ActiveAnimates[item] then return end
		cancelAnimation(self, item)
		if item:IsA("Beam") then self:EmitBeamAnimate(item, link, emitCtx)
		elseif item:IsA("Trail") and item:FindFirstChild("PartIcleProperties") then self:EmitTrailAnimate(item, link, emitCtx)
		elseif item:IsA("Highlight") then self:EmitHighlightAnimate(item, link, emitCtx)
		elseif item:IsA("Attachment") then self:EmitAttachmentAnimate(item, link, emitCtx)
		elseif item:IsA("Model") then self:EmitModelAnimate(item, link, emitCtx)
		elseif item:IsA("BlurEffect") then self:EmitBlurAnimate(item, link, emitCtx)
		elseif item:IsA("BloomEffect") then self:EmitBloomAnimate(item, link, emitCtx)
		elseif item:IsA("ColorCorrectionEffect") then self:EmitColorCorrectionAnimate(item, link, emitCtx)
		elseif item:IsA("Atmosphere") then self:EmitAtmosphereAnimate(item, link, emitCtx)
		elseif item:IsA("ImageLabel") then self:EmitImageLabelAnimate(item, link, emitCtx)
		elseif item:IsA("BasePart") then self:EmitPartAnimate(item, link, emitCtx) end
	end

	-- Emit honoring EmitCount + EmitDelay + EmitDuration. Animate mode: EmitDuration bounds AnimateLoop.
	function Particle:EnableEmit(item, link, emitCtx)
		self:_warnIfNotActivated("EnableEmit")
		local emissionMode = item:GetAttribute('EmissionMode') or "Emit"
		-- Zero-as-zero: missing EmitCount → default 1; explicit 0 → no emission.
		local rawEmitCount = item:GetAttribute('EmitCount')
		local emitCount = rawEmitCount == nil and 1 or rawEmitCount
		local emitDelay = item:GetAttribute('EmitDelay') or 0
		-- EmitDuration: number or "min,max" range string.
		local emitDuration = ParticlesMod.parseDuration(item:GetAttribute('EmitDuration')) or 0
		-- Animate items with default 0/0 still reach EmitAnimate (AnimateLoop drives them).
		if emissionMode ~= "Animate" and emitCount <= 0 and emitDuration <= 0 then return end

		-- Skip _emitGen serialization for: chain-driven (N parallel chains) and instant bursts.
		local isChainDriven = emitCtx and emitCtx.ChainCtx ~= nil
		local skipGenSerialization = isChainDriven or emitDuration <= 0
		local startGen
		if not skipGenSerialization then
			startGen = (item:GetAttribute("_emitGen") or 0) + 1
			pcall(function() item:SetAttribute("_emitGen", startGen) end)
		end
		-- Engine-session gen invalidates closures past Activate/Deactivate.
		local engineGen = self._engineGen or 0
		local function genStillCurrent()
			if self.Connection == nil then return false end
			if (self._engineGen or 0) ~= engineGen then return false end
			if not item.Parent then return false end
			if not skipGenSerialization and (item:GetAttribute("_emitGen") or 0) ~= startGen then
				return false
			end
			-- Nested-emit cancellation: parent's Engine cleanup flips _parentAlive[1].
			if emitCtx and emitCtx._parentAlive and not emitCtx._parentAlive[1] then return false end
			return true
		end

		if emissionMode == "Animate" then
			local function doAnimate()
				if not genStillCurrent() then return end
				if emitDuration > 0 then
					item:SetAttribute("AnimateLoop", true)
					task.delay(emitDuration, function()
						if not genStillCurrent() then return end
						if item:GetAttribute("AnimateLoop") then item:SetAttribute("AnimateLoop", false) end
					end)
				end
				self:EmitAnimate(item, link, emitCtx)
			end
			if emitDelay > 0 then task.delay(emitDelay, doAnimate) else doAnimate() end
			return
		end

		local config = TypeRegistry.getConfig(item)

		local function doEmit()
			if not genStillCurrent() then return end
			-- emitCtx threads EmitIndex/EmitCount for OnEmit payloads + EvenDistribution.
			for i = 1, emitCount do
				self:Emit(item, link, Events.withEmitIndexAndCount(emitCtx, i, emitCount))
			end
			if emitDuration > 0 then
				if isChainDriven then
					-- Chain-driven: independent loop, don't flip cfg.Enabled (stagger conflict).
					self:Enable(item, link, emitDuration, emitCtx)
				else
					-- User-driven duration emit: flip cfg.Enabled so the engine listener
					-- treats this as the canonical Enable cycle, schedule shared cleanup.
					-- Claim the item so a separate Part module instance skips its auto-Enable.
					item:SetAttribute("_PartIclePlaying", true)
					if config then config:SetAttribute("Enabled", true) end
					self:Enable(item, link, emitDuration, emitCtx)
					task.delay(emitDuration, function()
						if not genStillCurrent() then return end
						if config and config.Parent then config:SetAttribute("Enabled", false) end
						item:SetAttribute("_PartIclePlaying", nil)
					end)
				end
			end
		end

		if emitDelay > 0 then task.delay(emitDelay, doEmit) else doEmit() end
	end

	-- Continuous emit loop until duration / cfg.Enabled / parent / engine-gen drift.
	-- Animate mode short-circuits to AnimateLoop=true + EmitAnimate.
	function Particle:Enable(item, link, duration, emitCtx)
		self:_warnIfNotActivated("Enable")
		local data = self:GetData(item)
		if not data then return end
		local emissionMode = item:GetAttribute('EmissionMode') or "Emit"
		if emissionMode == "Animate" then
			item:SetAttribute("AnimateLoop", true)
			self:EmitAnimate(item, link, emitCtx)
			return
		end
		local loopDuration = duration or math.huge
		local config = TypeRegistry.getConfig(item)
		-- Chain-driven loops run parallel (own bucket); user-driven cancel-and-replace.
		local isChainDriven = emitCtx and emitCtx.ChainCtx ~= nil
		local engineGenAtStart = self._engineGen or 0
		local function loopBody()
			local startTime = os.clock()
			local emitAccum = 0 -- sub-frame Rate carry
			while true do
				if isChainDriven and (self._engineGen or 0) ~= engineGenAtStart then break end
				if not item or not item.Parent then
					if not isChainDriven then Particle.ActiveLoops[item] = nil end; break
				end
				if os.clock() - startTime >= loopDuration then
					if not isChainDriven then Particle.ActiveLoops[item] = nil end; break
				end
				if not isChainDriven and not data.CheckEnabled() then
					Particle.ActiveLoops[item] = nil; break
				end
				local dt = LOOP_YIELD_EVENT:Wait()
				-- Studio-unfocused pause; runtime always passes (Selection:Get is editor-only).
				if IS_STUDIO and IS_PLUGIN and not Particle._focused then
					local sel = Selection:Get()
					if #sel == 0 or (Particle._unfocusedAt > 0 and os.clock() - Particle._unfocusedAt > 600) then emitAccum = 0; continue end
				end
				local currentRate = config and config:GetAttribute("Rate") or 10
				if currentRate <= 0 then emitAccum = 0; continue end
				local interval = 1 / currentRate
				emitAccum = emitAccum + dt
				-- Only bump _evenRollingIdx when an Even toggle is enabled (attribute hygiene).
				local hasAnyEven = (data.RotXEven or data.RotYEven or data.RotZEven
					or data.PosXEven or data.PosYEven or data.PosZEven) == true
				while emitAccum >= interval do
					emitAccum = emitAccum - interval
					if hasAnyEven then
						local CYCLE_N = 12
						local prev = item:GetAttribute("_evenRollingIdx") or 0
						local nextIdx = ((prev) % CYCLE_N) + 1
						pcall(function() item:SetAttribute("_evenRollingIdx", nextIdx) end)
						self:Emit(item, link, Events.withEmitIndexAndCount(emitCtx, nextIdx, CYCLE_N))
					else
						self:Emit(item, link, emitCtx)
					end
				end
			end
		end
		if isChainDriven then
			-- Bucket per-item so Disable can cancel; task self-removes its entry on completion.
			local chainTask = task.spawn(function()
				loopBody()
				local selfThread = coroutine.running()
				local bucket = Particle.ActiveChainLoops[item]
				if not bucket then return end
				for i = #bucket, 1, -1 do
					if bucket[i] == selfThread then table.remove(bucket, i); break end
				end
				if #bucket == 0 then Particle.ActiveChainLoops[item] = nil end
			end)
			local bucket = Particle.ActiveChainLoops[item]
			if not bucket then bucket = {}; Particle.ActiveChainLoops[item] = bucket end
			table.insert(bucket, chainTask)
		else
			if Particle.ActiveLoops[item] then task.cancel(Particle.ActiveLoops[item]) end
			Particle.ActiveLoops[item] = task.spawn(loopBody)
		end
	end

	-- Origin override supported on Part/Attachment/Model only; reject + warn-once for others.
	local enableEmitAtUnsupported = {}
	local enableEmitAtAnimateWarned = false
	function Particle:EnableEmitAt(item, originCF, options)
		if not item or not item.Parent or not originCF then return end
		if not (item:IsA("BasePart") or item:IsA("Attachment") or item:IsA("Model")) then
			local key = item.ClassName
			if not enableEmitAtUnsupported[key] then
				enableEmitAtUnsupported[key] = true
				warn(("[Part-Icles] EnableEmitAt does not support %s targets (origin " ..
					"override is BasePart/Attachment/Model only). Emit skipped."):format(key))
			end
			return
		end
		-- Animate uses LIVE source RT; origin override would mutate authored position. Reject.
		if (item:GetAttribute("EmissionMode") or "Emit") == "Animate" then
			if not enableEmitAtAnimateWarned then
				enableEmitAtAnimateWarned = true
				warn("[Part-Icles] EnableEmitAt does not support Animate-mode targets " ..
					"in v1; use EmitMode=AtTarget for Animate sources. Emit skipped.")
			end
			return
		end
		options = options or {}
		-- Link override auto-disables IgnoreLink so the explicit ref reaches EmitPart.
		local hasLinkOverride = options.Link ~= nil
		local emitCtx = {
			ChainCtx            = options.ChainCtx,
			EventOriginCF       = originCF,
			EventOriginResolver = options.OriginResolver,
			UseFullOrigin       = options.UseFullOrigin ~= false,
			IgnoreLink          = options.IgnoreLink == true and not hasLinkOverride,
			Link                = options.Link,
			LinkMode            = options.LinkMode,
			EmitParent          = options.EmitParent,
		}
		self:EnableEmit(item, options.Link, emitCtx)
	end

	-- Register fresh pData: stamp chain id, insert ActiveEmits, seed OnHit raycast, fire OnEmit.
	function Particle:_registerEmit(pData, emitCtx)
		-- Active-particle cap (counts ActiveEmits + linger visuals).
		local cap = self.MAX_ACTIVE_PARTICLES or 1000
		if #self.ActiveEmits + (self._lingerVisualCount or 0) >= cap then
			-- 3D Animate uses LIVE source RT; can't destroy. Clone-Animate (Screen/ImageLabel) destroys.
			local liveRTAnimate = pData.IsAnimate and (pData.Type == "Part" or pData.Type == "Attachment"
				or pData.Type == "Beam" or pData.Type == "Model")
			if pData.IsAnimate and pData._sourceItem then self.ActiveAnimates[pData._sourceItem] = nil end
			if not liveRTAnimate and pData.VisualPart and pData.VisualPart.Parent then
				-- Cap-reject: route through _releaseOrDestroy so the visual enters the pool.
				-- a warm pool helps most.
				self:_releaseOrDestroy(pData, pData.VisualPart)
			end
			return
		end
		-- Root emits with no incoming emitCtx still get a fresh ChainCtx so OnEmit /
		-- OnDeath / OnHit on the same particle share identity (otherwise OnDeath would fire
		-- under a NEW root chain and chain-tracking across lifetime would break).
		pData.EventChainCtx = (emitCtx and emitCtx.ChainCtx) or pData.EventChainCtx or Events.newChainCtx()
		table.insert(self.ActiveEmits, pData)
		if pData.Events and pData.Events.OnHit then
			pData.LastHitCheckPos = Events.getWorldPosition(pData)
			pData.HitParams = Events.makeHitParams(pData)
			pData._hitFired = false
		end
		if pData.Events and pData.Events.OnEmit then
			-- Build payload explicitly so EmitIndex (per-burst index) reaches user scripts.
			-- Events.fire's nil-payload fallback can't synthesize EmitIndex because it
			-- doesn't see emitCtx.
			local payload = Events.makePayload(self, pData, "OnEmit", emitCtx)
			Events.fire(self, pData, "OnEmit", pData.EventChainCtx, payload)
		end
	end

	-- OnDeath fire helper; manual Kill suppresses unless fireOnDeath=true.
	function Particle:_fireOnDeath(pData)
		if pData.Events and pData.Events.OnDeath
			and (not pData._killedManually or pData._fireOnDeathOverride) then
			Events.fire(self, pData, "OnDeath", pData.EventChainCtx, nil)
		end
	end

	-- OnDestruction fire helper for Heartbeat destroy paths + finishAnimate.
	function Particle:_fireOnDestruction(pData, visualPart)
		if pData.Events and pData.Events.OnDestruction and visualPart and visualPart.Parent then
			Events.fire(self, pData, "OnDestruction", pData.EventChainCtx, nil)
		end
	end

	-- Release visual to pool when eligible, else Destroy. Animate visuals never pool.
	function Particle:_releaseOrDestroy(pData, visualPart)
		if not visualPart then return end
		if not visualPart.Parent then return end
		if pData.IsAnimate or not pData._sourceRT or not pData._poolKind then
			pcall(function() visualPart:Destroy() end)
			return
		end
		-- Live Rate read so pool cap tracks emitter rate.
		local rate
		local source = pData._sourceItem
		if source and source.Parent then
			local cfg = TypeRegistry.getConfig(source)
			if cfg then rate = cfg:GetAttribute("Rate") end
		end
		Pool.release(visualPart, pData._sourceRT, pData._poolKind, rate)
	end

	-- Engine-session predicate; ParticlesMod delayed closures bail on _engineGen drift.
	function Particle:_makeAliveCheck()
		local engineGen = self._engineGen or 0
		return function()
			return self.Connection ~= nil and (self._engineGen or 0) == engineGen
		end
	end

	-- AnimateLoop cycle restart: re-seed OnHit + fire OnEmit. EmitIndex nil for re-fires.
	function Particle:_fireAnimateCycleRestartEvents(pData)
		if pData.Events and pData.Events.OnHit then
			pData.LastHitCheckPos = Events.getWorldPosition(pData)
			pData.LastHitCheckTime = nil
		end
		if pData.Events and pData.Events.OnEmit then
			local payload = Events.makePayload(self, pData, "OnEmit", { ChainCtx = pData.EventChainCtx, EmitIndex = nil })
			Events.fire(self, pData, "OnEmit", pData.EventChainCtx, payload)
		end
	end

	-- payload.Kill flags-only; Heartbeat death branch destroys + restores. PartLife=0 forces immediate.
	-- Animate also flips AnimateLoop=false + cfg.Enabled=false so death branch goes to animate-finish.
	function Particle:_killParticle(pData, opts)
		opts = opts or {}
		pData._killedManually = true
		pData._fireOnDeathOverride = opts.fireOnDeath == true
		pData._forceDead = true
		pData.PartLife = 0
		if pData.IsAnimate then
			local source = pData._sourceItem
			if source then
				pcall(function()
					source:SetAttribute("AnimateLoop", false)
					-- Enabled is on Configuration, not item; route through config.
					local cfg = TypeRegistry.getConfig(source)
					if cfg then cfg:SetAttribute("Enabled", false) end
				end)
			end
		end
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">LinkService</string>
              <string name="Source"><![CDATA[--[[
	LinkService  -  standalone CFrame-tracking service.
	Users link arbitrary BaseParts / Models / Attachments to any target Instance
	(BasePart / Model / Attachment / Bone / Camera) using the same LinkMode dispatch
	as the particle runtime, without spawning particles.

	API:
	  LinkService:Activate()
	  LinkService:Deactivate()
	  LinkService:Link(part1, target, mode, duration)
	  LinkService:Clear(part1)
	  LinkService:IsLinked(part1) -> boolean

	mode: "Weld" | "Follow" | "Pivot" | "WeldWithoutRotation" (unknown -> "Weld")
	duration: optional number of seconds; nil = infinite. Entry auto-clears on expiry,
	          target destruction, or part1 destruction.

	Anchored is snapshotted at :Link time and forced true so Roblox physics does not
	fight per-frame CFrame writes; restored on :Clear / auto-expire.
]]

local RunService = game:GetService("RunService")
local Constants = require(script.Parent.PartConstants)

-- Resume in PreRender on client (after physics + attachment-transform propagation
-- complete; matches the Lifecycle.luau LOOP_YIELD_EVENT choice). Heartbeat on server
-- since PreRender is client-only.
local TICK_EVENT = RunService:IsClient() and RunService.PreRender or RunService.Heartbeat

local LinkService = {}

LinkService._active = false
LinkService._connection = nil
LinkService._links = {}
LinkService._anchorSnapshot = {}
LinkService._warnedNotActive = false

local VALID_MODES = {
	Weld = true,
	Follow = true,
	Pivot = true,
	WeldWithoutRotation = true,
}

local function _readPart1CF(part1)
	if part1:IsA("Model") then
		local ok, cf = pcall(part1.GetPivot, part1)
		if ok and cf then return cf end
		return CFrame.new()
	end
	if part1:IsA("Attachment") then return part1.WorldCFrame end
	return part1.CFrame
end

local function _classifyPart1(part1)
	if part1:IsA("Model") then return "Model" end
	if part1:IsA("Attachment") then return "Attachment" end
	return "Part"
end

-- Snapshot prior Anchored state + force true. Attachment has no Anchored  -  returns nil.
-- BasePart returns a bool. Model returns a table {[BasePart] = priorAnchored} so non-
-- PrimaryPart members do not free-fall under gravity while PivotTo drives PrimaryPart.
function LinkService:_captureAndAnchor(part1)
	if part1:IsA("BasePart") then
		local prior = part1.Anchored
		part1.Anchored = true
		return prior
	end
	if part1:IsA("Model") then
		local snapshot = {}
		for _, desc in ipairs(part1:GetDescendants()) do
			if desc:IsA("BasePart") then
				snapshot[desc] = desc.Anchored
				desc.Anchored = true
			end
		end
		return snapshot
	end
	return nil
end

function LinkService:_restoreAnchor(part1)
	local prior = self._anchorSnapshot[part1]
	self._anchorSnapshot[part1] = nil
	if prior == nil then return end
	if part1:IsA("BasePart") and part1.Parent then
		part1.Anchored = prior
		return
	end
	if part1:IsA("Model") and type(prior) == "table" then
		for desc, priorAnchored in pairs(prior) do
			if desc.Parent then desc.Anchored = priorAnchored end
		end
	end
end

-- Start the per-frame link-tracking loop. Idempotent.
function LinkService:Activate()
	if self._active then return end
	self._active = true
	self._connection = TICK_EVENT:Connect(function(dt)
		self:_tick(dt)
	end)
end

-- Stop tracking + clear every active link, restoring each part1's prior Anchored state.
function LinkService:Deactivate()
	if not self._active then return end
	self._active = false
	if self._connection then
		self._connection:Disconnect()
		self._connection = nil
	end
	for part1 in pairs(self._links) do
		self._links[part1] = nil
		self:_restoreAnchor(part1)
	end
end

-- Pin `part1`'s CFrame to follow `target` every frame using `mode` (Weld / Follow /
-- Pivot / WeldWithoutRotation). `duration` (optional seconds) auto-clears the link
-- when elapsed; nil = persist until Clear. Anchored is snapshotted+forced true so
-- physics does not fight the per-frame CFrame writes; restored on Clear.
function LinkService:Link(part1, target, mode, duration)
	if not part1 or not target then return end
	if part1 == target then return end
	if not (part1:IsA("BasePart") or part1:IsA("Model") or part1:IsA("Attachment")) then return end
	if not part1.Parent or not target.Parent then return end
	if not VALID_MODES[mode] then mode = "Weld" end
	if not self._active and not self._warnedNotActive then
		self._warnedNotActive = true
		warn("[Part-Icles LinkService] Link called before Activate(); the link won't update until you call LinkService:Activate(). This warning fires once.")
	end

	local targetCF = Constants.resolveLinkCFrame(target)
	local part1CF = _readPart1CF(part1)

	-- Snapshot Anchored on first Link only; re-Link of same part1 keeps the original
	-- prior-state so a Clear after multiple Links restores the truly-authored value.
	if self._anchorSnapshot[part1] == nil and not self._links[part1] then
		self._anchorSnapshot[part1] = self:_captureAndAnchor(part1)
	else
		-- Re-arm anchor flag in case user toggled it between Link calls.
		self:_captureAndAnchor(part1)
	end

	self._links[part1] = {
		target = target,
		mode = mode,
		offsetCF = targetCF:ToObjectSpace(part1CF),
		rotation = part1CF.Rotation,
		expiresAt = duration and (os.clock() + duration) or nil,
		partKind = _classifyPart1(part1),
	}
end

-- Stop tracking `part1`; restore its prior Anchored state. No-op if not linked.
function LinkService:Clear(part1)
	if not self._links[part1] then return end
	self._links[part1] = nil
	self:_restoreAnchor(part1)
end

-- Returns true when `part1` has an active link entry.
function LinkService:IsLinked(part1)
	return self._links[part1] ~= nil
end

function LinkService:_tick(dt)
	local now = os.clock()
	for part1, entry in pairs(self._links) do
		if not part1.Parent or not entry.target.Parent then
			self:Clear(part1)
		elseif entry.expiresAt and now >= entry.expiresAt then
			self:Clear(part1)
		else
			local targetCF = Constants.resolveLinkCFrame(entry.target)
			local newCF
			if entry.mode == "Weld" then
				newCF = targetCF * entry.offsetCF
			else
				-- Follow / Pivot / WeldWithoutRotation: position tracks the linked offset,
				-- rotation stays at the authored snapshot. WWR's mesh-frame variant from
				-- the particle pipeline doesn't apply outside emit; v1 treats it as Follow.
				newCF = CFrame.new((targetCF * entry.offsetCF).Position) * entry.rotation
			end
			if entry.partKind == "Model" then
				pcall(function() part1:PivotTo(newCF) end)
			elseif entry.partKind == "Attachment" then
				local parent = part1.Parent
				if parent and parent:IsA("BasePart") then
					part1.CFrame = parent.CFrame:ToObjectSpace(newCF)
				end
			else
				part1.CFrame = newCF
			end
		end
	end
end

return LinkService
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">LinkTrack</string>
              <string name="Source"><![CDATA[--[[
	LinkTrack Mixin  -  per-frame link transform reapply for Part / Model / Attachment.
	Runs every Heartbeat (outside the step gate) so linked particles track their link every frame.
	`pData._localWorldCF` is the link-relative composed CFrame stashed by UpdatePart/Model/Attachment.
	Attachment composes in actualParent-local space, mirroring getAttachmentLinkCF in Update.luau.
]]

local Constants = require(script.Parent.PartConstants)

return function(Particle)

-- Per-frame link-CFrame writer. Composes `pData._localWorldCF` against the live link
-- target and writes the result to `pData.VisualPart` so linked particles track their
-- link every Heartbeat. No-op when pData.Link is nil or destroyed.
function Particle:ReapplyLink(pData)
	local link = pData.Link
	if not link then return end
	-- Detect mid-flight link destruction: drop pData.Link so the next frame
	-- falls back to free-flying physics instead of freezing on the link's
	-- last CFrame (and avoiding a Model:GetPivot throw on a destroyed model
	-- with no PrimaryPart).
	if not link.Parent then
		pData.Link = nil
		return
	end
	local lcf = pData._localWorldCF
	if not lcf then return end
	if not pData.VisualPart or not pData.VisualPart.Parent then return end
	local t = pData.Type
	if t ~= "Part" and t ~= "Model" and t ~= "Attachment" then return end

	if t == "Attachment" then
		local visualParent = pData.VisualPart.Parent
		if not visualParent then return end
		local linkWorldCF = Constants.resolveLinkCFrame(link)
		local convCF = visualParent:IsA("BasePart") and visualParent.CFrame or CFrame.new()
		local linkLocalCF = convCF:ToObjectSpace(linkWorldCF)
		local parentCF_now
		if pData.LinkMode == "Follow" or pData.LinkMode == "Pivot" then
			parentCF_now = CFrame.new(linkLocalCF.Position)
		else
			parentCF_now = linkLocalCF
		end
		pData.VisualPart.CFrame = parentCF_now * lcf
		return
	end

	local linkCF = Constants.resolveLinkCFrame(link)
	local linkPos = linkCF.Position

	local lm = pData.LinkMode
	local newCF
	if lm == "WeldWithoutRotation" then
		-- Offset rotates with link, mesh rotation stays independent.
		local worldOffset = linkCF:VectorToWorldSpace(lcf.Position)
		local rotOnly = lcf - lcf.Position
		newCF = CFrame.new(linkPos + worldOffset) * rotOnly
	elseif lm == "Follow" or lm == "Pivot" then
		newCF = CFrame.new(linkPos) * lcf
	else -- Weld
		newCF = linkCF * lcf
	end

	if t == "Model" then
		pData.VisualPart:PivotTo(newCF)
	else
		pData.VisualPart.CFrame = newCF
	end
end

end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">NestedEmit</string>
              <string name="Source"><![CDATA[--[[
	NestedEmit - source-walk dispatcher for nested transformed Part-Icles.

	Walks SOURCE RenderTemplate (never clones nested-source subtrees). Each
	transformed leaf fires via particle:EnableEmit with link=clonedRoot, which
	EmitPart's link branch consumes for both initial spawn pose and per-frame
	tracking. parentAlive cancels nested closures on parent pData reclaim.
]]

local Pool = require(script.Parent.Pool)

local NestedEmit = {}

-- Walk source RT, fire each Transformed leaf. onNode(srcNode) optional pre-emit
-- hook (EmitModel uses for _parentScaleMap registration). _parentCloneMap forwards
-- Pool's source-to-clone map so nested Trail/Beam can rebind Attachment0/1.
function NestedEmit.walk(particle, sourceRT, clonedRoot, parentAlive, emitCtx, onNode)
	local parentCloneMap = Pool._cloneMaps and Pool._cloneMaps[clonedRoot]
	local function visit(node)
		if node:GetAttribute("Transformed") then
			if onNode then onNode(node) end
			local descCtx = {}
			if emitCtx then
				descCtx.ChainCtx  = emitCtx.ChainCtx
				descCtx.EmitIndex = emitCtx.EmitIndex
				descCtx.EmitCount = emitCtx.EmitCount
			end
			descCtx._parentAlive = parentAlive
			descCtx._parentCloneMap = parentCloneMap
			particle:EnableEmit(node, clonedRoot, descCtx)
			return
		end
		for _, child in node:GetChildren() do visit(child) end
	end
	visit(sourceRT)
end

return NestedEmit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Orientation</string>
              <string name="Source"><![CDATA[--[[
	Orientation Mixin  -  per-frame rotation overlay for Part / Model / Attachment.
	Modes mirror ParticleOrientation: None, FacingCamera, FacingCameraWorldUp,
	VelocityParallel, VelocityPerpendicular. Composes as `orient * existingRotation`.
]]

return function(Particle)

local EPS = 1e-3
local Y_AXIS = Vector3.yAxis
local X_AXIS = Vector3.xAxis
local DEFAULT_VEL = -Vector3.zAxis

function Particle:ApplyOrientation(pData, dt, camPos)
	local mode = pData.Orientation
	if not mode or mode == "None" then return end
	if not pData.VisualPart or not pData.VisualPart.Parent then return end
	local t = pData.Type
	if t ~= "Part" and t ~= "Model" and t ~= "Attachment" then return end

	local isModel = t == "Model"
	local isAttachment = t == "Attachment"
	-- Use pre-overlay base CFrame; reading live would compound previous frame's compose into existingRot.
	local currentCF = pData._postUpdateCF or (isModel and pData.VisualPart:GetPivot() or pData.VisualPart.CFrame)

	-- Attachment.CFrame is parent-local; work in world space for the lookAt, convert back on write.
	local parentPart
	if isAttachment then
		parentPart = pData.VisualPart.Parent
		if parentPart and parentPart:IsA("BasePart") then
			currentCF = parentPart.CFrame * currentCF
		else
			parentPart = nil
		end
	end

	local pos = currentCF.Position
	local existingRot = currentCF - pos

	local vel
	if pData._lastOrientPos then
		vel = (pos - pData._lastOrientPos) / math.max(dt, 1e-4)
	else
		vel = pData.BaseDirection or DEFAULT_VEL
	end
	pData._lastOrientPos = pos

	local orientRot
	if mode == "FacingCamera" then
		if not camPos then return end
		local toCam = camPos - pos
		if toCam.Magnitude < EPS then return end
		orientRot = CFrame.lookAt(Vector3.zero, toCam.Unit)
	elseif mode == "FacingCameraWorldUp" then
		-- Yaw-only: flatten camera direction onto XZ so mesh rotates around world Y only.
		if not camPos then return end
		local toCam = camPos - pos
		local flat = Vector3.new(toCam.X, 0, toCam.Z)
		if flat.Magnitude < EPS then return end
		orientRot = CFrame.lookAt(Vector3.zero, flat.Unit, Y_AXIS)
	elseif mode == "VelocityParallel" then
		-- DirMode=Local already aligns via LocalCF; overlaying here would double-rotate.
		if pData.VelocityVectored then return end
		-- forward = velocity, roll tracks camera so broadside stays visible.
		if vel.Magnitude < EPS then return end
		local upHint = camPos and (camPos - pos) or Y_AXIS
		if upHint.Magnitude < EPS then upHint = Y_AXIS end
		orientRot = CFrame.lookAt(Vector3.zero, vel.Unit, upHint.Unit)
	elseif mode == "VelocityPerpendicular" then
		-- up = velocity, forward fixed in world-horizontal plane.
		if vel.Magnitude < EPS then return end
		local upV = vel.Unit
		local fwd = upV:Cross(Y_AXIS)
		if fwd.Magnitude < EPS then fwd = upV:Cross(X_AXIS) end
		orientRot = CFrame.lookAt(Vector3.zero, fwd.Unit, upV)
	else
		-- Warn once per pData on unknown Orientation so typos don't fail silently.
		if not pData._orientWarned then
			pData._orientWarned = true
			warn("Part-Icles: unknown Orientation '" .. tostring(pData.Orientation) .. "' on emitted particle  -  falling back to identity.")
		end
		return
	end

	local newCF = CFrame.new(pos) * orientRot * existingRot

	if parentPart then
		newCF = parentPart.CFrame:ToObjectSpace(newCF)
	end

	if isModel then
		pData.VisualPart:PivotTo(newCF)
	else
		pData.VisualPart.CFrame = newCF
	end
end

end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">PartConstants</string>
              <string name="Source"><![CDATA[--[[
	PartConstants  -  lookup tables and helpers shared by Emit / Update / Transform.
	  DirectionVectors[NormalId] → (axis, multiplier) for CFrame component reads.
	  shapeFunctions[ParticleEmitterShape] → (offset, rotation, direction) per shape.
	  resolveLinkCFrame, composeRotation, applyPositionOffset  -  see per-function comments.
]]

local PartConstants = {}

-- Type-dispatched world CFrame: Attachment→WorldCFrame, Model→GetPivot, Bone→TransformedWorldCFrame, else .CFrame.
function PartConstants.resolveLinkCFrame(link)
	if link:IsA("Attachment") then return link.WorldCFrame end
	if link:IsA("Model") then return link:GetPivot() end
	if link:IsA("Bone") then return link.TransformedWorldCFrame end
	return link.CFrame
end

-- LocalABC entries are intrinsic Tait-Bryan Euler (body-frame composition, left-to-right).
-- Global (default) is the legacy Y*X*Z composition around fixed world axes; preserved so
-- existing saves don't shift visually on update. When the emission axis aligns with a
-- rotation axis, intrinsic ordering can no-op that axis on the launch direction  -  Global
-- gives the typical spread-cone behaviour.
function PartConstants.composeRotation(order, rotXdeg, rotYdeg, rotZdeg)
	local rxCF = CFrame.Angles(math.rad(rotXdeg), 0, 0)
	local ryCF = CFrame.Angles(0, math.rad(rotYdeg), 0)
	local rzCF = CFrame.Angles(0, 0, math.rad(rotZdeg))
	if order == "LocalXYZ" then return rxCF * ryCF * rzCF end
	if order == "LocalXZY" then return rxCF * rzCF * ryCF end
	if order == "LocalYXZ" then return ryCF * rxCF * rzCF end
	if order == "LocalYZX" then return ryCF * rzCF * rxCF end
	if order == "LocalZXY" then return rzCF * rxCF * ryCF end
	if order == "LocalZYX" then return rzCF * ryCF * rxCF end
	return ryCF * rxCF * rzCF -- Global default
end

PartConstants.DirectionVectors = {
	[Enum.NormalId.Top]    = {vector = "UpVector",    multiplier = 1},
	[Enum.NormalId.Bottom] = {vector = "UpVector",    multiplier = -1},
	[Enum.NormalId.Front]  = {vector = "LookVector",  multiplier = 1},
	[Enum.NormalId.Back]   = {vector = "LookVector",  multiplier = -1},
	[Enum.NormalId.Left]   = {vector = "RightVector", multiplier = -1},
	[Enum.NormalId.Right]  = {vector = "RightVector", multiplier = 1},
}

-- Each shape returns (offset, lookAtRotation, outwardDirection).
-- rotation applied only when LookAtInitially is true; direction sign-modulated by ShapeInOut.
PartConstants.shapeFunctions = {
	[Enum.ParticleEmitterShape.Box] = function(p, emitter)
		local Px = (math.random() * 2 - 1) * p.Size.X / 2
		local Py = (math.random() * 2 - 1) * p.Size.Y / 2
		local Pz = (math.random() * 2 - 1) * p.Size.Z / 2
		-- Box has no radial; use offset.Unit (origin-aligned falls back to world up).
		local offset = Vector3.new(Px, Py, Pz)
		local dir = offset.Magnitude > 1e-4 and offset.Unit or Vector3.yAxis
		local sRot = offset.Magnitude > 1e-4 and CFrame.lookAt(Vector3.new(), -dir) or CFrame.new()
		return offset, sRot, dir
	end,
	[Enum.ParticleEmitterShape.Sphere] = function(p, emitter)
		local outerRadius = p.Size.X / 2
		local innerRadius = outerRadius * emitter.ShapePartial
		local randomRadius = (math.random() * (outerRadius^3 - innerRadius^3) + innerRadius^3)^(1/3)
		local theta = math.random() * 2 * math.pi
		local phi = math.acos((math.random() * 2) - 1)
		local direction = Vector3.new(
			math.sin(phi) * math.cos(theta),
			math.sin(phi) * math.sin(theta),
			math.cos(phi)
		)
		return direction * randomRadius, CFrame.lookAt(Vector3.new(), -direction), direction
	end,
	[Enum.ParticleEmitterShape.Cylinder] = function(p, emitter)
		local radius = p.Size.X / 2
		local height = p.Size.Y
		-- Area-uniform annulus radius: F^-1(u) = sqrt(u*(1-h^2) + h^2).
		local h = math.clamp(emitter.ShapePartial, 0, 1)
		local randomRadius = math.sqrt(math.random() * (1 - h * h) + h * h)
		local angle = math.random() * 2 * math.pi
		local x = randomRadius * radius * math.cos(angle)
		local y = (math.random() * 2 - 1) * (height / 2)
		local z = randomRadius * radius * math.sin(angle)
		local localOffset = Vector3.new(x, y, z)
		local direction
		if math.abs(y) > (height / 2) - 0.01 then
			direction = Vector3.new(0, math.sign(y), 0)
		else
			local lateral = Vector3.new(x, 0, z)
			if lateral.Magnitude < 0.0001 then
				direction = Vector3.new(0, 1, 0)
			else
				direction = lateral.Unit
			end
		end
		return localOffset, CFrame.lookAt(Vector3.new(), -direction), direction
	end,
	[Enum.ParticleEmitterShape.Disc] = function(p, emitter)
		local radius = p.Size.X / 2
		-- Area-uniform annulus; matches Cylinder.
		local h = math.clamp(emitter.ShapePartial, 0, 1)
		local randomRadiusRatio = math.sqrt(math.random() * (1 - h * h) + h * h)
		local angle = math.random() * 2 * math.pi
		local x = randomRadiusRatio * radius * math.cos(angle)
		local z = randomRadiusRatio * radius * math.sin(angle)
		local localOffset = Vector3.new(x, 0, z)
		if localOffset.Magnitude < 0.0001 then
			return localOffset, CFrame.new(), Vector3.yAxis
		end
		local direction = localOffset.Unit
		return localOffset, CFrame.lookAt(Vector3.new(), -direction), direction
	end,
}

-- Apply PosX/Y/Z range offset to simCF.
-- simFrameCF: WORLD CFrame of the frame the caller's simCF is in. nil = world-space
-- sim (Part/Model siblings). For Attachment Emit: walked-up BasePart's CFrame. For
-- Attachment Animate: source attachment's WorldCFrame (composes arbitrary nest depth).
function PartConstants.applyPositionOffset(simCF, data, link, item, RangeMod, AxisLinksMod, emitCtx, simFrameCF)
	-- AxisLinks-aware sampling so linked Pos followers stay correlated; emitCtx drives
	-- PosXEven/PosYEven/PosZEven even spread. Independent sampling is the fallback.
	local pxS, pyS, pzS
	if AxisLinksMod and data.AxisLinks then
		local s = AxisLinksMod.sampleRangeAxes(data, data.AxisLinks, {"PosX","PosY","PosZ"}, RangeMod, emitCtx)
		pxS, pyS, pzS = s.PosX, s.PosY, s.PosZ
	else
		pxS = RangeMod.RandomValueFromRange(data.PosX or NumberRange.new(0))
		pyS = RangeMod.RandomValueFromRange(data.PosY or NumberRange.new(0))
		pzS = RangeMod.RandomValueFromRange(data.PosZ or NumberRange.new(0))
	end
	local px, py, pz = pxS, pyS, pzS
	if px == 0 and py == 0 and pz == 0 then return simCF end
	local posMode = data.PosMode or "Local"

	if posMode == "Local" then
		return simCF * CFrame.new(px, py, pz)
	end

	local offset = Vector3.new(px, py, pz)
	local worldOffset
	if posMode == "Global" then
		worldOffset = offset
	else -- RigidLocal: rotate by source's WORLD frame; composes through full nest chain.
		local rotCF
		if link then
			rotCF = PartConstants.resolveLinkCFrame(link)
		elseif item:IsA("Attachment") then
			rotCF = item.WorldCFrame
		elseif item:IsA("Model") then
			rotCF = item:GetPivot()
		else
			rotCF = item.CFrame
		end
		worldOffset = rotCF:VectorToWorldSpace(offset)
	end

	-- Convert world offset → caller's sim frame. nil = sim is world-space.
	local applyOffset = simFrameCF and simFrameCF:VectorToObjectSpace(worldOffset) or worldOffset
	return CFrame.new(simCF.Position + applyOffset) * simCF.Rotation
end

-- Resolve a PosOffset graph sample (rawOff) into world-frame displacement based on
-- DisplacementMode. Shared across all 6 emit paths (Part/Attachment/Model × normal/animate)
-- and Update.luau's per-frame _posOffsetFrameDelta. Three modes:
--   "Global"     → no rotation (world axes)
--   "RigidLocal" → rotated by emitterRot (emitter frame at spawn, pre-RotXYZ)
--   "Local" (or unknown) → rotated by spawnRot (post-RotXYZ particle frame)
--
-- Optional mirrorX/Y/Z axes apply a post-rotation orthogonal transform  -  used by
-- OnHit Bounce to reflect the PosOffset trajectory about hit normals. Each bounce
-- reflects all three axes about hit.Normal, accumulating as a single 3-vector basis
-- (det may flip to -1 after an odd number of bounces  -  valid for displacement).
-- nil mirror axes (default at spawn) skip the matrix application.
function PartConstants.resolveDisplacement(rawOff, mode, spawnRot, emitterRot, mirrorX, mirrorY, mirrorZ)
	local frameOff
	if mode == "Global" then
		frameOff = rawOff
	elseif mode == "RigidLocal" then
		frameOff = emitterRot:VectorToWorldSpace(rawOff)
	else
		frameOff = spawnRot:VectorToWorldSpace(rawOff)
	end
	if mirrorX then
		return mirrorX * frameOff.X + mirrorY * frameOff.Y + mirrorZ * frameOff.Z
	end
	return frameOff
end

-- Skip Coulomb cancellation when |a · n| below this  -  body parallel to surface
-- (vertical-wall-grazing case) shouldn't have its full gravity stripped.
local FREEFALL_THRESHOLD = 10

-- Coulomb contact-constraint shaping for gravity during settle. Strips normal
-- component (surface reaction force) + applies friction force on tangent vel
-- bounded by μ·|aN|. Yields standard inclined-plane dynamics: g·sinθ − μ·g·cosθ.
function PartConstants.applyContactAccel(accel, pData, dt)
	if not (pData._settleEngaged and pData._lastHitNormal) then return accel end
	local n = pData._lastHitNormal
	if n.Magnitude < 1e-4 then return accel end
	local aN_dot = accel:Dot(n)
	-- Surface only pushes (Newton's 3rd is one-directional). Gravity pointing
	-- AWAY from surface means no contact, no constraint.
	if aN_dot >= 0 then return accel end
	-- Vertical-wall escape: body parallel to surface normal has near-zero
	-- normal component. Skip constraint so gravity drags it along the wall.
	if math.abs(aN_dot) < FREEFALL_THRESHOLD then return accel end
	local aN = aN_dot * n
	local aT = accel - aN
	local mu = (pData.Events and pData.Events.OnHit and pData.Events.OnHit.Friction) or 0.2
	local vT = Vector3.zero
	if pData._accelVel then
		local av = pData._accelVel
		vT = av - av:Dot(n) * n
	end
	local vT_mag = vT.Magnitude
	local maxFrictionAccel = mu * math.abs(aN_dot)
	if vT_mag > 1e-4 then
		-- Kinetic regime: friction opposes tangent velocity, capped at Coulomb cone.
		-- Static-lock clamp prevents friction from reversing tangent vel in one step.
		local frictionAccel = (-vT.Unit) * maxFrictionAccel
		if maxFrictionAccel * (dt or 1/60) > vT_mag then
			frictionAccel = -vT / (dt or 1/60)
		end
		return aT + frictionAccel
	end
	-- Static regime: |aT| ≤ μ·|aN| means friction holds the body still
	-- (tan(θ) ≤ μ on a slope). |aT| > μ·|aN| means slope exceeds friction cone;
	-- body starts sliding at the residual tangent accel.
	local aT_mag = aT.Magnitude
	if aT_mag <= maxFrictionAccel then return Vector3.zero end
	return aT - aT.Unit * maxFrictionAccel
end

return PartConstants
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Particles</string>
              <string name="Source"><![CDATA[-- Particles  -  fires native ParticleEmitters/Trails inside a transformed item using the
-- EmitCount / EmitDelay / EmitDuration attributes. Per-instance gen tokens prevent stale
-- delayed-off closures from clobbering newer emit sessions.
local Range = require(script.Parent.Range)

local Particle = {}

-- EmitDuration is a number or a "min,max" range string; parse to scalar.
local function parseDuration(raw)
	if raw == nil then return nil end
	if typeof(raw) == "number" then return raw end
	local text = tostring(raw)
	local vals = {}
	for v in text:gmatch("[^,]+") do local n = tonumber(v:match("^%s*(.-)%s*$")); if n then table.insert(vals, n) end end
	if #vals == 0 then return nil end
	if #vals == 1 then return vals[1] end
	local mn, mx = math.min(vals[1], vals[2]), math.max(vals[1], vals[2])
	return Range.RandomValueFromRange(NumberRange.new(mn, mx))
end
Particle.parseDuration = parseDuration

-- Skip descendants under a nested Transformed item (sub-emitter handles those itself).
local function _hasTransformedAncestor(desc, root)
	local p = desc.Parent
	while p and p ~= root do
		if p:GetAttribute("Transformed") then return true end
		p = p.Parent
	end
	return false
end

-- alive: false when engine session ended; cancels delayed STARTS only.
local function _alive(alive)
	return (not alive) or alive()
end

-- Two gens, split responsibilities. CANCEL_GEN gates delayed starts (bumped by
-- CancelNative / Pool release / Disable). DURATION_GEN gates delayed-off closures
-- (bumped on each duration-window start) so a newer window can't be turned off
-- by an older one.
local CANCEL_GEN_ATTR = "_PartIcleNativeEmitGen"
local DURATION_GEN_ATTR = "_PartIcleNativeDurationGen"

local function _readCancelGen(v)
	return v:GetAttribute(CANCEL_GEN_ATTR) or 0
end
local function _bumpCancelGen(v)
	local gen = _readCancelGen(v) + 1
	pcall(function() v:SetAttribute(CANCEL_GEN_ATTR, gen) end)
	return gen
end
local function _cancelGenStillCurrent(v, gen)
	return v.Parent ~= nil and _readCancelGen(v) == gen
end

local function _readDurationGen(v)
	return v:GetAttribute(DURATION_GEN_ATTR) or 0
end
local function _bumpDurationGen(v)
	local gen = _readDurationGen(v) + 1
	pcall(function() v:SetAttribute(DURATION_GEN_ATTR, gen) end)
	return gen
end
local function _durationGenStillCurrent(v, gen)
	return v.Parent ~= nil and _readDurationGen(v) == gen
end

-- Enabled=true now, schedule Enabled=false in `duration`. Delayed-off owned by
-- duration gen so a later SetEnabledForDuration does not get clobbered.
Particle.SetEnabledForDuration = function(v, duration)
	local durGen = _bumpDurationGen(v)
	v.Enabled = true
	task.delay(duration, function()
		if _durationGenStillCurrent(v, durGen) then v.Enabled = false end
	end)
end

-- External API kept stable: ReadNativeGen / IsNativeGenCurrent address the
-- cancel token (delayed-start gating). Callers that want delayed-off ownership
-- use SetEnabledForDuration which handles its own duration token internally.
Particle.ReadNativeGen = _readCancelGen
Particle.IsNativeGenCurrent = _cancelGenStillCurrent

-- Bump cancel + duration gens + Enabled=false. Invalidates pending delayed
-- starts AND any pending delayed-off (which would otherwise re-toggle).
Particle.CancelNative = function(v)
	_bumpCancelGen(v)
	_bumpDurationGen(v)
	pcall(function() v.Enabled = false end)
end

-- Delayed-START gate: schedule captures cancel gen, closure bails on drift.
Particle.EnableEmit = function(part, alive)
	task.spawn(function()
		for i, v in part:GetDescendants() do
			if _hasTransformedAncestor(v, part) then continue end
			if v:IsA('ParticleEmitter') then
				local count = v:GetAttribute('EmitCount') or 1
				local emitDelay = v:GetAttribute('EmitDelay') or 0
				local emitDuration = v:GetAttribute('EmitDuration') or 0
				local cancelGen = _readCancelGen(v)
				local function doEmit()
					if not _alive(alive) or not _cancelGenStillCurrent(v, cancelGen) then return end
					-- Roblox :Emit(0) falls back to 1; gate on count>0.
					if count > 0 then v:Emit(count) end
					if emitDuration > 0 then
						local durGen = _bumpDurationGen(v)
						v.Enabled = true
						-- Delayed-off uses duration gen (not alive) so cleanup survives engine death.
						task.delay(emitDuration, function()
							if _durationGenStillCurrent(v, durGen) then v.Enabled = false end
						end)
					end
				end
				if count <= 0 and emitDuration <= 0 then continue end
				if emitDelay > 0 then task.delay(emitDelay, doEmit) else doEmit() end
			end
			-- Skip TrailEmitter (Transformed)  -  the engine pipeline emits cloned visuals
			-- via TrailEmitter.EmitTrail; toggling the SOURCE Trail's Enabled here would
			-- render the unwanted source Trail at default Roblox properties (white) on
			-- top of the authored emit clones.
			if v:IsA('Trail') and not v:GetAttribute('Transformed') then
				local dur = parseDuration(v:GetAttribute('EmitDuration'))
				if dur and dur > 0 then
					local cancelGen = _readCancelGen(v)
					task.delay(v:GetAttribute('EmitDelay') or 0.001, function()
						if not _alive(alive) or not _cancelGenStillCurrent(v, cancelGen) then return end
						local durGen = _bumpDurationGen(v)
						v.Enabled = true
						task.delay(dur, function()
							if _durationGenStillCurrent(v, durGen) then v.Enabled = false end
						end)
					end)
				end
			end
			-- Raw Beam: native streak between authored attachments. Skip BeamNative
			-- (Transformed)  -  directAccess type handled by Particle:EnableEmit mixin.
			-- Same gen-token pattern as Trail: cancelGen gates delayed-on, durGen owns delayed-off.
			if v:IsA('Beam') and not v:GetAttribute('Transformed') then
				local emitDuration = tonumber(v:GetAttribute('EmitDuration')) or 0
				local emitDelay = tonumber(v:GetAttribute('EmitDelay')) or 0
				if emitDuration > 0 then
					local cancelGen = _readCancelGen(v)
					local function doEmit()
						if not _alive(alive) or not _cancelGenStillCurrent(v, cancelGen) then return end
						local durGen = _bumpDurationGen(v)
						v.Enabled = true
						task.delay(emitDuration, function()
							if _durationGenStillCurrent(v, durGen) then v.Enabled = false end
						end)
					end
					if emitDelay > 0 then task.delay(emitDelay, doEmit) else doEmit() end
				end
			end
		end
	end)
end

Particle.EnableEmitSingle = function(v: Instance, alive)
	task.spawn(function()
		if v:IsA('Trail') then
			local dur = parseDuration(v:GetAttribute('EmitDuration'))
			if dur and dur > 0 then
				local cancelGen = _readCancelGen(v)
				local emitDelay = v:GetAttribute('EmitDelay') or 0
				local function doEnable()
					if not _alive(alive) or not _cancelGenStillCurrent(v, cancelGen) then return end
					local durGen = _bumpDurationGen(v)
					v.Enabled = true
					task.delay(dur, function()
						if _durationGenStillCurrent(v, durGen) then v.Enabled = false end
					end)
				end
				-- Synchronous enable when EmitDelay=0 so trail renders on the SAME
				-- frame as particle spawn. Prior `task.delay(EmitDelay or 0.001, ...)`
				-- forced a 1ms tick gap even with zero delay → trail invisible on
				-- frame 0, visible from frame 1+. For short-lived particles this is
				-- a noticeable gap in the trail head.
				if emitDelay > 0 then task.delay(emitDelay, doEnable) else doEnable() end
			end
		end
		if v:IsA('ParticleEmitter') then
			local count = v:GetAttribute('EmitCount') or 1
			local emitDelay = v:GetAttribute('EmitDelay') or 0
			local emitDuration = v:GetAttribute('EmitDuration') or 0
			if count <= 0 and emitDuration <= 0 then return end
			local cancelGen = _readCancelGen(v)
			local function doEmit()
				if not _alive(alive) or not _cancelGenStillCurrent(v, cancelGen) then return end
				if count > 0 then v:Emit(count) end
				if emitDuration > 0 then
					local durGen = _bumpDurationGen(v)
					v.Enabled = true
					task.delay(emitDuration, function()
						if _durationGenStillCurrent(v, durGen) then v.Enabled = false end
					end)
				end
			end
			if emitDelay > 0 then task.delay(emitDelay, doEmit) else doEmit() end
		end
	end)
end

Particle.EnableEmitChildrenAndRepeatForAttachments = function(part, alive)
	task.spawn(function()
		for i, v in part:GetChildren() do
			Particle.EnableEmitSingle(v, alive)
			if v:IsA('Attachment') then
				Particle.EnableEmitChildrenAndRepeatForAttachments(v, alive)
			end
		end
	end)
end

return Particle
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">PointLight</string>
              <string name="Source"><![CDATA[--[[
	PointLight Mixin  -  Emit + Update for PointLight particles.
	Property-only animation (Range / Brightness / Color over life), no spatial motion.
]]

local GraphMod = require(script.Parent.Graph)
local RangeMod = require(script.Parent.Range)
local Pool = require(script.Parent.Pool)

return function(Particle)

function Particle:UpdatePointLight(pData, dt, currentTime)
	-- Timescale v2 (signed reverse): see Update.luau UpdatePart. SetTimescale override wins for its window.
	local real_i = math.min(math.max((currentTime - pData.StartTime) / pData.LifeTime, 0), 1)
	local ts
	if pData._tsOverride ~= nil and currentTime < (pData._tsOverrideUntil or 0) then
		ts = pData._tsOverride
	else
		ts = pData.Graphs.Timescale and GraphMod.QueryPointsWithTime(real_i, pData.Graphs.Timescale, pData.Seeds.Timescale) or 1
	end
	local dtTs = dt * ts
	local lifeTime = pData.LifeTime
	local priorEff = pData._effectiveElapsed or 0
	local newEff = priorEff + (pData._timeFrozen and 0 or dtTs)
	if newEff < 0 then newEff = 0 end
	if newEff > lifeTime then newEff = lifeTime end
	pData._effectiveElapsed = newEff
	local atForwardEnd = newEff >= lifeTime
	local atBackwardEnd = newEff <= 0
	local elapsedTime = newEff
	local i = elapsedTime / lifeTime

	if not pData.VisualPart or not pData.VisualPart.Parent then return true end
	if pData.TotalKeyFrames <= 0 then return true end
	local graphFinished = real_i >= 1
	local isDying = graphFinished and (atForwardEnd or atBackwardEnd)
	i = math.min(math.max(i, 0), 1)

	local targetStep = math.floor(i * pData.TotalKeyFrames)

	if targetStep ~= pData.CurrentStep then
		pData.CurrentStep = targetStep
		local steppedI = pData.CurrentStep / pData.TotalKeyFrames

		if pData.Graphs.PLRange then
			pData.VisualPart.Range = GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.PLRange, pData.Seeds.PLRange)
		end
		if pData.Graphs.PLBrightness and not pData.SkipTransparency then
			pData.VisualPart.Brightness = GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.PLBrightness, pData.Seeds.PLBrightness)
		end
		if pData.Graphs.PLColor and not pData.SkipColor then
			pData.VisualPart.Color = GraphMod.QueryColorPointWithTime(steppedI, pData.Graphs.PLColor)
		end
	end

	return isDying
end

function Particle:EmitPointLight(light, link, emitCtx)
	if not light or not light.Parent then return end
	local data = self:GetData(light)
	if not data or not data.RenderTemplate then return end

	-- PoolHide flipped Enabled=false on release; flip back here.
	local visualLight = Pool.acquireOrClone(data.RenderTemplate, "PointLight", data.Pool)
	visualLight.Archivable = false
	visualLight.Enabled = true
	if data.Shadows ~= nil then visualLight.Shadows = data.Shadows end
	local parentPart = data.EmitParent or link or light.Parent

	local safeLifeTime = RangeMod.RandomValueFromRange(data.Lifetime)
	if safeLifeTime <= 0 then safeLifeTime = 0.001 end

	local seedRange = data.PLRange and GraphMod.GenerateSeed(data.PLRange) or {}
	local seedBright = data.PLBrightness and GraphMod.GenerateSeed(data.PLBrightness) or {}
	local seedTimescale = GraphMod.GenerateSeed(data.PLTimescale)

	-- Apply initial values before parenting (1-frame pop prevention).
	if data.PLRange then
		visualLight.Range = GraphMod.QueryPointsWithTime(0, data.PLRange, seedRange)
	end
	if data.PLBrightness then
		visualLight.Brightness = GraphMod.QueryPointsWithTime(0, data.PLBrightness, seedBright)
	end
	if data.PLColor then
		visualLight.Color = GraphMod.QueryColorPointWithTime(0, data.PLColor)
	end

	visualLight.Parent = parentPart

	local pData = {
		Type = "PointLight",
		VisualPart = visualLight,
		Events = data.Events,
		StartTime = os.clock(),
		TotalKeyFrames = math.max(1, data.TotalKeyFrames),
		CurrentStep = 0,
		LifeTime = safeLifeTime,
		PartLife = data.PartLife or 0,

		Graphs = {
			PLRange = data.PLRange,
			PLBrightness = data.PLBrightness,
			PLColor = data.PLColor,
			Timescale = data.PLTimescale,
		},
		Seeds = {
			PLRange = seedRange,
			PLBrightness = seedBright,
			Timescale = seedTimescale,
		},
		_effectiveElapsed = GraphMod.InitialEffectiveElapsed(data.PLTimescale, seedTimescale, safeLifeTime),
	}

	pData._sourceItem = light
	Particle._seedTsOverride(pData, light)
	if data.Pool ~= false then pData._sourceRT, pData._poolKind = data.RenderTemplate, "PointLight" end
	self:_registerEmit(pData, emitCtx)
end

end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Pool</string>
              <string name="Source"><![CDATA[--[[
	Pool  -  emission-driven object pool for emitted particle visuals.
	Per-source LIFO with hard cap + ring-buffer overflow + TTL eviction. Cap = rate*TTL*1.25 + 8.
	Generational invalidation via `_PoolGen` attribute (TypeRegistry.write bumps on edit).
	Animate mode skips pooling (visual IS the live source).
]]

local PoolHide = require(script.Parent.PoolHide)

local Pool = {}

-- Idle-pool destination folder. Released entries re-parent here so the Explorer makes it
-- obvious which clones are recyclable. Live emit clones stay in `EmittedPartsUsingPart_icle`
-- (Particle:GetFolder); only entries that finished an emit cycle land here.
local function _getPoolFolder()
	local f = workspace.Terrain:FindFirstChild("Part_IclesPooled")
	if f then return f end
	f = Instance.new("Folder")
	f.Name = "Part_IclesPooled"
	f.Archivable = false
	f.Parent = workspace.Terrain
	return f
end

-- Weak-key so a destroyed RenderTemplate's pool entry can gc instead of leaking
-- the source instance + cached visuals across un-transform / re-transform cycles.
Pool._pools = setmetatable({}, {__mode = "k"})  -- [sourceRT] = {entries, gen, cap, peakSize, hits, misses, evictions}
Pool._totalSize = 0
Pool._lastSweepAt = 0
Pool._lastReportAt = 0

Pool.MAX_POOL_TOTAL = 2048
Pool.TTL = 5
Pool.SWEEP_INTERVAL = 2
Pool.REPORT_INTERVAL = 0        -- 0 disables the periodic Output print
Pool.MIN_CAP = 8
Pool.CAP_SAFETY = 1.25

local function estimateCap(rate)
	local r = math.max(rate or 0, 0)
	return math.ceil(r * Pool.TTL * Pool.CAP_SAFETY) + Pool.MIN_CAP
end

local function getOrInitPool(source)
	local p = Pool._pools[source]
	if p then return p end
	p = {
		entries = {},                              -- LIFO of {instance, pooledAt}
		gen = source:GetAttribute("_PoolGen") or 0,
		cap = Pool.MIN_CAP,
		peakSize = 0,
		hits = 0, misses = 0, evictions = 0,
	}
	Pool._pools[source] = p
	return p
end

local function destroyEntry(entry)
	if entry and entry.instance then
		pcall(function() entry.instance:Destroy() end)
	end
end

local function discardAllEntries(pool)
	for i = 1, #pool.entries do destroyEntry(pool.entries[i]) end
	Pool._totalSize = math.max(0, Pool._totalSize - #pool.entries)
	pool.entries = {}
end

-- Pop a live entry or nil. Caller restores all visual properties (same as fresh Clone).
function Pool.acquire(source, kind)
	if not source then return nil end
	local pool = getOrInitPool(source)
	local sourceGen = source:GetAttribute("_PoolGen") or 0
	if sourceGen ~= pool.gen then
		-- Generation drifted; flush all entries.
		discardAllEntries(pool)
		pool.gen = sourceGen
	end
	while #pool.entries > 0 do
		local entry = table.remove(pool.entries)
		Pool._totalSize = math.max(0, Pool._totalSize - 1)
		local inst = entry.instance
		if inst and inst.Parent then
			PoolHide.show(inst, kind)
			pool.hits += 1
			return inst
		end
	end
	pool.misses += 1
	return nil
end

-- Push an instance back. Global cap → Destroy instead. Per-source full → ring-evict oldest.
function Pool.release(instance, source, kind, rate)
	if not instance or not source then return end
	if not instance.Parent then return end
	local pool = getOrInitPool(source)
	if rate then pool.cap = estimateCap(rate) end
	if Pool._totalSize >= Pool.MAX_POOL_TOTAL then
		pcall(function() instance:Destroy() end)
		return
	end
	while #pool.entries >= pool.cap do
		local oldest = table.remove(pool.entries, 1)  -- O(n) shift, n <= cap
		Pool._totalSize = math.max(0, Pool._totalSize - 1)
		destroyEntry(oldest)
		pool.evictions += 1
	end
	PoolHide.hide(instance, kind)
	-- Re-parent idle entry into the visible pool folder so the user can see, at any moment,
	-- which clones are recyclable. PoolHide already teleported / disabled it; reparent now
	-- so the Explorer reflects the idle state.
	pcall(function() instance.Parent = _getPoolFolder() end)
	pool.entries[#pool.entries + 1] = { instance = instance, pooledAt = os.clock() }
	Pool._totalSize += 1
	if #pool.entries > pool.peakSize then pool.peakSize = #pool.entries end
end

-- TTL sweep with 64-entry budget. Budget caps frame-time on huge pools.
function Pool.tickSweep(now)
	if (now - Pool._lastSweepAt) < Pool.SWEEP_INTERVAL then return end
	Pool._lastSweepAt = now
	local budget = 64
	-- Collect drained sources to drop after iteration; mutating Pool._pools while
	-- iterating it would skip / double-visit entries. A pool is droppable when its
	-- entries list is empty AND its source RT has been destroyed (no Parent), so
	-- live RTs that just hit a quiet stretch keep their stats.
	local toDrop = nil
	for source, pool in pairs(Pool._pools) do
		local i = 1
		while i <= #pool.entries and budget > 0 do
			local entry = pool.entries[i]
			local inst = entry.instance
			local stale = (now - entry.pooledAt) > Pool.TTL or not inst or not inst.Parent
			if stale then
				destroyEntry(entry)
				local n = #pool.entries
				if i < n then pool.entries[i] = pool.entries[n] end
				pool.entries[n] = nil
				Pool._totalSize = math.max(0, Pool._totalSize - 1)
				pool.evictions += 1
				budget -= 1
				-- Don't advance i; current slot now holds what was at the end.
			else
				i += 1
			end
		end
		if #pool.entries == 0 and (not source or not source.Parent) then
			toDrop = toDrop or {}
			toDrop[#toDrop + 1] = source
		end
	end
	if toDrop then
		for _, source in ipairs(toDrop) do
			Pool._pools[source] = nil
		end
	end
end

-- Called from TypeRegistry.write to invalidate stale-look pool entries.
function Pool.bumpGen(source)
	if not source then return end
	local cur = source:GetAttribute("_PoolGen") or 0
	pcall(function() source:SetAttribute("_PoolGen", cur + 1) end)
end

-- Drop one source's pool when its RT is destroyed.
function Pool.flushSource(source)
	local pool = Pool._pools[source]
	if not pool then return end
	discardAllEntries(pool)
	Pool._pools[source] = nil
end

-- Drop every pool; called from Particle:Deactivate.
function Pool.flushAll()
	for _, pool in pairs(Pool._pools) do
		discardAllEntries(pool)
	end
	Pool._pools = setmetatable({}, {__mode = "k"})
	Pool._totalSize = 0
end

-- Aggregate diagnostics print, gated by REPORT_INTERVAL.
function Pool.tickReport(now)
	if Pool.REPORT_INTERVAL <= 0 then return end
	if (now - Pool._lastReportAt) < Pool.REPORT_INTERVAL then return end
	Pool._lastReportAt = now
	local poolCount, totalEntries, totalHits, totalMisses, totalEvictions, peakAcross = 0, 0, 0, 0, 0, 0
	for _ in pairs(Pool._pools) do poolCount += 1 end
	for _, pool in pairs(Pool._pools) do
		totalEntries += #pool.entries
		totalHits += pool.hits
		totalMisses += pool.misses
		totalEvictions += pool.evictions
		if pool.peakSize > peakAcross then peakAcross = pool.peakSize end
	end
	local hitRate = (totalHits + totalMisses) > 0 and (totalHits / (totalHits + totalMisses) * 100) or 0
	print(string.format(
		"[Part-Icles Pool] sources=%d entries=%d/%d peak=%d hits=%d misses=%d (%.1f%% hit) evictions=%d",
		poolCount, totalEntries, Pool.MAX_POOL_TOTAL, peakAcross, totalHits, totalMisses, hitRate, totalEvictions
	))
end

-- Acquire or Clone. Stamps _PartIcleEmit so downstream readers recognize the instance.
-- `pooled=false` forces a fresh clone every time and skips the release path; nested
-- Trails/PEs inside the visual then always reflect their authored RT properties.
function Pool.acquireOrClone(rt, kind, pooled)
	local inst
	if pooled == false then
		inst = rt:Clone()
	else
		inst = Pool.acquire(rt, kind) or rt:Clone()
	end
	inst:SetAttribute("_PartIcleEmit", true)
	return inst
end

-- Rebuild RT subtree via Instance.fromExisting, skipping Transformed branches
-- (nested SOURCE Part-Icles - fired separately by NestedEmit). Builds a source-to
-- -clone map for the rebuilt subtree.
local function copyBare(source, map, isRoot)
	map = map or {}
	local bare = Instance.fromExisting(source)
	map[source] = bare
	for _, child in ipairs(source:GetChildren()) do
		if not child:GetAttribute("Transformed") then
			copyBare(child, map, false).Parent = bare
		end
	end
	-- Rebind intra-subtree Trail/Beam Attachment0/1. fromExisting copies refs
	-- verbatim; only Instance:Clone auto-rebinds. Cross-subtree refs (map miss)
	-- left for nested-context _parentCloneMap pass at consumer site.
	if isRoot == nil or isRoot then
		for src, clone in pairs(map) do
			if src:IsA("Trail") or src:IsA("Beam") then
				local a0, a1 = src.Attachment0, src.Attachment1
				if a0 and map[a0] then clone.Attachment0 = map[a0] end
				if a1 and map[a1] then clone.Attachment1 = map[a1] end
			end
		end
	end
	return bare, map
end
Pool.copyBare = copyBare

-- Weak-keyed by clone root. Map auto-GC's with the clone; pool-hits reuse it
-- until _PoolGen drifts (mutation evicts pool entry, next acquire rebuilds).
Pool._cloneMaps = setmetatable({}, {__mode = "k"})

function Pool.acquireOrCopyBare(rt, kind, pooled)
	local inst, map
	if pooled == false then
		inst, map = copyBare(rt)
	else
		inst = Pool.acquire(rt, kind)
		if inst then
			map = Pool._cloneMaps[inst]
		else
			inst, map = copyBare(rt)
		end
	end
	if map then Pool._cloneMaps[inst] = map end
	inst:SetAttribute("_PartIcleEmit", true)
	return inst
end

-- Call AFTER writing new spawn CFrame + parent. Defers Trail.Enabled flip by one
-- Heartbeat so Roblox's renderer has applied the new attachment positions before the
-- Trail starts emitting; otherwise the first segment can be drawn from a stale cached
-- position (the prior emit's death pose) to the new spawn pose, leaving a visible
-- streak. No-op on fresh clones (no `_pooledTrailEnabled` snapshot to restore).
function Pool.restoreTrails(instance, kind)
	task.delay(0, function()
		if not instance or not instance.Parent then return end
		PoolHide.restoreTrails(instance, kind)
	end)
end

-- Heartbeat hook; both subsystems gate on their own intervals.
function Pool.tick(now)
	Pool.tickSweep(now)
	Pool.tickReport(now)
end

function Pool.stats()
	local out = { totalSize = Pool._totalSize, sources = {} }
	for source, pool in pairs(Pool._pools) do
		out.sources[source] = {
			size = #pool.entries, peakSize = pool.peakSize, cap = pool.cap, gen = pool.gen,
			hits = pool.hits, misses = pool.misses, evictions = pool.evictions,
		}
	end
	return out
end

return Pool
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">PoolHide</string>
              <string name="Source"><![CDATA[--[[
	PoolHide  -  type-dispatched hide/show for pooled visuals.

	hide:  Part/Model  → CFrame teleport to far-away (Trails disabled first to avoid streak)
	       Beam/PointLight → Enabled=false
	       Attachment → no-op
	show:  no-op (Trails restored separately via PoolHide.restoreTrails after the
	       caller writes the new spawn CFrame).

	Caller's emit-setup re-writes Size / CFrame / Color / Transparency on acquire;
	PoolHide does not restore any rendering properties.
]]

local FAR_AWAY = Vector3.new(1e9, 1e9, 1e9)
local FAR_CFRAME = CFrame.new(FAR_AWAY)

local PoolHide = {}

-- Snapshot + disable every Trail descendant; runs BEFORE teleport to avoid a streak.
-- Also snapshot + zero Lifetime so existing segments expire instantly instead of persisting
-- across the teleport (Enabled=false only stops NEW segments; old ones live for Lifetime
-- seconds and render between the pre/post-teleport attachment positions = visible streak).
-- Skip snapshot when one already pending so a same-frame acquire→release race
-- can't overwrite the authored value with a transient false.
local function disableTrails(root)
	if root:IsA("Trail") then
		pcall(function()
			if root:GetAttribute("_pooledTrailEnabled") == nil then
				root:SetAttribute("_pooledTrailEnabled", root.Enabled)
			end
			if root:GetAttribute("_pooledTrailLifetime") == nil then
				root:SetAttribute("_pooledTrailLifetime", root.Lifetime)
			end
			root.Lifetime = 0
			root.Enabled = false
		end)
		return
	end
	for _, desc in ipairs(root:GetDescendants()) do
		if desc:IsA("Trail") then
			pcall(function()
				if desc:GetAttribute("_pooledTrailEnabled") == nil then
					desc:SetAttribute("_pooledTrailEnabled", desc.Enabled)
				end
				if desc:GetAttribute("_pooledTrailLifetime") == nil then
					desc:SetAttribute("_pooledTrailLifetime", desc.Lifetime)
				end
				desc.Lifetime = 0
				desc.Enabled = false
			end)
		end
	end
end

-- Restore each Trail's Lifetime + Enabled from snapshot, clear the attributes for next cycle.
local function restoreTrails(root)
	if root:IsA("Trail") then
		pcall(function()
			local priorLife = root:GetAttribute("_pooledTrailLifetime")
			if priorLife ~= nil then root.Lifetime = priorLife end
			root:SetAttribute("_pooledTrailLifetime", nil)
			local prior = root:GetAttribute("_pooledTrailEnabled")
			if prior ~= nil then root.Enabled = prior == true end
			root:SetAttribute("_pooledTrailEnabled", nil)
		end)
		return
	end
	for _, desc in ipairs(root:GetDescendants()) do
		if desc:IsA("Trail") then
			pcall(function()
				local priorLife = desc:GetAttribute("_pooledTrailLifetime")
				if priorLife ~= nil then desc.Lifetime = priorLife end
				desc:SetAttribute("_pooledTrailLifetime", nil)
				local prior = desc:GetAttribute("_pooledTrailEnabled")
				if prior ~= nil then desc.Enabled = prior == true end
				desc:SetAttribute("_pooledTrailEnabled", nil)
			end)
		end
	end
end

-- Bump cancel + duration gens + disable nested ParticleEmitter / Trail descendants.
-- Invalidates pending delayed starts + delayed-off closures from Particles.EnableEmit
-- so stale fires can't land on a reused pooled visual.
local CANCEL_GEN_ATTR = "_PartIcleNativeEmitGen"
local DURATION_GEN_ATTR = "_PartIcleNativeDurationGen"
local function cancelNativeDescendants(root)
	for _, desc in ipairs(root:GetDescendants()) do
		if desc:IsA("ParticleEmitter") or desc:IsA("Trail") then
			pcall(function()
				local cancelCur = desc:GetAttribute(CANCEL_GEN_ATTR) or 0
				desc:SetAttribute(CANCEL_GEN_ATTR, cancelCur + 1)
				local durCur = desc:GetAttribute(DURATION_GEN_ATTR) or 0
				desc:SetAttribute(DURATION_GEN_ATTR, durCur + 1)
				desc.Enabled = false
			end)
		end
	end
end

function PoolHide.hide(instance, kind)
	if not instance or not instance.Parent then return end

	if kind == "Part" then
		-- disableTrails must run BEFORE cancelNativeDescendants so the snapshot reads
		-- the authored Trail.Enabled instead of the about-to-be-disabled value.
		disableTrails(instance)
		cancelNativeDescendants(instance)
		if instance:IsA("BasePart") then
			pcall(function() instance.CFrame = FAR_CFRAME end)
		end

	elseif kind == "Model" then
		disableTrails(instance)
		cancelNativeDescendants(instance)
		pcall(function() instance:PivotTo(FAR_CFRAME) end)

	elseif kind == "Beam" then
		-- Snapshot Color + Transparency before disable so reacquire with an empty colorStates
		-- graph restores authored values instead of inheriting the prior cycle's last frame.
		pcall(function()
			if instance:GetAttribute("_pooledBeamColor") == nil then
				instance:SetAttribute("_pooledBeamColor", instance.Color)
			end
			if instance:GetAttribute("_pooledBeamTransparency") == nil then
				instance:SetAttribute("_pooledBeamTransparency", instance.Transparency)
			end
			instance.Enabled = false
		end)

	elseif kind == "PointLight" then
		pcall(function() instance.Enabled = false end)

	elseif kind == "Highlight" then
		pcall(function() instance.Enabled = false end)

	elseif kind == "TrailEmitter" then
		pcall(function() instance.Enabled = false end)

	elseif kind == "ImageLabel" then
		-- ImageLabel has no .Enabled; .Visible=false is the equivalent hide. Pool.release
		-- re-parents to workspace.Terrain.Part_IclesPooled  -  Roblox tolerates GUI under
		-- non-ScreenGui ancestors (just doesn't render until reparented back).
		pcall(function() instance.Visible = false end)

	elseif kind == "Attachment" then
		-- Attachment stays at its real-world pose; cancel native PE/Trail
		-- descendants so stale delayed starts can't re-emit on the pooled
		-- attachment after the custom visual died. disableTrails runs first
		-- so its snapshot reads the authored Trail.Enabled instead of the
		-- about-to-be-disabled value (mirrors Part / Model branches).
		disableTrails(instance)
		cancelNativeDescendants(instance)
	-- Visible is intentionally untouched: toggling diverges pooled vs fresh
	-- (Visible defaults false on authored Attachments, exposing a 3D cross gizmo).
	end
end

function PoolHide.show(instance, kind)
	if not instance or not instance.Parent then return end
	-- Symmetric with hide: Beam/PointLight/Highlight/TrailEmitter Enabled flip kept self-contained in the pool contract.
	if kind == "Beam" then
		-- Restore authored Color + Transparency from snapshot before re-enable. Emit setup only
		-- writes Color/Transparency when a graph is non-empty (Emit.luau:582-583); without this
		-- restore, pooled Beams reused with no graph keep prior-cycle final-frame values.
		pcall(function()
			local priorColor = instance:GetAttribute("_pooledBeamColor")
			if priorColor ~= nil then instance.Color = priorColor end
			instance:SetAttribute("_pooledBeamColor", nil)
			local priorTrans = instance:GetAttribute("_pooledBeamTransparency")
			if priorTrans ~= nil then instance.Transparency = priorTrans end
			instance:SetAttribute("_pooledBeamTransparency", nil)
			instance.Enabled = true
		end)
	elseif kind == "PointLight" or kind == "Highlight" or kind == "TrailEmitter" then
		pcall(function() instance.Enabled = true end)
	elseif kind == "ImageLabel" then
		pcall(function() instance.Visible = true end)
	end
	-- Trail restore deferred to PoolHide.restoreTrails (caller sets new CFrame first).
end

-- Call AFTER setting the new spawn CFrame. Restores Trail.Enabled from snapshot. Safe on
-- fresh clones (no `_pooledTrailEnabled` attribute means no-op).
function PoolHide.restoreTrails(instance, kind)
	if not instance or not instance.Parent then return end
	if kind == "Part" or kind == "Model" or kind == "Attachment" then
		restoreTrails(instance)
	end
end

return PoolHide
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">Range</string>
              <string name="Source"><![CDATA[-- Range  -  pick a random value from a NumberRange.
local Range = {}

function Range.RandomValueFromRange(range: NumberRange)
	if range.Min == range.Max then return range.Min end
	return range.Min + ((range.Max - range.Min) * math.random())
end

return Range
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">ScreenEmit</string>
              <string name="Source"><![CDATA[-- ScreenEmit  -  Emit / Animate / Update for Blur, Bloom, ColorCorrection, Atmosphere.
-- Property-only animation, clone-per-emit. Animate mode is singleton (re-emits while active drop).

local Lighting = game:GetService("Lighting")
local GraphMod = require(script.Parent.Graph)
local RangeMod = require(script.Parent.Range)

return function(Particle)

-- EmitParent override wins, else Lighting. Source location never used as default.
local function resolveScreenParent(data, _kind)
	if data.EmitParent then return data.EmitParent end
	return Lighting
end

-- Atmosphere uses AtmTimescale attr; normalize to Graphs.Timescale here.
local function buildGraphs(kind, data)
	if kind == "Blur" then
		return { BlurSize = data.BlurSize, Timescale = data.Timescale }
	elseif kind == "Bloom" then
		return { BloomIntensity = data.BloomIntensity, BloomSize = data.BloomSize, BloomThreshold = data.BloomThreshold, Timescale = data.Timescale }
	elseif kind == "CC" then
		return { CCBrightness = data.CCBrightness, CCContrast = data.CCContrast, CCSaturation = data.CCSaturation, CCTintColor = data.CCTintColor, Timescale = data.Timescale }
	elseif kind == "Atmosphere" then
		return { AtmDensity = data.AtmDensity, AtmOffset = data.AtmOffset, AtmGlare = data.AtmGlare, AtmHaze = data.AtmHaze, AtmColor = data.AtmColor, AtmDecay = data.AtmDecay, Timescale = data.AtmTimescale }
	end
	return {}
end

-- ColorSequences skip seeds.
local function buildSeeds(graphs)
	local seeds = {}
	for k, g in pairs(graphs) do
		if typeof(g) == "NumberSequence" then seeds[k] = GraphMod.GenerateSeed(g) end
	end
	return seeds
end

-- Write a graph/color sample to the visual; kind routes to the property name.
-- skipColor / skipTransparency gate respective channel writes (sourced from pData
-- via payload.SetSkipColor / SetSkipTransparency in user Module scripts).
local function writeSample(kind, visual, graphs, seeds, t, skipColor, skipTransparency)
	if kind == "Blur" and graphs.BlurSize then
		visual.Size = GraphMod.QueryPointsWithTime(t, graphs.BlurSize, seeds.BlurSize)
	elseif kind == "Bloom" then
		if graphs.BloomIntensity then visual.Intensity = GraphMod.QueryPointsWithTime(t, graphs.BloomIntensity, seeds.BloomIntensity) end
		if graphs.BloomSize then visual.Size = GraphMod.QueryPointsWithTime(t, graphs.BloomSize, seeds.BloomSize) end
		if graphs.BloomThreshold then visual.Threshold = GraphMod.QueryPointsWithTime(t, graphs.BloomThreshold, seeds.BloomThreshold) end
	elseif kind == "CC" then
		if graphs.CCBrightness and not skipTransparency then visual.Brightness = GraphMod.QueryPointsWithTime(t, graphs.CCBrightness, seeds.CCBrightness) end
		if graphs.CCContrast then visual.Contrast = GraphMod.QueryPointsWithTime(t, graphs.CCContrast, seeds.CCContrast) end
		if graphs.CCSaturation then visual.Saturation = GraphMod.QueryPointsWithTime(t, graphs.CCSaturation, seeds.CCSaturation) end
		if graphs.CCTintColor and not skipColor then visual.TintColor = GraphMod.QueryColorPointWithTime(t, graphs.CCTintColor) end
	elseif kind == "Atmosphere" then
		if graphs.AtmDensity then visual.Density = GraphMod.QueryPointsWithTime(t, graphs.AtmDensity, seeds.AtmDensity) end
		if graphs.AtmOffset then visual.Offset = GraphMod.QueryPointsWithTime(t, graphs.AtmOffset, seeds.AtmOffset) end
		if graphs.AtmGlare then visual.Glare = GraphMod.QueryPointsWithTime(t, graphs.AtmGlare, seeds.AtmGlare) end
		if graphs.AtmHaze then visual.Haze = GraphMod.QueryPointsWithTime(t, graphs.AtmHaze, seeds.AtmHaze) end
		if graphs.AtmColor and not skipColor then visual.Color = GraphMod.QueryColorPointWithTime(t, graphs.AtmColor) end
		if graphs.AtmDecay and not skipColor then visual.Decay = GraphMod.QueryColorPointWithTime(t, graphs.AtmDecay) end
	end
end

-- Atmosphere has no Enabled; PostProcessEffect kinds do.
local function kindHasEnabled(kind)
	return kind ~= "Atmosphere"
end

-- Emit-mode: clone RT, apply initial sample BEFORE Parent (avoid 1-frame pop), push pData.
local function emitClone(self, kind, item, link, emitCtx)
	local data = self:GetData(item)
	if not data or not data.RenderTemplate then return end

	local visual = data.RenderTemplate:Clone()
	visual.Archivable = false
	if kindHasEnabled(kind) then visual.Enabled = true end
	visual:SetAttribute("_PartIcleEmit", true)

	local safeLife = RangeMod.RandomValueFromRange(data.Lifetime)
	if safeLife <= 0 then safeLife = 0.001 end

	local graphs = buildGraphs(kind, data)
	local seeds = buildSeeds(graphs)
	writeSample(kind, visual, graphs, seeds, 0)

	visual.Parent = resolveScreenParent(data, kind)

	local pData = {
		Type = "Screen", Kind = kind,
		VisualPart = visual,
		Events = data.Events,
		StartTime = os.clock(),
		TotalKeyFrames = math.max(1, data.TotalKeyFrames or 100), CurrentStep = 0,
		LifeTime = safeLife, PartLife = data.PartLife or 0,
		Graphs = graphs, Seeds = seeds,
		_effectiveElapsed = GraphMod.InitialEffectiveElapsed(graphs.Timescale, seeds.Timescale, safeLife),
		_sourceItem = item,
	}
	Particle._seedTsOverride(pData, item)
	self:_registerEmit(pData, emitCtx)
end

-- Singleton Animate: clone, play, destroy on end. Re-emits while active are no-ops.
local function emitAnimateInternal(self, kind, item, link, emitCtx)
	if self.ActiveAnimates[item] then return end

	local data = self:GetData(item)
	if not data or not data.RenderTemplate then return end

	local visual = data.RenderTemplate:Clone()
	visual.Archivable = false
	if kindHasEnabled(kind) then visual.Enabled = true end
	visual:SetAttribute("_PartIcleEmit", true)

	local safeLife = RangeMod.RandomValueFromRange(data.Lifetime)
	if safeLife <= 0 then safeLife = 0.001 end

	local graphs = buildGraphs(kind, data)
	local seeds = buildSeeds(graphs)
	writeSample(kind, visual, graphs, seeds, 0)

	visual.Parent = resolveScreenParent(data, kind)

	local pData = {
		Type = "Screen", Kind = kind,
		VisualPart = visual,
		Events = data.Events,
		StartTime = os.clock(),
		TotalKeyFrames = math.max(1, data.TotalKeyFrames or 100), CurrentStep = 0,
		LifeTime = safeLife, PartLife = data.PartLife or 0,
		Graphs = graphs, Seeds = seeds,
		_effectiveElapsed = GraphMod.InitialEffectiveElapsed(graphs.Timescale, seeds.Timescale, safeLife),
		IsAnimate = true, AnimateItem = item,
	}
	pData._sourceItem = item
	Particle._seedTsOverride(pData, item)
	self.ActiveAnimates[item] = pData
	self:_registerEmit(pData, emitCtx)
end

-- Per-kind public entry points (dispatched from Emit / EmitAnimate)

function Particle:EmitBlur(item, link, emitCtx) emitClone(self, "Blur", item, link, emitCtx) end
function Particle:EmitBloom(item, link, emitCtx) emitClone(self, "Bloom", item, link, emitCtx) end
function Particle:EmitColorCorrection(item, link, emitCtx) emitClone(self, "CC", item, link, emitCtx) end
function Particle:EmitAtmosphere(item, link, emitCtx) emitClone(self, "Atmosphere", item, link, emitCtx) end

function Particle:EmitBlurAnimate(item, link, emitCtx) emitAnimateInternal(self, "Blur", item, link, emitCtx) end
function Particle:EmitBloomAnimate(item, link, emitCtx) emitAnimateInternal(self, "Bloom", item, link, emitCtx) end
function Particle:EmitColorCorrectionAnimate(item, link, emitCtx) emitAnimateInternal(self, "CC", item, link, emitCtx) end
function Particle:EmitAtmosphereAnimate(item, link, emitCtx) emitAnimateInternal(self, "Atmosphere", item, link, emitCtx) end

-- Per-frame update; returns true when lifetime ends (Heartbeat culls via swap-and-pop).
function Particle:UpdateScreen(pData, dt, currentTime)
	if not pData.VisualPart or not pData.VisualPart.Parent then return true end
	if pData.TotalKeyFrames <= 0 then return true end

	-- Timescale v2 (signed reverse): see Update.luau UpdatePart. SetTimescale override wins for its window.
	local real_i = math.min(math.max((currentTime - pData.StartTime) / pData.LifeTime, 0), 1)
	local ts
	if pData._tsOverride ~= nil and currentTime < (pData._tsOverrideUntil or 0) then
		ts = pData._tsOverride
	else
		ts = pData.Graphs.Timescale and GraphMod.QueryPointsWithTime(real_i, pData.Graphs.Timescale, pData.Seeds.Timescale) or 1
	end
	local dtTs = dt * ts
	local lifeTime = pData.LifeTime
	local priorEff = pData._effectiveElapsed or 0
	local newEff = priorEff + (pData._timeFrozen and 0 or dtTs)
	if newEff < 0 then newEff = 0 end
	if newEff > lifeTime then newEff = lifeTime end
	pData._effectiveElapsed = newEff
	local atForwardEnd = newEff >= lifeTime
	local atBackwardEnd = newEff <= 0
	local elapsed = newEff
	local i = elapsed / lifeTime
	local graphFinished = real_i >= 1
	local isDying = graphFinished and (atForwardEnd or atBackwardEnd)
	if i > 1 then i = 1 end
	if i < 0 then i = 0 end

	local targetStep = math.floor(i * pData.TotalKeyFrames)
	if targetStep ~= pData.CurrentStep then
		pData.CurrentStep = targetStep
		local t = pData.CurrentStep / pData.TotalKeyFrames
		writeSample(pData.Kind, pData.VisualPart, pData.Graphs, pData.Seeds, t, pData.SkipColor, pData.SkipTransparency)
	end

	return isDying
end

end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">ScreenHost</string>
              <string name="Source"><![CDATA[-- ScreenHost  -  lazy singleton ScreenGui in CoreGui for ImageLabel emitters without an EmitParent.

local CoreGui = game:GetService("CoreGui")
local ScreenHost = {}
local _gui = nil

function ScreenHost.get()
	if _gui and _gui.Parent then return _gui end
	_gui = Instance.new("ScreenGui")
	_gui.Name = "PartIclesScreenHost"
	_gui.Archivable = false
	_gui.DisplayOrder = -10 -- below plugin UI (default 0)
	_gui.ResetOnSpawn = false
	_gui.IgnoreGuiInset = true
	_gui.Parent = CoreGui
	return _gui
end

function ScreenHost.destroy()
	if _gui then pcall(_gui.Destroy, _gui); _gui = nil end
end

function ScreenHost.exists() return _gui and _gui.Parent ~= nil end

return ScreenHost
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">StaticPass</string>
              <string name="Source"><![CDATA[-- StaticPass  -  detect constant-valued NumberSequence graphs at emit / AnimateLoop
-- replay time. Constant graphs nil out of pData.Graphs and their value stamps onto
-- pData._static<Name>. Per-frame Update sites read the static value, skipping the
-- QueryPointsWithTime call. Idempotent: clears stale static fields before re-detecting,
-- so a graph switched from static→dynamic mid-cycle correctly re-arms the per-frame
-- sample path.
--
-- ColorSequence not handled  -  Graph.IsStatic is NumberSequence-only. Color graphs
-- remain per-frame sampled (cost is real but step-quantized).
local Graph = require(script.Parent.Graph)

local StaticPass = {}

-- Per-type list of { graphName, staticFieldName, default }.
-- Add a graph here, then add `pData._static<Name> or ` to the matching Update sample
-- site. Field name must match between the table entry and the Update read.
local FIELDS = {
	Part = {
		{ "Speed",         "_staticSpeed",         0 },
		{ "Brightness",    "_staticBrightness",    1 },
		{ "Transparency",  "_staticTransparency",  0 },
		{ "SizeX",         "_staticSizeX",         1 },
		{ "SizeY",         "_staticSizeY",         1 },
		{ "SizeZ",         "_staticSizeZ",         1 },
		{ "RotSpeedX",     "_staticRotSpeedX",     0 },
		{ "RotSpeedY",     "_staticRotSpeedY",     0 },
		{ "RotSpeedZ",     "_staticRotSpeedZ",     0 },
		{ "PosOffsetX",    "_staticPosOffsetX",    0 },
		{ "PosOffsetY",    "_staticPosOffsetY",    0 },
		{ "PosOffsetZ",    "_staticPosOffsetZ",    0 },
		{ "AccelStrength", "_staticAccelStrength", 0 },
	},
	Attachment = {
		{ "Speed",         "_staticSpeed",         0 },
		{ "RotSpeedX",     "_staticRotSpeedX",     0 },
		{ "RotSpeedY",     "_staticRotSpeedY",     0 },
		{ "RotSpeedZ",     "_staticRotSpeedZ",     0 },
		{ "PosOffsetX",    "_staticPosOffsetX",    0 },
		{ "PosOffsetY",    "_staticPosOffsetY",    0 },
		{ "PosOffsetZ",    "_staticPosOffsetZ",    0 },
	},
	Model = {
		{ "Speed",         "_staticSpeed",         0 },
		{ "Scale",         "_staticScale",         1 },
		{ "RotSpeedX",     "_staticRotSpeedX",     0 },
		{ "RotSpeedY",     "_staticRotSpeedY",     0 },
		{ "RotSpeedZ",     "_staticRotSpeedZ",     0 },
		{ "PosOffsetX",    "_staticPosOffsetX",    0 },
		{ "PosOffsetY",    "_staticPosOffsetY",    0 },
		{ "PosOffsetZ",    "_staticPosOffsetZ",    0 },
	},
	ImageLabel = {
		{ "ImageTransparency",      "_staticImageTransparency",      0 },
		{ "BackgroundTransparency", "_staticBackgroundTransparency", 0 },
		{ "ImgSpeed",               "_staticImgSpeed",               0 },
		{ "ImgRotSpeed",            "_staticImgRotSpeed",            0 },
		{ "SizeScaleX",             "_staticSizeScaleX",             1 },
		{ "SizeScaleY",             "_staticSizeScaleY",             1 },
	},
	-- Beam props live under pData.BeamProps / pData.AnimatedProps, not pData.Graphs.
	-- Beam keeps its inline static-pass in Emit.luau / EmitAnimate.luau / Engine.luau.
}

-- Walk the type's FIELDS table. For each entry: if pData.Graphs[name] is a constant
-- NumberSequence, stamp pData[staticField] and nil the graph. Otherwise clear any
-- stale static field (covers graph→dynamic transitions between AnimateLoop cycles).
function StaticPass.apply(pData)
	if not pData or not pData.Type then return end
	local list = FIELDS[pData.Type]
	if not list then return end
	local g = pData.Graphs
	if not g then return end
	for _, entry in ipairs(list) do
		local graphName, staticField, default = entry[1], entry[2], entry[3]
		local seq = g[graphName]
		if seq and Graph.IsStatic(seq) then
			pData[staticField] = Graph.GetStaticValue(seq, default)
			g[graphName] = nil
		else
			-- Graph absent or dynamic: clear stale static field from prior cycle.
			pData[staticField] = nil
		end
	end
end

-- AnimateLoop replay support. Prior cycle's StaticPass.apply nil'd constant graphs
-- from pData.Graphs. AxisLinks.refreshLoopGraphsAndSeeds iterates `pairs(pData.Graphs)`,
-- so nil keys aren't repopulated from freshData. Call this BEFORE refresh to put the
-- absent keys back, then refresh runs normally, then StaticPass.apply re-detects.
function StaticPass.restoreFromFreshData(pData, freshData)
	if not pData or not freshData or not pData.Type then return end
	local list = FIELDS[pData.Type]
	if not list then return end
	local g = pData.Graphs
	if not g then return end
	for _, entry in ipairs(list) do
		local graphName = entry[1]
		if g[graphName] == nil and freshData[graphName] then
			g[graphName] = freshData[graphName]
		end
	end
end

return StaticPass
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">TexturePin</string>
              <string name="Source"><![CDATA[-- TexturePin  -  keeps texture assets resident in GPU memory so they don't redecode on first use.
-- 1×1 ImageLabel at ImageTransparency=0.99 parented to a hidden ScreenGui keeps the asset decoded
-- (fully transparent / invisible images get evicted). Owner-counted: pin survives until last owner
-- releases. Ref: https://devforum.roblox.com/t/preloading-images-and-keeping-them-loaded/2998098

local CoreGui = game:GetService("CoreGui")
local ContentProvider = game:GetService("ContentProvider")

local TexturePin = {}

local _gui = nil            -- hidden ScreenGui hosting every pin ImageLabel
local _pinned = {}          -- assetId -> ImageLabel
local _ownersOf = {}        -- assetId -> {[owner]=true,...}
local _assetsByOwner = {}   -- owner   -> {[assetId]=true,...}  reverse index for O(pins held) release
local _ANON = newproxy()    -- sentinel for pin() without owner; only clear() releases anonymous pins

local function ensureGui()
	if _gui and _gui.Parent then return _gui end
	_gui = Instance.new("ScreenGui")
	_gui.Name = "PartIclesTexturePin"
	_gui.Archivable = false
	_gui.DisplayOrder = -999
	_gui.IgnoreGuiInset = true
	_gui.ResetOnSpawn = false
	_gui.Parent = CoreGui
	return _gui
end

-- Resolve string ID or texture-bearing Instance to a Content ID; nil means skip.
local function _resolveAssetId(entry)
	if typeof(entry) == "string" then return entry ~= "" and entry or nil end
	if typeof(entry) ~= "Instance" then return nil end
	if entry:IsA("Decal") or entry:IsA("Texture") or entry:IsA("ParticleEmitter") or entry:IsA("Beam") or entry:IsA("Trail") then
		local t = entry.Texture; return (t and t ~= "") and t or nil
	elseif entry:IsA("ImageLabel") or entry:IsA("ImageButton") then
		local t = entry.Image; return (t and t ~= "") and t or nil
	elseif entry:IsA("SpecialMesh") then
		-- SpecialMesh.TextureId (lowercase d).
		local t = entry.TextureId; return (t and t ~= "") and t or nil
	elseif entry:IsA("MeshPart") then
		-- MeshPart.TextureID (uppercase D); checked AFTER Beam etc.
		local t = entry.TextureID; return (t and t ~= "") and t or nil
	end
end

-- SurfaceAppearance carries 4 PBR slots; pin all four. Other entries use _resolveAssetId.
local function _appendAssetIds(entry, list)
	if entry:IsA("SurfaceAppearance") then
		for _, prop in ipairs({"ColorMap", "NormalMap", "MetalnessMap", "RoughnessMap"}) do
			local ok, t = pcall(function() return entry[prop] end)
			if ok and t and t ~= "" then table.insert(list, t) end
		end
		return
	end
	local id = _resolveAssetId(entry)
	if id then table.insert(list, id) end
end

-- Pin one or many assets for `owner`. De-duped via `_pinned`; owner defaults to anonymous.
function TexturePin.pin(input, owner)
	if not input then return end
	owner = owner or _ANON
	local items = (type(input) == "table") and input or { input }
	local newPins = {}
	for _, entry in ipairs(items) do
		local assetId = _resolveAssetId(entry)
		if assetId then
			if not _pinned[assetId] then
				local gui = ensureGui()
				local img = Instance.new("ImageLabel")
				img.Name = "Pin"; img.Image = assetId
				img.Size = UDim2.fromOffset(1, 1); img.Position = UDim2.fromOffset(0, 0)
				img.BackgroundTransparency = 1; img.ImageTransparency = 0.99 -- 1.0 culls and evicts
				img.BorderSizePixel = 0; img.ZIndex = 1
				img.Parent = gui
				_pinned[assetId] = img
				table.insert(newPins, img)
			end
			local owners = _ownersOf[assetId]; if not owners then owners = {}; _ownersOf[assetId] = owners end
			owners[owner] = true
			local assets = _assetsByOwner[owner]; if not assets then assets = {}; _assetsByOwner[owner] = assets end
			assets[assetId] = true
		end
	end
	if #newPins > 0 then task.spawn(function() pcall(ContentProvider.PreloadAsync, ContentProvider, newPins) end) end
end

-- Pin every texture-bearing descendant of `root`; owner = root.
function TexturePin.pinSubtree(root)
	if not root then return end
	local ids = {}
	_appendAssetIds(root, ids)
	local ok, descendants = pcall(root.GetDescendants, root)
	if ok then
		for _, d in ipairs(descendants) do _appendAssetIds(d, ids) end
	end
	if #ids > 0 then TexturePin.pin(ids, root) end
end

function TexturePin.isPinned(assetId) return _pinned[assetId] ~= nil end

function TexturePin.count()
	local n = 0; for _ in pairs(_pinned) do n += 1 end; return n
end

-- Drop owner's claim. Pin destroyed only when zero owners remain.
function TexturePin.unpin(input, owner)
	if not input then return end
	owner = owner or _ANON
	local items = (type(input) == "table") and input or { input }
	for _, entry in ipairs(items) do
		local assetId = _resolveAssetId(entry)
		if assetId and _pinned[assetId] then
			local owners = _ownersOf[assetId]
			if owners then owners[owner] = nil end
			local assets = _assetsByOwner[owner]
			if assets then assets[assetId] = nil end
			local anyOwner = false; if owners then for _ in pairs(owners) do anyOwner = true; break end end
			if not anyOwner then
				pcall(_pinned[assetId].Destroy, _pinned[assetId])
				_pinned[assetId] = nil; _ownersOf[assetId] = nil
			end
		end
	end
end

-- Release every pin this owner holds; hooked into DescendantRemoving for auto-cleanup.
function TexturePin.releaseOwner(owner)
	if not owner then return end
	local assets = _assetsByOwner[owner]; if not assets then return end
	for assetId in pairs(assets) do
		local owners = _ownersOf[assetId]
		if owners then owners[owner] = nil end
		local anyOwner = false; if owners then for _ in pairs(owners) do anyOwner = true; break end end
		if not anyOwner and _pinned[assetId] then
			pcall(_pinned[assetId].Destroy, _pinned[assetId])
			_pinned[assetId] = nil; _ownersOf[assetId] = nil
		end
	end
	_assetsByOwner[owner] = nil
end

-- Mirror of pinSubtree; other owners' shares persist.
function TexturePin.unpinSubtree(root)
	if not root then return end
	local ids = {}
	_appendAssetIds(root, ids)
	local ok, descendants = pcall(root.GetDescendants, root)
	if ok then
		for _, d in ipairs(descendants) do _appendAssetIds(d, ids) end
	end
	if #ids > 0 then TexturePin.unpin(ids, root) end
end

-- Destroy every pin + the host ScreenGui. Called on plugin toggle-off / Deactivate.
function TexturePin.clear()
	_pinned = {}; _ownersOf = {}; _assetsByOwner = {}
	if _gui then pcall(_gui.Destroy, _gui); _gui = nil end
end

return TexturePin
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">Timescale</string>
              <string name="Source"><![CDATA[--[[
	Timescale Mixin  -  runtime timescale override for live particles + raw ParticleEmitters.

	Public API (after :Activate):
	  :SetTimescale(item, scale, duration, permanent)
	     scale      -  0 = time stop, <0 = reverse, >0 = speed multiplier.
	     duration   -  seconds before revert to original (ignored when permanent).
	     permanent  -  true → never expires (duration ignored); false → timed via duration;
	                 false + duration=0 collapses to :ClearTimescale so toggling off uses one method.
	  :ClearTimescale(item)
	  :AbsoluteSetTimescale / :AbsoluteClearTimescale (recursive, mirrors AbsoluteEnable).

	Dispatch:
	  - Transformed (Part-Icles) items: write `_tsOverride` + `_tsOverrideUntil` attrs;
	    SetTimescale walks `Particle.ActiveEmits` to flip existing pData; emit mixins call
	    `Particle._seedTsOverride(pData, src)` so new emits during the window inherit; Update
	    mixins gate on `currentTime < pData._tsOverrideUntil` and fall back to `Graphs.Timescale`.
	  - Raw `ParticleEmitter` instances: write `.TimeScale` directly. Original value stashed
	    in `_origTimeScale` so concurrent SetTimescale calls don't lose it. `_tsGen` invalidates
	    stale `task.delay` restore closures so newer calls win.
]]

return function(Particle)

	-- Emit-site seeder. Stale attrs on src are harmless: Update mixin gate expires them lazily.
	function Particle._seedTsOverride(pData, src)
		if not src then return end
		pData._tsOverride = src:GetAttribute("_tsOverride")
		pData._tsOverrideUntil = src:GetAttribute("_tsOverrideUntil")
	end

	-- Native ParticleEmitter path. Stash original once, write override, schedule restore.
	local function _setNativePE(pe, scale, duration, permanent)
		if pe:GetAttribute("_origTimeScale") == nil then
			pcall(function() pe:SetAttribute("_origTimeScale", pe.TimeScale) end)
		end
		pcall(function() pe.TimeScale = scale end)
		-- Generation token: bump invalidates any pending stale restore closure.
		local gen = (pe:GetAttribute("_tsGen") or 0) + 1
		pcall(function() pe:SetAttribute("_tsGen", gen) end)
		if permanent == true then return end
		task.delay(duration, function()
			if not pe.Parent then return end
			if pe:GetAttribute("_tsGen") ~= gen then return end
			local orig = pe:GetAttribute("_origTimeScale")
			if orig ~= nil then
				pcall(function() pe.TimeScale = orig end)
				pcall(function() pe:SetAttribute("_origTimeScale", nil) end)
			end
			pcall(function() pe:SetAttribute("_tsGen", nil) end)
		end)
	end

	local function _clearNativePE(pe)
		local orig = pe:GetAttribute("_origTimeScale")
		if orig ~= nil then
			pcall(function() pe.TimeScale = orig end)
			pcall(function() pe:SetAttribute("_origTimeScale", nil) end)
		end
		-- Bump + clear gen so any pending task.delay closure from a prior timed call bails.
		local gen = (pe:GetAttribute("_tsGen") or 0) + 1
		pcall(function() pe:SetAttribute("_tsGen", gen) end)
		pcall(function() pe:SetAttribute("_tsGen", nil) end)
	end

	-- Apply a timescale override to a Transformed item or raw ParticleEmitter. See file header
	-- for scale / duration / permanent semantics + dispatch table.
	function Particle:SetTimescale(item, scale, duration, permanent)
		if not item then return end
		if typeof(scale) ~= "number" then return end
		local effectiveDuration
		if permanent == true then
			effectiveDuration = nil
		elseif typeof(duration) == "number" and duration > 0 then
			effectiveDuration = duration
		else
			self:ClearTimescale(item)
			return
		end
		if item:IsA("ParticleEmitter") then
			_setNativePE(item, scale, effectiveDuration, permanent)
			return
		end
		local until_ = (permanent == true) and math.huge or (os.clock() + effectiveDuration)
		pcall(function()
			item:SetAttribute("_tsOverride", scale)
			item:SetAttribute("_tsOverrideUntil", until_)
		end)
		local active = self.ActiveEmits
		for i = 1, #active do
			local pData = active[i]
			if pData and pData._sourceItem == item then
				pData._tsOverride = scale
				pData._tsOverrideUntil = until_
			end
		end
	end

	-- Remove timescale override from a Transformed item or raw ParticleEmitter. Inverse of
	-- SetTimescale; restores `Graphs.Timescale` (Transformed) or `_origTimeScale` (native PE).
	function Particle:ClearTimescale(item)
		if not item then return end
		if item:IsA("ParticleEmitter") then
			_clearNativePE(item)
			return
		end
		pcall(function()
			item:SetAttribute("_tsOverride", nil)
			item:SetAttribute("_tsOverrideUntil", nil)
		end)
		local active = self.ActiveEmits
		for i = 1, #active do
			local pData = active[i]
			if pData and pData._sourceItem == item then
				pData._tsOverride = nil
				pData._tsOverrideUntil = nil
			end
		end
	end

	-- Recurse like AbsoluteEnable. Transformed items + raw ParticleEmitters both terminal.
	function Particle:AbsoluteSetTimescale(item, scale, duration, permanent)
		if not item then return end
		if item:GetAttribute("Transformed") then
			self:SetTimescale(item, scale, duration, permanent)
			return
		end
		if item:IsA("ParticleEmitter") then
			self:SetTimescale(item, scale, duration, permanent)
			return
		end
		for _, child in item:GetChildren() do
			if item:IsA("BasePart") and child:IsA("BasePart") and not child:GetAttribute("Transformed") then
				continue
			end
			self:AbsoluteSetTimescale(child, scale, duration, permanent)
		end
	end

	-- Recursive ClearTimescale across `item` + transformed descendants.
	function Particle:AbsoluteClearTimescale(item)
		if not item then return end
		if item:GetAttribute("Transformed") then
			self:ClearTimescale(item)
			return
		end
		if item:IsA("ParticleEmitter") then
			self:ClearTimescale(item)
			return
		end
		for _, child in item:GetChildren() do
			if item:IsA("BasePart") and child:IsA("BasePart") and not child:GetAttribute("Transformed") then
				continue
			end
			self:AbsoluteClearTimescale(child)
		end
	end

end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">TrailEmitter</string>
              <string name="Source"><![CDATA[--[[
	TrailEmitter Mixin  -  Emit + Update for Trail particles (emitter mode, post-Transform-as-Emitter).
	Mirrors Beam emitter pattern: static spatial position (welded to existing Attachment0/Attachment1),
	animation entirely via graphs. Width / Transparency / Color drive through TrailGraphBlender;
	Brightness / LightEmission / LightInfluence / TextureLength / MinLength / MaxLength are
	per-frame scalar graphs sampled at the current step's i.

	Cross-file invariants:
	  - pData.Type = "TrailEmitter"  -  Heartbeat dispatch routes to UpdateTrail
	  - Lifecycle.cancelAnimation reads pData.TrailEmitterSnapshot to restore live RT (animate mode)
	  - PoolHide kind "TrailEmitter" → Enabled=false on release / true on acquire
	  - data.RenderTemplate is the cloned Trail; clones share its Attachment0/Attachment1 references
]]

local GraphMod = require(script.Parent.Graph)
local RangeMod = require(script.Parent.Range)
local TrailGraphBlender = require(script.Parent.TrailGraphBlender)
local Pool = require(script.Parent.Pool)
local MeshFlipbook = require(script.Parent.Flipbook)

return function(Particle)

-- Per-particle scalar graphs sampled at each step. Keep aligned with TrailEmitterProperties.
local SCALAR_GRAPHS = {"Brightness", "LightEmission", "LightInfluence", "TextureLength", "MinLength", "MaxLength"}

local function _writeBlenderState(visual, propName, states, mergedTimesList, lastIdxField, pData, t)
	if not states or #states == 0 then return end
	if #states == 1 then
		visual[propName] = states[1].Graph
		return
	end
	local lastIdx = pData[lastIdxField] or 1
	if t < states[lastIdx].Time then lastIdx = 1 end
	local pairIdx = #states - 1
	for idx = lastIdx, #states - 1 do
		if t >= states[idx].Time and t <= states[idx + 1].Time then
			pairIdx = idx; break
		end
	end
	pData[lastIdxField] = pairIdx
	local lower = states[pairIdx]
	local upper = states[pairIdx + 1] or states[#states]
	local range = upper.Time - lower.Time
	local segmentAlpha = range > 0 and ((t - lower.Time) / range) or 0
	local mergedTimes = mergedTimesList and mergedTimesList[pairIdx]
	if mergedTimes then
		if propName == "Color" then
			visual[propName] = GraphMod.LerpColorGraphFast(lower.Graph, upper.Graph, segmentAlpha, mergedTimes)
		else
			visual[propName] = GraphMod.LerpGraphFast(lower.Graph, upper.Graph, segmentAlpha, mergedTimes)
		end
	end
end

-- Per-frame Heartbeat update for TrailEmitter particles. Width / Transparency / Color drive
-- through TrailGraphBlender; scalar graphs (Brightness / LightEmission / etc) sample per frame.
function Particle:UpdateTrail(pData, dt, currentTime)
	-- Signed-reverse timescale support: see Update.luau UpdatePart. SetTimescale override wins for its window.
	local real_i = math.min(math.max((currentTime - pData.StartTime) / pData.LifeTime, 0), 1)
	local ts
	if pData._tsOverride ~= nil and currentTime < (pData._tsOverrideUntil or 0) then
		ts = pData._tsOverride
	else
		ts = pData.Graphs.Timescale and GraphMod.QueryPointsWithTime(real_i, pData.Graphs.Timescale, pData.Seeds.Timescale) or 1
	end
	local dtTs = dt * ts
	local lifeTime = pData.LifeTime
	local priorEff = pData._effectiveElapsed or 0
	local newEff = priorEff + (pData._timeFrozen and 0 or dtTs)
	if newEff < 0 then newEff = 0 end
	if newEff > lifeTime then newEff = lifeTime end
	pData._effectiveElapsed = newEff
	local atForwardEnd = newEff >= lifeTime
	local atBackwardEnd = newEff <= 0
	local elapsedTime = newEff
	local i = elapsedTime / lifeTime

	if not pData.VisualPart or not pData.VisualPart.Parent then return true end
	local graphFinished = real_i >= 1
	local isDying = graphFinished and (atForwardEnd or atBackwardEnd)
	i = math.min(math.max(i, 0), 1)

	-- Width / Transparency / Color blender (continuous-time, FPS-independent).
	local t = i
	if not pData.SkipColor then
		_writeBlenderState(pData.VisualPart, "WidthScale",   pData.WidthStates, pData.WidthMergedTimes, "_lastWidthIdx", pData, t)
		_writeBlenderState(pData.VisualPart, "Color",        pData.ColorStates, pData.ColorMergedTimes, "_lastColorIdx", pData, t)
	end
	if not pData.SkipTransparency then
		_writeBlenderState(pData.VisualPart, "Transparency", pData.TransStates, pData.TransMergedTimes, "_lastTransIdx", pData, t)
	end

	-- Step-quantized scalar graphs (Brightness / LightEmission / LightInfluence / TextureLength / MinLength / MaxLength).
	if pData.TotalKeyFrames > 0 then
		local targetStep = math.floor(i * pData.TotalKeyFrames)
		if targetStep ~= pData.CurrentStep then
			pData.CurrentStep = targetStep
			local steppedI = pData.CurrentStep / pData.TotalKeyFrames
			for _, key in ipairs(SCALAR_GRAPHS) do
				local graph = pData.Graphs[key]
				if graph then
					pData.VisualPart[key] = GraphMod.QueryPointsWithTime(steppedI, graph, pData.Seeds[key])
				end
			end
		end
	end

	return isDying
end

local function _collectStatesAndMergedTimes(graphBlender)
	local widthStates, transStates, colorStates = TrailGraphBlender.CollectStates(graphBlender)
	local widthMergedTimes, transMergedTimes, colorMergedTimes = {}, {}, {}
	for idx = 1, #widthStates - 1 do widthMergedTimes[idx] = TrailGraphBlender.PrecomputeMergedTimes(widthStates[idx].Graph, widthStates[idx + 1].Graph) end
	for idx = 1, #transStates - 1 do transMergedTimes[idx] = TrailGraphBlender.PrecomputeMergedTimes(transStates[idx].Graph, transStates[idx + 1].Graph) end
	for idx = 1, #colorStates - 1 do colorMergedTimes[idx] = TrailGraphBlender.PrecomputeMergedColorTimes(colorStates[idx].Graph, colorStates[idx + 1].Graph) end
	return widthStates, transStates, colorStates, widthMergedTimes, transMergedTimes, colorMergedTimes
end

local function _buildScalarGraphs(data)
	local graphs = { Timescale = data.TEmitTimescale }
	local seeds = { Timescale = GraphMod.GenerateSeed(data.TEmitTimescale) }
	for _, key in ipairs(SCALAR_GRAPHS) do
		local g = data["TEmit" .. key] or data[key]
		if g then
			graphs[key] = g
			seeds[key] = GraphMod.GenerateSeed(g)
		end
	end
	return graphs, seeds
end

-- Spawn a TrailEmitter particle: clones RenderTemplate, applies authored Width / Color graphs,
-- registers in ActiveEmits. Trail inherits Attachment0/Attachment1 references from the clone source.
function Particle:EmitTrail(trail, link, emitCtx)
	if not trail or not trail.Parent then return end
	local data = self:GetData(trail)
	if not data or not data.RenderTemplate then return end

	local visual = Pool.acquireOrClone(data.RenderTemplate, "TrailEmitter", data.Pool)
	visual.Archivable = false
	visual.Enabled = true
	-- Static props (Texture/TextureMode/FaceCamera) come from the cloned RT directly; no
	-- attribute-side mirror, so no override needed here.

	-- Rebind parent-scope Attachment0/1 refs via parent's clone map (nested-emit path).
	if emitCtx and emitCtx._parentCloneMap then
		local map = emitCtx._parentCloneMap
		if visual.Attachment0 and map[visual.Attachment0] then visual.Attachment0 = map[visual.Attachment0] end
		if visual.Attachment1 and map[visual.Attachment1] then visual.Attachment1 = map[visual.Attachment1] end
	end

	local safeLifeTime = RangeMod.RandomValueFromRange(data.Lifetime)
	if safeLifeTime <= 0 then safeLifeTime = 0.001 end
	-- visual.Lifetime is the Trail's segment fade duration, separate from particle Lifetime.
	local trailLifeRange = data.TrailLife or data.Lifetime
	local trailLifeVal = RangeMod.RandomValueFromRange(trailLifeRange)
	if trailLifeVal <= 0 then trailLifeVal = 0.001 end
	visual.Lifetime = trailLifeVal

	local widthStates, transStates, colorStates,
		widthMergedTimes, transMergedTimes, colorMergedTimes = _collectStatesAndMergedTimes(data.GraphBlender)

	if #widthStates > 0 then visual.WidthScale = widthStates[1].Graph end
	if #transStates > 0 then visual.Transparency = transStates[1].Graph end
	if #colorStates > 0 then visual.Color = colorStates[1].Graph end

	local graphs, seeds = _buildScalarGraphs(data)
	for _, key in ipairs(SCALAR_GRAPHS) do
		if graphs[key] then
			visual[key] = GraphMod.QueryPointsWithTime(0, graphs[key], seeds[key])
		end
	end

	visual.Parent = data.EmitParent or self:GetFolder()

	local pData = {
		Type = "TrailEmitter",
		VisualPart = visual,
		Link = link,
		Events = data.Events,
		StartTime = os.clock(),
		TotalKeyFrames = math.max(1, data.TotalKeyFrames),
		CurrentStep = 0,
		LifeTime = safeLifeTime,
		PartLife = data.PartLife or 0,
		WidthStates = widthStates, TransStates = transStates, ColorStates = colorStates,
		WidthMergedTimes = widthMergedTimes, TransMergedTimes = transMergedTimes, ColorMergedTimes = colorMergedTimes,
		Graphs = graphs,
		Seeds = seeds,
		_effectiveElapsed = GraphMod.InitialEffectiveElapsed(data.TEmitTimescale, seeds.Timescale, safeLifeTime),
	}

	pData._sourceItem = trail
	Particle._seedTsOverride(pData, trail)
	if data.Pool ~= false then pData._sourceRT, pData._poolKind = data.RenderTemplate, "TrailEmitter" end
	self:_registerEmit(pData, emitCtx)

	-- Flipbook: cycle visual.Texture through TrailFlipbooks/Decals. FlipBeam is generic over any
	-- target with a Texture property (Trail qualifies); reuse rather than fork a TrailFlipbook
	-- runtime. Mode/framerate/etc. live in the TEmitFlipbook* attrs read by GetData.
	if data.TrailFlipbookMode and data.TrailFlipbooks then
		local decals = MeshFlipbook.GetSortedBeamTextures(data.TrailFlipbooks)
		if #decals > 0 then
			local spec = {
				FlipbookMode = data.TrailFlipbookMode,
				FlipbookFramerate = data.TrailFlipbookFramerate,
				FlipbookStartRandom = data.TrailFlipbookStartRandom,
				FlipbookReverse = data.TrailFlipbookReverse,
			}
			MeshFlipbook.FlipBeam(pData, spec, decals, visual, safeLifeTime)
		end
	end
end

-- Animate mode: operate on the LIVE RenderTemplate. cancelAnimation/finishAnimate restore the
-- snapshotted intrinsic Trail props and disable the trail when the cycle ends.
function Particle:EmitTrailAnimate(trail, link, emitCtx)
	if not trail or not trail.Parent then return end
	if self.ActiveAnimates[trail] then return end
	local data = self:GetData(trail)
	if not data or not data.RenderTemplate then return end

	local visual = data.RenderTemplate -- LIVE source, not a clone

	-- Snapshot BEFORE mutating so cancelAnimation restores authored values (mirrors Beam pattern).
	local snapshot = {
		Lifetime = visual.Lifetime,
		Brightness = visual.Brightness,
		LightEmission = visual.LightEmission,
		LightInfluence = visual.LightInfluence,
		TextureLength = visual.TextureLength,
		MinLength = visual.MinLength,
		MaxLength = visual.MaxLength,
		Texture = visual.Texture,
		TextureMode = visual.TextureMode,
		FaceCamera = visual.FaceCamera,
		WidthScale = visual.WidthScale,
		Transparency = visual.Transparency,
		Color = visual.Color,
		Enabled = visual.Enabled,
	}

	visual.Enabled = true
	-- Static props (Texture/TextureMode/FaceCamera) come from the live source directly (no clone).

	local safeLifeTime = RangeMod.RandomValueFromRange(data.Lifetime)
	if safeLifeTime <= 0 then safeLifeTime = 0.001 end
	local trailLifeRange = data.TrailLife or data.Lifetime
	local trailLifeVal = RangeMod.RandomValueFromRange(trailLifeRange)
	if trailLifeVal <= 0 then trailLifeVal = 0.001 end
	visual.Lifetime = trailLifeVal

	local widthStates, transStates, colorStates,
		widthMergedTimes, transMergedTimes, colorMergedTimes = _collectStatesAndMergedTimes(data.GraphBlender)

	if #widthStates > 0 then visual.WidthScale = widthStates[1].Graph end
	if #transStates > 0 then visual.Transparency = transStates[1].Graph end
	if #colorStates > 0 then visual.Color = colorStates[1].Graph end

	local graphs, seeds = _buildScalarGraphs(data)
	for _, key in ipairs(SCALAR_GRAPHS) do
		if graphs[key] then
			visual[key] = GraphMod.QueryPointsWithTime(0, graphs[key], seeds[key])
		end
	end

	local pData = {
		Type = "TrailEmitter",
		VisualPart = visual,
		Link = link,
		Events = data.Events,
		StartTime = os.clock(),
		TotalKeyFrames = math.max(1, data.TotalKeyFrames),
		CurrentStep = 0,
		LifeTime = safeLifeTime,
		PartLife = data.PartLife or 0,
		IsAnimate = true, AnimateItem = trail,
		TrailEmitterSnapshot = snapshot,
		WidthStates = widthStates, TransStates = transStates, ColorStates = colorStates,
		WidthMergedTimes = widthMergedTimes, TransMergedTimes = transMergedTimes, ColorMergedTimes = colorMergedTimes,
		Graphs = graphs,
		Seeds = seeds,
		_effectiveElapsed = GraphMod.InitialEffectiveElapsed(data.TEmitTimescale, seeds.Timescale, safeLifeTime),
	}

	pData._sourceItem = trail
	Particle._seedTsOverride(pData, trail)
	self.ActiveAnimates[trail] = pData
	self:_registerEmit(pData, emitCtx)

	if data.TrailFlipbookMode and data.TrailFlipbooks then
		local decals = MeshFlipbook.GetSortedBeamTextures(data.TrailFlipbooks)
		if #decals > 0 then
			local spec = {
				FlipbookMode = data.TrailFlipbookMode,
				FlipbookFramerate = data.TrailFlipbookFramerate,
				FlipbookStartRandom = data.TrailFlipbookStartRandom,
				FlipbookReverse = data.TrailFlipbookReverse,
			}
			MeshFlipbook.FlipBeam(pData, spec, decals, visual, safeLifeTime)
		end
	end
end

end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">TrailGraphBlender</string>
              <string name="Source"><![CDATA[--[[
	TrailGraphBlender  -  multi-state interpolation for Trail emitter properties.
	Mirrors Graph.CollectGraphStates structure but adds a third Width track alongside
	Transparency + Color. Configuration children under the GraphBlender folder each
	carry Time + Width + Transparency + Color attributes; this collector returns three
	sorted state lists. The actual per-frame pair-state interpolation reuses Graph's
	PrecomputeMergedTimes + LerpGraphFast / LerpColorGraphFast.
]]

local Graph = require(script.Parent.Graph)

local TrailGraphBlender = {}

-- Collect blender states from a GraphBlender folder into three time-sorted lists
-- (width / transparency / color). Returned lists feed Graph.PrecomputeMergedTimes + LerpGraphFast
-- at runtime for per-frame interpolation between authored Configuration states.
function TrailGraphBlender.CollectStates(graphBlender)
	local widthStates, transStates, colorStates = {}, {}, {}
	if not graphBlender then return widthStates, transStates, colorStates end

	for _, child in pairs(graphBlender:GetChildren()) do
		if not child:IsA("Configuration") then continue end
		local time = child:GetAttribute("Time")
		if time == nil then
			local num = tonumber(string.match(child.Name, "%d+"))
			time = num and (num - 1) or 0
		end
		local width = child:GetAttribute("Width")
		if width and typeof(width) == "NumberSequence" then
			table.insert(widthStates, {Time = time, Graph = width})
		end
		local trans = child:GetAttribute("Transparency")
		if trans and typeof(trans) == "NumberSequence" then
			table.insert(transStates, {Time = time, Graph = trans})
		end
		local color = child:GetAttribute("Color")
		if color and typeof(color) == "ColorSequence" then
			table.insert(colorStates, {Time = time, Graph = color})
		end
	end

	-- Sort each list by Time + normalize fallback values into 0-1 range.
	for _, states in ipairs({widthStates, transStates, colorStates}) do
		table.sort(states, function(a, b) return a.Time < b.Time end)
		if #states > 1 and states[#states].Time > 1 then
			local maxTime = states[#states].Time
			if maxTime > 0 then for _, s in ipairs(states) do s.Time = s.Time / maxTime end end
		end
	end

	return widthStates, transStates, colorStates
end

-- Reuse Graph's existing math; Trail blender doesn't need new sequence-merge primitives.
TrailGraphBlender.PrecomputeMergedTimes = Graph.PrecomputeMergedTimes
TrailGraphBlender.PrecomputeMergedColorTimes = Graph.PrecomputeMergedColorTimes
TrailGraphBlender.LerpGraphFast = Graph.LerpGraphFast
TrailGraphBlender.LerpColorGraphFast = Graph.LerpColorGraphFast

return TrailGraphBlender
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">Transform</string>
              <string name="Source"><![CDATA[--[[
	Transform Mixin  -  converts an Instance into a Part-Icles emitter.
	  :Transform stamps attributes, creates PartIcleProperties Configuration + RenderTemplate, hides source.
	  :PreSimulateForward / :PreSimulateAttachmentForward  -  return local CFrames per step
	    without emitting. Used by Motion Preview and reused by Emit so live sim matches preview.
]]

local GraphMod = require(script.Parent.Graph)
local TypeRegistry = require(script.Parent.TypeRegistry)
local Constants = require(script.Parent.PartConstants)
local DirectionVectors = Constants.DirectionVectors

return function(Particle)

-- TransformCompleted fires after Transform/TransformModel/transformDirectAccess; lazy create.
if not Particle.TransformCompleted then
	Particle.TransformCompleted = Instance.new("BindableEvent")
end

-- Main dispatch. Plain directAccess Trail/Beam are promote-eligible: Transform stamps
-- PartIcleProperties + RenderTemplate so the item flips classCheck to TrailEmitter / Beam.
function Particle:Transform(part)
	if part:GetAttribute("Transformed") then return end
	local typeDef = TypeRegistry.getTypeFor(part)
	if not typeDef then return end

	-- Promoting a directAccess type: swap to the emitter typeDef before createConfig so the
	-- Configuration child carries TrailEmitter / Beam property defaults (not the directAccess shape).
	if typeDef.directAccess then
		if part:IsA("Trail") and TypeRegistry.Types.TrailEmitter then
			typeDef = TypeRegistry.Types.TrailEmitter
		elseif part:IsA("Beam") and TypeRegistry.Types.Beam then
			typeDef = TypeRegistry.Types.Beam
		else
			return
		end
	end

	if part:IsA("Model") then
		if not part.PrimaryPart then
			-- pcall(require) needs FindFirstChild guard; pcall can't protect the index before require sees it.
			local _modulesParent = script.Parent.Parent
			local _uiBuilder = _modulesParent and _modulesParent:FindFirstChild("UIBuilder")
			local _widgetsModule = _uiBuilder and _uiBuilder:FindFirstChild("Widgets")
			local Widgets
			if _widgetsModule then local okW; okW, Widgets = pcall(require, _widgetsModule); if not okW then Widgets = nil end end
			if Widgets and Widgets.showToast then
				Widgets.showToast("Model requires a PrimaryPart to be transformed.", "warn", 4)
			end
			warn("Part-Icles: Model requires PrimaryPart")
			return
		end
		return self:TransformModel(part, typeDef)
	end

	local config = TypeRegistry.createConfig(part, typeDef)

	local renderTemplate = part:Clone()
	renderTemplate.Name = "RenderTemplate"

	for _, child in renderTemplate:GetChildren() do
		if child:GetAttribute("Transformed") or child:IsA("Attachment") then continue end
		if child.Name == TypeRegistry.CONFIG_NAME or child.Name == "EmitParent" or child.Name == "Link" or child.Name == "AccelTarget" or child.Name == "ImageFlipbooks" then
			child:Destroy()
		elseif part:IsA("PointLight") or part:IsA("Highlight") then
			child:Destroy()
		elseif part:IsA("Attachment") then
			-- Strip plugin internals; keep authored Trails/Beams/Decals.
			if child.Name == "MeshFlipbooks" or child.Name == "BeamFlipbooks" or child.Name == "GraphBlender" then
				child:Destroy()
			end
		elseif part:IsA("ImageLabel") then
			-- Keep UIComponent decorators (UIGradient/UICorner/UIStroke/UIPadding).
			if not child:IsA("UIComponent") then child:Destroy() end
		elseif not child:IsA("SpecialMesh") and not child:IsA("Decal") and not child:IsA("Texture") and not child:IsA("SurfaceAppearance") then
			-- SurfaceAppearance must survive; Emit reads it via FindFirstChildOfClass.
			child:Destroy()
		end
	end

	-- Strip plugin attributes; preserve user-authored ones.
	for _, attrName in ipairs({"Transformed", "Qwinkle", "IsEmitter", "EmitCount", "EmitDuration", "EmitDelay", "EmissionMode", "AnimateLoop", "PreloadTexture", "LinkMode", "LinkSource"}) do
		renderTemplate:SetAttribute(attrName, nil)
	end

	if renderTemplate:IsA("BasePart") then
		renderTemplate.Anchored = true; renderTemplate.CanCollide = false; renderTemplate.CanQuery = false
		renderTemplate.CanTouch = false; renderTemplate.CastShadow = false; renderTemplate.Massless = true; renderTemplate.Locked = true
		renderTemplate.Transparency = 1
		for _, c in ipairs(renderTemplate:GetChildren()) do
			if c:IsA("Decal") or c:IsA("Texture") then c.Transparency = 1 end
		end
	end

	if renderTemplate:IsA("Attachment") then
		renderTemplate.CFrame = CFrame.new()
	end

	-- Silence native PEs/Trails on the RT (they ignore parent hidden state). Skip Transformed
	-- ones  -  directAccess Trails own .Enabled, and nested transformed PEs have their own lifecycle.
	for _, desc in ipairs(renderTemplate:GetDescendants()) do
		if (desc:IsA("ParticleEmitter") or desc:IsA("Trail"))
			and not desc:GetAttribute("Transformed")
		then desc.Enabled = false end
	end

	renderTemplate.Parent = part

	-- Capture authored visuals so emitter defaults reflect the source's pre-transform state.
	-- Size: SpecialMesh.Scale wins. Color/Transparency: first Decal wins UNLESS a
	-- SurfaceAppearance is present (PBR covers the surface  -  Decal is irrelevant).
	-- Read BEFORE the source strip below destroys the SpecialMesh/Decal children.
	if part:IsA("BasePart") and not part:IsA("Terrain") then
		local sizeVec = part.Size
		local meshChild = part:FindFirstChildWhichIsA("SpecialMesh")
		if meshChild then sizeVec = meshChild.Scale end
		local colorVal = part.Color
		local transparencyVal = part.Transparency
		local hasSurfaceAppearance = part:FindFirstChildWhichIsA("SurfaceAppearance") ~= nil
		if not hasSurfaceAppearance then
			local decalChild = part:FindFirstChildWhichIsA("Decal")
			if decalChild then
				colorVal = decalChild.Color3
				transparencyVal = decalChild.Transparency
			end
		end
		config:SetAttribute("SizeX", NumberSequence.new(sizeVec.X))
		config:SetAttribute("SizeY", NumberSequence.new(sizeVec.Y))
		config:SetAttribute("SizeZ", NumberSequence.new(sizeVec.Z))
		config:SetAttribute("Color", ColorSequence.new(colorVal))
		config:SetAttribute("Transparency", NumberSequence.new(transparencyVal))
	end

	-- Hide source: visual children moved to RT.
	if part:IsA("BasePart") then
		for _, child in ipairs(part:GetChildren()) do
			if child ~= renderTemplate and (child:IsA("SpecialMesh") or child:IsA("Decal") or child:IsA("Texture")) then child:Destroy() end
		end
		part.Transparency = 1
	elseif part:IsA("PointLight") then
		part.Enabled = false
	elseif part:IsA("Highlight") then
		part.Enabled = false
	elseif part:IsA("PostProcessEffect") then
		part.Enabled = false
	elseif part:IsA("ImageLabel") then
		part.Visible = false
	end

	if part:IsA("PointLight") then
		config:SetAttribute("Shadows", part.Shadows)
	end

	-- Capture authored PostProcessEffect / Atmosphere into config as single-keypoint sequences.
	if part:IsA("BlurEffect") then
		config:SetAttribute("BlurSize", NumberSequence.new(part.Size))
	elseif part:IsA("BloomEffect") then
		config:SetAttribute("BloomIntensity", NumberSequence.new(part.Intensity))
		config:SetAttribute("BloomSize", NumberSequence.new(part.Size))
		config:SetAttribute("BloomThreshold", NumberSequence.new(part.Threshold))
	elseif part:IsA("ColorCorrectionEffect") then
		config:SetAttribute("CCBrightness", NumberSequence.new(part.Brightness))
		config:SetAttribute("CCContrast", NumberSequence.new(part.Contrast))
		config:SetAttribute("CCSaturation", NumberSequence.new(part.Saturation))
		config:SetAttribute("CCTintColor", ColorSequence.new(part.TintColor))
	elseif part:IsA("Atmosphere") then
		config:SetAttribute("AtmDensity", NumberSequence.new(part.Density))
		config:SetAttribute("AtmOffset", NumberSequence.new(part.Offset))
		config:SetAttribute("AtmGlare", NumberSequence.new(part.Glare))
		config:SetAttribute("AtmHaze", NumberSequence.new(part.Haze))
		config:SetAttribute("AtmColor", ColorSequence.new(part.Color))
		config:SetAttribute("AtmDecay", ColorSequence.new(part.Decay))
	elseif part:IsA("Highlight") then
		config:SetAttribute("HLFillColor", ColorSequence.new(part.FillColor))
		config:SetAttribute("HLFillTransparency", NumberSequence.new(part.FillTransparency))
		config:SetAttribute("HLOutlineColor", ColorSequence.new(part.OutlineColor))
		config:SetAttribute("HLOutlineTransparency", NumberSequence.new(part.OutlineTransparency))
		config:SetAttribute("HLDepthMode", part.DepthMode.Name)
		-- Adornee picker child: emit-time _resolveAdornee falls through to source.Adornee then
		-- source.Parent when this ObjectValue is unset. Picker UI binds to the ObjectValue's
		-- Value field  -  required for the user-facing Adornee picker.
		if not part:FindFirstChild("Adornee") then
			local ad = Instance.new("ObjectValue"); ad.Name = "Adornee"; ad.Value = nil; ad.Parent = part
		end
	end

	-- RT must never render live (both source + RT live in Lighting / GUI tree).
	if renderTemplate:IsA("PostProcessEffect") then renderTemplate.Enabled = false end

	if part:IsA("ImageLabel") then
		if renderTemplate:IsA("ImageLabel") then renderTemplate.Visible = false end
		-- Only force BG=1 from the default; preserve user-authored translucent backdrops.
		if part.BackgroundTransparency == 0 then
			part.BackgroundTransparency = 1
		end
		config:SetAttribute("Image", part.Image)
		config:SetAttribute("Position", part.Position)
		config:SetAttribute("ImgSize", part.Size)
		config:SetAttribute("AnchorPoint", part.AnchorPoint)
		config:SetAttribute("ZIndex", part.ZIndex)
		config:SetAttribute("ScaleType", part.ScaleType.Name)
		config:SetAttribute("ResampleMode", part.ResampleMode.Name)
		if not part:FindFirstChild("ImageFlipbooks") then
			local ff = Instance.new("Folder"); ff.Name = "ImageFlipbooks"; ff.Parent = part
		end
	end

	if part:IsA("BasePart") and not part:IsA("Terrain") then
		if not part:FindFirstChild("MeshFlipbooks") then
			local mf = Instance.new("Folder"); mf.Name = "MeshFlipbooks"; mf.Parent = part
		end
	end

	-- Trail promote-to-emitter: disable source + RT Trail (RT gets re-Enabled on each emit clone).
	-- TrailEmitter properties auto-fill from TypeData.TrailEmitterProperties defaults via Migrate;
	-- explicit per-prop capture isn't required since native Trail values already live on the RT clone.
	if part:IsA("Trail") then
		part.Enabled = false
		if renderTemplate:IsA("Trail") then renderTemplate.Enabled = false end
		-- Default GraphBlender: state 1 seeds from source Trail's current Width / Transparency / Color
		-- so the emit immediately matches the visual the user authored before promoting.
		if not part:FindFirstChild("GraphBlender") then
			local gb = Instance.new("Folder"); gb.Name = "GraphBlender"
			local s1 = Instance.new("Configuration"); s1.Name = "1"
			s1:SetAttribute("Time", 0)
			s1:SetAttribute("Width", part.WidthScale or NumberSequence.new(1))
			s1:SetAttribute("Transparency", part.Transparency or NumberSequence.new(0))
			s1:SetAttribute("Color", part.Color or ColorSequence.new(Color3.new(1,1,1)))
			s1:SetAttribute("_AutoTime", true)
			s1.Parent = gb; gb.Parent = part
		end
		if not part:FindFirstChild("TrailFlipbooks") then
			local tf = Instance.new("Folder"); tf.Name = "TrailFlipbooks"; tf.Parent = part
		end
	end

	if part:IsA("Beam") then
		part.Enabled = false
		part.LightInfluence = 0 -- Unlit default
		if renderTemplate:IsA("Beam") then renderTemplate.Enabled = false; renderTemplate.LightInfluence = 0 end

		if not part:FindFirstChild("BeamFlipbooks") then
			local bf = Instance.new("Folder"); bf.Name = "BeamFlipbooks"; bf.Parent = part
		end

		config:SetAttribute("BeamBrightness", NumberSequence.new(part.Brightness))
		config:SetAttribute("CurveSize0", NumberSequence.new(part.CurveSize0))
		config:SetAttribute("CurveSize1", NumberSequence.new(part.CurveSize1))
		config:SetAttribute("Width0", NumberSequence.new(part.Width0))
		config:SetAttribute("Width1", NumberSequence.new(part.Width1))
		config:SetAttribute("LightEmission", NumberSequence.new(part.LightEmission))
		config:SetAttribute("BeamLightInfluence", NumberSequence.new(0))
		config:SetAttribute("Segments", NumberSequence.new(part.Segments))
		config:SetAttribute("TextureLength", NumberSequence.new(part.TextureLength))
		config:SetAttribute("TextureSpeed", NumberSequence.new(part.TextureSpeed))
		config:SetAttribute("FaceCamera", part.FaceCamera)
		config:SetAttribute("ZOffset", part.ZOffset)
		config:SetAttribute("BeamTextureMode", part.TextureMode.Name)

		-- _AutoTime marks states whose Time was set by Add State (vs user-edited via TimeBox).
		local gb = Instance.new("Folder"); gb.Name = "GraphBlender"
		local s1 = Instance.new("Configuration"); s1.Name = "1"
		s1:SetAttribute("Time", 0); s1:SetAttribute("Transparency", part.Transparency); s1:SetAttribute("Color", part.Color)
		s1:SetAttribute("_AutoTime", true)
		s1.Parent = gb; gb.Parent = part
	end

	if not part:FindFirstChild("EmitParent") then
		local ep = Instance.new("ObjectValue")
		ep.Name = "EmitParent"
		ep.Value = nil
		ep.Parent = part
	end

	if (part:IsA("BasePart") or part:IsA("Attachment")) and not part:FindFirstChild("Link") then
		local lk = Instance.new("ObjectValue")
		lk.Name = "Link"
		lk.Parent = part
	end

	if part:IsA("BasePart") and not part:FindFirstChild("AccelTarget") then
		local at = Instance.new("ObjectValue")
		at.Name = "AccelTarget"
		at.Value = nil
		at.Parent = part
	end

	-- ShapePart override: when UseShape=true, particles spawn within this BasePart's volume
	-- (using its Size + CFrame). Default Value = source itself so the picker UI shows the
	-- source explicitly; runtime `data.ShapePart or part` fallback handles unset values.
	if part:IsA("BasePart") and not part:FindFirstChild("ShapePart") then
		local sp = Instance.new("ObjectValue")
		sp.Name = "ShapePart"
		sp.Value = part
		sp.Parent = part
	end

	part:SetAttribute("Transformed", true)
	part:SetAttribute("Qwinkle", true)
	-- Beam EmitCount=1 default (one beam = one instance); others default 0 (zero-as-zero contract).
	part:SetAttribute("EmitCount", part:IsA("Beam") and 1 or 0)
	part:SetAttribute("EmitDuration", 0)
	part:SetAttribute("EmitDelay", 0)
	part:SetAttribute("IsEmitter", true)
	if part:IsA("BasePart") or part:IsA("Beam") or part:IsA("Trail") or part:IsA("ImageLabel") then
		part:SetAttribute("PreloadTexture", false)
	end
	-- Atmosphere is singleton-per-Lighting; default to Animate to avoid flickering Emit stacks.
	part:SetAttribute("EmissionMode", part:IsA("Atmosphere") and "Animate" or "Emit")
	part:SetAttribute("AnimateLoop", false)
	-- Link-driven types only. Highlight (Adornee-driven) + Trail (Attachment0/1-driven) skip these.
	if part:IsA("BasePart") or part:IsA("Beam") or part:IsA("Attachment") or part:IsA("Model") then
		part:SetAttribute("LinkMode", "Follow")
		part:SetAttribute("LinkSource", "None")
	end
	pcall(function() Particle.TransformCompleted:Fire(part) end)
end

-- Walk a Part/Beam/Model emit's motion forward step-by-step and return the per-step local CFrames.
-- Called by Motion Preview to draw trajectory lines in the viewport; also reused inside Emit so
-- the live simulation matches the preview without re-deriving the math. The CFrames are local to
-- `parentCF` (Link target or world origin) so a moving Link naturally carries the path with it.
function Particle:PreSimulateForward(data, seeds, initialCF, baseDirection, spreadRotation, link, lifetime, previewMaxSteps, spawnEmitterRotation)
	local linkMode = data.LinkMode or "Follow"
	local parentCF
	if link then
		local worldCF = Constants.resolveLinkCFrame(link)
		if linkMode == "Follow" or linkMode == "Pivot" then
			parentCF = CFrame.new(worldCF.Position)
		else parentCF = worldCF end
	else parentCF = CFrame.new() end
	local useVOS = (linkMode == "Weld" or linkMode == "WeldWithoutRotation") and link ~= nil
	-- previewMaxSteps caps preview callers; InvertMotion caps emit (per-particle CFrame allocation).
	local INVERT_MAX_STEPS = 500
	local totalKeyFrames = math.max(1, data.TotalKeyFrames)
	if previewMaxSteps and totalKeyFrames > previewMaxSteps then
		totalKeyFrames = previewMaxSteps
	elseif data.InvertMotion and totalKeyFrames > INVERT_MAX_STEPS then
		totalKeyFrames = INVERT_MAX_STEPS
	end
	local stepDT = lifetime / totalKeyFrames

	local currentPosition = initialCF.Position
	local localCF = parentCF:ToObjectSpace(initialCF)
	local baseDir = baseDirection
	local emissionDirection = data.EmissionDirection
	local rotMode = data.RotMode or "OverLife"
	local accRotX, accRotY, accRotZ = 0, 0, 0

	-- Snapshot AccelTarget pos at start; InvertMotion's cached CFrames can't track moving targets.
	local hasTargetAccel = data.AccelerationTowardsInstance == true and data.AccelTarget ~= nil and data.AccelStrength ~= nil and not data.InvertMotion
	local targetWorldPos
	if hasTargetAccel then
		local t = data.AccelTarget
		-- Type dispatch matches Update.getTargetPosition (Bone live pose, Model pivot, etc.).
		if t:IsA("Bone") then targetWorldPos = t.TransformedWorldCFrame.Position
		elseif t:IsA("BasePart") then targetWorldPos = t.Position
		elseif t:IsA("Attachment") then targetWorldPos = t.WorldPosition
		elseif t:IsA("Model") then local ok, cf = pcall(t.GetPivot, t); if ok and cf then targetWorldPos = cf.Position end
		end
		if not targetWorldPos then hasTargetAccel = false end
	end
	local targetVel = Vector3.zero
	local accelStrengthSeed = seeds.AccelStrength or {}

	-- PosOffset trajectory state for the precomputation loop. DisplacementMode +
	-- spawnEmitterRotation flow through Constants.resolveDisplacement below so the
	-- cached SimLocalCFrames honour the same frame the live Update.luau path uses.
	-- When spawnEmitterRotation is nil (preview path) it falls back to spawnRotation,
	-- degrading RigidLocal to Local for preview (preview is single-particle, no rotXYZ).
	local hasPosOffset = data.PosOffsetX ~= nil or data.PosOffsetY ~= nil or data.PosOffsetZ ~= nil
	local spawnRotation = initialCF.Rotation
	local prevWorldOff = Vector3.zero

	local localCFrames = {}
	localCFrames[0] = parentCF:ToObjectSpace(initialCF)

	for step = 1, totalKeyFrames do
		local steppedI = step / totalKeyFrames
		local elapsedSec = steppedI * lifetime

		local speed = GraphMod.QueryPointsWithTime(steppedI, data.Speed, seeds.Speed)
		local draggedSpeed = speed * math.exp(-data.ParticleData.Drag * elapsedSec)

		local accelVelocity = data.ParticleData.Acceleration * elapsedSec

		local displacement = (baseDir * draggedSpeed + accelVelocity) * stepDT

		if hasTargetAccel then
			local toTarget = targetWorldPos - currentPosition
			local dist = toTarget.Magnitude
			if dist > 1e-4 then
				local mag = GraphMod.QueryPointsWithTime(steppedI, data.AccelStrength, accelStrengthSeed)
				if mag and mag ~= 0 then
					targetVel = targetVel + toTarget * (mag * stepDT / dist)
					displacement = displacement + targetVel * stepDT
				end
			end
		end

		if hasPosOffset then
			local oX = data.PosOffsetX and GraphMod.QueryPointsWithTime(steppedI, data.PosOffsetX, seeds.PosOffsetX) or 0
			local oY = data.PosOffsetY and GraphMod.QueryPointsWithTime(steppedI, data.PosOffsetY, seeds.PosOffsetY) or 0
			local oZ = data.PosOffsetZ and GraphMod.QueryPointsWithTime(steppedI, data.PosOffsetZ, seeds.PosOffsetZ) or 0
			local worldOff = Constants.resolveDisplacement(Vector3.new(oX, oY, oZ),
				data.DisplacementMode or "Global", spawnRotation,
				spawnEmitterRotation or spawnRotation)
			displacement = displacement + (worldOff - prevWorldOff)
			prevWorldOff = worldOff
		end

		-- VOS only for Weld; Follow/Pivot keep world-relative velocity.
		local parentLocalDelta = useVOS and parentCF:VectorToObjectSpace(displacement) or displacement
		localCF = CFrame.new(parentLocalDelta) * localCF

		local rotSpeedX = GraphMod.QueryPointsWithTime(steppedI, data.RotSpeedX, seeds.RotSpeedX)
		local rotSpeedY = GraphMod.QueryPointsWithTime(steppedI, data.RotSpeedY, seeds.RotSpeedY)
		local rotSpeedZ = GraphMod.QueryPointsWithTime(steppedI, data.RotSpeedZ, seeds.RotSpeedZ)

		local rotCF
		local rotOrder = data.RotOrder or "Global"
		if rotMode == "Speed" then
			accRotX = accRotX + rotSpeedX * stepDT
			accRotY = accRotY + rotSpeedY * stepDT
			accRotZ = accRotZ + rotSpeedZ * stepDT
			rotCF = Constants.composeRotation(rotOrder, accRotX, accRotY, accRotZ)
		else
			rotCF = Constants.composeRotation(rotOrder, rotSpeedX, rotSpeedY, rotSpeedZ)
		end

		local worldCF = (parentCF * localCF) * rotCF
		currentPosition = worldCF.Position

		if data.VelocityVectored then
			local dirInfo = DirectionVectors[emissionDirection] or DirectionVectors[Enum.NormalId.Top]
			baseDir = (worldCF * spreadRotation)[dirInfo.vector] * dirInfo.multiplier
		end

		localCFrames[step] = parentCF:ToObjectSpace(worldCF)
	end

	return localCFrames, totalKeyFrames
end

-- Attachment variant: no Link param, attachment-local space (initialCF doubles as localCF).
function Particle:PreSimulateAttachmentForward(data, seeds, initialCF, baseDirection, spreadRotation, lifetime, previewMaxSteps, spawnEmitterRotation)
	local INVERT_MAX_STEPS = 500
	local totalKeyFrames = math.max(1, data.TotalKeyFrames)
	if previewMaxSteps and totalKeyFrames > previewMaxSteps then
		totalKeyFrames = previewMaxSteps
	elseif data.InvertMotion and totalKeyFrames > INVERT_MAX_STEPS then
		totalKeyFrames = INVERT_MAX_STEPS
	end
	local stepDT = lifetime / totalKeyFrames

	local localCF = initialCF
	local baseDir = baseDirection
	local emissionDirection = data.EmissionDirection
	local rotMode = data.RotMode or "OverLife"
	local accRotX, accRotY, accRotZ = 0, 0, 0
	-- AccelerationTowardsInstance not integrated here (local-space mismatch with world target).
	-- Preview Attachment trajectories diverge from live emit when target accel is enabled.

	-- PosOffset trajectory state. Routes through Constants.resolveDisplacement with
	-- DisplacementMode + spawnEmitterRotation so cached frames match live Update path.
	local hasPosOffset = data.PosOffsetX ~= nil or data.PosOffsetY ~= nil or data.PosOffsetZ ~= nil
	local spawnRotation = initialCF.Rotation
	local prevWorldOff = Vector3.zero

	local localCFrames = {}
	localCFrames[0] = initialCF

	for step = 1, totalKeyFrames do
		local steppedI = step / totalKeyFrames
		local elapsedSec = steppedI * lifetime

		local speed = GraphMod.QueryPointsWithTime(steppedI, data.Speed, seeds.Speed)
		local draggedSpeed = speed * math.exp(-data.ParticleData.Drag * elapsedSec)

		local accelVelocity = data.ParticleData.Acceleration * elapsedSec
		local displacement = (baseDir * draggedSpeed + accelVelocity) * stepDT

		if hasPosOffset then
			local oX = data.PosOffsetX and GraphMod.QueryPointsWithTime(steppedI, data.PosOffsetX, seeds.PosOffsetX) or 0
			local oY = data.PosOffsetY and GraphMod.QueryPointsWithTime(steppedI, data.PosOffsetY, seeds.PosOffsetY) or 0
			local oZ = data.PosOffsetZ and GraphMod.QueryPointsWithTime(steppedI, data.PosOffsetZ, seeds.PosOffsetZ) or 0
			local worldOff = Constants.resolveDisplacement(Vector3.new(oX, oY, oZ),
				data.DisplacementMode or "Global", spawnRotation,
				spawnEmitterRotation or spawnRotation)
			displacement = displacement + (worldOff - prevWorldOff)
			prevWorldOff = worldOff
		end

		localCF = CFrame.new(displacement) * localCF

		-- Rotation
		local rotSpeedX = GraphMod.QueryPointsWithTime(steppedI, data.RotSpeedX, seeds.RotSpeedX)
		local rotSpeedY = GraphMod.QueryPointsWithTime(steppedI, data.RotSpeedY, seeds.RotSpeedY)
		local rotSpeedZ = GraphMod.QueryPointsWithTime(steppedI, data.RotSpeedZ, seeds.RotSpeedZ)

		local rotCF
		local rotOrder = data.RotOrder or "Global"
		if rotMode == "Speed" then
			accRotX = accRotX + rotSpeedX * stepDT
			accRotY = accRotY + rotSpeedY * stepDT
			accRotZ = accRotZ + rotSpeedZ * stepDT
			rotCF = Constants.composeRotation(rotOrder, accRotX, accRotY, accRotZ)
		else
			rotCF = Constants.composeRotation(rotOrder, rotSpeedX, rotSpeedY, rotSpeedZ)
		end

		local worldCF = localCF * rotCF

		if data.VelocityVectored then
			local dirVecInfo = DirectionVectors[emissionDirection] or DirectionVectors[Enum.NormalId.Top]
			baseDir = (worldCF * spreadRotation)[dirVecInfo.vector] * dirVecInfo.multiplier
		end

		localCFrames[step] = worldCF
	end

	return localCFrames, totalKeyFrames
end

-- Model Transform: RT is whole Model subtree; original descendants hidden, not destroyed
-- (preserves Motor6Ds / AnimationControllers for playtest).
function Particle:TransformModel(model, typeDef)
	if model:GetAttribute("Transformed") then return end
	local config = TypeRegistry.createConfig(model, typeDef)

	-- Create RenderTemplate (clean clone of the Model)
	local renderTemplate = model:Clone()
	renderTemplate.Name = "RenderTemplate"

	for _, child in renderTemplate:GetChildren() do
		if child.Name == TypeRegistry.CONFIG_NAME or child.Name == "EmitParent" or child.Name == "Link" or child.Name == "AccelTarget" then
			child:Destroy()
		end
	end

	for _, attrName in ipairs({"Transformed", "Qwinkle", "IsEmitter", "EmitCount", "EmitDuration", "EmitDelay", "EmissionMode", "AnimateLoop"}) do
		renderTemplate:SetAttribute(attrName, nil)
	end

	-- Anchor + safe-clone every BasePart; silence native PEs/Trails (they ignore parent hidden state).
	for _, desc in renderTemplate:GetDescendants() do
		if desc:IsA("BasePart") then
			desc.Anchored = true; desc.CanCollide = false; desc.CanQuery = false
			desc.CanTouch = false; desc.CastShadow = false; desc.Massless = true; desc.Locked = true
		elseif (desc:IsA("ParticleEmitter") or desc:IsA("Trail"))
			and not desc:GetAttribute("Transformed")
		then
			desc.Enabled = false
		end
	end

	renderTemplate.Parent = model

	-- Hide originals; visuals moved to RT.
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsDescendantOf(renderTemplate) then continue end
		if desc:IsA("BasePart") then desc.Transparency = 1
		elseif desc:IsA("SpecialMesh") or desc:IsA("Decal") or desc:IsA("Texture") then desc:Destroy() end
	end

	if not model:FindFirstChild("EmitParent") then
		local ep = Instance.new("ObjectValue")
		ep.Name = "EmitParent"
		ep.Value = nil
		ep.Parent = model
	end

	if not model:FindFirstChild("Link") then
		local lk = Instance.new("ObjectValue")
		lk.Name = "Link"
		lk.Parent = model
	end

	model:SetAttribute("Transformed", true)
	model:SetAttribute("Qwinkle", true)
	model:SetAttribute("EmitCount", 0)
	model:SetAttribute("EmitDuration", 0)
	model:SetAttribute("EmitDelay", 0)
	model:SetAttribute("IsEmitter", true)
	model:SetAttribute("PreloadTexture", false)
	model:SetAttribute("EmissionMode", "Emit")
	model:SetAttribute("AnimateLoop", false)
	model:SetAttribute("LinkMode", "Follow")
	model:SetAttribute("LinkSource", "None")
	pcall(function() Particle.TransformCompleted:Fire(model) end)
end

end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">TypeRegistry</string>
              <string name="Source"><![CDATA[--[[
	TypeRegistry  -  schema source of truth for every Part-Icle type.
	TypeData.luau + TypeDataScreen.luau hold per-type tables; this file is generic read/write.
	Enums serialize by Name (string) and deserialize via Enum[enumType][name].
]]

local TypeData = require(script.TypeData)

export type TypeDef = {
	classCheck: (Instance) -> boolean,
	pDataType: string,
	uiSection: string,
	properties: {[string]: {[string]: any}},
	resize: {[string]: any}?,
	retime: {[string]: any}?,
	clipboard: {any}?,
	directAccess: boolean?,
}

local TypeRegistry = {}

TypeRegistry.CONFIG_NAME = "PartIcleProperties"
TypeRegistry.Types = TypeData.Types

-- Returns (typeDef, typeName) or (nil, nil).
function TypeRegistry.getTypeFor(item): (TypeDef?, string?)
	for typeName, typeDef in pairs(TypeRegistry.Types) do
		if typeDef.classCheck(item) then
			return typeDef, typeName
		end
	end
	return nil, nil
end

function TypeRegistry.getTypeName(item): string?
	local _, name = TypeRegistry.getTypeFor(item)
	return name
end

function TypeRegistry.getConfig(item)
	return item:FindFirstChild(TypeRegistry.CONFIG_NAME)
end

-- Resolve attrName overrides (BeamBrightness, PLRange, etc.); falls back to propName.
function TypeRegistry.getAttrName(typeDef, propName): string
	local propDef = typeDef.properties[propName]
	if propDef and propDef.attrName then
		return propDef.attrName
	end
	return propName
end

-- Read property value; enum returns EnumItem (not string).
function TypeRegistry.read(item, propName): any
	local typeDef = TypeRegistry.getTypeFor(item)
	if not typeDef then return nil end
	local propDef = typeDef.properties[propName]
	if not propDef then return nil end

	if typeDef.directAccess then
		if propDef.attribute then
			local attrName = propDef.attrName or propName
			local raw = item:GetAttribute(attrName)
			-- Explicit nil-check so stored `false` round-trips correctly.
			if raw ~= nil then return raw end
			return propDef.default
		end
		local ok, val = pcall(function() return item[propName] end)
		if ok and val ~= nil then return val end
		return propDef.default
	end

	local config = TypeRegistry.getConfig(item)
	if not config then return nil end

	local attrName = TypeRegistry.getAttrName(typeDef, propName)
	local raw = config:GetAttribute(attrName)

	if raw == nil then return propDef.default end

	if propDef.type == "enum" and type(raw) == "string" then
		-- Enum[type][name] raises on invalid names; pcall-wrap.
		local ok, enumVal = pcall(function() return Enum[propDef.enumType][raw] end)
		if ok and enumVal then return enumVal end
		return propDef.default
	end

	return raw
end

-- Bump RT _PoolGen so Pool flushes stale-look entries on next acquire. Inlined to keep
-- TypeRegistry's no-upward-dependency invariant (would otherwise require Pool).
local function _bumpPoolGen(item)
	local rt = item:FindFirstChild("RenderTemplate")
	if not rt then return end
	local cur = rt:GetAttribute("_PoolGen") or 0
	pcall(function() rt:SetAttribute("_PoolGen", cur + 1) end)
end

-- Bump RenderTemplate's _PoolGen so pooled visuals invalidate. UI paths that
-- mutate RT directly (Material, Beam Texture, Attachment0/1) call this.
function TypeRegistry.bumpPoolGen(item)
	if not item then return end
	_bumpPoolGen(item)
end

-- Clamp NumberSequence so each keypoint Value >= 0 and Envelope <= Value.
local function _clampNonNegativeSeq(value)
	if typeof(value) ~= "NumberSequence" then return value end
	local kps = value.Keypoints
	local needsClamp = false
	for _, kp in ipairs(kps) do
		if kp.Value < 0 or kp.Envelope > kp.Value then needsClamp = true; break end
	end
	if not needsClamp then return value end
	local clamped = {}
	for _, kp in ipairs(kps) do
		local v = math.max(0, kp.Value)
		local e = math.max(0, math.min(kp.Envelope, v))
		table.insert(clamped, NumberSequenceKeypoint.new(kp.Time, v, e))
	end
	return NumberSequence.new(clamped)
end

-- NaN/invalid guard: refuse writes that would persist garbage (NaN keypoints, infinite
-- numbers, malformed NumberSequence). Runtime guards degrade gracefully but stale-invalid
-- attrs survive across sessions and silently misbehave; reject at the write boundary so
-- the prior good value stays intact.
local function _isInvalidNumber(n)
	return type(n) == "number" and (n ~= n or n == math.huge or n == -math.huge)
end
local function _isInvalidValue(value)
	if type(value) == "number" then return _isInvalidNumber(value) end
	if typeof(value) == "NumberRange" then return _isInvalidNumber(value.Min) or _isInvalidNumber(value.Max) end
	if typeof(value) == "NumberSequence" then
		for _, kp in ipairs(value.Keypoints) do
			if _isInvalidNumber(kp.Time) or _isInvalidNumber(kp.Value) or _isInvalidNumber(kp.Envelope) then
				return true
			end
			if kp.Time < 0 or kp.Time > 1 then return true end
		end
	end
	return false
end

-- Write property value; enum stored as Name string (config) or EnumItem (direct).
function TypeRegistry.write(item, propName, value)
	if _isInvalidValue(value) then
		warn("[Part-Icles] TypeRegistry.write rejected invalid value for " .. tostring(propName))
		return
	end
	local typeDef = TypeRegistry.getTypeFor(item)
	if not typeDef then return end
	local propDef = typeDef.properties[propName]
	if not propDef then return end

	if typeDef.directAccess then
		if propDef.nonNegative then
			value = _clampNonNegativeSeq(value)
		end
		if propDef.attribute then
			local attrName = propDef.attrName or propName
			item:SetAttribute(attrName, value)
		else
			pcall(function() item[propName] = value end)
		end
		_bumpPoolGen(item)
		return
	end

	local config = TypeRegistry.getConfig(item)
	if not config then return end

	local attrName = TypeRegistry.getAttrName(typeDef, propName)

	if propDef.type == "enum" then
		if typeof(value) == "EnumItem" then
			config:SetAttribute(attrName, value.Name)
		else
			config:SetAttribute(attrName, tostring(value))
		end
	else
		-- nonNegative: clamp NumberSequence Value AND Envelope so Value + rand[-E,+E] >= 0.
		if propDef.nonNegative and typeof(value) == "NumberSequence" then
			local kps = value.Keypoints
			local needsClamp = false
			for _, kp in ipairs(kps) do
				if kp.Value < 0 or kp.Envelope > kp.Value then needsClamp = true; break end
			end
			if needsClamp then
				local clamped = {}
				for _, kp in ipairs(kps) do
					local v = math.max(0, kp.Value)
					local e = math.max(0, math.min(kp.Envelope, v))
					table.insert(clamped, NumberSequenceKeypoint.new(kp.Time, v, e))
				end
				value = NumberSequence.new(clamped)
			end
		end
		config:SetAttribute(attrName, value)
	end
	_bumpPoolGen(item)
end

-- Read every property into a flat table (generic GetData).
function TypeRegistry.readAll(item): {[string]: any}?
	local typeDef = TypeRegistry.getTypeFor(item)
	if not typeDef then return nil end
	local config = TypeRegistry.getConfig(item)
	if not config then return nil end

	local data = {}
	for propName, propDef in pairs(typeDef.properties) do
		local attrName = TypeRegistry.getAttrName(typeDef, propName)
		local raw = config:GetAttribute(attrName)
		if raw == nil then
			data[propName] = propDef.default
		elseif propDef.type == "enum" and type(raw) == "string" then
			data[propName] = Enum[propDef.enumType][raw]
		else
			data[propName] = raw
		end
	end
	return data
end

-- Stamp every default property; called by Transform.
function TypeRegistry.writeDefaults(config, typeDef)
	for propName, propDef in pairs(typeDef.properties) do
		local attrName = propDef.attrName or propName
		local value = propDef.default
		if propDef.type == "enum" then
			config:SetAttribute(attrName, value.Name)
		else
			config:SetAttribute(attrName, value)
		end
	end
end

-- New Configuration with defaults stamped; parented to item.
function TypeRegistry.createConfig(item, typeDef)
	local config = Instance.new("Configuration")
	config.Name = TypeRegistry.CONFIG_NAME
	TypeRegistry.writeDefaults(config, typeDef)
	config.Parent = item
	return config
end

function TypeRegistry.isGraph(propDef): boolean
	return propDef.type == "NumberSequence" or propDef.type == "ColorSequence"
end

function TypeRegistry.isNonNegative(propDef): boolean
	return propDef.nonNegative == true
end

function TypeRegistry.getPropDef(typeName, propName)
	local typeDef = TypeRegistry.Types[typeName]
	if not typeDef then return nil end
	return typeDef.properties[propName]
end

-- Type-aware default lookup; required because pairs() over Types isn't order-stable.
function TypeRegistry.getDefault(typeName, propName)
	local typeDef = TypeRegistry.Types[typeName]
	if not typeDef then return nil end
	local propDef = typeDef.properties[propName]
	if not propDef then return nil end
	return propDef.default
end

return TypeRegistry
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="65">
              <Properties>
                <string name="Name">TypeData</string>
                <string name="Source"><![CDATA[--[[
	TypeData  -  property descriptors for 3D / workspace types (Part / Beam / PointLight /
	Attachment / Model / Trail). Screen types live in TypeDataScreen.luau (500-line split).

	Property entry: { type, default, attrName?, enumType?, nonNegative?, attribute? }
	  attrName    config attribute name override (avoids collision with native props)
	  enumType    Roblox Enum category name (required for type="enum")
	  nonNegative NumberSequence keypoints clamped to >= 0 on write
	  attribute   directAccess only  -  store as instance attribute, not property
]]

local TypeData = {}

TypeData.PartProperties = {
	-- Graph properties (NumberSequence)
	Brightness    = { type = "NumberSequence", default = NumberSequence.new(1) },
	Color         = { type = "ColorSequence", default = ColorSequence.new(Color3.new(1,1,1)) },
	SizeX         = { type = "NumberSequence", default = NumberSequence.new(1), nonNegative = true },
	SizeY         = { type = "NumberSequence", default = NumberSequence.new(1), nonNegative = true },
	SizeZ         = { type = "NumberSequence", default = NumberSequence.new(1), nonNegative = true },
	Transparency  = { type = "NumberSequence", default = NumberSequence.new(0) },
	Speed         = { type = "NumberSequence", default = NumberSequence.new(0) },
	-- Per-axis position offset graphs over normalized life (studs, spawn-local frame).
	-- Trajectory shape, distinct from emit-time PosX/Y/Z NumberRange spreads below.
	-- Composed ADDITIVELY with Speed × Direction via per-frame delta accumulation.
	PosOffsetX    = { type = "NumberSequence", default = NumberSequence.new(0) },
	PosOffsetY    = { type = "NumberSequence", default = NumberSequence.new(0) },
	PosOffsetZ    = { type = "NumberSequence", default = NumberSequence.new(0) },
	RotSpeedX     = { type = "NumberSequence", default = NumberSequence.new(0) },
	RotSpeedY     = { type = "NumberSequence", default = NumberSequence.new(0) },
	RotSpeedZ     = { type = "NumberSequence", default = NumberSequence.new(0) },
	-- Timescale graph: scales per-frame elapsed-time advancement. Default constant 1
	-- means real-time playback. <1 slows, 0 freezes, >1 speeds up, NEGATIVE rewinds (v2).
	-- Sampled at REAL normalized time `(now - StartTime) / LifeTime` so the graph
	-- progresses monotonically through its keypoints regardless of which direction
	-- the particle's effective time is moving. Initial `_effectiveElapsed` depends on
	-- the graph's value at i=0: ts(0) >= 0 → particle starts at 0 and plays forward;
	-- ts(0) < 0 → particle starts at LifeTime (end-state visual) and rewinds to 0.
	-- This is what makes a STATIC `Timescale = -1` produce end-to-start playback.
	-- Runtime: `dt *= ts(real_i)`, `_effectiveElapsed += dt` clamped to [0, LifeTime].
	-- Death rule: ONLY after the graph has finished playing (real_i >= 1) does a
	-- boundary cross (effective hit 0 or LifeTime) trigger death. During graph
	-- playback the particle bounces freely between bounds  -  users can author graphs
	-- that overshoot either bound without prematurely killing the particle. Sticky-
	-- zero post-graph (last-keypoint ts == 0 + effective stuck mid-life) is
	-- documented user error: no real-time cap, particle leaks the slot.
	Timescale     = { type = "NumberSequence", default = NumberSequence.new(1) },

	-- Non-graph properties
	Lifetime          = { type = "NumberRange",  default = NumberRange.new(1) },
	Rate              = { type = "number",       default = 10 },
	Drag              = { type = "number",       default = 0 },
	Acceleration      = { type = "Vector3",      default = Vector3.new(0, 0, 0) },
	SpreadAngle       = { type = "Vector2",      default = Vector2.new(0, 0) },
	RotX              = { type = "NumberRange",   default = NumberRange.new(0) },
	RotY              = { type = "NumberRange",   default = NumberRange.new(0) },
	RotZ              = { type = "NumberRange",   default = NumberRange.new(0) },
	PosX              = { type = "NumberRange",   default = NumberRange.new(0) },
	PosY              = { type = "NumberRange",   default = NumberRange.new(0) },
	PosZ              = { type = "NumberRange",   default = NumberRange.new(0) },
	PosMode           = { type = "string",       default = "Local" },
	RotMode           = { type = "string",       default = "OverLife" },
	RotOrder          = { type = "string",       default = "Global" },
	TotalKeyFrames    = { type = "number",       default = 100 },
	PartLife          = { type = "number",       default = 0, nonNegative = true },
	ShapePartial      = { type = "number",       default = 0 },
	VelocityVectored  = { type = "boolean",      default = false },
	DirMode           = { type = "string",       default = "RigidLocal" },
	-- Frame for PosOffsetX/Y/Z over-life graphs. Mirrors DirMode's role for
	-- Speed but applied to displacement-through-life instead of velocity.
	-- Global = world axes; Local = particle's spawn frame (post-RotXYZ);
	-- RigidLocal = emitter's frame at spawn (pre-RotXYZ).
	DisplacementMode  = { type = "string",       default = "Global" },
	InvertMotion      = { type = "boolean",      default = false },
	Enabled           = { type = "boolean",      default = false },

	-- Target acceleration. AccelerationTowardsInstance gates the AccelStrength + AccelTarget pair.
	-- AccelStrength is a non-negative scalar magnitude over normalized particle lifetime.
	-- AccelTarget is the picked instance (stored as ObjectValue child, not attribute -- see Transform).
	AccelerationTowardsInstance = { type = "boolean",        default = false },
	AccelStrength               = { type = "NumberSequence", default = NumberSequence.new(0), nonNegative = true },

	-- Axis links: per-axis "LinkedTo" attribute names the primary axis whose graph + seed (or
	-- per-emit sampled range value) the follower axis should adopt. Stored as full property
	-- keys (e.g. SizeYLinkedTo = "SizeX"). Registered here so QOL snapshot/Migrate see them.
	-- Default "" means unlinked; GetData sanitizes empty/invalid values to nil. Clipboard
	-- companion-copy (auto-include LinkedTo when its primary axis is copied) is a separate
	-- piece of work  -  registration alone does not make per-prop clipboard preserve them.
	SizeXLinkedTo        = { type = "string", default = "" },
	SizeYLinkedTo        = { type = "string", default = "" },
	SizeZLinkedTo        = { type = "string", default = "" },
	RotSpeedXLinkedTo    = { type = "string", default = "" },
	RotSpeedYLinkedTo    = { type = "string", default = "" },
	RotSpeedZLinkedTo    = { type = "string", default = "" },
	PosOffsetXLinkedTo   = { type = "string", default = "" },
	PosOffsetYLinkedTo   = { type = "string", default = "" },
	PosOffsetZLinkedTo   = { type = "string", default = "" },
	RotXLinkedTo         = { type = "string", default = "" },
	RotYLinkedTo         = { type = "string", default = "" },
	RotZLinkedTo         = { type = "string", default = "" },
	PosXLinkedTo         = { type = "string", default = "" },
	PosYLinkedTo         = { type = "string", default = "" },
	PosZLinkedTo         = { type = "string", default = "" },
	-- EvenDistribution: per-axis toggle. When true + EmitIndex/EmitCount in emitCtx,
	-- the axis samples a deterministic spread across [Min, Max] instead of random.
	-- Burst emits use the natural EmitCount; Rate emits use a rolling counter mod 12.
	-- Linked followers inherit the primary's spread scalar via AxisLinks.sampleRangeAxes.
	RotXEven             = { type = "boolean", default = false },
	RotYEven             = { type = "boolean", default = false },
	RotZEven             = { type = "boolean", default = false },
	PosXEven             = { type = "boolean", default = false },
	PosYEven             = { type = "boolean", default = false },
	PosZEven             = { type = "boolean", default = false },

	-- Master gate: when true, the shape function runs at emit time and contributes
	-- offset / rotation / direction. When false, particles emit at the item's origin
	-- with no shape distribution.
	UseShape           = { type = "boolean", default = false },
	-- When true, the shape function's natural lookAt rotation (CFrame.lookAt(0, -dirVec))
	-- is applied to each spawned particle so they face the radial outward of the shape.
	-- When false, particles inherit only the emitter's rotation. ShapePartial (Hollow)
	-- separately controls volume vs shell distribution; this is purely an orientation knob.
	LookAtInitially    = { type = "boolean", default = false },
	-- Enum properties (stored as string Name)
	Shape              = { type = "enum", enumType = "ParticleEmitterShape",        default = Enum.ParticleEmitterShape.Box },
	ShapeInOut         = { type = "enum", enumType = "ParticleEmitterShapeInOut",    default = Enum.ParticleEmitterShapeInOut.Outward },
	EmissionDirection  = { type = "enum", enumType = "NormalId",                     default = Enum.NormalId.Top },
	Orientation        = { type = "string", default = "None" },
	ZOffset            = { type = "number", default = 0 },

	-- Flipbook
	FlipbookMode         = { type = "enum", enumType = "ParticleFlipbookMode", default = Enum.ParticleFlipbookMode.OneShot },
	FlipbookFramerate    = { type = "NumberRange", default = NumberRange.new(30) },
	FlipbookStartRandom  = { type = "boolean",     default = false },
	FlipbookReverse      = { type = "boolean",     default = false },

	Pool                 = { type = "boolean",     default = false },
}

TypeData.BeamProperties = {
	-- Graph properties (NumberSequence)
	Brightness    = { type = "NumberSequence", default = NumberSequence.new(1),    attrName = "BeamBrightness", nonNegative = true },
	Width0        = { type = "NumberSequence", default = NumberSequence.new(1),    nonNegative = true },
	Width1        = { type = "NumberSequence", default = NumberSequence.new(1),    nonNegative = true },
	CurveSize0    = { type = "NumberSequence", default = NumberSequence.new(0) },
	CurveSize1    = { type = "NumberSequence", default = NumberSequence.new(0) },
	LightEmission  = { type = "NumberSequence", default = NumberSequence.new(0) },
	-- Plugin expects unlit beams. Roblox's native Beam default is 1 (lit) but the
	-- Transform / RenderTemplate path forces 0; mirror that here so EmitBeam's
	-- config readback agrees.
	LightInfluence = { type = "NumberSequence", default = NumberSequence.new(0), attrName = "BeamLightInfluence" },
	Segments      = { type = "NumberSequence", default = NumberSequence.new(10) },
	TextureLength = { type = "NumberSequence", default = NumberSequence.new(1) },
	TextureSpeed  = { type = "NumberSequence", default = NumberSequence.new(1) },
	-- Timescale: see PartProperties for full semantics. Beam is continuous-time so
	-- the effective elapsed accumulator drives both GraphBlender state lerp and the
	-- per-frame property samples uniformly.
	Timescale     = { type = "NumberSequence", default = NumberSequence.new(1), attrName = "BeamTimescale" },

	-- Non-graph properties
	Lifetime          = { type = "NumberRange",  default = NumberRange.new(1),  attrName = "BeamLifetime" },
	Rate              = { type = "number",       default = 10 },
	TotalKeyFrames    = { type = "number",       default = 100 },
	Enabled           = { type = "boolean",      default = false },
	FaceCamera        = { type = "boolean",      default = false },
	ZOffset           = { type = "number",       default = 0 },
	TextureMode       = { type = "enum",         enumType = "TextureMode", default = Enum.TextureMode.Stretch, attrName = "BeamTextureMode" },

	-- Flipbook
	FlipbookMode         = { type = "enum",        enumType = "ParticleFlipbookMode", default = Enum.ParticleFlipbookMode.OneShot, attrName = "BeamFlipbookMode" },
	FlipbookFramerate    = { type = "NumberRange",  default = NumberRange.new(30), attrName = "BeamFlipbookFramerate" },
	FlipbookStartRandom  = { type = "boolean",      default = false,               attrName = "BeamFlipbookStartRandom" },
	FlipbookReverse      = { type = "boolean",      default = false,               attrName = "BeamFlipbookReverse" },

	Pool                 = { type = "boolean",      default = false },
}

-- Screen-type property tables (Blur/Bloom/CC/Atmosphere/ImageLabel) live in the TypeDataScreen
-- sub-module. Merged into TypeData.Types at the bottom.
local ScreenData = require(script.Parent.TypeDataScreen)
TypeData.BlurProperties = ScreenData.BlurProperties
TypeData.BloomProperties = ScreenData.BloomProperties
TypeData.ColorCorrectionProperties = ScreenData.ColorCorrectionProperties
TypeData.AtmosphereProperties = ScreenData.AtmosphereProperties
TypeData.ImageLabelProperties = ScreenData.ImageLabelProperties

TypeData.PointLightProperties = {
	-- Graph properties
	Range      = { type = "NumberSequence", default = NumberSequence.new(8),  attrName = "PLRange",      nonNegative = true },
	Brightness = { type = "NumberSequence", default = NumberSequence.new(1),  attrName = "PLBrightness", nonNegative = true },
	Color      = { type = "ColorSequence", default = ColorSequence.new(Color3.new(1,1,1)), attrName = "PLColor" },
	-- Timescale: see PartProperties.
	Timescale  = { type = "NumberSequence", default = NumberSequence.new(1),  attrName = "PLTimescale" },

	-- Non-graph properties
	Lifetime       = { type = "NumberRange",  default = NumberRange.new(1) },
	Rate           = { type = "number",       default = 10 },
	TotalKeyFrames = { type = "number",       default = 100 },
	PartLife       = { type = "number",       default = 0, nonNegative = true },
	Enabled        = { type = "boolean",      default = false },
	Shadows        = { type = "boolean",      default = false },

	Pool           = { type = "boolean",      default = false },
}

-- Non-spatial emitter type (no Link / LinkSource / EmissionDirection / Orientation / ZOffset).
-- Cloned Highlight is parented to source; Adornee resolved per-emit via Adornee ObjectValue child
-- (falls back to source.Parent if unset). Graphs drive the 4 colour/transparency properties over Lifetime.
TypeData.HighlightProperties = {
	FillColor            = { type = "ColorSequence",  default = ColorSequence.new(Color3.new(1,1,1)), attrName = "HLFillColor" },
	FillTransparency     = { type = "NumberSequence", default = NumberSequence.new(0), attrName = "HLFillTransparency" },
	OutlineColor         = { type = "ColorSequence",  default = ColorSequence.new(Color3.new(1,1,1)), attrName = "HLOutlineColor" },
	OutlineTransparency  = { type = "NumberSequence", default = NumberSequence.new(0), attrName = "HLOutlineTransparency" },
	-- Timescale: see PartProperties.
	Timescale            = { type = "NumberSequence", default = NumberSequence.new(1), attrName = "HLTimescale" },

	Lifetime             = { type = "NumberRange",    default = NumberRange.new(1) },
	Rate                 = { type = "number",         default = 10 },
	TotalKeyFrames       = { type = "number",         default = 100 },
	PartLife             = { type = "number",         default = 0, nonNegative = true },
	DepthMode            = { type = "enum",           enumType = "HighlightDepthMode", default = Enum.HighlightDepthMode.AlwaysOnTop, attrName = "HLDepthMode" },
	Enabled              = { type = "boolean",        default = false },

	Pool                 = { type = "boolean",        default = false },
}

-- Trail emitter mode (post-"Transform as Emitter"): full particle pipeline. Differentiated from
-- directAccess Trail by presence of a PartIcleProperties Configuration child. Width / Transparency
-- / Color via TrailGraphBlender; other Trail props are NumberSequence graphs over Lifetime.
TypeData.TrailEmitterProperties = {
	-- Standard timing. Lifetime drives how long the emitter spawns particles for; TrailLife
	-- drives the cloned Trail's native .Lifetime (segment fade-out). Two values needed because
	-- a Trail particle is "alive" longer than its trail tail  -  emit a Trail that exists for
	-- Lifetime seconds, with each clone fading its own tail over TrailLife seconds.
	Lifetime       = { type = "NumberRange",    default = NumberRange.new(2) },
	TrailLife      = { type = "NumberRange",    default = NumberRange.new(2), attrName = "TEmitTrailLife" },
	Rate           = { type = "number",         default = 10 },
	TotalKeyFrames = { type = "number",         default = 100 },
	PartLife       = { type = "number",         default = 0, nonNegative = true },
	-- Timescale: see PartProperties.
	Timescale      = { type = "NumberSequence", default = NumberSequence.new(1), attrName = "TEmitTimescale" },

	-- Per-particle graphs (mutate the cloned Trail every frame).
	Brightness     = { type = "NumberSequence", default = NumberSequence.new(1),   attrName = "TEmitBrightness",     nonNegative = true },
	LightEmission  = { type = "NumberSequence", default = NumberSequence.new(0),   attrName = "TEmitLightEmission",  nonNegative = true },
	LightInfluence = { type = "NumberSequence", default = NumberSequence.new(1),   attrName = "TEmitLightInfluence", nonNegative = true },
	TextureLength  = { type = "NumberSequence", default = NumberSequence.new(1),   attrName = "TEmitTextureLength",  nonNegative = true },
	MinLength      = { type = "NumberSequence", default = NumberSequence.new(0.1), attrName = "TEmitMinLength",      nonNegative = true },
	MaxLength      = { type = "NumberSequence", default = NumberSequence.new(0),   attrName = "TEmitMaxLength",      nonNegative = true },

	-- Texture / TextureMode / FaceCamera live as native properties on the RenderTemplate child;
	-- UI writes go directly to RT instead of through a duplicate Configuration attribute.
	Enabled        = { type = "boolean", default = false },

	-- Flipbook (cycles `visual.Texture` through TrailFlipbooks/Decals over particle lifetime).
	TrailFlipbookMode        = { type = "enum",        enumType = "ParticleFlipbookMode", default = Enum.ParticleFlipbookMode.OneShot, attrName = "TEmitFlipbookMode" },
	TrailFlipbookFramerate   = { type = "NumberRange", default = NumberRange.new(30), attrName = "TEmitFlipbookFramerate" },
	TrailFlipbookStartRandom = { type = "boolean",     default = false, attrName = "TEmitFlipbookStartRandom" },
	TrailFlipbookReverse     = { type = "boolean",     default = false, attrName = "TEmitFlipbookReverse" },

	Pool           = { type = "boolean", default = false },
}

-- Native Beam (directAccess): edits the raw Beam instance, no PartIcleProperties / emit pipeline.
-- Differentiated from emitter Beam by absence of a PartIcleProperties Configuration child.
-- All properties map 1:1 to native Beam instance properties (read/write direct).
TypeData.BeamNativeProperties = {
	Transparency   = { type = "NumberSequence", default = NumberSequence.new(0) },
	Color          = { type = "ColorSequence",  default = ColorSequence.new(Color3.new(1,1,1)) },

	Brightness     = { type = "number", default = 1 },
	Width0         = { type = "number", default = 1, nonNegative = true },
	Width1         = { type = "number", default = 1, nonNegative = true },
	CurveSize0     = { type = "number", default = 0 },
	CurveSize1     = { type = "number", default = 0 },
	LightEmission  = { type = "number", default = 0 },
	LightInfluence = { type = "number", default = 0 },
	Segments       = { type = "number", default = 10, nonNegative = true },
	TextureLength  = { type = "number", default = 1 },
	TextureSpeed   = { type = "number", default = 1 },
	ZOffset        = { type = "number", default = 0 },

	Texture        = { type = "string",  default = "" },
	TextureMode    = { type = "enum",    enumType = "TextureMode", default = Enum.TextureMode.Stretch },
	FaceCamera     = { type = "boolean", default = false },
	Enabled        = { type = "boolean", default = true },
}

TypeData.TrailProperties = {
	-- Graph properties (native NumberSequence / ColorSequence on Trail instance)
	Transparency   = { type = "NumberSequence", default = NumberSequence.new(0.5) },
	WidthScale     = { type = "NumberSequence", default = NumberSequence.new(1), nonNegative = true },
	Color          = { type = "ColorSequence", default = ColorSequence.new(Color3.new(1,1,1)) },

	-- Number properties (native on Trail instance)
	Brightness     = { type = "number", default = 1 },
	LightEmission  = { type = "number", default = 0 },
	LightInfluence = { type = "number", default = 1 },
	TextureLength  = { type = "number", default = 1 },
	Lifetime       = { type = "number", default = 2 },
	MinLength      = { type = "number", default = 0.1 },
	MaxLength      = { type = "number", default = 0 },

	-- Emission timing (stored as attribute, supports "5,2" range string)
	Duration       = { type = "string", default = "2", attribute = true, attrName = "EmitDuration" },

	-- Boolean properties
	Enabled        = { type = "boolean", default = true },
	FaceCamera     = { type = "boolean", default = false },

	-- Enum
	TextureMode    = { type = "enum", enumType = "TextureMode", default = Enum.TextureMode.Stretch },
}

TypeData.AttachmentProperties = {
	-- Graph properties (NumberSequence)
	Speed         = { type = "NumberSequence", default = NumberSequence.new(0) },
	-- Over-life per-axis position offset graphs (see PartProperties for semantics).
	PosOffsetX    = { type = "NumberSequence", default = NumberSequence.new(0) },
	PosOffsetY    = { type = "NumberSequence", default = NumberSequence.new(0) },
	PosOffsetZ    = { type = "NumberSequence", default = NumberSequence.new(0) },
	RotSpeedX     = { type = "NumberSequence", default = NumberSequence.new(0) },
	RotSpeedY     = { type = "NumberSequence", default = NumberSequence.new(0) },
	RotSpeedZ     = { type = "NumberSequence", default = NumberSequence.new(0) },
	-- Timescale graph: scales per-frame elapsed-time advancement. Default constant 1
	-- means real-time playback. <1 slows, 0 freezes, >1 speeds up, NEGATIVE rewinds (v2).
	-- Sampled at REAL normalized time `(now - StartTime) / LifeTime` so the graph
	-- progresses monotonically through its keypoints regardless of which direction
	-- the particle's effective time is moving. Initial `_effectiveElapsed` depends on
	-- the graph's value at i=0: ts(0) >= 0 → particle starts at 0 and plays forward;
	-- ts(0) < 0 → particle starts at LifeTime (end-state visual) and rewinds to 0.
	-- This is what makes a STATIC `Timescale = -1` produce end-to-start playback.
	-- Runtime: `dt *= ts(real_i)`, `_effectiveElapsed += dt` clamped to [0, LifeTime].
	-- Death rule: ONLY after the graph has finished playing (real_i >= 1) does a
	-- boundary cross (effective hit 0 or LifeTime) trigger death. During graph
	-- playback the particle bounces freely between bounds  -  users can author graphs
	-- that overshoot either bound without prematurely killing the particle. Sticky-
	-- zero post-graph (last-keypoint ts == 0 + effective stuck mid-life) is
	-- documented user error: no real-time cap, particle leaks the slot.
	Timescale     = { type = "NumberSequence", default = NumberSequence.new(1) },

	-- Non-graph properties
	Lifetime          = { type = "NumberRange",  default = NumberRange.new(1) },
	Rate              = { type = "number",       default = 10 },
	Drag              = { type = "number",       default = 0 },
	Acceleration      = { type = "Vector3",      default = Vector3.new(0, 0, 0) },
	SpreadAngle       = { type = "Vector2",      default = Vector2.new(0, 0) },
	RotX              = { type = "NumberRange",   default = NumberRange.new(0) },
	RotY              = { type = "NumberRange",   default = NumberRange.new(0) },
	RotZ              = { type = "NumberRange",   default = NumberRange.new(0) },
	PosX              = { type = "NumberRange",   default = NumberRange.new(0) },
	PosY              = { type = "NumberRange",   default = NumberRange.new(0) },
	PosZ              = { type = "NumberRange",   default = NumberRange.new(0) },
	PosMode           = { type = "string",       default = "Local" },
	RotMode           = { type = "string",       default = "OverLife" },
	RotOrder          = { type = "string",       default = "Global" },
	TotalKeyFrames    = { type = "number",       default = 100 },
	PartLife          = { type = "number",       default = 0, nonNegative = true },
	VelocityVectored  = { type = "boolean",      default = false },
	DirMode           = { type = "string",       default = "RigidLocal" },
	DisplacementMode  = { type = "string",       default = "Global" },
	InvertMotion      = { type = "boolean",      default = false },
	Enabled           = { type = "boolean",      default = false },

	-- Enum properties (stored as string Name)
	EmissionDirection  = { type = "enum", enumType = "NormalId", default = Enum.NormalId.Top },
	Orientation        = { type = "string", default = "None" },
	ZOffset            = { type = "number", default = 0 },

	-- Axis links: default "" means unlinked; GetData sanitizes empty/invalid values to nil.
	-- Attachment has Rot/Pos/RotSpeed config rows but not Size, so Size*LinkedTo entries are
	-- omitted to keep the attribute count tight.
	RotSpeedXLinkedTo    = { type = "string", default = "" },
	RotSpeedYLinkedTo    = { type = "string", default = "" },
	RotSpeedZLinkedTo    = { type = "string", default = "" },
	PosOffsetXLinkedTo   = { type = "string", default = "" },
	PosOffsetYLinkedTo   = { type = "string", default = "" },
	PosOffsetZLinkedTo   = { type = "string", default = "" },
	RotXLinkedTo         = { type = "string", default = "" },
	RotYLinkedTo         = { type = "string", default = "" },
	RotZLinkedTo         = { type = "string", default = "" },
	PosXLinkedTo         = { type = "string", default = "" },
	PosYLinkedTo         = { type = "string", default = "" },
	PosZLinkedTo         = { type = "string", default = "" },
	-- EvenDistribution: per-axis toggle. When true + EmitIndex/EmitCount in emitCtx,
	-- the axis samples a deterministic spread across [Min, Max] instead of random.
	-- Burst emits use the natural EmitCount; Rate emits use a rolling counter mod 12.
	-- Linked followers inherit the primary's spread scalar via AxisLinks.sampleRangeAxes.
	RotXEven             = { type = "boolean", default = false },
	RotYEven             = { type = "boolean", default = false },
	RotZEven             = { type = "boolean", default = false },
	PosXEven             = { type = "boolean", default = false },
	PosYEven             = { type = "boolean", default = false },
	PosZEven             = { type = "boolean", default = false },

	Pool                 = { type = "boolean", default = false },
}

TypeData.ModelProperties = {
	-- Graph properties (NumberSequence)
	Speed         = { type = "NumberSequence", default = NumberSequence.new(0) },
	-- Over-life per-axis position offset graphs (see PartProperties for semantics).
	PosOffsetX    = { type = "NumberSequence", default = NumberSequence.new(0) },
	PosOffsetY    = { type = "NumberSequence", default = NumberSequence.new(0) },
	PosOffsetZ    = { type = "NumberSequence", default = NumberSequence.new(0) },
	RotSpeedX     = { type = "NumberSequence", default = NumberSequence.new(0) },
	RotSpeedY     = { type = "NumberSequence", default = NumberSequence.new(0) },
	RotSpeedZ     = { type = "NumberSequence", default = NumberSequence.new(0) },
	Scale         = { type = "NumberSequence", default = NumberSequence.new(1), nonNegative = true },
	-- Timescale: see PartProperties.
	Timescale     = { type = "NumberSequence", default = NumberSequence.new(1) },

	-- Non-graph properties
	Lifetime          = { type = "NumberRange",  default = NumberRange.new(1) },
	Rate              = { type = "number",       default = 10 },
	Drag              = { type = "number",       default = 0 },
	Acceleration      = { type = "Vector3",      default = Vector3.new(0, 0, 0) },
	SpreadAngle       = { type = "Vector2",      default = Vector2.new(0, 0) },
	RotX              = { type = "NumberRange",   default = NumberRange.new(0) },
	RotY              = { type = "NumberRange",   default = NumberRange.new(0) },
	RotZ              = { type = "NumberRange",   default = NumberRange.new(0) },
	PosX              = { type = "NumberRange",   default = NumberRange.new(0) },
	PosY              = { type = "NumberRange",   default = NumberRange.new(0) },
	PosZ              = { type = "NumberRange",   default = NumberRange.new(0) },
	PosMode           = { type = "string",       default = "Local" },
	RotMode           = { type = "string",       default = "OverLife" },
	RotOrder          = { type = "string",       default = "Global" },
	TotalKeyFrames    = { type = "number",       default = 100 },
	PartLife          = { type = "number",       default = 0, nonNegative = true },
	VelocityVectored  = { type = "boolean",      default = false },
	DirMode           = { type = "string",       default = "RigidLocal" },
	DisplacementMode  = { type = "string",       default = "Global" },
	InvertMotion      = { type = "boolean",      default = false },
	Enabled           = { type = "boolean",      default = false },
	-- When true, descendant Beam's TextureLength scales with the Model's Scale graph
	-- (preserves tile count as Beam grows). When false, TextureLength stays at authored
	-- value (tiles repeat more as Beam scales up). Default true preserves prior behavior.
	ScaleTextureLength = { type = "boolean",     default = true },

	-- Enum properties
	EmissionDirection  = { type = "enum", enumType = "NormalId", default = Enum.NormalId.Top },
	Orientation        = { type = "string", default = "None" },
	ZOffset            = { type = "number", default = 0 },

	-- Axis links: default "" means unlinked; GetData sanitizes empty/invalid values to nil.
	-- Model has Rot/Pos/RotSpeed config rows; Scale isn't axis-keyed so no link metadata.
	RotSpeedXLinkedTo    = { type = "string", default = "" },
	RotSpeedYLinkedTo    = { type = "string", default = "" },
	RotSpeedZLinkedTo    = { type = "string", default = "" },
	PosOffsetXLinkedTo   = { type = "string", default = "" },
	PosOffsetYLinkedTo   = { type = "string", default = "" },
	PosOffsetZLinkedTo   = { type = "string", default = "" },
	RotXLinkedTo         = { type = "string", default = "" },
	RotYLinkedTo         = { type = "string", default = "" },
	RotZLinkedTo         = { type = "string", default = "" },
	PosXLinkedTo         = { type = "string", default = "" },
	PosYLinkedTo         = { type = "string", default = "" },
	PosZLinkedTo         = { type = "string", default = "" },
	-- EvenDistribution: per-axis toggle. When true + EmitIndex/EmitCount in emitCtx,
	-- the axis samples a deterministic spread across [Min, Max] instead of random.
	-- Burst emits use the natural EmitCount; Rate emits use a rolling counter mod 12.
	-- Linked followers inherit the primary's spread scalar via AxisLinks.sampleRangeAxes.
	RotXEven             = { type = "boolean", default = false },
	RotYEven             = { type = "boolean", default = false },
	RotZEven             = { type = "boolean", default = false },
	PosXEven             = { type = "boolean", default = false },
	PosYEven             = { type = "boolean", default = false },
	PosZEven             = { type = "boolean", default = false },

	Pool                 = { type = "boolean", default = false },
}

TypeData.Types = {
	Part = {
		classCheck = function(item) return item:IsA("BasePart") end,
		pDataType = "Part",
		uiSection = "Meshes",
		properties = TypeData.PartProperties,

		resize = {
			scaleGraphs = { "SizeX", "SizeY", "SizeZ", "Speed", "AccelStrength", "PosOffsetX", "PosOffsetY", "PosOffsetZ" },
			scaleVectors = { "Acceleration" },
			scaleRanges = { "PosX", "PosY", "PosZ" },
		},
		retime = {
			multiplyNumbers = { "Rate", "Drag" },
			divideRanges = { "Lifetime" },
			multiplyRanges = { "FlipbookFramerate" },
			multiplyGraphs = { "Speed" },
			rotSpeedGraphs = { "RotSpeedX", "RotSpeedY", "RotSpeedZ" },
			squareVectors = { "Acceleration" },
			squareGraphs = { "AccelStrength" },
		},
		clipboard = {
			{name = "Spawning", props = {"Rate", "Lifetime", "SpreadAngle", "EmissionDirection", "PosX", "PosY", "PosZ", "PosXEven", "PosYEven", "PosZEven", "PosMode", "Orientation", "ZOffset"}},
			{name = "Emission", props = {"EmitCount", "EmitDelay", "EmitDuration"}},
			{name = "Appearance", props = {"Brightness", "Color", "SizeX", "SizeY", "SizeZ", "Transparency", "Material"}},
			{name = "Movement", props = {"Speed", "PosOffsetX", "PosOffsetY", "PosOffsetZ", "RotMode", "RotOrder", "RotSpeedX", "RotSpeedY", "RotSpeedZ", "Acceleration", "Drag", "DirMode", "DisplacementMode", "InvertMotion", "AccelerationTowardsInstance", "AccelStrength", "Timescale"}},
			{name = "Shape", props = {"UseShape", "Shape", "ShapeInOut", "ShapePartial", "LookAtInitially"}},
			{name = "Flipbook", props = {"FlipbookMode", "FlipbookFramerate", "FlipbookStartRandom", "FlipbookReverse"}},
			{name = "Advanced", props = {"TotalKeyFrames", "PartLife", "RotX", "RotY", "RotZ", "RotXEven", "RotYEven", "RotZEven", "Pool"}},
			-- One virtual prop per event so users pick which events to copy/paste. Each
			-- event prop's per-type validity is governed by EventsSchema.VALID_PER_TYPE,
			-- so filterTogglesBySelection auto-hides rows for events the selection's
			-- types don't support (e.g. OnHit hides for Beam-only selections).
			{name = "Events", props = {"OnEmit", "OnDeath", "OnDestruction", "OnHit"}},
		},
	},

	-- Beam emitter (post-"Transform as Emitter"): full particle pipeline. Differentiated from
	-- directAccess BeamNative by presence of a PartIcleProperties Configuration child.
	Beam = {
		classCheck = function(item) return item:IsA("Beam") and item:FindFirstChild("PartIcleProperties") ~= nil end,
		pDataType = "Beam",
		uiSection = "Beams",
		properties = TypeData.BeamProperties,

		resize = {
			scaleGraphs = { "Width0", "Width1", "CurveSize0", "CurveSize1", "Segments" },
		},
		retime = {
			multiplyNumbers = { "Rate" },
			divideRanges = { "Lifetime" },
			multiplyRanges = { "FlipbookFramerate" },
			multiplyGraphs = { "TextureSpeed" },
		},
		clipboard = {
			{name = "Spawning", props = {"Rate", "Lifetime"}},
			{name = "Emission", props = {"EmitCount", "EmitDelay", "EmitDuration"}},
			{name = "Appearance", props = {"Brightness", "Width0", "Width1", "LightEmission", "LightInfluence", "ZOffset"}},
			{name = "Geometry", props = {"CurveSize0", "CurveSize1", "Segments", "TextureLength", "TextureSpeed", "TextureMode", "FaceCamera"}},
			{name = "Flipbook", props = {"FlipbookMode", "FlipbookFramerate", "FlipbookStartRandom", "FlipbookReverse"}},
			{name = "Advanced", props = {"TotalKeyFrames", "Timescale", "Pool"}},
			{name = "Blender", props = {"Blender"}},
			{name = "Events", props = {"OnEmit", "OnDeath", "OnDestruction"}},
		},
	},

	PointLight = {
		classCheck = function(item) return item:IsA("PointLight") end,
		pDataType = "PointLight",
		uiSection = "PointLights",
		properties = TypeData.PointLightProperties,

		resize = {
			scaleGraphs = { "Range" },
		},
		retime = {
			multiplyNumbers = { "Rate" },
			divideRanges = { "Lifetime" },
		},
		clipboard = {
			{name = "Spawning", props = {"Rate", "Lifetime"}},
			{name = "Emission", props = {"EmitCount", "EmitDelay", "EmitDuration"}},
			{name = "Appearance", props = {"Range", "Brightness", "Color", "Shadows"}},
			{name = "Advanced", props = {"TotalKeyFrames", "PartLife", "Timescale", "Pool"}},
			{name = "Events", props = {"OnEmit", "OnDeath", "OnDestruction"}},
		},
	},

	Highlight = {
		classCheck = function(item) return item:IsA("Highlight") end,
		pDataType = "Highlight",
		uiSection = "Highlights",
		properties = TypeData.HighlightProperties,

		retime = {
			multiplyNumbers = { "Rate" },
			divideRanges = { "Lifetime" },
		},
		clipboard = {
			{name = "Spawning", props = {"Rate", "Lifetime"}},
			{name = "Emission", props = {"EmitCount", "EmitDelay", "EmitDuration"}},
			{name = "Appearance", props = {"FillColor", "FillTransparency", "OutlineColor", "OutlineTransparency", "DepthMode"}},
			{name = "Advanced", props = {"TotalKeyFrames", "PartLife", "Timescale", "Pool"}},
			{name = "Events", props = {"OnEmit", "OnDeath", "OnDestruction"}},
		},
	},

	-- TrailEmitter: Trail with a PartIcleProperties Configuration child (post-Transform-as-Emitter).
	-- Mutually exclusive with directAccess Trail via the FindFirstChild discriminator below.
	TrailEmitter = {
		classCheck = function(item) return item:IsA("Trail") and item:FindFirstChild("PartIcleProperties") ~= nil end,
		pDataType = "TrailEmitter",
		uiSection = "TrailEmitters",
		properties = TypeData.TrailEmitterProperties,

		resize = {
			scaleGraphs = { "MinLength", "MaxLength" },
		},
		retime = {
			multiplyNumbers = { "Rate" },
			divideRanges = { "Lifetime", "TrailLife" },
			multiplyRanges = { "TrailFlipbookFramerate" },
		},
		clipboard = {
			{name = "Spawning", props = {"Rate", "Lifetime"}},
			{name = "Emission", props = {"EmitCount", "EmitDelay", "EmitDuration"}},
			{name = "Appearance", props = {"Brightness", "LightEmission", "LightInfluence", "Texture", "TextureMode", "FaceCamera"}},
			{name = "Geometry", props = {"TextureLength", "MinLength", "MaxLength"}},
			{name = "Advanced", props = {"TotalKeyFrames", "PartLife", "Timescale", "Pool"}},
			{name = "Events", props = {"OnEmit", "OnDeath", "OnDestruction"}},
		},
	},

	-- Native Beam (directAccess): plain Beam without PartIcleProperties. Read/write directly
	-- on instance. Mutually exclusive with emitter Beam via FindFirstChild discriminator.
	BeamNative = {
		classCheck = function(item) return item:IsA("Beam") and item:FindFirstChild("PartIcleProperties") == nil end,
		pDataType = "BeamNative",
		uiSection = "BeamNatives",
		directAccess = true,
		properties = TypeData.BeamNativeProperties,

		resize = {
			scaleNumbers = { "Width0", "Width1", "CurveSize0", "CurveSize1" },
		},
		retime = {
			multiplyNumbers = { "TextureSpeed" },
		},

		clipboard = {
			{name = "Appearance", props = {"Brightness", "Color", "Transparency", "LightEmission", "LightInfluence", "ZOffset"}},
			{name = "Geometry", props = {"Width0", "Width1", "CurveSize0", "CurveSize1", "Segments", "TextureLength", "TextureSpeed", "TextureMode", "FaceCamera"}},
			{name = "Texture", props = {"Texture"}},
		},
	},

	Trail = {
		classCheck = function(item) return item:IsA("Trail") and item:FindFirstChild("PartIcleProperties") == nil end,
		pDataType = "Trail",
		uiSection = "Trails",
		directAccess = true,
		properties = TypeData.TrailProperties,

		resize = {
			scaleGraphs = { "WidthScale" },
		},
		retime = {
			divideNumbers = { "Lifetime" },
		},
		clipboard = {
			{name = "Spawning", props = {"Lifetime"}},
			-- Trail uses the logical key `Duration` (attrName=EmitDuration) instead of
			-- the virtual `EmitDuration` non-Trail items use. RandomizerRules has a
			-- special-case for Trail Duration; expose it in the catalog so the
			-- Randomizer panel actually surfaces a row.
			{name = "Emission", props = {"Duration"}},
			{name = "Appearance", props = {"Brightness", "Transparency", "Color", "WidthScale", "LightEmission", "LightInfluence"}},
			{name = "Geometry", props = {"MinLength", "MaxLength", "TextureLength", "TextureMode", "FaceCamera"}},
		},
	},

	Attachment = {
		classCheck = function(item) return item:IsA("Attachment") end,
		pDataType = "Attachment",
		uiSection = "Attachments",
		properties = TypeData.AttachmentProperties,

		resize = {
			scaleGraphs = { "Speed", "PosOffsetX", "PosOffsetY", "PosOffsetZ" },
			scaleVectors = { "Acceleration" },
			scaleRanges = { "PosX", "PosY", "PosZ" },
		},
		retime = {
			multiplyNumbers = { "Rate", "Drag" },
			divideRanges = { "Lifetime" },
			multiplyGraphs = { "Speed" },
			rotSpeedGraphs = { "RotSpeedX", "RotSpeedY", "RotSpeedZ" },
			squareVectors = { "Acceleration" },
		},
		clipboard = {
			{name = "Spawning", props = {"Rate", "Lifetime", "SpreadAngle", "EmissionDirection", "PosX", "PosY", "PosZ", "PosXEven", "PosYEven", "PosZEven", "PosMode", "Orientation", "ZOffset"}},
			{name = "Emission", props = {"EmitCount", "EmitDelay", "EmitDuration"}},
			{name = "Movement", props = {"Speed", "PosOffsetX", "PosOffsetY", "PosOffsetZ", "RotMode", "RotOrder", "RotSpeedX", "RotSpeedY", "RotSpeedZ", "Acceleration", "Drag", "DirMode", "DisplacementMode", "InvertMotion", "Timescale"}},
			{name = "Advanced", props = {"TotalKeyFrames", "PartLife", "RotX", "RotY", "RotZ", "RotXEven", "RotYEven", "RotZEven", "Pool"}},
			{name = "Events", props = {"OnEmit", "OnDeath", "OnDestruction", "OnHit"}},
		},
	},

	Model = {
		classCheck = function(item) return item:IsA("Model") end,
		pDataType = "Model",
		uiSection = "Models",
		properties = TypeData.ModelProperties,

		resize = {
			scaleGraphs = { "Speed", "Scale", "PosOffsetX", "PosOffsetY", "PosOffsetZ" },
			scaleVectors = { "Acceleration" },
			scaleRanges = { "PosX", "PosY", "PosZ" },
		},
		retime = {
			multiplyNumbers = { "Rate", "Drag" },
			divideRanges = { "Lifetime" },
			multiplyGraphs = { "Speed" },
			rotSpeedGraphs = { "RotSpeedX", "RotSpeedY", "RotSpeedZ" },
			squareVectors = { "Acceleration" },
		},
		clipboard = {
			{name = "Spawning", props = {"Rate", "Lifetime", "SpreadAngle", "EmissionDirection", "PosX", "PosY", "PosZ", "PosXEven", "PosYEven", "PosZEven", "PosMode", "Orientation", "ZOffset"}},
			{name = "Emission", props = {"EmitCount", "EmitDelay", "EmitDuration"}},
			{name = "Scale", props = {"Scale", "ScaleTextureLength"}},
			{name = "Movement", props = {"Speed", "PosOffsetX", "PosOffsetY", "PosOffsetZ", "RotMode", "RotOrder", "RotSpeedX", "RotSpeedY", "RotSpeedZ", "Acceleration", "Drag", "DirMode", "DisplacementMode", "InvertMotion", "Timescale"}},
			{name = "Advanced", props = {"TotalKeyFrames", "PartLife", "RotX", "RotY", "RotZ", "RotXEven", "RotYEven", "RotZEven", "Pool"}},
			{name = "Events", props = {"OnEmit", "OnDeath", "OnDestruction", "OnHit"}},
		},
	},
}

-- Merge in screen-type Types (Blur, Bloom, ColorCorrection, Atmosphere, ImageLabel).
for name, entry in pairs(ScreenData.Types) do TypeData.Types[name] = entry end

return TypeData
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="66">
              <Properties>
                <string name="Name">TypeDataScreen</string>
                <string name="Source"><![CDATA[-- TypeDataScreen  -  Property tables + Types entries for the five screen-space types:
-- Blur, Bloom, ColorCorrection, Atmosphere, ImageLabel.
-- Shape + schema identical to TypeData  -  see that file's header for the property-entry format.

local Screen = {}

Screen.BlurProperties = {
	-- Graph properties
	Size           = { type = "NumberSequence", default = NumberSequence.new(10), attrName = "BlurSize", nonNegative = true },

	-- Timescale graph: see TypeData.PartProperties for full semantics.
	Timescale      = { type = "NumberSequence", default = NumberSequence.new(1) },

	-- Non-graph properties
	Lifetime       = { type = "NumberRange", default = NumberRange.new(1) },
	Rate           = { type = "number",      default = 10 },
	TotalKeyFrames = { type = "number",      default = 100 },
	PartLife       = { type = "number",      default = 0 },
	Enabled        = { type = "boolean",     default = false },
}

Screen.BloomProperties = {
	-- Graph properties (per BloomEffect spec: Intensity 0..1, Size 0..56, Threshold 0..10)
	Intensity      = { type = "NumberSequence", default = NumberSequence.new(0.4),  attrName = "BloomIntensity", nonNegative = true },
	Size           = { type = "NumberSequence", default = NumberSequence.new(24),   attrName = "BloomSize",      nonNegative = true },
	Threshold      = { type = "NumberSequence", default = NumberSequence.new(0.95), attrName = "BloomThreshold", nonNegative = true },

	-- Timescale graph: see TypeData.PartProperties for full semantics.
	Timescale      = { type = "NumberSequence", default = NumberSequence.new(1) },

	-- Non-graph properties
	Lifetime       = { type = "NumberRange", default = NumberRange.new(1) },
	Rate           = { type = "number",      default = 10 },
	TotalKeyFrames = { type = "number",      default = 100 },
	PartLife       = { type = "number",      default = 0 },
	Enabled        = { type = "boolean",     default = false },
}

Screen.ColorCorrectionProperties = {
	-- Graph properties (all signed: -1..1 range, so no nonNegative)
	Brightness     = { type = "NumberSequence", default = NumberSequence.new(0), attrName = "CCBrightness" },
	Contrast       = { type = "NumberSequence", default = NumberSequence.new(0), attrName = "CCContrast" },
	Saturation     = { type = "NumberSequence", default = NumberSequence.new(0), attrName = "CCSaturation" },
	TintColor      = { type = "ColorSequence",  default = ColorSequence.new(Color3.new(1,1,1)), attrName = "CCTintColor" },

	-- Timescale graph: see TypeData.PartProperties for full semantics.
	Timescale      = { type = "NumberSequence", default = NumberSequence.new(1) },

	-- Non-graph properties
	Lifetime       = { type = "NumberRange", default = NumberRange.new(1) },
	Rate           = { type = "number",      default = 10 },
	TotalKeyFrames = { type = "number",      default = 100 },
	PartLife       = { type = "number",      default = 0 },
	Enabled        = { type = "boolean",     default = false },
}

Screen.AtmosphereProperties = {
	-- Graph properties (Density/Offset 0..1, Glare 0..24, Haze 0..10 per Atmosphere spec)
	Density        = { type = "NumberSequence", default = NumberSequence.new(0.3),  attrName = "AtmDensity", nonNegative = true },
	Offset         = { type = "NumberSequence", default = NumberSequence.new(0.25), attrName = "AtmOffset",  nonNegative = true },
	Glare          = { type = "NumberSequence", default = NumberSequence.new(0),    attrName = "AtmGlare",   nonNegative = true },
	Haze           = { type = "NumberSequence", default = NumberSequence.new(0),    attrName = "AtmHaze",    nonNegative = true },
	Color          = { type = "ColorSequence",  default = ColorSequence.new(Color3.new(0.78, 0.78, 0.78)), attrName = "AtmColor" },
	Decay          = { type = "ColorSequence",  default = ColorSequence.new(Color3.new(0.416, 0.471, 0.541)), attrName = "AtmDecay" },
	-- Timescale graph: see TypeData.PartProperties for full semantics.
	Timescale      = { type = "NumberSequence", default = NumberSequence.new(1), attrName = "AtmTimescale" },

	-- Non-graph properties (Atmosphere has no native Enabled; we track it for emission timing only)
	Lifetime       = { type = "NumberRange", default = NumberRange.new(1) },
	Rate           = { type = "number",      default = 10 },
	TotalKeyFrames = { type = "number",      default = 100 },
	PartLife       = { type = "number",      default = 0 },
	Enabled        = { type = "boolean",     default = false },
}

Screen.ImageLabelProperties = {
	-- Graph properties (animate per-life)
	ImageTransparency       = { type = "NumberSequence", default = NumberSequence.new(0) },
	BackgroundTransparency  = { type = "NumberSequence", default = NumberSequence.new(1) }, -- default invisible
	Speed                   = { type = "NumberSequence", default = NumberSequence.new(0), attrName = "ImgSpeed", nonNegative = true },

	-- Per-axis Size scale graphs (multiply base Size components per frame). Keys match the
	-- axis_graph_select widget's expected naming (baseKey "SizeScale" + axis "X"/"Y").
	SizeScaleX              = { type = "NumberSequence", default = NumberSequence.new(1), nonNegative = true },
	SizeScaleY              = { type = "NumberSequence", default = NumberSequence.new(1), nonNegative = true },

	-- Rotation system (RotRange for random initial; RotSpeed graph for continuous/over-life spin; RotMode switches semantics)
	RotRange                = { type = "NumberRange",    default = NumberRange.new(0),   attrName = "ImgRotRange" },
	RotSpeed                = { type = "NumberSequence", default = NumberSequence.new(0), attrName = "ImgRotSpeed" },
	RotMode                 = { type = "string",         default = "OverLife",            attrName = "ImgRotMode" },

	-- ColorSequences
	ImageColor3             = { type = "ColorSequence",  default = ColorSequence.new(Color3.new(1,1,1)) },
	BackgroundColor3        = { type = "ColorSequence",  default = ColorSequence.new(Color3.new(1,1,1)) },

	-- Static at emit
	Image             = { type = "string",    default = "" },
	Position          = { type = "UDim2",     default = UDim2.fromScale(0.5, 0.5) },
	Size              = { type = "UDim2",     default = UDim2.fromOffset(100, 100), attrName = "ImgSize" },
	AnchorPoint       = { type = "Vector2",   default = Vector2.new(0.5, 0.5) },
	ZIndex            = { type = "number",    default = 1 },
	ScaleType         = { type = "enum",      enumType = "ScaleType",       default = Enum.ScaleType.Stretch },
	ResampleMode      = { type = "enum",      enumType = "ResamplerMode",   default = Enum.ResamplerMode.Default },

	-- 2D motion
	EmissionAngle     = { type = "number",    default = 90 }, -- 90 = up, 0 = right, 180 = left, 270 = down
	SpreadAngle       = { type = "number",    default = 0, attrName = "ImgSpreadAngle" },
	Acceleration      = { type = "Vector2",   default = Vector2.new(0, 0), attrName = "ImgAcceleration" },
	Drag              = { type = "number",    default = 0, attrName = "ImgDrag" },
	InvertMotion      = { type = "boolean",   default = false, attrName = "ImgInvertMotion" },

	-- Flipbook source type (asset layout)  -  "Decals" = numbered-Decals folder, "Spritesheet" = grid on single Image.
	FlipbookSource     = { type = "string",      default = "Decals", attrName = "ImgFlipbookSource" },
	-- Flipbook playback mode  -  matches Roblox's Enum.ParticleFlipbookMode convention (Loop/OneShot/PingPong/Random).
	FlipbookMode       = { type = "enum",        enumType = "ParticleFlipbookMode", default = Enum.ParticleFlipbookMode.Loop, attrName = "ImgFlipbookMode" },
	FlipbookStartRandom = { type = "boolean",    default = false, attrName = "ImgFlipbookStartRandom" },
	GridCols           = { type = "number",      default = 8 },
	GridRows           = { type = "number",      default = 1 },
	FlipbookFramerate  = { type = "NumberRange", default = NumberRange.new(10), attrName = "ImgFlipbookFramerate" },
	FlipbookReverse    = { type = "boolean",     default = false, attrName = "ImgFlipbookReverse" },

	-- Timescale graph: see TypeData.PartProperties for full semantics.
	Timescale      = { type = "NumberSequence", default = NumberSequence.new(1), attrName = "ImgTimescale" },

	-- Standard
	Lifetime       = { type = "NumberRange", default = NumberRange.new(1) },
	Rate           = { type = "number",      default = 10 },
	TotalKeyFrames = { type = "number",      default = 100 },
	PartLife       = { type = "number",      default = 0 },
	Enabled        = { type = "boolean",     default = false },
}

Screen.Types = {
	Blur = {
		classCheck = function(item) return item:IsA("BlurEffect") end,
		pDataType = "Blur",
		uiSection = "Blurs",
		properties = Screen.BlurProperties,
		resize = { scaleGraphs = { "Size" } },
		retime = { multiplyNumbers = { "Rate" }, divideRanges = { "Lifetime" } },
		clipboard = {
			{name = "Spawning",   props = {"Rate", "Lifetime"}},
			{name = "Emission",   props = {"EmitCount", "EmitDelay", "EmitDuration"}},
			{name = "Appearance", props = {"Size"}},
			{name = "Advanced",   props = {"TotalKeyFrames", "PartLife", "Timescale"}},
			{name = "Events",     props = {"OnEmit", "OnDeath", "OnDestruction"}},
		},
	},

	Bloom = {
		classCheck = function(item) return item:IsA("BloomEffect") end,
		pDataType = "Bloom",
		uiSection = "Blooms",
		properties = Screen.BloomProperties,
		resize = { scaleGraphs = { "Size" } },
		retime = { multiplyNumbers = { "Rate" }, divideRanges = { "Lifetime" } },
		clipboard = {
			{name = "Spawning",   props = {"Rate", "Lifetime"}},
			{name = "Emission",   props = {"EmitCount", "EmitDelay", "EmitDuration"}},
			{name = "Appearance", props = {"Intensity", "Size", "Threshold"}},
			{name = "Advanced",   props = {"TotalKeyFrames", "PartLife", "Timescale"}},
			{name = "Events",     props = {"OnEmit", "OnDeath", "OnDestruction"}},
		},
	},

	ColorCorrection = {
		classCheck = function(item) return item:IsA("ColorCorrectionEffect") end,
		pDataType = "ColorCorrection",
		uiSection = "ColorCorrections",
		properties = Screen.ColorCorrectionProperties,
		resize = {},
		retime = { multiplyNumbers = { "Rate" }, divideRanges = { "Lifetime" } },
		clipboard = {
			{name = "Spawning",   props = {"Rate", "Lifetime"}},
			{name = "Emission",   props = {"EmitCount", "EmitDelay", "EmitDuration"}},
			{name = "Appearance", props = {"Brightness", "Contrast", "Saturation", "TintColor"}},
			{name = "Advanced",   props = {"TotalKeyFrames", "PartLife", "Timescale"}},
			{name = "Events",     props = {"OnEmit", "OnDeath", "OnDestruction"}},
		},
	},

	Atmosphere = {
		classCheck = function(item) return item:IsA("Atmosphere") end,
		pDataType = "Atmosphere",
		uiSection = "Atmospheres",
		properties = Screen.AtmosphereProperties,
		resize = {},
		retime = { multiplyNumbers = { "Rate" }, divideRanges = { "Lifetime" } },
		clipboard = {
			{name = "Spawning",   props = {"Rate", "Lifetime"}},
			{name = "Emission",   props = {"EmitCount", "EmitDelay", "EmitDuration"}},
			{name = "Appearance", props = {"Density", "Offset", "Glare", "Haze", "Color", "Decay"}},
			{name = "Advanced",   props = {"TotalKeyFrames", "PartLife", "Timescale"}},
			{name = "Events",     props = {"OnEmit", "OnDeath", "OnDestruction"}},
		},
	},

	ImageLabel = {
		classCheck = function(item) return item:IsA("ImageLabel") end,
		pDataType = "ImageLabel",
		uiSection = "ImageLabels",
		properties = Screen.ImageLabelProperties,
		resize = {
			-- Pixel-sized bits scale: Speed graph (px/sec), per-axis size scale graphs, Acceleration (Vector2),
			-- and the UDim2 Position/Size rectangles (both Scale and Offset components scale together).
			scaleGraphs  = { "Speed", "SizeScaleX", "SizeScaleY" },
			scaleVectors = { "Acceleration" },
			scaleUDim2s  = { "Position", "Size" },
		},
		retime = {
			multiplyNumbers = { "Rate", "Drag" },
			divideRanges    = { "Lifetime" },
			multiplyRanges  = { "FlipbookFramerate" },
			multiplyGraphs  = { "Speed", "RotSpeed" },
			-- Acceleration is studs/sec² (or screen-pixels/sec² here); kinematic shape preserved
			-- under retime requires factor² scaling. Other types include this; ImageLabel was missing.
			squareVectors   = { "Acceleration" },
		},
		clipboard = {
			{name = "Spawning",   props = {"Rate", "Lifetime", "RotRange", "RotSpeed", "RotMode"}},
			{name = "Emission",   props = {"EmitCount", "EmitDelay", "EmitDuration"}},
			{name = "Appearance", props = {"Image", "ImageColor3", "ImageTransparency", "BackgroundColor3", "BackgroundTransparency", "ScaleType", "ResampleMode"}},
			-- (FlipbookMode stays in the Flipbook group  -  conceptually belongs there.)
			{name = "Layout",     props = {"Position", "Size", "SizeScaleX", "SizeScaleY", "AnchorPoint", "ZIndex"}},
			{name = "Motion",     props = {"Speed", "EmissionAngle", "SpreadAngle", "Acceleration", "Drag", "InvertMotion"}},
			{name = "Flipbook",   props = {"FlipbookSource", "FlipbookMode", "FlipbookStartRandom", "GridCols", "GridRows", "FlipbookFramerate", "FlipbookReverse"}},
			{name = "Advanced",   props = {"TotalKeyFrames", "PartLife", "Timescale"}},
			{name = "Events",     props = {"OnEmit", "OnDeath", "OnDestruction"}},
		},
	},
}

return Screen
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">Update</string>
              <string name="Source"><![CDATA[--[[
	Update Mixin  -  per-frame update for Part / Beam / Attachment.
	Returns true when Lifetime expires (swap-and-pop or animate-loop reset).
	Hot-path zero-allocation contract: no CFrame/Vector3/table creation in step loops.
]]

local GraphMod = require(script.Parent.Graph)
local Constants = require(script.Parent.PartConstants)
local EventsCollision = require(script.Parent.EventsCollision)
local DirectionVectors = Constants.DirectionVectors

-- Per-frame parent CFrame for linked particles. Weld uses full link CFrame; Follow/Pivot strip rotation.
local function getLinkCF(pData)
	local lk = pData.Link
	if not (lk and lk.Parent) then return CFrame.new(), false end
	local worldCF = Constants.resolveLinkCFrame(lk)
	if pData.LinkMode == "Follow" or pData.LinkMode == "Pivot" then
		return CFrame.new(worldCF.Position), false
	end
	return worldCF, true
end

-- Attachment variant: convert link world CFrame → visual's parent-local space.
local function getAttachmentLinkCF(pData)
	local lk = pData.Link
	if not (lk and lk.Parent) then return CFrame.new(), false, false end
	local visualParent = pData.VisualPart and pData.VisualPart.Parent
	if not visualParent then return CFrame.new(), false, false end
	local linkWorldCF = Constants.resolveLinkCFrame(lk)
	local convCF = visualParent:IsA("BasePart") and visualParent.CFrame or CFrame.new()
	local linkLocalCF = convCF:ToObjectSpace(linkWorldCF)
	if pData.LinkMode == "Follow" or pData.LinkMode == "Pivot" then
		return CFrame.new(linkLocalCF.Position), false, true
	end
	return linkLocalCF, true, true
end

-- World position for target-accel; nil for destroyed / no-Position types.
-- Bone before BasePart (Bone IS-A BasePart but .Position is bind pose, not live).
local function getTargetPosition(target)
	if not target or not target.Parent then return nil end
	if target:IsA("Bone") then return target.TransformedWorldCFrame.Position end
	if target:IsA("BasePart") then return target.Position end
	if target:IsA("Attachment") then return target.WorldPosition end
	if target:IsA("Camera") then return target.CFrame.Position end
	if target:IsA("Model") then local ok, cf = pcall(target.GetPivot, target); if ok and cf then return cf.Position end end
	return nil
end

-- PosOffsetX/Y/Z over-life graph → per-frame delta added to displacement.
-- Difference-based: sample absolute offset at t_norm in the DisplacementMode
-- frame, subtract _prevWorldOff. LocalCF accumulator integrates correctly.
-- Three frames mirror DirMode (Speed direction):
--   Global     = world axes (no rotation applied)
--   Local      = SpawnRotation (post-RotXYZ particle frame; per-particle RotXYZ
--                rotates the path → fans / scatter / convergence patterns)
--   RigidLocal = SpawnEmitterRotation (emitter frame at spawn, pre-RotXYZ;
--                path follows emitter orientation but not particle tumble)
local function _posOffsetFrameDelta(pData, steppedI)
	if not pData.HasPosOffsetGraphs then return Vector3.zero end
	local oX = pData._staticPosOffsetX or (pData.Graphs.PosOffsetX and GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.PosOffsetX, pData.Seeds.PosOffsetX)) or 0
	local oY = pData._staticPosOffsetY or (pData.Graphs.PosOffsetY and GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.PosOffsetY, pData.Seeds.PosOffsetY)) or 0
	local oZ = pData._staticPosOffsetZ or (pData.Graphs.PosOffsetZ and GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.PosOffsetZ, pData.Seeds.PosOffsetZ)) or 0
	local worldOff = Constants.resolveDisplacement(Vector3.new(oX, oY, oZ),
		pData.DisplacementMode or "Global", pData.SpawnRotation, pData.SpawnEmitterRotation,
		pData._displacementMirrorX, pData._displacementMirrorY, pData._displacementMirrorZ)
	local delta = worldOff - pData._prevWorldOff
	pData._prevWorldOff = worldOff
	return delta
end

return function(Particle)

-- Part update: position (4 branches), rotation, size, color/transparency, flipbook.
-- Branches: Inverted reads precomputed CFrames; VelocityVectored needs full per-step iteration;
-- fast paths skip ahead with no accel/drag.
function Particle:UpdatePart(pData, dt, currentTime)
	-- Signed-reverse Timescale: ts sampled at real_i (not effective i) so it progresses
	-- monotonically through keypoints regardless of effective-time direction. ts(0)<0 →
	-- particle starts at end of life and rewinds; ts(0)>=0 → starts forward.
	-- SetTimescale override (Lifecycle.luau) wins over the graph for its window.
	local real_i = math.min(math.max((currentTime - pData.StartTime) / pData.LifeTime, 0), 1)
	local ts
	if pData._tsOverride ~= nil and currentTime < (pData._tsOverrideUntil or 0) then
		ts = pData._tsOverride
	else
		ts = pData.Graphs.Timescale and GraphMod.QueryPointsWithTime(real_i, pData.Graphs.Timescale, pData.Seeds.Timescale) or 1
	end
	dt = dt * ts
	local lifeTime = pData.LifeTime
	local priorEff = pData._effectiveElapsed or 0
	local newEff = priorEff + (pData._timeFrozen and 0 or dt)
	if dt < 0 and pData._hitHistory and #pData._hitHistory > 0 then
		EventsCollision.restoreHitsOnReverse(pData, priorEff, newEff)
	end
	if newEff < 0 then newEff = 0 end
	if newEff > lifeTime then newEff = lifeTime end
	pData._effectiveElapsed = newEff
	-- After-clamp dt: boundary frames see partial step instead of overshooting.
	dt = newEff - priorEff
	pData._lastEffectiveDt = dt
	-- Particle dies when effective sits at a boundary AND the graph has finished playing.
	local atForwardEnd = newEff >= lifeTime
	local atBackwardEnd = newEff <= 0
	local elapsedTime = newEff
	local i = elapsedTime / lifeTime

	if not pData.VisualPart or not pData.VisualPart.Parent then return true end
	if pData.TotalKeyFrames <= 0 then return true end
	local graphFinished = real_i >= 1
	-- OnHit Collision=Stop (or auto-settle freeze): skip motion/step work, age normally.
	if pData._collisionStopped then return graphFinished and (atForwardEnd or atBackwardEnd) end
	local isDying = graphFinished and (atForwardEnd or atBackwardEnd)
	i = math.min(math.max(i, 0), 1)

	pData.AccumulatedDT += dt
	local targetStep = math.floor(i * pData.TotalKeyFrames)

	if targetStep ~= pData.CurrentStep then
		local prevStep = pData.CurrentStep
		local stepDir = (targetStep > prevStep) and 1 or -1
		local stepsToProcess = math.abs(targetStep - prevStep)
		local perStepDT = pData.AccumulatedDT / stepsToProcess
		local frameDT = pData.AccumulatedDT
		pData.AccumulatedDT = 0

		-- Collision spin (deg/sec) into _spinAccum (degrees); composes with both rotation modes.
		local spinRate = pData._spinRate
		if spinRate and (spinRate.X ~= 0 or spinRate.Y ~= 0 or spinRate.Z ~= 0) then
			pData._spinAccumX = (pData._spinAccumX or 0) + spinRate.X * frameDT
			pData._spinAccumY = (pData._spinAccumY or 0) + spinRate.Y * frameDT
			pData._spinAccumZ = (pData._spinAccumZ or 0) + spinRate.Z * frameDT
		end
		local speedMult = pData.SpeedMultiplier or 1

		-- POSITION: Inverted
		if pData.InvertMotion then
			pData.CurrentStep = targetStep
			local reverseStep = pData.TotalKeyFrames - targetStep
			local localCF = pData.SimLocalCFrames[reverseStep] or pData.SimLocalCFrames[0]
			local parentCF_now = getLinkCF(pData)
			pData.VisualPart.CFrame = parentCF_now * localCF
			pData._localWorldCF = localCF
			pData.CurrentPosition = pData.VisualPart.Position

		-- POSITION: Forward, FULL iteration (VelocityVectored)
		elseif pData.NeedsFullIteration then
			-- parentCF_now / dirInfo hoisted outside the loop; final CFrame written once at batch end.
			local hasDrag = pData.HasDrag
			local hasAccel = pData.HasAccel
			local parentCF_now, useVOS = getLinkCF(pData)
			local dirInfo = DirectionVectors[pData.EmissionDirection] or DirectionVectors[Enum.NormalId.Top]
			local localCF = pData.LocalCF
			local accRotX, accRotY, accRotZ = pData.AccRotX, pData.AccRotY, pData.AccRotZ
			local baseDir = pData.BaseDirection
			local accelVel = pData._accelVel or Vector3.zero
			local targetVel = pData.TargetVel
			-- Seed simPos from live VisualPart.Position (overlays moved CFrame since CurrentPosition write).
			local simPos = pData.VisualPart.Position
			local rotMode = pData.RotMode
			local rotOrder = pData.RotOrder or "Global"
			local lastWorldCF, lastLocalWorldCF
			for step = prevStep + stepDir, targetStep, stepDir do
				local si = step / pData.TotalKeyFrames
				local elapsedSec = si * pData.LifeTime

				local speed = pData._speedOverride or ((pData._staticSpeed or GraphMod.QueryPointsWithTime(si, pData.Graphs.Speed, pData.Seeds.Speed)) * speedMult)
				local draggedSpeed = hasDrag and (speed * math.exp(-pData.Drag * elapsedSec)) or speed

				local displacement
				if hasAccel then
					local effA = Constants.applyContactAccel(pData.Acceleration, pData, perStepDT)
					accelVel = accelVel + effA * perStepDT
					displacement = (baseDir * draggedSpeed + accelVel) * perStepDT
				else
					displacement = baseDir * (draggedSpeed * perStepDT)
				end

				-- Target accel: Euler integration; reads simPos for mid-substep tracking.
				if pData.HasTargetAccel then
					local tPos = getTargetPosition(pData.AccelTarget)
					if tPos then
						local toTarget = tPos - simPos
						local dist = toTarget.Magnitude
						if dist > 1e-4 then
							local mag = pData._staticAccelStrength or GraphMod.QueryPointsWithTime(si, pData.Graphs.AccelStrength, pData.Seeds.AccelStrength)
							if mag and mag ~= 0 then
								targetVel = targetVel + toTarget * (mag * perStepDT / dist)
								displacement = displacement + targetVel * perStepDT
							end
						end
					end
				end

				-- PosOffset per-step delta. Telescoping sums across the loop integrate
				-- to the correct absolute-offset change over this Heartbeat's steps.
				displacement = displacement + _posOffsetFrameDelta(pData, si)

				local parentLocalDelta = useVOS and parentCF_now:VectorToObjectSpace(displacement) or displacement
				localCF = CFrame.new(parentLocalDelta) * localCF

				local rotDamp = pData._settleRotDamp or 1
				local rotSpeedX = (pData._staticRotSpeedX or GraphMod.QueryPointsWithTime(si, pData.Graphs.RotSpeedX, pData.Seeds.RotSpeedX)) * rotDamp
				local rotSpeedY = (pData._staticRotSpeedY or GraphMod.QueryPointsWithTime(si, pData.Graphs.RotSpeedY, pData.Seeds.RotSpeedY)) * rotDamp
				local rotSpeedZ = (pData._staticRotSpeedZ or GraphMod.QueryPointsWithTime(si, pData.Graphs.RotSpeedZ, pData.Seeds.RotSpeedZ)) * rotDamp

				local rotationCFrame
				local sx = pData._spinAccumX or 0
				local sy = pData._spinAccumY or 0
				local sz = pData._spinAccumZ or 0
				if rotMode == "Speed" then
					accRotX = accRotX + rotSpeedX * perStepDT
					accRotY = accRotY + rotSpeedY * perStepDT
					accRotZ = accRotZ + rotSpeedZ * perStepDT
					rotationCFrame = Constants.composeRotation(rotOrder, accRotX + sx, accRotY + sy, accRotZ + sz)
				else
					rotationCFrame = Constants.composeRotation(rotOrder, rotSpeedX + sx, rotSpeedY + sy, rotSpeedZ + sz)
				end

				lastWorldCF = (parentCF_now * localCF) * rotationCFrame
				lastLocalWorldCF = localCF * rotationCFrame
				simPos = lastWorldCF.Position

				local rotatedCF = lastWorldCF * pData.SpreadRotation
				baseDir = rotatedCF[dirInfo.vector] * dirInfo.multiplier
			end
			pData.LocalCF = localCF
			pData.AccRotX, pData.AccRotY, pData.AccRotZ = accRotX, accRotY, accRotZ
			pData.BaseDirection = baseDir
			pData._accelVel = accelVel
			pData.TargetVel = targetVel
			pData.CurrentPosition = simPos
			pData.CurrentStep = targetStep
			if lastWorldCF then
				pData.VisualPart.CFrame = lastWorldCF
				pData._localWorldCF = lastLocalWorldCF
			end

		-- POSITION: Forward, SPEED ROTATION
		elseif pData.NeedsRotAccum then
			local hasDrag = pData.HasDrag
			local hasAccel = pData.HasAccel
			local totalScalarDisp = 0
			local totalAccelDisp = Vector3.zero
			local accelVel = pData._accelVel or Vector3.zero

			for step = prevStep + stepDir, targetStep, stepDir do
				local si = step / pData.TotalKeyFrames
				local elapsedSec = si * pData.LifeTime
				local speed = pData._speedOverride or ((pData._staticSpeed or GraphMod.QueryPointsWithTime(si, pData.Graphs.Speed, pData.Seeds.Speed)) * speedMult)
				if hasDrag then speed = speed * math.exp(-pData.Drag * elapsedSec) end
				totalScalarDisp = totalScalarDisp + speed * perStepDT
				if hasAccel then
					local effA = Constants.applyContactAccel(pData.Acceleration, pData, perStepDT)
					accelVel = accelVel + effA * perStepDT
					totalAccelDisp = totalAccelDisp + accelVel * perStepDT
				end

				local rotDamp = pData._settleRotDamp or 1
				local rotSpeedX = (pData._staticRotSpeedX or GraphMod.QueryPointsWithTime(si, pData.Graphs.RotSpeedX, pData.Seeds.RotSpeedX)) * rotDamp
				local rotSpeedY = (pData._staticRotSpeedY or GraphMod.QueryPointsWithTime(si, pData.Graphs.RotSpeedY, pData.Seeds.RotSpeedY)) * rotDamp
				local rotSpeedZ = (pData._staticRotSpeedZ or GraphMod.QueryPointsWithTime(si, pData.Graphs.RotSpeedZ, pData.Seeds.RotSpeedZ)) * rotDamp
				pData.AccRotX = pData.AccRotX + rotSpeedX * perStepDT
				pData.AccRotY = pData.AccRotY + rotSpeedY * perStepDT
				pData.AccRotZ = pData.AccRotZ + rotSpeedZ * perStepDT
			end
			pData._accelVel = accelVel

			local totalDisplacement = pData.BaseDirection * totalScalarDisp + totalAccelDisp

			-- Target accel: frame-granularity (mid-frame si).
			if pData.HasTargetAccel then
				local tPos = getTargetPosition(pData.AccelTarget)
				if tPos then
					local toTarget = tPos - pData.VisualPart.Position
					local dist = toTarget.Magnitude
					if dist > 1e-4 then
						local frameDT2 = perStepDT * (targetStep - prevStep)
						local midSI = ((prevStep + 1 + targetStep) * 0.5) / pData.TotalKeyFrames
						local mag = pData._staticAccelStrength or GraphMod.QueryPointsWithTime(midSI, pData.Graphs.AccelStrength, pData.Seeds.AccelStrength)
						if mag and mag ~= 0 then
							pData.TargetVel = pData.TargetVel + toTarget * (mag * frameDT2 / dist)
							totalDisplacement = totalDisplacement + pData.TargetVel * frameDT2
						end
					end
				end
			end

			-- PosOffsetX/Y/Z over-life position graphs. Adds the frame-delta of the
			-- current absolute offset (in world space, rotated from spawn-local) so
			-- the LocalCF accumulator naturally integrates to the final offset.
			totalDisplacement = totalDisplacement + _posOffsetFrameDelta(pData, targetStep / pData.TotalKeyFrames)

			local parentCF_now, useVOS = getLinkCF(pData)
			local parentLocalDelta = useVOS and parentCF_now:VectorToObjectSpace(totalDisplacement) or totalDisplacement
			pData.LocalCF = CFrame.new(parentLocalDelta) * pData.LocalCF
			local sx = pData._spinAccumX or 0
			local sy = pData._spinAccumY or 0
			local sz = pData._spinAccumZ or 0
			local rotationCFrame = Constants.composeRotation(pData.RotOrder or "Global", pData.AccRotX + sx, pData.AccRotY + sy, pData.AccRotZ + sz)

			pData.VisualPart.CFrame = (parentCF_now * pData.LocalCF) * rotationCFrame
			pData._localWorldCF = pData.LocalCF * rotationCFrame
			pData.CurrentPosition = pData.VisualPart.Position
			pData.CurrentStep = targetStep

		-- POSITION: Forward, FAST
		else
			local hasDrag = pData.HasDrag
			local hasAccel = pData.HasAccel
			local totalScalarDisp = 0
			local totalAccelDisp = Vector3.zero
			local accelVel = pData._accelVel or Vector3.zero

			-- Drag-free closed form: speed integral + (accelVel*Δt + 0.5*accel*Δt²).
			if not hasDrag then
				local invTKF = 1 / pData.TotalKeyFrames
				local prevT = prevStep * invTKF
				local targetT = targetStep * invTKF
				local override = pData._speedOverride
				if override then
					totalScalarDisp = override * (targetT - prevT) * pData.LifeTime
				elseif pData._staticSpeed then
					-- Constant Speed integrates to value × duration.
					totalScalarDisp = pData._staticSpeed * speedMult * (targetT - prevT) * pData.LifeTime
				else
					totalScalarDisp = pData.LifeTime * speedMult * (GraphMod.IntegrateUpTo(targetT, pData.Graphs.Speed, pData.Seeds.Speed) - GraphMod.IntegrateUpTo(prevT, pData.Graphs.Speed, pData.Seeds.Speed))
				end
				if hasAccel then
					local deltaSec = (targetT - prevT) * pData.LifeTime
					local effA = Constants.applyContactAccel(pData.Acceleration, pData, deltaSec)
					totalAccelDisp = accelVel * deltaSec + effA * (deltaSec * deltaSec * 0.5)
					accelVel = accelVel + effA * deltaSec
				end
			else
				-- Drag fallback: per-step loop.
				for step = prevStep + stepDir, targetStep, stepDir do
					local si = step / pData.TotalKeyFrames
					local elapsedSec = si * pData.LifeTime
					local speed = pData._speedOverride or ((pData._staticSpeed or GraphMod.QueryPointsWithTime(si, pData.Graphs.Speed, pData.Seeds.Speed)) * speedMult)
					speed = speed * math.exp(-pData.Drag * elapsedSec)
					totalScalarDisp = totalScalarDisp + speed * perStepDT
					if hasAccel then
						local effA = Constants.applyContactAccel(pData.Acceleration, pData, perStepDT)
						accelVel = accelVel + effA * perStepDT
						totalAccelDisp = totalAccelDisp + accelVel * perStepDT
					end
				end
			end
			pData._accelVel = accelVel

			local totalDisplacement = pData.BaseDirection * totalScalarDisp + totalAccelDisp

			-- Target accel: frame-granularity sample.
			if pData.HasTargetAccel then
				local tPos = getTargetPosition(pData.AccelTarget)
				if tPos then
					local toTarget = tPos - pData.VisualPart.Position
					local dist = toTarget.Magnitude
					if dist > 1e-4 then
						local frameDT = perStepDT * (targetStep - prevStep)
						local midSI = ((prevStep + 1 + targetStep) * 0.5) / pData.TotalKeyFrames
						local mag = pData._staticAccelStrength or GraphMod.QueryPointsWithTime(midSI, pData.Graphs.AccelStrength, pData.Seeds.AccelStrength)
						if mag and mag ~= 0 then
							pData.TargetVel = pData.TargetVel + toTarget * (mag * frameDT / dist)
							totalDisplacement = totalDisplacement + pData.TargetVel * frameDT
						end
					end
				end
			end

			-- PosOffsetX/Y/Z over-life position graphs (see helper at top of file).
			totalDisplacement = totalDisplacement + _posOffsetFrameDelta(pData, targetStep / pData.TotalKeyFrames)

			local parentCF_now, useVOS = getLinkCF(pData)
			local parentLocalDelta = useVOS and parentCF_now:VectorToObjectSpace(totalDisplacement) or totalDisplacement
			pData.LocalCF = CFrame.new(parentLocalDelta) * pData.LocalCF

			local steppedI = targetStep / pData.TotalKeyFrames
			local rotDamp = pData._settleRotDamp or 1
			local rotX = (pData._staticRotSpeedX or GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.RotSpeedX, pData.Seeds.RotSpeedX)) * rotDamp + (pData._spinAccumX or 0)
			local rotY = (pData._staticRotSpeedY or GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.RotSpeedY, pData.Seeds.RotSpeedY)) * rotDamp + (pData._spinAccumY or 0)
			local rotZ = (pData._staticRotSpeedZ or GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.RotSpeedZ, pData.Seeds.RotSpeedZ)) * rotDamp + (pData._spinAccumZ or 0)
			local rotationCFrame = Constants.composeRotation(pData.RotOrder or "Global", rotX, rotY, rotZ)

			pData.VisualPart.CFrame = (parentCF_now * pData.LocalCF) * rotationCFrame
			pData._localWorldCF = pData.LocalCF * rotationCFrame
			pData.CurrentPosition = pData.VisualPart.Position
			pData.CurrentStep = targetStep
		end

		-- SIZE  -  gated by pData.SkipSize (set via payload.SetSkipSize).
		local steppedI = targetStep / pData.TotalKeyFrames
		if not pData.SkipSize then
			local sizex = pData._staticSizeX or GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.SizeX, pData.Seeds.SizeX)
			local sizey = pData._staticSizeY or GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.SizeY, pData.Seeds.SizeY)
			local sizez = pData._staticSizeZ or GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.SizeZ, pData.Seeds.SizeZ)

			if pData.ParentScale then
				local ps = pData.ParentScale
				local pI = math.clamp((currentTime - ps.StartTime) / ps.LifeTime, 0, 1)
				local pFactor = math.max(0.001, GraphMod.QueryPointsWithTime(pI, ps.Graph, ps.Seed))
				sizex = sizex * pFactor
				sizey = sizey * pFactor
				sizez = sizez * pFactor
			end

			if pData.SpecialMesh then
				pData.SpecialMesh.Scale = Vector3.new(sizex, sizey, sizez)
			else
				pData.VisualPart.Size = Vector3.new(sizex, sizey, sizez)
			end
		end

		-- VISUAL
		local transparency = pData._staticTransparency or GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.Transparency, pData.Seeds.Transparency)

		if pData.SurfaceAppearance then
			-- Color graph tints SA.Color raw; Brightness graph drives SA.EmissiveTint only.
			-- EmissiveTint write pcall-guarded for older Studio builds without the property.
			local brightness = pData._staticBrightness or GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.Brightness, pData.Seeds.Brightness)
			local color = GraphMod.QueryColorPointWithTime(steppedI, pData.Graphs.Color)
			if not pData.SkipTransparency then pData.VisualPart.Transparency = transparency end
			if not pData.SkipColor then
				pData.VisualPart.Color = Color3.fromRGB(color.R * 255, color.G * 255, color.B * 255)
				pData.SurfaceAppearance.Color = Color3.fromRGB(color.R * 255, color.G * 255, color.B * 255)
				pcall(function() pData.SurfaceAppearance.EmissiveTint = Color3.new(color.R * brightness, color.G * brightness, color.B * brightness) end)
			end
		elseif pData.HasDecal then
			local brightness = pData._staticBrightness or GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.Brightness, pData.Seeds.Brightness)
			local color = GraphMod.QueryColorPointWithTime(steppedI, pData.Graphs.Color)
			if not pData.SkipTransparency then pData.Decal.Transparency = transparency end
			if not pData.SkipColor then pData.Decal.Color3 = Color3.fromRGB(color.R * 255 * brightness, color.G * 255 * brightness, color.B * 255 * brightness) end
		else
			-- Plain MeshPart: Brightness multiplies SA/Decal only, not mesh Color.
			local color = GraphMod.QueryColorPointWithTime(steppedI, pData.Graphs.Color)
			if not pData.SkipTransparency then pData.VisualPart.Transparency = transparency end
			if not pData.SkipColor then pData.VisualPart.Color = Color3.fromRGB(color.R * 255, color.G * 255, color.B * 255) end
		end
	end

	return isDying
end

-- Attachment update: parent-local motion. No Size graph (Attachments drive child instances).
function Particle:UpdateAttachment(pData, dt, currentTime)
	-- Signed-reverse Timescale: see UpdatePart. SetTimescale override wins for its window.
	local real_i = math.min(math.max((currentTime - pData.StartTime) / pData.LifeTime, 0), 1)
	local ts
	if pData._tsOverride ~= nil and currentTime < (pData._tsOverrideUntil or 0) then
		ts = pData._tsOverride
	else
		ts = pData.Graphs.Timescale and GraphMod.QueryPointsWithTime(real_i, pData.Graphs.Timescale, pData.Seeds.Timescale) or 1
	end
	dt = dt * ts
	local lifeTime = pData.LifeTime
	local priorEff = pData._effectiveElapsed or 0
	local newEff = priorEff + (pData._timeFrozen and 0 or dt)
	if dt < 0 and pData._hitHistory and #pData._hitHistory > 0 then
		EventsCollision.restoreHitsOnReverse(pData, priorEff, newEff)
	end
	if newEff < 0 then newEff = 0 end
	if newEff > lifeTime then newEff = lifeTime end
	pData._effectiveElapsed = newEff
	-- After-clamp dt: boundary frames see partial step instead of overshooting.
	dt = newEff - priorEff
	pData._lastEffectiveDt = dt
	local atForwardEnd = newEff >= lifeTime
	local atBackwardEnd = newEff <= 0
	local elapsedTime = newEff
	local i = elapsedTime / lifeTime
	if not pData.VisualPart or not pData.VisualPart.Parent then return true end
	if pData.TotalKeyFrames <= 0 then return true end
	local graphFinished = real_i >= 1
	if pData._collisionStopped then return graphFinished and (atForwardEnd or atBackwardEnd) end
	local isDying = graphFinished and (atForwardEnd or atBackwardEnd)
	i = math.min(math.max(i, 0), 1)
	pData.AccumulatedDT += dt
	local targetStep = math.floor(i * pData.TotalKeyFrames)

	if targetStep ~= pData.CurrentStep then
		local prevStep = pData.CurrentStep
		local stepDir = (targetStep > prevStep) and 1 or -1
		local stepsToProcess = math.abs(targetStep - prevStep)
		local perStepDT = pData.AccumulatedDT / stepsToProcess
		local frameDT = pData.AccumulatedDT
		pData.AccumulatedDT = 0
		local spinRate = pData._spinRate
		if spinRate and (spinRate.X ~= 0 or spinRate.Y ~= 0 or spinRate.Z ~= 0) then
			pData._spinAccumX = (pData._spinAccumX or 0) + spinRate.X * frameDT
			pData._spinAccumY = (pData._spinAccumY or 0) + spinRate.Y * frameDT
			pData._spinAccumZ = (pData._spinAccumZ or 0) + spinRate.Z * frameDT
		end
		local speedMult = pData.SpeedMultiplier or 1

		-- actualParent-local link CFrame; identity when no link.
		local parentCF_now, useVOS = getAttachmentLinkCF(pData)

		if pData.InvertMotion then
			pData.CurrentStep = targetStep
			local reverseStep = pData.TotalKeyFrames - targetStep
			local localCF = pData.SimLocalCFrames[reverseStep] or pData.SimLocalCFrames[0]
			pData.VisualPart.CFrame = parentCF_now * localCF
			pData.LocalCF = localCF
			pData._localWorldCF = localCF

		-- POSITION: Forward, FULL iteration (VelocityVectored)
		elseif pData.NeedsFullIteration then
			local hasDrag = pData.HasDrag
			local hasAccel = pData.HasAccel
			local accelVel = pData._accelVel or Vector3.zero
			local sx = pData._spinAccumX or 0
			local sy = pData._spinAccumY or 0
			local sz = pData._spinAccumZ or 0
			local rotOrder = pData.RotOrder or "Global"
			for step = prevStep + stepDir, targetStep, stepDir do
				local si = step / pData.TotalKeyFrames
				local elapsedSec = si * pData.LifeTime

				local speed = pData._speedOverride or ((pData._staticSpeed or GraphMod.QueryPointsWithTime(si, pData.Graphs.Speed, pData.Seeds.Speed)) * speedMult)
				local draggedSpeed = hasDrag and (speed * math.exp(-pData.Drag * elapsedSec)) or speed

				local displacement
				if hasAccel then
					local effA = Constants.applyContactAccel(pData.Acceleration, pData, perStepDT)
					accelVel = accelVel + effA * perStepDT
					displacement = (pData.BaseDirection * draggedSpeed + accelVel) * perStepDT
				else
					displacement = pData.BaseDirection * (draggedSpeed * perStepDT)
				end

				-- PosOffset per-step delta. Telescoping integration across loop iterations.
				displacement = displacement + _posOffsetFrameDelta(pData, si)

				-- Weld/WeldWithoutRotation: rotate displacement from world into link-local before stacking onto LocalCF.
				local stepDelta = useVOS and parentCF_now:VectorToObjectSpace(displacement) or displacement
				pData.LocalCF = CFrame.new(stepDelta) * pData.LocalCF

				-- Rotation
				local rotDamp = pData._settleRotDamp or 1
				local rotSpeedX = (pData._staticRotSpeedX or GraphMod.QueryPointsWithTime(si, pData.Graphs.RotSpeedX, pData.Seeds.RotSpeedX)) * rotDamp
				local rotSpeedY = (pData._staticRotSpeedY or GraphMod.QueryPointsWithTime(si, pData.Graphs.RotSpeedY, pData.Seeds.RotSpeedY)) * rotDamp
				local rotSpeedZ = (pData._staticRotSpeedZ or GraphMod.QueryPointsWithTime(si, pData.Graphs.RotSpeedZ, pData.Seeds.RotSpeedZ)) * rotDamp

				local rotationCFrame
				if pData.RotMode == "Speed" then
					pData.AccRotX = pData.AccRotX + rotSpeedX * perStepDT
					pData.AccRotY = pData.AccRotY + rotSpeedY * perStepDT
					pData.AccRotZ = pData.AccRotZ + rotSpeedZ * perStepDT
					rotationCFrame = Constants.composeRotation(rotOrder, pData.AccRotX + sx, pData.AccRotY + sy, pData.AccRotZ + sz)
				else
					rotationCFrame = Constants.composeRotation(rotOrder, rotSpeedX + sx, rotSpeedY + sy, rotSpeedZ + sz)
				end

				pData.VisualPart.CFrame = parentCF_now * pData.LocalCF * rotationCFrame
				pData._localWorldCF = pData.LocalCF * rotationCFrame

				local rotatedCF = pData.VisualPart.CFrame * pData.SpreadRotation
				local dirInfo = DirectionVectors[pData.EmissionDirection] or DirectionVectors[Enum.NormalId.Top]
				pData.BaseDirection = rotatedCF[dirInfo.vector] * dirInfo.multiplier
			end
			pData._accelVel = accelVel
			pData.CurrentStep = targetStep

		-- POSITION: Forward, SPEED ROTATION
		elseif pData.NeedsRotAccum then
			local hasDrag = pData.HasDrag
			local hasAccel = pData.HasAccel
			local totalScalarDisp = 0
			local totalAccelDisp = Vector3.zero
			local accelVel = pData._accelVel or Vector3.zero

			for step = prevStep + stepDir, targetStep, stepDir do
				local si = step / pData.TotalKeyFrames
				local elapsedSec = si * pData.LifeTime
				local speed = pData._speedOverride or ((pData._staticSpeed or GraphMod.QueryPointsWithTime(si, pData.Graphs.Speed, pData.Seeds.Speed)) * speedMult)
				if hasDrag then speed = speed * math.exp(-pData.Drag * elapsedSec) end
				totalScalarDisp = totalScalarDisp + speed * perStepDT
				if hasAccel then
					local effA = Constants.applyContactAccel(pData.Acceleration, pData, perStepDT)
					accelVel = accelVel + effA * perStepDT
					totalAccelDisp = totalAccelDisp + accelVel * perStepDT
				end

				local rotDamp = pData._settleRotDamp or 1
				local rotSpeedX = (pData._staticRotSpeedX or GraphMod.QueryPointsWithTime(si, pData.Graphs.RotSpeedX, pData.Seeds.RotSpeedX)) * rotDamp
				local rotSpeedY = (pData._staticRotSpeedY or GraphMod.QueryPointsWithTime(si, pData.Graphs.RotSpeedY, pData.Seeds.RotSpeedY)) * rotDamp
				local rotSpeedZ = (pData._staticRotSpeedZ or GraphMod.QueryPointsWithTime(si, pData.Graphs.RotSpeedZ, pData.Seeds.RotSpeedZ)) * rotDamp
				pData.AccRotX = pData.AccRotX + rotSpeedX * perStepDT
				pData.AccRotY = pData.AccRotY + rotSpeedY * perStepDT
				pData.AccRotZ = pData.AccRotZ + rotSpeedZ * perStepDT
			end
			pData._accelVel = accelVel

			local totalDisplacement = pData.BaseDirection * totalScalarDisp + totalAccelDisp
			totalDisplacement = totalDisplacement + _posOffsetFrameDelta(pData, targetStep / pData.TotalKeyFrames)

			local stepDelta = useVOS and parentCF_now:VectorToObjectSpace(totalDisplacement) or totalDisplacement
			pData.LocalCF = CFrame.new(stepDelta) * pData.LocalCF
			local sx = pData._spinAccumX or 0
			local sy = pData._spinAccumY or 0
			local sz = pData._spinAccumZ or 0
			local rotationCFrame = Constants.composeRotation(pData.RotOrder or "Global", pData.AccRotX + sx, pData.AccRotY + sy, pData.AccRotZ + sz)

			pData.VisualPart.CFrame = parentCF_now * pData.LocalCF * rotationCFrame
			pData._localWorldCF = pData.LocalCF * rotationCFrame
			pData.CurrentStep = targetStep

		-- POSITION: Forward, FAST
		else
			local hasDrag = pData.HasDrag
			local hasAccel = pData.HasAccel
			local totalScalarDisp = 0
			local totalAccelDisp = Vector3.zero
			local accelVel = pData._accelVel or Vector3.zero

			-- Drag-free closed form: speed integral + (accelVel*Δt + 0.5*accel*Δt²).
			if not hasDrag then
				local invTKF = 1 / pData.TotalKeyFrames
				local prevT = prevStep * invTKF
				local targetT = targetStep * invTKF
				local override = pData._speedOverride
				if override then
					totalScalarDisp = override * (targetT - prevT) * pData.LifeTime
				elseif pData._staticSpeed then
					-- Constant Speed integrates to value × duration.
					totalScalarDisp = pData._staticSpeed * speedMult * (targetT - prevT) * pData.LifeTime
				else
					totalScalarDisp = pData.LifeTime * speedMult * (GraphMod.IntegrateUpTo(targetT, pData.Graphs.Speed, pData.Seeds.Speed) - GraphMod.IntegrateUpTo(prevT, pData.Graphs.Speed, pData.Seeds.Speed))
				end
				if hasAccel then
					local deltaSec = (targetT - prevT) * pData.LifeTime
					local effA = Constants.applyContactAccel(pData.Acceleration, pData, deltaSec)
					totalAccelDisp = accelVel * deltaSec + effA * (deltaSec * deltaSec * 0.5)
					accelVel = accelVel + effA * deltaSec
				end
			else
				for step = prevStep + stepDir, targetStep, stepDir do
					local si = step / pData.TotalKeyFrames
					local elapsedSec = si * pData.LifeTime
					local speed = pData._speedOverride or ((pData._staticSpeed or GraphMod.QueryPointsWithTime(si, pData.Graphs.Speed, pData.Seeds.Speed)) * speedMult)
					speed = speed * math.exp(-pData.Drag * elapsedSec)
					totalScalarDisp = totalScalarDisp + speed * perStepDT
					if hasAccel then
						local effA = Constants.applyContactAccel(pData.Acceleration, pData, perStepDT)
						accelVel = accelVel + effA * perStepDT
						totalAccelDisp = totalAccelDisp + accelVel * perStepDT
					end
				end
			end
			pData._accelVel = accelVel

			local totalDisplacement = pData.BaseDirection * totalScalarDisp + totalAccelDisp
			totalDisplacement = totalDisplacement + _posOffsetFrameDelta(pData, targetStep / pData.TotalKeyFrames)

			local stepDelta = useVOS and parentCF_now:VectorToObjectSpace(totalDisplacement) or totalDisplacement
			pData.LocalCF = CFrame.new(stepDelta) * pData.LocalCF

			local steppedI = targetStep / pData.TotalKeyFrames
			local rotDamp = pData._settleRotDamp or 1
			local rotX = (pData._staticRotSpeedX or GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.RotSpeedX, pData.Seeds.RotSpeedX)) * rotDamp + (pData._spinAccumX or 0)
			local rotY = (pData._staticRotSpeedY or GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.RotSpeedY, pData.Seeds.RotSpeedY)) * rotDamp + (pData._spinAccumY or 0)
			local rotZ = (pData._staticRotSpeedZ or GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.RotSpeedZ, pData.Seeds.RotSpeedZ)) * rotDamp + (pData._spinAccumZ or 0)
			local rotationCFrame = Constants.composeRotation(pData.RotOrder or "Global", rotX, rotY, rotZ)

			pData.VisualPart.CFrame = parentCF_now * pData.LocalCF * rotationCFrame
			pData._localWorldCF = pData.LocalCF * rotationCFrame
			pData.CurrentStep = targetStep
		end
	end

	return isDying
end

end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">UpdateBeam</string>
              <string name="Source"><![CDATA[--[[
	UpdateBeam Mixin  -  per-frame update for Beam particles (no spatial motion).
	GraphBlender lerps between authored Transparency/Color states; pair-index cached for O(1) search.
	Animate-loop reset must clear _lastTransIdx/_lastColorIdx (init.luau handles this).
	TextureSpeed uses integral-based offset (engine's rate-accumulator is FPS-dependent).
	ParentScale multiplies Width/CurveSize/TextureLength/Segments by nested-Model scale factor.
]]

local GraphMod = require(script.Parent.Graph)

return function(Particle)

-- Per-frame update for a Beam-typed particle (`pData`). Advances effective elapsed,
-- writes Width0/1, Color, Transparency from authored graphs + GraphBlender states.
-- Returns true when the particle has died.
function Particle:UpdateBeam(pData, dt, currentTime)
	-- Signed-reverse Timescale: see Update.luau UpdatePart. SetTimescale override wins for its window.
	local real_i = math.min(math.max((currentTime - pData.StartTime) / pData.LifeTime, 0), 1)
	local ts
	if pData._tsOverride ~= nil and currentTime < (pData._tsOverrideUntil or 0) then
		ts = pData._tsOverride
	else
		ts = pData.Graphs.Timescale and GraphMod.QueryPointsWithTime(real_i, pData.Graphs.Timescale, pData.Seeds.Timescale) or 1
	end
	local dtTs = dt * ts
	local lifeTime = pData.LifeTime
	local priorEff = pData._effectiveElapsed or 0
	local newEff = priorEff + (pData._timeFrozen and 0 or dtTs)
	if newEff < 0 then newEff = 0 end
	if newEff > lifeTime then newEff = lifeTime end
	pData._effectiveElapsed = newEff
	local atForwardEnd = newEff >= lifeTime
	local atBackwardEnd = newEff <= 0
	local elapsedTime = newEff
	local i = elapsedTime / lifeTime

	if not pData.VisualPart or not pData.VisualPart.Parent then return true end
	local graphFinished = real_i >= 1
	local isDying = graphFinished and (atForwardEnd or atBackwardEnd)
	i = math.min(math.max(i, 0), 1)

	-- Continuous-time, FPS-independent.
	local t = i

	local transStates = pData.TransStates
	local colorStates = pData.ColorStates

	-- Transparency blender
	if not pData.SkipTransparency then
		if transStates and #transStates >= 2 then
			local lastTrans = pData._lastTransIdx or 1
			-- Reverse-Timescale support: rescan from start when t dropped below cached pair's lower bound.
			if t < transStates[lastTrans].Time then lastTrans = 1 end
			local pairIdx = #transStates - 1
			for idx = lastTrans, #transStates - 1 do
				if t >= transStates[idx].Time and t <= transStates[idx + 1].Time then
					pairIdx = idx; break
				end
			end
			pData._lastTransIdx = pairIdx
			local lower = transStates[pairIdx]
			local upper = transStates[pairIdx + 1] or transStates[#transStates]
			local range = upper.Time - lower.Time
			local segmentAlpha = range > 0 and ((t - lower.Time) / range) or 0
			local mergedTimes = pData.TransMergedTimes[pairIdx]
			if mergedTimes then
				pData.VisualPart.Transparency = GraphMod.LerpGraphFast(lower.Graph, upper.Graph, segmentAlpha, mergedTimes)
			else
				pData.VisualPart.Transparency = GraphMod.LerpGraph(lower.Graph, upper.Graph, segmentAlpha)
			end
		elseif transStates and #transStates == 1 then
			pData.VisualPart.Transparency = transStates[1].Graph
		end
	end

	-- Color blender
	if not pData.SkipColor then
		if colorStates and #colorStates >= 2 then
			local lastColor = pData._lastColorIdx or 1
			if t < colorStates[lastColor].Time then lastColor = 1 end
			local pairIdx = #colorStates - 1
			for idx = lastColor, #colorStates - 1 do
				if t >= colorStates[idx].Time and t <= colorStates[idx + 1].Time then
					pairIdx = idx; break
				end
			end
			pData._lastColorIdx = pairIdx
			local lower = colorStates[pairIdx]
			local upper = colorStates[pairIdx + 1] or colorStates[#colorStates]
			local range = upper.Time - lower.Time
			local segmentAlpha = range > 0 and ((t - lower.Time) / range) or 0
			local mergedTimes = pData.ColorMergedTimes[pairIdx]
			if mergedTimes then
				pData.VisualPart.Color = GraphMod.LerpColorGraphFast(lower.Graph, upper.Graph, segmentAlpha, mergedTimes)
			else
				pData.VisualPart.Color = GraphMod.LerpColorGraph(lower.Graph, upper.Graph, segmentAlpha)
			end
		elseif colorStates and #colorStates == 1 then
			pData.VisualPart.Color = colorStates[1].Graph
		end
	end

	-- TextureSpeed: integral-based offset for FPS independence.
	local tsAnim = pData.AnimatedProps.TextureSpeed
	if tsAnim then
		local integral = GraphMod.IntegrateUpTo(t, tsAnim.Sequence, tsAnim.Seed)
		pData.VisualPart:SetTextureOffset((-integral * pData.LifeTime) % 1)
	end

	-- Other animated beam properties (Width0, Width1, CurveSize, etc.)
	for name, animData in pairs(pData.AnimatedProps) do
		if name ~= "TextureSpeed" then
			local val = GraphMod.QueryPointsWithTime(t, animData.Sequence, animData.Seed)
			if name == "Segments" then val = math.max(20, math.round(val)) end
			pData.VisualPart[name] = val
		end
	end

	-- Parent model scale (nested beams)
	if pData.ParentScale then
		local ps = pData.ParentScale
		local pI = math.clamp((currentTime - ps.StartTime) / ps.LifeTime, 0, 1)
		local pFactor = math.max(0.001, GraphMod.QueryPointsWithTime(pI, ps.Graph, ps.Seed))
		local vb = pData.VisualPart
		local ap = pData.AnimatedProps
		vb.Width0 = (ap.Width0 and vb.Width0 or pData._baseWidth0) * pFactor
		vb.Width1 = (ap.Width1 and vb.Width1 or pData._baseWidth1) * pFactor
		vb.CurveSize0 = (ap.CurveSize0 and vb.CurveSize0 or pData._baseCurveSize0) * pFactor
		vb.CurveSize1 = (ap.CurveSize1 and vb.CurveSize1 or pData._baseCurveSize1) * pFactor
		-- TextureLength multiplies (preserves tile count as beam scales) when Model's
		-- ScaleTextureLength attribute is true (default). False leaves authored value
		-- so tiles repeat more densely as beam grows.
		if ps.ScaleTextureLength ~= false then
			vb.TextureLength = (ap.TextureLength and vb.TextureLength or pData._baseTextureLength) * pFactor
		end
		vb.Segments = math.max(20, math.round((ap.Segments and vb.Segments or pData._baseSegments) * pFactor))
	end

	return isDying
end

end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">UpdateModel</string>
              <string name="Source"><![CDATA[--[[
	UpdateModel Mixin  -  per-frame update for Model particles.
	Same motion branches as UpdatePart; uses :PivotTo for position and :ScaleTo for size.
]]

local GraphMod = require(script.Parent.Graph)
local Constants = require(script.Parent.PartConstants)
local EventsCollision = require(script.Parent.EventsCollision)
local DirectionVectors = Constants.DirectionVectors

-- PosOffsetX/Y/Z over-life graph → per-frame delta added to displacement.
-- Routes through Constants.resolveDisplacement so DisplacementMode (Global / Local /
-- RigidLocal) + OnHit mirror axes apply uniformly with the Part / Attachment path
-- in Update.luau:_posOffsetFrameDelta.
local function _posOffsetFrameDelta(pData, steppedI)
	if not pData.HasPosOffsetGraphs then return Vector3.zero end
	local oX = pData._staticPosOffsetX or (pData.Graphs.PosOffsetX and GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.PosOffsetX, pData.Seeds.PosOffsetX)) or 0
	local oY = pData._staticPosOffsetY or (pData.Graphs.PosOffsetY and GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.PosOffsetY, pData.Seeds.PosOffsetY)) or 0
	local oZ = pData._staticPosOffsetZ or (pData.Graphs.PosOffsetZ and GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.PosOffsetZ, pData.Seeds.PosOffsetZ)) or 0
	local worldOff = Constants.resolveDisplacement(Vector3.new(oX, oY, oZ),
		pData.DisplacementMode or "Global", pData.SpawnRotation, pData.SpawnEmitterRotation,
		pData._displacementMirrorX, pData._displacementMirrorY, pData._displacementMirrorZ)
	local delta = worldOff - pData._prevWorldOff
	pData._prevWorldOff = worldOff
	return delta
end

-- Routes through Constants.resolveLinkCFrame for Model + Bone link targets.
local function getLinkCF(pData)
	local lk = pData.Link
	if not (lk and lk.Parent) then return CFrame.new(), false end
	local worldCF = Constants.resolveLinkCFrame(lk)
	if pData.LinkMode == "Follow" or pData.LinkMode == "Pivot" then
		return CFrame.new(worldCF.Position), false
	end
	return worldCF, true
end

return function(Particle)

-- Per-frame update for a Model-typed particle (`pData`). Advances effective elapsed,
-- writes the new pivot via :PivotTo, applies scale + flipbook. Returns true when the
-- particle has died (consumed by Engine.luau's swap-and-pop loop).
function Particle:UpdateModel(pData, dt, currentTime)
	-- Signed-reverse Timescale: see Update.luau UpdatePart. SetTimescale override wins for its window.
	local real_i = math.min(math.max((currentTime - pData.StartTime) / pData.LifeTime, 0), 1)
	local ts
	if pData._tsOverride ~= nil and currentTime < (pData._tsOverrideUntil or 0) then
		ts = pData._tsOverride
	else
		ts = pData.Graphs.Timescale and GraphMod.QueryPointsWithTime(real_i, pData.Graphs.Timescale, pData.Seeds.Timescale) or 1
	end
	dt = dt * ts
	local lifeTime = pData.LifeTime
	local priorEff = pData._effectiveElapsed or 0
	local newEff = priorEff + (pData._timeFrozen and 0 or dt)
	if dt < 0 and pData._hitHistory and #pData._hitHistory > 0 then
		EventsCollision.restoreHitsOnReverse(pData, priorEff, newEff)
	end
	if newEff < 0 then newEff = 0 end
	if newEff > lifeTime then newEff = lifeTime end
	pData._effectiveElapsed = newEff
	-- After-clamp dt: boundary frames see partial step instead of overshooting.
	dt = newEff - priorEff
	pData._lastEffectiveDt = dt
	local atForwardEnd = newEff >= lifeTime
	local atBackwardEnd = newEff <= 0
	local elapsedTime = newEff
	local i = elapsedTime / lifeTime

	if not pData.VisualPart or not pData.VisualPart.Parent then return true end
	if pData.TotalKeyFrames <= 0 then return true end
	local graphFinished = real_i >= 1
	if pData._collisionStopped then return graphFinished and (atForwardEnd or atBackwardEnd) end
	local isDying = graphFinished and (atForwardEnd or atBackwardEnd)
	i = math.min(math.max(i, 0), 1)

	pData.AccumulatedDT += dt
	local targetStep = math.floor(i * pData.TotalKeyFrames)

	if targetStep ~= pData.CurrentStep then
		local prevStep = pData.CurrentStep
		local stepDir = (targetStep > prevStep) and 1 or -1
		local stepsToProcess = math.abs(targetStep - prevStep)
		local frameDT = pData.AccumulatedDT
		local perStepDT = frameDT / stepsToProcess
		pData.AccumulatedDT = 0

		-- Collision spin: angular velocity (deg/sec) into per-axis accumulators.
		local spinRate = pData._spinRate
		if spinRate and (spinRate.X ~= 0 or spinRate.Y ~= 0 or spinRate.Z ~= 0) then
			pData._spinAccumX = (pData._spinAccumX or 0) + spinRate.X * frameDT
			pData._spinAccumY = (pData._spinAccumY or 0) + spinRate.Y * frameDT
			pData._spinAccumZ = (pData._spinAccumZ or 0) + spinRate.Z * frameDT
		end
		local speedMult = pData.SpeedMultiplier or 1
		local spinAddX = pData._spinAccumX or 0
		local spinAddY = pData._spinAccumY or 0
		local spinAddZ = pData._spinAccumZ or 0
		local rotOrder = pData.RotOrder or "Global"

		-- POSITION: Inverted
		if pData.InvertMotion then
			pData.CurrentStep = targetStep
			local reverseStep = pData.TotalKeyFrames - targetStep
			local localCF = pData.SimLocalCFrames[reverseStep] or pData.SimLocalCFrames[0]
			local parentCF_now = getLinkCF(pData)
			pData.VisualPart:PivotTo(parentCF_now * localCF)
			pData._localWorldCF = localCF
			pData.CurrentPosition = pData.VisualPart:GetPivot().Position

		-- POSITION: Forward, FULL iteration (VelocityVectored)
		elseif pData.NeedsFullIteration then
			local hasDrag = pData.HasDrag
			local hasAccel = pData.HasAccel
			local accelVel = pData._accelVel or Vector3.zero
			for step = prevStep + stepDir, targetStep, stepDir do
				local si = step / pData.TotalKeyFrames
				local elapsedSec = si * pData.LifeTime

				local speed = pData._speedOverride or ((pData._staticSpeed or GraphMod.QueryPointsWithTime(si, pData.Graphs.Speed, pData.Seeds.Speed)) * speedMult)
				local draggedSpeed = hasDrag and (speed * math.exp(-pData.Drag * elapsedSec)) or speed

				local displacement
				if hasAccel then
					local effA = Constants.applyContactAccel(pData.Acceleration, pData, perStepDT)
					accelVel = accelVel + effA * perStepDT
					displacement = (pData.BaseDirection * draggedSpeed + accelVel) * perStepDT
				else
					displacement = pData.BaseDirection * (draggedSpeed * perStepDT)
				end

				-- PosOffset per-step delta. Telescoping integration across loop iterations.
				displacement = displacement + _posOffsetFrameDelta(pData, si)

				local parentCF_now, useVOS = getLinkCF(pData)
				local parentLocalDelta = useVOS and parentCF_now:VectorToObjectSpace(displacement) or displacement
				pData.LocalCF = CFrame.new(parentLocalDelta) * pData.LocalCF

				local rotDamp = pData._settleRotDamp or 1
				local rotSpeedX = (pData._staticRotSpeedX or GraphMod.QueryPointsWithTime(si, pData.Graphs.RotSpeedX, pData.Seeds.RotSpeedX)) * rotDamp
				local rotSpeedY = (pData._staticRotSpeedY or GraphMod.QueryPointsWithTime(si, pData.Graphs.RotSpeedY, pData.Seeds.RotSpeedY)) * rotDamp
				local rotSpeedZ = (pData._staticRotSpeedZ or GraphMod.QueryPointsWithTime(si, pData.Graphs.RotSpeedZ, pData.Seeds.RotSpeedZ)) * rotDamp

				local rotationCFrame
				if pData.RotMode == "Speed" then
					pData.AccRotX = pData.AccRotX + rotSpeedX * perStepDT
					pData.AccRotY = pData.AccRotY + rotSpeedY * perStepDT
					pData.AccRotZ = pData.AccRotZ + rotSpeedZ * perStepDT
					rotationCFrame = Constants.composeRotation(rotOrder, pData.AccRotX + spinAddX, pData.AccRotY + spinAddY, pData.AccRotZ + spinAddZ)
				else
					rotationCFrame = Constants.composeRotation(rotOrder, rotSpeedX + spinAddX, rotSpeedY + spinAddY, rotSpeedZ + spinAddZ)
				end

				pData.VisualPart:PivotTo((parentCF_now * pData.LocalCF) * rotationCFrame)
				pData._localWorldCF = pData.LocalCF * rotationCFrame
				pData.CurrentPosition = pData.VisualPart:GetPivot().Position

				local rotatedCF = pData.VisualPart:GetPivot() * pData.SpreadRotation
				local dirInfo = DirectionVectors[pData.EmissionDirection] or DirectionVectors[Enum.NormalId.Top]
				pData.BaseDirection = rotatedCF[dirInfo.vector] * dirInfo.multiplier
			end
			pData._accelVel = accelVel
			pData.CurrentStep = targetStep

		-- POSITION: Forward, SPEED ROTATION (accumulated rotation)
		elseif pData.NeedsRotAccum then
			local hasDrag = pData.HasDrag
			local hasAccel = pData.HasAccel
			local totalScalarDisp = 0
			local totalAccelDisp = Vector3.zero
			local accelVel = pData._accelVel or Vector3.zero

			for step = prevStep + stepDir, targetStep, stepDir do
				local si = step / pData.TotalKeyFrames
				local elapsedSec = si * pData.LifeTime
				local speed = pData._speedOverride or ((pData._staticSpeed or GraphMod.QueryPointsWithTime(si, pData.Graphs.Speed, pData.Seeds.Speed)) * speedMult)
				if hasDrag then speed = speed * math.exp(-pData.Drag * elapsedSec) end
				totalScalarDisp = totalScalarDisp + speed * perStepDT
				if hasAccel then
					local effA = Constants.applyContactAccel(pData.Acceleration, pData, perStepDT)
					accelVel = accelVel + effA * perStepDT
					totalAccelDisp = totalAccelDisp + accelVel * perStepDT
				end

				local rotDamp = pData._settleRotDamp or 1
				local rotSpeedX = (pData._staticRotSpeedX or GraphMod.QueryPointsWithTime(si, pData.Graphs.RotSpeedX, pData.Seeds.RotSpeedX)) * rotDamp
				local rotSpeedY = (pData._staticRotSpeedY or GraphMod.QueryPointsWithTime(si, pData.Graphs.RotSpeedY, pData.Seeds.RotSpeedY)) * rotDamp
				local rotSpeedZ = (pData._staticRotSpeedZ or GraphMod.QueryPointsWithTime(si, pData.Graphs.RotSpeedZ, pData.Seeds.RotSpeedZ)) * rotDamp
				pData.AccRotX = pData.AccRotX + rotSpeedX * perStepDT
				pData.AccRotY = pData.AccRotY + rotSpeedY * perStepDT
				pData.AccRotZ = pData.AccRotZ + rotSpeedZ * perStepDT
			end
			pData._accelVel = accelVel

			local totalDisplacement = pData.BaseDirection * totalScalarDisp + totalAccelDisp
			totalDisplacement = totalDisplacement + _posOffsetFrameDelta(pData, targetStep / pData.TotalKeyFrames)

			local parentCF_now, useVOS = getLinkCF(pData)
			local parentLocalDelta = useVOS and parentCF_now:VectorToObjectSpace(totalDisplacement) or totalDisplacement
			pData.LocalCF = CFrame.new(parentLocalDelta) * pData.LocalCF
			local rotationCFrame = Constants.composeRotation(rotOrder, pData.AccRotX + spinAddX, pData.AccRotY + spinAddY, pData.AccRotZ + spinAddZ)

			pData.VisualPart:PivotTo((parentCF_now * pData.LocalCF) * rotationCFrame)
			pData._localWorldCF = pData.LocalCF * rotationCFrame
			pData.CurrentPosition = pData.VisualPart:GetPivot().Position
			pData.CurrentStep = targetStep

		-- POSITION: Forward, FAST (absolute rotation)
		else
			local hasDrag = pData.HasDrag
			local hasAccel = pData.HasAccel
			local totalScalarDisp = 0
			local totalAccelDisp = Vector3.zero
			local accelVel = pData._accelVel or Vector3.zero

			for step = prevStep + stepDir, targetStep, stepDir do
				local si = step / pData.TotalKeyFrames
				local elapsedSec = si * pData.LifeTime
				local speed = pData._speedOverride or ((pData._staticSpeed or GraphMod.QueryPointsWithTime(si, pData.Graphs.Speed, pData.Seeds.Speed)) * speedMult)
				if hasDrag then speed = speed * math.exp(-pData.Drag * elapsedSec) end
				totalScalarDisp = totalScalarDisp + speed * perStepDT
				if hasAccel then
					local effA = Constants.applyContactAccel(pData.Acceleration, pData, perStepDT)
					accelVel = accelVel + effA * perStepDT
					totalAccelDisp = totalAccelDisp + accelVel * perStepDT
				end
			end
			pData._accelVel = accelVel

			local totalDisplacement = pData.BaseDirection * totalScalarDisp + totalAccelDisp
			totalDisplacement = totalDisplacement + _posOffsetFrameDelta(pData, targetStep / pData.TotalKeyFrames)

			local parentCF_now, useVOS = getLinkCF(pData)
			local parentLocalDelta = useVOS and parentCF_now:VectorToObjectSpace(totalDisplacement) or totalDisplacement
			pData.LocalCF = CFrame.new(parentLocalDelta) * pData.LocalCF

			local steppedI = targetStep / pData.TotalKeyFrames
			local rotDamp = pData._settleRotDamp or 1
			local rotX = (pData._staticRotSpeedX or GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.RotSpeedX, pData.Seeds.RotSpeedX)) * rotDamp
			local rotY = (pData._staticRotSpeedY or GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.RotSpeedY, pData.Seeds.RotSpeedY)) * rotDamp
			local rotZ = (pData._staticRotSpeedZ or GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.RotSpeedZ, pData.Seeds.RotSpeedZ)) * rotDamp
			local rotationCFrame = Constants.composeRotation(rotOrder, rotX + spinAddX, rotY + spinAddY, rotZ + spinAddZ)

			pData.VisualPart:PivotTo((parentCF_now * pData.LocalCF) * rotationCFrame)
			pData._localWorldCF = pData.LocalCF * rotationCFrame
			pData.CurrentPosition = pData.VisualPart:GetPivot().Position
			pData.CurrentStep = targetStep
		end

		-- SCALE: ScaleTo cascades to BaseParts, Meshes, PEs, Beams, Trails.
		local steppedI = targetStep / pData.TotalKeyFrames
		local scale = math.max(0.001, pData._staticScale or GraphMod.QueryPointsWithTime(steppedI, pData.Graphs.Scale, pData.Seeds.Scale))
		pData.VisualPart:ScaleTo(scale)
		-- ScaleTo can drop descendant Beam.Segments below 20; re-clamp.
		if pData._visualBeams then
			for _, beam in ipairs(pData._visualBeams) do
				if beam.Parent and beam.Segments < 20 then beam.Segments = 20 end
			end
		end
	end

	return isDying
end

end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">ZOffset</string>
              <string name="Source"><![CDATA[--[[
	ZOffset Mixin  -  per-frame position shift along particle→camera line for Part / Model / Attachment.
	Positive = closer to camera. Runs after Orientation so velocity derivation uses pre-shifted position.
]]

return function(Particle)

local EPS = 1e-3

function Particle:ApplyZOffset(pData, camPos)
	local zo = pData.ZOffset
	if not zo or zo == 0 then return end
	if not camPos then return end
	if not pData.VisualPart or not pData.VisualPart.Parent then return end
	local t = pData.Type
	if t ~= "Part" and t ~= "Model" and t ~= "Attachment" then return end

	local isModel = t == "Model"
	local isAttachment = t == "Attachment"
	-- Use the pre-overlay base CFrame so ZOffset is an absolute shift; reading live would compound each frame.
	local currentCF = pData._postUpdateCF or (isModel and pData.VisualPart:GetPivot() or pData.VisualPart.CFrame)

	-- Attachment.CFrame is parent-local; convert to world for the camera shift, back to local on write.
	local parentPart
	if isAttachment then
		parentPart = pData.VisualPart.Parent
		if parentPart and parentPart:IsA("BasePart") then
			currentCF = parentPart.CFrame * currentCF
		else
			parentPart = nil
		end
	end

	local pos = currentCF.Position
	local toCam = camPos - pos
	local mag = toCam.Magnitude
	if mag < EPS then return end
	local newPos = pos + (toCam / mag) * zo
	local newCF = CFrame.new(newPos) * (currentCF - pos)

	if parentPart then
		newCF = parentPart.CFrame:ToObjectSpace(newCF)
	end

	if isModel then
		pData.VisualPart:PivotTo(newCF)
	else
		pData.VisualPart.CFrame = newCF
	end
end

end
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
